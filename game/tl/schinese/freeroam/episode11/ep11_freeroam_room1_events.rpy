# freeroam\episode11\ep11_freeroam_room1_events.rpy:5
translate schinese ep11_freeroam_room1_intro_label_2b35b6fe:

    # mc "..."
    mc "..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:9
translate schinese ep11_freeroam_room1_intro_label_70cccd8e:

    # mc "Hey. Do you have time? I feel we need to talk."
    mc "嘿，你有空吗？我觉得我们得谈谈。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:13
translate schinese ep11_freeroam_room1_intro_label_3d25f58d:

    # jb "Did you see that Nick left?"
    jb "你看到Nick走了吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:15
translate schinese ep11_freeroam_room1_intro_label_65f32a43:

    # mc "Where did he go?"
    mc "他去哪儿了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:17
translate schinese ep11_freeroam_room1_intro_label_77e9bdf2:

    # jb "I haven't the foggiest idea. I got back after class and wanted to check up on him, but he was gone."
    jb "我一点头绪都没有。我下课后回来想看看他，结果他已经不见了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:18
translate schinese ep11_freeroam_room1_intro_label_b4a57c23:

    # jb "He took most of his belongings with him. It doesn't feel like he's coming back."
    jb "他带走了大部分自己的东西。感觉他不会再回来了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:24
translate schinese ep11_freeroam_room1_intro_label_e0395819:

    # mc "Good riddance. Tommy had the right idea to banish him."
    mc "走了清净，Tommy就该把他赶出去。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:26
translate schinese ep11_freeroam_room1_intro_label_08af8a01:

    # jb "I get why you're mad at Nick. You took some big blows yesterday..."
    jb "我明白你为什么生Nick的气。昨天你遭受了不小的打击……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:31
translate schinese ep11_freeroam_room1_intro_label_c5380f93:

    # mc "I understand why. I didn't want to come back here today, either."
    mc "我明白你的意思。我今天也不想再回来这儿了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:33
translate schinese ep11_freeroam_room1_intro_label_4de47f84:

    # jb "I can't blame you. You took some big blows yesterday..."
    jb "我不能怪你。你昨天也吃了不少苦头……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:38
translate schinese ep11_freeroam_room1_intro_label_097789fb:

    # mc "Listen... I should have told you the truth about Heather, but I couldn't do it."
    mc "听着……我本该把Heather的真相告诉你，可我没能说出口。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:39
translate schinese ep11_freeroam_room1_intro_label_f76a1e76:

    # mc "You put me on the spot with that conversation, and I didn't know what to say."
    mc "那次你突然问我，我慌了，不知道该说什么。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:40
translate schinese ep11_freeroam_room1_intro_label_e5317638:

    # mc "I did a bad thing at that party."
    mc "我在那场派对上做了一件蠢事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:42
translate schinese ep11_freeroam_room1_intro_label_37c915e6:

    # jb "I understand why you didn't tell me, but I thought you trusted me more than that."
    jb "我明白你为什么没告诉我，但我以为你比我想象中更信任我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:43
translate schinese ep11_freeroam_room1_intro_label_923b9054:

    # jb "I'm not gonna lie to you. It hurt."
    jb "我不会骗你，这确实很痛。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:45
translate schinese ep11_freeroam_room1_intro_label_6c0be033:

    # mc "You were talking about telling Tommy, and I panicked."
    mc "你当时说要告诉Tommy，我就慌了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:48
translate schinese ep11_freeroam_room1_intro_label_9e4fb74c:

    # jb "I get it... But you trusted Nick with it. Not that it did you any good. So..."
    jb "我明白……但你却把这件事告诉了Nick。这对你来说一点都没好处。所以……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:50
translate schinese ep11_freeroam_room1_intro_label_69c25b65:

    # mc "Yeah..."
    mc "嗯……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:53
translate schinese ep11_freeroam_room1_intro_label_668d658b:

    # jb "But you told Tommy."
    jb "可你告诉了Tommy。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:55
translate schinese ep11_freeroam_room1_intro_label_76e8aa24:

    # mc "I had to. I didn't want Nick to get the full blame. Not that it did me any good."
    mc "我必须告诉他。我不想让Nick承担全部责任，虽然这样也没给我带来什么好处。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:57
translate schinese ep11_freeroam_room1_intro_label_fcf3ae9d:

    # jb "The things Nick said... There was a lot to digest."
    jb "Nick说的那些事……信息量太大了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:59
translate schinese ep11_freeroam_room1_intro_label_79ddae04:

    # jb "I wanna be upfront with you. I don't have cock envy."
    jb "我直说吧，我没嫉妒你的鸡巴。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:60
translate schinese ep11_freeroam_room1_intro_label_4c164f9b:

    # jb "I made the mistake of telling him about some of my fantasies; that's all."
    jb "我犯了个错，把自己的一些性幻想告诉了他，仅此而已。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:63
translate schinese ep11_freeroam_room1_intro_label_59e06b95:

    # mc "You already told me those things at the barbecue, so it wasn't news."
    mc "你已经在烧烤时跟我说过那些事了，所以对我来说不算什么新鲜事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:65
translate schinese ep11_freeroam_room1_intro_label_91a59fc8:

    # mc "What you fantasize about is up to you."
    mc "你幻想什么都是你的事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:67
translate schinese ep11_freeroam_room1_intro_label_1a698f43:

    # jb "Yeah, but I'm embarrassed... I don't want you to feel uncomfortable around me."
    jb "是啊，可我很难为情……我不想让你和我待在一起时觉得不自在。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:69
translate schinese ep11_freeroam_room1_intro_label_68ec10d7:

    # mc "I don't."
    mc "我不会觉得不自在。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:70
translate schinese ep11_freeroam_room1_intro_label_b8a33751:

    # mc "I'm more worried that everyone in the frat secretly hates me."
    mc "我更担心兄弟会里每个人都在暗地里恨我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:72
translate schinese ep11_freeroam_room1_intro_label_35d60ed3:

    # jb "No one hates you."
    jb "没人讨厌你。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:75
translate schinese ep11_freeroam_room1_intro_label_19bfd23b:

    # mc "Nick seems to, and Tommy should."
    mc "Nick好像就恨我，Tommy也有理由恨我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:77
translate schinese ep11_freeroam_room1_intro_label_88cd33c8:

    # mc "Nick seems to."
    mc "Nick好像就恨我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:78
translate schinese ep11_freeroam_room1_intro_label_9757d16e:

    # mc "I was trying to help the frat out, not make myself look like a leader or a saint."
    mc "我当时是想帮兄弟会一把，不是想让自己看起来像个领袖或者圣人。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:80
translate schinese ep11_freeroam_room1_intro_label_992b5f41:

    # jb "I think those were Nick's words. They weren't mine, and I haven't heard anyone speak badly about what you did."
    jb "我想那是Nick的原话。那不是我的想法，我也没听谁说你做得不好。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:82
translate schinese ep11_freeroam_room1_intro_label_fbca88e7:

    # jb "Are you kidding me? Look at what you made us do."
    jb "你开玩笑吗？看看你带着我们做成了什么。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:84
translate schinese ep11_freeroam_room1_intro_label_1f7a0121:

    # jb "Not only did you improve the mansion, you helped improve us."
    jb "不仅你改善了宅邸，还帮我们提升了自己。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:86
translate schinese ep11_freeroam_room1_intro_label_36c5aec8:

    # jb "Not only did you try to improve the mansion, you helped improve us."
    jb "不仅你试图改善这座宅邸，你还帮我们变得更好。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:89
translate schinese ep11_freeroam_room1_intro_label_36ca4132:

    # mc "Thanks... I needed to hear that."
    mc "谢谢……我需要听到这句话。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:94
translate schinese ep11_freeroam_room1_intro_label_934b016b:

    # mc "I'm sorry that I hurt you. It wasn't about you, though. I trust you."
    mc "对不起，我伤到你了。但那不是针对你，我信任你。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:96
translate schinese ep11_freeroam_room1_intro_label_e41ef17a:

    # jb "Thanks."
    jb "谢谢。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:104
translate schinese ep11_freeroam_room1_intro_label_412792a2:

    # mc "I'm gonna talk to the rest when I get a chance."
    mc "我等会儿再跟其他人说。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:105
translate schinese ep11_freeroam_room1_intro_label_2aa7afd1:

    # mc "Things aren't what we thought they were with everything said last night."
    mc "昨晚说了那么多，可事情好像并不是我们以为的那样。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:107
translate schinese ep11_freeroam_room1_intro_label_ece5dcdf:

    # jb "What do you mean?"
    jb "你是什么意思？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:109
translate schinese ep11_freeroam_room1_intro_label_891e1dd1:

    # mc "I'm still figuring things out, but there has been some development."
    mc "我还在理清头绪，但事情有些新进展。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:110
translate schinese ep11_freeroam_room1_intro_label_7c2cda50:

    # mc "Tara wants us to apologize to her friends for one, and she claims they didn't post that cluck."
    mc "比如Tara想让我们向她朋友道歉，还说那条动态不是她们发的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:111
translate schinese ep11_freeroam_room1_intro_label_21a29a9c:

    # mc "And since Nick claims he didn't either, it doesn't make things any clearer."
    mc "而Nick也声称不是他发的，事情反而更不清楚了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:112
translate schinese ep11_freeroam_room1_intro_label_03845216:

    # mc "I'll let you know when I have more information."
    mc "我会在有更多消息的时候告诉你。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:121
translate schinese ep11_fr1_bella_call_label_a592161e:

    # isa "Hi, [name]."
    isa "嗨，[name]."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:123
translate schinese ep11_fr1_bella_call_label_94b4f6ac:

    # mc "Hey. I didn't get a chance to talk to you after English class, but I wanted to thank you for everything this weekend."
    mc "嘿，英语课后没来得及和你说话，不过我想感谢你这个周末帮了我这么多。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:125
translate schinese ep11_fr1_bella_call_label_65d57e67:

    # isa "It wasn't much, but I'm happy I could help."
    isa "这不算什么，但我很高兴能帮上忙。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:126
translate schinese ep11_fr1_bella_call_label_c787dfc8:

    # isa "And I have to say, it's quite a colorful group of friends you have."
    isa "而且我得说，你这帮朋友可真是五花八门。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:128
translate schinese ep11_fr1_bella_call_label_2517fe16:

    # mc "You're one of us now."
    mc "你现在是我们的一员了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:130
translate schinese ep11_fr1_bella_call_label_92ef7f7f:

    # isa "You think so?"
    isa "你这么想吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:132
translate schinese ep11_fr1_bella_call_label_21985e17:

    # mc "Aren't you?"
    mc "你不觉得吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:135
translate schinese ep11_fr1_bella_call_label_4ddc3fe4:

    # isa "I suppose I am. Teacher, mentor, friend, us..."
    isa "大概是吧。老师、导师、朋友，还有我们之间……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:137
translate schinese ep11_fr1_bella_call_label_8b9f70d5:

    # isa "I suppose I am. Teacher, mentor, friend..."
    isa "我猜我算是吧。老师、导师、朋友……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:138
translate schinese ep11_fr1_bella_call_label_30e7dc10:

    # isa "We've gotten quite close. It's something I didn't anticipate."
    isa "我们已经变得很亲近了。这并不是我预料到的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:140
translate schinese ep11_fr1_bella_call_label_6dd6f1f5:

    # mc "You're needed. It felt like your place was a home where we could be ourselves and bond more."
    mc "大家需要你。在你家，我们能自在地做自己，也变得更亲近，真的像个家。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:142
translate schinese ep11_fr1_bella_call_label_d84bf762:

    # isa "I'm glad."
    isa "我很高兴。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:143
translate schinese ep11_fr1_bella_call_label_f95e5908:

    # isa "I've been thinking about what Sage said about celebrating more together."
    isa "我一直在想Sage说的，以后大家多聚在一起庆祝。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:145
translate schinese ep11_fr1_bella_call_label_fc4b16e3:

    # isa "Would it be weird if we had a small Christmas party at my place?"
    isa "在我家办个小型圣诞聚会，会不会有点奇怪？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:146
translate schinese ep11_fr1_bella_call_label_c599266c:

    # isa "It doesn't have to be on Christmas Eve, but getting together before that and maybe eating and talking would make everyone feel nice."
    isa "不一定非得在圣诞前夜，但提前聚在一起，一起吃点东西、聊聊天，大家都会感觉很舒服。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:148
translate schinese ep11_fr1_bella_call_label_7062f173:

    # mc "I think that's a great idea. Are you up for it? I know how much effort it takes to host a party."
    mc "我觉得这主意很棒。你愿意办吗？我知道举办派对要花很多精力。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:150
translate schinese ep11_fr1_bella_call_label_fad96434:

    # isa "I think I'll manage. Can I count on you to show up for it?"
    isa "我觉得应该没问题。你能来参加吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:152
translate schinese ep11_fr1_bella_call_label_3a380d53:

    # mc "Unless my teacher forces me to study."
    mc "除非老师逼我学习。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:154
translate schinese ep11_fr1_bella_call_label_386839c4:

    # isa "I have a feeling she won't. I can't speak on behalf of Philip, though."
    isa "我想她不会逼你。不过Philip那边，我可做不了主。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:155
translate schinese ep11_fr1_bella_call_label_9f9fec94:

    # isa "But maybe your finals will pose a problem. I know how busy it gets in December for students."
    isa "不过你期末考试可能会是个问题。我知道十二月对学生来说真的很忙。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:157
translate schinese ep11_fr1_bella_call_label_8e1c1af4:

    # mc "I'm sure we can make room for one dinner. We have to eat anyway. I'm up for it. Go ahead and check with the rest."
    mc "我相信我们能腾出时间吃顿饭。反正我们总得吃饭。我同意，你去跟其他人确认一下吧。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:159
translate schinese ep11_fr1_bella_call_label_c90a88ea:

    # isa "I'll do that."
    isa "我这就去办。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:161
translate schinese ep11_fr1_bella_call_label_42b005d9:

    # mc "Talk soon."
    mc "回头聊。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:172
translate schinese ep11_fr1_sage_call_label_b1ef63c9:

    # sa "Hey..."
    sa "嘿..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:174
translate schinese ep11_fr1_sage_call_label_1f92daaa:

    # mc "Hey... About last time..."
    mc "嘿... 关于上次的事..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:176
translate schinese ep11_fr1_sage_call_label_ca24a7af:

    # sa "Really? You're doing this over the phone?"
    sa "你认真的？这种事打算在电话里谈？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:178
translate schinese ep11_fr1_sage_call_label_f6571278:

    # mc "Want me to come over?"
    mc "要我过去吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:180
translate schinese ep11_fr1_sage_call_label_a76c7160:

    # sa "On second thought, the phone is great. It gives me the choice to hang up on you."
    sa "再想想，电话挺好。这样我随时能挂断。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:185
translate schinese ep11_fr1_sage_call_label_1b5b113b:

    # mc "I'm sorry for the way we ended the weekend. Everything was going great. Dad absolutely loved you, and I had to ruin it."
    mc "对不起，我们周末结束的方式。那一切都很棒，我爸超级喜欢你，我却把它搞砸了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:186
translate schinese ep11_fr1_sage_call_label_a0f72ca5:

    # mc "But I didn't do it on purpose."
    mc "但我不是故意的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:191
translate schinese ep11_fr1_sage_call_label_53eddd06:

    # mc "I haven't done anything wrong."
    mc "我没做错什么。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:193
translate schinese ep11_fr1_sage_call_label_a6137460:

    # sa "Yeah, I'm hanging up."
    sa "嗯，我挂了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:195
translate schinese ep11_fr1_sage_call_label_b8c2a8c0:

    # mc "Sage, let's talk about it. I don't want or need to have bad tension between us."
    mc "Sage，我们谈谈吧。我不希望我们之间一直这么别扭，也没必要这样。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:196
translate schinese ep11_fr1_sage_call_label_95af22f9:

    # mc "Why is it that you're this upset?"
    mc "你为什么这么生气？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:200
translate schinese ep11_fr1_sage_call_label_5421dd29:

    # sa "You talked to me about meeting your ex while I was stuck with you at your dad's place."
    sa "你在我被困在你爸家的时候，还跟我聊你跟前任见面的事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:202
translate schinese ep11_fr1_sage_call_label_d2d5b88b:

    # mc "Would it have been better if I didn't tell you that I was going to see her?"
    mc "如果我当时没告诉你我要见她，会不会好一点？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:204
translate schinese ep11_fr1_sage_call_label_57718152:

    # sa "Do you want me to be honest? You're not gonna like it."
    sa "你想要我诚实点吗？你可能不会喜欢我说的话。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:206
translate schinese ep11_fr1_sage_call_label_434172ab:

    # mc "Of course, I want to hear what you think."
    mc "当然，我想听听你的想法。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:208
translate schinese ep11_fr1_sage_call_label_c49c02ec:

    # sa "I don't even get why you feel like you have to see her at all."
    sa "我真搞不懂你为什么非得见她。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:209
translate schinese ep11_fr1_sage_call_label_dd367c5a:

    # sa "To me, that screams you're not done with each other."
    sa "对我来说，这明显说明你们还没完。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:211
translate schinese ep11_fr1_sage_call_label_490104db:

    # mc "I told you how I see it..."
    mc "我跟你说过我怎么想的……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:213
translate schinese ep11_fr1_sage_call_label_52e5e70c:

    # sa "Yes, and I don't buy it."
    sa "是的，我可不信这套。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:214
translate schinese ep11_fr1_sage_call_label_81c4501e:

    # sa "Sure, you can be \"friends\" with your ex. Friends, as in you put up with having them around and make minor efforts with that friendship."
    sa "当然，你可以和前任做‘朋友’。所谓朋友，就是能忍受对方待在身边，偶尔花点心思维持关系。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:215
translate schinese ep11_fr1_sage_call_label_209bb58d:

    # sa "But you can't become someone's best friend after breaking up. That's just a convenient lie for something else."
    sa "但分手后不可能反倒成了最好的朋友。这只是为了掩盖别的事而编出的方便借口。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:218
translate schinese ep11_fr1_sage_call_label_46073fde:

    # mc "She's not my best friend. That's Derek."
    mc "她不是我最好的朋友，Derek才是。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:220
translate schinese ep11_fr1_sage_call_label_3b6ea306:

    # sa "Well... Yeah...but... Still, dude. Don't you see what I mean by any of this?"
    sa "好吧……对……可是……老兄，你还不明白我的意思吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:222
translate schinese ep11_fr1_sage_call_label_47be8e23:

    # mc "So, are you telling me I shouldn't see her at all?"
    mc "所以你是说我不该见她？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:224
translate schinese ep11_fr1_sage_call_label_00ef99bd:

    # sa "I'm not saying that. My God! How can you be this oblivious to how I feel?"
    sa "我可没这么说。天啊！你怎么能这么不理解我感受？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:225
translate schinese ep11_fr1_sage_call_label_eddacd9d:

    # sa "You're usually great at it."
    sa "你通常都挺擅长的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:227
translate schinese ep11_fr1_sage_call_label_abdc2c83:

    # mc "Then what do you want?"
    mc "那你想要什么？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:229
translate schinese ep11_fr1_sage_call_label_8a3d8e17:

    # sa "I want you to understand how uncomfortable it makes me feel that you still spend time alone with her."
    sa "我想让你明白，你还在和她单独相处，这让我有多不舒服。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:231
translate schinese ep11_fr1_sage_call_label_dc301d22:

    # mc "I can tell that you feel that way now."
    mc "我能看出来你现在是这么想的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:232
translate schinese ep11_fr1_sage_call_label_1fbe54ef:

    # mc "But you gotta understand, she was my first and only girlfriend. Sage, I have almost no experience with this..."
    mc "但你得明白，她是我的第一个、也是唯一一个女朋友。Sage，我在这方面几乎毫无经验……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:234
translate schinese ep11_fr1_sage_call_label_f4095936:

    # mc "And I have to say, I don't see it your way. You can stay good friends with your ex, especially when it wasn't a real relationship."
    mc "而且我得说，我不同意你的看法。你完全可以和前任保持好朋友的关系，尤其是当时根本算不上什么真正的恋爱关系。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:235
translate schinese ep11_fr1_sage_call_label_2d8ffb3e:

    # mc "I meant it when I said she helped me get through bad times."
    mc "我当初说她帮我熬过那些难熬的日子，是认真的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:236
translate schinese ep11_fr1_sage_call_label_0038751f:

    # mc "The friend she was to me when I was a kid helped me become who I am today. She's always been my support ever since I was bullied and didn't have any friends."
    mc "她小时候给我的陪伴，塑造了今天的我。从我受人欺负、一个朋友都没有时起，她就一直支持着我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:238
translate schinese ep11_fr1_sage_call_label_ba0bfb6c:

    # mc "I don't want you to worry about me and Zoey. We're just talking... In fact, it's been hard to do so since she returned."
    mc "我不想你为我和Zoey担心。我们只是在聊天……事实上，自从她回来之后，这么做都很难。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:240
translate schinese ep11_fr1_sage_call_label_a07f76fd:

    # mc "I've been mad at her, and I'm not even sure if I can get over what she did."
    mc "我一直在生她的气，甚至不确定自己能不能忘记她做过的事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:242
translate schinese ep11_fr1_sage_call_label_a4bdd71d:

    # sa "[name], it's her that I don't trust."
    sa "[name]，我不信任的是她。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:247
translate schinese ep11_fr1_sage_call_label_d1d26e0d:

    # mc "Yeah, but you have to trust me. Isn't that how a relationship works?"
    mc "对，但你必须信任我。谈恋爱不就该这样吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:248
translate schinese ep11_fr1_sage_call_label_7981513b:

    # mc "Zoey doesn't intend to get back together with me, and even if she did, it doesn't mean she calls the shots."
    mc "Zoey没打算和我复合。即便她真有这个想法，也不是她说了算。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:249
translate schinese ep11_fr1_sage_call_label_b0a6e03e:

    # mc "I have free will, and I chose to be with you."
    mc "我有自由意志，我选择和你在一起。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:253
translate schinese ep11_fr1_sage_call_label_390a526f:

    # mc "That's fair. I understand that."
    mc "这话说得对。我明白。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:255
translate schinese ep11_fr1_sage_call_label_8b36990f:

    # sa "You do?"
    sa "你真的这么想？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:257
translate schinese ep11_fr1_sage_call_label_0c8a53fd:

    # mc "You don't know her like I do. If I were in your shoes, I would be suspicious, too."
    mc "你不像我这么了解她。换作是我，也会心存怀疑。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:258
translate schinese ep11_fr1_sage_call_label_07cd6b38:

    # sa "..."
    sa "..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:261
translate schinese ep11_fr1_sage_call_label_2c7bd45a:

    # sa "Why didn't you say these things when we started this argument!?"
    sa "你当初干嘛不早点说这些！？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:263
translate schinese ep11_fr1_sage_call_label_6bfc7dff:

    # mc "I didn't think it would turn into this big fight."
    mc "我没想到会演变成这么激烈的争吵。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:265
translate schinese ep11_fr1_sage_call_label_d6a3eb3d:

    # mc "Is jealousy a big thing with you? Will I have to worry about talking to other girls, too?"
    mc "你很容易吃醋吗？以后我和别的女孩说话，也得担心你生气？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:267
translate schinese ep11_fr1_sage_call_label_db15ccb2:

    # mc "I think it's sweet that you're jealous; it shows that you care."
    mc "我觉得你吃醋的样子挺可爱的，这说明你在意我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:268
translate schinese ep11_fr1_sage_call_label_84b42b15:

    # mc "But...don't let it get to you. I don't want to feel like I can't talk to other girls."
    mc "但……别让嫉妒冲昏头脑。我不希望自己连和其他女孩说话都要顾忌。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:270
translate schinese ep11_fr1_sage_call_label_3d37ffa5:

    # sa "That's so not what this is, [name]."
    sa "[name]，这根本不是一回事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:271
translate schinese ep11_fr1_sage_call_label_b5f1ac5d:

    # sa "Coming from the relationship with Chad that ended after a similar fight... It scares me."
    sa "我和Chad的感情就是在一次类似的争吵后结束的……所以我很害怕。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:273
translate schinese ep11_fr1_sage_call_label_4b84cd5e:

    # mc "Fuck... I didn't even think about that."
    mc "操...我都没想到这点。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:275
translate schinese ep11_fr1_sage_call_label_54295b3b:

    # sa "I'm not saying that you're cheating on me, but..."
    sa "我不是说你在外面找别人，但..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:276
translate schinese ep11_fr1_sage_call_label_d4f1abd8:

    # sa "That's something I didn't think Chad would do either."
    sa "这种事，我以前也没想过Chad会做。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:278
translate schinese ep11_fr1_sage_call_label_1ba69636:

    # mc "I'm not Chad, you know?"
    mc "我不是Chad，明白吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:280
translate schinese ep11_fr1_sage_call_label_b2d45d1e:

    # sa "I know you're not."
    sa "我知道你不是。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:283
translate schinese ep11_fr1_sage_call_label_509dbed2:

    # mc "(I'm worse than him...)"
    mc "（我比他还要糟糕……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:285
translate schinese ep11_fr1_sage_call_label_9874a812:

    # mc "(I ruined your family, and you don't even know it...)"
    mc "（我毁了你的家庭，而你甚至毫不知情……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:287
translate schinese ep11_fr1_sage_call_label_4125566f:

    # mc "(I've managed to betray you before we even became a couple...)"
    mc "（我们甚至还没成为情侣，我就已经背叛过你了……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:288
translate schinese ep11_fr1_sage_call_label_8dd316d9:

    # mc "(What am I doing with her...?)"
    mc "（我和她到底算什么……？）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:291
translate schinese ep11_fr1_sage_call_label_bea8fb87:

    # mc "Promise to talk to me when you feel like this."
    mc "答应我，以后有这种感受就告诉我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:292
translate schinese ep11_fr1_sage_call_label_f7ef57ee:

    # mc "And I'll promise to think more about your feelings before I blurt things out."
    mc "我也答应你，以后不会脱口而出，会先多想想你的感受。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:294
translate schinese ep11_fr1_sage_call_label_5a84b19a:

    # sa "Deal..."
    sa "成交。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:295
translate schinese ep11_fr1_sage_call_label_794893ff:

    # sa "Now the phone feels like a bad choice. I wanna hug you..."
    sa "现在这电话真是个糟糕的选择。我想抱抱你……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:297
translate schinese ep11_fr1_sage_call_label_15364849:

    # mc "Me too. I'm happy we could talk it out."
    mc "我也是。我们能聊聊真的很开心。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:300
translate schinese ep11_fr1_sage_call_label_3e1d67f4:

    # mc "Speaking of Chad... There's a twofold reason why I called."
    mc "说到Chad……我打这通电话其实有两个原因。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:301
translate schinese ep11_fr1_sage_call_label_79fea510:

    # mc "I need to get a hold of him. Can I have his number?"
    mc "我需要联系他。能给我他的号码吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:303
translate schinese ep11_fr1_sage_call_label_8a03998e:

    # sa "In what universe would you need his number?"
    sa "你怎么会需要他的号码？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:305
translate schinese ep11_fr1_sage_call_label_7e0e13ba:

    # mc "I'm trying to sort out some arguments between the frats, and I think Chad can give me some answers."
    mc "我在处理兄弟会之间的一些矛盾，我想Chad能给我一些答案。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:307
translate schinese ep11_fr1_sage_call_label_d354aefe:

    # sa "I'll share his contact info with you, but good luck trying to get any answers from him. He's a shut book."
    sa "我可以把他的联系方式发给你，不过想从他嘴里问出答案可不容易。他什么都不肯说。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:308
translate schinese ep11_fr1_sage_call_label_5f7c938e:

    # sa "No... Not just a shut book. He's like one of those diaries that teenage girls have with a lock on that they hide under their pillow."
    sa "不……他可不只是守口如瓶。他就像青春期女孩锁起来藏在枕头底下的日记本。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:310
translate schinese ep11_fr1_sage_call_label_9b32d5e4:

    # mc "It's worth a try. You and I aren't the only ones who have been fighting."
    mc "值得一试。最近起冲突的可不只有我们俩。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:311
translate schinese ep11_fr1_sage_call_label_f0feeb9d:

    # mc "The DIKs had a big one last night."
    mc "DIKs昨晚大吵了一架。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:313
translate schinese ep11_fr1_sage_call_label_1902e26f:

    # sa "About what?"
    sa "关于什么？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:315
translate schinese ep11_fr1_sage_call_label_26df49b4:

    # mc "It started with Heather cheating on Tommy with Nick, and then it became an even bigger fight because of other things."
    mc "起因是Heather背着Tommy和Nick上床，后来又因为其他事，争吵闹得更大了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:317
translate schinese ep11_fr1_sage_call_label_c19edb7a:

    # sa "I suspected that would get ugly... Heather told me what she did..."
    sa "我就猜事情会闹得很难看……Heather把自己做的事告诉我了……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:318
translate schinese ep11_fr1_sage_call_label_64665882:

    # sa "But what can you do? They set themselves up for that with their kind of relationship."
    sa "但你能怎么办？他们自己就是这么搞的，这种关系模式本身就埋下祸根。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:320
translate schinese ep11_fr1_sage_call_label_e570e758:

    # mc "Yeah... Nick left the DIKs today, and I'm not sure if he will return."
    mc "对……Nick今天离开了DIKs，我也不知道他会不会回来。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:322
translate schinese ep11_fr1_sage_call_label_1bdeeaff:

    # sa "He left?"
    sa "他走了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:324
translate schinese ep11_fr1_sage_call_label_338ca832:

    # mc "It wasn't the only thing he was accused of. Like I said, it turned bigger."
    mc "这可不是他唯一被指责的事。就像我说的，事情越来越糟了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:327
translate schinese ep11_fr1_sage_call_label_79bd892a:

    # sa "Want me to come over?"
    sa "要我过去吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:329
translate schinese ep11_fr1_sage_call_label_d15020c8:

    # mc "No... Please don't. I'm busy...uh... I'll talk to you another time, ok?"
    mc "不...别这样。我正忙...啊...改天再聊，行吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:331
translate schinese ep11_fr1_sage_call_label_2d970b3f:

    # sa "Alright..."
    sa "好吧..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:333
translate schinese ep11_fr1_sage_call_label_c25ac570:

    # mc "(Who am I kidding? I need to talk to someone about Sage...)"
    mc "（我在骗谁呢？我得找个人谈谈Sage的事……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:334
translate schinese ep11_fr1_sage_call_label_bc001054:

    # mc "(But one problem at a time... It must wait until I've dealt with the DIKs.)"
    mc "（不过事情得一件件解决……等我先处理完DIKs的问题再说。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:336
translate schinese ep11_fr1_sage_call_label_027c7c2e:

    # sa "Ok, that settles it. This is too much for a phone call. I'm coming over."
    sa "好，这事就这么定了。电话里说不清，我直接过来。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:338
translate schinese ep11_fr1_sage_call_label_cfce055e:

    # mc "Are you sure?"
    mc "你确定吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:340
translate schinese ep11_fr1_sage_call_label_f04e10e1:

    # sa "Yeah, I still want that hug."
    sa "嗯，我还是想要那个拥抱。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:342
translate schinese ep11_fr1_sage_call_label_98e45e41:

    # mc "Haha, ok. I'll be here."
    mc "哈哈，好。我会在这里等你。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:345
translate schinese ep11_fr1_sage_call_label_52a3134b:

    # sa "[name]! What's up?"
    sa "[name]！怎么了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:347
translate schinese ep11_fr1_sage_call_label_9521be92:

    # mc "Too much."
    mc "事情太多了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:349
translate schinese ep11_fr1_sage_call_label_07e53b76:

    # sa "Uh oh. What did you do?"
    sa "哎呀，你干了什么？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:353
translate schinese ep11_fr1_sage_call_label_9112f0e4:

    # mc "(I ruined your family by fucking your mom.)"
    mc "（我和你妈上床，毁了你的家庭。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:355
translate schinese ep11_fr1_sage_call_label_158e6b2c:

    # mc "(Started a sexual relationship with your mom that may have impacted your parents' relationship.)"
    mc "（和你妈发展出一段性关系，可能影响了你父母的关系。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:357
translate schinese ep11_fr1_sage_call_label_03970606:

    # mc "(Things with your mom that may have resulted in your parents' divorce.)"
    mc "（我和你妈之间的事，可能导致了你父母离婚。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:359
translate schinese ep11_fr1_sage_call_label_7242038a:

    # mc "Believe it or not, but it's not so much me this time."
    mc "信不信由你，这次不是我。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:360
translate schinese ep11_fr1_sage_call_label_133daff7:

    # mc "The DIKs had a big fight last night."
    mc "DIKs昨晚大吵了一架。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:362
translate schinese ep11_fr1_sage_call_label_1902e26f_1:

    # sa "About what?"
    sa "关于什么？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:364
translate schinese ep11_fr1_sage_call_label_6546993b:

    # mc "It started with Heather cheating on Tommy with Nick, then it turned into an even bigger fight because of other things."
    mc "起因是Heather背着Tommy和Nick上床，后来又因为其他事，争吵闹得更大了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:366
translate schinese ep11_fr1_sage_call_label_c19edb7a_1:

    # sa "I suspected that would get ugly... Heather told me what she did..."
    sa "我就猜事情会闹得很难看……Heather把自己做的事告诉我了……"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:367
translate schinese ep11_fr1_sage_call_label_64665882_1:

    # sa "But what can you do? They set themselves up for that with their kind of relationship."
    sa "但你能怎么办？他们自己就是这么搞的，这种关系注定会出问题。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:369
translate schinese ep11_fr1_sage_call_label_d558ca98:

    # mc "Yeah... Nick left the DIKs today, and I'm not sure if he will come back."
    mc "对……Nick今天离开了DIKs，我也不知道他会不会回来。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:371
translate schinese ep11_fr1_sage_call_label_1bdeeaff_1:

    # sa "He left?"
    sa "他走了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:373
translate schinese ep11_fr1_sage_call_label_338ca832_1:

    # mc "It wasn't the only thing he was accused of. Like I said, it turned bigger."
    mc "这可不是他唯一被指责的事。就像我说的，事情变得更糟了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:375
translate schinese ep11_fr1_sage_call_label_dbb00be3:

    # sa "Damn... That sounds bad."
    sa "该死……听起来很糟糕。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:377
translate schinese ep11_fr1_sage_call_label_5be5809b:

    # mc "Yeah, that's why I'm calling. I need your help with something."
    mc "对，所以我才打来。我有件事需要你帮忙。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:379
translate schinese ep11_fr1_sage_call_label_db6cdf24:

    # sa "I doubt I can do much to help, but if you think otherwise... What do you need?"
    sa "我怕我帮不上什么忙，但如果你觉得我能……你到底需要什么？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:381
translate schinese ep11_fr1_sage_call_label_9be7535e:

    # mc "I need Chad's number."
    mc "我需要Chad的号码。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:383
translate schinese ep11_fr1_sage_call_label_2065f61b:

    # sa "How do you go from Nick leaving the DIKs to asking me about Chad's number?"
    sa "你怎么会从Nick离开DIKs，一下跳到问我要Chad的号码？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:385
translate schinese ep11_fr1_sage_call_label_b2192f59:

    # mc "It would take me a long time to explain, and I am not even sure if I'm on the right track."
    mc "解释起来很长，而且我也不确定自己的调查方向对不对。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:386
translate schinese ep11_fr1_sage_call_label_0c4f5dd7:

    # mc "But I need to talk to him because he has some answers I need."
    mc "但我必须和他谈谈，因为他知道一些我想弄清楚的事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:388
translate schinese ep11_fr1_sage_call_label_d354aefe_1:

    # sa "I'll share his contact info with you, but good luck trying to get any answers from him. He's a shut book."
    sa "我可以把他的联系方式发给你，不过想从他嘴里问出答案可不容易。他什么都不肯说。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:389
translate schinese ep11_fr1_sage_call_label_5f7c938e_1:

    # sa "No... Not just a shut book. He's like one of those diaries that teenage girls have with a lock on that they hide under their pillow."
    sa "不……他可不只是守口如瓶。他就像青春期女孩锁起来藏在枕头底下的日记本。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:391
translate schinese ep11_fr1_sage_call_label_1f85fee0:

    # mc "It's a slim chance, but I have to try. Sitting around doing nothing won't help us."
    mc "希望虽然渺茫，但我必须试试。坐在这里什么都不做，对我们没有帮助。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:392
translate schinese ep11_fr1_sage_call_label_2976d03f:

    # mc "So, how are you feeling today?"
    mc "那么，你今天感觉怎么样？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:394
translate schinese ep11_fr1_sage_call_label_98d260be:

    # sa "I feel like I embarrassed myself at Bella's."
    sa "我觉得我在贝拉面前丢脸了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:396
translate schinese ep11_fr1_sage_call_label_7e3b35cd:

    # mc "Come on, you didn't."
    mc "别这样，你没有丢脸。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:398
translate schinese ep11_fr1_sage_call_label_37521653:

    # sa "It was stupid of me to drink that much when I had a hard time keeping my feelings to myself all day."
    sa "我那天喝那么多酒真是太傻了，整天都控制不住自己的情绪。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:400
translate schinese ep11_fr1_sage_call_label_1d1b88a9:

    # mc "That one, I won't argue. But everyone understood what you're going through."
    mc "这点我没法反驳。不过大家都理解你正在经历什么。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:402
translate schinese ep11_fr1_sage_call_label_00ee808a:

    # sa "Did they ever... I can't believe how sweet they were to me."
    sa "她们确实理解……真不敢相信她们对我那么贴心。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:404
translate schinese ep11_fr1_sage_call_label_0bfb7502:

    # mc "Feels good, huh? You're not alone in this."
    mc "感觉不错吧？你不是一个人在经历这些。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:406
translate schinese ep11_fr1_sage_call_label_2d07b4a8:

    # sa "Yeah. Thank you."
    sa "嗯，谢谢。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:409
translate schinese ep11_fr1_sage_call_label_54ddf7b3:

    # mc "And thanks for stealing my girlfriend yesterday."
    mc "还有，谢谢你昨天抢走了我女朋友。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:411
translate schinese ep11_fr1_sage_call_label_437e25a2:

    # sa "Haha! You're welcome. If it makes you feel better, we had a great time."
    sa "哈哈！不客气。这样想能让你好受点的话，我们玩得很开心。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:412
translate schinese ep11_fr1_sage_call_label_e4d96d66:

    # sa "But boy, did you fuck up or what?"
    sa "但你小子是不是把事情搞砸了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:414
translate schinese ep11_fr1_sage_call_label_387e92e5:

    # mc "I did?"
    mc "我搞砸了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:416
translate schinese ep11_fr1_sage_call_label_53a0cfb9:

    # sa "Why the hell are you running off to your ex like that when you're with Jill?"
    sa "你和Jill在一起，怎么还能那样跑去找前任？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:418
translate schinese ep11_fr1_sage_call_label_3c8793be:

    # mc "That's not what it was."
    mc "那不是那么回事。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:419
translate schinese ep11_fr1_sage_call_label_f4a71875:

    # mc "Wait... Did Jill say I did that?"
    mc "等等……是Jill说我这么做的？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:421
translate schinese ep11_fr1_sage_call_label_51859f68:

    # sa "She told me what you told her, and I said it was ok to feel weird about it."
    sa "她告诉我你跟她说过那些话，我说没关系，觉得奇怪是正常的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:423
translate schinese ep11_fr1_sage_call_label_177d3eb2:

    # mc "What are you doing?"
    mc "你干什么呢？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:425
translate schinese ep11_fr1_sage_call_label_87ee604a:

    # sa "What am I doing? Look in the mirror."
    sa "我干什么？你先照照镜子。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:427
translate schinese ep11_fr1_sage_call_label_7dbe44f5:

    # mc "As I told Jill, Zoey is a childhood friend."
    mc "我跟Jill说过，Zoey是我的儿时好友。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:429
translate schinese ep11_fr1_sage_call_label_acfc2e0f:

    # sa "And an ex-girlfriend. Stop being a moron, [name]. Can't you see why that would make Jill feel uncomfortable?"
    sa "也是你的前女友。别犯傻了，[name]。你看不出Jill为什么会觉得不舒服吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:431
translate schinese ep11_fr1_sage_call_label_475740ac:

    # mc "I didn't get the feeling she was completely against it. She seemed to understand why I was still seeing Zoey."
    mc "我没觉得她完全反对。她似乎理解我为什么还要见Zoey。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:433
translate schinese ep11_fr1_sage_call_label_88238cd2:

    # sa "Oh, [name]. It amazes me how you can be both emotionally smart and stupid."
    sa "哦，[name]。你在感情上既聪明又迟钝，真让我吃惊。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:434
translate schinese ep11_fr1_sage_call_label_9c5fb7ee:

    # sa "Don't neglect my girl's feelings, ok?"
    sa "别忽视我家姑娘的感受，好吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:436
translate schinese ep11_fr1_sage_call_label_19858d10:

    # mc "She's your girl now?"
    mc "她现在是你的人了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:438
translate schinese ep11_fr1_sage_call_label_ee3d1521:

    # sa "Hell yeah, she is. And if you're not behaving, I will steal her from you."
    sa "那当然。你要是不好好表现，我就把她从你身边抢走。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:440
translate schinese ep11_fr1_sage_call_label_f1c89bad:

    # mc "As much as I'd like to see you try, I am behaving."
    mc "我倒挺想看你试试，不过我一直很规矩。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:442
translate schinese ep11_fr1_sage_call_label_ca8b050e:

    # sa "Good. I know it's not my place to speak for her, but she feels too shy to say it to you. Be more mindful."
    sa "好。我知道我无权替她说，但她太害羞，不好意思直接对你说。多留点心。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:444
translate schinese ep11_fr1_sage_call_label_c915c632:

    # mc "Thanks for letting me know. I had no idea she felt that way about it. I will."
    mc "谢谢你的提醒。我之前完全不知道她对这件事有这种感觉。我会的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:445
translate schinese ep11_fr1_sage_call_label_741b51d1:

    # mc "Did you deal with your family yet?"
    mc "你处理完你家的事了吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:447
translate schinese ep11_fr1_sage_call_label_2a36a1b9:

    # sa "No, but I'll deal with them soon. I know I can't escape it."
    sa "没，但我很快就会处理的。我知道逃不掉的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:452
translate schinese ep11_fr1_sage_call_label_a73e1abe:

    # mc "Did you deal with it yesterday?"
    mc "你昨天处理完了吗？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:454
translate schinese ep11_fr1_sage_call_label_9b4633fa:

    # sa "No. Jill and I had our nails done."
    sa "没有。我和Jill去做了美甲。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:456
translate schinese ep11_fr1_sage_call_label_e6861cb3:

    # mc "Oh? You two hung out?"
    mc "哦？你们俩出去玩了？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:458
translate schinese ep11_fr1_sage_call_label_652d0107:

    # sa "Yeah, she offered to show me the place where she frequents. We made a date out of it."
    sa "对，她说要带我去自己常去的店，我们就当约会一样一起去了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:459
translate schinese ep11_fr1_sage_call_label_9d8b8947:

    # sa "It was a nice distraction. She's a lot of fun."
    sa "正好让我换换心情。和她待在一起很开心。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:461
translate schinese ep11_fr1_sage_call_label_2e7757ae:

    # mc "That's nice."
    mc "这挺不错的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:463
translate schinese ep11_fr1_sage_call_label_a5b4faae:

    # sa "I'll deal with my family soon. I know I can't escape it."
    sa "我很快就会处理家里的事情。我知道我逃不掉的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:464
translate schinese ep11_fr1_sage_call_label_fbb9ac25:

    # sa "Good luck with Chad."
    sa "祝你找Chad顺利。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:466
translate schinese ep11_fr1_sage_call_label_6bf3a450:

    # mc "Thanks again."
    mc "谢谢啦。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:469
translate schinese ep11_fr1_sage_call_label_c25ac570_1:

    # mc "(Who am I kidding? I need to talk to someone about Sage...)"
    mc "（我在骗谁呢？我得找个人谈谈Sage的事……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:470
translate schinese ep11_fr1_sage_call_label_bc001054_1:

    # mc "(But one problem at a time... It must wait until I've dealt with the DIKs.)"
    mc "（不过事情得一件件解决……等我先处理完DIKs的问题再说。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:510
translate schinese ep11_fr1_end_label_85fa95cf:

    # mc "Rusty?"
    mc "Rusty？"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:512
translate schinese ep11_fr1_end_label_768e1b37:

    # mc "(He's still in school.)"
    mc "（他还在上学。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:517
translate schinese ep11_fr1_end_label_e069cf9b:

    # mc "(The DIK evaluation pictures and videos are still here in Derek's and my folder...)"
    mc "（DIK考核的照片和视频还在Derek和我的文件夹里……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:518
translate schinese ep11_fr1_end_label_a8e86ec1:

    # mc "(It's too late for it now, but I don't care. I'm deleting that video before it causes more damage.)"
    mc "（现在删或许已经晚了，但我不在乎。我得在那段视频造成更多伤害前删掉它。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:521
translate schinese ep11_fr1_end_label_9589613e:

    # mc "(Rusty restricted access to most folders after the Rooster incident... Only the folder owners have access... But even if access weren't restricted, I doubt I'd find anything useful.)"
    mc "（Rooster事件后，Rusty限制了大多数文件夹的访问权限……现在只有文件夹所有者能打开……不过即使权限没有受限，我大概也找不到有用的东西。）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:522
translate schinese ep11_fr1_end_label_c4d14f91:

    # mc "(If the video leaked after Rusty changed the permissions, it means it was either Rusty or Derek who sent that video to Professor Burke...)"
    mc "（如果视频是在Rusty修改权限后泄露的，就说明是Rusty或Derek把它发给了Professor Burke……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:523
translate schinese ep11_fr1_end_label_7f8cd80a:

    # mc "(But I trust both of them. The video must have leaked before that...)"
    mc "（但我信任他们俩。视频一定是在那之前泄露的……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:524
translate schinese ep11_fr1_end_label_3ad7a0e4:

    # mc "(The pictures sent to Chad and Dawe are likely in the other guys' folders. But I can't access any of them...)"
    mc "（发给Chad和Dawe的照片，很可能在其他人的文件夹里。但那些文件夹我一个也进不去……）"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:537
translate schinese ep11_fr1_end_label_d43c79d8:

    # sa "I'm sorry for that stupid fight."
    sa "那场愚蠢的争吵，对不起。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:539
translate schinese ep11_fr1_end_label_8c34e9fa:

    # mc "Me too. I don't want to fight with you."
    mc "我也有错。我不想和你争吵。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:541
translate schinese ep11_fr1_end_label_171971a1:

    # sa "Let's move past it."
    sa "我们把这事放下吧。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:542
translate schinese ep11_fr1_end_label_3242ebf3:

    # sa "So... Tell me what happened yesterday."
    sa "那……跟我说说昨天发生了什么。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:546
translate schinese ep11_fr1_end_label_9228abd9:

    # mc "Let's sit down in my room."
    mc "我们坐到我房间里吧。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:549
translate schinese ep11_fr1_end_label_ccf7abda:

    # mc "But first..."
    mc "但首先..."

# freeroam\episode11\ep11_freeroam_room1_events.rpy:551
translate schinese ep11_fr1_end_label_dc17e0ce:

    # mc "I don't know a lot about nails or cosmetics, but they look pretty."
    mc "我不太懂指甲和化妆品，但它们看起来挺好看的。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:552
translate schinese ep11_fr1_end_label_2feb352a:

    # mc "They match your eyes."
    mc "它们和你的眼睛很配。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:555
translate schinese ep11_fr1_end_label_ae651217:

    # sa "I can't believe you noticed... Thank you."
    sa "我真不敢相信你注意到了……谢谢你。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:562
translate schinese ep11_fr_room_jacob_label_5a020b64:

    # jac "Good, you're here."
    jac "好，你来了。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:564
translate schinese ep11_fr_room_jacob_label_2d66630c:

    # mc "Yeah, I am."
    mc "对，我在。"

# freeroam\episode11\ep11_freeroam_room1_events.rpy:566
