# freeroam\episode11\ep11_freeroam_cabin_events.rpy:10
translate schinese ep11_trip_label_41f12694:

    # mc "Are we there yet?"
    mc "我们到了吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:12
translate schinese ep11_trip_label_521a7073:

    # ji "I told you it was a long drive."
    ji "我跟你说过这趟路程很长。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:14
translate schinese ep11_trip_label_d5bec59b:

    # mc "Yeah, but I didn't picture it being this long."
    mc "嗯，但我就没想它会这么长。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:16
translate schinese ep11_trip_label_9c0b0162:

    # ji "Luckily for you, we're almost there."
    ji "幸好你运气不错，我们快到了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:18
translate schinese ep11_trip_label_081f16c9:

    # mc "The thing is, you said that an hour ago, and now I have trust issues."
    mc "问题是，你刚才说这话已经一小时了，现在我开始怀疑你了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:20
translate schinese ep11_trip_label_ffe5794a:

    # ji "Haha, but we are almost there. There's only one more left turn on this road before we're there."
    ji "哈哈，不过我们快到了。这条路只剩最后一个左转，转完就到了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:22
translate schinese ep11_trip_label_3e87f6df:

    # isa "That one, right?"
    isa "就是那条啊？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:24
translate schinese ep11_trip_label_95a23ed1:

    # ji "Yes, there it is. See, I told you we were almost there."
    ji "对，到了。看见没，我说过我们快到了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:26
translate schinese ep11_trip_label_73342160:

    # mc "How long do we have to drive on that road, though?"
    mc "我们还得在这条路上开多久啊？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:28
translate schinese ep11_trip_label_75aebf2d:

    # ji "We're almost there, haha."
    ji "我们快到了，哈哈。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:33
translate schinese ep11_trip_label_66110168:

    # ji "Look, there it is. And that's Bianca's parents' car."
    ji "看，就是那辆。那是Bianca家的车。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:34
translate schinese ep11_trip_label_b3480b9f:

    # isa "It's beautiful. What a comfy-looking cabin."
    isa "真漂亮。那间小屋看起来挺舒服的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:35
translate schinese ep11_trip_label_eb251f1f:

    # mc "Wow, it's not at all how I had pictured it."
    mc "哇，完全不是我想象中的样子。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:38
translate schinese ep11_trip_label_29f41368:

    # ji "You're going to love it here. I've only been here one time, but it was the best."
    ji "你会喜欢这里的。我只来过一次，但那次真的很棒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:40
translate schinese ep11_trip_label_bd437ef7:

    # bia "Hey, everyone! Welcome!"
    bia "嘿，大家好！欢迎来到这里！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:42
translate schinese ep11_trip_label_19f8d692:

    # bia "How was your trip? Did you remember how to find the place?"
    bia "你这趟旅程怎么样？还记得怎么找到这儿的吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:44
translate schinese ep11_trip_label_b0a65efa:

    # ji "I remembered. It was a fun trip, but longer for some than others."
    ji "我记得。那趟旅程挺有趣的，不过有些人经历得比别人长。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:46
translate schinese ep11_trip_label_0aa5745d:

    # mc "I'm some. It was a long one, yeah. But I'm happy to be here."
    mc "我也是。挺漫长的，没错。但能到这里我很开心。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:48
translate schinese ep11_trip_label_cac8e825:

    # bia "Me too! We're gonna have so much fun!"
    bia "我也是！我们肯定能玩得很开心！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:50
translate schinese ep11_trip_label_c70b7878:

    # bia "Oh! Before I forget. The reception is crap out here."
    bia "哦！我差点忘了。这里的信号差得不行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:51
translate schinese ep11_trip_label_8a11babe:

    # bia "You can find a sweet spot in this area if you're lucky, but I've never gotten more than a single bar."
    bia "这里信号有时候能接上，但运气不好的话连个格子都捞不着。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:52
translate schinese ep11_trip_label_68534939:

    # bia "I hope you're not expecting any important calls."
    bia "希望你别指望能接到什么重要的电话。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:54
translate schinese ep11_trip_label_6c4118ef:

    # isa "Zero bars. I might as well turn the phone off until Sunday."
    isa "零格信号。我干脆在周日之前关机算了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:56
translate schinese ep11_trip_label_db6c4c4f:

    # bia "Yeah, and don't panic. It's a 20-minute drive to the nearest town if you need it."
    bia "对，别慌。如果需要的话，最近的镇子开车只要20分钟。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:59
translate schinese ep11_trip_label_7951e3ca:

    # ji "Is Matthew here?"
    ji "Matthew在吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:61
translate schinese ep11_trip_label_6da3c31c:

    # bia "He had to cancel. Can you believe it?"
    bia "他不得不取消。你能相信吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:62
translate schinese ep11_trip_label_615ef4e5:

    # bia "He had a work meeting tomorrow. There was some crisis he had to manage."
    bia "他明天有个工作会议，有个危机他必须处理。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:63
translate schinese ep11_trip_label_499eeca6:

    # bia "It sucks for him, but I wasn't going to skip this trip."
    bia "这对他来说真够惨的，但我可不会因为这个就跳过这次旅行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:65
translate schinese ep11_trip_label_eb18cdae:

    # ji "Aw, that's too bad."
    ji "唉，真可惜。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:68
translate schinese ep11_trip_label_852310ca:

    # bia "Let's get inside. I want to show the newcomers the place."
    bia "我们进去吧。我想带新来的朋友们看看这个地方。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:73
translate schinese ep11_trip_label_ab44cb5a:

    # bia "This is it! Our humble family cabin."
    bia "这就是了！我们家这间简陋的小木屋。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:75
translate schinese ep11_trip_label_13b67524:

    # bia "Ok, it's not that humble. It's modern."
    bia "好吧，它不算太寒酸。挺现代的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:76
translate schinese ep11_trip_label_f9e5753c:

    # bia "But its size makes it somewhat humble."
    bia "但它的规模让它多少显得有点寒酸。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:78
translate schinese ep11_trip_label_4953f496:

    # bia "It's not a big place, but it has what we need."
    bia "它不算大，但够用。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:80
translate schinese ep11_trip_label_99ef401b:

    # bia "Also, beware of this stupid beam; you might hit your head on it if you're not careful."
    bia "还有，小心这根碍事的横梁，一不留神就会撞到头。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:82
translate schinese ep11_trip_label_fd622850:

    # bia "So, this is it. You have the kitchen and dining room over there."
    bia "所以，这就是了。那边是厨房和餐厅。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:84
translate schinese ep11_trip_label_2cf3340a:

    # bia "This is the \"after-ski area\", as Dad loves to call it. It's hands down the best spot in the cabin."
    bia "这是爸爸总爱叫的“滑雪后休息区”，毫无疑问是这间小屋里最好的地方。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:85
translate schinese ep11_trip_label_1d9ad72b:

    # bia "Whenever you see the fire needs it, go ahead and stoke it."
    bia "只要看见火需要添柴，就去添吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:87
translate schinese ep11_trip_label_c9a8a89b:

    # isa "This both smells and sounds lovely."
    isa "这闻起来和听起来都挺棒的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:89
translate schinese ep11_trip_label_388606e2:

    # bia "Doesn't it? My family loves gathering around the fire at night."
    bia "难道不是吗？我家人就爱晚上围着火堆聚在一起。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:91
translate schinese ep11_trip_label_913db3ea:

    # bia "Up that ladder, you'll find a smaller guest room. It's for sleeping purposes only since it's so small."
    bia "往上那架梯子，你还能找到一间小客房。那间房只能用来睡觉，因为实在太小了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:93
translate schinese ep11_trip_label_c44a5545:

    # bia "Behind that door, you will find the master bedroom, toilet, and shower. It's inconvenient since you must pass through the bedroom to get there."
    bia "那扇门后面是主卧、厕所和淋浴间。有点不方便，因为你要穿过卧室才能到那儿。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:94
translate schinese ep11_trip_label_d6be39df:

    # bia "And that's pretty much the place."
    bia "这就是大致情况了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:96
translate schinese ep11_trip_label_a273433e:

    # bia "No, wait! We also have a sauna and hot tub outside. You guys brought bathing suits, right?"
    bia "不，等等！外面还有桑拿房和热水浴池。你们带泳衣了吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:98
translate schinese ep11_trip_label_75277de4:

    # mc "It's outside? But it's freezing."
    mc "在外面？但好冷啊。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:100
translate schinese ep11_trip_label_d9cbe0f3:

    # bia "Have you ever sat in the sauna and bathed in the snow before?"
    bia "你有没有试过在桑拿房里坐着，然后在雪里洗澡？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:102
translate schinese ep11_trip_label_dfdf36b3:

    # mc "No? Who does that? The closest thing I can think of is losing in a snowball fight."
    mc "没听说过？谁会这样？我想到的最接近的情况就是输掉雪球大战。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:104
translate schinese ep11_trip_label_571970a6:

    # ji "You're either going to love or hate it. It's quite the experience."
    ji "你要么爱死它，要么恨死它。绝对是一次特别的体验。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:106
translate schinese ep11_trip_label_cd5ba6f0:

    # isa "I'm going to enjoy watching that."
    isa "我要好好看看那场面。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:109
translate schinese ep11_trip_label_5941fce0:

    # bia "Jill and [name], you guys can take the big bedroom, and I'll bunk up with Bella in the small one."
    bia "Jill 和[name]你们可以睡大房间，我跟贝拉睡小房间。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:110
translate schinese ep11_trip_label_8cbfb676:

    # bia "Is that ok for everyone?"
    bia "这大家都没意见吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:112
translate schinese ep11_trip_label_41df5c46:

    # isa "That will work fine."
    isa "这样安排没问题。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:116
translate schinese ep11_trip_label_85fb5a6c:

    # bia "I'm not quite sure how we should split the rooms. Any suggestions?"
    bia "我不太确定该怎么分房间，大家有什么建议吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:118
translate schinese ep11_trip_label_e352338b:

    # ji "I think [name] and Bella want a room of their own."
    ji "我想[name]还有贝拉想要一间属于他们自己的房间。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:120
translate schinese ep11_trip_label_8fba3b10:

    # bia "Oh?"
    bia "哦？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:122
translate schinese ep11_trip_label_70630e06:

    # bia "Oh!"
    bia "哦！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:124
translate schinese ep11_trip_label_07256af8:

    # bia "Uhh... Ok, you two take the master bedroom, and Jill and I bunk in the other one."
    bia "嗯……好吧，你们俩住主卧，我和Jill挤另一个。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:126
translate schinese ep11_trip_label_0ab724d3:

    # bia "Sorry, I had no idea that you two were..."
    bia "抱歉，我完全没意识到你们俩..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:128
translate schinese ep11_trip_label_cf33ff07:

    # isa "It's...nothing we flaunt."
    isa "这没什么好炫耀的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:130
translate schinese ep11_trip_label_9a075679:

    # bia "I think it's great. I love both of you guys."
    bia "我觉得这挺棒的，我挺你们俩的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:132
translate schinese ep11_trip_label_fd4d3512:

    # bia "I hope you guys already ate dinner. I thought we could end the night with some cocoa and then get up bright and early for a day full of fun."
    bia "希望你们俩已经吃晚饭了。我想我们今晚可以喝点热可可，然后早早睡一觉，明天一整天都玩个够。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:133
translate schinese ep11_trip_label_28565b4c:

    # bia "Jill, can you help me in the kitchen?"
    bia "Jill，能来厨房帮我一下吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:142
translate schinese ep11_trip_label_68ca0fcb:

    # mc "Our first trip together. Feels nice, doesn't it?"
    mc "我们第一次一起出行。感觉不错，对吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:144
translate schinese ep11_trip_label_92bf7a57:

    # isa "It does feel nice to get away with you."
    isa "和你一起逃开的感觉还真不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:146
translate schinese ep11_trip_label_27deeb1a:

    # mc "You don't mind the company, right?"
    mc "你不会介意和我待在一起吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:148
translate schinese ep11_trip_label_985a253c:

    # isa "Of course not."
    isa "当然不。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:150
translate schinese ep11_trip_label_b3e46ddf:

    # isa "I admit I felt a tad nervous when Bianca realized that we..."
    isa "我承认当Bianca意识到我们..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:151
translate schinese ep11_trip_label_0e2a9e04:

    # isa "That we are together."
    isa "我们在一起。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:153
translate schinese ep11_trip_label_a8d19591:

    # isa "But it also feels good because it means we can be ourselves out here and not hide."
    isa "但这也感觉很好，因为这意味着我们在这里可以做自己，不用藏着掖着。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:155
translate schinese ep11_trip_label_64284b4b:

    # mc "I must admit I felt better when I thought it was ok for us to have a relationship."
    mc "我必须承认，当我想到我们能有一段关系的时候，感觉好多了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:157
translate schinese ep11_trip_label_fb623a7e:

    # isa "..."
    isa "..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:159
translate schinese ep11_trip_label_6c9d6b5b:

    # isa "Let's enjoy the good feeling we get here this weekend, ok?"
    isa "那我们好好享受这个周末带来的感觉吧，好吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:161
translate schinese ep11_trip_label_c4b1932e:

    # mc "Sure. That's why I'm here."
    mc "当然。这就是我为什么在这里的原因。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:165
translate schinese ep11_trip_label_8174f344:

    # isa "*{i}Smack{/i}*"
    isa "*{i}一巴掌{/i}*"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:170
translate schinese ep11_trip_label_999414e6:

    # isa "This would be a nice place to live, don't you think?"
    isa "这地方住着也不错，你觉得呢？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:172
translate schinese ep11_trip_label_e27da102:

    # mc "Out here? Far from everyone? I'm not sure."
    mc "在这里？离其他人这么远？我不确定。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:173
translate schinese ep11_trip_label_66edf8b1:

    # mc "I think it's nice for the weekend, but I'd get lonely."
    mc "我觉得周末在这里挺不错的，但一个人待着可能会觉得寂寞。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:175
translate schinese ep11_trip_label_58303f99:

    # isa "Hm, yes. Maybe a bigger community wouldn't hurt, but this place has its charms."
    isa "嗯，是啊。也许一个更大的社区也不错，不过这个地方也有它吸引人的地方。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:177
translate schinese ep11_trip_label_a7e7a263:

    # mc "If you're moving, can I have your house?"
    mc "如果你搬走，能让我住你家吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:179
translate schinese ep11_trip_label_f3819acc:

    # isa "That would be something, eh?"
    isa "那可就太棒了，对吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:181
translate schinese ep11_trip_label_62056a4a:

    # mc "I'd take good care of your pool."
    mc "我会好好照顾你的泳池。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:183
translate schinese ep11_trip_label_1086418e:

    # isa "You better."
    isa "你最好这样。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:185
translate schinese ep11_trip_label_21d3aa9c:

    # mc "With a place like yours, I wouldn't ever think about moving. It's the perfect house, in my opinion."
    mc "有了你这样的房子，我根本不会考虑搬走。在我看来，这简直是完美的住所。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:187
translate schinese ep11_trip_label_10525e6f:

    # isa "You're too sweet. I love it too, but one can still dream of having a place like this."
    isa "你太甜了。我也很喜欢，但谁说不能梦想拥有这样的地方呢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:189
translate schinese ep11_trip_label_fb1e2ee4:

    # mc "Are you thinking about getting a holiday cabin?"
    mc "你是不是在考虑买个小木屋度假？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:191
translate schinese ep11_trip_label_ecb14dad:

    # isa "I'm not made out of money, [name]. It's just a dream."
    isa "我不是有钱人[name]只是个梦。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:192
translate schinese ep11_trip_label_430998a6:

    # isa "I bet you have those."
    isa "我打赌你有那些。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:194
translate schinese ep11_trip_label_a5bbafc8:

    # mc "Naturally."
    mc "自然。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:196
translate schinese ep11_trip_label_fcfe32ff:

    # bia "Cocoa time! Don't burn yourselves; it's hot as hell!"
    bia "热可可时间！别把自己烧焦了，这玩意儿可他妈的热！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:198
translate schinese ep11_trip_label_ff747497:

    # ji "Here you go. I wasn't sure if you liked marshmallows in yours. But I thought the cup suited you."
    ji "给你。我不确定你喜不喜欢在棉花糖里加棉花糖，不过我觉得这个杯子挺适合你的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:200
translate schinese ep11_trip_label_fb6caf4b:

    # mc "Haha! This is great, thanks."
    mc "哈哈，这太棒了，谢谢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:202
translate schinese ep11_trip_label_906fb02b:

    # bia "How do you like the place, [name]?"
    bia "你觉得这个地方怎么样，[name]?"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:204
translate schinese ep11_trip_label_72092a5c:

    # mc "It's cozy, but it sure gets dark early."
    mc "挺暖和的，不过天黑得真早。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:206
translate schinese ep11_trip_label_f7fd1b9e:

    # bia "Haha, yep! You better not wander off far outside. In a couple of hours, it will be pitch black."
    bia "哈哈，没错！你可别跑太远。再过几个小时，外面就黑得跟晚上一样。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:207
translate schinese ep11_trip_label_698cb122:

    # bia "But if you do wander off, luckily, the cabin lights up like a beacon."
    bia "不过如果你真敢跑出去，幸运的是，小屋的灯光会像灯塔一样亮。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:209
translate schinese ep11_trip_label_fd2acc15:

    # mc "Don't worry. I have no plans on heading outside tonight."
    mc "别担心。我今晚没打算出去。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:211
translate schinese ep11_trip_label_2ec63af1:

    # mc "Bella, haha. You have whipped cream on your nose."
    mc "贝拉，哈哈。你鼻尖上沾了奶油。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:212
translate schinese ep11_trip_label_5a789acd:

    # isa "Oh?"
    isa "哦？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:214
translate schinese ep11_trip_label_8b66e2b2:

    # ji "It's going to be fun to ski tomorrow!"
    ji "明天滑雪可真带劲！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:216
translate schinese ep11_trip_label_5f219d8e:

    # mc "For you, maybe. I'm horrible at it."
    mc "你或许可以，我可完全不擅长。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:218
translate schinese ep11_trip_label_02c7573d:

    # ji "Maybe you're great at it but don't know it yet?"
    ji "也许你其实挺擅长的，只是自己还没意识到？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:220
translate schinese ep11_trip_label_cf8f1b96:

    # mc "When does that ever happen with anything?"
    mc "这什么时候发生过？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:222
translate schinese ep11_trip_label_b8fecae9:

    # isa "You might do well at it. You've got a good balance from martial arts and are in good shape."
    isa "你可能挺擅长的。你从小学习武术，平衡感不错，身体也挺棒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:224
translate schinese ep11_trip_label_0198dfa7:

    # bia "And if you suck, we have a snowmobile you could use instead."
    bia "如果你不行，我们还有雪地摩托可以用。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:226
translate schinese ep11_trip_label_ca2e3387:

    # ji "Haha, don't tell him that. He's going to opt for it."
    ji "哈哈，别告诉他这话。他肯定会选这个。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:228
translate schinese ep11_trip_label_f931d71b:

    # mc "I'd love to try the snowmobile!"
    mc "我真想试试那辆雪地摩托！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:230
translate schinese ep11_trip_label_6e4604fb:

    # bia "Actually, I think it broke. Or ran out of gas. Or maybe both."
    bia "其实它可能坏了。或者没油了。或者两者都有。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:232
translate schinese ep11_trip_label_151ea527:

    # mc "Haha, nice try. I wanna ride it for sure."
    mc "哈哈，你这招不错。我正想骑它呢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:234
translate schinese ep11_trip_label_4a3546f4:

    # ji "See what you did? Now, we don't get the pleasure to see [name] fall in the snow skiing."
    ji "看到你干的好事？现在，我们再也享受不到看[name]在雪地滑雪时摔倒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:236
translate schinese ep11_trip_label_71dd263a:

    # mc "Hey, you thought I'd be great at it!"
    mc "嘿，你以为我会很擅长这事儿？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:237
translate schinese ep11_trip_label_c3ae8615:

    # ji "Hahaha!"
    ji "哈哈哈！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:254
translate schinese ep11_trip_label_19f12771:

    # ji "Good morning."
    ji "早上好。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:256
translate schinese ep11_trip_label_c03a63aa:

    # mc "No... Is it morning already?"
    mc "不...已经早上了吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:258
translate schinese ep11_trip_label_119b26f9:

    # ji "We said bright and early."
    ji "我们一大早就说好了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:260
translate schinese ep11_trip_label_dcc0eed8:

    # mc "I could use two more hours..."
    mc "我还能再撑两小时..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:262
translate schinese ep11_trip_label_48a3bfd3:

    # ji "If you do, those two hours get deducted from snowmobile time."
    ji "如果你这么做了，那两个小时就从雪地摩托的时间里扣掉了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:264
translate schinese ep11_trip_label_8dda849b:

    # mc "Ok, I'm up!"
    mc "好的，我醒了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:266
translate schinese ep11_trip_label_8ce1113b:

    # ji "Haha!"
    ji "哈哈！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:268
translate schinese ep11_trip_label_9a0641ef:

    # ji "I'm looking forward to today. I've been waiting for this moment with you."
    ji "我今天可期待了，一直等着和你一起的这一刻。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:269
translate schinese ep11_trip_label_02c4092a:

    # ji "To be able to turn you around on winter. I feel like I will be able to do that today."
    ji "能在冬天里让你转个身。我觉得今天我就能做到。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:271
translate schinese ep11_trip_label_0679c95a:

    # mc "Are you that confident that I will like it?"
    mc "你这么确定我会喜欢？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:273
translate schinese ep11_trip_label_8def0651:

    # ji "I am."
    ji "我就是。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:275
translate schinese ep11_trip_label_bdc45eb3:

    # mc "I love seeing you confident."
    mc "我喜欢看你这么自信的样子。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:277
translate schinese ep11_trip_label_b7b0a066:

    # ji "Let's see if the others are awake."
    ji "我们看看其他人有没有醒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:284
translate schinese ep11_trip_label_323d26c9:

    # isa "[name]?"
    isa "[name]?"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:286
translate schinese ep11_trip_label_8395faf1:

    # mc "Mmm... Yeah?"
    mc "嗯……是啊？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:288
translate schinese ep11_trip_label_fada2257:

    # isa "Wake up."
    isa "醒来。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:290
translate schinese ep11_trip_label_87126b09:

    # mc "Woke up a little earlier for me, huh?"
    mc "为了陪我，今天醒得早了一点，是吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:292
translate schinese ep11_trip_label_8f2d8eb2:

    # isa "You wish. It's time to head up. I heard Jill and Bianca wake up already."
    isa "你可真会说。该起床了，我听说Jill和Bianca已经醒了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:294
translate schinese ep11_trip_label_acaceea3:

    # mc "I feel like it's too early. I'm gonna need some more sleep."
    mc "我觉得现在还太早，我得再睡一会儿。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:296
translate schinese ep11_trip_label_8b46965e:

    # isa "Maybe you can take a nap later in the afternoon. Let's make the most out of this day."
    isa "也许你下午可以小睡一会儿。咱们今天可得好好利用起来。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:298
translate schinese ep11_trip_label_59ab59f4:

    # mc "*{i}Yawns{/i}* Yeah, you're right."
    mc "*{i}哈欠{/i}*是的，你说得对。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:304
translate schinese ep11_trip_label_bbf4384a:

    # bia "Good morning, guys! Breakfast is served. Help yourselves."
    bia "早上好，大家！早餐已经准备好了，自取吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:306
translate schinese ep11_trip_label_482c4245:

    # bia "Did you sleep well?"
    bia "睡得怎么样？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:308
translate schinese ep11_trip_label_3e03abe8:

    # mc "Like a log. I closed my eyes for one second, and suddenly, it was time to get up."
    mc "像块木头一样。我闭上眼一秒，突然就该起床了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:310
translate schinese ep11_trip_label_c7b236b6:

    # bia "We were just discussing ski boots. What size shoes are you? 9, 9.5?"
    bia "我们刚才在讨论滑雪靴。你穿几码鞋？9码，还是9.5码？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:312
translate schinese ep11_trip_label_80317ce8:

    # mc "No. More like 10.5 or 11. It depends on the shoe."
    mc "不是，大概10.5码或11码，取决于鞋型。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:314
translate schinese ep11_trip_label_65384a9d:

    # bia "No way they are that big. Show me."
    bia "不可能那么大，给我看看。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:321
translate schinese ep11_trip_label_b1bcb21f:

    # mc "Yep, they are. I have a wide foot. It can be hard to find shoes that fit for me."
    mc "嗯，是的，我脚确实大。我脚型比较宽，找合脚的鞋子挺难的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:323
translate schinese ep11_trip_label_752bf867:

    # bia "Whoa, no kidding! Hahaha! They don't look that big from a glance, but they are."
    bia "哇，真的假的！哈哈哈！光看一眼好像没那么大，但其实真的挺大的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:327
translate schinese ep11_trip_label_bbfd52df:

    # mc "They're big, trust me."
    mc "它们确实很大，信我。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:329
translate schinese ep11_trip_label_100ddd0e:

    # bia "Alright."
    bia "行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:330
translate schinese ep11_trip_label_d68c90ee:

    # bia "We have a few pairs here; I'm hoping one of them will be your size. My Dad and uncles keep some boots here for skiing."
    bia "我们这儿有几双；希望其中有一双合你的脚。我爸爸和叔叔们为了滑雪留了些靴子在这里。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:331
translate schinese ep11_trip_label_5bb35d61:

    # bia "If they don't fit, we'll have to head into town."
    bia "如果鞋子不合适，我们就得去镇上一趟。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:333
translate schinese ep11_trip_label_853c5763:

    # mc "Or I'll ride the snowmobile all day. Win-win."
    mc "要不然我就整天骑雪地摩托。双赢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:335
translate schinese ep11_trip_label_a70617f0:

    # ji "And here I was, hoping he'd forget about that snowmobile."
    ji "而我正盼着他能忘记那辆雪地摩托。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:337
translate schinese ep11_trip_label_64c6b711:

    # bia "I promise you'll get to ride it. But you're not getting out of skiing."
    bia "我保证你一定能骑上它。但你可别想逃过滑雪这一关。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:342
translate schinese ep11_trip_label_0f76111f:

    # ji "Did you find ones that fit?"
    ji "你找到合适的一双了吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:344
translate schinese ep11_trip_label_f162e54e:

    # mc "They are tight, but yeah, they fit."
    mc "它们有点紧，但确实合脚。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:346
translate schinese ep11_trip_label_06132861:

    # isa "Looking good, [name]. Those sunglasses will at least make you look cool when you fall."
    isa "看起来不错，[name]那副墨镜至少能让你在摔倒时看起来有点酷。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:348
translate schinese ep11_trip_label_bbe74be2:

    # mc "Well, you gotta crash with style."
    mc "那就要摔得有范儿点。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:350
translate schinese ep11_trip_label_c155ead5:

    # ji "Shall we head for the tracks?"
    ji "我们去滑雪道吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:352
translate schinese ep11_trip_label_ba148974:

    # mc "The tracks?"
    mc "滑雪道？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:354
translate schinese ep11_trip_label_8b1c075e:

    # isa "Ski trails. You wouldn't want to ski through snow without them."
    isa "滑雪道。你可不想在雪地里滑雪时没有它们。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:356
translate schinese ep11_trip_label_4122d152:

    # bia "They loop around these woods with several nice stops along the way."
    bia "他们会在这些树林里绕一圈，沿途还有几个不错的停留点。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:357
translate schinese ep11_trip_label_54ec16b4:

    # bia "We'll get to see nature and great views today."
    bia "今天我们可以欣赏自然风光和绝佳的景色。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:359
translate schinese ep11_trip_label_d6fc7b51:

    # ji "Are you getting excited?"
    ji "你是不是有点兴奋了？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:361
translate schinese ep11_trip_label_35248586:

    # mc "I have zero expectations, but it sounds good."
    mc "我没抱太大期望，但听起来不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:363
translate schinese ep11_trip_label_2d35fbd5:

    # bia "Put your skis on! It's go time."
    bia "穿上滑雪板！出发了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:366
translate schinese ep11_trip_label_dae77da7:

    # bia "Woho!"
    bia "哇哦！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:368
translate schinese ep11_trip_label_1a46baad:

    # mc "And off she goes."
    mc "她一溜烟就冲出去了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:370
translate schinese ep11_trip_label_3a4d7691:

    # ji "Don't feel stressed. That's what's good about a track. It leads us to the same place."
    ji "别紧张。这就是滑道的好处，它会把我们带到同一个地方。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:372
translate schinese ep11_trip_label_3eb1b645:

    # isa "And besides, we don't want to crash into each other. It's smart to keep some distance."
    isa "况且，我们可不想撞上彼此。保持一点距离挺聪明的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:377
translate schinese ep11_trip_label_720198c6:

    # isa "Have fun, guys. I'll get out of your hair."
    isa "玩得开心点，伙计们。我先走了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:379
translate schinese ep11_trip_label_c58c0dd4:

    # ji "You don't have to wait for me. I'll catch up."
    ji "你不用等我，我会追上来的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:381
translate schinese ep11_trip_label_1d8c1cfe:

    # mc "Ok, but I don't think there will be much to catch up to. I've never done this before."
    mc "好，但我觉得我们之间也没什么好追的。我以前从来没做过这种事。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:383
translate schinese ep11_trip_label_c5a4317c:

    # ji "Try your best to move forward and we'll take it from there."
    ji "尽力往前走，我们接着来。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:387
translate schinese ep11_trip_label_1a4b8ce5:

    # ji "How's your balance?"
    ji "你平衡感怎么样？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:388
translate schinese ep11_trip_label_25fce9ca:

    # mc "I feel sluggish."
    mc "我感觉有点迟钝。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:390
translate schinese ep11_trip_label_4663cb40:

    # ji "You don't have to move your feet a lot."
    ji "你不用把脚动太多。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:391
translate schinese ep11_trip_label_df040b41:

    # ji "Bend your knees and lean forward. Let your body work together with your arms."
    ji "弯曲膝盖，身体前倾，让手臂和身体协调配合。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:395
translate schinese ep11_trip_label_67b9b691:

    # mc "I think I got it."
    mc "我想我明白了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:398
translate schinese ep11_trip_label_c6f1863c:

    # mc "Whoa!"
    mc "哇！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:400
translate schinese ep11_trip_label_cfeb2d34:

    # ji "Be careful. It's easy to lose your balance."
    ji "小心点。很容易失去平衡。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:402
translate schinese ep11_trip_label_23e877c5:

    # mc "I can tell. It will take me some time to get used to this."
    mc "我能感觉到。我得花点时间才能适应这种感觉。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:404
translate schinese ep11_trip_label_692d303b:

    # ji "Take it at your own pace."
    ji "按你自己的节奏来。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:406
translate schinese ep11_trip_label_ac68d9c5:

    # mc "They're already so far ahead. I can't even see them anymore."
    mc "他们已经远远地超前了，我连影子都看不见了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:407
translate schinese ep11_trip_label_79dc11d2:

    # ji "Haha, don't worry about them. Focus on having a good time."
    ji "哈哈，别管他们了。放松点，享受一下吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:411
translate schinese ep11_trip_label_f1e3f719:

    # mc "This view is pretty good."
    mc "这景色不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:413
translate schinese ep11_trip_label_bc8451e4:

    # ji "Not too shabby, huh?"
    ji "还不错吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:415
translate schinese ep11_trip_label_22f5a5ca:

    # mc "Nope. But I can already feel the burn in my arms."
    mc "不，但我已经能感觉到手臂开始酸了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:417
translate schinese ep11_trip_label_53765345:

    # ji "Try to use your body more. That way, your arms won't get as tired."
    ji "多用身体的力量，这样手臂就不会那么累了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:418
translate schinese ep11_trip_label_b056dc09:

    # ji "And don't forget to glide. You don't have to rush forward."
    ji "别忘了滑行，不用急着往前冲。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:420
translate schinese ep11_trip_label_bf800603:

    # mc "Uh oh... There's a slope incoming."
    mc "哎呀……有个坡道要来了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:422
translate schinese ep11_trip_label_b6c359f5:

    # ji "That's great! Just focus on keeping your balance and let the slope carry you forward. Lean into it; don't stand straight."
    ji "不错！只要保持平衡，让坡道带着你前进就行。往坡道那边倾一点，别站着直挺挺的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:424
translate schinese ep11_trip_label_c6f1863c_1:

    # mc "Whoa!"
    mc "哇！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:427
translate schinese ep11_trip_label_82b726d6:

    # mc "No! No! No!"
    mc "不！不！不！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:429
translate schinese ep11_trip_label_b114355f:

    # ji "Don't stand straight!"
    ji "别站直！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:432
translate schinese ep11_trip_label_f050dd74:

    # mc "AH!!!"
    mc "啊！！！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:434
translate schinese ep11_trip_label_232c3437:

    # ji "Hahaha! Are you ok?"
    ji "哈哈哈！你没事吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:436
translate schinese ep11_trip_label_caddec45:

    # mc "I could have hurt myself badly and you're laughing at me."
    mc "我差点把自己弄伤了，你却还笑我。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:438
translate schinese ep11_trip_label_898e0342:

    # ji "Are you badly hurt?"
    ji "你伤得重吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:440
translate schinese ep11_trip_label_0038576b:

    # mc "No, I'm fine."
    mc "不，我没事。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:442
translate schinese ep11_trip_label_7c4a9749:

    # ji "Haha! It looked too funny."
    ji "哈哈哈！那样子看起来太好笑了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:444
translate schinese ep11_trip_label_6bd96a17:

    # mc "I couldn't keep my balance at all."
    mc "我完全失去了平衡。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:446
translate schinese ep11_trip_label_349a5590:

    # ji "The slope was a new thing for you. Try it again and don't go too fast."
    ji "这坡子对你来说是新玩意儿。再试一次，别跑得太快。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:448
translate schinese ep11_trip_label_d59a8a4d:

    # ji "We all fall sometimes. Honestly, I'm impressed you lasted this long."
    ji "我们都会摔跤。说实话，你能撑这么久，我挺佩服的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:449
translate schinese ep11_trip_label_f5f3844c:

    # ji "My first time, I fell on my butt once every minute."
    ji "我第一次玩的时候，每分钟都得摔一跤。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:451
translate schinese ep11_trip_label_e5b29c79:

    # mc "Thanks, that feels better to hear."
    mc "谢谢，听到这话感觉好多了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:453
translate schinese ep11_trip_label_bab6e6e7:

    # ji "Granted, I was five years old at the time, but still."
    ji "说真的，我当时才五岁，但这也算不上什么借口。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:455
translate schinese ep11_trip_label_abad741a:

    # mc "Ok, enough out of you."
    mc "好，轮到你们了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:457
translate schinese ep11_trip_label_8e2e9007:

    # ji "Hahaha! Let's get back at it."
    ji "哈哈哈！我们继续吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:461
translate schinese ep11_trip_label_18ba4fff:

    # ji "I'm going to catch up with Bianca. See you guys later!"
    ji "我要去追上Bianca。待会儿见啦。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:463
translate schinese ep11_trip_label_52df57e4:

    # mc "Ok, here we go..."
    mc "好，我们开始了..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:465
translate schinese ep11_trip_label_f2cda05f:

    # isa "What level of amateur are you?"
    isa "你到底有多业余？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:467
translate schinese ep11_trip_label_a51faf56:

    # mc "Was that an insult or a question?"
    mc "那是嘲讽还是在问问题？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:469
translate schinese ep11_trip_label_7e16e33d:

    # isa "A question, of course."
    isa "当然是一句问话。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:470
translate schinese ep11_trip_label_94f17e7f:

    # isa "Do you know how to move forward?"
    isa "你知道怎么往前走吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:472
translate schinese ep11_trip_label_c99660aa:

    # mc "I've seen how it's done, but that's about it."
    mc "我看过别人是怎么做的，但也就到此为止了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:473
translate schinese ep11_trip_label_12f7c336:

    # mc "I guess I use my arms to push myself forward."
    mc "我想我只能用胳膊往前推。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:475
translate schinese ep11_trip_label_8ecac147:

    # isa "You will fatigue if you only use your arms. Bend your knees and activate your core, too."
    isa "你光用胳膊推的话会累的。膝盖要弯曲，核心肌群也得发力。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:478
translate schinese ep11_trip_label_78bd071e:

    # isa "There you go."
    isa "搞定。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:479
translate schinese ep11_trip_label_17b9feac:

    # mc "Hey, it's working."
    mc "好家伙，这玩意儿真管用。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:481
translate schinese ep11_trip_label_2b4e093a:

    # isa "You can also skate by alternating right and left, like when you're running."
    isa "你也可以左右交替滑动，就像跑步一样。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:482
translate schinese ep11_trip_label_167c407a:

    # isa "Don't lift your feet, though. Keep the skis glued to the ground and slide forward."
    isa "别把脚抬起来，保持滑雪板贴着地面，向前滑动。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:484
translate schinese ep11_trip_label_33d44504:

    # mc "This is tricky. I feel like I'm super slow."
    mc "这挺难的。我感觉我超级慢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:485
translate schinese ep11_trip_label_6082c8d3:

    # isa "It's not a race. Enjoy yourself."
    isa "这又不是比赛，放松点享受吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:489
translate schinese ep11_trip_label_c6781ec7:

    # mc "I gotta say, this view is great. Have you done this a lot?"
    mc "这景色真棒，你经常这样滑吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:491
translate schinese ep11_trip_label_38bc6451:

    # isa "Not as often as I'd like, but I've been on ski trips before."
    isa "没那么频繁，但我以前也去过几次滑雪旅行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:492
translate schinese ep11_trip_label_d57f266e:

    # isa "I prefer to ski downhill, but this has its appeal too. It's much more relaxing."
    isa "我更喜欢高山滑雪，不过这种也别有乐趣，轻松多了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:493
translate schinese ep11_trip_label_de9ba065:

    # isa "It's fun and you get free exercise while you're at it."
    isa "这挺好玩的，还能顺便锻炼一下。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:495
translate schinese ep11_trip_label_bf800603_1:

    # mc "Uh oh... There's a slope incoming."
    mc "哎呀……有个坡道要来了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:497
translate schinese ep11_trip_label_6ca17cbf:

    # isa "Don't skate on the slope. Focus on keeping your balance and rest your arms."
    isa "别在斜坡上滑行。注意保持平衡，手臂放松。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:499
translate schinese ep11_trip_label_16a850c8:

    # mc "Bella, it's going too fast!"
    mc "贝拉，你骑得太快了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:501
translate schinese ep11_trip_label_65381067:

    # isa "Don't stand up straight! You will fall!"
    isa "别站直了！你会摔的！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:504
translate schinese ep11_trip_label_7b41bb8e:

    # mc "AHHH!!!"
    mc "啊啊啊！！！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:506
translate schinese ep11_trip_label_408ac01a:

    # isa "Are you taking a break already?"
    isa "你是不是已经撑不住了？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:508
translate schinese ep11_trip_label_1369f388:

    # mc "I fell on my ass... Ow..."
    mc "我摔了个屁股墩……痛……"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:510
translate schinese ep11_trip_label_1cc08634:

    # isa "Don't panic next time. Keep leaning into it and you won't fall like that."
    isa "别下次再慌了。继续往那边倾倒，就不会这样摔了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:512
translate schinese ep11_trip_label_6e764235:

    # mc "I was going pretty damned fast."
    mc "我刚才跑得还挺快的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:514
translate schinese ep11_trip_label_c10cc2c1:

    # isa "Not really."
    isa "不是真的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:516
translate schinese ep11_trip_label_1b4f2331:

    # isa "Do it again. There's still some slope left to go."
    isa "再来一次。还有坡道没走完呢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:522
translate schinese ep11_trip_label_b8e0c897:

    # bia "There you are!"
    bia "在那儿了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:524
translate schinese ep11_trip_label_80133c58:

    # bia "We were worried we had lost you. We were about to turn back to search."
    bia "我们担心你丢了，都准备回去搜寻了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:526
translate schinese ep11_trip_label_b7f63224:

    # mc "This is exhausting. It's way more intense than running."
    mc "太累人了，比跑步剧烈多了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:528
translate schinese ep11_trip_label_6b41e7e5:

    # isa "You're activating new muscles; it's understandable."
    isa "你正在激活新的肌肉，这很正常。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:531
translate schinese ep11_trip_label_57a47f07:

    # bia "At least you made it here. Now, you get to enjoy a break at the perfect spot."
    bia "至少你们终于到了这里。现在可以在这完美的地方好好休息一下了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:538
translate schinese ep11_trip_break_label_064e707e:

    # bia "Who wants lunch?"
    bia "谁想吃午饭？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:540
translate schinese ep11_trip_break_label_bcdd7419:

    # ji "Me, please."
    ji "我。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:542
translate schinese ep11_trip_break_label_47ee0053:

    # bia "Let's eat and then work on getting back home."
    bia "我们先吃点东西，然后想办法回去。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:543
translate schinese ep11_trip_break_label_000e936f:

    # bia "It usually takes longer to get back than to get here."
    bia "回来通常比去那里要花更长时间。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:545
translate schinese ep11_trip_break_label_80bfed50:

    # bia "And with some of us going slower, I think we shouldn't wait too long."
    bia "有些人走慢了，我觉得我们不应该等太久。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:548
translate schinese ep11_trip_break_label_7a9a0c08:

    # mc "You can say my name, you know?"
    mc "你可以直接叫我的名字，知道吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:581
translate schinese ep11_trip_view_label_0f149da7:

    # mc "This view is incredible."
    mc "这景色简直绝了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:583
translate schinese ep11_trip_view_label_12661519:

    # bia "It's amazing, isn't it? It's hard to grow tired of it."
    bia "太美了，对吧？怎么也看不腻。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:585
translate schinese ep11_trip_view_label_dd8e7436:

    # mc "Have you been here a lot?"
    mc "你经常来这儿吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:587
translate schinese ep11_trip_view_label_4fa65642:

    # bia "Yeah, many times. My family shares the cabin. Everyone helps out with it."
    bia "嗯，很多次。我家人一起住这间小屋，大家都帮忙照看。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:588
translate schinese ep11_trip_view_label_9dc77cb5:

    # bia "It has become a tradition to stay here a few times every year."
    bia "这里每年都会来几次，已经成了传统。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:590
translate schinese ep11_trip_view_label_cea4e320:

    # mc "It's so beautiful. You're lucky to have this."
    mc "这地方真漂亮。你真是幸运能拥有这样的地方。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:592
translate schinese ep11_trip_view_label_7deb9043:

    # bia "It's a privilege, for sure. I won't forget that."
    bia "这确实是一种特权，我肯定不会忘记。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:602
translate schinese ep11_trip_pic_label_5788634c:

    # mc "(I should take some pictures while we're here.)"
    mc "（我应该趁这个机会拍些照片。）"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:608
translate schinese ep11_trip_pic_label_6a6de7a2:

    # mc "Jill! Over here."
    mc "Jill！这边！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:610
translate schinese ep11_trip_pic_label_0dd6c6ac:

    # ji "What are you up to?"
    ji "你在干嘛？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:612
translate schinese ep11_trip_pic_label_967adfe3:

    # mc "I'm taking some pictures to remember this trip."
    mc "我在拍些照片，好记住这次旅行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:614
translate schinese ep11_trip_pic_label_a1ef66a8:

    # ji "Good idea! Now I want some pictures too."
    ji "好主意！现在我也想拍几张照片。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:620
translate schinese ep11_trip_pic_label_6a6de7a2_1:

    # mc "Jill! Over here."
    mc "Jill！这边！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:622
translate schinese ep11_trip_pic_label_0dd6c6ac_1:

    # ji "What are you up to?"
    ji "你干嘛呢？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:624
translate schinese ep11_trip_pic_label_833db075:

    # mc "I'm taking some pictures to remember this trip by."
    mc "我在拍些照片，好记住这次旅行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:626
translate schinese ep11_trip_pic_label_a1ef66a8_1:

    # ji "Good idea! Now I want some pictures too."
    ji "好主意！现在我也想拍几张照片。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:630
translate schinese ep11_trip_pic_label_d4f97ce2:

    # mc "Smile!"
    mc "笑一个！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:639
translate schinese ep11_trip_pic_label_71744bb5:

    # ji "What are you taking a picture of?"
    ji "你拍的是什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:641
translate schinese ep11_trip_pic_label_62ec3d9b:

    # mc "Uh... A bit of everything."
    mc "嗯……什么都拍一点。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:643
translate schinese ep11_trip_pic_label_bc81f7da:

    # ji "Mhm... *{i}Sigh{/i}*"
    ji "嗯……*{i}叹气{/i}*"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:650
translate schinese ep11_trip_pic_label_dd037c17:

    # mc "Bella! Strike a pose."
    mc "贝拉！摆个姿势。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:656
translate schinese ep11_trip_pic_label_f7befd94:

    # isa "Can you send me the pictures you take?"
    isa "你能发我一下你拍的照片吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:658
translate schinese ep11_trip_pic_label_606e2d02:

    # mc "Sure."
    mc "当然。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:661
translate schinese ep11_trip_pic_label_2803edc4:

    # isa "Taking pictures, are you?"
    isa "你是在拍照吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:664
translate schinese ep11_trip_pic_label_217dec46:

    # mc "I wanted a nice shot of you."
    mc "我想拍张好看的照片给你。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:666
translate schinese ep11_trip_pic_label_05d068e7:

    # mc "I wanted a nice shot of you. You look so cute in that hat."
    mc "我想拍张好看的照片给你。你戴那顶帽子的样子真可爱。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:677
translate schinese ep11_trip_pic_label_2803edc4_1:

    # isa "Taking pictures, are you?"
    isa "你是在拍照吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:679
translate schinese ep11_trip_pic_label_a87a337b:

    # mc "Yep."
    mc "对。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:682
translate schinese ep11_trip_pic_label_c90095b3:

    # isa "Want me to take one of you?"
    isa "要我拍一张你吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:684
translate schinese ep11_trip_pic_label_c9b558b2:

    # mc "Yeah! Take a nice one of me when I stand over here."
    mc "对！给我拍一张我站在这儿时的好照片。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:689
translate schinese ep11_trip_pic_label_e169ff69:

    # isa "(Just as I thought. I'm deleting this one.)"
    isa "（就如我所想的。我删掉这张。）"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:693
translate schinese ep11_trip_pic_label_f1717cbd:

    # isa "(Of Jill too... *{i}Sigh{/i}*)"
    isa "（对Jill也太……*{i}叹气{/i}*)"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:713
translate schinese ep11_trip_pic_label_f78abcf5:

    # isa "All done."
    isa "搞定啦。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:718
translate schinese ep11_trip_pic_label_54e6fb5a:

    # mc "Bianca? Can I get a picture of you?"
    mc "Bianca？能给我拍张你的照片吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:720
translate schinese ep11_trip_pic_label_ade33f18:

    # bia "Oh! Of course! I want one, too."
    bia "哦！当然！我也想要一张。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:730
translate schinese ep11_trip_pic_label_6a8f4786:

    # bia "Did it come out good? I didn't blink, did I?"
    bia "拍得好吗？我没眨眼吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:732
translate schinese ep11_trip_pic_label_cd591057:

    # mc "No, you look good."
    mc "不，你看起来不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:740
translate schinese ep11_trip_pic_label_6a8f4786_1:

    # bia "Did it come out good? I didn't blink, did I?"
    bia "拍得好看吗？我没眨眼吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:742
translate schinese ep11_trip_pic_label_cd591057_1:

    # mc "No, you look good."
    mc "不，你看起来不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:746
translate schinese ep11_trip_pic_label_9ee07f12:

    # bia "Oh! Good idea, let's take one together."
    bia "哦！好主意，我们一起来拍一张吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:752
translate schinese ep11_trip_pic_label_83ad6f33:

    # bia "Haha! Here! Let me see it!"
    bia "哈哈！来！让我看看！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:755
translate schinese ep11_trip_pic_label_38e97178:

    # bia "Stop hogging it!"
    bia "别抢着看！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:762
translate schinese ep11_trip_pic_label_26707fa0:

    # bia "Hey! How about a group picture?"
    bia "嘿！来张合照怎么样？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:764
translate schinese ep11_trip_pic_label_32ac144b:

    # ji "Oh! That will be fun."
    ji "哦！这会很有趣。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:766
translate schinese ep11_trip_pic_label_7daed725:

    # mc "I'll put it on a timer."
    mc "我会设定一个定时器。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:768
translate schinese ep11_trip_pic_label_b5d5a4b3:

    # bia "You don't have to do that with those phones. It's enough if everyone screams cheese."
    bia "你没必要用那些手机这么做。大家只要齐声喊“奶酪”就行了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:770
translate schinese ep11_trip_pic_label_c7997e0b:

    # mc "I didn't know that."
    mc "我都不知道。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:772
translate schinese ep11_trip_pic_label_03d4bfd4:

    # ji "Everyone ready?"
    ji "大家准备好了吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:776
translate schinese ep11_trip_pic_label_0ef011ef:

    # "CHEEESE!!!"
    "奶牛！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:778
translate schinese ep11_trip_pic_label_1c15ee68:

    # bia "I got snow in my eyes; I think I blinked. Let's take another one!"
    bia "我眼睛里有雪；我想我眨了眨眼。再来一张！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:780
translate schinese ep11_trip_pic_label_ec32637c:

    # mc "I'm sure it's fine."
    mc "这应该没问题。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:782
translate schinese ep11_trip_pic_label_3862293f:

    # bia "No! It would be a waste if we didn't look good in the picture."
    bia "不！如果我们拍出来效果不好，那就太浪费了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:784
translate schinese ep11_trip_pic_label_d11cbee8:

    # mc "(Haha! A waste, huh? I'm gonna channel Mom for this one.)"
    mc "（哈哈！浪费，是吧？这次我得装一下我妈。）"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:788
translate schinese ep11_trip_pic_label_0ef011ef_1:

    # "CHEEESE!!!"
    "切！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:790
translate schinese ep11_trip_pic_label_eaa58020:

    # bia "That was better, I think."
    bia "这下好些了，我觉得。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:792
translate schinese ep11_trip_pic_label_3160d5e8:

    # mc "Haha, doubt it."
    mc "哈哈，别怀疑。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:801
translate schinese ep11_trip_jill_label_c570c3e1:

    # mc "The trip here was worth it."
    mc "这趟过来值了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:803
translate schinese ep11_trip_jill_label_688f6a0d:

    # ji "Enjoying winter yet?"
    ji "还喜欢冬天吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:805
translate schinese ep11_trip_jill_label_a2c469c5:

    # mc "You know what? I think I'm getting there."
    mc "你知道吗？我觉得我快要到了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:809
translate schinese ep11_trip_jill_label_7cc13ab0:

    # ji "I'm happy I get to share this with you. It means a lot to me."
    ji "我很高兴能和你一起经历这一切。对我来说意义很大。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:814
translate schinese ep11_trip_jill_label_8cd7a99b:

    # mc "The trip here was definitely worth it."
    mc "这一趟绝对值得。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:816
translate schinese ep11_trip_jill_label_fdfbed52:

    # ji "It sounds like someone is starting to come around on winter."
    ji "听起来有人开始接受冬天了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:818
translate schinese ep11_trip_jill_label_c1ce533c:

    # mc "I think I'm getting there."
    mc "我觉得我开始适应了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:820
translate schinese ep11_trip_jill_label_cd7121bf:

    # ji "Somehow, I knew you'd like it. You just needed to experience something new."
    ji "不知怎么，我早就知道你会喜欢。你只是需要尝试些新东西。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:829
translate schinese ep11_trip_bella_label_49b17929:

    # mc "You know, skiing isn't that bad? I think I've gotten the hang of it."
    mc "你知道吗，滑雪其实没那么糟糕？我觉得我差不多掌握了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:831
translate schinese ep11_trip_bella_label_98c7bca7:

    # isa "Good. Because I talked to Bianca and you'll need some skills for what's up next."
    isa "好，因为你跟Bianca聊过，接下来的事你得有点本事才行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:833
translate schinese ep11_trip_bella_label_c17ef8ec:

    # mc "What's that?"
    mc "什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:835
translate schinese ep11_trip_bella_label_ad9d2f7a:

    # isa "You're looking at it."
    isa "你正看着它。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:837
translate schinese ep11_trip_bella_label_31462164:

    # isa "To get back to the cabin, we need to go downhill all the way to the bottom. And this hill is the only way down."
    isa "要回小屋，必须一路沿坡滑到山脚，而这条坡是唯一下山的路。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:838
translate schinese ep11_trip_bella_label_4be4bc41:

    # mc "ARE YOU KIDDING ME!?"
    mc "你在开玩笑吗！？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:840
translate schinese ep11_trip_bella_label_d680e6b6:

    # mc "Bianca! Is that true? Do I have to ski downhill to get back home?"
    mc "Bianca！真的吗？回家必须一路滑下山？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:842
translate schinese ep11_trip_bella_label_de46c28d:

    # bia "Yep. Sure is."
    bia "对，就是这么回事。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:844
translate schinese ep11_trip_bella_label_3f02b489:

    # mc "I struggle to hold the skis parallel to each other. And I fell multiple times getting here."
    mc "我努力让滑雪板保持平行，但还是摔了好几次才到这儿。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:845
translate schinese ep11_trip_bella_label_2b9d30ca:

    # mc "I think my ass is getting bruises."
    mc "我觉得屁股都要青了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:847
translate schinese ep11_trip_bella_label_90b2374b:

    # mc "There's no way I can do that!"
    mc "我根本不可能做到！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:849
translate schinese ep11_trip_bella_label_7183ca4f:

    # "*{i}Laughter{/i}*"
    "*{i}笑声{/i}*"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:851
translate schinese ep11_trip_bella_label_c2d48315:

    # ji "You guys are so mean to him."
    ji "你们俩对他真够狠的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:853
translate schinese ep11_trip_bella_label_36b0ca76:

    # mc "You're joking... Thanks... I thought you were serious."
    mc "你开玩笑的……谢谢……我刚才还以为你是认真的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:855
translate schinese ep11_trip_bella_label_a2aa9806:

    # bia "You're welcome to go down there if you want, but we'd need to call out for a rescue team if you do."
    bia "你要是想去那儿就去吧，不过要是真去了，我们得叫救援队来救你。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:857
translate schinese ep11_trip_bella_label_312e9fdc:

    # mc "Ok... Good one. You got me."
    mc "哦……好家伙，你真行，把我骗过去了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:866
translate schinese ep11_freeroam_cabin_intro_label_76e3e5c6:

    # mc "*{i}Phew{/i}* Finally..."
    mc "*{i}呼——{/i}*终于..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:868
translate schinese ep11_freeroam_cabin_intro_label_781ee8c6:

    # isa "I had a great time, but it does feel good to be back inside."
    isa "玩得挺开心，不过能回到里面确实感觉不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:870
translate schinese ep11_freeroam_cabin_intro_label_f2a0245f:

    # bia "It's cold in here. Jill, would you mind starting a fire?"
    bia "这里好冷。Jill，你介意生个火吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:872
translate schinese ep11_freeroam_cabin_intro_label_b86d5ca6:

    # ji "Not a problem. I'm on it."
    ji "没问题，我来搞定。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:874
translate schinese ep11_freeroam_cabin_intro_label_55255608:

    # bia "And don't shower yet; I have something planned."
    bia "别急着洗澡；我有个计划。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:876
translate schinese ep11_freeroam_cabin_intro_label_595df346:

    # isa "Then I'll start preparing dinner."
    isa "那我先开始准备晚饭了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:878
translate schinese ep11_freeroam_cabin_intro_label_a866bb9d:

    # bia "Excellent. I have to do some preparations outside. I'll be back when I'm done."
    bia "很好。我得去外面做些准备。等我做完就回来。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:885
translate schinese ep11_cabin_jill_event_label_0606fd57:

    # mc "What a day... I'm beat."
    mc "今天真是累坏了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:888
translate schinese ep11_cabin_jill_event_label_166210ae:

    # ji "You did great today. I'm so proud of you."
    ji "你今天表现得真棒，我为你感到骄傲。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:890
translate schinese ep11_cabin_jill_event_label_2ce0d2b6:

    # mc "You're proud of me? What for?"
    mc "你为我感到骄傲？为什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:892
translate schinese ep11_cabin_jill_event_label_90ef3621:

    # ji "You dared to try new things just like that."
    ji "你敢这么直接地尝试新事物。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:894
translate schinese ep11_cabin_jill_event_label_b018aaf6:

    # ji "It made me very happy. My feelings for you grew when I saw it."
    ji "这让我非常开心。看到你那样，我对你的感觉更深了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:896
translate schinese ep11_cabin_jill_event_label_610ea323:

    # mc "Because I sucked at skiing?"
    mc "因为我在滑雪上一塌糊涂？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:898
translate schinese ep11_cabin_jill_event_label_e69143da:

    # ji "Because of how you handled yourself when you were outside of your comfort zone."
    ji "因为你在舒适区外的表现。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:900
translate schinese ep11_cabin_jill_event_label_44cb0114:

    # ji "I found it attractive."
    ji "我觉得你挺有魅力的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:902
translate schinese ep11_cabin_jill_event_label_54929a8b:

    # mc "Even when I fell down?"
    mc "就算摔了跤呢？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:904
translate schinese ep11_cabin_jill_event_label_25e802b6:

    # ji "Haha, you fell a few times, but you got up and at it again."
    ji "哈哈，你摔了几下，但还是爬起来继续玩。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:908
translate schinese ep11_cabin_jill_event_label_7eef082b:

    # mc "Thanks for bringing me here. It's a shame we have to leave tomorrow."
    mc "谢谢带我来这儿。真可惜明天就要离开了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:910
translate schinese ep11_cabin_jill_event_label_778d04eb:

    # ji "Yeah, the day flew by. But we still have some quality time left tonight."
    ji "是啊，这一天过得飞快。不过我们今晚还有些高质量的相处时间呢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:912
translate schinese ep11_cabin_jill_event_label_f7af3fe9:

    # ji "And you still have a snowmobile to ride, don't you?"
    ji "你还有雪地摩托要骑，对吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:914
translate schinese ep11_cabin_jill_event_label_ae575db8:

    # mc "Oh, yeah! I gotta ask Bianca about that."
    mc "哦，对了！我得问问Bianca那个事。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:917
translate schinese ep11_cabin_jill_event_label_a8d7c6e0:

    # ji "Was it fun riding the snowmobile?"
    ji "骑雪地摩托好玩吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:919
translate schinese ep11_cabin_jill_event_label_fa319102:

    # mc "So much fun!"
    mc "玩得超开心！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:921
translate schinese ep11_cabin_jill_event_label_933e1a54:

    # ji "Oh, I just remembered. I forgot to tell you about something."
    ji "哦，我刚刚想起来，我忘记告诉你一件事了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:924
translate schinese ep11_cabin_jill_event_label_849ec633:

    # ji "Did you have fun?"
    ji "你玩得开心吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:926
translate schinese ep11_cabin_jill_event_label_43eeb63c:

    # mc "Lots."
    mc "好多。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:928
translate schinese ep11_cabin_jill_event_label_d071771b:

    # ji "I'm glad."
    ji "很高兴。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:930
translate schinese ep11_cabin_jill_event_label_09afb406:

    # mc "How about you?"
    mc "你呢？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:932
translate schinese ep11_cabin_jill_event_label_c46b775b:

    # ji "Yes, I love skiing. And I've missed this place. It brought back some nice memories."
    ji "是的，我超爱滑雪。而且我挺想这里的，这里让我想起了一些美好的回忆。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:934
translate schinese ep11_cabin_jill_event_label_60a1ae8c:

    # ji "The fire got pretty hot. Haha..."
    ji "火势搞得挺热的。哈哈..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:943
translate schinese ep11_cabin_jill_event_label_b061a447:

    # mc "So, what's new with you?"
    mc "那你怎么最近？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:946
translate schinese ep11_cabin_jill_event_label_af79ef49:

    # ji "I got offered to play piano at a party."
    ji "有人邀请我在一场聚会上弹钢琴。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:948
translate schinese ep11_cabin_jill_event_label_1b9d5b5f:

    # mc "A party?"
    mc "派对？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:950
translate schinese ep11_cabin_jill_event_label_6ce2e6bc:

    # ji "At an annual faculty Christmas party. Staff, sponsors and others will be there."
    ji "在一年一度的教师圣诞派对上。会有教职工、赞助商和其他人参加。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:951
translate schinese ep11_cabin_jill_event_label_37afdd2e:

    # ji "They usually have some entertainment, and I was asked to play for them."
    ji "他们通常会安排一些娱乐节目，我被邀请去给他们演奏。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:954
translate schinese ep11_cabin_jill_event_label_f257e32f:

    # ji "After what happened at my recital, I felt like it was a question out of pity."
    ji "上次演奏会之后，我感觉那问题像是出于同情才问的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:956
translate schinese ep11_cabin_jill_event_label_c80871f1:

    # mc "Come on, that can't be why they asked you."
    mc "别傻了，那肯定不是他们请你来的理由。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:958
translate schinese ep11_cabin_jill_event_label_a37789ab:

    # ji "Maybe it wasn't, but it's what I keep thinking. I don't think I will go through with it."
    ji "也许不是，但这就是我一直在想的。我觉得自己可能撑不下去。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:960
translate schinese ep11_cabin_jill_event_label_eca982e1:

    # mc "Are you scared you won't be able to do it?"
    mc "你怕自己做不到吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:962
translate schinese ep11_cabin_jill_event_label_0947e8cb:

    # ji "Yes. What do you think I should do?"
    ji "是的。你觉得我应该怎么做？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:966
translate schinese ep11_cabin_jill_event_label_29a27c63:

    # mc "I think you should give it another try. It's what you want, and if there's another chance to do it, why not?"
    mc "我觉得你再试一次吧。这是你想要的，而且如果还有机会的话，为什么不去试试呢？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:968
translate schinese ep11_cabin_jill_event_label_2b5edff9:

    # ji "I just don't want to panic again. And I can feel that I will."
    ji "我只是不想再慌了。我能感觉到我快要撑不住了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:969
translate schinese ep11_cabin_jill_event_label_1173bddf:

    # ji "But this time, it will be a smaller audience, and it won't be on a stage - it will be background entertainment."
    ji "但这次观众会少一些，而且不会在舞台上——它只是背景音乐。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:970
translate schinese ep11_cabin_jill_event_label_d37aa80e:

    # ji "I'd sit there playing music while they talk to each other. I barely think they'd stop to listen."
    ji "我就坐在那儿弹琴，他们互相聊天。我几乎不敢相信他们会停下来听。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:972
translate schinese ep11_cabin_jill_event_label_a77c1c5b:

    # mc "Isn't that perfect? If you're not the center of attention, maybe it won't be as stressful."
    mc "这不完美吗？如果你不是焦点，也许就不会那么紧张了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:974
translate schinese ep11_cabin_jill_event_label_281adcfa:

    # ji "Perhaps."
    ji "也许吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:976
translate schinese ep11_cabin_jill_event_label_ea32cd7f:

    # mc "And if it's background entertainment only, you could walk away whenever."
    mc "而且如果只是背景音乐的话，你随时可以走开。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:978
translate schinese ep11_cabin_jill_event_label_5f7b58a8:

    # ji "It's still scary. But I know I have to push myself... I want to."
    ji "还是挺吓人的。但我知道我必须逼自己一把……我想试试看。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:980
translate schinese ep11_cabin_jill_event_label_df7d4a39:

    # ji "The recital was so scary for me. My entire body and mind screamed no."
    ji "那次演出对我来说太可怕了。我的全身和脑海都在喊着不要。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:981
translate schinese ep11_cabin_jill_event_label_629aea71:

    # ji "I've regretted it a lot. If I had another shot at it, I would have forced myself to play."
    ji "我后悔了好多次。如果再给我一次机会，我会强迫自己上台表演。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:983
translate schinese ep11_cabin_jill_event_label_ab6872d3:

    # mc "Then do it now. It's your chance."
    mc "现在就做吧。这是你的机会。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:985
translate schinese ep11_cabin_jill_event_label_86b93d76:

    # ji "We'll see."
    ji "我们走着瞧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:987
translate schinese ep11_cabin_jill_event_label_487e8bbb:

    # mc "You're a great pianist, regardless of whether you perform or not."
    mc "你就算不上台也是一名出色的钢琴家。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:989
translate schinese ep11_cabin_jill_event_label_7ba52ee1:

    # mc "I think you should listen to your gut. What does it tell you?"
    mc "我觉得你应该听从自己的直觉。它在告诉你什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:991
translate schinese ep11_cabin_jill_event_label_90d805cc:

    # ji "It tells me the same thing that it did at the recital. My body and mind scream no."
    ji "它告诉我和那次演出时一样的话。我的身体和大脑都在尖叫着说“不”。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:992
translate schinese ep11_cabin_jill_event_label_fc492b78:

    # ji "But I've regretted it a lot. That I never went up on stage to perform."
    ji "但我一直很后悔。我从未走上舞台表演。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:993
translate schinese ep11_cabin_jill_event_label_ffb74f3d:

    # ji "I know I was ready to do it, but I didn't get to show everyone that I could do it."
    ji "我知道我当时已经准备好了，但没能让大家看到我能做到什么。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:995
translate schinese ep11_cabin_jill_event_label_0496e6e9:

    # ji "Right now, I feel torn. I don't want to fail again because that would feel like a nail in the coffin."
    ji "现在我感觉很纠结。我不想再失败了，因为那样感觉就像在棺材上钉了一颗钉子。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:996
translate schinese ep11_cabin_jill_event_label_71f1fa51:

    # ji "But I want to try it again."
    ji "但我还是想再试一次。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:998
translate schinese ep11_cabin_jill_event_label_8b1dae2d:

    # mc "Only you can decide if you want to do it or not."
    mc "只有你自己能决定要不要做这件事。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:999
translate schinese ep11_cabin_jill_event_label_cbf51131:

    # mc "Don't feel forced to prove a point. You're a great pianist, regardless of whether you perform or not."
    mc "别觉得非要证明什么。不管你有没有上台，你都是个很棒的钢琴家。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1004
translate schinese ep11_cabin_jill_event_label_57ddd3d5:

    # mc "That's great news! Are you doing it?"
    mc "这太好了！你准备好了吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1006
translate schinese ep11_cabin_jill_event_label_509bcf3a:

    # ji "Yes, I am. I want to feel that high again."
    ji "是的，我要。我想再感受那种感觉。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1007
translate schinese ep11_cabin_jill_event_label_a00e578f:

    # ji "It's still scary, but I know I can do it, thanks to you."
    ji "虽然还是有点害怕，但我知道我能做到，多亏了你。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1009
translate schinese ep11_cabin_jill_event_label_0ab06730:

    # mc "I just gave you the encouragement you needed. You did all the work."
    mc "我只是给了你需要的鼓励，你做了所有的工作。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1011
translate schinese ep11_cabin_jill_event_label_77a6d0a3:

    # ji "No. You did more than that."
    ji "你没错，你做得更多。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1012
translate schinese ep11_cabin_jill_event_label_883b556d:

    # ji "And I'll never forget it."
    ji "我永远不会忘记。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1019
translate schinese ep11_cabin_jill_event_label_bd797ba0:

    # ji "..."
    ji "..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1031
translate schinese ep11_cabin_bianca_event_label_147e0a89:

    # bia "Almost..."
    bia "几乎..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1033
translate schinese ep11_cabin_bianca_event_label_0c30051f:

    # bia "Hngn... Come on... Come on..."
    bia "哼... 来了... 来了..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1034
translate schinese ep11_cabin_bianca_event_label_90f2e6f5:

    # mc "Taking a selfie?"
    mc "拍自拍？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1036
translate schinese ep11_cabin_bianca_event_label_14bc262f:

    # bia "Haha, no! I'm trying to get a bar, but today is a bad day."
    bia "哈哈，不！我正想拍个照，但今天真是个糟糕的日子。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1037
translate schinese ep11_cabin_bianca_event_label_cac66016:

    # bia "Screw it. My phone will have to wait until tomorrow."
    bia "管他呢。我的手机得等到明天再说。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1039
translate schinese ep11_cabin_bianca_event_label_0b96cd33:

    # mc "Is it important?"
    mc "这重要吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1041
translate schinese ep11_cabin_bianca_event_label_89eb328f:

    # bia "Not really. I wanna check if I got any messages or missed calls."
    bia "不怎么重要。我想看看有没有消息或者未接来电。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1043
translate schinese ep11_cabin_bianca_event_label_7caea147:

    # bia "Whoa!!!"
    bia "哇！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1046
translate schinese ep11_cabin_bianca_event_label_7cb5e145:

    # bia "Wow! Quick thinking."
    bia "哇！反应真快。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1048
translate schinese ep11_cabin_bianca_event_label_f4991eb8:

    # mc "All good?"
    mc "都好？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1050
translate schinese ep11_cabin_bianca_event_label_4e079052:

    # bia "Yeah, thanks!"
    bia "对，谢谢！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1052
translate schinese ep11_cabin_bianca_event_label_bb2e81d6:

    # bia "Oh! [name]! I almost forgot. Follow me."
    bia "哦！[name]我差点忘了。跟上我。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1055
translate schinese ep11_cabin_bianca_event_label_bf7f0df5:

    # bia "Cool, huh!?"
    bia "酷毙了！？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1056
translate schinese ep11_cabin_bianca_event_label_f2ab88a6:

    # mc "Wow! So cool."
    mc "哇！真酷！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1058
translate schinese ep11_cabin_bianca_event_label_d935b3c6:

    # bia "Wanna take it for a spin before it gets too dark?"
    bia "要不要现在就骑上去兜一圈，等天黑了就来不及了？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1059
translate schinese ep11_cabin_bianca_event_label_be01c22c:

    # mc "Will you let me borrow it? I never rode one before."
    mc "你会让我借一下吗？我从来没骑过这种东西。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1060
translate schinese ep11_cabin_bianca_event_label_daa407e5:

    # bia "Sure! But I'm coming with you. I can't risk you getting lost."
    bia "当然！不过我要跟你一起去。我可不能冒这个险，让你迷路。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1061
translate schinese ep11_cabin_bianca_event_label_ae8b4fe5:

    # bia "I know these woods well. You'll need a guide."
    bia "我知道这些树林，你得有个向导。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1063
translate schinese ep11_cabin_bianca_event_label_f99cd99f:

    # bia "Hop on behind me and I'll show you."
    bia "上车，我带你走。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1064
translate schinese ep11_cabin_bianca_event_label_994b3360:

    # mc "Sure. Sounds fun."
    mc "好啊。听起来挺好玩的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1066
translate schinese ep11_cabin_bianca_event_label_06fcdeb1:

    # bia "Don't tell Dad we did this."
    bia "别告诉爸爸我们这么做了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1067
translate schinese ep11_cabin_bianca_event_label_4c52f9c2:

    # mc "Why? Is he protective of it?"
    mc "为什么？他是不是很在意这个？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1069
translate schinese ep11_cabin_bianca_event_label_a2a965c8:

    # bia "No, but this one isn't made for two persons. But we can still do it if you're careful."
    bia "不，但这辆不是双人用的。不过如果你小心点，我们还是可以试试。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1070
translate schinese ep11_cabin_bianca_event_label_e0e5ac16:

    # mc "Ok, where should I put my arms?"
    mc "那我该把手臂放在哪里？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1072
translate schinese ep11_cabin_bianca_event_label_e5c46d67:

    # bia "You have to wrap them around me, or you'll fall off."
    bia "你得把它们绕在我身上，不然你会掉下去。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1073
translate schinese ep11_cabin_bianca_event_label_9bde7d8b:

    # bia "And don't be shy; grip tightly. This thing goes WRRRROOOOM!"
    bia "别害羞，抓紧点。这玩意儿可会发出ＷＲＲＲＲＲＲＲＲＯＯＯＯＯＭＭＭ！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1074
translate schinese ep11_cabin_bianca_event_label_fa375fcf:

    # mc "It does?"
    mc "它真的会？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1077
translate schinese ep11_cabin_bianca_event_label_9dee614e:

    # "WRRRRRRRRROOOOOOMMM!!!"
    "轰隆隆！！！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1078
translate schinese ep11_cabin_bianca_event_label_2db4ad3f:

    # bia "WOHO!!!"
    bia "哇哦！！！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1083
translate schinese ep11_cabin_bianca_event_label_43df8d42:

    # mc "I thought you said we had to drive carefully!"
    mc "我以为你刚才说要小心驾驶！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1085
translate schinese ep11_cabin_bianca_event_label_a247a79b:

    # bia "Haha! I said you had to drive it carefully. I know what I'm doing."
    bia "哈哈！我刚才说要你小心驾驶，我知道我在做什么。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1087
translate schinese ep11_cabin_bianca_event_label_db26b499:

    # mc "I didn't think it would be this fast!"
    mc "我没想到它能快成这样！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1088
translate schinese ep11_cabin_bianca_event_label_6519c399:

    # bia "Oh, it goes even faster! But I saw how you fell in the snow earlier today; I don't want to overdo it."
    bia "哦，它还能更快！不过我看到你今天早上在雪地里摔了一跤，我可不想开得太猛。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1089
translate schinese ep11_cabin_bianca_event_label_35b124d1:

    # mc "How thoughtful..."
    mc "真体贴啊..."

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1096
translate schinese ep11_cabin_bianca_event_label_f23f0e7b:

    # bia "Haha, are you doing ok?"
    bia "哈哈，你还好吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1098
translate schinese ep11_cabin_bianca_event_label_5de18d89:

    # mc "Yeah! That was fun as hell!"
    mc "对！那他妈的太好玩了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1100
translate schinese ep11_cabin_bianca_event_label_3ed92e97:

    # mc "I bet you ride this all the time."
    mc "我敢打赌你经常骑这玩意儿。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1102
translate schinese ep11_cabin_bianca_event_label_fabb2c1d:

    # bia "Oh, yeah! You know it."
    bia "哦，是啊！你懂的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1104
translate schinese ep11_cabin_bianca_event_label_0aab246b:

    # bia "I always have a blast when I'm here. There are so many things to do that you can't back home."
    bia "我每次来这儿都玩得超开心。这儿能做的事情太多了，你在家根本体验不到。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1106
translate schinese ep11_cabin_bianca_event_label_80a67d29:

    # mc "Then, I take it you're here often."
    mc "那你是经常来这儿？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1108
translate schinese ep11_cabin_bianca_event_label_27c78701:

    # bia "Not as often as I'd like. And, of course, the weather isn't always this good."
    bia "不像我想要的那么频繁。而且，当然了，天气也不总是这么好。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1111
translate schinese ep11_cabin_bianca_event_label_6b5abd7b:

    # bia "Matty and I used to come here, just the two of us."
    bia "我和马蒂以前经常来这儿，就我们俩。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1113
translate schinese ep11_cabin_bianca_event_label_bf72d2cf:

    # mc "Sounds romantic."
    mc "听起来挺浪漫的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1115
translate schinese ep11_cabin_bianca_event_label_37431eb5:

    # bia "Yeah, it was. That fucking lunkhead made a big mistake."
    bia "对，那家伙确实犯了个大错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1117
translate schinese ep11_cabin_bianca_event_label_0d6e7471:

    # bia "Being here alone with someone is great."
    bia "和一个人独处在这里真的很棒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1119
translate schinese ep11_cabin_bianca_event_label_6581997a:

    # bia "Matty and I have been here for a few years, just the two of us."
    bia "Matty和我在这儿已经几年了，就我们俩。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1121
translate schinese ep11_cabin_bianca_event_label_bf72d2cf_1:

    # mc "Sounds romantic."
    mc "听起来挺浪漫的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1123
translate schinese ep11_cabin_bianca_event_label_ab79dc79:

    # bia "Haha, very. Being here alone with someone is great."
    bia "哈哈，确实。和某人独处在这里真的很棒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1124
translate schinese ep11_cabin_bianca_event_label_9316269c:

    # bia "I mean, there aren't many other places where you can walk around nude and bathe naked in the sauna and hot tub without prying eyes."
    bia "我的意思是，能这样没人窥视、光着身子四处走，还能裸着泡桑拿和热水浴池的地方可不多。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1126
translate schinese ep11_cabin_bianca_event_label_8b421e29:

    # mc "Haha, you do that?"
    mc "哈哈，你也是？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1128
translate schinese ep11_cabin_bianca_event_label_3ce6df00:

    # bia "All the time, haha! And other things, too."
    bia "一直都这样，哈哈！还有别的事情也是一样。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1129
translate schinese ep11_cabin_bianca_event_label_b129beea:

    # bia "But that would be oversharing."
    bia "但那样就有点过头了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1131
translate schinese ep11_cabin_bianca_event_label_1370da3e:

    # mc "It already is. Now I know you had sex in the sauna."
    mc "它本来就是。现在我知道你在更衣室里做过那事了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1133
translate schinese ep11_cabin_bianca_event_label_fd9067a5:

    # bia "And the hot tub."
    bia "还有热水浴池。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1135
translate schinese ep11_cabin_bianca_event_label_f236ec5a:

    # mc "Yikes."
    mc "哇，这可真够劲的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1136
translate schinese ep11_cabin_bianca_event_label_c4c124f2:

    # mc "Not on this snowmobile, I hope."
    mc "别在这辆雪地摩托上。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1139
translate schinese ep11_cabin_bianca_event_label_41708d6c:

    # bia "Haha! No, not on this snowmobile. Although, I bet you could. The seat is perfect for it."
    bia "哈哈！不，不是在这辆雪地摩托上。不过，我打赌你也能。座椅正适合这么做。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1141
translate schinese ep11_cabin_bianca_event_label_67d77ce9:

    # bia "Yeah, you'd probably go like this. Haha!"
    bia "对，你大概就是这么干的。哈哈！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1146
translate schinese ep11_cabin_bianca_event_label_3747aa82:

    # mc "Yeah. It sounds like that's the way to do it."
    mc "嗯，听起来就是这样干的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1147
translate schinese ep11_cabin_bianca_event_label_d892be29:

    # mc "Ok, it's my turn to drive!"
    mc "好，轮到我开车了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1150
translate schinese ep11_cabin_bianca_event_label_b4f8a4fc:

    # bia "Hell yeah! You saw how I did it, right?"
    bia "好啊！你看到我怎么做的了吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1155
translate schinese ep11_cabin_bianca_event_label_cc43352c:

    # mc "Yeah, I can see this working for sure."
    mc "嗯，这招肯定能行。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1159
translate schinese ep11_cabin_bianca_event_label_494c59ad:

    # bia "Haha! Yep, that's how you'd do it."
    bia "哈哈！没错，就是这样干的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1161
translate schinese ep11_cabin_bianca_event_label_e0179b68:

    # bia "We should be heading back."
    bia "我们该回去了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1163
translate schinese ep11_cabin_bianca_event_label_aca9f678:

    # mc "My turn to drive, yeah?"
    mc "我的回合了，对吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1165
translate schinese ep11_cabin_bianca_event_label_9f58563d:

    # bia "Yep."
    bia "嗯。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1168
translate schinese ep11_cabin_bianca_event_label_dd7137b5:

    # bia "You saw how I did it, right?"
    bia "你看到我怎么做的，对吧？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1169
translate schinese ep11_cabin_bianca_event_label_caf72b92:

    # mc "Yeah, I think so."
    mc "嗯，我想是这样。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1170
translate schinese ep11_cabin_bianca_event_label_22e05e6d:

    # mc "Ok... Here we go!"
    mc "好……开始了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1174
translate schinese ep11_cabin_bianca_event_label_b9a754ff:

    # bia "You can use the throttle more than that."
    bia "你可以把油门踩得更狠点。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1175
translate schinese ep11_cabin_bianca_event_label_f6435690:

    # mc "I'm a slow starter."
    mc "我起步有点慢。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1178
translate schinese ep11_cabin_bianca_event_label_88656620:

    # bia "Haha, I'll say."
    bia "哈哈，我这么说是对的。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1184
translate schinese ep11_cabin_bianca_event_label_5582048a:

    # mc "Thanks for the ride! It was awesome."
    mc "谢谢你的载我一程！开得真带劲。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1186
translate schinese ep11_cabin_bianca_event_label_6f2e9794:

    # bia "My pleasure! I'm just happy I got to take it out for a spin."
    bia "我的荣幸！能开它出去兜一圈，我就已经很开心了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1188
translate schinese ep11_cabin_bianca_event_label_3484838a:

    # bia "Oh! A bar!"
    bia "哦！一家酒吧！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1189
translate schinese ep11_cabin_bianca_event_label_2379b5b7:

    # bia "No, wait! Almost!"
    bia "不，等等！快到了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1205
translate schinese ep11_cabin_bella_event_label_612238be:

    # mc "Do you need my help?"
    mc "你需要我帮忙吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1207
translate schinese ep11_cabin_bella_event_label_4d2fddbf:

    # isa "No, thanks. Dinner will be quick work. I was asked to keep it simple, and I did."
    isa "不用谢。晚饭很快就能搞定。有人让我保持简单，我也没让她们失望。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1208
translate schinese ep11_cabin_bella_event_label_dc07c588:

    # isa "Wine?"
    isa "红酒？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1210
translate schinese ep11_cabin_bella_event_label_606e2d02:

    # mc "Sure."
    mc "当然。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1212
translate schinese ep11_cabin_bella_event_label_58363732:

    # isa "I can't believe it's almost Christmas. December has felt like a blur."
    isa "真不敢相信圣诞节都快到了，十二月感觉过得像做梦一样。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1214
translate schinese ep11_cabin_bella_event_label_40ef57e6:

    # mc "Yeah. This entire semester went by fast."
    mc "嗯，这整个学期过得真快。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1215
translate schinese ep11_cabin_bella_event_label_6ec297bf:

    # mc "And come spring, you're not my English teacher anymore."
    mc "到了春天，你就不再是我的英语老师了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1217
translate schinese ep11_cabin_bella_event_label_77a024e2:

    # isa "But I'll be your teacher in Introduction to College Research."
    isa "但我会是你的《大学研究导论》老师。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1219
translate schinese ep11_cabin_bella_event_label_19679e2d:

    # mc "Is it a hard class?"
    mc "这课难不难？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1221
translate schinese ep11_cabin_bella_event_label_5d7deb80:

    # isa "It depends on who you ask. Many students find it dull and uninspiring."
    isa "这得看问谁了。很多学生觉得这门课无聊又没劲。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1223
translate schinese ep11_cabin_bella_event_label_f102d707:

    # mc "Way to hype me up for it."
    mc "这课我可不稀罕。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1225
translate schinese ep11_cabin_bella_event_label_e280d9bc:

    # isa "But it's essential for the work you'll do later in college. I wouldn't knock it."
    isa "但这是你以后上大学做研究时必不可少的技能。我可不会说它不好。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1227
translate schinese ep11_cabin_bella_event_label_25e0c005:

    # mc "Do you get any winter break, or is it just us?"
    mc "你有寒假吗，还是说就我们俩？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1229
translate schinese ep11_cabin_bella_event_label_071205b8:

    # isa "I'll get some days off, yes. But I have other duties to carry out between semesters."
    isa "我确实会放几天假，不过学期中间还有其他事情要处理。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1230
translate schinese ep11_cabin_bella_event_label_e3c1e2f8:

    # isa "What will you be doing on your break?"
    isa "你寒假期间打算做什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1233
translate schinese ep11_cabin_bella_event_label_56e21e78:

    # mc "Hopefully, I'll be spending lots of time with you."
    mc "希望我能和你花很多时间在一起。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1235
translate schinese ep11_cabin_bella_event_label_c07d4711:

    # isa "Aren't you going back home?"
    isa "你不是要回老家吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1237
translate schinese ep11_cabin_bella_event_label_7d674f80:

    # mc "I'll go back home for a few days, but I think I'll return to my frat before the next semester starts."
    mc "我会回家待几天，但我想在下一学期开始前就回到兄弟会。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1239
translate schinese ep11_cabin_bella_event_label_db952aa4:

    # isa "I see. Yes, I'm available."
    isa "明白了。是的，我有空。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1241
translate schinese ep11_cabin_bella_event_label_892bf084:

    # mc "I haven't thought that far ahead yet. Since I have nothing to study - unless I wanna cram some chemistry - I'll likely have some time off."
    mc "我还没想那么远。反正我现在也没啥功课要做——除非我想临时抱佛脚复习化学——所以大概率会有一段空闲时间。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1242
translate schinese ep11_cabin_bella_event_label_2957f28e:

    # mc "I'll go back home for a few days, but I think I'll be back in the frat before next semester starts."
    mc "我会回老家待几天，但我想在下一学期开始前就回到兄弟会。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1244
translate schinese ep11_cabin_bella_event_label_10e6e351:

    # isa "I look forward to our Christmas party."
    isa "我期待我们的圣诞派对。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1246
translate schinese ep11_cabin_bella_event_label_31ddcf73:

    # mc "Me too! That was a great idea."
    mc "我也是！这个主意真不错。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1248
translate schinese ep11_cabin_bella_event_label_b3ae4ba3:

    # isa "Thank Sage for sparking it. I hope she's doing fine."
    isa "这得感谢Sage点燃了火花。希望她一切安好。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1250
translate schinese ep11_cabin_bella_event_label_98ff32e6:

    # mc "Yeah... It's tough for her, I can tell."
    mc "对……我看得出来，她现在很难受。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1252
translate schinese ep11_cabin_bella_event_label_72e82262:

    # isa "Is there something you'd like for Christmas?"
    isa "你圣诞想要什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1254
translate schinese ep11_cabin_bella_event_label_d33eed9c:

    # mc "Me? Why? Are you getting me something?"
    mc "我？为什么？你是不是要给我买什么？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1256
translate schinese ep11_cabin_bella_event_label_4ab8af6f:

    # isa "I was just curious."
    isa "我只是好奇一下。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1258
translate schinese ep11_cabin_bella_event_label_8c285b9d:

    # mc "Well, if that's the case..."
    mc "好吧，如果真是这样的话……"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1261
translate schinese ep11_cabin_bella_event_label_1f21cfa1:

    # mc "All I want for Christmas is..."
    mc "我圣诞节只想要一台雪地摩托。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1262
translate schinese ep11_cabin_bella_event_label_3a1d4719:

    # mc "...a snowmobile."
    mc "...一辆雪地摩托。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1264
translate schinese ep11_cabin_bella_event_label_caf67fad:

    # isa "Haha, shut it."
    isa "哈哈，闭嘴。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1266
translate schinese ep11_cabin_bella_event_label_3be25b1d:

    # mc "And make it a fast one!"
    mc "再来个快的！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1268
translate schinese ep11_cabin_bella_event_label_a150ad59:

    # isa "I'm not getting you a snowmobile. Lower your expectations."
    isa "我可不会给你买雪地摩托。降低点预期吧。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1270
translate schinese ep11_cabin_bella_event_label_6812d81a:

    # mc "Haha, ok. Then no. I don't need anything for Christmas."
    mc "哈哈，好吧。那就算了。我圣诞节什么都不需要。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1271
translate schinese ep11_cabin_bella_event_label_a995d2a0:

    # mc "I'm happy I get to celebrate it twice this year!"
    mc "今年能庆祝两次，我挺开心的！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1273
translate schinese ep11_cabin_bella_event_label_5b812b8a:

    # mc "I wouldn't mind a bump in my grades."
    mc "我倒是不介意成绩能提一提。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1275
translate schinese ep11_cabin_bella_event_label_3269f0db:

    # isa "Do you realize by asking me that you're doing something unethical?"
    isa "你有没有意识到，光是问我就已经做了一件不道德的事？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1277
translate schinese ep11_cabin_bella_event_label_8c30f48e:

    # isa "And given what we talked about with the midterm tests..."
    isa "而且考虑到我们刚才谈到的期中考试的事情……"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1279
translate schinese ep11_cabin_bella_event_label_3d59c485:

    # mc "It was just a joke."
    mc "不过是个玩笑啦。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1280
translate schinese ep11_cabin_bella_event_label_9f60e7bd:

    # mc "I don't need anything for Christmas."
    mc "我圣诞节什么都不需要。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1281
translate schinese ep11_cabin_bella_event_label_a995d2a0_1:

    # mc "I'm happy I get to celebrate it twice this year!"
    mc "今年能庆祝两次，我挺开心的！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1297
translate schinese ep11_cabin_sauna_event_label_54770451:

    # bia "Guys! It's time!"
    bia "伙计们！该开始了！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1299
translate schinese ep11_cabin_sauna_event_label_b34a7759:

    # ji "To party?"
    ji "来玩乐吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1302
translate schinese ep11_cabin_sauna_event_label_5abc4458:

    # bia "Hell yes! Drinks are on me."
    bia "当然！酒钱我来付。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1304
translate schinese ep11_cabin_sauna_event_label_63585a9d:

    # isa "Champagne? You shouldn't have. I opened a bottle of white wine in the kitchen."
    isa "香槟？你太客气了。我在厨房开了一瓶白葡萄酒。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1306
translate schinese ep11_cabin_sauna_event_label_d55983fc:

    # bia "We'll get to that bottle too."
    bia "我们到时候再喝这瓶。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1309
translate schinese ep11_cabin_sauna_event_label_61092435:

    # bia "Cheers to an amazing trip with a buttload of snow fun! I'm so happy you guys came to share this weekend with me."
    bia "干杯，祝我们这次旅行充满一堆雪地乐趣！你们能来和我一起度过这个周末，我太开心了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1311
translate schinese ep11_cabin_sauna_event_label_b3bd50e5:

    # isa "I think I speak for everyone when I say the pleasure was ours."
    isa "我觉得我代表大家说，能和你们一起度过这个周末真是太棒了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1313
translate schinese ep11_cabin_sauna_event_label_9895e054:

    # "Cheers!"
    "干杯！"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1315
translate schinese ep11_cabin_sauna_event_label_4108bf29:

    # isa "It's so good."
    isa "太好喝了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1317
translate schinese ep11_cabin_sauna_event_label_3c41499d:

    # ji "This Champagne goes straight to your head. My face feels warm already, haha."
    ji "这香槟直接灌进脑袋里了。我的脸已经有点热了，哈哈。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1319
translate schinese ep11_cabin_sauna_event_label_96f8ea55:

    # bia "I hope you guys are ready. Do you know what time it is?"
    bia "我希望你们都准备好了。知道现在几点了吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1321
translate schinese ep11_cabin_sauna_event_label_31510e7c:

    # mc "Didn't you say it was party time?"
    mc "你不是说现在是派对时间吗？"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1323
translate schinese ep11_cabin_sauna_event_label_055436fc:

    # bia "Haha! Yes! But also..."
    bia "哈哈！对！不过还有……"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1324
translate schinese ep11_cabin_sauna_event_label_df28e1ed:

    # bia "It's sauna time! And [name] promised he would jump naked into the snow."
    bia "桑拿时间到了！[name]他承诺会光着身子跳进雪里。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1326
translate schinese ep11_cabin_sauna_event_label_f1442f6e:

    # isa "Now that I'd like to see."
    isa "现在我真想看看。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1328
translate schinese ep11_cabin_sauna_event_label_34ec06ff:

    # mc "I did not promise that."
    mc "我没答应过。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1330
translate schinese ep11_cabin_sauna_event_label_49f7302a:

    # ji "Hahaha! It does sound like something you would promise."
    ji "哈哈哈！听起来你确实有可能会答应这种事。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1332
translate schinese ep11_cabin_sauna_event_label_d9995de5:

    # mc "No way! Naked in the snow? I'd turn into a popsicle."
    mc "不可能！光着身子跳进雪里？我立马就变成冰棍了。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1334
translate schinese ep11_cabin_sauna_event_label_98e53ddd:

    # isa "Let's start with the sauna and see if he dares."
    isa "我们先从桑拿开始，看看他有没有胆子。"

# freeroam\episode11\ep11_freeroam_cabin_events.rpy:1336
translate schinese ep11_cabin_sauna_event_label_a6615b5c:

    # bia "It's heating up as we speak, and I don't want to be the only one in there. So, you guys better get changed."
