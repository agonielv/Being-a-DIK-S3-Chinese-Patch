translate schinese ep11_pp_quinn2_event_label_1f4c259e:

    # qu "I can't make up for what I've already done to Riona, but I owe her this."
    qu "我没办法弥补已经对她做过的事，但至少我该给她这个。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4132
