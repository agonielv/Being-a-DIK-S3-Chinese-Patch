    # qu "I will make Mick, Vinny and Buddy pay for what they did to her."
    qu "我会让Buddy、Vinny和Mick为他们对她的所作所为付出代价。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4134
translate schinese ep11_pp_quinn2_event_label_7b681870:

    # mc "I want to trust you, but I can't just stand by and watch."
    mc "我想相信你，但我不能就这么站着看着。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4136
translate schinese ep11_pp_quinn2_event_label_961604b6:

