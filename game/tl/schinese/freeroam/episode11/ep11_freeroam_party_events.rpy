translate schinese ep11_pp_zoey_endb_label_b1c03404:

    # zo "Is that what you really think about her? I've heard otherwise."
    zo "你这才是真的这么想她吗？我听说不是这样。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4217
translate schinese ep11_pp_zoey_endb_label_eaded9fa:

    # mc "She talks a lot. She's got a decent body but an ugly personality."
    mc "她话多得烦人，身材不错但性格真难搞。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4218
translate schinese ep11_pp_zoey_endb_label_a3f84fb5:

    # mc "What did she say?"
    mc "她说了什么？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4220
translate schinese ep11_pp_zoey_endb_label_3acf715d:

    # zo "It doesn't matter."
    zo "没关系。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4223
translate schinese ep11_pp_zoey_endb_label_fd614a8e:

    # mc "I'm gonna leave soon... I've got this thing I gotta do."
    mc "我得走了，我还有事要办。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4225
translate schinese ep11_pp_zoey_endb_label_1c43d492:

    # zo "You're leaving your own party?"
    zo "你这是要离开自己的派对吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4227
translate schinese ep11_pp_zoey_endb_label_ab08203c:

    # mc "Yeah. I'm sorry... But I didn't wanna leave before we finished our talk."
    mc "对。我抱歉……但我本来不想在我们聊完之前就离开。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4228
translate schinese ep11_pp_zoey_endb_label_d76a41a2:

    # mc "I don't think it would be cool to bring you here and not hear you out."
    mc "我觉得带你不听你说话，这事儿挺不酷的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4230
translate schinese ep11_pp_zoey_endb_label_b35c45e0:

    # mc "How about we continue our chat?"
    mc "那我们继续聊吧？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4232
translate schinese ep11_pp_zoey_endb_label_b1053faf:

    # zo "Ok... Can we get away from these people?"
    zo "好……我们能离开这些人吗？"

