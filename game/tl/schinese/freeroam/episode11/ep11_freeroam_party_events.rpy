translate schinese ep11_pp_sk_event_label_d06ac323:

    # mc "Now, here's a party. Go, Jamie..."
    mc "现在，这可真是个派对。去吧，Jamie..."

# freeroam\episode11\ep11_freeroam_party_events.rpy:3346
translate schinese ep11_pp_sk_event_label_835c4739:

    # sy "More like \"go away\"."
    sy "更像是“滚开”。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3348
translate schinese ep11_pp_sk_event_label_bb2c0afd:

    # mc "Aw, are you jealous?"
    mc "哎呀，你吃醋了？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3350
translate schinese ep11_pp_sk_event_label_093db026:

    # sy "Of Jamie? Oh, please. He's not a good kisser."
    sy "关于Jamie？哦，别傻了。他可没那么会亲吻。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3351
translate schinese ep11_pp_sk_event_label_ae4dc709:

    # sy "Just look how he's slobbering all over her."
    sy "看看他现在对她的样子，口水都流到地上了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3353
translate schinese ep11_pp_sk_event_label_0e69ccbc:

    # mc "They look good together. Way better than him and Dany, if you ask me."
    mc "他们看起来很般配。要我说，比他和Dany般配多了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3354
translate schinese ep11_pp_sk_event_label_3d307cdf:

    # sy "They're not hooking up. Karen is just doing her mission of going to second base with someone and Jamie is the tool."
    sy "他们根本没在搞什么钩子，Karen只是在完成她的任务，跟别人上到第二步，而Jamie就是个工具人。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3356
translate schinese ep11_pp_sk_event_label_36294152:

    # mc "I'd still call that hooking up. And good for Karen."
    mc "我倒觉得那也算在交往了。而且你干得不错，Karen。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3357
translate schinese ep11_pp_sk_event_label_d1780d60:

    # mc "What about you? Did you do yours already?"
    mc "你呢？你那边搞定了吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3359
translate schinese ep11_pp_sk_event_label_22791a94:

    # sy "No. And I've been meaning to ask you..."
    sy "没。而且我一直在想问你……"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3360
translate schinese ep11_pp_sk_event_label_869becb3:

    # sy "Who the hell came up with these lame ideas? Seven minutes in heaven?"
    sy "谁他妈想出这些无聊的主意？七分钟天堂？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3361
translate schinese ep11_pp_sk_event_label_2b37f0fb:

    # sy "Last time I checked, you did that in high school. This is college. Grow up!"
    sy "上次我检查的时候，你这在高中就干过。现在是大学了，该长大了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3363
translate schinese ep11_pp_sk_event_label_a9b0ce88:

    # mc "That's an easy one. You should see some of the other guests' missions."
    mc "这可是最简单的了。你该看看其他客人那些任务。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3364
translate schinese ep11_pp_sk_event_label_b935868f:

    # mc "Trust me, there are way worse things to get."
    mc "相信我，还有更糟的事情等着你。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3366
translate schinese ep11_pp_sk_event_label_4a894017:

    # sy "Will you help me out with it?"
    sy "你会帮我一下吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3368
translate schinese ep11_pp_sk_event_label_d1483ffe:

    # mc "Do you want me to make out with you in a closet?"
    mc "你想要我跟你在更衣室里亲热吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3370
translate schinese ep11_pp_sk_event_label_278ca28b:

    # sy "No!?"
    sy "不！？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3372
translate schinese ep11_pp_sk_event_label_9a644979:

    # mc "Isn't that what it is?"
    mc "这不就是所谓的“任务”吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3374
translate schinese ep11_pp_sk_event_label_d3aa46bd:

    # sy "By definition, you have to sit in a dark room or closet together for seven minutes and do whatever."
    sy "按定义，你们得在黑暗的房间或更衣室里坐七分钟，什么也不做。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3375
translate schinese ep11_pp_sk_event_label_573e1c17:

    # sy "While many choose to participate in sexual activities or kiss, it's enough to talk or sit and wait the time out."
    sy "虽然很多人选择做爱或者接吻，但只是聊天或者坐在一起等时间也够了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3377
translate schinese ep11_pp_sk_event_label_0e0213d5:

    # mc "So, you want me to sit in silence with you in a closet for seven minutes?"
    mc "所以你想让我和你在一个更衣室里安静地坐七分钟？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3379
translate schinese ep11_pp_sk_event_label_ad5b4d7a:

    # sy "It doesn't have to be a closet. Let's find an empty room and do it."
    sy "这不一定要在储物间里。我们找个空房间，搞定就行。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3383
translate schinese ep11_pp_sk_event_label_b744cdde:

    # mc "Ok, but no funny business."
    mc "好，但别搞什么花招。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3385
translate schinese ep11_pp_sk_event_label_b488d2b0:

    # sy "As if."
    sy "像你这样。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3387
translate schinese ep11_pp_sk_event_label_44818560:

    # mc "Ok. Let's find a room then."
    mc "好，我们先找个房间吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3389
translate schinese ep11_pp_sk_event_label_8abc1f58:

    # mc "Nah, I'm good."
    mc "我挺好的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3394
translate schinese ep11_pp_sk_event_label_9abcb233:

    # mc "We'll have to turn the lights off, but this will do. It's as close to a closet as we get tonight."
    mc "我们得把灯关掉，不过这样也行。这已经是今晚最接近密室的了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3401
translate schinese ep11_pp_sk_event_label_98c1d4fc:

    # sy "We'll have to wing it because I don't have a phone or watch on me. What takes seven minutes?"
    sy "我们得靠运气了，因为我身上没带手机或者手表。七分钟能干啥？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3403
translate schinese ep11_pp_sk_event_label_f79af46d:

    # mc "We can listen to a few songs from here. Two or three songs should do it."
    mc "我们可以在这里听几首歌。两到三首应该就够了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3407
translate schinese ep11_pp_sk_event_label_2a598310:

    # sy "To be clear... Don't expect me to do something with you. Ok?"
    sy "说白了……别指望我会对你做什么。明白吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3413
translate schinese ep11_pp_sk_event_label_43de6897:

    # mc "I'm not expecting anything. Let's sit here and wait together."
    mc "我没指望什么。我们就这样坐这儿一起等吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3416
translate schinese ep11_pp_sk_event_label_cee8cdbb:

    # mc "You can if you want to."
    mc "你可以如果想要的话。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3418
translate schinese ep11_pp_sk_event_label_73567654:

    # sy "Stop it."
    sy "别闹了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3421
translate schinese ep11_pp_sk_event_label_17b396cd:

    # mc "Not even a little kiss?"
    mc "连个亲都不给？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3425
translate schinese ep11_pp_sk_event_label_c9b290a7:

    # sy "*{i}Smack{/i}*"
    sy "*{i}打耳光{/i}*"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3427
translate schinese ep11_pp_sk_event_label_e86e391b:

    # sy "There, now shut up."
    sy "那儿，现在闭嘴。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3433
translate schinese ep11_pp_sk_event_label_58456552:

    # mc "I'm taken, so I wasn't expecting anything. I wouldn't have done this otherwise."
    mc "我已经有对象了，所以没抱什么期望。如果不是这样，我也不至于做这种事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3435
translate schinese ep11_pp_sk_event_label_43de6897_1:

    # mc "I'm not expecting anything. Let's sit here and wait together."
    mc "我没想到什么。我们坐这儿一起等吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3440
translate schinese ep11_pp_sk_event_label_17b396cd_1:

    # mc "Not even a little kiss?"
    mc "连个轻吻都不给？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3444
translate schinese ep11_pp_sk_event_label_c9b290a7_1:

    # sy "*{i}Smack{/i}*"
    sy "*{i}打耳光{/i}*"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3446
translate schinese ep11_pp_sk_event_label_e86e391b_1:

    # sy "There, now shut up."
    sy "好了，别说了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3452
translate schinese ep11_pp_sk_event_label_6a3eca5b:

    # sy "What did you get?"
    sy "你拿到什么了？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3454
translate schinese ep11_pp_sk_event_label_582359ea:

    # mc "Hm?"
    mc "嗯？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3456
translate schinese ep11_pp_sk_event_label_9d9db804:

    # sy "What did you pull from that bowl? What are you supposed to do tonight?"
    sy "你从碗里捞出什么了？今晚你打算干什么？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3460
translate schinese ep11_pp_sk_event_label_e412eb67:

    # mc "I was supposed to dress as Santa and have girls sit in my lap, but I haven't even started. I don't think I'll complete it."
    mc "我本该打扮成圣诞老人，让女孩们坐在我腿上，但我连开始都没开始。我想我大概完不成了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3462
translate schinese ep11_pp_sk_event_label_e226c662:

    # mc "I was supposed to dress as Santa and have girls sit in my lap. I might finish it at some point."
    mc "我本该打扮成圣诞老人，让女孩们坐在我腿上。我可能什么时候会完成这件事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3464
translate schinese ep11_pp_sk_event_label_83785477:

    # mc "I was supposed to dress as Santa and have girls sit in my lap. It was pretty easy; I'm already done with it."
    mc "我本该打扮成圣诞老人，让女孩们坐在我腿上。其实挺简单的，我早就做完了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3466
translate schinese ep11_pp_sk_event_label_3e47ee54:

    # mc "I was supposed to dress as Santa and have girls sit in my lap. But I got out of it because I helped out hosting the party."
    mc "我本来该打扮成圣诞老人，让女生坐我腿上，但我逃了，因为帮着办派对。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3468
translate schinese ep11_pp_sk_event_label_a9b9afe6:

    # sy "That's a good one. It's the first one that I heard that was Christmas-related."
    sy "这招不错。这是第一个我听到的跟圣诞节有关的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3472
translate schinese ep11_pp_sk_event_label_c7c1287e:

    # sy "Nice job on the report, by the way. Did you see what Dr. Jenkins wrote?"
    sy "话说你那份报告做得不错。你看到詹金斯博士写的评语了吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3474
translate schinese ep11_pp_sk_event_label_8ac292f2:

    # mc "Did she grade it already?"
    mc "她给评分了吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3476
translate schinese ep11_pp_sk_event_label_db3c87e6:

    # sy "Yeah, we passed. She thought we did a thorough job."
    sy "嗯，我们通过了。她觉得我们做得挺到位的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3478
translate schinese ep11_pp_sk_event_label_ea86a34d:

    # mc "That's great. We make a good team."
    mc "这挺不错的。我们配合得挺默契的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3480
translate schinese ep11_pp_sk_event_label_2f9fb54f:

    # sy "Eh. I've had better."
    sy "嗯，我有过更好的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3482
translate schinese ep11_pp_sk_event_label_19ef8cc2:

    # mc "My frame of reference was Derek, so I can't say the same."
    mc "我的参照物是Derek，所以不能这么说。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3484
translate schinese ep11_pp_sk_event_label_11a1ab57:

    # sy "Although not much of a feat, you're better than Ron. I'll give you that."
    sy "虽然算不上多厉害，但你比Ron强，这点我承认。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3492
translate schinese ep11_pp_sk_event_label_10c90a59:

    # mc "I gotta say, you're not as bad as I originally thought."
    mc "我得说，你没我想象中那么差。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3494
translate schinese ep11_pp_sk_event_label_af187fa4:

    # sy "Is that supposed to be a compliment?"
    sy "这算是在夸我吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3496
translate schinese ep11_pp_sk_event_label_246cb367:

    # mc "It's my way of saying that I'm starting to like you. We never got along before we were forced to get along."
    mc "这是我在暗示我开始喜欢你了。我们以前根本合不来，现在被迫在一起才勉强能相处。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3498
translate schinese ep11_pp_sk_event_label_f84ec7b7:

    # sy "I've had my reasons."
    sy "我有我的理由。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3500
translate schinese ep11_pp_sk_event_label_10c356bd:

    # mc "To not like me?"
    mc "不喜欢我？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3502
translate schinese ep11_pp_sk_event_label_e66cb045:

    # sy "Stereotypes, preconceived notions, advice, rumors and whatnot."
    sy "刻板印象、先入为主的观念、建议、流言蜚语之类的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3504
translate schinese ep11_pp_sk_event_label_98e16798:

    # mc "That's a lot of reasons."
    mc "那可真是不少理由。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3507
translate schinese ep11_pp_sk_event_label_449a35fc:

    # sy "And while most of it seems to be true, and you can be a big fucking button pusher..."
    sy "虽然大部分都是真的，但你他妈还挺会按别人按钮的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3509
translate schinese ep11_pp_sk_event_label_5f7f8980:

    # sy "And while some of it seems to be true, not all is..."
    sy "虽然有些东西看起来是真的，但并不是全部……"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3511
translate schinese ep11_pp_sk_event_label_ff06ae52:

    # sy "But not much of it seems to be true..."
    sy "但大部分其实也不太对劲..."

# freeroam\episode11\ep11_freeroam_party_events.rpy:3512
translate schinese ep11_pp_sk_event_label_ab815988:

    # sy "You have some qualities that aren't detestable."
    sy "你身上也有一些不那么讨厌的特质。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3515
translate schinese ep11_pp_sk_event_label_48f37d4d:

    # mc "Is {i}that{/i} supposed to be a compliment?"
    mc "是{i}那{/i}本该是夸奖？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3517
translate schinese ep11_pp_sk_event_label_b3d0d8b5:

    # sy "You're kind of ok, too."
    sy "你也不算太差。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3522
translate schinese ep11_pp_sk_event_label_73bf3800:

    # mc "You sure know how to make a guy feel special."
    mc "你真会让一个男人觉得自己很特别。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3525
translate schinese ep11_pp_sk_event_label_9590b02b:

    # mc "Thanks, Sally. I appreciate that."
    mc "谢谢，Sally，我挺感激的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3529
translate schinese ep11_pp_sk_event_label_43617113:

    # sy "Has it been seven minutes yet?"
    sy "已经七分钟了？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3531
translate schinese ep11_pp_sk_event_label_a1f11008:

    # mc "More like one minute."
    mc "差不多一分钟都不到。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3533
translate schinese ep11_pp_sk_event_label_bb3ef508:

    # sy "This is boring."
    sy "太无聊了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3539
translate schinese ep11_pp_sk_event2_label_34d38635:

    # mc "On the other hand... Let's call it seven minutes."
    mc "另一方面……我们算七分钟吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3542
translate schinese ep11_pp_sk_event2b_label_0475f16d:

    # sy "Uh... Ok. That means I'm done."
    sy "嗯... 好吧。那意思就是我该结束了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3544
translate schinese ep11_pp_sk_event2b_label_4e0513c8:

    # mc "Yeah. No consequence for you."
    mc "没错。对你来说没影响。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3546
translate schinese ep11_pp_sk_event2b_label_67ff4933:

    # sy "Great. I assume I should thank you, but all you did was sit here for one minute with me, so I won't."
    sy "很好。我本该谢谢你，但你只是坐在我旁边一分钟，所以我就不谢了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3548
translate schinese ep11_pp_sk_event2b_label_57184c13:

    # mc "You're welcome."
    mc "你欢迎。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3550
translate schinese ep11_pp_sk_event2b_label_7a447443:

    # sy "Haha!"
    sy "哈哈！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3554
translate schinese ep11_pp_sk_event2b_label_c596babc:

    # mc "It's not supposed to be boring. It's supposed to be heaven."
    mc "这不应该是无聊的，这应该是天堂。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3560
translate schinese ep11_pp_sk_event2b_label_c43e4de1:

    # sy "Should we make out to pass the time?"
    sy "我们来亲热一下打发时间？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3565
translate schinese ep11_pp_sk_event2b_label_55945baa:

    # mc "If you're up for it."
    mc "如果你想的话。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3576
translate schinese ep11_pp_sk_event2c_label_c6f1863c:

    # mc "Whoa!"
    mc "哇哦！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3583
translate schinese ep11_pp_sk_event2c_label_b93cb4b1:

    # mc "I...um...think that's enough."
    mc "我...呃...我想我们已经够了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:3585
translate schinese ep11_pp_sk_event2c_label_1ac5eeed:

    # sy "What's wrong?"
