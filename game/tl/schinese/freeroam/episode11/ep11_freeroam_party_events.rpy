    de "而且你要是想待到想走为止，尽管留下。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4192
translate schinese ep11_pp_zoey_end_label_ce38ccec:

    # lea "Wait a minute! Is that the big punishment you've been hyping all night!?"
    lea "等等！这难道就是你整晚吹嘘的终极惩罚？！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4194
translate schinese ep11_pp_zoey_end_label_d0ab3e08:

