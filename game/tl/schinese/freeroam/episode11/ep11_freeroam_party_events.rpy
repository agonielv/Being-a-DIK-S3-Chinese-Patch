translate schinese ep11_pp_quinn2_event_label_60b3ba9b:

    # qu "I've done dangerous things all my life, [name]."
    qu "我这一辈子干过不少危险的事[name]."

# freeroam\episode11\ep11_freeroam_party_events.rpy:4139
translate schinese ep11_pp_quinn2_event_label_9695880c:

    # qu "You're scared because this is the first time you're aware of it."
    qu "你害怕是因为这是你第一次意识到这一点。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4141
translate schinese ep11_pp_quinn2_event_label_3f06a4c8:

    # qu "And this is why I was scared to tell you the truth."
    qu "这就是我为什么不敢告诉你真相的原因。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4143
translate schinese ep11_pp_quinn2_event_label_1d7654ef:

    # qu "When I need you... Trust me. I won't hesitate to let you know."
    qu "当我需要你的时候...相信我。我会毫不犹豫地告诉你。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4144
translate schinese ep11_pp_quinn2_event_label_33e760ca:

    # qu "I know you want to protect me. But understand that I want to protect you too."
    qu "我知道你想保护我。但你要明白，我同样想保护你。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4146
translate schinese ep11_pp_quinn2_event_label_73a478df:

    # qu "There is nothing that you can do to help anyone right now."
    qu "现在你什么都做不了，帮不了任何人。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4147
translate schinese ep11_pp_quinn2_event_label_b4d27def:

    # qu "If you can't do this for me, do it for Riona."
    qu "如果你不能为我做这件事，那就为Riona做吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4148
translate schinese ep11_pp_quinn2_event_label_a6a81e6c:

    # qu "You're not cut out for this. It's not your kind of life, but it's mine."
    qu "你不是这块料。这生活不适合你，但适合我。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4152
translate schinese ep11_pp_quinn2_event_label_d368f745:

