# freeroam\episode11\ep11_freeroam_party_events.rpy:869
translate schinese ep11_pp_ashley_event_label_d9780fe1:

    # sar "It's simple: choose neither and sleep with both."
    sar "很简单：什么都不选，两个都睡。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:871
translate schinese ep11_pp_ashley_event_label_436b7161:

    # ash "That's your advice? You're terrible at this."
    ash "这就是你的建议？你在这方面简直一窍不通。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:873
translate schinese ep11_pp_ashley_event_label_0af719ae:

    # sar "No. Relationships are terrible, and guys have the right idea about them."
    sar "不。感情这玩意儿真他妈糟糕，男人们对此的看法倒是挺对的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:875
translate schinese ep11_pp_ashley_event_label_066e44c7:

    # ash "And what idea is that?"
    ash "那是什么想法？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:877
translate schinese ep11_pp_ashley_event_label_780dea83:

    # sar "That you can always score someone better, so there's no point in settling down."
    sar "你可以随时找到更好的人，所以没必要安于现状。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:879
translate schinese ep11_pp_ashley_event_label_c03fcc73:

    # ash "Not every guy is like that."
    ash "不是每个男人都这样。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:881
translate schinese ep11_pp_ashley_event_label_2be77019:

    # sar "Every hot guy is. Who wants to bother with the rest of them?"
    sar "长得帅的男人全都这样。其他男人谁稀罕？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:883
translate schinese ep11_pp_ashley_event_label_18d0c308:

    # ash "Nuh-uh. You're wrong and that's shallow."
    ash "才不是。你错了，而且这种想法很肤浅。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:885
translate schinese ep11_pp_ashley_event_label_8ecd500a:

    # sar "[name]! Can you settle the score for us?"
    sar "[name]！你能替我们评评理吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:886
translate schinese ep11_pp_ashley_event_label_63542070:

    # sar "No matter who you're with, isn't there always a hotter chick out there?"
    sar "不管和谁在一起，外面总会有更性感的辣妹，对吧？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:890
translate schinese ep11_pp_ashley_event_label_13a59b75:

    # mc "Very few in the world can say they are the best at something. There's always someone better out there."
    mc "世界上能说自己在某方面是顶尖的没几个，总有人比你更厉害。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:891
translate schinese ep11_pp_ashley_event_label_31122970:

    # mc "Why would it be different with hotness?"
    mc "为什么美貌就例外呢？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:893
translate schinese ep11_pp_ashley_event_label_cd0913fa:

    # mc "But that doesn't mean the girl you're with isn't hot."
    mc "但这不代表和你交往的女孩不性感。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:895
translate schinese ep11_pp_ashley_event_label_2d990d75:

    # sar "Exactly! But the grass is always greener on the other side."
    sar "没错！可别人家的草总是更绿。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:897
translate schinese ep11_pp_ashley_event_label_a4635d5a:

    # mc "Nah. I figure when you're in a relationship with someone you're into, they'll be the hottest girl for you."
    mc "不。我觉得当你和真正喜欢的人交往时，在你眼里她就是最性感的女孩。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:899
translate schinese ep11_pp_ashley_event_label_17a5d569:

    # sar "That's called denial, [name]. It's something guys would say not to hurt the feelings of their girl. And it's total BS."
    sar "这叫自我欺骗，[name]。男人只会为了不伤女朋友的心才这么说，完全是胡扯。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:901
translate schinese ep11_pp_ashley_event_label_b0f1dee2:

    # mc "Sure, I think that goes for everyone and everything. Just like there's someone better than you at everything you can do, there is someone hotter than you, too."
    mc "当然，我觉得这适用于每个人和每件事。就像总有人比你更擅长你擅长的一切，也总有人比你更性感。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:902
translate schinese ep11_pp_ashley_event_label_d4721db7:

    # mc "But I'd like to think that you're not looking at those people when you're in a good relationship."
    mc "但我想你谈恋爱的时候，不会盯着那些人看。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:904
translate schinese ep11_pp_ashley_event_label_9b110b6e:

    # sar "That's called settling for something."
    sar "这叫将就。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:906
translate schinese ep11_pp_ashley_event_label_4a2c0447:

    # mc "That's an odd way to look at relationships."
    mc "这种看待恋爱关系的方式真奇怪。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:909
translate schinese ep11_pp_ashley_event_label_64ec25bd:

    # ash "Whatever, guys. This doesn't help."
    ash "随便啦，伙计们。这根本没用。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:911
translate schinese ep11_pp_ashley_event_label_0a43cce9:

    # mc "Help with what?"
    mc "帮什么忙？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:913
translate schinese ep11_pp_ashley_event_label_4a2d5e2c:

    # ash "It's private."
    ash "这是私事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:915
translate schinese ep11_pp_ashley_event_label_90a0bb32:

    # sar "Hypothetically, [name]. Do you think Ashley should dump Anthony for Derek, or what?"
    sar "只是假设，[name]。你觉得Ashley该甩掉Anthony，改和Derek交往吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:917
translate schinese ep11_pp_ashley_event_label_9a6c384e:

    # ash "Sarah!"
    ash "Sarah！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:919
translate schinese ep11_pp_ashley_event_label_a711a468:

    # sar "Hypothetically, Ash!"
    sar "只是假设，阿什！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:921
translate schinese ep11_pp_ashley_event_label_fee65a5e:

    # ash "Oh my God, you're such an asshole."
    ash "天啊，你真是个混蛋。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:923
translate schinese ep11_pp_ashley_event_label_87a53847:

    # mc "I'm biased in this question, so I'll say you should do what makes you happy."
    mc "我在这事上有点偏心，所以我说你应该做让自己开心的事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:925
translate schinese ep11_pp_ashley_event_label_181d28d9:

    # ash "I didn't ask!"
    ash "我没问！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:927
translate schinese ep11_pp_ashley_event_label_a00a5762:

    # mc "Hypothetically, of course. While he doesn't say it, I know Derek is still into you."
    mc "当然只是假设。他虽然没说出口，但我知道Derek还喜欢你。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:929
translate schinese ep11_pp_ashley_event_label_4fda9d88:

    # ash "..."
    ash "..."

# freeroam\episode11\ep11_freeroam_party_events.rpy:931
translate schinese ep11_pp_ashley_event_label_73e33bbf:

    # sar "See, it was good that I asked him, huh?"
    sar "你看，我问他这个问题是挺好的，对吧？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:933
translate schinese ep11_pp_ashley_event_label_ae51f5b0:

    # ash "I'll get you back for this one day."
    ash "总有一天我要报复回来。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:942
translate schinese ep11_pp_drink1_event_label_f2bc39a9:

    # mc "(There we go... Some punch for that girl upstairs.)"
    mc "（好了……给楼上那个女孩的潘趣酒。）"

# freeroam\episode11\ep11_freeroam_party_events.rpy:948
translate schinese ep11_pp_zoey_event_label_d28b3499:

    # he "Why shouldn't I come to a party with my friends? Because Tommy's there? Grow up."
    he "我为什么不能和朋友来参加派对？因为Tommy也在？成熟点吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:950
translate schinese ep11_pp_zoey_event_label_9998b8e4:

    # ml "I was just asking if it was awkward."
    ml "我只是问一下会不会尴尬。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:952
translate schinese ep11_pp_zoey_event_label_84efcfa2:

    # he "It's not awkward. I'll go where I please. And if Tommy feels awkward that I'm here, he'll have to deal with it."
    he "没什么尴尬的。我想去哪就去哪。如果Tommy因为我在这里觉得尴尬，那是他的问题。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:954
translate schinese ep11_pp_zoey_event_label_3853755f:

    # le "No, he's fine with it. I already asked."
    le "不会，他并不介意。我已经问过了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:956
translate schinese ep11_pp_zoey_event_label_e93bf01c:

    # he "What did he say?"
    he "他怎么说的？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:958
translate schinese ep11_pp_zoey_event_label_a5b64f21:

    # le "Not much. You know him. But I figured he would have put up a fight if he didn't want it."
    le "没什么。你了解他的。不过我猜如果他不想这样，应该会闹一场的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:960
translate schinese ep11_pp_zoey_event_label_7dc559e0:

    # zo "Did you guys break up recently?"
    zo "你们最近分手了吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:962
translate schinese ep11_pp_zoey_event_label_9ec7b8bb:

    # he "Around Thanksgiving. But there's been friction for quite some time before that."
    he "感恩节前后。不过早在那之前，我们之间就摩擦不断了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:963
translate schinese ep11_pp_zoey_event_label_770a627b:

    # he "But that's what happens when you agree to be in an open relationship that only was \"open\" for one of us."
    he "可我们所谓的开放式关系，只对其中一个人‘开放’，结果当然会变成这样。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:965
translate schinese ep11_pp_zoey_event_label_1d20932d:

    # zo "Oh..."
    zo "哦……"

# freeroam\episode11\ep11_freeroam_party_events.rpy:967
translate schinese ep11_pp_zoey_event_label_011cf14b:

    # he "Yeah, \"Oh\". You don't have to sympathize or try to understand it. It's over now."
    he "对，就是‘哦’。你不必同情，也不用费心理解。现在已经结束了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:969
translate schinese ep11_pp_zoey_event_label_987c9ce5:

    # ml "What about you, Zoey? You're single, yeah?"
    ml "那你呢，Zoey？你还是单身，对吧？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:971
translate schinese ep11_pp_zoey_event_label_e70082f1:

    # zo "Eh... Yeah. I'm single. Is it that obvious?"
    zo "嗯……是的。我单身。这么明显吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:973
translate schinese ep11_pp_zoey_event_label_89654fbc:

    # ml "No, I could tell from how much Jacob likes you."
    ml "不是，我是从Jacob那么喜欢你看出来的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:975
translate schinese ep11_pp_zoey_event_label_321b0556:

    # zo "He's just a friend."
    zo "他只是个朋友。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:977
translate schinese ep11_pp_zoey_event_label_28638321:

    # ml "For now, haha."
    ml "现在嘛，哈哈。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:979
translate schinese ep11_pp_zoey_event_label_ebaac669:

    # le "Jacob is a great guy. Trustworthy, empathetic, funny..."
    le "Jacob人很好。可靠、体贴、风趣……"

# freeroam\episode11\ep11_freeroam_party_events.rpy:981
translate schinese ep11_pp_zoey_event_label_61cb4377:

    # zo "I'm sure he is."
    zo "他肯定是个好家伙。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:983
translate schinese ep11_pp_zoey_event_label_16d982eb:

    # mc "Why are you all standing here? There's dancing in Tommy's room."
    mc "你们怎么都站在这里？Tommy房间里可以跳舞。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:985
translate schinese ep11_pp_zoey_event_label_2a935d5c:

    # mc "Oh, shit. Sorry! I didn't see you there, Heather."
    mc "哦，该死。抱歉！我没看见你也在，Heather。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:987
translate schinese ep11_pp_zoey_event_label_968ae011:

    # he "I'm ok! Ok? Can everyone stop assuming I'm not?"
    he "我没事！听到了吗？大家都别再以为我出事了！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:990
translate schinese ep11_pp_zoey_event_label_8621a0c2:

    # mc "Now that we have established that Heather is doing ok... How are the rest of you doing?"
    mc "既然已经确认Heather没事……你们其他人怎么样？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:992
translate schinese ep11_pp_zoey_event_label_6624ced4:

    # mc "I didn't mean to start something. Uh... So, how's everyone doing?"
    mc "我没想挑起什么。呃……大家现在都还好吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:994
translate schinese ep11_pp_zoey_event_label_0e7a12c4:

    # ml "Weak party, so far. Did you even invite any guys?"
    ml "目前派对有点冷清。你们到底有没有邀请男生？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:996
translate schinese ep11_pp_zoey_event_label_ff8d6ab9:

    # mc "Of course, we did. Here's one of them."
    mc "当然，我们请了。这是其中一个。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:999
translate schinese ep11_pp_zoey_event_label_604a3348:

    # mc "And he came dressed as a guy for this party for a change. Or maybe as a topless girl?"
    mc "他这次穿得像个男生，算是换了个风格。或者……是穿得像个没穿衣服的女生？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1001
translate schinese ep11_pp_zoey_event_label_537b5d98:

    # le "You're such an ass."
    le "你真是个蠢货。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1003
translate schinese ep11_pp_zoey_event_label_7e77199f:

    # mc "A hell of a guy, too."
    mc "真他妈个狠角色。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1005
translate schinese ep11_pp_zoey_event_label_2db85c37:

    # ml "Mhm. So, only DIKs?"
    ml "嗯。所以只有DIKs的人？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1007
translate schinese ep11_pp_zoey_event_label_f97f7b93:

    # mc "No, no. Others too. There is someone behind you... And I've seen some more hanging around."
    mc "不，不光是他们。还有其他人。你后面有人，我刚才还看到几个在附近晃悠。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1009
translate schinese ep11_pp_zoey_event_label_e5b4c352:

    # zo "You see what she's getting at, don't you? There are way more girls than guys here."
    zo "你明白她想说什么，对吧？这里女生比男生多太多了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1011
translate schinese ep11_pp_zoey_event_label_f7b98506:

    # mc "I'm sorry, but I had to do it WWTD style."
    mc "抱歉，但我得按WWTD的方式来。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1013
translate schinese ep11_pp_zoey_event_label_47dc6765:

    # he "A what style?"
    he "什么风格？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1015
translate schinese ep11_pp_zoey_event_label_383f0b62:

    # mc "WWTD. What would Tommy do? He'd invite more girls than guys to skew the ratio in favor of the dudes."
    mc "WWTD，意思是‘Tommy会怎么做？’他会多邀请女孩，把男女比例变得对男生有利。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1017
translate schinese ep11_pp_zoey_event_label_9c1c48a2:

    # he "Don't tell me there are two of you."
    he "别告诉我又出了一个汤米。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1019
translate schinese ep11_pp_zoey_event_label_ea1a27dd:

    # mc "I did it for him. He's been pretty bummed out lately."
    mc "我是为了他才这么做的。他最近心情挺差的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1020
translate schinese ep11_pp_zoey_event_label_d6763ba5:

    # mc "Again... Sorry, Heather."
    mc "还是要说……抱歉，Heather。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1022
translate schinese ep11_pp_zoey_event_label_b4b9b905:

    # he "Has he really?"
    he "他真的很消沉吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1024
translate schinese ep11_pp_zoey_event_label_c3517f41:

    # ml "Nick isn't coming, right?"
    ml "Nick不会来，对吧？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1026
translate schinese ep11_pp_zoey_event_label_6b50993c:

    # le "We're not talking about him tonight. He's not here to defend himself."
    le "今晚别谈他。他不在这里，没法为自己辩解。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1028
translate schinese ep11_pp_zoey_event_label_975df01a:

    # ml "So, you guys are cool? I heard you weren't."
    ml "所以你们俩没事？我听说你们之前有点不愉快。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1030
translate schinese ep11_pp_zoey_event_label_1c901bbe:

    # le "He's still one of us."
    le "他还是我们中的一员。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1032
translate schinese ep11_pp_zoey_event_label_774424f0:

    # ml "But he left."
    ml "但他走了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1037
translate schinese ep11_pp_zoey_event_label_173dab13:

    # mc "Mel is right, though. We're far from cool. He's a fucking ass, if you ask me."
    mc "不过梅兰妮说得对，我们远远谈不上和好。依我看，他就是个混蛋。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1039
translate schinese ep11_pp_zoey_event_label_cc5c29e7:

    # mc "Mel is right, though. We're far from cool. I didn't invite him tonight."
    mc "不过梅兰妮说得对，我们远远谈不上和好。我今晚没邀请他。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1041
translate schinese ep11_pp_zoey_event_label_1cdfc149:

    # ml "I didn't realize it was that bad."
    ml "我没想到事情会这么糟。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1044
translate schinese ep11_pp_zoey_event_label_64f22922:

    # mc "What Leon's trying to say is that we're not done arguing and that anything can happen. And we're not going to talk badly about the guy."
    mc "Leon想说的是，我们还没吵完，接下来什么都有可能发生。而且我们不会在背后说他坏话。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1046
translate schinese ep11_pp_zoey_event_label_d0d7de8c:

    # ml "I wasn't saying you should talk smack; I was asking where he was tonight. But I get it, it's sensitive."
    ml "我没说你该去说他坏话，我是问他今晚去哪儿了。不过我懂，这事儿挺敏感的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1049
translate schinese ep11_pp_zoey_event_label_e53d400b:

    # zo "Nick is a DIK, right? What did he do?"
    zo "Nick是DIK的一员，对吧？他做了什么？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1051
translate schinese ep11_pp_zoey_event_label_834fb6c2:

    # he "*{i}Groans{/i}*"
    he "*{i}不耐烦地呻吟{/i}*"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1054
translate schinese ep11_pp_zoey_event_label_2335a18b:

    # mc "Let's chat over here for a while."
    mc "我们在这边聊一会儿吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1056
translate schinese ep11_pp_zoey_event_label_aea39190:

    # zo "Did I say something wrong? Everyone else was talking about him."
    zo "我是不是说错什么了？大家伙都在说他。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1058
translate schinese ep11_pp_zoey_event_label_63903855:

    # mc "No, you didn't... However, Nick is one of the reasons Heather broke up with Tommy."
    mc "你没说错……不过Nick确实是Heather和Tommy分手的原因之一。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1060
translate schinese ep11_pp_zoey_event_label_b1119c0d:

    # mc "Well... I am, too."
    mc "我也是。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1061
translate schinese ep11_pp_zoey_event_label_cdd1a843:

    # mc "Enough about that. How are you settling in? You seem more comfortable now than when you showed up."
    mc "不说那个了。你适应得怎么样？看起来比刚来时自在多了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1063
translate schinese ep11_pp_zoey_event_label_b11fb0ad:

    # zo "It's called liquid courage, and I'm increasing it by the minute."
    zo "这叫酒壮人胆，而且我每分钟都在继续加量。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1065
translate schinese ep11_pp_zoey_event_label_765ce3d8:

    # mc "Haha, that's good. You don't have to do that Dirty Bowl mission if you don't want to, by the way. I'll give you a pass."
    mc "哈哈，那就好。对了，你不想做污污碗任务就不用做，我可以放你一马。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1067
translate schinese ep11_pp_zoey_event_label_baa72474:

    # zo "What mission?"
    zo "什么任务？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1069
translate schinese ep11_pp_zoey_event_label_6293597e:

    # mc "The ones Derek is handing out. I'd avoid him if I were you."
    mc "就是Derek在发的那些任务。换作我，就会躲着他。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1071
translate schinese ep11_pp_zoey_event_label_83ef1ed2:

    # zo "That's fine. I only came here so I could talk to you. I bet you're gonna be busy tonight as always."
    zo "这就行。我来这里就为了能和你聊聊。我打赌你今晚又会忙得不可开交。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1073
translate schinese ep11_pp_zoey_event_label_dccb2f7b:

    # mc "Somewhat, yeah. But not as bad as it was during Halloween. And I've got some more help from Derek handling things."
    mc "是有点忙，不过没万圣节派对时那么夸张，而且Derek也帮我分担了不少。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1074
translate schinese ep11_pp_zoey_event_label_34513af2:

    # mc "I have time to talk to you. So, what's up? Anything on your mind?"
    mc "我有时间跟你聊。所以，咋了？有什么想说的？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1076
translate schinese ep11_pp_zoey_event_label_456a88b0:

    # zo "A lot."
    zo "好多。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1078
translate schinese ep11_pp_zoey_event_label_ddf3237b:

    # mc "Let's hear it."
    mc "说吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1084
translate schinese ep11_pp_zoey_event_label_d61e97d1:

    # zo "Uh... I..."
    zo "嗯……我……"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1085
translate schinese ep11_pp_zoey_event_label_2a13952f:

    # zo "Guess who will maybe start at B&R in the spring?"
    zo "猜猜谁明年春天或许会入读B&R？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1087
translate schinese ep11_pp_zoey_event_label_fd69ab47:

    # mc "No way...? Did you apply?"
    mc "不可能……？你申请了？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1089
translate schinese ep11_pp_zoey_event_label_5d14f08f:

    # zo "Kinda late, but yeah, I did. I'm scared my chances suck, but we'll see."
    zo "申请得有点晚，不过对，我申请了。我很怕自己机会渺茫，只能等结果了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1091
translate schinese ep11_pp_zoey_event_label_c377a675:

    # mc "What did you apply for?"
    mc "你申请了什么？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1093
translate schinese ep11_pp_zoey_event_label_1d552272:

    # zo "A four-year digital design program. It's intimidating as fuck."
    zo "四年制数字设计专业。想想就他妈吓人。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1095
translate schinese ep11_pp_zoey_event_label_9be914af:

    # mc "That's awesome. I've always known you were talented with that."
    mc "这太棒了。我早知道你在那方面很有天赋。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1097
translate schinese ep11_pp_zoey_event_label_ebaefe30:

    # zo "Digital design and drawing isn't the same, dude."
    zo "数字设计和画画不是一回事，老兄。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1099
translate schinese ep11_pp_zoey_event_label_8d684345:

    # mc "No, but I think you will do amazing. I'm happy for you."
    mc "不，但我认为你会做得非常棒。我真心为你高兴。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1101
translate schinese ep11_pp_zoey_event_label_3c5ac0c4:

    # zo "You are?"
    zo "你真的为我高兴？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1103
translate schinese ep11_pp_zoey_event_label_620c829e:

    # mc "Of course! I think it's great that you found something you want to do."
    mc "当然！我觉得你找到自己想做的事情真的很棒。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1105
translate schinese ep11_pp_zoey_event_label_71de070d:

    # zo "Yeah... Same."
    zo "嗯……我也是。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1107
translate schinese ep11_pp_zoey_event_label_187328b9:

    # mc "We'll see each other a lot next year then."
    mc "我们明年肯定能经常见面。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1109
translate schinese ep11_pp_zoey_event_label_8e958556:

    # zo "You're talking as if it's decided. I don't even know if I'll get in. A lot can happen in a month. Maybe I was too late?"
    zo "你说话的语气好像已经确定了。我甚至还不确定自己能不能进。一个月里能发生很多事情，也许我来得太晚了？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1111
translate schinese ep11_pp_zoey_event_label_c894deee:

    # mc "Even so..."
    mc "就算这样..."

# freeroam\episode11\ep11_freeroam_party_events.rpy:1117
translate schinese ep11_pp_zoey_event_label_34145219:

    # mc "Thanks for sharing it with me."
    mc "谢谢你告诉我。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1119
translate schinese ep11_pp_zoey_event_label_7e00d980:

    # zo "I wanted you to hear it first. After Mom, of course."
    zo "我想让你第一个知道。当然，是除我妈以外的第一个。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1121
translate schinese ep11_pp_zoey_event_label_e8b381b0:

    # mc "Is she supportive?"
    mc "她支持你吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1123
translate schinese ep11_pp_zoey_event_label_9eff8634:

    # zo "Very."
    zo "非常。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1125
translate schinese ep11_pp_zoey_event_label_c3bdead5:

    # mc "That was some big news. I'm happy you told me face-to-face."
    mc "这可是个大消息。你愿意当面告诉我，我很高兴。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1127
translate schinese ep11_pp_zoey_event_label_abc2bf5b:

    # zo "There's another thing too. But..."
    zo "还有件事。但..."

# freeroam\episode11\ep11_freeroam_party_events.rpy:1128
translate schinese ep11_pp_zoey_event_label_6404f028:

    # zo "It can wait until later."
    zo "还是晚点再说吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1130
translate schinese ep11_pp_zoey_event_label_15ce6f0c:

    # mc "I've got time."
    mc "我有时间。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1132
translate schinese ep11_pp_zoey_event_label_9dd01294:

    # zo "No. Not yet. I'm not in a rush tonight."
    zo "不，现在还不行。我今晚不着急。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1134
translate schinese ep11_pp_zoey_event_label_50a64bbe:

    # mc "Alright. I'll get back to checking up on the party then, and you can grab me whenever you want."
    mc "那我先去检查一下派对的情况，你什么时候需要我，随时叫就行。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1135
translate schinese ep11_pp_zoey_event_label_e07bd7df:

    # mc "With that first piece of news, you got me hyped for the second round already."
    mc "第一个消息已经让我很兴奋，更期待第二个了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1145
translate schinese ep11_pp_bianca_event_label_d611c47a:

    # mc "Hey! How's it going?"
    mc "嘿！咋样？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1148
translate schinese ep11_pp_bianca_event_label_b16c3128:

    # bia "There he is! We've been looking for you."
    bia "他来了！我们一直在找你。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1150
translate schinese ep11_pp_bianca_event_label_96e201d4:

    # bia "Thank you so much for the invite."
    bia "谢谢你的邀请。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1152
translate schinese ep11_pp_bianca_event_label_6d5f8951:

    # mc "Don't mention it."
    mc "别客气。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1154
translate schinese ep11_pp_bianca_event_label_c93d6b2d:

    # mc "Welcome, Carla. What a great party you chose for your first one."
    mc "欢迎，Carla。第一次参加就选中了这么棒的派对。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1157
translate schinese ep11_pp_bianca_event_label_3c96980c:

    # bia "Thank you so much for the invite. I had to bring Carla to one of your parties, haha!"
    bia "非常感谢你的邀请。我必须带Carla来参加一次你们的派对，哈哈！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1159
translate schinese ep11_pp_bianca_event_label_26d81951:

    # mc "Don't mention it. Welcome, Carla. What a great party you chose for your first one."
    mc "别客气。欢迎，Carla。第一次参加就选中了这么棒的派对。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1161
translate schinese ep11_pp_bianca_event_label_d7a4991c:

    # car "Oh, it's not my first. I went to one last year, but it wasn't anything like this."
    car "哦，这可不是我第一次。我去年也参加过一个，但跟这个完全没法比。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1162
translate schinese ep11_pp_bianca_event_label_25324cd3:

    # car "This one makes me wonder what went through your mind when you planned it. This party is nuts."
    car "这场派对让我很想知道，你策划时脑子里究竟在想什么。实在太疯狂了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1164
translate schinese ep11_pp_bianca_event_label_67d2d75d:

    # mc "I have to take responsibility for this one... I planned it."
    mc "我得为这次负责……是我策划的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1166
translate schinese ep11_pp_bianca_event_label_f9dd7d08:

    # bia "Hahaha! No way! Was it your idea to have a lingerie Christmas party?"
    bia "哈哈哈！不可能吧！这是你搞的内衣圣诞派对？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1168
translate schinese ep11_pp_bianca_event_label_3dc012cc:

    # mc "A Christmas Panty party, if you will... And yes. But also, they have had these parties in the past, so I can't take full credit for the idea."
    mc "准确地说是圣诞内裤派对……没错，是我的主意。不过以前他们也办过，所以创意不能全算我的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1172
translate schinese ep11_pp_bianca_event_label_b6a44f70:

    # bia "So, what was Jill's excuse for not showing up?"
    bia "所以Jill找了什么借口不来？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1174
translate schinese ep11_pp_bianca_event_label_f3c58161:

    # mc "She's busy tonight with Bella and friends. I wish I could say she would have loved to come, but she wouldn't."
    mc "她今晚要和贝拉她们聚会。我倒想说她会很愿意来，但她肯定不愿意。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1176
translate schinese ep11_pp_bianca_event_label_7e7abe55:

    # bia "Haha! Nope! We couldn't have convinced her either."
    bia "哈哈！没那回事！我们也没法说服她。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1179
translate schinese ep11_pp_bianca_event_label_88aa7b3b:

    # bia "Did you invite Jill? She said she wasn't coming, but I was unsure if she was invited."
    bia "你邀请Jill了吗？她说自己不来，可我不确定她有没有收到邀请。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1181
translate schinese ep11_pp_bianca_event_label_24413bd7:

    # mc "Yeah, I invited her. But she was busy tonight."
    mc "我请了她。但她今晚有事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1183
translate schinese ep11_pp_bianca_event_label_472a34a3:

    # bia "That's convenient, haha."
    bia "这倒是方便，哈哈。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1185
translate schinese ep11_pp_bianca_event_label_5232160a:

    # mc "I'm happy you two showed up. Did you bring anyone with you?"
    mc "我高兴你们两个来了。你们带人一起来的吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1189
translate schinese ep11_pp_bianca_event_label_320bc046:

    # bia "I was going to bring my boyfriend, Matthew, but he had dinner plans with some friends."
    bia "我本来想带男朋友Matthew来，但他约了朋友吃晚饭。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1191
translate schinese ep11_pp_bianca_event_label_df9440ae:

    # bia "Matty couldn't come; he had dinner plans with some friends."
    bia "马蒂来不了，他约了朋友吃晚饭。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1194
translate schinese ep11_pp_bianca_event_label_a9e8a887:

    # car "I asked my boyfriend, Jeff, to come, but he never goes to my college parties. He finds them too loud and annoying."
    car "我邀请了男朋友Jeff，但他从不参加我的大学派对，觉得又吵又烦。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1196
translate schinese ep11_pp_bianca_event_label_c1099d1f:

    # car "I asked Jeff to come, but he never tags along to my college parties. He finds them too loud and annoying."
    car "我邀请了Jeff，但他从不陪我参加大学派对，觉得又吵又烦。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1197
translate schinese ep11_pp_bianca_event_label_4d0f4fc1:

    # car "He was worried about the theme when I showed him what I'd be wearing."
    car "我把今晚要穿的衣服给他看时，他很担心这个派对主题。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1199
translate schinese ep11_pp_bianca_event_label_e33cf808:

    # mc "Tell Jeff not to worry; you're in good hands tonight."
    mc "告诉Jeff别担心，今晚我们会照顾好你。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1201
translate schinese ep11_pp_bianca_event_label_2f486710:

    # car "I'd tell him, if you guys didn't confiscate our phones."
    car "要不是你们没收了手机，我就告诉他了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1203
translate schinese ep11_pp_bianca_event_label_b6765887:

    # mc "Ah, sorry about that. It's a party rule for all guests."
    mc "啊，抱歉啦。这是给所有客人的规矩。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1204
translate schinese ep11_pp_bianca_event_label_cecf7659:

    # mc "You can always use it by the front door."
    mc "你随时可以在门口用。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1206
translate schinese ep11_pp_bianca_event_label_1ae057a8:

    # car "It's fine. I wouldn't know where to put it anyway. This outfit doesn't have pockets."
    car "没关系。我也不知道该放在哪儿。这套衣服根本没口袋。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1207
translate schinese ep11_pp_bianca_event_label_a5c0e086:

    # car "Did I emphasize how nuts the party is?"
    car "我有没有强调过这个派对有多疯狂？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1209
translate schinese ep11_pp_bianca_event_label_806a5a9b:

    # de "New guests! Welcome! You have to pull a mission from The Dirty Bowl."
    de "新客人！欢迎！你们必须从污污碗里抽一个任务。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1211
translate schinese ep11_pp_bianca_event_label_d58cb6f9:

    # bia "What is that? It sounds scary."
    bia "这是什么？听起来好吓人。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1214
translate schinese ep11_pp_bianca_event_label_23006f3c:

    # mc "Carla has a boyfriend, Derek. Maybe you should let her slide."
    mc "Carla有男朋友，Derek。也许你该放她一马。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1216
translate schinese ep11_pp_bianca_event_label_2dee16e2:

    # mc "They have boyfriends, Derek. Maybe you should give them a free pass."
    mc "她们都有男朋友，Derek。也许你该免掉她们的任务。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1218
translate schinese ep11_pp_bianca_event_label_a5fafc7c:

    # de "No way. Every guest must take a mission. No exceptions. Boyfriend or girlfriend, it doesn't matter."
    de "不行，每位客人都必须抽一个任务，没有例外。有男朋友还是女朋友都不重要。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1219
translate schinese ep11_pp_bianca_event_label_25dea6ec:

    # de "We treat everyone equally tonight. I don't make the rules."
    de "今晚人人平等。我又不是制定规则的人。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1221
translate schinese ep11_pp_bianca_event_label_dfe17cef:

    # mc "Except that you did help make the rules."
    mc "可你明明也参与制定了规则。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1223
translate schinese ep11_pp_bianca_event_label_9dfdeaac:

    # de "No exceptions."
    de "没有例外。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1225
translate schinese ep11_pp_bianca_event_label_47e5b8a3:

    # bia "It's fine. We'll take one each. There!"
    bia "行，我们各拿一个。搞定！"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1227
translate schinese ep11_pp_bianca_event_label_c1e1f85b:

    # de "Best of luck to you. Finish them by midnight or face the consequences."
    de "祝你们好运。午夜前完成，否则就要面对后果。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1229
translate schinese ep11_pp_bianca_event_label_46abb311:

    # car "Then, I'll be out of here come midnight. Look."
    car "那我午夜就溜了，你看着办吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:1230
translate schinese ep11_pp_bianca_event_label_c9366d42:

    # bia "Oh my God! Hahaha!"
    bia "天啊！哈哈哈！"

