translate schinese ep11_pp_zoey_endb_label_9a53bd6a:

    # mc "Let's go to my room."
    mc "我们去我房间吧。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4243
translate schinese ep11_pp_zoey_endb_label_88805f74:

    # zo "Where do I begin...?"
    zo "我从哪儿说起啊……"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4245
translate schinese ep11_pp_zoey_endb_label_8f361844:

    # mc "Is it something important...?"
    mc "这是什么事儿啊……？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4247
translate schinese ep11_pp_zoey_endb_label_cecb8359:

    # zo "Yeah."
    zo "嗯。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4249
translate schinese ep11_pp_zoey_endb_label_a4a7a98d:

    # mc "I'm all ears."
    mc "我洗耳恭听。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4257
translate schinese ep11_pp_zoey_endb_label_25757065:

    # zo "Do you remember the day we met?"
    zo "还记得我们第一次见面的那天吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4259
translate schinese ep11_pp_zoey_endb_label_46f76d61:

    # mc "In detention? How could I ever forget that day?"
    mc "被关禁闭？我怎么可能会忘记那天？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4260
translate schinese ep11_pp_zoey_endb_label_ba371ffd:

    # mc "It's etched into my memory."
    mc "刻在我记忆里。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4262
translate schinese ep11_pp_zoey_endb_label_364bb620:

    # zo "That was a bad day for you."
    zo "那是你倒霉的一天。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4264
translate schinese ep11_pp_zoey_endb_label_82063093:

    # mc "I'll say."
    mc "我倒是这么觉得。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4266
translate schinese ep11_pp_zoey_endb_label_1b901c91:

    # zo "For me, it was a standard day. I had lost count of the number of days I spent in detention."
    zo "对我而言，那只是普通的一天。我已经数不清有多少天是在禁闭室度过的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4267
translate schinese ep11_pp_zoey_endb_label_d879e60f:

    # zo "And I could tell that you weren't the typical kid to be there."
    zo "我能看出来你可不是那种会进禁闭室的普通学生。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4269
translate schinese ep11_pp_zoey_endb_label_59a7aa75:

    # zo "But you were so angry. So, I figured something big must have happened for you to earn detention."
    zo "但你当时气得不行。所以我猜你一定发生了什么大事，才会被送去留校察看。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4271
translate schinese ep11_pp_zoey_endb_label_23f46ead:

    # mc "I remember I wondered what you were there for, too."
    mc "我记得我当时也好奇你为什么会去那里。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4273
translate schinese ep11_pp_zoey_endb_label_578f619f:

    # zo "Smoking in class. I was so stupid and edgy back then."
    zo "在课堂上抽烟。我当时真是蠢得不行，脾气也特别躁。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4275
translate schinese ep11_pp_zoey_endb_label_b619ae39:

    # zo "Do you remember the first thing I said to you?"
    zo "你还记得我第一次对你说的话吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4277
translate schinese ep11_pp_zoey_endb_label_ef3a2f55:

    # mc "Yeah. \"Do you want some gum?\"."
    mc "对。\"要来块口香糖吗？\""

# freeroam\episode11\ep11_freeroam_party_events.rpy:4278
translate schinese ep11_pp_zoey_endb_label_1b608a06:

    # mc "I wanted that gum, but I turned it down."
    mc "我想吃那颗口香糖，但还是拒绝了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4280
translate schinese ep11_pp_zoey_endb_label_6a399c44:

    # zo "You should have just said yes."
    zo "你应该直接说好。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4282
translate schinese ep11_pp_zoey_endb_label_1e338d02:

    # mc "I didn't want to take it; it was yours."
    mc "我没想拿你的口香糖，那是你的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4284
translate schinese ep11_pp_zoey_endb_label_6a84bf8d:

    # zo "I would have felt more comfortable talking to you earlier if you had."
    zo "如果早些时候你接受了，我可能会更自在地和你说话。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4286
translate schinese ep11_pp_zoey_endb_label_e7bc63e2:

    # mc "It worked out eventually, didn't it?"
    mc "结果还是搞定了，不是吗？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4288
translate schinese ep11_pp_zoey_endb_label_98fc66b4:

    # zo "It sure did."
    zo "确实挺棒的。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4290
translate schinese ep11_pp_zoey_endb_label_b926518f:

    # zo "I never told you this, but being in detention with you was the highlight of my day back then."
    zo "我从来没跟你说过，但那时候和你一起被关禁闭，是我那天最开心的事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4292
translate schinese ep11_pp_zoey_endb_label_c3ad8c60:

    # mc "It was?"
    mc "这是什么意思？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4294
translate schinese ep11_pp_zoey_endb_label_8e396a55:

    # zo "Yeah. And you were gonna be there for two months."
    zo "对。而且你得在那里待两个月。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4295
translate schinese ep11_pp_zoey_endb_label_5f5336c3:

    # zo "So, I smoked in class again on purpose to get more detention, knowing I would spend it with you."
    zo "所以我故意在课堂上抽烟，就是为了多待一会儿，和你一起坐禁闭。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4297
translate schinese ep11_pp_zoey_endb_label_15d4a291:

    # mc "You did?"
    mc "你真的做了？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4299
translate schinese ep11_pp_zoey_endb_label_69f46ea9:

    # zo "Stupid, huh?"
    zo "蠢啊？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4301
translate schinese ep11_pp_zoey_endb_label_ff0142cf:

    # mc "Um, yeah. You could have gotten expelled."
    mc "嗯，你本来可能就被开除了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4303
translate schinese ep11_pp_zoey_endb_label_42bf6f1c:

    # zo "I know."
    zo "我知道。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4305
translate schinese ep11_pp_zoey_endb_label_b1cbfc01:

    # mc "We could have spent time after school, you know? It didn't have to be in detention."
    mc "我们本可以放学后一起花时间，你明白吧？不一定非得在禁闭室里。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4307
translate schinese ep11_pp_zoey_endb_label_f1419487:

    # zo "I was insecure. I wasn't sure if you would want to be around me outside of detention."
    zo "我那时很没自信，不确定离开禁闭室以后，你还愿不愿意和我待在一起。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4308
translate schinese ep11_pp_zoey_endb_label_4e67c574:

    # zo "I wasn't the best at expressing myself back then."
    zo "我当时还不太会表达自己。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4310
translate schinese ep11_pp_zoey_endb_label_47e27164:

    # mc "Well... Who was?"
    mc "那……当时是谁？"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4312
translate schinese ep11_pp_zoey_endb_label_0e725dea:

    # mc "We've come a long way since."
    mc "我们从那时候已经走得很远了。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4316
translate schinese ep11_pp_zoey_endb_label_c4ced9d5:

    # zo "Not really."
    zo "真的没那么回事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4317
translate schinese ep11_pp_zoey_endb_label_f7bd51d6:

    # zo "Even though I draw and write a lot, I'm still not good at expressing myself."
    zo "尽管我经常画画和写作，我还是不擅长表达自己。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4327
translate schinese ep11_pp_zoey_endb_label_93d18c5f:

