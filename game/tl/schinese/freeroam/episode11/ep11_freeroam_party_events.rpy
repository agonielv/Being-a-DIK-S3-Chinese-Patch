translate schinese ep11_pp_zoey_end_label_7863d03e:

    # lea "Yeah, but some people left because they feared the punishment and others caved and did theirs."
    lea "对，但有些人是因为害怕惩罚而离开了，还有些人干脆认了，做了那事。"

# freeroam\episode11\ep11_freeroam_party_events.rpy:4202
translate schinese ep11_pp_zoey_end_label_37391a96:

    # de "Well, that's life for you. Enjoy the rest of the party!"
