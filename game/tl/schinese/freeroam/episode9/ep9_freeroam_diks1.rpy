# freeroam\episode9\ep9_freeroam_diks1.rpy:454
translate schinese ep9_final_diks2_library_desk_label_b38991e6:

    # mc "(No studying tonight; it's a party, and classes after midterms haven't started yet.)"
    mc "（今晚不学习。现在是派对，而且期中考试后的课程还没开始。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:458
translate schinese ep9_final_diks2_library_desk_label_3d60c0bd:

    # mc "(Mom's monkey pose is fantastic. It makes it even better that her friends are taking the picture seriously.)"
    mc "（妈妈摆的猴子姿势太棒了，她的朋友们还一本正经地拍照，让这张照片更加好笑。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:548
translate schinese ep9_diks_ph1_lib_right_label_nofx_6ed7bdd8:

    # mc "(That's Elena's camera and some school equipment. The HOTs wanted a place to take pictures of the guests, and Jacob got excited.)"
    mc "（那是Elena的相机和学校的一些设备。HOT们想找个地方替客人拍照，Jacob一听就来劲了。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:549
translate schinese ep9_diks_ph1_lib_right_label_nofx_7637ac65:

    # mc "(One thing led to another, and now I have a photo studio in my room.)"
    mc "（事情就这么一步步发展，最后我的房间变成了摄影棚。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:710
translate schinese ep9_diks_ph1_2ua_label_nofx_47bcb71e:

    # mc "(A scarecrow and a ghost. Whoever that is just put a sheet over them and painted black eyes on it. It's not the worst costume here, but it probably won't win the costume contest.)"
    mc "（一个稻草人和一个鬼。不管是谁，就是拿床单盖住身子，再画上黑眼圈。这装扮不算最差，但估计也赢不了最佳服装比赛。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:826
translate schinese ep9_diks_ph1_left_hall2_label_694b52dd:

    # mc "(We locked this door for the party. Jamie didn't want anyone to ruin his plants by pissing on them.)"
    mc "（我们锁了这扇门办派对。Jamie可不想有人把他的植物尿了。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:846
translate schinese ep9_diks_ph1_left_hall_label_e2679048:

    # mc "(Spooky!)"
    mc "（好吓人！）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:875
translate schinese ep9_diks_ph1_rusty_room_label_nofx_8cdaf1c4:

    # mc "(A murder mystery, eh? Tommy had a good idea for these decorations.)"
    mc "（谋杀谜案，是吗？Tommy这套装饰的点子不错。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:876
translate schinese ep9_diks_ph1_rusty_room_label_nofx_8f6a7a25:

    # mc "(The victim seems to be a male with a huge cock. So... There are two of us? Haha! Well, not anymore.)"
    mc "（受害者似乎是个长着巨根的男人。所以……这种人有两个？哈哈！好吧，现在只剩一个了。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:880
translate schinese ep9_diks_ph1_rusty_room_label_nofx_e470345a:

    # mc "(A gun shell? The murder weapon must be a gun.)"
    mc "（一枚弹壳？凶器一定是枪。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:884
translate schinese ep9_diks_ph1_rusty_room_label_nofx_cedb1d8f:

    # mc "(Lipstick on the glass... But the first piece of evidence shows that the victim is male. Is the killer a female?)"
    mc "（玻璃杯上有口红……可第一条证据表明受害者是男性。凶手是女人吗？）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:888
translate schinese ep9_diks_ph1_rusty_room_label_nofx_37a053b6:

    # mc "(Hm, where is evidence number {color=#00ff00}4{/color}?)"
    mc "（嗯，编号为{color=#00ff00}4{/color}的证据在哪里？）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:889
translate schinese ep9_diks_ph1_rusty_room_label_nofx_42a046c6:

    # mc "(Oh! There's something behind the cushion. A gun! The murder weapon?)"
    mc "（哦！垫子后面有东西。一把枪！是凶器吗？）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:930
translate schinese ep9_diks_ph1_right_hall_label_e38eb4b0:

    # mc "(Eyeballs, severed fingers, and pumpkin muffins. It sounds like a winning combination. And I don't care what the others say; to me, that looks like a small Christmas tree.)"
    mc "（眼球、断指和南瓜松饼，听起来是个必胜组合。管别人怎么说，在我看来，那就是一棵小圣诞树。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:933
translate schinese ep9_diks_ph1_right_hall_label_b372e826:

    # mc "(It's kind of ironic. On any other day than today, that noose would be terrifying. And on the day it's supposed to be scary, it's not.)"
    mc "（有点讽刺。换作任何一天，那条绞索都会很吓人。可到了它本该吓人的今天，反而不可怕了。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1023
translate schinese ep9_diks_ph1_leon_room_label_nofx_0447991e:

    # mc "(I'm not scared of spiders, but I would be if that thing were real.)"
    mc "（我不怕蜘蛛，但如果那玩意是真的，我肯定会害怕。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1026
translate schinese ep9_diks_ph1_leon_room_label_nofx_4f83d1af:

    # mc "(Are those Halloween props or used for other purposes?)"
    mc "（这些究竟是万圣节道具，还是平时另有用途？）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1058
translate schinese ep9_diks_ph1_toilet_2nd_label_nofx_52131a84:

    # mc "(Disgusting and cool at the same time. I hope it's easy to clean up.)"
    mc "（恶心又酷，真是完美组合。希望清理起来不麻烦。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1091
translate schinese ep9_diks_ph1_bathroom_label_nofx_0dc9df40:

    # mc "(We wanted to make the bathrooms extra scary. You're already in a bathroom, so it doesn't matter if you shit yourself. Haha!)"
    mc "（我们想把洗手间布置得格外吓人。反正人已经在洗手间里，就算吓得拉裤子也不要紧。哈哈！）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1128
translate schinese ep9_diks_ph1_dining_label_faf0bdaa:

    # mc "(I hope we got enough chips... Who would have thought it would be this hard to estimate how much food you need for a guest list that seems to expand by the hour?)"
    mc "（希望准备的薯片够多……宾客名单每小时都在变长，谁能想到估算食物用量会这么困难？）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1131
translate schinese ep9_diks_ph1_dining_label_2dc00012:

    # mc "(And this is where we stopped giving a fuck about the decorations. It's more of a staging area anyway.)"
    mc "（到了这里，我们已经懒得管装饰了。反正这里更像是后勤区。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1132
translate schinese ep9_diks_ph1_dining_label_823f67d9:

    # mc "(Also, limiting the party is better than having people running around in every room.)"
    mc "（而且把派对限制在这些房间里，总比让所有人到处乱窜要好。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1204
translate schinese ep9_diks_ph1_kitchen_label_nofx_defaaf42:

    # mc "(Every party needs food and snacks. Popcorn is both cheap and easy to make.)"
    mc "（每场派对都需要食物和零嘴。爆米花既便宜又容易准备。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1205
translate schinese ep9_diks_ph1_kitchen_label_nofx_58da6024:

    # mc "(Someone made the point it was healthy too, but if you're {b}that{/b} concerned about your health, you shouldn't even be drinking.)"
    mc "（还有人说爆米花也很健康，不过如果你{b}真有那么{/b}在意健康，根本就不该喝酒。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1208
translate schinese ep9_diks_ph1_kitchen_label_nofx_db38290c:

    # mc "(We've ordered a lot of alcohol for tonight. At a glance, it seems like an excessive amount, but I trust that Rusty knows what he's doing by now.)"
    mc "（我们点了好多酒，看起来好像太多了，但我觉得Rusty现在应该知道该点多少了。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1286
translate schinese ep9_diks_ph1_nick_label_nofx_c3d1ce3e:

    # mc "(The HOTs and the DIKs already had a lot of decorations from previous years, but most of them were ruined and ended up not being nearly enough for this party.)"
    mc "（HOT们和DIKs们本来还留着许多往年的装饰，但大部分都已经损坏，远远不够这次派对使用。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1289
translate schinese ep9_diks_ph1_nick_label_nofx_25978a56:

    # mc "(We ended up renting plenty of props for the party. I think that was a good call.)"
    mc "（最后我们为派对租了很多道具。我觉得这个决定很明智。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1329
translate schinese ep9_diks_ph1_jacob_label_nofx_1dfb25dd:

    # mc "(Another painting in the works. But there are no Halloween decorations in here. Jacob's been helping out a lot with the party, though.)"
    mc "（又一幅正在创作的画。不过这里没有万圣节装饰。话说回来，Jacob确实为派对帮了很多忙。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1365
translate schinese ep9_diks_ph1_tommy_label_nofx_54dc7959:

    # mc "(I don't get the idea behind putting police tape around the dance floor, but Tommy wanted it.)"
    mc "（我不懂为什么要在舞池周围拉警戒带，不过Tommy坚持要这么做。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1368
translate schinese ep9_diks_ph1_tommy_label_nofx_20fb525c:

    # mc "(I wonder if Tommy's gonna sleep in that coffin tonight.)"
    mc "（不知道Tommy今晚会不会睡在那口棺材里。）"

# freeroam\episode9\ep9_freeroam_diks1.rpy:1448
translate schinese ep9_diks_ph1_jamie_label_nofx_49a0d977:

    # mc "(I gotta hand it to Jamie. His room always feels cozy. It's probably because of the plants.)"
    mc "（这点得夸夸Jamie。他的房间总是很温馨，大概是因为那些植物。）"

