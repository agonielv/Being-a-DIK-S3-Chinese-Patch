translate schinese ep9_jm_breakup_label_75c94414:

    # ji "Sorry... I'm feeling so stupid wearing this now. I'm beginning to think I couldn't have picked a worse costume."
    ji "抱歉……现在穿着这身衣服，我觉得自己好傻。我开始觉得没有比这更糟糕的装扮了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4458
translate schinese ep9_jm_breakup_label_ece010c0:

    # mc "I love that costume. It makes me smile."
    mc "我喜欢这件衣服。它让我忍不住笑出来。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4460
translate schinese ep9_jm_breakup_label_38a3b8f0:

    # ji "Wanna grab some air?"
    ji "想出去透透气吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4462
translate schinese ep9_jm_breakup_label_355ed343:

    # mc "Let's..."
    mc "让我们走走吧。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4465
translate schinese ep9_jm_breakup_label_fe55a5f1:

    # mc "(But I want to be with Sage.)"
    mc "（但我想和Sage在一起。）"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4468
translate schinese ep9_jm_breakup_label_d4e74f66:

    # mc "(But my feelings for Bella are stronger.)"
    mc "（但我对贝拉的感觉更强烈。）"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4476
translate schinese ep9_diks_ph3_rusty_event_label_56092e38:

    # tan "Haha! Lily? Really?"
    tan "哈哈哈！Lily？真的吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4478
translate schinese ep9_diks_ph3_rusty_event_label_e03b7e65:

    # sn "Yeah! I kinda see it."
    sn "对！我有点看出来了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4480
translate schinese ep9_diks_ph3_rusty_event_label_02db950f:

    # le "It would have been better if Jamie wore his costume too. I feel stupid wearing this."
    le "要是Jamie也穿上他的装扮就好了。我一个人穿成这样感觉好傻。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4482
translate schinese ep9_diks_ph3_rusty_event_label_057129dc:

    # tan "Aw! Don't feel stupid. You look...good!"
    tan "哎呀，别觉得傻，你看起来……挺帅的！"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4484
translate schinese ep9_diks_ph3_rusty_event_label_b503e9f4:

    # sn "Did anyone see Rusty or is he in too good of a costume to notice?"
    sn "有人看到Rusty了吗？还是他的装扮太逼真，大家都没认出来？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4486
translate schinese ep9_diks_ph3_rusty_event_label_08bc9ddd:

    # tan "I just came back from a smoke and saw him on the rooftop. He seemed a bit off or drunk."
    tan "我刚从抽烟回来，看见他在屋顶上。他看起来有点不对劲，或者是在喝醉。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4489
translate schinese ep9_diks_ph3_rusty_event_label_4d9c55dd:

    # mc "(Huh? I should check that out.)"
    mc "（咦？我得去看看。）"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4496
translate schinese ep9_diks_ph3_rusty_event_label_85fa95cf:

    # mc "Rusty?"
    mc "你干嘛一个人在这儿？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4497
translate schinese ep9_diks_ph3_rusty_event_label_65c65474:

    # mc "There you are. What are you doing up here by yourself?"
    mc "你在这儿干嘛？一个人上这儿来干什么？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4499
translate schinese ep9_diks_ph3_rusty_event_label_c7dd31c3:

    # rs "Did you know that flirting is harmless?"
    rs "你知道调情其实挺安全的？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4501
translate schinese ep9_diks_ph3_rusty_event_label_32188fe8:

    # mc "That kind of depends..."
    mc "这得看情况了..."

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4503
translate schinese ep9_diks_ph3_rusty_event_label_9296cec1:

    # rs "It doesn't feel harmless."
    rs "这感觉一点都不无害。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4505
translate schinese ep9_diks_ph3_rusty_event_label_7d010a14:

    # mc "What happened?"
    mc "怎么了？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4507
translate schinese ep9_diks_ph3_rusty_event_label_82f5d7e2:

    # rs "Micha's got a boyfriend."
    rs "Micha有男朋友了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4508
translate schinese ep9_diks_ph3_rusty_event_label_2b35b6fe:

    # mc "..."
    mc "..."

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4510
translate schinese ep9_diks_ph3_rusty_event_label_45664203:

    # mc "That's a shit feeling."
    mc "那感觉真他妈糟。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4511
translate schinese ep9_diks_ph3_rusty_event_label_d7c90583:

    # mc "Was she hiding that from you?"
    mc "她瞒着你这事吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4513
translate schinese ep9_diks_ph3_rusty_event_label_7726e58a:

    # rs "Yes. No... She just got back together with him."
    rs "是。不……她刚刚重新和他在一起了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4515
translate schinese ep9_diks_ph3_rusty_event_label_c77b69fd:

    # mc "She wasn't completely honest?"
    mc "她没完全说实话？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4517
translate schinese ep9_diks_ph3_rusty_event_label_50836d7f:

    # rs "..."
    rs "..."

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4519
translate schinese ep9_diks_ph3_rusty_event_label_91c8b2b6:

    # mc "Do you like her a lot?"
    mc "你喜欢她很多吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4521
translate schinese ep9_diks_ph3_rusty_event_label_bcf5c442:

    # rs "I guess I did like her more than I thought I did."
    rs "我想我其实挺喜欢她的。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4522
translate schinese ep9_diks_ph3_rusty_event_label_2f6cdf27:

    # rs "I've had it rough with relationships in the past."
    rs "我过去在感情里吃过不少苦头。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4523
translate schinese ep9_diks_ph3_rusty_event_label_04eac3ce:

    # rs "I never looked for one, but I wasn't dismissing the idea of it altogether."
    rs "我从来没主动找过，但也没完全否定过这个可能性。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4525
translate schinese ep9_diks_ph3_rusty_event_label_98046286:

    # rs "But I've been pretty shallow. I fucked around a lot."
    rs "但我一直挺肤浅的。我到处乱搞。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4526
translate schinese ep9_diks_ph3_rusty_event_label_4b1f7c43:

    # rs "Micha's one of the girls I felt that it could be more than that."
    rs "Micha是少数让我觉得能发展成正式关系的女孩之一。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4527
translate schinese ep9_diks_ph3_rusty_event_label_8ef41561:

    # rs "Those feelings are rare. They stick with you."
    rs "这种感觉很少见。它会一直留在你心里。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4529
translate schinese ep9_diks_ph3_rusty_event_label_d4a7667c:

    # mc "I can relate to that more than you know."
    mc "我能理解这种感觉，比你想象的要多。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4531
translate schinese ep9_diks_ph3_rusty_event_label_9ec68c4a:

    # rs "Yeah? Ever dated someone who had a boyfriend?"
    rs "你他妈也干过这种事？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4533
translate schinese ep9_diks_ph3_rusty_event_label_11b321f0:

    # mc "Sort of. I mean... Yeah, I've dated a taken girl."
    mc "差不多吧。我是说……嗯，是的，我确实跟一个有男朋友的女生交往过。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4534
translate schinese ep9_diks_ph3_rusty_event_label_b415a341:

    # mc "It made me feel like what I'm assuming you feel right now."
    mc "这让我感觉就像我现在正经历着你所感受到的。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4536
translate schinese ep9_diks_ph3_rusty_event_label_26f16bdc:

    # mc "It got me sad, it got me angry, and it made me realize a lot about myself."
    mc "它让我难过，让我愤怒，也让我意识到很多关于自己的事情。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4538
translate schinese ep9_diks_ph3_rusty_event_label_7b337749:

    # rs "How did you get over it?"
    rs "你怎么放下的？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4541
translate schinese ep9_diks_ph3_rusty_event_label_117f6029:

    # mc "I didn't get over it. But it's too complicated to explain."
    mc "我没走出来。但解释起来太复杂了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4543
translate schinese ep9_diks_ph3_rusty_event_label_67e44ea3:

    # mc "I didn't. It still hurts thinking about it too much, but I've been trying to move on."
    mc "我没放下。想太多还是会痛，但我在试着往前走。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4545
translate schinese ep9_diks_ph3_rusty_event_label_e5853f44:

    # mc "By trying to talk to other girls and get back into the dating game."
    mc "试着跟其他女生聊天，重新回到约会的游戏中。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4547
translate schinese ep9_diks_ph3_rusty_event_label_c875570f:

    # rs "Guess I'm not making anyone do the walk of shame tomorrow."
    rs "猜我明天也不用让人走羞耻之路了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4549
translate schinese ep9_diks_ph3_rusty_event_label_23bc1f60:

    # mc "Haha! Dude, you're like the saddest joker ever."
    mc "哈哈！伙计，你他妈真是最悲惨的笑话了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4551
translate schinese ep9_diks_ph3_rusty_event_label_69dd5049:

    # rs "Haha!"
    rs "哈哈！"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4553
translate schinese ep9_diks_ph3_rusty_event_label_660ee126:

    # rs "And you throw great parties."
    rs "你办的派对也挺棒的。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4555
translate schinese ep9_diks_ph3_rusty_event_label_10dee4ef:

    # mc "You think so?"
    mc "你这么想吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4557
translate schinese ep9_diks_ph3_rusty_event_label_836ac811:

    # rs "Absolutely do."
    rs "绝对没错。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4559
translate schinese ep9_diks_ph3_rusty_event_label_ae164aa2:

    # rs "And you throw mediocre parties."
    rs "而且你办的派对一般般。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4561
translate schinese ep9_diks_ph3_rusty_event_label_0c6978ad:

    # mc "Damn... That's below the belt."
    mc "他妈的...这招太卑鄙了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4563
translate schinese ep9_diks_ph3_rusty_event_label_1b6e0c18:

    # rs "It's a decent party, [name]. I'd probably enjoy it more if it weren't for Micha."
    rs "派对办得不错，[name]。要不是Micha的事，我大概会玩得更开心。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4565
translate schinese ep9_diks_ph3_rusty_event_label_b00daaea:

    # rs "And you're like the worst party planner ever."
    rs "你简直就是最差劲的派对策划者。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4567
translate schinese ep9_diks_ph3_rusty_event_label_a79be523:

    # mc "Shit. You didn't like the party because of me?"
    mc "操，你是因为我才不喜欢那个派对的？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4569
translate schinese ep9_diks_ph3_rusty_event_label_9354b793:

    # rs "Micha made it fun. I know you're trying. Keep at it, though."
    rs "以前是Micha让派对变得有趣。我知道你已经很努力了，继续保持。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4573
translate schinese ep9_diks_ph3_rusty_event_label_d03349ca:

    # rs "Wanna know something crazy?"
    rs "想听听什么疯狂的事吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4575
translate schinese ep9_diks_ph3_rusty_event_label_0817892e:

    # mc "Always."
    mc "总是这样。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4577
translate schinese ep9_diks_ph3_rusty_event_label_058616ed:

    # rs "Before you and I checked if we could afford to replace the windows, I was going to sell my car."
    rs "在我们检查能不能负担得起换窗户之前，我本来打算卖掉我的车。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4579
translate schinese ep9_diks_ph3_rusty_event_label_b5c6a041:

    # mc "To cover the expenses?"
    mc "为了支付开销？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4581
translate schinese ep9_diks_ph3_rusty_event_label_458ab435:

    # rs "Yeah. I even went online to get a rough estimate and everything."
    rs "对。我甚至上网做了个粗略估算。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4583
translate schinese ep9_diks_ph3_rusty_event_label_3ec5ab24:

    # mc "Good thing you didn't. It's a sweet ride."
    mc "好在你没这么做。那车挺不错的。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4585
translate schinese ep9_diks_ph3_rusty_event_label_5410e308:

    # rs "I love that car."
    rs "我爱那辆车。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4586
translate schinese ep9_diks_ph3_rusty_event_label_1f3b60f6:

    # rs "But I love the DIKs more."
    rs "但我更爱DIKs。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4588
translate schinese ep9_diks_ph3_rusty_event_label_e6db698e:

    # mc "Your heart is in the right place, Rusty."
    mc "你的出发点是好的，Rusty。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4590
translate schinese ep9_diks_ph3_rusty_event_label_b8e8fa51:

    # rs "So is yours."
    rs "你也是。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4591
translate schinese ep9_diks_ph3_rusty_event_label_65002092:

    # rs "I can't believe I feel more connected to a freshman than to people I've known here for years."
    rs "我真不敢相信，我跟一个大一新生的联系，比跟在这里认识多年的人还要深。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4593
translate schinese ep9_diks_ph3_rusty_event_label_5d239f38:

    # mc "That means a lot to me. I'm happy I can talk to you like this. I haven't got a lot of people for it."
    mc "这对我来说意义很大。能和你这样说话，我很开心。我真正能这样交流的人不多。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4595
translate schinese ep9_diks_ph3_rusty_event_label_8c30488d:

    # rs "If you ever wanna borrow the car, I'll keep the keys in the safe for you."
    rs "如果你想借车的话，我随时把钥匙放在保险箱里给你。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4597
translate schinese ep9_diks_ph3_rusty_event_label_cf3d2344:

    # mc "You'd let me ride it?"
    mc "你会让我骑吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4599
translate schinese ep9_diks_ph3_rusty_event_label_f5a6ab80:

    # rs "Without your help around here, none of us would ride it."
    rs "没有你的帮忙，我们谁都不敢开这车。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4600
translate schinese ep9_diks_ph3_rusty_event_label_6e3b6d4d:

    # rs "Use it whenever you want."
    rs "随你用。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4602
translate schinese ep9_diks_ph3_rusty_event_label_3aa208f3:

    # rs "If you scratch it, I'll kill you."
    rs "如果你敢划它，我杀了你。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4603
translate schinese ep9_diks_ph3_rusty_event_label_8ca05adb:

    # mc "Hahaha!"
    mc "哈哈哈！"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4607
translate schinese ep9_diks_ph3_rusty_event_label_d762b9a2:

    # rs "About before... You asked me about how we could afford everything now."
    rs "关于之前的事……你问我现在我们怎么负担得起一切的。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4609
translate schinese ep9_diks_ph3_rusty_event_label_f49fff8f:

    # mc "Yeah?"
    mc "嗯？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4611
translate schinese ep9_diks_ph3_rusty_event_label_0c9136d4:

    # rs "You know my car?"
    rs "你知道我的车吗？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4613
translate schinese ep9_diks_ph3_rusty_event_label_f2ba25d4:

    # mc "Yes. It's a sweet ride."
    mc "是的，那车不错。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4615
translate schinese ep9_diks_ph3_rusty_event_label_43738dcf:

    # rs "I sold it."
    rs "我把它卖了。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4617
translate schinese ep9_diks_ph3_rusty_event_label_95ebb1ad:

    # mc "You what?"
    mc "你卖车了？"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4619
translate schinese ep9_diks_ph3_rusty_event_label_14299c7e:

    # rs "It was the only way I could cover the expenses without crawling back to Dad."
    rs "这是唯一能让我在不向爸爸低头的情况下支付费用的办法。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4620
translate schinese ep9_diks_ph3_rusty_event_label_58e29e8c:

    # rs "I had to take responsibility and this was within my power."
    rs "我必须承担责任，而且这在我能力范围内。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4621
translate schinese ep9_diks_ph3_rusty_event_label_cf304f79:

    # rs "I loved that car."
    rs "我爱那辆车。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4622
translate schinese ep9_diks_ph3_rusty_event_label_129a477c:

    # rs "But I love the DIKs more. Ultimately, it wasn't a hard decision."
    rs "但我更爱DIKs。说到底，这并不是一个难做的决定。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4624
translate schinese ep9_diks_ph3_rusty_event_label_7e093d36:

    # mc "It's still sad... But wow..."
    mc "这还是挺让人难过……但真他妈厉害。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4625
translate schinese ep9_diks_ph3_rusty_event_label_e6db698e_1:

    # mc "Your heart is in the right place, Rusty."
    mc "你的出发点是好的，Rusty。"

# freeroam\episode9\ep9_freeroam_ph3_events.rpy:4627
translate schinese ep9_diks_ph3_rusty_event_label_b8e8fa51_1:

    # rs "So is yours."
