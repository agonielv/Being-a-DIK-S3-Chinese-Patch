# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6039
translate schinese ep9_ssolo_label_f3b3d28f:

    # mc "What's wrong?"
    mc "怎么了？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6041
translate schinese ep9_ssolo_label_aae64a6b:

    # sa "I forgot the stupid trophy in my room."
    sa "我把那个蠢奖杯忘在房间里了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6043
translate schinese ep9_ssolo_label_8675a0f2:

    # mc "The one for the best costume competition?"
    mc "最佳服装比赛的那个？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6045
translate schinese ep9_ssolo_label_2d5aeea1:

    # sa "Yeah. We glued it together yesterday, and I completely forgot about it."
    sa "对，我们昨天拼在一起的，我完全给忘了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6048
translate schinese ep9_ssolo_label_f99aab57:

    # mc "Let's go get it. I could use some fresh air."
    mc "我们去拿吧。我正好需要点新鲜空气。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6051
translate schinese ep9_ssolo_label_c0cb4aa8:

    # sa "There it is."
    sa "就在那儿。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6053
translate schinese ep9_ssolo_label_caa01c66:

    # mc "Haha! No way. You made this?"
    mc "哈哈！你居然做了这个？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6054
translate schinese ep9_ssolo_label_7caaf1f8:

    # sa "As per Tommy's request."
    sa "按Tommy的要求做的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6055
translate schinese ep9_ssolo_label_f5516deb:

    # mc "For someone who didn't want anything to do with the competition, he sure likes to come up with ideas for it."
    mc "对于一个不想参与比赛的人，他倒是挺喜欢为比赛出主意的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6057
translate schinese ep9_ssolo_label_e62f4306:

    # sa "Yeah, what is it with you guys and dicks?"
    sa "是啊，你们这些人怎么满脑子都是鸡巴？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6058
translate schinese ep9_ssolo_label_6ef6c1be:

    # sa "Dicks for helmets, dicks for trophies..."
    sa "鸡巴头盔、鸡巴奖杯……"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6060
translate schinese ep9_ssolo_label_11e0e064:

    # mc "Dicks are funny, I guess."
    mc "大概因为鸡巴看着很滑稽吧。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6061
translate schinese ep9_ssolo_label_819928f8:

    # mc "You did a good job on this trophy."
    mc "你这奖杯做得不错。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6063
translate schinese ep9_ssolo_label_55d20ee8:

    # sa "Yeah? You'd wanna have that on your desk?"
    sa "是吗？你会想把它摆在书桌上？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6065
translate schinese ep9_ssolo_label_7280a915:

    # mc "Well, I'm a judge in the contest. Luckily, I don't have to factor that into my opinion about how it looks."
    mc "嗯，我可是这次比赛的评委。幸运的是，这事儿不用影响我对它外观的评价。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6067
translate schinese ep9_ssolo_label_66c0fde7:

    # sa "I know why you like the look of it."
    sa "我知道你为什么喜欢这个样子。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6068
translate schinese ep9_ssolo_label_4e58a640:

    # sa "It's got an uncanny resemblance, no?"
    sa "它看着是不是莫名像你那根？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6070
translate schinese ep9_ssolo_label_cd10eaa1:

    # mc "You modeled the trophy after me?"
    mc "你把奖杯做成了我的样子？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6072
translate schinese ep9_ssolo_label_310c33b4:

    # sa "Haha! Don't be ridiculous. This one has you beat."
    sa "哈哈！别犯傻了。这根可比你的厉害。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6073
translate schinese ep9_ssolo_label_f0df71dd:

    # sa "I modeled it after my brother. Since, you know, he's a huge dick."
    sa "我是照着我哥做的。毕竟你懂的，他就是个大鸡巴……大混蛋。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6075
translate schinese ep9_ssolo_label_5702ebc3:

    # mc "I'm happy you said that last part."
    mc "我高兴你最后那句是这么说的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6077
translate schinese ep9_ssolo_label_a8d90963:

    # sa "Eww!"
    sa "呸！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6079
translate schinese ep9_ssolo_label_b833598c:

    # mc "They have their Halloween tonight too, right?"
    mc "他们今晚也有万圣节聚会，对吧？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6081
translate schinese ep9_ssolo_label_821fb3f9:

    # sa "If you can call it that. I'd say it's more of a cult meeting. Creeps me the fuck out."
    sa "那也配叫万圣节活动？我看更像邪教集会，想想都瘆得慌。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6083
translate schinese ep9_ssolo_label_1fe1b860:

    # mc "Yeah, their parties don't seem normal at all."
    mc "是的，他们的派对看起来一点都不正常。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6085
translate schinese ep9_ssolo_label_4f797777:

    # sa "Well, you've been to one. They're all pretty similar."
    sa "嗯，你去过了，它们都差不多。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6087
translate schinese ep9_ssolo_label_455ba0ed:

    # mc "Yeah? Let's hope the sprinklers don't go off on this one too."
    mc "是吗？但愿这次喷淋系统别又启动了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6090
translate schinese ep9_ssolo_label_bdafec96:

    # sa "I got wet when you did that, you know."
    sa "你当时打开喷淋，可把我都弄湿了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6092
translate schinese ep9_ssolo_label_16fa5b3a:

    # mc "Yeah... Sorry about that."
    mc "嗯……抱歉啊。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6095
translate schinese ep9_ssolo_label_13d4c7a4:

    # sa "Haha! I know who Tybalt would blame for that without hesitating."
    sa "哈哈！不用想都知道，Tybalt会把这事怪到谁头上。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6097
translate schinese ep9_ssolo_label_16a49c2c:

    # mc "Your brother slapped me for that."
    mc "你兄弟因为那个打了我。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6098
translate schinese ep9_ssolo_label_8ca8cff0:

    # sa "He slapped you?"
    sa "他抽了你耳光？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6099
translate schinese ep9_ssolo_label_c5debef3:

    # mc "Yeah, a proper bitch slap. Straight across my face. And he also called me nasty names as he did it."
    mc "嗯，一记正经的耳光，直接扇我脸上。他打的时候还骂了我一堆难听的脏话。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6101
translate schinese ep9_ssolo_label_5a9b3a3c:

    # sa "For real? Please, tell me you punched him."
    sa "真的假的？拜托，跟我说你打了他。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6104
translate schinese ep9_ssolo_label_67c77c84:

    # mc "Oh, I left there with fake tanned knuckles."
    mc "我离开时，拳头上都沾了一层假古铜色。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6106
translate schinese ep9_ssolo_label_0e2cc834:

    # sa "Good. Someone needs to bring him back to earth."
    sa "好，有人该把他拉回现实了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6108
translate schinese ep9_ssolo_label_9d605b77:

    # mc "Then Derek and I egged him."
    mc "然后我和Derek拿鸡蛋砸了他。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6110
translate schinese ep9_ssolo_label_047ea63c:

    # mc "I walked away from it. He already looked ridiculous in his wet suit."
    mc "我直接走了。他那身西装湿透以后，看着已经够可笑了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6112
translate schinese ep9_ssolo_label_d19f4a00:

    # sa "You walked away from getting slapped? Talk about self-restraint."
    sa "你当时连挨打都忍住了？真他妈有自制力。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6114
translate schinese ep9_ssolo_label_4e2fc38e:

    # mc "Well, Derek and I egged him afterward."
    mc "不过后来，我和Derek又拿鸡蛋砸了他。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6115
translate schinese ep9_ssolo_label_3f0c8914:

    # mc "It was part of our Hell Week pledge board."
    mc "那是我们地狱周任务板上的一项任务。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6117
translate schinese ep9_ssolo_label_8a483790:

    # sa "Haha! You guys egged him this year too? I would have loved to see that - him all covered in eggshells and yolk!"
    sa "哈哈！你们今年也拿鸡蛋砸他了？真想亲眼看看他浑身沾满蛋壳和蛋黄的样子！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6119
translate schinese ep9_ssolo_label_9f470914:

    # mc "Pranking them is an annual thing, so..."
    mc "捉弄他们每年都会搞一次，所以……"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6120
translate schinese ep9_ssolo_label_98e6a2b3:

    # mc "Maybe you will see it next year?"
    mc "也许明年你就能看到了？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6122
translate schinese ep9_ssolo_label_6bb8992f:

    # sa "He's graduating, too. So, that's not gonna happen..."
    sa "他也要毕业了，所以这事儿也不会再发生了……"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6124
translate schinese ep9_ssolo_label_07cd6b38:

    # sa "..."
    sa "..."

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6125
translate schinese ep9_ssolo_label_af0e56b7:

    # mc "What are you thinking about?"
    mc "你在想什么？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6127
translate schinese ep9_ssolo_label_1a3e44c5:

    # sa "Mel just gave me an idea..."
    sa "梅尔刚给了我一个灵感……"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6128
translate schinese ep9_ssolo_label_de6de1d4:

    # sa "You know... We still have gallons of pumpkin pulp in our fridge from carving pumpkins."
    sa "你知道的……我们雕南瓜后，冰箱里还剩下好几加仑南瓜瓤。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6130
translate schinese ep9_ssolo_label_caf65d04:

    # mc "Yeah? So?"
    mc "是吗？所以呢？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6132
translate schinese ep9_ssolo_label_84fb3472:

    # sa "What do you say? Do we have time for a prank of our own?"
    sa "你有什么看法？我们还有时间搞个恶作剧吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6134
translate schinese ep9_ssolo_label_a4f27190:

    # mc "You wanna prank your brother?"
    mc "你想捉弄你哥哥？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6136
translate schinese ep9_ssolo_label_9b524c35:

    # sa "Let's fill his bed with it!"
    sa "我们把那些南瓜瓤铺满他的床！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6138
translate schinese ep9_ssolo_label_a39a1d50:

    # mc "You're serious?"
    mc "你当真？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6140
translate schinese ep9_ssolo_label_923ce738:

    # sa "Oh, hell yes, I am!"
    sa "当然，我无比认真！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6142
translate schinese ep9_ssolo_label_1eb28fd2:

    # mc "It's risky. Didn't you say they have their party now?"
    mc "这挺危险的。你不是说他们现在正在开派对吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6143
translate schinese ep9_ssolo_label_31c6a7eb:

    # mc "I mean, how would we even get in there?"
    mc "我的意思是，我们怎么才能进去呢？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6145
translate schinese ep9_ssolo_label_4606a6be:

    # sa "Have you met me?"
    sa "你见过我吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6147
translate schinese ep9_ssolo_label_6c561a9a:

    # mc "He let us pass, just like that...?"
    mc "他直接就让我们进去了，就这么简单？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6149
translate schinese ep9_ssolo_label_d85f4012:

    # sa "I told you he would. \"We're bringing food to the party\"."
    sa "我早说了他会。\"我们带了食物去派对\"。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6150
translate schinese ep9_ssolo_label_56788471:

    # mc "They're all out back, right?"
    mc "他们都在后院，对吧？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6151
translate schinese ep9_ssolo_label_adc0f370:

    # sa "They should be, unless they're using the bathrooms. We better watch out."
    sa "他们应该都在外面，除非他们去上厕所了。我们得小心点。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6153
translate schinese ep9_ssolo_label_54373323:

    # sa "The coast is clear. Let's do it."
    sa "四下无人，动手吧。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6155
translate schinese ep9_ssolo_label_06b2cecf:

    # sa "Haha! Yes! Spread it out."
    sa "哈哈！对，把它铺开。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6156
translate schinese ep9_ssolo_label_89961f9d:

    # mc "This is disgusting. He's gonna hate this."
    mc "真恶心。他肯定会恨死这个恶作剧。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6158
translate schinese ep9_ssolo_label_72e3746f:

    # sa "Haha! I bet he won't spot this. He might even get in bed on top of it when it's dark."
    sa "哈哈！他肯定发现不了。天黑了他可能还会睡在上面。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6159
translate schinese ep9_ssolo_label_8a4c3e42:

    # mc "We should get out of here."
    mc "我们该走了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6161
translate schinese ep9_ssolo_label_bad74216:

    # mc "Think he'll freak out when he notices?"
    mc "你觉得他发现的时候会崩溃吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6163
translate schinese ep9_ssolo_label_15fa7b44:

    # sa "Oh, absolutely! And he'll blame everyone for it, not knowing who did it."
    sa "哦，绝对的！他还会把责任推给所有人，却不知道是谁干的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6165
translate schinese ep9_ssolo_label_3c240c08:

    # mc "I feel a bit bad, though."
    mc "不过我感觉有点愧疚。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6167
translate schinese ep9_ssolo_label_d0d3f103:

    # sa "You don't have to feel bad. He deserves this."
    sa "你不用觉得难受。他配得上这个。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6169
translate schinese ep9_ssolo_label_5e38f3fb:

    # mc "Not about him. But I swore off doing things like this after Hell Week."
    mc "我不是在替他难受。只是地狱周以后，我发誓不再干这种事了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6170
translate schinese ep9_ssolo_label_18a4d210:

    # mc "It got way too intense at times."
    mc "有时候真的太激烈了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6172
translate schinese ep9_ssolo_label_551fd97c:

    # sa "This was just a harmless prank. Cut yourself some slack."
    sa "这不过是个无害的恶作剧。别太苛责自己。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6173
translate schinese ep9_ssolo_label_a05ce924:

    # sa "It's not like we put the pulp in his suits."
    sa "我们又没把南瓜瓤塞进他的西装里。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6175
translate schinese ep9_ssolo_label_881e568c:

    # mc "That would have been way worse, yes."
    mc "那可就糟了，没错。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6178
translate schinese ep9_ssolo_label_d6d2c04d:

    # sa "We should put the pulp in his suits!"
    sa "我们应该把南瓜瓤塞进他的西装里！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6180
translate schinese ep9_ssolo_label_f1e29629:

    # mc "Haha! Easy now. Let's do one prank at a time."
    mc "哈哈！悠着点。一次一个恶作剧就行。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6189
translate schinese ep9_jsolo_label_5f4cb715:

    # js "Mhm. No, it's a laid-back party."
    js "嗯。不，这是一场轻松的派对。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6191
translate schinese ep9_jsolo_label_d407830f:

    # js "Uh-huh."
    js "嗯。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6192
translate schinese ep9_jsolo_label_c395a6e8:

    # js "*{i}Mouths{/i}* Dad."
    js "*{i}无声地说{/i}*爸爸。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6194
translate schinese ep9_jsolo_label_d3d1dca0:

    # js "If I'm drinking?"
    js "你问我有没有喝酒？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6195
translate schinese ep9_jsolo_label_d01dc2c6:

    # js "Well, what did you do in college at my age?"
    js "那你像我这么大、还在上大学时，都做过些什么？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6197
translate schinese ep9_jsolo_label_4e824d72:

    # js "Hahaha!"
    js "哈哈哈！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6198
translate schinese ep9_jsolo_label_0292f85c:

    # js "What? No. It's just [name] being goofy."
    js "什么？没有。只是[name]在犯傻。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6200
translate schinese ep9_jsolo_label_ee12c454:

    # js "Um... [name]? Yeah, the same one from before."
    js "嗯……[name]？对，就是以前提过的那个。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6201
translate schinese ep9_jsolo_label_76980ff8:

    # js "Well, he's a friend."
    js "嗯，他就是个朋友。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6203
translate schinese ep9_jsolo_label_5ab13724:

    # mc "*{i}Mouths{/i}* Friend!?"
    mc "*{i}无声地说{/i}*朋友！？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6205
translate schinese ep9_jsolo_label_8794c429:

    # js "Yeah, he's in my class."
    js "对，他在我班上。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:6206
translate schinese ep9_jsolo_label_5806f25d:

