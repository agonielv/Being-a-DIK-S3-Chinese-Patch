translate schinese ep9_diks_ph2_scary_event_label_0b5e5a88:

    # mc "It's so funny looking your way. We're sitting here and it's supposed to be scary..."
    mc "朝你那边看实在太好笑了。大家坐在这里，本来应该很恐怖……"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:649
translate schinese ep9_diks_ph2_scary_event_label_57c58a1a:

    # mc "And in the corner of my eye, I see a silly banana-Jill."
    mc "可余光里却总能看见一个傻乎乎的香蕉Jill。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:651
translate schinese ep9_diks_ph2_scary_event_label_dfc01506:

    # ji "Haha! I guess I'm ruining the ambiance."
    ji "哈哈！我猜我是在破坏气氛了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:653
translate schinese ep9_diks_ph2_scary_event_label_1f846e3a:

    # mc "No, you're not. Well, maybe, but it doesn't matter. I wouldn't have it any other way."
    mc "没有。好吧，也许有一点，但没关系。我一点也不想换成别的样子。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:656
translate schinese ep9_diks_ph2_scary_event_label_1a566803:

    # mc "You look scary in the dark."
    mc "你在这黑暗里看起来挺吓人的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:658
translate schinese ep9_diks_ph2_scary_event_label_618a20d3:

    # isa "Thank you. I feel more comfortable than I did at the start of the party. Mostly thanks to the dim lighting."
    isa "谢谢。我比派对刚开始时舒服多了。主要是因为灯光昏暗。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:661
translate schinese ep9_diks_ph2_scary_event_label_040fa457:

    # my "How are you doing over there, [name]? Did I scare you?"
    my "你那边怎么样，[name]？被我吓到了吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:663
translate schinese ep9_diks_ph2_scary_event_label_6d884e48:

    # mc "It was a good story, but I wasn't too scared."
    mc "这故事挺有意思的，但我也没那么害怕。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:665
translate schinese ep9_diks_ph2_scary_event_label_823df23d:

    # my "I guess you're doing better than when we watched that scary movie together."
    my "我猜你现在比我们一起看恐怖片的时候好多了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:667
translate schinese ep9_diks_ph2_scary_event_label_d4471a67:

    # mc "(It feels weird that she's talking about that openly in a group...)"
    mc "（她当着大家的面直接提起那件事，感觉有点奇怪……）"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:668
translate schinese ep9_diks_ph2_scary_event_label_377a6562:

    # mc "(I don't know why that is. If it's the alcohol or something else, but she seems more comfortable.)"
    mc "（不知道是酒精还是别的原因，但她看起来比平时自在多了。）"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:670
translate schinese ep9_diks_ph2_scary_event_label_fdade787:

    # mc "(It makes me a bit uncomfortable. It's almost like she's flirting.)"
    mc "（这让我有点不自在，感觉她几乎是在跟我调情。）"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:671
translate schinese ep9_diks_ph2_scary_event_label_6d32ae5e:

    # mc "(All this time, trying to hide what's between us three from everyone, I guess it leaves those kinds of marks.)"
    mc "（这一路上，我们三个之间的事一直藏着掖着，想瞒过所有人，结果却留下了这种痕迹。）"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:674
translate schinese ep9_diks_ph2_scary_event_label_afa83c8e:

    # cam "I have a true story if you want to hear one."
    cam "我有个真实发生过的故事，你们想听吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:676
translate schinese ep9_diks_ph2_scary_event_label_baf23fc9:

    # jac "Hell yeah, lay it on us."
    jac "当然，快讲给我们听。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:678
translate schinese ep9_diks_ph2_scary_event_label_7463f116:

    # cam "Have you ever heard of sleep paralysis?"
    cam "你们听说过睡眠瘫痪，也就是鬼压床吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:679
translate schinese ep9_diks_ph2_scary_event_label_569f0819:

    # cam "It's when you're asleep and your brain wakes up, but your body doesn't."
    cam "就是睡着时大脑已经醒来，身体却还没有。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:680
translate schinese ep9_diks_ph2_scary_event_label_dfe9ac77:

    # cam "You cannot move your body voluntarily when it happens, but your mind is present."
    cam "发作时身体完全不受控制，但意识始终是清醒的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:682
translate schinese ep9_diks_ph2_scary_event_label_a037ecd5:

    # cam "Most people panic when they get it, but there's nothing you can do."
    cam "大多数人遇到这种情况会惊慌失措，但其实你什么都做不了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:683
translate schinese ep9_diks_ph2_scary_event_label_4e25227a:

    # cam "You can't call out for help or do anything aside from trying to fall back to sleep or wait until your body wakes up."
    cam "你喊不出声，也什么都做不了，只能设法重新睡着，或者等身体自己醒来。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:685
translate schinese ep9_diks_ph2_scary_event_label_1a8b246c:

    # cam "Some say that if you focus on jiggling your fingertips or toes, eventually, your body wakes up, but that never worked for my mother."
    cam "有人说，只要集中精神活动指尖或脚趾，身体最终就会醒来，但这招对我妈妈从来没用。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:687
translate schinese ep9_diks_ph2_scary_event_label_b2f9e617:

    # cam "My mother suffered from sleep paralysis. It happened many times and she told me how it made her see things in her dreams."
    cam "我妈妈经常遭遇鬼压床。她说发作时会看到一些如同梦境般的东西。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:688
translate schinese ep9_diks_ph2_scary_event_label_80da6607:

    # cam "Things that felt very real."
    cam "感觉非常真实的事物。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:690
translate schinese ep9_diks_ph2_scary_event_label_6bc2935f:

    # cam "{i}She ate pills to fall asleep, hoping it would help her, but it didn't.{/i}"
    cam "{i}她服用安眠药，希望能有所帮助，可一点用也没有。{/i}"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:692
translate schinese ep9_diks_ph2_scary_event_label_161b37cc:

    # cam "{i}She never got used to the sleep paralysis; she got scared of it.{/i}"
    cam "{i}她始终无法适应鬼压床，每次都非常害怕。{/i}"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:694
translate schinese ep9_diks_ph2_scary_event_label_12f6a64a:

    # cam "{i}She would wake up sweating as it happened. She wanted to scream but panicked because she couldn't.{/i}"
    cam "{i}每次发作，她都会满身大汗地醒来。她想尖叫，却发不出声音，只能陷入恐慌。{/i}"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:695
translate schinese ep9_diks_ph2_scary_event_label_289a8885:

    # cam "{i}Her eyes quickly started wandering around the room.{/i}"
    cam "{i}她的目光迅速扫过房间各处。{/i}"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:696
translate schinese ep9_diks_ph2_scary_event_label_a9ec30ae:

    # cam "{i}The ceiling.{/i}"
    cam "{i}天花板{/i}"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:697
translate schinese ep9_diks_ph2_scary_event_label_be13f7ed:

    # cam "{i}The bed.{/i}"
    cam "{i}床{/i}"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:698
translate schinese ep9_diks_ph2_scary_event_label_a4c4c3c5:

    # cam "{i}The walls.{/i}"
