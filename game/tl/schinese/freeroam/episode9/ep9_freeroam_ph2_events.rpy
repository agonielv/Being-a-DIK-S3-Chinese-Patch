translate schinese ep9_isabella_dance_label_62e73c20:

    # isa "Now, do the same but without me holding you in place."
    isa "现在，你试着自己做一遍，不用我扶着你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2606
translate schinese ep9_isabella_dance_label_71801f6e:

    # mc "Yeah... This works."
    mc "嗯……这样也行。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2608
translate schinese ep9_isabella_dance_label_79763470:

    # isa "You're getting the hang of it."
    isa "你越来越上手了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2610
translate schinese ep9_isabella_dance_label_6a17a62a:

    # mc "I preferred it when you had your arms around my neck."
    mc "我更喜欢你把我脖子搂住的时候。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2612
translate schinese ep9_isabella_dance_label_72223364:

    # isa "Of course, you did."
    isa "你当然更喜欢那样。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2614
translate schinese ep9_isabella_dance_label_9f512b7a:

    # mc "I wish I could kiss you right now."
    mc "我现在真想吻你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2615
translate schinese ep9_isabella_dance_label_5cd643e4:

    # isa "Me too."
    isa "我也是。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2628
translate schinese ep9_sage_dance_label_f6fe26dc:

    # mc "(Seeing her on this dance floor... Haha, it takes me back.)"
    mc "（看见她站在舞池里……哈哈，真让我想起了以前。）"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2630
translate schinese ep9_sage_dance_label_99f8f6ab:

    # mc "(There she is.)"
    mc "（她在这儿。）"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2634
translate schinese ep9_sage_dance_label_95b85072:

    # mc "Found you."
    mc "找到你了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2636
translate schinese ep9_sage_dance_label_d122201c:

    # sa "Dammit. I need to hide better from you."
    sa "该死，我得找个更好的地方躲着。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2638
translate schinese ep9_sage_dance_label_e8fdd446:

    # mc "That wouldn't work; I'd still find you."
    mc "没用，我还是会找到你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2640
translate schinese ep9_sage_dance_label_fff643a2:

    # sa "What if I hide well? In a place where you'd never look?"
    sa "要是我藏得特别好，躲在一个你绝不会去找的地方呢？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2642
translate schinese ep9_sage_dance_label_46a5c149:

    # mc "Simple, I'd look for the place I'd never look and find you."
    mc "简单。我只要去自己绝不会找的地方，就能找到你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2644
translate schinese ep9_sage_dance_label_a506acc6:

    # sa "Finally, you're drunk! Because that didn't make any sense."
    sa "终于，你喝醉了！因为那句话完全没道理。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2645
translate schinese ep9_sage_dance_label_2c625323:

    # sa "Dance with me."
    sa "陪我跳支舞。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2655
translate schinese ep9_sage_dance_label_8e634602:

    # sa "Whoa! Haha!"
    sa "哇！哈哈！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2656
translate schinese ep9_sage_dance_label_3e0b0fd9:

    # sa "Are you showing everyone how strong you are?"
    sa "你这是在向所有人展示你有多强吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2658
translate schinese ep9_sage_dance_label_f62ac7e3:

    # mc "I'm dressed as a warrior; this is the way to do it."
    mc "我扮的是战士，当然就该这么做。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2660
translate schinese ep9_sage_dance_label_8dbd61fe:

    # sa "Definitely makes sense if you ask me."
    sa "照你这么说，确实很有道理。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2662
translate schinese ep9_sage_dance_label_d891c790:

    # sa "Haha! You're not letting me down, are you?"
    sa "哈哈！你不会把我放下来吧？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2663
translate schinese ep9_sage_dance_label_3c688c0e:

    # mc "I can hold you like this forever."
    mc "我能一直这样抱着你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2666
translate schinese ep9_sage_dance_label_afbe6280:

    # sa "Haha! What are you doing down there?"
    sa "哈哈哈！你下面在干嘛？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2668
translate schinese ep9_sage_dance_label_67e5c7f8:

    # mc "I go where the music takes me."
    mc "音乐把我带到哪里，我就去哪里。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2670
translate schinese ep9_sage_dance_label_3baf5bf0:

    # sa "Pff! You're only looking for a reason to peek up my skirt. I see you."
    sa "切！你只是想找借口偷看我的裙底。我可看穿你了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2672
translate schinese ep9_sage_dance_label_f8aea766:

    # mc "I didn't think about that, but that's brilliant!"
    mc "我没想过这点，但这个主意太棒了！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2674
translate schinese ep9_sage_dance_label_740df495:

    # sa "Well? How about it?"
    sa "怎么样？还不快看？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2676
translate schinese ep9_sage_dance_label_574dcb65:

    # mc "I'm never coming back up; I'm gonna stay down here forever."
    mc "我永远不上去啦，我就在这儿待一辈子。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2678
translate schinese ep9_sage_dance_label_f3dde7c2:

    # mc "Ow! Or until people start stepping on me, I guess."
    mc "哎哟！好吧，至少待到有人开始踩我为止。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2689
translate schinese ep9_sage_dance_label_f8b78859:

    # sa "How can you make me feel fuzzy and horny at the same time?"
    sa "你怎么能让我同时觉得暖洋洋又欲火焚身？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2692
translate schinese ep9_sage_dance_label_467aad2e:

    # sa "You stopped dancing."
    sa "你不跳了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2694
translate schinese ep9_sage_dance_label_3622dd57:

    # mc "So did you."
    mc "你不也停了吗。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2696
translate schinese ep9_sage_dance_label_b7a6b79e:

    # sa "I'm waiting for you to kiss me."
    sa "我在等你亲我。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2698
translate schinese ep9_sage_dance_label_08845845:

    # mc "Haha, well, so was I."
    mc "哈哈，我也是。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2707
translate schinese ep9_sage_dance_label_dba31e59:

    # sa "You're always horny, aren't you?"
    sa "你一直都挺饥渴的，对吧？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2709
translate schinese ep9_sage_dance_label_c63b8499:

    # mc "With you, I am."
    mc "在你面前，我确实一直很饥渴。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2724
translate schinese ep9_sage_dance_loop_label_c1d883a4:

    # mc "I need a break."
    mc "我需要喘口气。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2726
translate schinese ep9_sage_dance_loop_label_2ae79bff:

    # sa "You may look strong, but your endurance is shit."
    sa "你看起来很强壮，但耐力真是垃圾。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2728
translate schinese ep9_sage_dance_loop_label_4c12f679:

    # mc "I'm saving myself for you later."
    mc "我在为晚些时候和你做准备，得省点体力。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2730
translate schinese ep9_sage_dance_loop_label_ed3e72bb:

    # sa "You're gonna need some kind of a sports drink. Just saying!"
    sa "你得喝点运动饮料补充体力，提醒你一下！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2739
translate schinese ep9_jill_talk_label_33e40660:

    # mc "I almost didn't recognize you."
    mc "我差点没认出你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2741
translate schinese ep9_jill_talk_label_b12a9c06:

    # ji "You didn't?"
    ji "你没认出来？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2743
translate schinese ep9_jill_talk_label_36850214:

    # mc "Yeah, I don't know if it's the mask, the outfit...or maybe both?"
    mc "是啊，不知道是因为面具、服装……还是两样都有？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2745
translate schinese ep9_jill_talk_label_d73805d3:

    # ji "It's not me...is it?"
    ji "是因为我已经不像自己了……对吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2747
translate schinese ep9_jill_talk_label_1eafd933:

    # bia "Oh, boy. Here we go..."
    bia "天啊，又来了……"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2751
translate schinese ep9_jill_talk_label_adb4136d:

    # mc "It's a great costume. It suits you!"
    mc "这身装扮不错，挺适合你的！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2753
translate schinese ep9_jill_talk_label_36286627:

    # bia "Hah! Told you."
    bia "哈！我早就说了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2755
translate schinese ep9_jill_talk_label_72fdc7f7:

    # mc "What? You don't like it?"
    mc "什么？你不喜欢？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2757
translate schinese ep9_jill_talk_label_16b1f2c0:

    # ji "I do like it."
    ji "我喜欢。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2759
translate schinese ep9_jill_talk_label_98bcc197:

    # mc "But?"
    mc "但？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2761
translate schinese ep9_jill_talk_label_bb7c7bcd:

    # ji "No but."
    ji "没有但是。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2763
translate schinese ep9_jill_talk_label_9e0850a4:

    # bia "A big but. And surprisingly, the big but is her big butt."
    bia "这个‘但是’可大了。没想到，她的大but还真是她的大butt。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2765
translate schinese ep9_jill_talk_label_f13b37a3:

    # ji "Bianca!"
    ji "Bianca！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2767
translate schinese ep9_jill_talk_label_946111b7:

    # bia "Jill is self-conscious. It's nothing new; she's always been this way."
    bia "Jill就是不够自信，没什么新鲜的，她一直都这样。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2769
translate schinese ep9_jill_talk_label_2684daf1:

    # ji "Yeah, yeah. I'm wearing the costume. So, get off my case."
    ji "嗯，嗯。我穿着戏服呢。你们别管了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2771
translate schinese ep9_jill_talk_label_f94f0b15:

    # bia "Not until you admit you look amazing in it."
    bia "除非你承认自己穿这身美极了，否则我可不会罢休。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2773
translate schinese ep9_jill_talk_label_044a72b1:

    # ji "Not happening tonight. Maybe in ten years."
    ji "今晚别想了，也许十年后吧。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2775
translate schinese ep9_jill_talk_label_287f268a:

    # bia "Classic Jill."
    bia "真是典型的Jill。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2777
translate schinese ep9_jill_talk_label_5995c4af:

    # mc "No, it's not you. Not one bit."
    mc "确实不像你，一点都不像。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2779
translate schinese ep9_jill_talk_label_678fe8f2:

    # ji "See?"
    ji "看吧？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2781
translate schinese ep9_jill_talk_label_d9a1e794:

    # bia "Big whoop? Halloween is all about not being yourself. So, you're nailing it."
    bia "那又怎样？万圣节本来就是让人扮成另一个自己。所以你这次成功极了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2783
translate schinese ep9_jill_talk_label_5d193aa0:

    # mc "That you are. It is a great-looking costume - no need to feel uncomfortable about it."
    mc "确实。服装看起来很棒，没必要因为它不自在。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2785
translate schinese ep9_jill_talk_label_f54d6a69:

    # ji "I'm not uncomfortable; I tend to overanalyze things."
    ji "我不觉得不舒服，我就是容易想太多。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2787
translate schinese ep9_jill_talk_label_946111b7_1:

    # bia "Jill is self-conscious. It's nothing new; she's always been this way."
    bia "Jill就是不够自信，没什么新鲜的，她一直都这样。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2790
translate schinese ep9_jill_talk_label_fb687adf:

    # mc "Sorry...but you are...?"
    mc "抱歉……请问你是……？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2792
translate schinese ep9_jill_talk_label_35c0f324:

    # bia "Oh! I'm Bianca. A close friend."
    bia "哦！我是Bianca，吉尔的好朋友。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2793
translate schinese ep9_jill_talk_label_69757c33:

    # bia "And that was Olivia, who just left."
    bia "刚才离开的是Olivia。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2796
translate schinese ep9_jill_talk_label_fb0824c9:

    # mc "Cool! I'm [name]."
    mc "酷！我叫[name]。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2798
translate schinese ep9_jill_talk_label_03d3f54f:

    # mc "Nice to meet you. I'm [name]."
    mc "很高兴见到你。我叫[name]."

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2801
translate schinese ep9_jill_talk_label_79ca6d9f:

    # bia "Oh, we know who you are. We were at the recital."
    bia "哦，我们知道你是谁。我们去看过那场独奏会。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2802
translate schinese ep9_jill_talk_label_ad3a4039:

    # bia "You're amazing!"
    bia "你太棒了！"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2804
translate schinese ep9_jill_talk_label_1b38edcc:

    # mc "Oh? Thanks so much."
    mc "哦？谢谢啦。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2807
translate schinese ep9_jill_talk_label_354acf34:

    # bia "Yeah, I've heard about you."
    bia "嗯，我听说过你。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2810
translate schinese ep9_jill_talk_label_89c9e4c3:

    # mc "I don't wanna sound like a complete dick, but who invited you?"
    mc "我不想显得太讨厌，但谁请你来的？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2812
translate schinese ep9_jill_talk_label_fb1f8c8d:

    # mc "I don't wanna sound mean, but who invited you?"
    mc "我不想显得刻薄，不过是谁邀请你来的？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2814
translate schinese ep9_jill_talk_label_67a9c767:

    # ji "Josy did."
    ji "是Josy。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2816
translate schinese ep9_jill_talk_label_5e575c8f:

    # mc "I see. I would have invited you if I thought you wanted to come. Should I feel bad about that?"
    mc "我明白了。如果我当时觉得你想来的话，我早就邀请你了。我该为这事感到抱歉吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2818
translate schinese ep9_jill_talk_label_bb8ad6a1:

    # ji "I think I understand why you didn't... If things were normal, I would have declined anyway."
    ji "我想我明白你为什么没邀请我……如果一切正常，我反正也会拒绝。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2820
translate schinese ep9_jill_talk_label_ee87e6f3:

    # mc "Oh?"
    mc "哦？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2822
translate schinese ep9_jill_talk_label_4f217051:

    # ji "I meant I'm usually attending High Society Halloween. It's an Alpha Nu Omega party."
    ji "我的意思是，我一般都会参加上流社会万圣节晚会，那是Alpha Nu Omega举办的派对。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2824
translate schinese ep9_jill_talk_label_a55150ca:

    # bia "Even the name of it sounds crap."
    bia "连这名字听起来都很烂。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2826
translate schinese ep9_jill_talk_label_a2221853:

    # ji "Well, regardless, I'm here tonight."
    ji "不管怎样，我今晚在这里。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2828
translate schinese ep9_jill_talk_label_963b2faf:

    # mc "You made the right call."
    mc "你这次选对了。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2831
translate schinese ep9_jill_talk_label_4d3f728a:

    # mc "I... I hope you've been doing all right since...you know."
    mc "我……我希望那件事以后，你过得还好……你懂的。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2833
translate schinese ep9_jill_talk_label_48ca186e:

    # ji "Mhm... Thanks."
    ji "嗯……谢谢。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2835
translate schinese ep9_jill_talk_label_34d47d94:

    # mc "Enjoy the party! I'll see you girls around."
    mc "尽情享受派对吧！回头见，姑娘们。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2838
translate schinese ep9_jill_talk_label_7ec4fefc:

    # bia "So, if you don't want him, he's up for grabs?"
    bia "所以，如果你不想跟他在一起，他现在可是自由的？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2840
translate schinese ep9_jill_talk_label_e1efaa43:

    # ji "Haha! Bianca! Would you say that in front of Matthew?"
    ji "哈哈！Bianca！你敢当着Matthew的面这么说吗？"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2842
translate schinese ep9_jill_talk_label_646a7e50:

    # bia "I'm joking! But some guys make you wish you were single."
    bia "我开玩笑的！不过有些家伙会让你巴不得自己单身。"

# freeroam\episode9\ep9_freeroam_ph2_events.rpy:2843
translate schinese ep9_jill_talk_label_712dfdce:

    # bia "And at the moment I can't believe that you said no to him. What's wrong with you?"
    bia "现在我真不敢相信你居然拒绝了他。你到底怎么了？"

