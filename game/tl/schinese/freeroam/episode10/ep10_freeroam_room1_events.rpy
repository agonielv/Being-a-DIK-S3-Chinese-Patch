translate schinese ep10_fr2_sage_event_label_2ce736e2:

    # mc "That's a lot of cinnamon you put on your oatmeal."
    mc "你往燕麦里撒了这么多肉桂粉。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:25
translate schinese ep10_fr2_sage_event_label_d4a85896:

    # sa "No, it's not."
    sa "不是，它就是。"

