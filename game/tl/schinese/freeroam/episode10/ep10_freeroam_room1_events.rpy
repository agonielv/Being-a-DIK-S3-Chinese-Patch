translate schinese ep10_fr2_sage_event_label_5bb4e0b3:

    # mc "It's not? There's like this brown desert sand cloud of cinnamon surrounding your bowl."
    mc "不是吗？你碗里都快被肉桂粉给埋起来了，像撒了一层棕色的沙漠沙尘暴。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:29
translate schinese ep10_fr2_sage_event_label_bbcafa42:

    # sa "Don't you like cinnamon?"
    sa "你不喜欢肉桂吗？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:31
translate schinese ep10_fr2_sage_event_label_a6bbb276:

    # mc "It's alright, but I don't like doing the cinnamon challenge for breakfast."
    mc "这还行，但我早餐可不想做肉桂挑战。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:33
translate schinese ep10_fr2_sage_event_label_0c10edec:

    # sa "Funny guy."
    sa "有趣的人。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:35
translate schinese ep10_fr2_sage_event_label_d89f2cca:

    # mc "Were you always this messy?"
    mc "你一直这样邋遢吗？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:37
translate schinese ep10_fr2_sage_event_label_017d6105:

    # sa "How am I messy?"
    sa "我怎么了，这么邋遢？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:41
translate schinese ep10_fr2_sage_event_label_4027a01d:

    # sa "Meh! Relax, I'll clean it up after."
    sa "嗯！放松点，我之后会收拾干净的。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:42
translate schinese ep10_fr2_sage_event_label_75f922b3:

    # sa "Any other \"compliments\" you'd like to give me?"
    sa "还有别的“赞美”想对我说吗？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:44
translate schinese ep10_fr2_sage_event_label_852e3017:

    # mc "Yes, and a real one at that. It's nice to see that you're comfortable around me like this."
    mc "是的，而且是真心的。能看见你这样自在地在我身边，感觉挺不错的。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:45
translate schinese ep10_fr2_sage_event_label_dfe31538:

    # mc "And I like waking up next to you and starting my day with you."
    mc "而且我喜欢早上醒来能靠在你身边，和你一起开始新的一天。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:47
translate schinese ep10_fr2_sage_event_label_51b320e9:

    # sa "Ok, those compliments saved your butt from a spanking."
    sa "好吧，那些赞美可帮你躲过了挨打。"

