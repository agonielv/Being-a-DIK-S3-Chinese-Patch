translate schinese ep10_jm_plan_label_48b0c501:

    # mc "(It's almost the weekend again. And I have nothing planned on Friday.)"
    mc "（这周末又快到了，周五我也没什么安排。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:183
translate schinese ep10_jm_plan_label_8e1e5c0d:

    # mc "(I wanna be with Josy and Maya, but I'm not sure if we should spend time together as it is right now...)"
    mc "（我想和Josy还有Maya在一起，但我们现在这样相处是不是有点太早了……）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:184
translate schinese ep10_jm_plan_label_3304fd23:

    # mc "(With the lie and all, maybe it's best to lay low?)"
    mc "（撒了谎之后，还是低调点比较好？）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:185
translate schinese ep10_jm_plan_label_df63b218:

    # mc "(That doesn't mean I can't spend some time with one of them, right?)"
    mc "（这不代表我不能和她们中的一个花点时间，对吧？）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:189
translate schinese ep10_jm_plan_label_1d1fe4b9:

    # mc "(I'm sure Josy will understand.)"
    mc "（我确定Josy会理解的。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:216
translate schinese ep10_jm_plan_label_b51f7e52:

    # mc "(I'm sure Maya will understand.)"
    mc "（我相信Maya会明白的。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:243
translate schinese ep10_jm_plan_label_412e58f5:

    # mc "(Hm... But what about Friday? If Sage is busy, what am I gonna do?)"
    mc "（嗯……那周五怎么办？如果Sage没空，我该做什么？）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:246
translate schinese ep10_jm_plan_label_48b0c501_1:

    # mc "(It's almost the weekend again. And I have nothing planned on Friday.)"
    mc "（快到周末了，周五我也没什么安排。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:249
translate schinese ep10_jm_plan_label_bd7d2d9b:

    # mc "(Maybe I could spend some time with Maya and see how she's feeling and all...?)"
    mc "（也许我可以和Maya多待一会儿，看看她怎么样……？）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:250
translate schinese ep10_jm_plan_label_09fa531a:

    # mc "(I don't dare to ask Josy. She'd probably not even answer.)"
    mc "（我不敢问Josy。她大概连理都不会理我。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:254
translate schinese ep10_jm_plan_label_6637a354:

    # mc "(It's been a while since I hung out with Maya... I should ask her if she's free.)"
    mc "（已经有一段时间没和Maya一起出去了，我应该问问她有没有空。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:257
translate schinese ep10_jm_plan_label_be3cefbf:

    # mc "(It's been a while since I hung out with Josy... I should ask her if she's free.)"
    mc "（好久没和Josy碰面了……我应该问问她有没有空。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:262
translate schinese ep10_jm_plan_label_6637a354_1:

    # mc "(It's been a while since I hung out with Maya... I should ask her if she's free.)"
    mc "（好久没和Maya一起玩了……我应该问问她有没有空。）"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:265
translate schinese ep10_jm_plan_label_be3cefbf_1:

    # mc "(It's been a while since I hung out with Josy... I should ask her if she's free.)"
