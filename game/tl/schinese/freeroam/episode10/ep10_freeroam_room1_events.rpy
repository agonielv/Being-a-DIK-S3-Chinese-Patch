# freeroam\episode10\ep10_freeroam_room1_events.rpy:63
translate schinese ep10_bella_phone_call_label_d1f03f71:

    # isa "Hello?"
    isa "你好？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:66
translate schinese ep10_bella_phone_call_label_0facf62f:

    # mc "I'm finally up and about. Sorry if I kept you waiting."
    mc "终于起来了，抱歉让你等了。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:68
translate schinese ep10_bella_phone_call_label_6b68998d:

    # isa "I assumed you had classes."
    isa "我以为你有课。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:70
translate schinese ep10_bella_phone_call_label_6988b3f1:

    # mc "Nope. I have a study day today, and I slept in."
    mc "不，我今天有学习日，我睡过头了。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:72
translate schinese ep10_bella_phone_call_label_bc9bc438:

    # isa "That doesn't sound like a study day."
    isa "那听起来可不像个学习日。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:74
translate schinese ep10_bella_phone_call_label_ac1908b1:

    # mc "It's called \"study day\", not \"study morning\". And I will study."
    mc "这叫“学习日”，不是“学习早”。而且我还会学习的。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:75
translate schinese ep10_bella_phone_call_label_f5c08bac:

    # mc "Maybe I'll drop by the library later and let you watch me."
    mc "也许我待会儿去图书馆一趟，让你看看我。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:77
translate schinese ep10_bella_phone_call_label_fa630130:

    # isa "Haha... Please, do."
    isa "哈哈... 你倒是说吧。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:79
translate schinese ep10_bella_phone_call_label_cea47986:

    # mc "What did you want?"
    mc "你找我有什么事？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:82
translate schinese ep10_bella_phone_call_label_1d1ddfff:

    # mc "Hey, Bella. What's wrong?"
    mc "嘿，贝拉，怎么了？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:84
translate schinese ep10_bella_phone_call_label_bf6d7328:

    # isa "Why would something be wrong?"
    isa "为什么会有问题？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:86
translate schinese ep10_bella_phone_call_label_5e7b229b:

    # mc "You texted me, asking me to call you. It sounded like something was wrong."
    mc "你发信息让我给你打电话，听起来好像有什么事。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:88
translate schinese ep10_bella_phone_call_label_d815417c:

    # isa "Well, surprise, surprise. I wanted to be friendly."
    isa "呵，真是出乎意料，对吧。我想表现得友好一点。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:90
translate schinese ep10_bella_phone_call_label_bf787afc:

    # mc "Oh? Sorry. What's up?"
    mc "哦？抱歉。怎么了？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:94
translate schinese ep10_bella_phone_call_label_377989a9:

    # isa "Tomorrow, the gym is having a free classes day, and I wanted to invite you to do yoga with me."
    isa "明天健身房有免费课程日，我想邀请你和我一起做瑜伽。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:96
translate schinese ep10_bella_phone_call_label_ab5ae232:

    # isa "Tomorrow, the gym is having a free classes day, and I wanted to invite you to do yoga with Jill and me."
    isa "明天健身房有免费课程日，我想邀请你和Jill一起跟我做瑜伽。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:98
translate schinese ep10_bella_phone_call_label_f5f682a5:

    # mc "Do you want me in your yoga class?"
    mc "你想要我参加你的瑜伽课吗？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:100
translate schinese ep10_bella_phone_call_label_029bff2f:

    # isa "I thought it would be fun for you. You've shown moderate interest in it before, and now is a perfect opportunity to broaden your horizons."
    isa "我以为你会觉得有趣。你之前对瑜伽表现出了中等程度的兴趣，现在正是拓宽你视野的好机会。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:103
translate schinese ep10_bella_phone_call_label_e5859b2a:

    # mc "While I'd love to hang out with you more, I'm afraid I will feel out of place."
    mc "虽然我很想多和你一起待着，但我怕自己会有点不自在。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:106
translate schinese ep10_bella_phone_call_label_4e56f5d0:

    # mc "I like that you want to do stuff with me and all..."
    mc "我挺喜欢你愿意和我一起做点事情的……"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:108
translate schinese ep10_bella_phone_call_label_457b82d5:

    # mc "I gotta say that I'm flattered that you invited me. It makes me happy to hear..."
    mc "我得说，你邀请我我挺感动的。听到这个我挺开心的……"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:109
translate schinese ep10_bella_phone_call_label_85c859d8:

    # mc "...but a yoga class. I will feel out of place."
    mc "……但瑜伽课。我会觉得格格不入。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:111
translate schinese ep10_bella_phone_call_label_f24abe70:

    # mc "And I'm not sure if Jill would want me there. We had a pretty weird discussion the last time I saw her."
    mc "而且我也不确定Jill会不会想让我去。上次见到她的时候，我们聊得还挺奇怪的。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:114
translate schinese ep10_bella_phone_call_label_2a6fdb53:

    # isa "It doesn't hurt to feel out of place. Venturing outside of your comfort zone is good for you."
    isa "这感觉并不坏，走出舒适圈对你是有好处的。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:116
translate schinese ep10_bella_phone_call_label_17aa6247:

    # isa "I asked her, and she didn't mind."
    isa "我问了她，她没介意。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:117
translate schinese ep10_bella_phone_call_label_4b02283a:

    # isa "Also, it doesn't hurt to feel out of place. Venturing outside of your comfort zone is good for you."
    isa "也别觉得不自在，这很正常。走出舒适圈对你有好处。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:119
translate schinese ep10_bella_phone_call_label_8c675a79:

    # mc "Like you did, showing up at our Halloween party, huh?"
    mc "就像你一样，突然出现在我们的万圣节派对上，对吧？"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:121
translate schinese ep10_bella_phone_call_label_e14d3544:

    # isa "Exactly."
    isa "正好。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:123
translate schinese ep10_bella_phone_call_label_3294b901:

    # mc "All right. I'll come, but don't set your expectations too high."
    mc "好，我来。不过别把期望值设得太高。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:125
translate schinese ep10_bella_phone_call_label_95e3677a:

    # isa "I've known you long enough to know where my expectations should be."
    isa "我认识你这么久，早就知道我的期待该放哪了。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:127
translate schinese ep10_bella_phone_call_label_d6937ea5:

    # mc "I'm not sure if that's a compliment or an insult. But thanks for inviting me."
    mc "我不确定你说的是赞美还是讽刺。不过谢谢你邀请我。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:130
translate schinese ep10_bella_phone_call_label_04b04ca7:

    # isa "See you later today, then. Whenever you get dressed and ready to study."
    isa "待会儿见，今天就今天吧。你什么时候穿好衣服，准备好学习了就来找我。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:132
translate schinese ep10_bella_phone_call_label_0529d931:

    # mc "I'll drop by soon. I know how much you miss me."
    mc "我待会就来。我知道你有多想我。"

# freeroam\episode10\ep10_freeroam_room1_events.rpy:136
translate schinese ep10_bella_phone_call_label_447a0092:

    # isa "Have a nice \"study day\", [name]."
    isa "祝你有个“学习日”[name]."

# freeroam\episode10\ep10_freeroam_room1_events.rpy:138
translate schinese ep10_bella_phone_call_label_58e5962d:

    # mc "Sure! Good luck with \"work\"."
    mc "当然！祝你“工作”顺利。"

