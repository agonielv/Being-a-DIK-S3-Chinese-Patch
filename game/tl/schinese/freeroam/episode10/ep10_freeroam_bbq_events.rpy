translate schinese ep10_bbq_bpjo_event_label_cc497a62:

    # mc "Haha! Did you ever play before?"
    mc "哈哈！你以前玩过吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4866
translate schinese ep10_bbq_bpjo_event_label_7d0ed979:

    # js "No, but how hard can it be to throw a ball into a cup?"
    js "不，但我猜扔个球进杯子里能有多难？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4868
translate schinese ep10_bbq_bpjo_event_label_234e9a76:

    # mc "You'll see how hard it is. Let's play."
    mc "你待会儿就知道有多难。我们开始吧。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4870
translate schinese ep10_bbq_bpjo_event_label_60ebd3ad:

    # my "This got interesting."
    my "这变得有意思了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4872
translate schinese ep10_bbq_bpjo_event_label_0307d7d3:

    # ml "I overheard you guys saying you'll play. I'm so gonna watch this."
    ml "我听到你们说要玩，我可要好好看看。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4874
translate schinese ep10_bbq_bpjo_event_label_bc5ae28c:

    # my "Who do you think will win?"
    my "你觉得谁会赢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4876
translate schinese ep10_bbq_bpjo_event_label_3af65d72:

    # ml "My money's on [name], but I hope Josy can beat him. It would be way funnier."
    ml "我押[name]赢，不过还是希望Josy能打败他。那样更有意思。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4910
translate schinese ep10_bp_after_josy_label_6aef38fc:

    # mc "Sorry, but you lose. And what a way to lose..."
    mc "抱歉，但你输了。而且输得还挺有意思……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4912
translate schinese ep10_bp_after_josy_label_62233d34:

    # js "I'm not removing my panties for this."
    js "我可不会为了这个脱裤子。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4914
translate schinese ep10_bp_after_josy_label_2ed92555:

    # my "It's part of the dare. Did you come this far to stop at the finish line?"
    my "这是挑战的一部分。你一路走来，难道就打算在终点线前退缩吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4916
translate schinese ep10_bp_after_josy_label_0d982671:

    # js "Whose side are you on!?"
    js "你站哪边！？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4918
translate schinese ep10_bp_after_josy_label_6ad2926e:

    # my "Hahaha!"
    my "哈哈哈！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4920
translate schinese ep10_bp_after_josy_label_4d55f995:

    # js "I'll do this quick."
    js "我这就搞定了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4924
translate schinese ep10_bp_after_josy_label_fb015d8a:

    # mc "Woho!!! Way to go, Josy!"
    mc "哇哦！！！干得漂亮，Josy！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4926
translate schinese ep10_bp_after_josy_label_517886bb:

    # js "Shh!!! Not so loud!"
    js "嘘！别那么大声！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4928
translate schinese ep10_bp_after_josy_label_27353864:

    # my "You can put your clothes back on. You won the dare."
    my "你可以把衣服穿回去。你赢了这个挑战。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4930
translate schinese ep10_bp_after_josy_label_dbdc88dc:

    # js "Thank you!"
    js "谢谢！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4941
translate schinese ep10_bp_after_josy_label_9e49c0d4:

    # js "I win!"
    js "我赢了！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4943
translate schinese ep10_bp_after_josy_label_fe36d145:

    # ml "I can't believe it! She did it."
    ml "我真不敢相信！她真的做到了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4944
translate schinese ep10_bp_after_josy_label_40993775:

    # my "This went in a whole other direction than I thought it would."
    my "这完全出乎我的意料。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4946
translate schinese ep10_bp_after_josy_label_0a7f7ece:

    # js "Haha! It sure did! But I still won that dare, didn't I?"
    js "哈哈！确实变了样！不过我可没输那赌约，对吧？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4947
translate schinese ep10_bp_after_josy_label_857cabd1:

    # my "You did what I asked, so yes."
    my "你做了我让你做的事，所以是的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4948
translate schinese ep10_bp_after_josy_label_c8a0de43:

    # js "[name]? Why are you covering it?"
    js "[name]你为什么遮着？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4950
translate schinese ep10_bp_after_josy_label_7165b7d0:

    # mc "Do I have to show it? Melanie is right there."
    mc "我非得给你看吗？Melanie就在那儿。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4952
translate schinese ep10_bp_after_josy_label_01dc1df4:

    # ml "I sure am."
    ml "我可真够意思的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4954
translate schinese ep10_bp_after_josy_label_5bd856d2:

    # mc "Take a good look because this is all you're getting."
    mc "好好看看吧，这就是你能得到的全部了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4955
translate schinese ep10_bp_after_josy_label_ecf1be85:

    # js "Yay! Haha!"
    js "哈哈哈！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4956
translate schinese ep10_bp_after_josy_label_6ad2926e_1:

    # my "Hahaha!"
    my "哈哈哈！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4959
translate schinese ep10_bp_after_josy_label_14f00ee3:

    # ml "You guys are so fucking cool together. You make me miss what I had back in high school."
    ml "你们俩真是他妈的酷毙了。你们让我怀念起高中时我曾经拥有过的东西。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4961
translate schinese ep10_bp_after_josy_label_16e9689b:

    # my "Oh, yeah! Mel was in a relationship with a friend and a guy back in high school."
    my "哦，对了！梅尔以前在高中时和一个朋友以及一个男生交往过。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4963
translate schinese ep10_bp_after_josy_label_6619a2d1:

    # js "You were?"
    js "你当时在哪儿？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4965
translate schinese ep10_bp_after_josy_label_34b502f3:

    # ml "Yeah! Let me tell you about it."
    ml "好啊！让我告诉你是怎么回事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4980
translate schinese ep10_bbq_nora_event_label_ffbda945:

    # mc "The rock is speaking to me..."
    mc "这块石头在跟我说话..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4982
translate schinese ep10_bbq_nora_event_label_4e85cb4d:

    # mc "Hello?"
    mc "喂？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4986
translate schinese ep10_bbq_nora_event_label_f03e5225:

    # "*{i}Cellphone rings{/i}*"
    "*{i}手机响起{/i}*"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4987
translate schinese ep10_bbq_nora_event_label_4e85cb4d_1:

    # mc "Hello?"
    mc "喂？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4990
translate schinese ep10_bbq_nora_event_label_fe7ddd95:

    # no "[name], it's Nora."
    no "[name]，它就是Nora。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4991
translate schinese ep10_bbq_nora_event_label_191ec89c:

    # no "I've pondered what to do with us, now that you're a student in my class, but it's a tough decision."
    no "我一直在想，现在你成了我班上的学生，我们该怎么做，但这个决定真的很难。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4994
translate schinese ep10_bbq_nora_event_label_c724dbbb:

    # mc "Whoa, Nora..."
    mc "哇，Nora……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4997
translate schinese ep10_bbq_nora_event_label_283f044c:

    # mc "Straight to business, huh?"
    mc "说正经的？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5002
translate schinese ep10_bbq_nora_event_label_72b16878:

    # no "I have come to a conclusion."
    no "我做了一个决定。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5003
translate schinese ep10_bbq_nora_event_label_b58c12d9:

    # no "It's simply too complicated to date someone I'm teaching, and I have to inform you that I can't date you anymore."
    no "这太复杂了，我不能继续和我正在教的学生交往，我得告诉你，我不能再和你交往了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5006
translate schinese ep10_bbq_nora_event_label_94e84b95:

    # mc "Wait...what? Are you joking?"
    mc "等下...你啥意思？你是在开玩笑吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5009
translate schinese ep10_bbq_nora_event_label_54e6f545:

    # mc "You're joking, right?"
    mc "你他妈是开玩笑的吧？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5014
translate schinese ep10_bbq_nora_event_label_37c65447:

    # no "I'm afraid I'm not. It's against our rules unless it's disclosed, but that's not something I'm willing to do."
    no "我可没开玩笑。按照规定，除非提前报备，否则是不能这样做的，而我可不愿意这么做。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5015
translate schinese ep10_bbq_nora_event_label_824a6cfe:

    # no "I'd be putting my career in jeopardy and would have to find a way around grading your lab report."
    no "我会把我的事业置于危险之中，还得想办法绕过给你打分的环节。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5016
translate schinese ep10_bbq_nora_event_label_1430b7e4:

    # no "It involves letting my superiors know about you, and even Professor Willcock would have to learn about it."
    no "这需要让我向上级透露你的事，就连威尔科克教授也得知道。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5017
translate schinese ep10_bbq_nora_event_label_1c96a91f:

    # no "Sure, it is mitigated by the fact that we met before knowing it would come to this, but as much as it pains me, I cannot continue."
    no "当然，这种事虽然因为之前就认识多少有点缓和，但说实话，我实在没办法继续下去了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5022
translate schinese ep10_bbq_nora_event_label_2b35b6fe:

    # mc "..."
    mc "..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5027
translate schinese ep10_bbq_nora_event_label_5afdd6ae:

    # no "[name]? Are you still there?"
    no "[name]你还在吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5032
translate schinese ep10_bbq_nora_event_label_1f874846:

    # mc "You seem to have figured it out, so, I don't know what I can say to change your mind."
    mc "你好像已经想通了，那我也不知道该说什么才能改变你的想法。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5033
translate schinese ep10_bbq_nora_event_label_50f8a12b:

    # mc "I don't want you to risk your job, but it sucks that we have to stop seeing each other because of something we didn't know about."
    mc "我不想你为了我冒险丢了工作，但真他妈烦人，因为我们得因为一些我们根本不知道的事而停止见彼此。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5034
translate schinese ep10_bbq_nora_event_label_c37850ca:

    # mc "I thought we had a good connection."
    mc "我觉得我们挺有默契的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5039
translate schinese ep10_bbq_nora_event_label_22f8b5bd:

    # no "We do. We have a great rapport, and I didn't expect to have much in common with someone of your age."
    no "我们确实有。我们配合得非常好，我没想到会和你这个年纪的人有这么多共同点。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5041
translate schinese ep10_bbq_nora_event_label_2b7f8a2e:

    # no "All things considered, I beat myself up for having to make this call."
    no "综合考虑，我责怪自己不得不做出这个决定。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5042
translate schinese ep10_bbq_nora_event_label_6228f8f3:

    # no "I wish our relationship had progressed even further to be able to dare go the other route, but I have to stay realistic."
    no "真希望我们的关系能更进一步，好让我敢尝试别的方向，但我也得保持现实。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5043
translate schinese ep10_bbq_nora_event_label_e1909e0e:

    # no "There is too much at stake, and at the stage I'm at in my life, I can't afford to gamble with my profession."
    no "风险太高了，而我现在这个阶段，实在承担不起在职业上冒险。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5045
translate schinese ep10_bbq_nora_event_label_c1cbac1c:

    # no "But we also have some key differences, and when I consider everything about us, it doesn't add up in the long haul."
    no "但我们之间也有一些关键的差异，综合考虑我们的一切，长远来看并不合适。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5050
translate schinese ep10_bbq_nora_event_label_ed8c087f:

    # mc "What if we keep it a secret? That could work."
    mc "要是我们一直瞒着呢？那说不定能成。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5055
translate schinese ep10_bbq_nora_event_label_3ccca372:

    # no "It could never work. Things like these don't remain secret for long."
    no "这事儿根本行不通。这种事怎么可能一直瞒着不被发现。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5056
translate schinese ep10_bbq_nora_event_label_b37b9b0a:

    # no "All it takes is one mistake and it's out there."
    no "只要出一点错，事情就全完了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5057
translate schinese ep10_bbq_nora_event_label_ffad2aa7:

    # no "And honestly, are you telling me that you haven't told anyone about us?"
    no "说实话，你是在跟我说你还没跟任何人提过我们吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5062
translate schinese ep10_bbq_nora_event_label_19413ce4:

    # mc "Ok... I see what you mean."
    mc "嗯……我明白你的意思了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5063
translate schinese ep10_bbq_nora_event_label_29424d2e:

    # mc "Since you're this determined to end it, I don't think I have anything else to say..."
    mc "既然你这么坚持要结束这一切，我想我也没什么好说的了..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5068
translate schinese ep10_bbq_nora_event_label_7ddc8a3c:

    # no "I'm sorry, [name]. I truly am."
    no "对不起，[name]我确实如此。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5076
translate schinese ep10_bbq_nora_event_label_28a796fd:

    # mc "Me too. I wish you didn't give up on me this easily, but it's your call."
    mc "我也是。我真希望你没这么轻易就放弃我，但这是你的决定。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5077
translate schinese ep10_bbq_nora_event_label_d0e2fd1e:

    # mc "I hope you'll think some more about it and change your mind."
    mc "我希望你再好好想想，别这么快就决定。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5081
translate schinese ep10_bbq_nora_event_label_c485cc51:

    # mc "Don't be. I get it."
    mc "别这样。我明白的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5082
translate schinese ep10_bbq_nora_event_label_1316c958:

    # mc "I won't ask you to change your mind and you have obviously thought about this a lot."
    mc "我不会求你改变主意，你显然已经好好考虑过这件事了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5083
translate schinese ep10_bbq_nora_event_label_99c1f17d:

    # mc "I guess I'll see you in class..."
    mc "那我猜我只能在课上见你了..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5089
translate schinese ep10_bbq_nora_event_label_36f23619:

    # no "Bye, [name]."
    no "再见，[name]."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5097
translate schinese ep10_bbq_q_event_label_9e985a5b:

    # qu "This kumbaya bullshit is getting dull. I need a smoke. Walk with me."
    qu "这套其乐融融的鬼话真他妈无聊。我得抽根烟。走吧，陪我走走。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5099
translate schinese ep10_bbq_q_event_label_2c427d99:

    # mc "You don't like the party, huh?"
    mc "你不喜欢派对，是吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5101
translate schinese ep10_bbq_q_event_label_acab4785:

    # qu "I don't like the wilderness. I need to at least see concrete on the horizon or I get anxious."
    qu "我不喜欢荒野。我至少得看到地平线上有建筑物，不然我就焦虑。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5103
translate schinese ep10_bbq_q_event_label_69ed9f10:

    # mc "You're a weirdo. It's nice getting away from that for a while."
    mc "你真是个怪人。能暂时逃离那地方，感觉还挺不错的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5105
translate schinese ep10_bbq_q_event_label_6ababa31:

    # qu "Oh, yeah. The area a whole 10-minute walk away from campus feels refreshing."
    qu "哦，对了，离校园只有十分钟步行路程的地方感觉挺清爽的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5107
translate schinese ep10_bbq_q_event_label_4d3a90a3:

    # mc "What's funnier: You making fun of it or you getting an anxiety attack from something you ridiculed?"
    mc "什么更有趣：你拿它开玩笑，还是因为你嘲笑的东西而焦虑发作？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5109
translate schinese ep10_bbq_q_event_label_cfa2bebf:

    # qu "Nice try. It's not an anxiety attack, I just don't like it."
    qu "你这招不错，不过那不是焦虑症，我就是不喜欢。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5112
translate schinese ep10_bbq_q_event_label_a8dd1bdd:

    # qu "I'd offer you a hit, but I think you've had enough for tonight."
    qu "我可以给你来一口，但我觉得你今晚已经够了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5114
translate schinese ep10_bbq_q_event_label_fe96ca5b:

    # mc "I can handle it."
    mc "我能应付。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5116
translate schinese ep10_bbq_q_event_label_2a3231ba:

    # qu "I heard you were looking for a gnome or something. I don't think you can handle more."
    qu "我听说你找的是个地精或者什么的。我觉得你已经撑不住了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5118
translate schinese ep10_bbq_q_event_label_6caabb53:

    # mc "I can."
    mc "我可以。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5120
translate schinese ep10_bbq_q_event_label_44e05e9d:

    # qu "Come here."
    qu "过来。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5122
translate schinese ep10_bbq_q_event_label_6327814d:

    # qu "Want a hit?"
    qu "要来一口吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5124
translate schinese ep10_bbq_q_event_label_253ce317:

    # mc "No, I'm good."
    mc "不，我没事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5126
translate schinese ep10_bbq_q_event_label_b3aa6f32:

    # qu "Don't be such a baby. Come here."
    qu "别装了，过来。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5134
translate schinese ep10_bbq_q_event_label_6cff196a:

    # qu "Bet you like it when I'm your bong."
    qu "你他妈还挺享受我给你抽大麻的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5136
translate schinese ep10_bbq_q_event_label_77872c99:

    # mc "I can see why smoking is addictive if you do it like this."
    mc "我明白为什么有人会上瘾了，就冲这感觉。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5138
translate schinese ep10_bbq_q_event_label_fe19ac0f:

    # mc "Do you give yourself a discount?"
    mc "你是不是觉得自己能打点折扣？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5140
translate schinese ep10_bbq_q_event_label_b4bccff9:

    # qu "On weed? Of course. I gotta have some perks."
    qu "至于大麻？当然。我得有点好处才行。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5142
translate schinese ep10_bbq_q_event_label_a01db3ba:

    # mc "So... What's your goal with it?"
    mc "那……你用它有什么目的？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5143
translate schinese ep10_bbq_q_event_label_f3221973:

    # mc "Selling drugs, I mean."
    mc "卖毒品，我说的是。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5145
translate schinese ep10_bbq_q_event_label_8f5b9584:

    # qu "To make money."
    qu "赚钱。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5147
translate schinese ep10_bbq_q_event_label_b822c8e5:

    # mc "Money for college?"
    mc "钱用来上大学？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5149
translate schinese ep10_bbq_q_event_label_746eee72:

    # qu "Money can be used for a lot of things."
    qu "钱能用来做很多事情。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5151
translate schinese ep10_bbq_q_event_label_b27825c0:

    # mc "Sure, but I'm curious what you're going for. Like, if you wanted to cover your tuition or make some extra on the side."
    mc "当然，不过我很好奇你的目标是什么。比如，你只是想付清学费，还是也想赚点外快？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5153
translate schinese ep10_bbq_q_event_label_2f947c07:

    # qu "It's just something I do. I'm not like the rest of you."
    qu "这只是我干的事。我不像你们其他人那样。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5155
translate schinese ep10_bbq_q_event_label_4d79de33:

    # mc "Are you uncomfortable talking about it?"
    mc "你是不是觉得谈这个话题有点尴尬？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5157
translate schinese ep10_bbq_q_event_label_bac97109:

    # qu "Look, it's not for college. College is the means to an end."
    qu "说白了，这跟大学没关系。大学只是个手段。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5158
translate schinese ep10_bbq_q_event_label_5cf3c2ae:

    # qu "I do what I have to do, to be allowed to stay, but I'm not planning on sticking around for the duration."
    qu "我做这些只是为了让能继续待在这里，但我不打算一直待下去。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5160
translate schinese ep10_bbq_q_event_label_a06bb929:

    # mc "Huh? Are you dropping out?"
    mc "你是不是要退学了？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5162
translate schinese ep10_bbq_q_event_label_08be2de2:

    # qu "Eventually, yeah. It's pointless staying here for too long. But for the moment being, it works out for me."
    qu "最后嘛，是的。待太久也没啥意义。但眼下这样还行。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5164
translate schinese ep10_bbq_q_event_label_6f0628f4:

    # mc "What about the HOTs?"
    mc "关于HOTs呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5166
translate schinese ep10_bbq_q_event_label_348179c8:

    # qu "What about them?"
    qu "那他们呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5168
translate schinese ep10_bbq_q_event_label_80da707a:

    # mc "You're the vice president. I thought you were aiming for the top spot after Sage leaves."
    mc "你是副社长，我以为你等Sage走了之后，是要往上爬的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5170
translate schinese ep10_bbq_q_event_label_0cb48bd2:

    # qu "She doesn't know about my plans or what I do. Let's keep it that way, ok?"
    qu "她不知道我的计划或者我干了什么。保持这样，好吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5171
translate schinese ep10_bbq_q_event_label_7bd4ae94:

    # qu "And there's nothing that says I have to stay at B&R."
    qu "而且没什么能说我必须待在B&R。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5172
translate schinese ep10_bbq_q_event_label_aced7801:

    # qu "We'll see... Maybe it's for less than a year, maybe it's for longer, but I don't know yet."
    qu "咱们走着瞧吧……可能就不到一年，也可能更久，但现在我还真说不准。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5174
translate schinese ep10_bbq_q_event_label_254b3549:

    # qu "I've thought about leading the HOTs and doing things the way I wanted to..."
    qu "我考虑过要领导HOTs，按我想的方式做事……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5175
translate schinese ep10_bbq_q_event_label_210b78a3:

    # qu "...but looking at all the bullshit Sage has to deal with every week - every shitty rule she has to follow..."
    qu "...但看着Sage每周都要应付的那些烂摊子，每条她必须遵守的狗屎规矩……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5176
translate schinese ep10_bbq_q_event_label_a56dfd28:

    # qu "Having power should be fun, but I think that position would make my stay here worse."
    qu "拥有权力应该很有趣，但我觉得这个位置只会让我的处境更糟。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5177
translate schinese ep10_bbq_q_event_label_908d9527:

    # qu "And unlike others, I don't aim to use it as a bullet point on my resume. Fuck that."
    qu "跟别人不一样，我可没打算把它当成简历上的一个亮点。操，那玩意儿我才不稀罕。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5179
translate schinese ep10_bbq_q_event_label_2b35b6fe:

    # mc "..."
    mc "..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5181
translate schinese ep10_bbq_q_event_label_f780d2eb:

    # qu "What's wrong?"
    qu "怎么了？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5183
translate schinese ep10_bbq_q_event_label_0752e628:

    # mc "It makes me sad to hear you say that. I was hoping that you'd stick around for longer."
    mc "听到你这么说让我很难过。我原本希望你能多留一阵子。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5185
translate schinese ep10_bbq_q_event_label_3ae83f7c:

    # qu "I'm not skipping town. I'd just be elsewhere."
    qu "我没要离开这里，我只是会去别的地方。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5187
translate schinese ep10_bbq_q_event_label_b5fcf43d:

    # mc "Yeah, but still... I'd miss you here."
    mc "是啊，可我还是会想你的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5189
translate schinese ep10_bbq_q_event_label_a1090f51:

    # qu "Stop that."
    qu "别这样。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5191
translate schinese ep10_bbq_q_event_label_8e2f440a:

    # mc "But I would."
    mc "但我确实会。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5193
translate schinese ep10_bbq_q_event_label_377d6f01:

    # qu "Stop crying. I could still crash your stupid parties."
    qu "别装了，我还能来你那些无聊的派对。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5195
translate schinese ep10_bbq_q_event_label_816d0ae0:

    # mc "But it would feel different not having you around every day."
    mc "但没有你每天在身边的感觉，一切都会不一样。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5197
translate schinese ep10_bbq_q_event_label_661c3673:

    # qu "I'm not here to study, [name]. You need to get that into your head and be cool with it."
    qu "我来这里不是为了学习，[name]你需要把这事儿想通了，别太较真。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5198
translate schinese ep10_bbq_q_event_label_cc962c71:

    # qu "Nothing lasts forever. Everything changes at some point."
    qu "没有什么是永恒的。总有一天，一切都会变。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5199
translate schinese ep10_bbq_q_event_label_b8a70260:

    # qu "You lose friends, you lose family, and yet you're still ok as long as you push on."
    qu "你可能会失去朋友，失去家人，但只要你继续往前走，你还是能过得下去。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5201
translate schinese ep10_bbq_q_event_label_be67ab5a:

    # qu "Always be brave. Always have pride."
    qu "永远勇敢。永远有尊严。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5203
translate schinese ep10_bbq_q_event_label_02ddb78d:

    # mc "Is this your motivational speech?"
    mc "这是在给你上励志课吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5205
translate schinese ep10_bbq_q_event_label_dc39372a:

    # qu "I don't want you to bitch about me leaving, like it's the end of the fucking world. It's bound to happen sometime anyway."
    qu "我不想你因为我要离开就抱怨个没完，好像这就意味着世界末日似的。反正迟早都会发生的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5207
translate schinese ep10_bbq_q_event_label_ae6f57b1:

    # mc "Until that day comes, I'm gonna try my hardest to make you stay longer."
    mc "直到那天到来之前，我会尽我最大的努力让你多留一会儿。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5209
translate schinese ep10_bbq_q_event_label_ac3ec3b5:

    # qu "That's...pathetic."
    qu "这他妈真丢人。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5211
translate schinese ep10_bbq_q_event_label_69910262:

    # mc "Can I have another hit? Hold the joint."
    mc "要再来一口吗？拿着那个烟卷。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5217
translate schinese ep10_bbq_q_event_label_70fcebcf:

    # qu "Get back to singing campfire songs, you pretty little choir boy."
    qu "回去唱你们的篝火歌吧，你这个漂亮的小合唱团男孩。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5219
translate schinese ep10_bbq_q_event_label_954c70e2:

    # mc "I'm sure you'll sit down with us when we start roasting marshmallows."
    mc "我确定等我们开始烤棉花糖的时候，你肯定会坐下来和我们一起。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5221
translate schinese ep10_bbq_q_event_label_e22366b9:

    # qu "Eww! I can't believe I kissed you."
    qu "呸！我真不敢相信我亲了你。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5238
translate schinese ep10_bbq_2dg_event_label_24a789b4:

    # mc "So, about that dare..."
    mc "所以，关于那个赌约……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5240
translate schinese ep10_bbq_2dg_event_label_bb69870e:

    # js "It was Maya's idea."
    js "这是Maya的主意。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5242
translate schinese ep10_bbq_2dg_event_label_eaa3b331:

    # my "Sure was."
    my "确实挺有意思的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5244
translate schinese ep10_bbq_2dg_event_label_b3881402:

    # mc "I didn't think we would still be playing, but does that mean it's my turn?"
    mc "我没想过我们还会继续玩下去，但这样是不是轮到我了？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5246
translate schinese ep10_bbq_2dg_event_label_99b05c8e:

    # js "Nope, I think it's my turn since I got dared, right?"
    js "不，我觉得该是我回合了，因为我被挑战了，对吧？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5247
translate schinese ep10_bbq_2dg_event_label_c1dff962:

    # mc "Oh..."
    mc "哦..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5249
translate schinese ep10_bbq_2dg_event_label_3f536e7d:

    # my "Why? Did you have a good one?"
    my "为什么？你有好点的吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5251
translate schinese ep10_bbq_2dg_event_label_b4e286c5:

    # mc "No, but I could have come up with something."
    mc "不，但我本来可以想出个更好的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5253
translate schinese ep10_bbq_2dg_event_label_f3217c27:

    # my "I almost dared Josy to sleep in your tent tonight because she doesn't want to."
    my "我差点敢让你今晚睡帐篷，因为她不想待在屋里。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5255
translate schinese ep10_bbq_2dg_event_label_92620659:

    # mc "Why? That wasn't a bad dare."
    mc "为什么？那可不是个坏挑战。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5257
translate schinese ep10_bbq_2dg_event_label_bd58e6f5:

    # js "Are you joking? Don't you know how cold it will get overnight?"
    js "你他妈是开玩笑吧？你不知道晚上会有多冷吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5259
translate schinese ep10_bbq_2dg_event_label_136da2cb:

    # mc "We have the bonfire that will keep going for a while."
    mc "我们还有个篝火，能烧一阵子。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5261
translate schinese ep10_bbq_2dg_event_label_b5f6639f:

    # js "For a while, yes. What about after that?"
    js "一段时间内是的。之后呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5262
translate schinese ep10_bbq_2dg_event_label_c8f7845b:

    # js "I'm telling you, you will freeze your butt off if you sleep there tonight."
    js "你他妈要是睡那儿，屁股都得冻成冰块。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5264
translate schinese ep10_bbq_2dg_event_label_ebda0f08:

    # mc "You're a wuss."
    mc "你是个胆小鬼。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5266
translate schinese ep10_bbq_2dg_event_label_b1ff5260:

    # js "*{i}Gasp{/i}* I'm not a wuss! I'm tough! I just completed a dare!"
    js "*{i}吸气{/i}*我不是胆小鬼！我很强壮！我刚刚完成了一个挑战！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5268
translate schinese ep10_bbq_2dg_event_label_99fbd43a:

    # my "Haha! Yeah, but still...you're kind of a wuss."
    my "哈哈！是啊，不过……你他妈的也算个胆小鬼。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5270
translate schinese ep10_bbq_2dg_event_label_85a4f448:

    # js "If you two are sooo brave..."
    js "你们俩这么勇敢啊……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5271
translate schinese ep10_bbq_2dg_event_label_cbae616e:

    # js "I dare you to..."
    js "我敢赌你敢在小便池后面干那事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5273
translate schinese ep10_bbq_2dg_event_label_ec848dad:

    # my "Oh no..."
    my "哦不……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5275
translate schinese ep10_bbq_2dg_event_label_85d2ecad:

    # js "[name]! I dare you to have sex with...uh...behind the porta potties."
    js "[name]我赌你敢在小便池后面发生关系。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5277
translate schinese ep10_bbq_2dg_event_label_a9deb510:

    # mc "With who? With Maya?"
    mc "跟谁？跟Maya？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5279
translate schinese ep10_bbq_2dg_event_label_bbdd6e89:

    # js "I was gonna say with Maya, but I stopped myself mid-sentence because I want it too. Haha!"
    js "我本来是想说和Maya，但话到嘴边又停住了，因为我太想要了。哈哈！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5281
translate schinese ep10_bbq_2dg_event_label_b232aa9c:

    # my "We can't all have sex behind the toilets."
    my "我们不能都去厕所后面搞事情。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5283
translate schinese ep10_bbq_2dg_event_label_7ffad0e3:

    # js "No, you're right. Someone would have to keep watch..."
    js "不，你说得对。得有人盯着点..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5284
translate schinese ep10_bbq_2dg_event_label_d4cf3b13:

    # js "Let's tag team it!"
    js "我们一起来干！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5286
translate schinese ep10_bbq_2dg_event_label_8988edc6:

    # mc "This is sounding less like a dare, and more like something both of you wanna do."
    mc "这听起来越来越不像个挑战，更像是你们俩都想要做的事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5288
translate schinese ep10_bbq_2dg_event_label_d67eff9b:

    # js "Well, then I dare you to do it."
    js "那我可就敢赌你去做了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5290
translate schinese ep10_bbq_2dg_event_label_bdd8fcc3:

    # mc "Does it mean I get to dare you next?"
    mc "这表示我接下来可以向你发起挑战吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5292
translate schinese ep10_bbq_2dg_event_label_a71ed086:

    # js "Yes."
    js "嗯。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5294
translate schinese ep10_bbq_2dg_event_label_73bdc702:

    # mc "Ok, I'll do it."
    mc "好，我干了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5297
translate schinese ep10_bbq_2dg_event_label_8a17caa3:

    # mc "But also, psych! I would do it without the dare too. Haha!"
    mc "不过说真的，就算没有这个挑战我也会做。哈哈！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5326
translate schinese ep10_jm_lewd_label_f90e37d0:

    # js "Question is... Who goes back there first?"
    js "问题是……谁先回去？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5331
translate schinese ep10_jm_lewd_label_674c85fe:

    # mc "Maya, let's go!"
    mc "NAME_0，我们走吧！"

