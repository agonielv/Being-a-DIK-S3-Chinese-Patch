    # ji "You don't do drugs, right?"
    ji "你嗑药吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1327
translate schinese ep10_bbq_guitar_j_event_label_e8a5bac0:

    # mc "I've tried weed, but I didn't eat any mushrooms."
    mc "我试过大麻，但没吃蘑菇。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1329
translate schinese ep10_bbq_guitar_j_event_label_b1728c2e:

    # ji "Oh... You should be careful with that."
    ji "哦……你得小心点。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1331
translate schinese ep10_bbq_guitar_j_event_label_9be6b923:

    # mc "Tommy says alcohol is much more dangerous than weed."
    mc "Tommy说酒精比大麻危险多了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1333
translate schinese ep10_bbq_guitar_j_event_label_3a3f7418:

    # ji "*{i}Sigh{/i}*"
    ji "*{i}叹气{/i}*"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1335
translate schinese ep10_bbq_guitar_j_event_label_66e8c6c6:

    # mc "No. Never. It's not for me."
    mc "不。从不。那东西不在我身上。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1337
translate schinese ep10_bbq_guitar_j_event_label_eeb2ec77:

    # ji "That's good..."
    ji "这挺好..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1340
translate schinese ep10_bbq_guitar_j_event_label_18e6b260:

    # mc "How are you tonight?"
    mc "你今晚怎么样？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1342
translate schinese ep10_bbq_guitar_j_event_label_51b6a208:

    # ji "I'm fine."
    ji "我没事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1347
translate schinese ep10_bbq_guitar_j_event2_label_b0a7eb3e:

    # ji "There you are. I've been trying to reach you, but you didn't answer your phone."
    ji "你终于出现了。我一直在试着联系你，但你没接电话。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1349
translate schinese ep10_bbq_guitar_j_event2_label_ecbee836:

    # mc "Jill..."
    mc "Jill……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1350
translate schinese ep10_bbq_guitar_j_event2_label_a79e86b7:

    # mc "Is it really you?"
    mc "真的是你？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1352
translate schinese ep10_bbq_guitar_j_event2_label_df14d14b:

    # ji "It's me."
    ji "是我。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1353
translate schinese ep10_bbq_guitar_j_event2_label_d608bef1:

    # ji "How are you? You look a little bit...weird."
    ji "你怎么样？你看起来有点...怪怪的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1355
translate schinese ep10_bbq_guitar_j_event2_label_0ca9c7db:

    # mc "I'm totally fine now that you're here."
    mc "我现在完全没事了，你来了就好。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1357
translate schinese ep10_bbq_guitar_j_event2_label_9b74f954:

    # ji "Ok, you're drunk. Haha."
    ji "哦，你喝醉了。哈哈。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1358
translate schinese ep10_bbq_guitar_j_event2_label_cc6441de:

    # ji "It seems like many already are. Are you guys having fun?"
    ji "看起来很多人已经这样了。你们玩得开心吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1360
translate schinese ep10_bbq_guitar_j_event2_label_f7cad505:

    # mc "It's fun. It's scary. And pretty sexy. It's a bit of everything."
    mc "这挺好玩的。有点吓人。还蛮性感的。什么都有。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1361
translate schinese ep10_bbq_guitar_j_event2_label_c2456576:

    # mc "But enough about that."
    mc "但说够了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1363
translate schinese ep10_bbq_guitar_j_event2_label_18f6c2fa:

    # mc "How are {b}you{/b}?"
    mc "怎么了{b}你{/b}?"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1365
translate schinese ep10_bbq_guitar_j_event2_label_96415f04:

    # ji "Haha, I'm fine."
    ji "哈哈，我挺好的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1368
translate schinese ep10_bbq_guitar_j_event2_label_886b676c:

    # ji "Oh! No. I'm not fine, I'm both better than fine and at the same time way worse."
    ji "哦！不，我没事，我比没事还要好，但同时又糟糕透顶。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1370
translate schinese ep10_bbq_guitar_j_event2_label_b10feeca:

    # mc "Good and bad news?"
    mc "好坏参半的消息？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1372
translate schinese ep10_bbq_guitar_j_event2_label_d638d0bd:

    # ji "You can say that. So, I got mad at Tybalt again and went down to the bar to get some space."
    ji "你这话没错。所以我又跟Tybalt吵了一架，然后跑去酒吧冷静一下。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1373
translate schinese ep10_bbq_guitar_j_event2_label_75ac63d3:

    # ji "And I ran into Trent."
    ji "我撞见了Trent。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1375
translate schinese ep10_bbq_guitar_j_event2_label_01543258:

    # mc "I don't know who that is."
    mc "我不知道那是谁。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1377
translate schinese ep10_bbq_guitar_j_event2_label_0684370e:

    # ji "He's one of Tybalt's closest friends. I'm sure you've seen him."
    ji "他是Tybalt最亲近的朋友之一，我敢说你肯定见过他。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1378
translate schinese ep10_bbq_guitar_j_event2_label_954dc691:

    # ji "Anyway, I recalled something that Tybalt told me, back when he blamed you for causing a fire in our mansion."
    ji "不管怎样，我回想起Tybalt以前跟我说过的话，那时候他还怪你把我们庄园烧了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1379
translate schinese ep10_bbq_guitar_j_event2_label_f25ac177:

    # ji "It involved Trent, and it wasn't flattering, so I asked him about it."
    ji "这事儿牵扯到Trent，而且挺不光彩的，所以我问他到底怎么回事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1381
translate schinese ep10_bbq_guitar_j_event2_label_4b8c48fb:

    # ji "It turns out, Tybalt was lying once again and used Trent in his lies. Trent didn't like that very much."
    ji "结果，Tybalt又一次在说谎，还把Trent扯了进来。Trent对这事可一点都不高兴。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1382
translate schinese ep10_bbq_guitar_j_event2_label_55be45d7:

    # ji "So, we went upstairs to Tybalt's room to have a chat and the next 20 seconds I would like to have erased from my memory."
    ji "所以我们上楼到Tybalt的房间聊了会儿，接下来的二十秒我真希望能从记忆里彻底抹去。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1384
translate schinese ep10_bbq_guitar_j_event2_label_7d010a14:

    # mc "What happened?"
    mc "发生了什么？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1386
translate schinese ep10_bbq_guitar_j_event2_label_2d205d49:

    # ji "Tybalt and his {i}teeny-tiny Tybbie{/i} were having intercourse with a fruit I'll never be able to enjoy again."
    ji "Tybalt和他的{i}小提比{/i}正在和一种我再也无法享用的水果性交。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1388
translate schinese ep10_bbq_guitar_j_event2_label_928017cc:

    # ji "And, oh, my stolen underwear - for one - was decorating said fruit."
    ji "而且，我被偷的内衣——就那一件——正装饰着那个水果。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1389
translate schinese ep10_bbq_guitar_j_event2_label_80634c0f:

    # ji "The underwear you told me he stole. You were right. You were absolutely right."
    ji "你跟我说他偷的内衣，你没错，你完全没错。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1391
translate schinese ep10_bbq_guitar_j_event2_label_f71ce20a:

    # mc "That's so fucking creepy..."
    mc "这他妈真他妈诡异..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1393
translate schinese ep10_bbq_guitar_j_event2_label_65a68aaa:

    # ji "It is."
    ji "是的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1395
translate schinese ep10_bbq_guitar_j_event2_label_42311d42:

    # mc "What did you guys do?"
    mc "你们干了什么？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1397
translate schinese ep10_bbq_guitar_j_event2_label_8886bdb5:

    # ji "I kicked him between his legs."
    ji "我踢了他的腿间。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1399
translate schinese ep10_bbq_guitar_j_event2_label_948d63af:

    # mc "Haha! Wait! You what?"
    mc "哈哈！等等！你干了什么？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1401
translate schinese ep10_bbq_guitar_j_event2_label_782f17df:

    # ji "It was an impulse. I was so mad! All the lies and then he's doing that from across the hall."
    ji "是冲动之举。我当时气疯了！一堆谎言，然后他就在隔壁房间干那事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1402
translate schinese ep10_bbq_guitar_j_event2_label_22390d3b:

    # ji "I felt so disgusted and humiliated!"
    ji "我感到恶心又丢脸！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1404
translate schinese ep10_bbq_guitar_j_event2_label_8519c550:

    # ji "I left and he had a heated argument with Trent."
    ji "我离开后，他和Trent吵得不可开交。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1405
translate schinese ep10_bbq_guitar_j_event2_label_72d96205:

    # ji "After which Trent came to me and told me he's on my side, if we bring this up to the disciplinary committee."
    ji "之后Trent来找我，说他站在我们这边，如果我们把这事告到纪律委员会去的话。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1407
translate schinese ep10_bbq_guitar_j_event2_label_b02f5ec6:

    # mc "What would happen if you did that?"
    mc "那你会怎么做？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1409
translate schinese ep10_bbq_guitar_j_event2_label_cdd9f546:

    # ji "Tybalt would likely be removed as President. His entire world would shatter."
    ji "主角的名字可能会被开除学籍，他整个世界都会崩塌。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1414
translate schinese ep10_bbq_guitar_j_event2_label_e949cba3:

    # mc "Oh, hell yes! Do that. Let's get rid of him."
    mc "哦，他妈的，干就完事了！让他滚蛋。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1416
translate schinese ep10_bbq_guitar_j_event2_label_9fb987a5:

    # ji "It is tempting, but I don't want to ruin him. I just want him to leave me alone and stop trying to provoke me."
    ji "这很诱人，但我不想毁了他。我只想让他别再纠缠我，别再挑衅我了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1421
translate schinese ep10_bbq_guitar_j_event2_label_f63de8df:

    # mc "Whoa... I wouldn't want my world to shatter. Into like a million pieces..."
    mc "哇……我可不想我的世界碎掉。碎成一地渣渣……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1422
translate schinese ep10_bbq_guitar_j_event2_label_0edb79d8:

    # mc "Don't do it, Jill. Show him mercy."
    mc "别这么做，Jill。饶他一回吧。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1424
translate schinese ep10_bbq_guitar_j_event2_label_672a802e:

    # mc "I don't like the guy and he's a fucking creep for doing that, on top of everything else he does..."
    mc "我不喜欢这家伙，他干这种事就他妈的够恶心了，再加上他其他那些事……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1425
translate schinese ep10_bbq_guitar_j_event2_label_cbec9d82:

    # mc "...but you should show him some mercy. Don't you think?"
    mc "但你该给他点怜悯。你不会觉得吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1426
translate schinese ep10_bbq_guitar_j_event2_label_0dcea604:

    # mc "You're better than him."
    mc "你比他强。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1428
translate schinese ep10_bbq_guitar_j_event2_label_fe48d242:

    # ji "That's what I'm leaning toward. I don't want to ruin him. I just want him to leave me alone and stop trying to provoke me."
    ji "这就是我倾向的做法。我不想毁了他，我只是想让他别再纠缠我，别再故意挑衅我。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1430
translate schinese ep10_bbq_guitar_j_event2_label_563a44ad:

    # ji "Trent told me Tybalt's feeling upset about what happened, so I think it will have an effect without me telling the committee about it."
    ji "Trent跟我说Tybalt对刚才的事很不爽，所以我觉得不用我去找委员会说，这事本身就会有影响。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1431
translate schinese ep10_bbq_guitar_j_event2_label_3e15e4d4:

    # ji "But we'll see... I haven't ruled it out yet, and I don't want to talk to him about it because I'm still mad."
    ji "但我们还没看到结果……我还没排除这个可能性，而且我不想跟他谈这件事，因为我还在生气。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1433
translate schinese ep10_bbq_guitar_j_event2_label_814f8e26:

    # mc "Are you afraid you will kick him in the balls again?"
    mc "你怕自己又会踢他裆部吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1435
translate schinese ep10_bbq_guitar_j_event2_label_b6a29e1e:

    # ji "Hahaha! Yes!"
    ji "哈哈哈！是啊！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1437
translate schinese ep10_bbq_guitar_j_event2_label_fa85d804:

    # ji "I was wearing pointy heels. And I must have hit him with the tip of my toes because he screamed and cried so loud."
    ji "我穿的是尖头高跟鞋，肯定是鞋尖踢中了他，因为他叫得特别大声，还哭得很惨。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1439
translate schinese ep10_bbq_guitar_j_event2_label_4873b343:

    # mc "Ouch! Getting kicked in the balls hurts like hell."
    mc "哎哟！被踢到蛋疼得要命。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1441
translate schinese ep10_bbq_guitar_j_event2_label_bfa7a4ad:

    # ji "Yeah, I know. It's not the first time I've done it to someone."
    ji "嗯，我知道。这也不是我第一次这样整人了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1443
translate schinese ep10_bbq_guitar_j_event2_label_232b58f8:

    # mc "You've done it before?"
    mc "你以前也这么干过？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1445
translate schinese ep10_bbq_guitar_j_event2_label_d6a19b39:

    # ji "When I was a kid, my sister told me it was a good way to do it to defend myself."
    ji "小时候我姐姐跟我说，这是个很好的自卫方法。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1447
translate schinese ep10_bbq_guitar_j_event2_label_3d84d34e:

    # mc "Jill, you can't go around kicking guys in their balls."
    mc "你不能到处去踢男人的蛋。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1449
translate schinese ep10_bbq_guitar_j_event2_label_32e9354b:

    # mc "Even though it does sound kinda fun..."
    mc "虽然听起来有点好玩……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1451
translate schinese ep10_bbq_guitar_j_event2_label_cf4e0e74:

    # ji "Haha! That's so not what I'm doing."
    ji "哈哈！那可不就是我干的事儿。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1453
translate schinese ep10_bbq_guitar_j_event2_label_b63cc76b:

    # mc "Jill the Ball Kicker."
    mc "球踢者Jill。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1455
translate schinese ep10_bbq_guitar_j_event2_label_bea50450:

    # ji "Stop it."
    ji "停下。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1457
translate schinese ep10_bbq_guitar_j_event2_label_f81f6158:

    # mc "Please, don't ever do that to me."
    mc "请，别再对我做这种事了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1459
translate schinese ep10_bbq_guitar_j_event2_label_4b8ab59a:

    # ji "I would never."
    ji "我可不会。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1461
translate schinese ep10_bbq_guitar_j_event2_label_b9109844:

    # sa "Jill! I thought that was you!"
    sa "Jill！我就知道是你！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1466
translate schinese ep10_bbq_guitar_j_event2_label_a85b1a9c:

    # ji "Oh, hi!"
    ji "哦，嗨！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1468
translate schinese ep10_bbq_guitar_j_event2_label_5e6dcc99:

    # sa "[name], why didn't you tell me she got here?"
    sa "[name]，为什么你没告诉我她已经到了？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1471
translate schinese ep10_bbq_guitar_j_event2_label_899db34d:

    # mc "Wait a minute! Sage!"
    mc "等等，你这是谁？！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1472
translate schinese ep10_bbq_guitar_j_event2_label_b5e1b01e:

    # mc "Did you always have red hair!?"
    mc "你一直都有红头发？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1474
translate schinese ep10_bbq_guitar_j_event2_label_4de54f9c:

    # sa "Jill, I'm gonna steal you from [name] for a bit."
    sa "Jill，我要暂时把你从[name]身边抢走一会儿。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1475
translate schinese ep10_bbq_guitar_j_event2_label_af8aa488:

    # sa "Come! It's drinks and girl talk time."
    sa "来吧，该喝点东西，聊聊女孩的事了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1477
translate schinese ep10_bbq_guitar_j_event2_label_3d194ed9:

    # mc "It's red like fire!"
    mc "红得像火一样！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1479
translate schinese ep10_bbq_guitar_j_event2_label_3aac99a7:

    # sa "Pull yourself together, [name]. Drugs are bad for you, ok?"
    sa "收住你的思绪[name]毒品对你不好，好吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1481
translate schinese ep10_bbq_guitar_j_event2_label_f95629d9:

    # ji "Drugs?"
    ji "药物？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1484
translate schinese ep10_bbq_guitar_j_event2_label_ee5aa106:

