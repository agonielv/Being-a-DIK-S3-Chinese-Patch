    ji "我也不知道，我本来就没打算来睡过夜的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5616
translate schinese ep10_bbq_jill_end_event_label_51ce807f:

    # mc "What do you need? Pillow and blanket? Because I got them."
    mc "你还需要什么？枕头和毯子？我都有。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5618
translate schinese ep10_bbq_jill_end_event_label_ae96acd7:

    # ji "Won't it get cold?"
    ji "这不会冷吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5620
translate schinese ep10_bbq_jill_end_event_label_578b172f:

    # mc "Why is that everyone's remark?"
    mc "为什么大家都要这么说啊？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5622
translate schinese ep10_bbq_jill_end_event_label_bc70efde:

    # ji "Because it's cold. Haha!"
    ji "因为冷啊。哈哈！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5624
translate schinese ep10_bbq_jill_end_event_label_98d5a5ea:

    # mc "The bonfire is hot and it will hopefully last overnight."
    mc "篝火烧得正旺，希望能燃整夜。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5626
translate schinese ep10_bbq_jill_end_event_label_a43edc1f:

    # ji "If you're sure."
    ji "如果你确定。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5628
translate schinese ep10_bbq_jill_end_event_label_b0fb4069:

    # mc "If we wake up in the middle of the night and we're freezing, we head back to my place immediately. Ok?"
    mc "如果我们半夜醒来冻得不行，我们就立刻回我那儿去。明白吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5630
translate schinese ep10_bbq_jill_end_event_label_6d486c37:

    # ji "After you."
    ji "你先来。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5632
translate schinese ep10_bbq_jill_end_event_label_2d13edac:

    # mc "Have you camped a lot?"
    mc "你经常露营吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5634
translate schinese ep10_bbq_jill_end_event_label_b7eb32e4:

    # ji "Not a lot. You?"
    ji "不多。你呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5636
translate schinese ep10_bbq_jill_end_event_label_6ff41185:

    # mc "Nope."
    mc "不。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5638
translate schinese ep10_bbq_jill_end_event_label_52da1505:

    # ji "Yet you're confident this will work out fine."
    ji "可你却这么有信心这会一切顺利。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5640
translate schinese ep10_bbq_jill_end_event_label_da301620:

    # mc "Sometimes you gotta live a little."
    mc "有时候就得放肆一下。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5643
translate schinese ep10_bbq_jill_end_event_label_56eacc2f:

    # ji "I think you've lived an awful lot tonight."
    ji "我觉得你今晚已经活得够多了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5645
translate schinese ep10_bbq_jill_end_event_label_b3137a4c:

    # ji "I suppose."
    ji "我猜也是。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5647
translate schinese ep10_bbq_jill_end_event_label_e6bfd784:

    # ji "Please, don't get mad if I wake you up shuddering."
    ji "请别生气，如果我惊醒你时还在发抖。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5649
translate schinese ep10_bbq_jill_end_event_label_0a4dbc8d:

    # mc "I promise."
    mc "我保证。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5650
translate schinese ep10_bbq_jill_end_event_label_8819b775:

    # mc "Thanks for doing this for me. Everyone saying it was a stupid idea..."
    mc "谢谢你能帮我做这件事。大家都说这个主意挺傻的……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5651
translate schinese ep10_bbq_jill_end_event_label_5a84c454:

    # mc "It kinda made me feel bad for planning it."
    mc "这让我有点难受，当初计划这一切。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5653
translate schinese ep10_bbq_jill_end_event_label_11b95e3b:

    # ji "Don't feel bad. You did great."
    ji "别觉得不好意思，你做得很好。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5654
translate schinese ep10_bbq_jill_end_event_label_7c494be6:

    # ji "I've had a good time and some fun conversations."
    ji "玩得挺开心，也聊了不少有趣的事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5655
translate schinese ep10_bbq_jill_end_event_label_108ad55c:

    # ji "You should sleep. Tomorrow is a big day for you."
    ji "你该去睡了。明天对你来说是个大日子。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5657
translate schinese ep10_bbq_jill_end_event_label_69c25b65:

    # mc "Yeah..."
    mc "嗯..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5659
translate schinese ep10_bbq_jill_end_event_label_a3a83043:

    # ji "Please, be safe."
    ji "请小心点。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:5661
translate schinese ep10_bbq_jill_end_event_label_b1abdbcc:

    # mc "I'll try my best."
    mc "我会尽力的。"
