# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4443
translate schinese ep10_bbq_msolo_event_label_3f424471:

    # mc "About what happened at my place... Um..."
    mc "关于我家里发生的事……嗯……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4444
translate schinese ep10_bbq_msolo_event_label_4b854bfa:

    # mc "I wish I had something to blame it on, but what it comes down to is that I shouldn't have said those things to begin with."
    mc "我希望我能找个东西来责怪，但归根结底是我一开始就不该说那些话。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4445
translate schinese ep10_bbq_msolo_event_label_6626fd5f:

    # mc "I'm sorry that I made you uncomfortable."
    mc "我很抱歉让你感到不舒服。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4447
translate schinese ep10_bbq_msolo_event_label_c8c94471:

    # my "Don't feel sorry."
    my "别自责了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4448
translate schinese ep10_bbq_msolo_event_label_04b3f55b:

    # my "I'm the sorry one. I shouldn't have reacted the way I did."
    my "我是那个该道歉的人。我本不该那样反应。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4449
translate schinese ep10_bbq_msolo_event_label_c1ab749e:

    # my "I got mad at you because you told me your feelings."
    my "我生气是因为你告诉我了你的感受。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4451
translate schinese ep10_bbq_msolo_event_label_4ff3f7cc:

    # my "I didn't know what to do with my own feelings at that point, and I felt cornered."
    my "我当时根本不知道该怎么处理自己的感受，感觉被逼到墙角了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4452
translate schinese ep10_bbq_msolo_event_label_4e6259a8:

    # my "I still don't know what to feel. And I've tried to push it aside because I don't want to think about it."
    my "我到现在还是不知道该感觉什么。我试着把它推开，因为我不想去想这些事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4454
translate schinese ep10_bbq_msolo_event_label_ce98d4a7:

    # my "All I can say is that... I don't think I would have reacted that way, if I didn't reciprocate."
    my "我只能这么说……如果我不回应你的话，我想我不会这么反应。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4455
translate schinese ep10_bbq_msolo_event_label_3275e2cd:

    # my "And I shouldn't even say that. Fuck..."
    my "而且我甚至不该说这些。操..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4457
translate schinese ep10_bbq_msolo_event_label_f6d01ab4:

    # my "I need some time to process this."
    my "我需要一些时间来消化这一切。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4459
translate schinese ep10_bbq_msolo_event_label_a3afa617:

    # mc "I get that... Take all the time you need."
    mc "我明白……你慢慢想吧，需要多少时间都行。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4461
translate schinese ep10_bbq_msolo_event_label_0d780c3e:

    # my "What about you?"
    my "你呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4463
translate schinese ep10_bbq_msolo_event_label_7fb5db24:

    # mc "I'll keep doing what I've tried all this time... To move on."
    mc "我会继续做我一直以来尝试的事……为了向前走。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4464
translate schinese ep10_bbq_msolo_event_label_895ea583:

    # mc "Maybe one day I'll be able to do it."
    mc "也许有一天，我能做到。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4469
translate schinese ep10_bbq_msolo_event_label_d7699dd2:

    # my "Tomorrow's the big day."
    my "明天就是大日子了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4471
translate schinese ep10_bbq_msolo_event_label_709e18f3:

    # mc "What are your thoughts?"
    mc "你有什么想法？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4473
translate schinese ep10_bbq_msolo_event_label_c516bb3c:

    # my "I'm scared, but I feel motivated to do it too."
    my "我有点害怕，但同样也感到很有动力去做这件事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4474
translate schinese ep10_bbq_msolo_event_label_768d6237:

    # my "I feel like something is finally happening."
    my "我觉得事情终于要开始了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4476
translate schinese ep10_bbq_msolo_event_label_2d998879:

    # my "*{i}Phew{/i}* I hope it goes according to plan."
    my "*{i}呼——{/i}*希望一切按计划进行。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4478
translate schinese ep10_bbq_msolo_event_label_b3130b57:

    # mc "It will."
    mc "会的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4480
translate schinese ep10_bbq_msolo_event_label_fb0fb138:

    # my "Yeah. You're right. It will."
    my "嗯，你说得对。会的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4482
translate schinese ep10_bbq_msolo_event_label_7c845b29:

    # mc "Try your best to enjoy this night."
    mc "尽力享受这个夜晚吧。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4484
translate schinese ep10_bbq_msolo_event_label_36f4e60c:

    # my "Oh, I am. I'm having a great time. And everyone's so nice to me."
    my "哦，我也是。我玩得很开心。大家都对我很好。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4494
translate schinese ep10_bbq_jsolo_event_label_6fc685b2:

    # mc "Having fun?"
    mc "玩得开心吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4496
translate schinese ep10_bbq_jsolo_event_label_895cfdb9:

    # js "I am. What about you?"
    js "我在啊。你呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4499
translate schinese ep10_bbq_jsolo_event_label_5a062040:

    # mc "I ate a mushroom and I'm seeing things..."
    mc "我吃了一朵蘑菇，现在看到的东西都怪怪的……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4501
translate schinese ep10_bbq_jsolo_event_label_a4b470e3:

    # js "I don't wanna act like I'm your parent, but you shouldn't do drugs, [name]."
    js "我不想装成你的家长，但你不应该吸毒，[name]."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4502
translate schinese ep10_bbq_jsolo_event_label_475c2b52:

    # js "Bad things could happen to you."
    js "可能发生不好的事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4504
translate schinese ep10_bbq_jsolo_event_label_4c1148a2:

    # mc "I know, but I wanted to try it with my brothers."
    mc "我知道，但我想和兄弟们一起试试。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4506
translate schinese ep10_bbq_jsolo_event_label_0d6bc3f6:

    # mc "It's ok. It would have been better if the boys didn't take drugs. But I'm trying to enjoy it."
    mc "没关系。如果那几个家伙没吸毒就好了。不过我试着享受一下这个过程。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4508
translate schinese ep10_bbq_jsolo_event_label_bd2e9492:

    # js "Yeah, what's up with that? Was it Tommy's idea?"
    js "是啊，那是怎么回事？是Tommy的主意吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4510
translate schinese ep10_bbq_jsolo_event_label_bf0e553b:

    # mc "Something like it."
    mc "差不多这样。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4512
translate schinese ep10_bbq_jsolo_event_label_8abfc7fb:

    # mc "How have you been?"
    mc "你最近怎么样？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4515
translate schinese ep10_bbq_jsolo_event_label_e51a68a4:

    # js "I wish I knew. It's been a haze and I try not to think about it too much."
    js "我希望我明白。这段时间一直糊里糊涂的，我尽量不去想太多。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4516
translate schinese ep10_bbq_jsolo_event_label_7e3119b2:

    # js "Because every time I do, I feel bad about myself."
    js "每次我这么想，我都觉得自己挺糟糕的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4517
translate schinese ep10_bbq_jsolo_event_label_9245b6d1:

    # js "I feel bad about what I did, said and how I feel."
    js "我对自己做过的事、说过的话，还有现在的感受都觉得内疚。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4518
translate schinese ep10_bbq_jsolo_event_label_e3f57fdc:

    # js "What about you?"
    js "你呢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4520
translate schinese ep10_bbq_jsolo_event_label_d2414f13:

    # mc "Part of me feels relieved that I told you what I felt."
    mc "我有一部分其实松了口气，因为我终于告诉你我内心真实的想法了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4521
translate schinese ep10_bbq_jsolo_event_label_bc57ed26:

    # mc "And then there's another part that regrets it because of Maya."
    mc "然后还有另一部分，因为Maya而感到后悔。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4523
translate schinese ep10_bbq_jsolo_event_label_6af819aa:

    # js "Maya... Yeah..."
    js "Maya……嗯……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4524
translate schinese ep10_bbq_jsolo_event_label_a44de26a:

    # js "She still doesn't know anything. And she's in a place where I can't talk to her about it."
    js "她到现在还不知道任何事。而且她现在待的地方，我也没法跟她谈这个。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4526
translate schinese ep10_bbq_jsolo_event_label_54b4b01f:

    # mc "Yeah, I get it. But is there ever going to be a good time to tell her?"
    mc "我明白你的意思。但你真的觉得，什么时候才是个好时机告诉她吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4528
translate schinese ep10_bbq_jsolo_event_label_c7c255ca:

    # js "Nope. There won't be. But there will be less worse times for it."
    js "不会。永远不会。不过总会有一些没那么糟的时候。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4529
translate schinese ep10_bbq_jsolo_event_label_fde8bd6c:

    # js "At least, I hope."
    js "至少，我希望如此。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4531
translate schinese ep10_bbq_jsolo_event_label_4e21d6f4:

    # js "[name]... Tomorrow has to go well. I don't know what I'll do if it doesn't."
    js "[name]...明天必须顺利。如果不行的话，我不知道自己会怎么做。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4533
translate schinese ep10_bbq_jsolo_event_label_06eb03ff:

    # mc "I'll do my best."
    mc "我会尽力的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4540
translate schinese ep10_bbq_jsolo_event_label_90545c3e:

    # mc "*{i}Smack{/i}*"
    mc "*{i}亲吻{/i}*"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4542
translate schinese ep10_bbq_jsolo_event_label_e282ffe8:

    # js "(Don't tilt your head up to his. Don't do it. Don't.)"
    js "（别抬你那该死的头去看他。别看。别看。）"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4551
translate schinese ep10_bbq_jsolo_event_label_40d40ca6:

    # js "Do you mean since I put on lingerie and told you I had feelings for you?"
    js "你是说自从我穿上内衣告诉你我喜欢你之后吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4552
translate schinese ep10_bbq_jsolo_event_label_50dee793:

    # js "And when you said you didn't feel that way about me anymore."
    js "而且当你跟我说你不再对我有那种感觉了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4553
translate schinese ep10_bbq_jsolo_event_label_6ec3324c:

    # js "I've been great..."
    js "我表现得挺好的……"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4555
translate schinese ep10_bbq_jsolo_event_label_2b35b6fe:

    # mc "..."
    mc "..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4557
translate schinese ep10_bbq_jsolo_event_label_24b747d9:

    # js "I'm at a stage where I don't know what to do, [name]."
    js "我到了一个不知道该做什么的阶段，[name]."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4558
translate schinese ep10_bbq_jsolo_event_label_b85c6e78:

    # js "I don't want to do anything rash, so, I'm letting days pass and see if I feel anything different from the day before."
    js "我不想做任何冲动的事，所以我想让时间过去，看看自己是否和前一天有什么不同。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4559
translate schinese ep10_bbq_jsolo_event_label_82713ed1:

    # js "But so far... Nope. I'm feeling pretty much the same as I did when I told you. And it sucks."
    js "但到目前为止……没感觉。我现在的感受和我跟你说那件事的时候几乎一模一样。这他妈真他妈烦。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4561
translate schinese ep10_bbq_jsolo_event_label_a99d5804:

    # mc "Yeah... I understand that it must be hard for you. But I don't want it to become something that stops us from talking."
    mc "嗯……我知道这对你来说一定很难，但我不想让它成为阻碍我们交流的问题。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4563
translate schinese ep10_bbq_jsolo_event_label_b56ba251:

    # js "I feel embarrassed for saying and doing that. And you saying that I shouldn't feel embarrassed wouldn't help."
    js "我为那天说的话和做的事感到尴尬。而你跟我说不该感到尴尬，恐怕也没用。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4565
translate schinese ep10_bbq_jsolo_event_label_39428f11:

    # mc "Do you want me to do something embarrassing? Would that help?"
    mc "你想要我做点丢人的事吗？这样能帮你吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4567
translate schinese ep10_bbq_jsolo_event_label_3ab85c6b:

    # js "Haha, no. I don't think it would."
    js "哈哈，不。我觉得不会。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4569
translate schinese ep10_bbq_jsolo_event_label_d7bdf352:

    # js "I'm sorry, [name]. But I don't feel happy with myself at the moment. And I don't think you can do anything to help me with that."
    js "对不起，[name]但现在我并不开心，而且我觉得你也没办法帮我改变这一点。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4570
translate schinese ep10_bbq_jsolo_event_label_d14f11ca:

    # js "But I don't want to stop talking to you either. Even though I feel like I want to sink through the floor at times when I remember that night."
    js "但我也不想停止和你说话。即使有时候想起那晚，我感觉自己就像要钻进地缝里一样尴尬。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4572
translate schinese ep10_bbq_jsolo_event_label_8eb7efc4:

    # js "We'll survive. Won't we?"
    js "我们能挺过去的。不是吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4574
translate schinese ep10_bbq_jsolo_event_label_ad0a7736:

    # mc "We will."
    mc "我们会的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4584
translate schinese ep10_bbq_1dg_event_label_527b0c55:

    # my "Tommy is completely gone."
    my "Tommy彻底消失了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4585
translate schinese ep10_bbq_1dg_event_label_a9438531:

    # js "I know. I checked up on him before to make sure he was all right, but I couldn't make much sense of it."
    js "我知道。我之前去看过他，确认他没事，但当时我根本搞不懂发生了什么。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4586
translate schinese ep10_bbq_1dg_event_label_2c352611:

    # js "I hope Heather will watch him because I don't want to waste this night doing it."
    js "希望Heather能看着他，我不想浪费这个夜晚去做这种事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4589
translate schinese ep10_bbq_1dg_event_label_70c37f6e:

    # my "It's bad enough that [name] ate a mushroom too."
    my "这已经够糟糕了[name]吃了一朵蘑菇。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4591
translate schinese ep10_bbq_1dg_event_label_7effba7c:

    # js "He did?"
    js "他真的做了？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4593
translate schinese ep10_bbq_1dg_event_label_5b28769c:

    # my "He sure did."
    my "他确实这么做了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4595
translate schinese ep10_bbq_1dg_event_label_f814719a:

    # js "Well, that would explain a lot."
    js "那就能解释很多事情了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4599
translate schinese ep10_bbq_1dg_event_label_b36f780b:

    # my "At least [name] didn't cave."
    my "至少[name]没屈服。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4601
translate schinese ep10_bbq_1dg_event_label_1b749c7b:

    # my "At least [name] didn't cave. He even tried to talk them out of it."
    my "至少[name]他没屈服。他甚至试图说服他们。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4603
translate schinese ep10_bbq_1dg_event_label_21ab8c27:

    # js "That's good. That's one less person to worry about."
    js "这倒是个好消息。少了一个让人头疼的人。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4606
translate schinese ep10_bbq_1dg_event_label_a106d9a8:

    # my "Did you hear that he's sleeping in a tent tonight?"
    my "你听说了吗，他今晚要睡帐篷？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4608
translate schinese ep10_bbq_1dg_event_label_b3756f9e:

    # js "Haha, yeah! He's nuts for doing that."
    js "哈哈，没错！他这么做真是疯了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4609
translate schinese ep10_bbq_1dg_event_label_eb97b87d:

    # js "I bet he'll bail like the rest."
    js "我打赌他也会跑掉，跟其他人一样。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4611
translate schinese ep10_bbq_1dg_event_label_d83170f4:

    # my "I don't think he will bail. Not if he's still drunk by then."
    my "我觉得他不会退缩。只要他到时候还醉醺醺的，就不会。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4613
translate schinese ep10_bbq_1dg_event_label_b93ef1d6:

    # js "You're not gonna stay with him in that tent, right?"
    js "你真不打算跟他一起睡帐篷吧？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4615
translate schinese ep10_bbq_1dg_event_label_783efe8c:

    # my "Would you?"
    my "你敢不敢？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4617
translate schinese ep10_bbq_1dg_event_label_6b75afde:

    # js "And freeze my butt off? No."
    js "冻成狗？不会。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:4619
translate schinese ep10_bbq_1dg_event_label_82e042ba:

