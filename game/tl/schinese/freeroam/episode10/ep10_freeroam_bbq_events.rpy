# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1721
translate schinese ep10_bbq_rio_event_label_fc855f2e:

    # mc "*{i}Whisper{/i}* Dinosaurs?"
    mc "*{i}耳语{/i}*恐龙？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:1723
translate schinese ep10_bbq_rio_event_label_7e657346:

