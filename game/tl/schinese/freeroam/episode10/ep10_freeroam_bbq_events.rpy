translate schinese ep10_bbq_jill2_event_label_7ea36b2c:

    # mc "Yeah. Are you cold?"
    mc "嗯。你冷吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2796
translate schinese ep10_bbq_jill2_event_label_f679376e:

