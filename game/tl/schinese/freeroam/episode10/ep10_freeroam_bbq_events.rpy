    ji "*{i}亲吻{/i}*"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2932
translate schinese ep10_bbq_jb_event_label_2961a2c5:

    # jb "[name]!"
    jb "[name]!"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2935
translate schinese ep10_bbq_jb_event_label_743b2870:

    # mc "JB! How are you?"
    mc "JB！你怎么样？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2938
translate schinese ep10_bbq_jb_event_label_16a410f4:

