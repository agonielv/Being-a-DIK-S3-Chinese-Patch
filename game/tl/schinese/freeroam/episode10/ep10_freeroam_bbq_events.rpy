    ji "..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2792
translate schinese ep10_bbq_jill2_event_label_76b4a00b:

    # ji "This is a beautiful place. It makes me wish it was summer again, so we could take a swim."
    ji "这里真是个漂亮的地方。真希望现在是夏天，这样我们就能去游泳了。"

