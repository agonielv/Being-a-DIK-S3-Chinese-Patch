    ji "你会让我讨厌音乐吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2848
translate schinese ep10_bbq_jill2_event_label_6b6c668b:

    # mc "No, I will make you like bands I love. And I know which one to start with..."
    mc "不，我会让你喜欢我爱的乐队。而且我知道该从哪支开始..."

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2849
translate schinese ep10_bbq_jill2_event_label_15e06e22:

