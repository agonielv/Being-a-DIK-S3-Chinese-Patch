# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2940
translate schinese ep10_bbq_jb_event_label_80bdf3f5:

    # jb "I gave a fork a staredown for like an hour."
    jb "我盯着一把叉子看了整整一个小时。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2941
translate schinese ep10_bbq_jb_event_label_a29a9918:

    # jb "Why do forks come with different numbers of prongs? And if you have many prongs and they meld together, do you know what you get?"
    jb "为什么叉子会有不同数量的叉齿？如果你有很多叉齿，它们融在一起了，你知道你会得到什么吗？"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2942
translate schinese ep10_bbq_jb_event_label_45d3208a:

    # jb "A spoon, [name]! It becomes a spoon!"
    jb "一把勺子[name]它变成了一把勺子！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2945
translate schinese ep10_bbq_jb_event_label_c6f1863c:

    # mc "Whoa!"
    mc "哇哦！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2947
translate schinese ep10_bbq_jb_event_label_d7ecd65e:

    # mc "That's quite the epiphany."
    mc "那可真是个醒悟啊。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2949
translate schinese ep10_bbq_jb_event_label_c03dd24e:

    # jb "Right!?"
    jb "对吧？！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2950
translate schinese ep10_bbq_jb_event_label_f9073e42:

    # jb "Have you seen Elena? I gotta tell her about it."
    jb "你见过Elena吗？我得告诉她这件事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2952
translate schinese ep10_bbq_jb_event_label_c9a15f21:

    # mc "She's somewhere around here."
    mc "她就在附近。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2955
translate schinese ep10_bbq_jb_event_label_3251108d:

    # jb "I gotta find her! She needs to know about this."
    jb "我得赶紧找到她！她必须知道这件事。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2958
translate schinese ep10_bbq_jb_event_label_f522b71f:

    # jb "Elena tells me you two are close."
    jb "Elena跟我说你们俩关系挺近的。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2959
translate schinese ep10_bbq_jb_event_label_9a5782fd:

    # jb "I wanted to say how happy that makes me to hear."
    jb "听到这个我真的很开心。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2961
translate schinese ep10_bbq_jb_event_label_4d42302e:

    # mc "Yeah, we kinda are. She's such a fun person to be around."
    mc "嗯，我们还挺合得来的。她真的很有趣，跟谁在一起都让人开心。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2963
translate schinese ep10_bbq_jb_event_label_277e6715:

    # jb "She is fun! And caring. And sexy."
    jb "她很有趣，很贴心，还很性感。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2964
translate schinese ep10_bbq_jb_event_label_bdc01298:

    # jb "I think I got horny talking to you about her."
    jb "光是和你聊起她，我都有点兴奋了。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2966
translate schinese ep10_bbq_jb_event_label_69163332:

    # mc "Go do something about it, bro. I can't help you with that."
    mc "去搞定她，兄弟。我帮不上你这个忙。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2968
translate schinese ep10_bbq_jb_event_label_11ccbe95:

    # mc "Hell, I have so many quests to go on that I don't know where to start."
    mc "我他妈的有这么多任务要做，都不知道从哪儿开始。"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2970
translate schinese ep10_bbq_jb_event_label_fa88d450:

    # jb "On a scale of one to ten. One being the highest. How sexy is Elena?"
