translate schinese ep10_bbq_jill2_event_label_27b5373b:

    # mc "Their best song!? You can't possibly ask me to pick one ShitFaced song. They have countless hits!"
    mc "他们的最佳歌曲？你不可能让我选一首醉鬼歌。他们有太多经典曲目了！"

# freeroam\episode10\ep10_freeroam_bbq_events.rpy:2868
translate schinese ep10_bbq_jill2_event_label_e007c54b:

