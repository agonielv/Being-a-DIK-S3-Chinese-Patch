    # pa "This is not what I wanted for today, either."
    pa "这也不是我今天想看到的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1198
translate schinese ep10_tg_contract_label_0e90a0d7:

    # pa "Your mother has worsened these last few months and didn't want us to cancel the plans when you were coming back home."
    pa "你妈最近几个月情况越来越差，不想我们因为你要回家而取消计划。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1212
translate schinese ep10_tg_contract_label_6bc16a8e:

    # mc "(Sage couldn't find it... I hope that I can.)"
    mc "（Sage没找到……希望我能找到。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1214
translate schinese ep10_tg_contract_label_26e5c65b:

    # mc "(I hope I can find it...)"
    mc "（希望我能找到它……）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1221
translate schinese ep10_fr_tg_end_label_6d22081f:

    # mc "(Loans...)"
    mc "（贷款……都还清了。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1222
translate schinese ep10_fr_tg_end_label_93915d6a:

    # mc "(Mortgage seems paid in full.)"
    mc "（房贷已经结清了。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1224
translate schinese ep10_fr_tg_end_label_9366a466:

    # mc "(A loan for a caravan. Payments for it... Paid in full.)"
    mc "（一辆房车的贷款。还款……已经还清了。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1226
translate schinese ep10_fr_tg_end_label_a1952f3b:

    # mc "(Finnman Banking? Some kind of loan... Uh... Nah, this doesn't look like it.)"
    mc "（芬曼银行？什么贷款啊……呃……不，这看起来不像。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1228
translate schinese ep10_fr_tg_end_label_916f3ae9:

    # mc "(Medical bills for Helen... Insurance... Ugh... I feel like such a scummy asshole going through these.)"
    mc "（Helen的医疗账单……保险……啧……我觉得自己像个混蛋，翻这些东西。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1229
translate schinese ep10_fr_tg_end_label_2c82009f:

    # mc "(It's for Maya... Come on... Push those feelings away.)"
    mc "（这是给Maya的... 好吧... 把那些感觉压下去。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1231
translate schinese ep10_fr_tg_end_label_c299fbfd:

    # mc "(Oh! This one has Maya's signature on it! And Patrick's, too! This is it!)"
    mc "（哦！这张上有Maya的签名，还有Patrick的！就是这张！）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1232
translate schinese ep10_fr_tg_end_label_dc736807:

    # mc "(\"The funds lent by Finnman Banking...\" Finnman Banking? Wait, I saw that one in here.)"
    mc "（“芬曼银行提供的贷款……”芬曼银行？等等，我好像在这儿见过这个。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1234
translate schinese ep10_fr_tg_end_label_bb0157ba:

    # mc "(I'll grab these too.)"
    mc "（我也一起拿走吧。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1237
translate schinese ep10_fr_tg_end_label_528b4fdc:

    # mc "(I can't forget to lock the door and to put the keys back in the box.)"
    mc "（我可不能忘了锁门，再把钥匙放回盒子。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1238
translate schinese ep10_fr_tg_end_label_92a66dc7:

    # mc "(The longer the time we have reading these papers without him knowing about it, the better.)"
    mc "（我们越早读完这些文件而不让他发现，就越好了。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1240
translate schinese ep10_fr_tg_end_label_02a2a8c5:

    # pa "*{i}Sobs{/i}*"
    pa "*{i}抽泣{/i}*"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1242
translate schinese ep10_fr_tg_end_label_5ac02a47:

    # mc "(Is he...crying?)"
    mc "（他……在哭？）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1244
translate schinese ep10_fr_tg_end_label_2b35b6fe:

    # mc "..."
    mc "..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1249
translate schinese ep10_fr_tg_end_label_93c789b2:

    # mc "Derek? Are you out there?"
    mc "Derek？你在外面吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1251
translate schinese ep10_fr_tg_end_label_f59d44e4:

    # de "[mc_de_up]?"
    de "[mc_de_up]?"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1253
translate schinese ep10_fr_tg_end_label_4b38d788:

    # mc "I got it! Open the door."
    mc "我搞定啦，开门。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1255
translate schinese ep10_fr_tg_end_label_ff0eed0d:

    # de "Hold on."
    de "等等。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1259
translate schinese ep10_fr_tg_end_label_d2d3fa05:

    # my "This couldn't have gone any worse."
    my "这事儿要是再糟下去，我真不知道该怎么办了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1261
translate schinese ep10_fr_tg_end_label_85697bff:

    # sa "We were so close to getting it earlier. With just some more time to search, I'm sure [name] will find it."
    sa "之前就差一点了。只要再多找一会儿，我相信[name]一定能找到。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1263
translate schinese ep10_fr_tg_end_label_fe47a849:

    # my "I don't know what we were thinking when we came up with this."
    my "我们当时是怎么想的，居然会搞出这种主意。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1265
translate schinese ep10_fr_tg_end_label_a56302d6:

    # sa "It will be fine, Maya."
    sa "这会没事的，Maya。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1267
translate schinese ep10_fr_tg_end_label_ace7d76c:

    # my "I'm afraid I caused problems for Mom. If she gets mad at Dad..."
    my "我怕我让妈妈为难了。如果她生气的话，爸爸……"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1268
translate schinese ep10_fr_tg_end_label_9a18068a:

    # my "Sometimes, she says these horrible things to him in front of us."
    my "有时候她会当着我们的面，对他说些很难听的话。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1270
translate schinese ep10_fr_tg_end_label_5189c20a:

    # my "Like, how she doesn't love him anymore. And how he wasn't her first love."
    my "像她说他现在不爱她了，还说他不是她第一个爱的人。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1271
translate schinese ep10_fr_tg_end_label_c60226a5:

    # my "I think it's her illness talking, but I can't help but wonder if she'd ever leave him."
    my "我想可能是她病了，但我不禁想，她会不会真的会离开他。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1273
translate schinese ep10_fr_tg_end_label_07cd6b38:

    # sa "..."
    sa "..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1275
translate schinese ep10_fr_tg_end_label_a9993288:

    # sa "It's not the end of the world if they split up. Many parents...divorce."
    sa "这不意味着世界末日，很多父母……都离婚了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1277
translate schinese ep10_fr_tg_end_label_accedcde:

    # my "For them, it's everything. Mom depends on him."
    my "对她们来说，那一切就是全部。妈妈也靠他。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1279
translate schinese ep10_fr_tg_end_label_9d8b7f58:

    # sa "Don't jump ahead, Maya. Your dad might cool down tomorrow, and you can talk to him."
    sa "别急着下结论，Maya。你爸可能明天就冷静下来了，到时候你再跟他谈谈。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1280
translate schinese ep10_fr_tg_end_label_a3a72a8d:

    # sa "And if the boys are lucky...everything we did tonight will be worth it."
    sa "如果男生们运气好……今晚我们做的一切都值得。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1288
translate schinese ep10_fr_tg_end_label_f053cf89:

    # mc "I did it! Maya, I did it!"
    mc "我干了！Maya，我干了！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1290
translate schinese ep10_fr_tg_end_label_fe4954cd:

    # sa "No way!"
    sa "不可能！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1292
translate schinese ep10_fr_tg_end_label_9e010866:

    # my "You got the contract?"
    my "你拿到合同了？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1294
translate schinese ep10_fr_tg_end_label_abe999e0:

    # mc "The papers are right here! Here you go!"
    mc "合同在这儿呢！给你！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1296
translate schinese ep10_fr_tg_end_label_033aca33:

    # my "Are you for real?"
    my "你是认真的吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1299
translate schinese ep10_fr_tg_end_label_71ab1f7f:

    # de "Let's go! Haha!"
    de "冲啊！哈哈！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1302
translate schinese ep10_fr_tg_end_label_65761134:

    # my "I can't believe you got them... They're here. They're really here!"
    my "我简直不敢相信你搞到了它们……它们真的在这里。真的在这里！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1305
translate schinese ep10_fr_tg_end_label_8fa91e13:

    # de "We fucking did it!"
    de "我们他妈的真干成了！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1308
translate schinese ep10_fr_tg_end_label_99479cc3:

    # mc "So, what now? Should we read them?"
    mc "那现在怎么办？我们该先看吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1310
translate schinese ep10_fr_tg_end_label_75e5f5af:

    # sa "I don't want to be responsible for interpreting the contracts on my own. Let's wait until we're at Bella's."
    sa "我不想自己一个人负责解释这些合同。等我们到了贝拉家再谈吧。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1312
translate schinese ep10_fr_tg_end_label_f8ce2508:

    # mc "I can't wait until we get to Bella's."
    mc "我迫不及待想见到贝拉了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1317
translate schinese ep10_fr_tg_end_label_62739910:

    # de "Hey! This calls for a celebration! How about some music?"
    de "嘿！这事儿得庆祝一下！来点音乐怎么样？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1320
translate schinese ep10_fr_tg_end_label_9297b67d:

    # sa "What the fuck is this music?"
    sa "这他妈是什么音乐？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1322
translate schinese ep10_fr_tg_end_label_88afda27:

    # mc "Um... Weird tunes."
    mc "嗯……奇怪的曲调。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1324
translate schinese ep10_fr_tg_end_label_23aaf15f:

    # my "Hahaha! This is the radio station Dad listens to."
    my "哈哈哈！这就是我爸爸常听的电台。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1325
translate schinese ep10_fr_tg_end_label_02cef5a4:

    # my "SET US FREE!"
    my "放我们自由！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1327
translate schinese ep10_fr_tg_end_label_b73446b8:

    # mc "SET US FREE!"
    mc "放我们自由！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1330
translate schinese ep10_fr_tg_end_label_871b714b:

    # sa "Hahaha!"
    sa "哈哈哈！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1333
translate schinese ep10_fr_tg_end_label_feba4158:

    # de "SET US FREE!"
    de "放我们自由！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1334
translate schinese ep10_fr_tg_end_label_a548db7e:

    # my "PREACH IT, BROTHER!"
    my "说得好，兄弟！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1349
translate schinese ep10_fr_tg_end_bella_label_45572896:

    # de "Is this the place?"
    de "这是那个地方吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1350
translate schinese ep10_fr_tg_end_bella_label_45ed9d56:

    # mc "Yeah, we're here."
    mc "嗯，到了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1352
translate schinese ep10_fr_tg_end_bella_label_c1d5d7ac:

    # my "*{i}Phew{/i}* Let's go. They're waiting for us."
    my "*{i}松了口气{/i}* 走吧，他们还在等我们。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1354
translate schinese ep10_fr_tg_end_bella_label_7f7c987b:

    # my "Let's go... They'll want to hear what happened."
    my "我们走吧...他们想听听发生了什么。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1360
translate schinese ep10_fr_tg_end_bella_label_48edc78a:

    # de "Go ahead, you guys. I need a minute."
    de "你们先上，我需要一分钟。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1363
translate schinese ep10_fr_tg_end_bella_label_e05ab314:

    # mc "Are you ok?"
    mc "你没事吧？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1366
translate schinese ep10_fr_tg_end_bella_label_2845e70b:

    # de "I can't believe we did it... Well, {b}you{/b} did it."
    de "我真不敢相信我们做到了……嗯，{b}你{/b}干了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1370
translate schinese ep10_fr_tg_end_bella_label_5e16c41f:

    # mc "We're not out of the woods yet."
    mc "我们还没完全脱险呢。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1372
translate schinese ep10_fr_tg_end_bella_label_2fa1fccf:

    # de "It still feels like a victory... It's about time."
    de "这感觉还是像一场胜利……终于等到这一天了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1374
translate schinese ep10_fr_tg_end_bella_label_0f369f2a:

    # mc "Yeah... It kind of does."
    mc "是啊……确实有点。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1378
translate schinese ep10_fr_tg_end_bella_label_63b2bcc1:

    # mc "I couldn't have done it without you."
    mc "没有你我根本做不到。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1380
translate schinese ep10_fr_tg_end_bella_label_b122b76b:

    # de "I was about to give up when we drove away."
    de "我差点放弃了，就当我们开车离开的时候。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1382
translate schinese ep10_fr_tg_end_bella_label_436153b8:

    # mc "But we both changed our minds and powered through. That's what matters."
    mc "但我们俩都改变了主意，坚持了下来。这才是最重要的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1385
translate schinese ep10_fr_tg_end_bella_label_385cb20e:

    # de "I will be. I have to."
    de "我会的。我必须这么做。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1389
translate schinese ep10_fr_tg_end_bella_label_5c96a1fc:

    # mc "We'll find another way to help her."
    mc "我们会找到其他办法帮她。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1391
translate schinese ep10_fr_tg_end_bella_label_8ab3fc2a:

    # de "I don't want to be a downer, but I don't think we will."
    de "我不希望扫了大家的兴，但我觉得我们可能真的不行。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1393
translate schinese ep10_fr_tg_end_bella_label_d03db983:

    # mc "You're not giving up, right?"
    mc "你可没放弃吧？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1395
translate schinese ep10_fr_tg_end_bella_label_db6c603c:

    # de "Truth be told, I didn't believe this play would work in the first place."
    de "说实话，我一开始就不觉得这场戏能成。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1397
translate schinese ep10_fr_tg_end_bella_label_26c77182:

    # mc "Have some faith..."
    mc "有希望的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1399
translate schinese ep10_fr_tg_end_bella_label_0c12ccba:

    # de "My dad had faith. Look what it got him."
    de "我老爸有信仰。看看他最后得到了什么。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1400
translate schinese ep10_fr_tg_end_bella_label_5f919177:

    # de "It's fine, [name]."
    de "没关系[name]."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1403
translate schinese ep10_fr_tg_end_bella_label_1b2493eb:

    # de "[name]... About before... I should have told you about Dad, but...it was too hard."
    de "[name]……关于之前的事……我本该告诉你关于爸爸的事，但……太难了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1405
translate schinese ep10_fr_tg_end_bella_label_3e96af64:

    # mc "You should have told me that your dad is abusing Maya. And maybe you too?"
    mc "你早该告诉我你爸在虐待Maya。还有你可能也一样？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1407
translate schinese ep10_fr_tg_end_bella_label_cf2a3b2c:

    # de "It's not like that."
    de "不是那个意思。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1408
translate schinese ep10_fr_tg_end_bella_label_404240a4:

    # de "Dad's gotten a bit rough with us in the past, but he doesn't hit us."
    de "我爸以前对我们有点粗暴，但从来没打过我们。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1410
translate schinese ep10_fr_tg_end_bella_label_1b64eb3e:

    # mc "What I saw him do to Maya is still abuse, dude..."
    mc "我亲眼看到他对Maya做的那些事，那仍然是虐待，伙计……"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1411
translate schinese ep10_fr_tg_end_bella_label_f266eafc:

    # mc "Not to mention the whole psychological abuse."
    mc "更别提心理上的虐待了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1413
translate schinese ep10_fr_tg_end_bella_label_9477e37e:

    # de "I don't expect you to understand this, but it's not been easy for him."
    de "我可没指望你能理解，但对他来说真的不容易。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1414
translate schinese ep10_fr_tg_end_bella_label_ca0acd65:

    # de "He basically raised us on his own. Mom did what she could, but Dad's been carrying this heavy burden all my life."
    de "他基本上是单挑养大我们的。妈妈尽她所能，但爸爸这一生都在扛着这个重担。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1416
translate schinese ep10_fr_tg_end_bella_label_62cfa036:

    # de "Having to provide for us, taking care of Mom and us... He's pushing himself daily for his family."
    de "为了我们一家，他每天都在拼命努力，照顾妈妈和我们。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1417
translate schinese ep10_fr_tg_end_bella_label_f1247442:

    # de "His beaker is almost always full, and at times, it overflows."
    de "他的烧杯几乎总是装满，有时候甚至会溢出来。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1419
translate schinese ep10_fr_tg_end_bella_label_d4048126:

    # de "I know it doesn't justify his actions...but...he's still our dad."
    de "我知道他的行为不值得原谅……但……他仍然是我们的父亲。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1420
translate schinese ep10_fr_tg_end_bella_label_80eace44:

    # de "And all I could do about it was to be there for Maya. Always and ever..."
    de "而我唯一能做的，就是一直陪在Maya身边。永远如此……"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1421
translate schinese ep10_fr_tg_end_bella_label_6357ca84:

    # de "That's why I'm here today, [name]."
    de "这就是我今天在这里的原因，[name]."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1423
translate schinese ep10_fr_tg_end_bella_label_b2b9e19d:

    # mc "What do you mean?"
    mc "你是什么意思？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1425
translate schinese ep10_fr_tg_end_bella_label_7909db6e:

    # de "I mean, that's why I'm in college. It's been cool to party and try to hook up with girls and all..."
    de "我是说，这就是我上大学的原因。参加派对、试着勾搭女生什么的……确实挺有意思。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1426
translate schinese ep10_fr_tg_end_bella_label_47ba5011:

    # de "But I'm really doing it for Maya. Wherever she goes, I will follow."
    de "但我真的这么做，是为了Maya。无论她去哪，我都会跟着她。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1430
translate schinese ep10_fr_tg_end_bella_label_d16590cc:

    # de "She doesn't know that's the reason, and it's fine. I think it's best if she doesn't know it. But it's what I want to do."
    de "她不知道这是原因，这样也挺好。我觉得她不知道最好。但这就是我想做的事。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1432
translate schinese ep10_fr_tg_end_bella_label_fd6cbc3e:

    # de "I owe it to Mom. And I owe it to Dad, too."
    de "我欠妈妈的，也欠爸爸的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1433
translate schinese ep10_fr_tg_end_bella_label_41fc04e5:

    # de "Even if Dad doesn't see it our way, I'm doing it for my family."
    de "即使我爸不理解我们，我也是为了我的家人在这么做。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1434
translate schinese ep10_fr_tg_end_bella_label_f8eb2c38:

    # de "Maybe someday he will realize he's been wrong with how he treats Maya."
    de "也许总有一天他会意识到自己对待Maya的方式是错的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1436
translate schinese ep10_fr_tg_end_bella_label_8a75610e:

    # mc "Derek..."
    mc "Derek……"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1437
translate schinese ep10_fr_tg_end_bella_label_e004e0cc:

    # de "No, no... Don't touch me. I'm a slight graze away from bursting."
    de "不，别碰我。我离爆开就差一点了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1438
translate schinese ep10_fr_tg_end_bella_label_fa80facb:

    # de "And I'm not talking about my dick. Haha..."
    de "而且我可不是在说我的屌。哈哈..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1445
translate schinese ep10_fr_tg_end_bella_label_2cfc4323:

    # mc "Fuck you. I'm still doing it."
    mc "操你。我还是要这么做。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1447
translate schinese ep10_fr_tg_end_bella_label_07af15ae:

    # mc "I'm still doing it."
    mc "我还在继续。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1448
translate schinese ep10_fr_tg_end_bella_label_d6bb24a1:

    # de "*{i}Sobs{/i}*"
    de "*{i}抽泣{/i}*"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1451
translate schinese ep10_fr_tg_end_bella_label_2fc7f3ba:

    # mc "Derek. You should do something for yourself, too. If college isn't what you wanna do with your life, you shouldn't do it."
    mc "Derek。你也要为自己做点什么。如果大学不是你想过的人生，那就别勉强自己。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1452
translate schinese ep10_fr_tg_end_bella_label_95ef16b3:

    # mc "You can still be there for Maya."
    mc "你还可以在那儿陪着Maya。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1453
translate schinese ep10_fr_tg_end_bella_label_bbb8f1b9:

    # de "And do what? I have no clue what I wanna do with my life."
    de "那我该怎么办？我连自己想干啥都不知道。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1460
translate schinese ep10_fr_tg_end_bella_label_2fc7f3ba_1:

    # mc "Derek. You should do something for yourself, too. If college isn't what you wanna do with your life, you shouldn't do it."
    mc "Derek。你也要为自己做点什么。如果大学不是你想过的人生，那你就不该来这儿。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1461
translate schinese ep10_fr_tg_end_bella_label_95ef16b3_1:

    # mc "You can still be there for Maya."
    mc "你还可以在Maya身边。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1463
translate schinese ep10_fr_tg_end_bella_label_bbb8f1b9_1:

    # de "And do what? I have no clue what I wanna do with my life."
    de "那我该干啥？我根本不知道自己这辈子想干啥。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1465
translate schinese ep10_fr_tg_end_bella_label_85545613:

    # mc "You have to figure that one out for yourself."
    mc "你得自己弄清楚。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1466
translate schinese ep10_fr_tg_end_bella_label_a20a4f44:

    # mc "But I don't think Maya would want you to live your life just for her."
    mc "但我不觉得Maya会让你为了她一个人活一辈子。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1467
translate schinese ep10_fr_tg_end_bella_label_7597467a:

    # mc "And I think you know that too. Or else you would have told her about this."
    mc "而且我想你也是知道的。不然你早就告诉过她了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1469
translate schinese ep10_fr_tg_end_bella_label_7d44c1ff:

    # de "I just wanted her to be safe first."
    de "我只是先想让她安全。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1476
translate schinese ep10_fr_tg_end_bella_label_c9315e7e:

    # mc "Let's make sure she can be safe, then."
    mc "那我们就确保她能安全地在一起。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1479
translate schinese ep10_fr_tg_end_bella_label_ddeaa2d9:

    # mc "Then don't give up on her now. She needs you."
    mc "那现在别放弃她。她需要你。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1480
translate schinese ep10_fr_tg_end_bella_label_8693da19:

    # mc "Let's make sure she can be safe together."
    mc "让我们一起确保她能安全。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:1486
translate schinese ep10_fr_tg_end_bella_label_39a1b081:

    # de "[mc_de_up]... I know I'm not your best friend, but you're mine."
    de "[mc_de_up]...我知道我不是你最好的朋友，但你是我的。"

