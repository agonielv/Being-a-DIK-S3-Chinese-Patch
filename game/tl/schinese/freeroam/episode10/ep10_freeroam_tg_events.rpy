translate schinese ep10_tg_dinner_label_b78e8c2a:

    # pa "I haven't watched the game yet. I put it on pause to prepare the feast."
    pa "我还没看比赛呢，我把它暂停了，好准备这顿盛宴。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:475
translate schinese ep10_tg_dinner_label_9107cc4d:

    # hl "But you love watching the game on Thanksgiving."
    hl "但你最喜欢在感恩节看比赛。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:477
translate schinese ep10_tg_dinner_label_af305b50:

    # pa "I'll watch it later tonight."
    pa "我待会儿再看。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:478
translate schinese ep10_tg_dinner_label_a3ddea27:

    # pa "If anyone knows who won, spare me the spoilers. Haha!"
    pa "如果有人知道结果，就别给我剧透了。哈哈！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:481
translate schinese ep10_tg_dinner_label_8cf1aa30:

    # hl "Oh! Another fresh face. Who is this?"
    hl "哦！又来个新面孔。这是谁？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:483
translate schinese ep10_tg_dinner_label_d19f179c:

    # de "Mom, this is my - ugh - close friend, Sage."
    de "妈妈，这是我——呃——我一个很熟的朋友，Sage。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:485
translate schinese ep10_tg_dinner_label_968f42ce:

    # sa "Hi! Helen, is it? You have a lovely home."
    sa "嗨！Helen，对吧？你这房子真不错。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:487
translate schinese ep10_tg_dinner_label_44bf54c8:

    # hl "Sage, what a pretty name. Almost as pretty as you."
    hl "Sage，你这名字真漂亮，几乎和你一样好看。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:489
translate schinese ep10_tg_dinner_label_500d3676:

    # sa "Oh. Thanks..."
    sa "哦。谢谢..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:492
translate schinese ep10_tg_dinner_label_40622467:

    # pa "Love? Do you want to say the prayers?"
    pa "爱？你想说祷告词吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:494
translate schinese ep10_tg_dinner_label_a4d2a3a2:

    # hl "I don't do that anymore. You know that."
    hl "我可不做那种事了。你清楚的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:496
translate schinese ep10_tg_dinner_label_ab4394ea:

    # pa "Still, I wanted to check. Do you mind if I say them?"
    pa "不过我还是想确认一下，你介意我念出来吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:500
translate schinese ep10_tg_dinner_label_c01f6e72:

    # pa "Our Heavenly Father."
    pa "我们天上的父亲。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:501
translate schinese ep10_tg_dinner_label_0f01a443:

    # pa "We are thankful for our food and drink."
    pa "我们感谢这顿饭和这杯酒。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:502
translate schinese ep10_tg_dinner_label_7b2c8d95:

    # pa "And we're especially thankful for this on this day, which we may share in the company of family and friends."
    pa "而今天，我们特别感恩，因为今天可能和家人朋友一起度过。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:503
translate schinese ep10_tg_dinner_label_905fc951:

    # pa "Thank you."
    pa "谢谢。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:505
translate schinese ep10_tg_dinner_label_28a57be6:

    # pa "Please, everyone. Dig in."
    pa "请各位，尽情享用。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:507
translate schinese ep10_tg_dinner_label_65950893:

    # hl "The food looks delicious!"
    hl "这顿饭看起来真棒！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:508
translate schinese ep10_tg_dinner_label_54904527:

    # hl "Your father has spent most of today ensuring we have this great meal."
    hl "你父亲今天大部分时间都在确保我们能有这顿美餐。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:510
translate schinese ep10_tg_dinner_label_608d776f:

    # hl "I remember when we were young, and he struggled so hard in the kitchen. Haha!"
    hl "我记得我们小时候，他做饭的时候可惨了，哈哈！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:511
translate schinese ep10_tg_dinner_label_cdf74821:

    # hl "He once made fish sticks using the bread toaster. Do you remember that, Maya?"
    hl "他以前用面包烤箱做过鱼条。你记得吗，Maya？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:513
translate schinese ep10_tg_dinner_label_d9fb7b37:

    # my "Yes, I do. They came out all burnt."
    my "是的，我记得。全都烧焦了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:515
translate schinese ep10_tg_dinner_label_5aa22ae6:

    # hl "Haha! All burnt! We had to open the windows because it smelled so bad."
    hl "哈哈！全糊了！那味道太难闻了，我们只好把窗户都打开。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:516
translate schinese ep10_tg_dinner_label_a654830f:

    # hl "It also set off the fire alarms, and the neighbors came running."
    hl "还触发了火警，邻居们都跑出来了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:518
translate schinese ep10_tg_dinner_label_a9ad8525:

    # pa "You've always been the cook in the family. Everything I've learned comes from you."
    pa "你一直都是家里那个会做饭的人。我所有学的都是从你那儿来的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:520
translate schinese ep10_tg_dinner_label_3be8ac37:

    # hl "You're doing great, love."
    hl "你表现得不错，宝贝。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:521
translate schinese ep10_tg_dinner_label_01a32eaa:

    # hl "Your father is so good these days. He cooks, cleans, and works."
    hl "你爸最近可真能干，做饭、打扫、上班全都包了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:522
translate schinese ep10_tg_dinner_label_6377f70e:

    # hl "I do the laundry, of course. That's my job, haha."
    hl "我当然洗衣服了，这可是我的工作，哈哈。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:524
translate schinese ep10_tg_dinner_label_d41ee15e:

    # pa "And I don't dare touch it."
    pa "我可不敢碰。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:526
translate schinese ep10_tg_dinner_label_23ae2660:

    # hl "Haha! No, you better not."
    hl "哈哈，别碰。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:529
translate schinese ep10_tg_dinner_label_77db9fac:

    # my "*{i}Whispers{/i}* I'm sorry about Mom. She gets amped up after she takes morphine."
    my "*{i}耳语{/i}* 抱歉，我妈吃完吗啡就会特别兴奋。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:530
translate schinese ep10_tg_dinner_label_02165a41:

    # my "*{i}Whispers{/i}* It's hard to get a word in."
    my "*{i}耳语{/i}* 根本插不上话。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:535
translate schinese ep10_tg_dinner_label_87692a00:

    # mc "*{i}Whispers{/i}* She's sweet, though. I can see where you get it from."
    mc "*{i}耳语{/i}* 不过她人挺好的。我知道你这性格像谁了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:549
translate schinese ep10_tg_dinner_label_72330b26:

    # mc "*{i}Whispers{/i}* I understand. It must be tough to try and stay herself with her illness."
    mc "*{i}耳语{/i}* 我明白。生着病还要努力保持自我，她一定很不容易。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:554
translate schinese ep10_tg_dinner_label_f45b9cba:

    # pa "Honey? Don't forget to eat."
    pa "甜心？别忘了吃饭。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:556
translate schinese ep10_tg_dinner_label_b64abde9:

    # hl "Oh, right! Eat. I need to eat when I've taken my medication, or I get sick."
    hl "哦，对了，吃点东西。我吃药之后得吃点东西，不然会肚子疼。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:557
translate schinese ep10_tg_dinner_label_ed3f4572:

    # hl "It's the weirdest thing."
    hl "这事儿真是怪得不行。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:559
translate schinese ep10_tg_dinner_label_9a47f466:

    # pa "I have an idea. How about we go around the table and say what we are thankful for?"
    pa "我有个主意。我们轮流说说各自感恩的事怎么样？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:560
translate schinese ep10_tg_dinner_label_0b83fb4c:

    # pa "That's a nice tradition, right? I can start."
    pa "这真是个不错的传统，对吧？我也可以开始。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:562
translate schinese ep10_tg_dinner_label_0d47baae:

    # pa "I am thankful for my family. How we stick together through thick and thin."
    pa "我感谢我的家人。无论顺境逆境，我们总是彼此支持。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:563
translate schinese ep10_tg_dinner_label_770818c4:

    # pa "And how we always care about each other."
    pa "而且我们总是互相关心。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:565
translate schinese ep10_tg_dinner_label_dca62257:

    # pa "I am thankful for you, Helen. Every day is a struggle for you, but you always manage, and it amazes me."
    pa "我感谢你，Helen。你每天都在挣扎，但你总是撑下来，这让我很佩服。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:566
translate schinese ep10_tg_dinner_label_4027f72d:

    # pa "You are the strongest person I'm blessed to know, and I don't know how you do it."
    pa "你是我在世上最坚强的人，我不知道你是怎么做到的。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:567
translate schinese ep10_tg_dinner_label_71368c50:

    # pa "I love you."
    pa "我爱你。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:569
translate schinese ep10_tg_dinner_label_7a5814b8:

    # hl "Oh, dear. That was so beautiful."
    hl "哦，亲爱的。那番话真美。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:572
translate schinese ep10_tg_dinner_label_4a5158e7:

    # mc "(That was so unexpected... It felt genuine.)"
    mc "（那句话来得太突然了……感觉是发自内心的。）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:573
translate schinese ep10_tg_dinner_label_874bed06:

    # mc "(If he means those words, why is he treating Maya like shit?)"
    mc "（如果他真的这么说，为什么还要对Maya这么刻薄？）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:575
translate schinese ep10_tg_dinner_label_07f9399a:

    # pa "What are you thankful for, love?"
    pa "你感激什么，亲爱的？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:577
translate schinese ep10_tg_dinner_label_ed534dbe:

    # hl "I, too, am thankful for my beautiful family."
    hl "我也很感谢我的美丽家庭。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:578
translate schinese ep10_tg_dinner_label_1d05e655:

    # hl "Having you home is the highlight of my day, week, or month. It's what I live for."
    hl "有你在身边是我一天、一周甚至一月里最期待的事，我活着就是为了这一刻。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:580
translate schinese ep10_tg_dinner_label_76cd5c61:

    # hl "What are you thankful for, pumpkin?"
    hl "你感恩什么，小甜心？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:582
translate schinese ep10_tg_dinner_label_6546d7e0:

    # my "Uh... I don't know."
    my "嗯……我也不太确定。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:584
translate schinese ep10_tg_dinner_label_98961fdd:

    # pa "Surely you're thankful for something."
    pa "你肯定有什么值得感激的吧。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:586
translate schinese ep10_tg_dinner_label_9ff375ad:

    # my "I'm thankful for my friends."
    my "我感谢我的朋友们。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:590
translate schinese ep10_tg_dinner_label_8a2b1071:

    # my "And my family, of course."
    my "还有我的家人，当然了。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:592
translate schinese ep10_tg_dinner_label_1c3a38f9:

    # de "Me too. And I'm thankful for this dinner."
    de "我也是。我还感谢这顿晚餐。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:595
translate schinese ep10_tg_dinner_label_fc5c6678:

    # hl "What about you two?"
    hl "你们俩呢？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:596
translate schinese ep10_tg_dinner_label_dec05ffd:

    # hl "You make a lovely couple, I might add."
    hl "你们真是个不错的组合，我得说。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:601
translate schinese ep10_tg_dinner_label_a3d2a6c2:

    # my "Actually... [name] is my boyfriend, Mom."
    my "其实……妈，[name]是我男朋友。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:603
translate schinese ep10_tg_dinner_label_f9da226a:

    # hl "Your boyfriend!? Is it true?"
    hl "你男朋友？是真的吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:605
translate schinese ep10_tg_dinner_label_4c18a526:

    # mc "Yeah, it is."
    mc "是的，没错。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:607
translate schinese ep10_tg_dinner_label_591d7880:

    # hl "Patrick, did you hear what your daughter just shared with us? Isn't it wonderful!?"
    hl "Patrick，你听到你女儿刚刚跟我们说的了吗？这不挺棒的吧？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:609
translate schinese ep10_tg_dinner_label_8a0216ba:

    # pa "It is certainly something out of the ordinary."
    pa "这可真是个不寻常的事。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:612
translate schinese ep10_tg_dinner_label_f068e116:

    # my "(Lying to Mom like this doesn't feel good...)"
    my "（撒谎给妈妈的感觉真不好）"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:614
translate schinese ep10_tg_dinner_label_4e484e24:

    # hl "Such a wonderful surprise! Now, I have something else to be thankful for."
    hl "这样的惊喜真棒！现在，我还有别的事情要感激。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:616
translate schinese ep10_tg_dinner_label_8a9265ea:

    # hl "But oh! How embarrassing. I must apologize to you for my comment!"
    hl "但天啊！多尴尬啊。我必须向你为我的评论道歉！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:618
translate schinese ep10_tg_dinner_label_2bd14406:

    # sa "It's fine, haha. Uh..."
    sa "没事，哈哈。呃..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:619
translate schinese ep10_tg_dinner_label_b0bc126f:

    # sa "*{i}Sigh{/i}* I'm not sure about what I'm thankful for today."
    sa "*{i}叹气{/i}* 我也不知道今天该为什么而感恩。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:621
translate schinese ep10_tg_dinner_label_59b82ac4:

    # pa "It can be anything that comes to mind. Your family, or maybe something happened this last year that you are thankful for?"
    pa "你可以感谢任何让你感到温暖的东西，比如家人，或者今年发生的一些让你感到开心的事？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:623
translate schinese ep10_tg_dinner_label_07cd6b38:

    # sa "..."
    sa "..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:625
translate schinese ep10_tg_dinner_label_7da3f2a0:

    # sa "Ok... I'm thankful for finding new, true friends and being able to open up to them."
    sa "嗯……我感恩能遇到新的、真诚的朋友，还能向他们敞开心扉。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:628
translate schinese ep10_tg_dinner_label_f6fd9553:

    # sa "And I'm thankful for someone special, too."
    sa "而且我也很感谢一个人。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:633
translate schinese ep10_tg_dinner_label_54c19ea4:

    # sa "It's meant a lot."
    sa "这对我意义重大。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:635
translate schinese ep10_tg_dinner_label_ee9ad5a5:

    # hl "Aw, how nice!"
    hl "哎呀，真暖心啊！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:637
translate schinese ep10_tg_dinner_label_c1e36442:

    # mc "I guess it's my turn..."
    mc "我猜该我了..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:640
translate schinese ep10_tg_dinner_label_08604c69:

    # hl "What about you?"
    hl "你呢？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:642
translate schinese ep10_tg_dinner_label_2c870468:

    # mc "Me? Um..."
    mc "我？呃..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:644
translate schinese ep10_tg_dinner_label_d7582d8f:

    # mc "I'm thankful for the ones closest to me."
    mc "我最感激的是身边最亲近的人。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:645
translate schinese ep10_tg_dinner_label_7452080a:

    # mc "And I'm thankful for my dad..."
    mc "而且我也是感谢我的爸爸..."

# freeroam\episode10\ep10_freeroam_tg_events.rpy:647
translate schinese ep10_tg_dinner_label_e8c48754:

    # mc "He's guided and supported me throughout my life."
    mc "他一直引导并支持着我。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:648
translate schinese ep10_tg_dinner_label_dca74e54:

    # mc "I wouldn't be who I am today without him."
    mc "没有他，我今天就不会成为现在的我。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:653
translate schinese ep10_tg_dinner_label_967ded87:

    # mc "And most importantly, he lets me be me. He lets me make my own mistakes, and he accepts my flaws."
    mc "最重要的是，他让我做自己。他让我自己去犯错，也接纳我的缺点。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:654
translate schinese ep10_tg_dinner_label_45d4aa6b:

    # mc "He doesn't impose his standards or wishes on me."
    mc "他从不强加自己的标准或愿望给我。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:656
translate schinese ep10_tg_dinner_label_6e3755d7:

    # mc "That's what a parent should be like."
    mc "这才是当父母该有的样子。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:660
translate schinese ep10_tg_dinner_label_080b1211:

    # hl "Your father must be proud. He sounds like a beautiful person."
    hl "你父亲一定很骄傲。他听起来是个很棒的人。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:662
translate schinese ep10_tg_dinner_label_66f3ec90:

    # mc "Thank you. He is."
    mc "谢谢。他就是。"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:664
translate schinese ep10_tg_dinner_label_db8e8465:

    # pa "Isn't your father lonely, spending Thanksgiving without you?"
    pa "你不觉得你爸一个人过感恩节挺孤单的吗？"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:666
translate schinese ep10_tg_dinner_label_d3d41f7d:

    # hl "Patrick!"
    hl "Patrick！"

# freeroam\episode10\ep10_freeroam_tg_events.rpy:668
translate schinese ep10_tg_dinner_label_8159b09e:

    # pa "It was merely a question."
    pa "这不过是个问题。"

