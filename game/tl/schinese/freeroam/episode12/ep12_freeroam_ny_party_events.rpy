    mc "{b}你{/b}你邀请 Nick？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:225



translate schinese ep12_np_nick_label_d305ee7f:







    # sa "I'm free to invite whomever I want to our party."



    sa "我随便邀请谁来我们的派对都行。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:228



translate schinese ep12_np_nick_label_b9a53260_1:







    # sa "I did."



    sa "我邀请的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:230



translate schinese ep12_np_nick_label_7ba7519e:







    # mc "Why would you do that? Does Rusty know about this?"



    mc "你们为什么要这么做？Rusty知道吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:232



translate schinese ep12_np_nick_label_884f2364:







    # ni "I'm right here, dude."



    ni "我在这儿呢，伙计。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:235



translate schinese ep12_np_nick_label_b12bc869:







    # mc "I don't give a flying fuck."



    mc "我他妈才不在乎呢。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:237



translate schinese ep12_np_nick_label_ef644512:







    # sa "[name]. Knock it off."



    sa "[name]别闹了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:238



translate schinese ep12_np_nick_label_46467bd1:







    # sa "Rusty knows Nick was invited. He wanted to give him another chance. You should follow his lead."



    sa "Rusty知道Nick被邀请了。他想再给Nick一次机会。你该学学他。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:240



translate schinese ep12_np_nick_label_094b215a:







    # mc "The problem is, Rusty didn't tell Tommy or me about this."



    mc "问题是，Rusty 没有跟 Tommy 或我提起这事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:242



translate schinese ep12_np_nick_label_6d1b95cd:







    # sa "Tommy might not be cool with it, but he's aware Nick is here."



    sa "Tommy可能不太乐意，但他知道Nick在这儿。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:243



translate schinese ep12_np_nick_label_10e515c4:







    # sa "It's time to bury the hatchet. And not just for your guys' sake, it's for Heather and us too."



    sa "该埋葬这把斧头了。不只是为了你们，也是为了Heather和我们。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:246



translate schinese ep12_np_nick_label_6349aa25:







    # sa "Don't make this harder than it has to be."



    sa "别把事情搞得太复杂了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:249



translate schinese ep12_np_nick_label_52dadc0e:







    # sa "Please?"



    sa "请？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:252



translate schinese ep12_np_nick_label_36533087:







    # sa "Rusty knows Nick was invited. He wanted to give him another chance."



    sa "Rusty知道Nick被邀请了。他想再给Nick一次机会。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:254



translate schinese ep12_np_nick_label_13cf51a9:







    # mc "Nick... Do you think this is a good idea? If you wanted to talk, you could have done it outside of the party."



    mc "Nick……你觉得这是个好主意吗？如果你想谈谈，完全可以在派对外面说。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:255



translate schinese ep12_np_nick_label_2c68e909:







    # mc "You're not gonna have a good time here when you're unwanted."



    mc "你在这里待着没人要，肯定玩不开心。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:257



translate schinese ep12_np_nick_label_233f2f41:







    # sa "[name], it's time to bury the hatchet. And not just for your guys' sake, it's for Heather and us too."



    sa "[name]现在该埋葬这把斧头了。不仅为了你们大家，也为了Heather和我们。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:260



translate schinese ep12_np_nick_label_6349aa25_1:







    # sa "Don't make this harder than it has to be."



    sa "别把事情搞得太复杂了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:263



translate schinese ep12_np_nick_label_52dadc0e_1:







    # sa "Please?"



    sa "请？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:267



translate schinese ep12_np_nick_label_95a80238:







    # sa "Nick, come. Let me show you the party."



    sa "Nick，过来。我带你参观一下派对。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:271



translate schinese ep12_np_nick_label_df9ac3b3:







    # mc "(What a shit idea... Is Rusty ok with this?)"



    mc "（这他妈是个馊主意……Rusty会同意吗？）"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:273



translate schinese ep12_np_nick_label_d97fc5b7:







    # mc "(I don't know about this...)"



    mc "（我也不太确定这主意）"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:285



translate schinese ep12_np_bj_label_0c91a526:







    # js "A chaperone? Why? It's not a high school party."



    js "带个监护人？为什么？这又不是高中聚会。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:290



translate schinese ep12_np_bj_label_68b7b1be:







    # isa "Well... It's on campus grounds, and those were the negotiated terms."



    isa "好吧……这派对是在校园里办的，而且那些条件是我们谈好的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:291



translate schinese ep12_np_bj_label_b4f98ca4:







    # isa "But not many were thrilled to work on New Year's Eve."



    isa "但并不是每个人都对在新年之夜工作感到兴奋。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:293



translate schinese ep12_np_bj_label_789586a0:







    # isa "As for me, it worked out well. I get to spend the evening with you girls."



    isa "至于我嘛，这事儿挺顺的。我能和你们这些姑娘们一起过个晚上。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:295



translate schinese ep12_np_bj_label_03d55c44:







    # js "Haha, so you get paid for doing this."



    js "哈哈，所以你是拿钱来干这个的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:297



translate schinese ep12_np_bj_label_6297267f:







    # isa "Yes, but I'm here to ensure students are safe."



    isa "是的，但我是来确保学生们安全的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:299



translate schinese ep12_np_bj_label_57f3cbfd:







    # js "But what about the alcohol?"



    js "那酒精呢？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:301



translate schinese ep12_np_bj_label_990614d8:







    # isa "I'm not going to tell everyone in here not to drink because we know that's futile."



    isa "我不会在这里告诉每个人别喝酒，因为我们知道这样是没用的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:302



translate schinese ep12_np_bj_label_7f1c1bb3:







    # isa "And besides, many are 21. I cannot know who's not."



    isa "再说，这里很多人都是21岁。我没办法一个个确认谁没到年龄。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:304



translate schinese ep12_np_bj_label_bc7765a1:







    # isa "My only concern is how my co-chaperone will handle it. She might not be as lenient as I am."



    isa "我唯一担心的是我的搭档会怎么处理这件事。她可能不会像我这么宽容。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:306



translate schinese ep12_np_bj_label_af78a828:







    # js "Sage said Jade was under control."



    js "Sage说Jade的情况已经控制住了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:307



translate schinese ep12_np_bj_label_4229aa9f:







    # js "She'll do her job and all, but won't interfere unless it's absolutely needed."



    js "她会尽职尽责，但除非情况特别严重，否则她不会多管闲事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:309



translate schinese ep12_np_bj_label_8aa46043:







    # isa "I suppose I should talk to her later on."



    isa "我猜我应该之后跟她谈谈。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:311



translate schinese ep12_np_bj_label_55261664:







    # js "Yeah, you should. Want to have a drink with me, or do you have to stay sober?"



    js "要喝一杯吗？还是得保持清醒？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:313



translate schinese ep12_np_bj_label_c33a319f:







    # isa "My only obligation is to keep students safe. How can I do that without tasting what they are drinking?"



    isa "我唯一的责任就是确保学生们安全。那我怎么能在不尝尝他们喝什么的情况下做到这一点呢？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:315



translate schinese ep12_np_bj_label_6376f6d1:







    # js "Haha! A drink it is."



    js "哈哈！来杯酒吧。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:328



translate schinese ep12_np_he_label_324c76f3:







    # el "I love how everything came together. This venue was a great choice."



    el "我爱这一切都这么顺利，这个场地选得太好了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:330



translate schinese ep12_np_he_label_62063182:







    # he "Don't celebrate too early. There's a reason they put up that tape, and why we had to split the dining room into two."



    he "别太早庆祝。他们贴那条胶带是有原因的，而且我们把餐厅分成两半也是有道理的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:332



translate schinese ep12_np_he_label_bbc3e700:







    # el "Don't you think they'll behave tonight?"



    el "你就不觉得他们今晚会闹事吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:334



translate schinese ep12_np_he_label_36c05cae:







    # he "Have you met them? I'm calling it. By 10 p.m., there will be at least one big fight."



    he "你见过他们吗？我赌定了，到十点前至少会有一场大打出手。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:336



translate schinese ep12_np_he_label_6d164f49:







    # el "Blame it on the alcohol."



    el "归咎于酒精。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:338



translate schinese ep12_np_he_label_9adf5719:







    # he "I'll blame it on everyone who thought this party was a good idea to begin with."



    he "我得把锅甩给所有觉得这聚会是个好主意的人。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:340



translate schinese ep12_np_he_label_4542b5bc:







    # mc "10 p.m.? I'll take that bet."



    mc "十点？我押你一局。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:342



translate schinese ep12_np_he_label_75af423f:







    # he "You don't think so?"



    he "你就不这么想？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:347



translate schinese ep12_np_he_label_acb5eeb6:







    # mc "Not with this line separating us. It may seem stupid and juvenile..."



    mc "不过这道线隔在我们之间。它看起来可能很傻，也很幼稚……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:348



translate schinese ep12_np_he_label_9485e548:







    # mc "...but it could work."



    mc "但也许能行。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:349



translate schinese ep12_np_he_label_a5d2b77e:







    # mc "The problems usually happen when we interact with them."



    mc "问题通常出在我们和他们互动的时候。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:351



translate schinese ep12_np_he_label_edb1e5cc:







    # he "And how will an imaginary barrier prevent you from starting something?"



    he "那道想象中的屏障能阻止你挑起事端吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:353



translate schinese ep12_np_he_label_3a01b0bb:







    # mc "Oh, I'm sure they'll say shit to our faces, but I'm saying no one will fight."



    mc "哦，他们肯定会在我们面前说些难听的话，但我说的是没人会真的动手。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:354



translate schinese ep12_np_he_label_e535cb45:







    # mc "At least none of the DIKs are looking to fight them."



    mc "至少那些DIKs都没打算跟他们动手。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:356



translate schinese ep12_np_he_label_bb6a593d:







    # he "I don't think that goes both ways."



    he "我觉得这事儿可没那么简单。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:358



translate schinese ep12_np_he_label_e1418951:







    # mc "I've been to a party with the alphas before, and I didn't fight them."



    mc "我以前也参加过和阿尔法们一起的聚会，但没跟他们动手。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:360



translate schinese ep12_np_he_label_d88b4af5:







    # el "Exactly. It was our party, and [name] behaved."



    el "没错。那是我们的派对，而[name]表现得很规矩。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:363



translate schinese ep12_np_he_label_bb1029d8:







    # mc "Hm... Behave is a strong word..."



    mc "嗯……“行为得体”这个词用得有点重……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:366



translate schinese ep12_np_he_label_24148985:







    # mc "I think there will be a fight, but I think that's too early for it."



    mc "我觉得可能会有冲突，但我觉得现在还太早了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:368



translate schinese ep12_np_he_label_055b93c3:







    # el "Why are you two so negative?"



    el "你们俩怎么这么消极？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:370



translate schinese ep12_np_he_label_5294e286:







    # mc "I've been to a party with the alphas before."



    mc "我之前也参加过和阿尔法们一起的聚会。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:372



translate schinese ep12_np_he_label_c44a296a:







    # el "Exactly. And you behaved, didn't you?"



    el "没错。你当时也表现得很不赖，不是吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:375



translate schinese ep12_np_he_label_5ae039f2:







    # mc "I made it my mission to make the alphas leave early, so..."



    mc "我打定主意要让那些阿尔法兄弟会的人早点离开，所以……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:377



translate schinese ep12_np_he_label_dd6b8acd:







    # el "What?"



    el "什么？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:379



translate schinese ep12_np_he_label_d6da77e1:







    # mc "For starters, I pushed Dawe into the pool, had a horny Arieth sic two of them, and I snitched on the dude who passed out in Heather's bed to Heather."



    mc "首先，我推了Dawe进泳池，让Arieth那家伙带两个家伙去搞事情，还把那个在Heather床上晕倒的家伙告发给了Heather。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:381



translate schinese ep12_np_he_label_0219118b:







    # he "Yeah, I remember that. It was Jimmy."



    he "嗯，我记得。那是Jimmy。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:384



translate schinese ep12_np_he_label_13c3124e:







    # el "Aha, I see how it is. You know you will start a fight tonight, and that's why you're so negative."



    el "啊，我明白了。你清楚今晚你会挑起事端，所以你现在这么消极。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:386



translate schinese ep12_np_he_label_b363179c:







    # mc "I don't start things. I finish them."



    mc "我从不挑事，我只收尾。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:388



translate schinese ep12_np_he_label_ddb7b63b:







    # el "Listen here, macho man. I'll be on you like a hound tonight if I get a whiff of you starting or finishing anything."



    el "听着，硬汉。如果你今晚敢动什么歪脑筋，我立马像猎犬一样扑上来。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:391



translate schinese ep12_np_he_label_ee5b868b:







    # mc "What I'm saying is that there are ways to fuck with them without turning it into a fight."



    mc "我的意思是说，有办法让他们吃点苦头，又不至于闹到打架。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:393



translate schinese ep12_np_he_label_e97482e9:







    # el "Listen here, fuck boy. I'll be on you like a hound tonight if I get a whiff of you starting anything."



    el "听好了，混蛋。如果今晚我闻到你有任何动作，我就会像猎犬一样扑上来。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:395



translate schinese ep12_np_he_label_6f6ec8ef:







    # el "That goes for you, too."



    el "这话说得也适用于你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:397



translate schinese ep12_np_he_label_9a7cbbd5:







    # he "What would I even start?"



    he "我连从哪儿开始都不知道。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:399



translate schinese ep12_np_he_label_6d101a1a:







    # el "Just be mindful."



    el "小心点。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:402



translate schinese ep12_np_he_label_b64f6e5f:







    # mc "It took all my willpower, but I did."



    mc "我费了老大的劲才没做出来。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:405



translate schinese ep12_np_he_label_461570e8:







    # el "See! That makes it possible for you to behave tonight, too."



    el "看吧！这样你今晚也能表现得像个样儿。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:407



translate schinese ep12_np_he_label_cc9739ff:







    # mc "It's not me you should worry about. It's the rest of my brothers."



    mc "你不用担心我，该担心的是我其他兄弟们。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:408



translate schinese ep12_np_he_label_15c3eee8:







    # mc "Collectively... There's a chance something will happen."



    mc "集体行动的话……事情可能会发生。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:410



translate schinese ep12_np_he_label_d007d85a:







    # el "Then, I think the three of us should work together to prevent that from happening."



    el "那我们就三个一起想办法，阻止这种事情发生。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:413



translate schinese ep12_np_he_label_b20bfdf7:







