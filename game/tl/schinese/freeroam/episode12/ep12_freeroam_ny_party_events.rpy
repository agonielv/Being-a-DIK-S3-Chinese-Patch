    sa "他确实说了。我当时觉得他炫耀这件事挺奇怪的，但后来突然就明白了……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3476



translate schinese ep12_np_smc_label_a475b9cd:







    # sa "I seriously think he likes you."



    sa "我真的觉得他喜欢你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3478



translate schinese ep12_np_smc_label_1ebc3b18:







    # mc "It took him a while to get there, but I think so, too."



    mc "他花了不少时间才到这一步，但我也是这么想的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3479



translate schinese ep12_np_smc_label_0fedd334:







    # mc "I'm coming around on him as well."



    mc "我也是这么想的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3481



translate schinese ep12_np_smc_label_36cdb407:







    # sa "How so?"



    sa "怎么个意思？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3483



translate schinese ep12_np_smc_label_f5f9fc8d:







    # mc "I can't tell you. It's a DIK secret code thing."



    mc "我不能告诉你。这是DIK的秘密暗号。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3485



translate schinese ep12_np_smc_label_b796b8ac:







    # sa "*{i}Whispers{/i}* How is it about his diabetes?"



    sa "*{i}耳语{/i}* 他的糖尿病怎么样了？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3487



translate schinese ep12_np_smc_label_9a81f48d:







    # mc "You know about it?"



    mc "你知道这件事？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3489



translate schinese ep12_np_smc_label_9a9c553f:







    # sa "Heather told me. She worries about him a lot."



    sa "Heather告诉我的。她很担心他。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3490



translate schinese ep12_np_smc_label_53bb1117:







    # sa "When they were together, she took care of him more than you'd think."



    sa "在一起的时候，她照顾他的程度可比你想象的要多。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3491



translate schinese ep12_np_smc_label_898cde4d:







    # sa "It was how they got together."



    sa "他们是怎么在一起的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3493



translate schinese ep12_np_smc_label_a743d01f:







    # mc "I didn't know about it until recently."



    mc "我直到最近才知道这件事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3495



translate schinese ep12_np_smc_label_ad43dac1:







    # sa "For real?"



    sa "真的假的？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3497



translate schinese ep12_np_smc_label_f6c28f10:







    # mc "Yeah. He had collapsed on the bathroom floor, and I found him in there."



    mc "嗯。他晕倒在浴室地板上，我是在那儿找到他的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3498



translate schinese ep12_np_smc_label_64d001dd:







    # mc "It could have ended badly."



    mc "这可能以糟糕的方式结束。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3500



translate schinese ep12_np_smc_label_126c6273:







    # sa "No wonder he likes you then."



    sa "难怪他喜欢你啊。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3502



translate schinese ep12_np_smc_label_0b6f138f:







    # mc "There's more to it than that. We talked after and have been bonding well this last month or so."



    mc "还有别的原因。我们谈过之后，最近一个月相处得挺好的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3504



translate schinese ep12_np_smc_label_c36d0486:







    # sa "I'm glad he's alright. I'm not gonna tell Heather that it happened. She'd freak out."



    sa "很高兴他没事。我不会把这事告诉Heather，她会吓坏的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3506



translate schinese ep12_np_smc_label_1c4081cf:







    # mc "Does she still care about him?"



    mc "她还关心他吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3508



translate schinese ep12_np_smc_label_197a540d:







    # sa "She pretends she doesn't, but she does."



    sa "她假装不在乎，其实心里还是放不下的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3509



translate schinese ep12_np_smc_label_68973c9f:







    # sa "The problem is that he doesn't feel the same. Or if he does, he doesn't show it."



    sa "问题是他感觉不到同样的东西。或者就算他感觉到了，也不会表现出来。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3511



translate schinese ep12_np_smc_label_fb4efd8e:







    # mc "He can be a shut book at times."



    mc "他有时候就是个闷葫芦。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3513



translate schinese ep12_np_smc_label_66511c2a:







    # sa "Yeah, but he can't be like that with his girlfriend."



    sa "嗯，但他不能那样对自己的女朋友。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3515



translate schinese ep12_np_smc_label_c0780025:







    # sa "Look at how you are. You talk to me about everything, even when I don't want you to."



    sa "看看你现在这副样子。你什么事情都跟我说，哪怕我根本不想听。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3518



translate schinese ep12_np_smc_label_b1a3b5ec:







    # mc "I try, but it's hard at times."



    mc "我试着去沟通，但有时候真的很困难。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3520



translate schinese ep12_np_smc_label_3f933e81:







    # mc "I don't talk to you about everything..."



    mc "我不会跟你分享所有事情……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3522



translate schinese ep12_np_smc_label_f7159460:







    # sa "Tommy didn't talk about how he felt for Heather at all. I don't think he has that kind of talk in him."



    sa "Tommy根本没跟你说过他对Heather的感觉。我觉得他那种人根本不会说这种话。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3523



translate schinese ep12_np_smc_label_72745483:







    # sa "Heather needs someone more affectionate. But at the same time, she needs someone like Tommy."



    sa "Heather需要一个更会表达爱意的人，但同时她也需要像Tommy这样的人。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3524



translate schinese ep12_np_smc_label_3bbce7fe:







    # sa "So, what can you do?"



    sa "那你能怎么办？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3526



translate schinese ep12_np_smc_label_00618287:







    # mc "Who knows what makes a relationship work out? I couldn't tell you."



    mc "谁知道什么样的关系能长久？我可说不准。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3529



translate schinese ep12_np_smc_label_35d63c3b:







    # sa "You couldn't? What about ours?"



    sa "你连自己的都搞不定？那你们的呢？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3530



translate schinese ep12_np_smc_label_2dd6e315:







    # sa "Can you tell if it will work out?"



    sa "你能看出它会不会成功吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3533



translate schinese ep12_np_smc_label_5d454d41:







    # mc "We'll make it work. I can't see a reason why it wouldn't."



    mc "我们会让它成功的。我看不出有什么理由会失败。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3535



translate schinese ep12_np_smc_label_71565622:







    # sa "You're sweet, but not realistic."



    sa "你挺甜的，但不够现实。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3537



translate schinese ep12_np_smc_label_dc94157a:







    # mc "Why? I didn't enter our relationship thinking that it would fail."



    mc "为什么？我当初进入这段关系的时候，可没想着它会失败。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3539



translate schinese ep12_np_smc_label_0404a76a:







    # sa "Neither did I, but couples break up for all kinds of reasons."



    sa "我也没想过，但情侣分手的原因有很多种。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3540



translate schinese ep12_np_smc_label_1b686eb7:







    # sa "Let's not be naive and promise each other forever afters. Because you never know."



    sa "别傻乎乎地许下永远的承诺，因为谁也说不准会发生什么。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3542



translate schinese ep12_np_smc_label_fce9e52f:







    # mc "(Maybe it has something to do with her parents' divorce...)"



    mc "（也许和她父母离婚的事有关……）"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3544



translate schinese ep12_np_smc_label_413169ef:







    # mc "Well, I say we have a near 100%% chance to make it work then."



    mc "那我看，我们有将近100%%的把握能成功。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3546



translate schinese ep12_np_smc_label_db2ffca3:







    # sa "*{i}Smack{/i}*"



    sa "*{i}一巴掌{/i}*"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3550



translate schinese ep12_np_smc_label_816c1735:







    # mc "I can't tell you that either. But I like what we have."



    mc "我也不告诉你。但我觉得我们现在这样挺好的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3551



translate schinese ep12_np_smc_label_ecdc279e:







    # mc "The sex is amazing, and we have a lot of fun."



    mc "性爱很带感，我们玩得很开心。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3553



translate schinese ep12_np_smc_label_2dd27aee:







    # sa "And that's enough for you?"



    sa "这够你了吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3555



translate schinese ep12_np_smc_label_3a3ad821:







    # mc "It is for now. But I feel we're growing as a couple every day."



    mc "现在就这样吧。但我感觉我们每天都在一起成长。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3556



translate schinese ep12_np_smc_label_92930a03:







    # mc "I'd like to see us in a year from now and see how much we have changed."



    mc "我想看看一年后的我们，看看我们变成了什么样子。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3558



translate schinese ep12_np_smc_label_d1f1c398:







    # sa "I have a feeling next year will be full of challenges and surprises."



    sa "我觉得明年肯定会有不少挑战和惊喜。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3560



translate schinese ep12_np_smc_label_db2ffca3_1:







    # sa "*{i}Smack{/i}*"



    sa "*{i}一巴掌{/i}*"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3563



translate schinese ep12_np_smc_label_dc522db8:







    # mc "No, I can't tell that. But I can tell you that I want to make it work."



    mc "不，我不能说那个。但我可以告诉你，我想让它成功。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3565



translate schinese ep12_np_smc_label_694193df:







    # sa "I like that you have that as an ambition. That makes me feel more confident about you."



    sa "我喜欢你有这个目标，这让我对你更有信心。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3567



translate schinese ep12_np_smc_label_a3a59fd7:







    # mc "Do you have doubts?"



    mc "你有怀疑吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3569



translate schinese ep12_np_smc_label_d84ab827:







    # sa "Yes, but I doubt everything. I've yet to see one relationship up close that stood the test of time."



    sa "是的，但我对一切都不确定。我还没见过一对关系能真正经得起时间的考验。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3571



translate schinese ep12_np_smc_label_6c201d80:







    # mc "(Of course... Her parents' divorce... I'm not gonna push her on this tonight.)"



    mc "（当然……她父母的离婚……我今晚就不逼她了。）"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3573



translate schinese ep12_np_smc_label_413169ef_1:







    # mc "Well, I say we have a near 100%% chance to make it work then."



    mc "那我看，我们有将近100%%的把握能成功。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3575



translate schinese ep12_np_smc_label_db2ffca3_2:







    # sa "*{i}Smack{/i}*"



    sa "*{i}一巴掌{/i}*"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3578



translate schinese ep12_np_smc_label_d4ad37d2:







    # mc "No, I can't."



    mc "不，我不能。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3580



translate schinese ep12_np_smc_label_36c9b587:







    # sa "But you want it to work out, right?"



    sa "但你希望它能成功，对吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3582



translate schinese ep12_np_smc_label_cdb349aa:







    # mc "Uh... I have a great time with you, and you're my girlfriend."



    mc "嗯……和你在一起我很开心，你是我的女朋友。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3583



translate schinese ep12_np_smc_label_e9e42567:







    # mc "That should tell you something."



    mc "这该告诉你点什么了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3585



translate schinese ep12_np_smc_label_df8effb2:







    # sa "You'll have to do better than that. You're not convincing me here."



    sa "你得拿出点真本事来。你现在可一点都不让我信服。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3587



translate schinese ep12_np_smc_label_782e7f28:







    # mc "What do you expect me to say?"



    mc "你指望我说什么？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3589



translate schinese ep12_np_smc_label_b312dc16:







    # sa "It's an easy question, isn't it? Would you rather be single than with me?"



    sa "这问题很简单，不是吗？你宁愿一个人，也不愿和我在一起？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3591



translate schinese ep12_np_smc_label_3772aa1f:







    # mc "With you."



    mc "和你在一起。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3593



translate schinese ep12_np_smc_label_43e9a0da:







    # sa "Ok."



    sa "嗯。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3595



translate schinese ep12_np_smc_label_5b9ea9cf:







    # mc "Was that better?"



    mc "那更好了吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3597



translate schinese ep12_np_smc_label_d84ab827_1:







    # sa "Yes, but I doubt everything. I've yet to see one relationship up close that stood the test of time."



    sa "是的，但我不确定任何事。我还没见过一段关系能经得起时间的考验。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3599



translate schinese ep12_np_smc_label_afd64feb:







    # mc "(Of course... Her parents' divorce...)"



    mc "（当然……她父母的离婚……）"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3601



translate schinese ep12_np_smc_label_d90e9229:







    # mc "Don't overthink it."



    mc "别想太多。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3604



translate schinese ep12_np_smc_label_b3066a55:







    # sa "Yeah, me neither."



    sa "我也这么觉得。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3606



translate schinese ep12_np_smc_label_11f481d2:







    # mc "How have you been lately? I feel like we haven't talked much."



    mc "你最近怎么样？感觉我们最近聊得不多。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3608



translate schinese ep12_np_smc_label_696e333f:







    # sa "I know. I've had a lot on my plate. Christmas, family, preparations for this party, and the next semester..."



    sa "我知道。我最近事情很多，圣诞节、家人、这次聚会的准备，还有下学期……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3610



translate schinese ep12_np_smc_label_d48bd0e3:







    # mc "Yeah, I get it. Things should return to normal once the new semester starts."



    mc "嗯，我懂。等新学期开始一切应该就会恢复正常了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3612



translate schinese ep12_np_smc_label_5d2d5ce1:







    # mc "You ok?"



    mc "你没事吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3614



translate schinese ep12_np_smc_label_f59f0d1a:







    # sa "Hm? Oh, yeah! Totally."



    sa "嗯？哦，对了！完全没问题。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3616



translate schinese ep12_np_smc_label_ab7e95cb:







    # mc "Alright. I'm gonna mingle some more. Maybe someone wants to drink with me."



    mc "好，我再到处走走。说不定有人想和我一起喝点东西。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3618



translate schinese ep12_np_smc_label_0e40f8d5:







    # sa "Have fun!"



    sa "玩得开心点！"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3627



translate schinese ep12_np_s2mc_label_2c29e25b:







    # mc "Hey... Can we talk?"



    mc "嘿……我们能谈谈吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3630



translate schinese ep12_np_s2mc_label_b15c8716:







    # sa "Why? I have nothing to say to you."



    sa "为什么？我没什么好跟你说的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3632



translate schinese ep12_np_s2mc_label_dda96da8:







    # mc "You wanted me to bury the hatchet with Nick tonight."



    mc "你今晚是想让我和Nick和好如初吧。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3633



translate schinese ep12_np_s2mc_label_7aac09f0:







    # mc "Why can't you do the same with me?"



    mc "你为什么就不能对我也这样做呢？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3635



