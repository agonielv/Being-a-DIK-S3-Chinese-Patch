    # mc "Like, in general. You know?"



    mc "比如说，总的来说。你明白吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8984



translate schinese ep12_np2_smc_label_4c7c5da4:







    # sa "Well, everyone can find someone attractive. There's nothing wrong with that..."



    sa "嗯，每个人都会觉得有人有吸引力，这很正常……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8985



translate schinese ep12_np2_smc_label_fd07c0e5:







    # sa "But that's not what you're saying, are you?"



    sa "但这不是你想要表达的意思，对吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8987



translate schinese ep12_np2_smc_label_ec98d2f6:







    # mc "If I'm having these thoughts and urges while I'm in a relationship with you..."



    mc "如果我在和你在一起的时候都会有这些想法和冲动……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8988



translate schinese ep12_np2_smc_label_ade83611:







    # mc "I feel like I'm not ready for our relationship."



    mc "我觉得自己还没准备好开始我们的感情。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8990



translate schinese ep12_np2_smc_label_dfd4bfa9:







    # sa "So, you want to be single and fuck others? Is that what you're saying?"



    sa "所以你是想单身然后跟别人搞？你是这个意思吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8992



translate schinese ep12_np2_smc_label_1ff0787e:







    # mc "Not quite. But..."



    mc "不完全是。但……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8993



translate schinese ep12_np2_smc_label_8b1ed16b:







    # mc "I think we rushed into our relationship. And then I think about the challenges we'd face next year after you quit college."



    mc "我觉得我们太快进入这段关系了。然后我又想到，等你退学后，我们明年要面对的那些挑战。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8994



translate schinese ep12_np2_smc_label_19a47c1d:







    # mc "Combined with all that... Maybe it's for the best if we end it."



    mc "结合了所有这些……也许我们结束吧，这样更好。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8997



translate schinese ep12_np2_smc_label_55a48f61:







    # sa "*{i}Sobs{/i}* I didn't want to make this decision already, [name]."



    sa "*{i}抽泣{/i}* 我没想这么早就做这个决定，[name]。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:8998



translate schinese ep12_np2_smc_label_a393f09e:







    # sa "I know next year will be different, but I still wanted to do this with you."



    sa "我知道明年会不一样，但我想和你一起做这件事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9000



translate schinese ep12_np2_smc_label_a2f1401a:







    # sa "But I can't do that if you want to live like you're single."



    sa "但如果你还想继续当个单身汉，我可没办法这么做。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9001



translate schinese ep12_np2_smc_label_1d7bd70f:







    # sa "Fuck..."



    sa "操..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9003



translate schinese ep12_np2_smc_label_8fa99620:







    # mc "I'm sorry for upsetting you..."



    mc "对不起，让你难过了..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9004



translate schinese ep12_np2_smc_label_79f468a7:







    # mc "I love being together with you. We've had an amazing time and friendship..."



    mc "我喜欢和你在一起的感觉。我们有过很棒的时光和友谊……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9005



translate schinese ep12_np2_smc_label_e7fcdcf2:







    # mc "...but I'm not in love with you, and I don't think I'll get there."



    mc "...但我并不爱你，而且我觉得我可能永远都不会爱上你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9008



translate schinese ep12_np2_smc_label_20e3e427:







    # sa "*{i}Sigh{/i}* I didn't want to think about this for at least another six months, [name]."



    sa "*{i}叹气{/i}* 我本来至少半年内都不想考虑这件事，[name]。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9009



translate schinese ep12_np2_smc_label_4e34fff9:







    # sa "Don't you think I know how hard it will be for us? Of course, I do."



    sa "你难道以为我不知道我们在一起会有多难吗？当然知道。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9010



translate schinese ep12_np2_smc_label_7042a3b8:







    # sa "Everything will change after I graduate."



    sa "一切都会在毕业后改变。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9012



translate schinese ep12_np2_smc_label_76411ee1:







    # sa "But that's not the real issue. You want to live the single life..."



    sa "但那不是真正的问题。你想过单身生活……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9014



translate schinese ep12_np2_smc_label_8fa99620_1:







    # mc "I'm sorry for upsetting you..."



    mc "对不起，让你不开心了..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9015



translate schinese ep12_np2_smc_label_99c20577:







    # mc "I love being together with you. We have an amazing time and friendship..."



    mc "我喜欢和你在一起。我们在一起的时候总是很开心，友情也特别棒……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9016



translate schinese ep12_np2_smc_label_e7fcdcf2_1:







    # mc "...but I'm not in love with you, and I don't think I'll get there."



    mc "但我不爱你，而且我觉得我大概也不会爱上你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9018



translate schinese ep12_np2_smc_label_ae432664:







    # sa "I'm not in love with you either. At least not in that way."



    sa "我也不爱你。至少不是那种爱。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9022



translate schinese ep12_np2_smc_label_c9e2f464:







    # sa "Let's end it then."



    sa "那我们就这样结束吧。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9024



translate schinese ep12_np2_smc_label_d12fe0a9:







    # mc "I think we have to."



    mc "我觉得我们得结束了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9036



translate schinese ep12_np2_smc_label_50e3fc62:







    # mc "What else can I say?"



    mc "还有什么可说的？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9038



translate schinese ep12_np2_smc_label_0429510c:







    # mc "And say what?"



    mc "那还能说什么？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9046



translate schinese ep12_np2_smc_label_2ae8bf56:







    # mc "It looks like you have something on your mind."



    mc "看起来你心里有事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9048



translate schinese ep12_np2_smc_label_24bbfa93:







    # sa "I don't know if it's New Year or if there's something wrong with me, but I think we need to talk."



    sa "我不知道是新年到了，还是我有什么问题，但我觉得我们现在需要谈谈。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9050



translate schinese ep12_np2_smc_label_8f821445:







    # mc "It doesn't feel great when you put it like that."



    mc "听起来这么说感觉不太好。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9052



translate schinese ep12_np2_smc_label_9ef090bb:







    # sa "*{i}Sigh{/i}* It doesn't feel great for me at all, [name]."



    sa "*{i}叹气{/i}* 这让我一点也不好受，[name]。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9053



translate schinese ep12_np2_smc_label_300457dd:







    # sa "Next year will be different for me. I'll graduate and don't know what's next."



    sa "明年对我而言会不一样。我将毕业，不知道之后会怎样。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9055



translate schinese ep12_np2_smc_label_64297ac1:







    # sa "I feel sad when I think about leaving B&R and you, but I need to start thinking about my future."



    sa "想到要离开你和你，我感觉很难过，但我得开始考虑我的未来了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9056



translate schinese ep12_np2_smc_label_e971545f:







    # sa "Your time here has barely begun, and mine is close to an end."



    sa "你在这里的时间才刚刚开始，而我的却快要结束了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9058



translate schinese ep12_np2_smc_label_071211a7:







    # sa "All these questions are whirling around in my head... How will we do it? Can we keep a strong connection after college?"



    sa "这些念头在我脑子里转来转去……我们该怎么走下去？毕业后还能保持这种联系吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9060



translate schinese ep12_np2_smc_label_3c09b643:







    # mc "Anything is possible if we want it."



    mc "只要我们想要，一切皆有可能。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9062



translate schinese ep12_np2_smc_label_c8e4cdca:







    # sa "Yeah... But that's what bothers me."



    sa "嗯... 但正是这一点让我烦。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9063



translate schinese ep12_np2_smc_label_ab251c13:







    # sa "When I think about all of that... I'm not sure how much I want it."



    sa "当我想到所有这些……我不确定我到底想要多少。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9065



translate schinese ep12_np2_smc_label_14f1eec1:







    # mc "The future or me?"



    mc "未来，还是我？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9067



translate schinese ep12_np2_smc_label_e0c430df:







    # sa "Us..."



    sa "我们..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9070



translate schinese ep12_np2_smc_label_f5983591:







    # sa "Everything about you is amazing, but I don't think I can fall in love with you."



    sa "你的一切都很棒，但我感觉我没法爱上你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9071



translate schinese ep12_np2_smc_label_36db1f68:







    # sa "And it's not because I'm not willing to try."



    sa "而且不是因为我不愿意去尝试。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9072



translate schinese ep12_np2_smc_label_000391a5:







    # sa "I'm simply not feeling those feelings for you."



    sa "我就是感觉不到那种感觉。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9073



translate schinese ep12_np2_smc_label_9dbf63c2:







    # sa "There have been times when I thought I was feeling something. Times when I pushed myself to feel something."



    sa "我也有过觉得自己在感受什么的时候。也有过逼自己去感受什么的时刻。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9075



translate schinese ep12_np2_smc_label_b1caefe0:







    # sa "But all I felt was love for you as a person. But that's not the same kind of love that I need it to be."



    sa "但我感受到的只是对你这个人的爱。但那不是我需要的那种爱。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9077



translate schinese ep12_np2_smc_label_16b2d833:







    # sa "There's an attraction between us. We have great talks. But that's not enough."



    sa "我们之间确实有吸引力。我们聊得也很好。但这些还不够。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9079



translate schinese ep12_np2_smc_label_a1ae2a46:







    # sa "There's an attraction between us. We have great sex. But that's not enough."



    sa "我们之间确实有吸引力。我们也有很棒的性爱。但那还不够。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9080



translate schinese ep12_np2_smc_label_e673d668:







    # sa "And I don't want to hurt you later by leading you on."



    sa "而且我不想以后让你受伤，因为我一直在撩你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9082



translate schinese ep12_np2_smc_label_3bbb3c68:







    # mc "What you're saying is that you want to break up with me now..."



    mc "你现在的意思是想现在就和我分手吧..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9086



translate schinese ep12_np2_smc_label_f4d11690:







    # mc "*{i}Sigh{/i}*"



    mc "*{i}叹气{/i}*"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9087



translate schinese ep12_np2_smc_label_7f9ca1ce:







    # mc "I get it... Hey, if you don't feel something, you don't."



    mc "我明白了……嘿，如果你没感觉，那就不算。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9089



translate schinese ep12_np2_smc_label_bcb8d5cf:







    # mc "This isn't about Zoey, right?"



    mc "这事儿和Zoey没关系，对吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9091



translate schinese ep12_np2_smc_label_486e0c7d:







    # mc "This isn't about Zoey, right? Because I'm no longer her friend."



    mc "这不是因为Zoey，对吧？毕竟我已经不再是她的朋友了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9093



translate schinese ep12_np2_smc_label_edfd9798:







    # sa "No. She might have been a part of it, but there's much more to it than her."



    sa "不。她可能在其中扮演了角色，但事情远不止她那么简单。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9094



translate schinese ep12_np2_smc_label_d458a6d0:







    # sa "I wish it were different. But I can't force my feelings. It's not true to do that."



    sa "我希望它能不一样。但我不能强迫自己的感情。那样做不真实。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9096



translate schinese ep12_np2_smc_label_667fb2cc:







    # mc "You need to stay true to yourself, then..."



    mc "你得坚持做自己，然后..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9098



translate schinese ep12_np2_smc_label_56573741:







    # sa "You have no idea how hard this is for me."



    sa "你根本不知道这对我来说有多难。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9099



translate schinese ep12_np2_smc_label_7b86ce3e:







    # sa "But at the same time, I don't want to go on for another six months knowing this has to happen."



    sa "但与此同时，我也不想再过六个月，明知这一切迟早会发生。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9101



translate schinese ep12_np2_smc_label_3fdc9d1d:







    # mc "I can tell something has weighed on your mind lately. You haven't been present."



    mc "我能感觉到最近有什么事压在你心里。你一直不在状态。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9103



translate schinese ep12_np2_smc_label_af0a443c:







    # sa "Please, don't hate me."



    sa "请别恨我。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9105



translate schinese ep12_np2_smc_label_94b25377:







    # mc "Sage... I could never hate you."



    mc "Sage……我永远不可能恨你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9106



translate schinese ep12_np2_smc_label_62e52414:







    # mc "But this makes it difficult for me, because I feel something different for you."



    mc "但这让我很难受，因为我对你有了不一样的感觉。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9108



translate schinese ep12_np2_smc_label_49d9b7ba:







    # sa "I talked to Zoey tonight...and she told me you're staying friends."



    sa "我今晚跟Zoey聊了聊……她跟我说你打算继续当朋友。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9110



translate schinese ep12_np2_smc_label_526a434b:







    # mc "Yeah... I was planning to talk to you about that."



    mc "嗯……我本来打算和你谈谈这个事的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9112



translate schinese ep12_np2_smc_label_b8b8d2bb:







    # sa "I'm sure you were. But it doesn't matter to me, [name]..."



    sa "你肯定这么想过的。但对我来说没关系，[name]..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9113



translate schinese ep12_np2_smc_label_165a0446:







    # sa "I already know how I feel about it."



    sa "我已经知道自己是怎么想的了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9115



translate schinese ep12_np2_smc_label_1b99def6:







    # sa "And if you respected me and my feelings enough, this wouldn't be the case."



    sa "如果你真的尊重我以及我的感受，事情就不会变成这样。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9116



translate schinese ep12_np2_smc_label_be8e1274:







    # sa "I can't stay in this relationship with you any longer."



    sa "我不能再和你继续这样下去了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9118



translate schinese ep12_np2_smc_label_9c489347:







    # mc "What? I thought you said my friendship with Zoey wasn't an ultimatum."



    mc "什么？我刚才明明说你和Zoey的友谊不是最后通牒。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9120



translate schinese ep12_np2_smc_label_d88a7bed:







    # sa "It wasn't. But I know myself..."



    sa "它不是。但我了解自己……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9121



translate schinese ep12_np2_smc_label_8b93cec6:







    # sa "I won't be able to stand for it. She's already proven my point, and you choosing to stay friends with her after what she did..."



    sa "我受不了了。她已经证明了我的观点，而你选择在她做了那些事之后还跟她保持朋友关系……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9123



translate schinese ep12_np2_smc_label_1cbdeb4b:







    # sa "It hurts. Her telling you that she loved you hurt. And you brushing that off like it's nothing hurts even more."



    sa "这很伤人。她告诉你她爱你，这已经够伤了。而你却像那件事根本不存在一样敷衍过去，这伤得更厉害。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:9124



translate schinese ep12_np2_smc_label_7f035f96:







    # sa "And I get it, you value her friendship a lot. It's clear."



    sa "我明白，你很重视她的友谊。这很明显。"







