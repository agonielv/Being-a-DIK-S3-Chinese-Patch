    mc "我不记得了。大概没有吧。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12533
translate schinese ep12_np2_ot_label_485c4b9c:

    # mc "No, I didn't."
    mc "不，我没有。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12535
translate schinese ep12_np2_ot_label_f20d6d22:

    # osc "Yes, you did! Fucking admit it."
    osc "你明明就有！他妈的承认吧。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12537
translate schinese ep12_np2_ot_label_b8e3eeed:

    # ta "Stop it, Oscar. Let it go!"
    ta "住手，Oscar。算了吧！"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12539
translate schinese ep12_np2_ot_label_1fe5fc2b:

    # mc "I don't think so."
    mc "我可不这么觉得。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12542
translate schinese ep12_np2_ot_label_b8e3eeed_1:

    # ta "Stop it, Oscar. Let it go!"
    ta "住手，Oscar。算了吧！"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12544
translate schinese ep12_np2_ot_label_3c1b7da8:

    # ta "It was just a kiss, Oscar. Let it go!"
    ta "只是亲了一下而已，Oscar。算了吧！"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12546
translate schinese ep12_np2_ot_label_ecade893:

    # osc "One of these days, I'm going to fuck someone you like."
    osc "总有一天，我也要去上一个你喜欢的人。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12548
translate schinese ep12_np2_ot_label_decd2d7c:

    # mc "This is my friend, Derek. I like him."
    mc "这是我朋友Derek，我挺喜欢他的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12550
translate schinese ep12_np2_ot_label_eaf3f4a5:

    # de "You stay far away from my butthole, Oscar."
    de "离我的屁眼远点，Oscar。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12552
translate schinese ep12_np2_ot_label_b6cdefe2:

    # de "Dude, you made him cry."
    de "哥们儿，你把他弄哭了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12555
translate schinese ep12_np2_ot_label_58749121:

    # mc "You didn't have to drink, Tara."
    mc "Tara，你没必要喝酒的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12557
translate schinese ep12_np2_ot_label_d19cd558:

    # ta "With what we did together, I didn't drink enough."
    ta "想到我们一起干的事，我喝得还远远不够。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12560
translate schinese ep12_np2_ot_label_9fe417a1:

    # mc "Are you guys back together?"
    mc "你们复合了？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12562
translate schinese ep12_np2_ot_label_894e49ef:

    # ta "We're not, but you know how it is..."
    ta "没有，不过你也知道是怎么回事……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12565
translate schinese ep12_np2_ot_label_709915e5:

    # mc "Oh, well... You know where to find me."
    mc "好吧……你知道去哪里找我。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12567
translate schinese ep12_np2_ot_label_6b2e55df:

    # mc "Oh, well..."
    mc "好吧……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12572
translate schinese ep12_np2_ot_label_15f6a8c9:

    # mc "Why did you tell him we had sex? We never did."
    mc "你为什么告诉他我们上过床？我们根本没做过。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12574
translate schinese ep12_np2_ot_label_c9dfe7e8:

    # ta "We did, but you don't know it. At the dorm party..."
    ta "做过，只是你不知道。就在宿舍派对上……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12576
translate schinese ep12_np2_ot_label_a9ad0313:

    # mc "Oh... That was you?"
    mc "哦……那个人是你？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12580
translate schinese ep12_np2_ot_label_18da5624:

    # de "How do you have sex with someone without knowing it? What kind of a game are you playing here, [mc_de]?"
    de "你怎么可能和人上了床却不知道？你到底在玩什么游戏，[mc_de]？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12583
translate schinese ep12_np2_ot_label_8438c874:

    # ta "I shouldn't have kissed you... Now he's all pissed for no good reason."
    ta "我当时不该亲你的……现在他毫无理由地气成这样。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12591
translate schinese ep12_np2_elena_label_a76f2a18:

    # el "[name]... Can you help me out with something?"
    el "[name]……能帮我一个忙吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12593
translate schinese ep12_np2_elena_label_7a67e007:

    # mc "What do I have to carry?"
    mc "要我搬什么？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12595
translate schinese ep12_np2_elena_label_b595a791:

    # el "Why did you assume you had to carry something? Because I'm a woman?"
    el "你为什么认定是让我搬东西？因为我是女人吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12597
translate schinese ep12_np2_elena_label_9ce5bb9d:

    # mc "Oh, not at all. Because that's all I've been helping out with tonight."
    mc "当然不是。只是今晚别人找我帮忙，全都是搬东西。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12599
translate schinese ep12_np2_elena_label_49290143:

    # el "It's nothing like that."
    el "这次不是那种事。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12600
translate schinese ep12_np2_elena_label_d9df1f16:

    # el "I've promised to do something for John Boy, and I wanted to check if you're up for it."
    el "我答应替John Boy做件事，想先问问你愿不愿意。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12602
translate schinese ep12_np2_elena_label_2ddadd7d:

    # mc "Does it have anything to do with what we did together at the panty party?"
    mc "跟我们在内裤派对上一起做过的事有关吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12604
translate schinese ep12_np2_elena_label_fca6c05d:

    # el "You saved me from awkwardly beating around the bush."
    el "你替我省去了尴尬地绕圈子。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12605
translate schinese ep12_np2_elena_label_8545f93a:

    # el "Would you be interested in that?"
    el "你有兴趣吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12608
translate schinese ep12_np2_elena_label_738ae9ff:

    # mc "I can't. I have a girlfriend now."
    mc "不行，我现在有女朋友了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12610
translate schinese ep12_np2_elena_label_ff1bba0e:

    # el "I thought so. I wasn't 100%% sure that was the case, but I suspected it."
    el "我就猜到了。之前不能 100%% 确定，但一直有这个感觉。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12612
translate schinese ep12_np2_elena_label_dc6169c1:

    # mc "If things were different, my answer might have been too."
    mc "如果情况不同，我的回答可能也会不同。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12614
translate schinese ep12_np2_elena_label_b6d3242c:

    # el "The question is always free, isn't it? Thanks for not making a big deal out of it."
    el "问一句又不要钱，对吧？谢谢你没把这事搞得很尴尬。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12616
translate schinese ep12_np2_elena_label_f15cde78:

    # mc "I would never."
    mc "我绝不会那么做。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12618
translate schinese ep12_np2_elena_label_10105fd5:

    # mc "Tonight?"
    mc "今晚？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12620
translate schinese ep12_np2_elena_label_bf51b0e8:

    # el "Yes."
    el "对。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12622
translate schinese ep12_np2_elena_label_059140cc:

    # mc "Can I think about it?"
    mc "能让我考虑一下吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12624
translate schinese ep12_np2_elena_label_7b85c921:

    # el "If we're doing it, we'll do it after midnight."
    el "如果要做，我们会在午夜之后做。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12626
translate schinese ep12_np2_elena_label_98f3663d:

    # mc "And by it, you mean...\"it\"?"
    mc "你说的“做”，就是……“那个”？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12628
translate schinese ep12_np2_elena_label_c0ca9331:

    # el "*{i}Nervous chuckle{/i}* Yes. It."
    el "*{i}紧张地轻笑{/i}* 对，就是那个。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12630
translate schinese ep12_np2_elena_label_8eaaea9f:

    # mc "Like last time?"
    mc "像上次一样？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12632
translate schinese ep12_np2_elena_label_e5c6bf4d:

    # el "No. This time it would be just you and me, and he'd be watching us."
    el "不。这次只有你和我，他会在旁边看着。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12634
translate schinese ep12_np2_elena_label_b7b32389:

    # mc "He wants that?"
    mc "他想看这个？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12636
translate schinese ep12_np2_elena_label_6ed08bd9:

    # el "It's his top fantasy since like forever."
    el "这一直都是他最想实现的幻想。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12637
translate schinese ep12_np2_elena_label_5c500b31:

    # el "If you want to be a part of that, let me know. It would be a surprise to him from me."
    el "你要是愿意加入就告诉我。我想把它当成给他的惊喜。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12649
translate schinese ep12_np2_mjmc_label_4eeb05ed:

    # js "So, next semester, I'll stop paying for my dorm then."
    js "那我下学期就不再交宿舍费了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12654
translate schinese ep12_np2_mjmc_label_3f28a125:

    # my "Yeah. I think you should. Thank you so much for doing that all this time."
    my "嗯，我觉得你应该这么做。真的谢谢你一直替我付到现在。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12655
translate schinese ep12_np2_mjmc_label_ad6e1398:

    # my "I know I haven't thanked you enough for it."
    my "我知道自己一直没好好感谢过你。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12660
translate schinese ep12_np2_mjmc_label_05121fdc:

    # js "You should come live with us."
    js "你应该搬来和我们一起住。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12665
translate schinese ep12_np2_mjmc_label_3c7b842f:

    # my "*{i}Sigh{/i}* I don't know... It's a big decision."
    my "*{i}叹气{/i}* 我不知道……这是个重大的决定。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12670
translate schinese ep12_np2_mjmc_label_6754d82a:

    # js "Like we haven't already made big decisions tonight."
    js "今晚我们做过的重大决定还少吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12675
translate schinese ep12_np2_mjmc_label_ebef71dc:

    # my "Yeah... What is it about New Year's Eve that makes you want to make those?"
    my "是啊……跨年夜到底有什么魔力，让人总想做这种决定？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12676
translate schinese ep12_np2_mjmc_label_a7c69f9e:

    # my "You could change on a Thursday if you wanted to. Yet, life-changing decisions are often made today."
    my "你想改变的话，随便一个星期四也能改变。可偏偏大家总爱在今天做出改变人生的决定。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12687
translate schinese ep12_np2_mjmc_label_593ea39a:

    # js "In our case, I think it's more of a coincidence. Wouldn't you agree?"
    js "对我们来说，我觉得只是巧合。你不这么认为吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12693
translate schinese ep12_np2_mjmc_label_694bb7a3:

    # mc "Alright, what is it you needed to talk to me about?"
    mc "好吧，你们到底想跟我谈什么？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12698
translate schinese ep12_np2_mjmc_label_f969ff7c:

    # my "[name]..."
    my "[name]……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12699
translate schinese ep12_np2_mjmc_label_67efb240:

    # my "*{i}Sigh{/i}* There's no easy way to start this conversation with you."
    my "*{i}叹气{/i}* 这场谈话怎么开头都不会轻松。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12700
translate schinese ep12_np2_mjmc_label_d4635f78:

    # my "You might feel like it's sudden, but you should know that it's been in the air for months. And Josy and I have been talking over the last few weeks about it."
    my "你可能觉得很突然，但这件事其实已经酝酿了几个月。过去几周，Josy和我一直在谈这件事。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12701
translate schinese ep12_np2_mjmc_label_ccc4eb8e:

    # my "More than we ever did before. We've pretty much let it all out."
    my "我们从没像这次一样谈得这么深入，几乎把一切都说开了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12706
translate schinese ep12_np2_mjmc_label_c77bfb14:

    # mc "Let what out?"
    mc "把什么说开了？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12711
translate schinese ep12_np2_mjmc_label_152ea358:

    # js "Our thoughts and feelings..."
    js "我们的想法和感受……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12712
translate schinese ep12_np2_mjmc_label_841bd0ab:

    # js "We've been completely unfiltered. And it's been draining, but also good for us."
    js "我们彻底敞开了心扉。过程让人筋疲力尽，但对我们也有好处。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12713
translate schinese ep12_np2_mjmc_label_a308ba1f:

    # js "I feel like it's the first time Maya has truly heard what I had to say. And I understand her better now too."
    js "我觉得Maya第一次真正听懂了我想说的话，而我现在也更理解她了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12718
translate schinese ep12_np2_mjmc_label_491134ab:

    # my "You see, while we are three in this relationship, at times it has felt like we weren't."
    my "你看，虽然这段关系里有三个人，但有时感觉并非如此。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12719
translate schinese ep12_np2_mjmc_label_4574c64c:

    # my "Sometimes, it's been us three, then it's been you and I, or you and Josy, but rarely just Josy and I."
    my "有时是我们三个人，有时是你和我，或者你和Josy，却很少只有Josy和我。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12724
translate schinese ep12_np2_mjmc_label_da4cabd2:

    # js "And with everything that has been going on in our lives as of late, it was clear that Maya and I needed to talk without you."
    js "最近我们的生活里发生了这么多事，Maya和我显然需要避开你，单独谈一谈。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12729
translate schinese ep12_np2_mjmc_label_c65f74d5:

    # mc "Did I do something wrong?"
    mc "是我做错了什么吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12734
translate schinese ep12_np2_mjmc_label_987eaa3f:

    # my "It wasn't about what you did. It was about what Josy and I didn't do - communicate."
    my "这跟你做过什么无关，而是Josy和我没做到什么——沟通。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12735
translate schinese ep12_np2_mjmc_label_382d2e2b:

    # my "But now we have..."
    my "但现在我们已经谈过了……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12740
translate schinese ep12_np2_mjmc_label_ff8e98d9:

    # js "This will be hard for you to hear..."
    js "接下来的话你会很难接受……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12741
translate schinese ep12_np2_mjmc_label_22d44330:

    # js "...but Maya and I have decided that we want to be friends."
    js "……但Maya和我决定，以后只做朋友。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12746
translate schinese ep12_np2_mjmc_label_11455b53:

    # mc "What?"
    mc "什么？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12751
translate schinese ep12_np2_mjmc_label_778b9596:

    # my "We need a break from each other. There's no other way to put it."
    my "我们需要暂时分开。只能这么说了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12757
translate schinese ep12_np2_mjmc_label_f74459a2:

    # js "Like you know, [name]... You and me, spending time at Mom's place... It felt so good to me."
    js "你也知道，[name]……你和我在妈妈家共度的那段时间……对我来说太美好了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12762
translate schinese ep12_np2_mjmc_label_b6535cfd:

    # js "Then I pictured doing that together with Maya...and it wasn't the same."
    js "可当我想象Maya也在那里时……感觉就不一样了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12763
translate schinese ep12_np2_mjmc_label_b6416e92:

    # js "It would be so much more difficult."
    js "一切会变得困难得多。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12769
translate schinese ep12_np2_mjmc_label_1805dfd9:

    # my "Picturing our relationship with just you and me in it, [name]..."
    my "想象这段关系里只有你和我，[name]……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12770
translate schinese ep12_np2_mjmc_label_1c87a8fe:

    # my "It made me feel things I believed I wasn't allowed to feel."
    my "这让我产生了一些曾经以为自己不该有的感受。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12775
translate schinese ep12_np2_mjmc_label_b839c432:

    # my "And I also saw how you would fit well in with my family, and all my problems would be solved just like that..."
    my "我也发现你会很好地融入我的家庭，所有问题仿佛一下子就解决了……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12778
translate schinese ep12_np2_mjmc_label_3cb33e0b:

    # js "Let's face it, our parents will never be ok with our relationship."
    js "面对现实吧，我们的父母永远不会接受我们的关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12783
translate schinese ep12_np2_mjmc_label_57e6902b:

    # mc "Well, that's not news. We all share that issue with our parents and our relationship."
    mc "这个问题又不是今天才知道。我们三个人的父母都无法接受这段关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12784
translate schinese ep12_np2_mjmc_label_71e2c03c:

    # mc "What happened to trying to be together despite that?"
    mc "那我们之前说好不顾这些也要在一起，又算什么？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12789
translate schinese ep12_np2_mjmc_label_493e350e:

    # my "We know... But we're not sure we are in love with each other anymore."
    my "我们知道……但我们不确定彼此是否还相爱。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12790
translate schinese ep12_np2_mjmc_label_5ae801b3:

    # my "And we're not willing to risk our families when we feel that way."
    my "既然是这种感觉，我们不愿意拿自己的家庭去冒险。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12795
translate schinese ep12_np2_mjmc_label_54a311d7:

    # js "I think the love we once felt for each other has turned into a very beautiful friendship..."
    js "我想，我们曾经对彼此的爱已经变成了一段非常美好的友谊……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12796
translate schinese ep12_np2_mjmc_label_0823b0cb:

    # js "But it's no longer about lust and desire."
    js "但那已经不再是欲望和渴求了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12802
translate schinese ep12_np2_mjmc_label_1a3557dd:

    # js "It's not the same feelings as I've felt for you."
    js "这和我对你的感情完全不同。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12808
translate schinese ep12_np2_mjmc_label_35e07b46:

    # my "Exactly... What I feel for you, [name], is so much different."
    my "没错……我对你的感觉，[name]，真的截然不同。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12813
translate schinese ep12_np2_mjmc_label_4174b411:

    # mc "But... A break from each other? What does that mean?"
    mc "可是……暂时分开？那到底是什么意思？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12818
translate schinese ep12_np2_mjmc_label_1cdc3d19:

    # js "It means we want to find out for sure that it's how we truly feel. And the only way of doing that is to be without each other."
    js "意思是我们想确定自己真正的感受，而唯一的办法就是暂时离开彼此。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12823
translate schinese ep12_np2_mjmc_label_afe04038:

    # mc "You mean we should break up?"
    mc "你们是说要分手？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12828
translate schinese ep12_np2_mjmc_label_1046bdac:

    # my "That's not how we'd like to put it..."
    my "我们不想这么称呼它……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12834
translate schinese ep12_np2_mjmc_label_574031e6:

    # mc "But that's what it is, isn't it? If you're not together anymore...you've broken up."
    mc "但事实就是这样，不是吗？你们不再在一起……那就是分手了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12836
translate schinese ep12_np2_mjmc_label_beadd131:

    # mc "But that's what it is, isn't it? If you're not together anymore...you've broken up. How would that make things better?"
    mc "但事实就是这样，不是吗？你们不再在一起……那就是分手了。这又怎么会让事情变好？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12842
translate schinese ep12_np2_mjmc_label_d8d25d9c:

    # mc "And what about the contract, Maya? I thought you'd finally allow yourself to have us as a choice now."
    mc "那份协议呢，Maya？我以为你终于允许自己把我们当成一个选择了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12847
translate schinese ep12_np2_mjmc_label_e9c20664:

    # my "That's true. I can make that choice, and for the first time it's not being forced upon me."
    my "没错。我现在可以自己做选择，而且第一次不是被逼着选择。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12848
translate schinese ep12_np2_mjmc_label_36ff4b52:

    # my "It was us who decided we needed this break. It wasn't Patrick, or Pete, or anyone else. It was us."
    my "是我们自己决定需要暂时分开的。不是Patrick，不是Pete，也不是任何别人，而是我们。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12849
translate schinese ep12_np2_mjmc_label_c88b800b:

    # my "If anything... Staying together now on principle would be for the wrong reasons."
    my "真要说的话……现在仅仅为了坚持而继续在一起，理由反而是错的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12855
translate schinese ep12_np2_mjmc_label_c8dc49b3:

    # mc "And what about me? Don't I have a say in this?"
    mc "那我呢？这件事我没有发言权吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12860
translate schinese ep12_np2_mjmc_label_24ce5383:

    # js "We know this affects you... And therein lies the problem. If it was just about Maya and me, it would have been easier."
    js "我们知道这也会影响你……而问题恰恰就在这里。如果只关系到Maya和我，反而会简单得多。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12869
translate schinese ep12_np2_mjmc_label_7fd52006:

    # mc "Well... If you're honest with me, I have to return the favor..."
    mc "好吧……既然你们对我坦诚，我也必须同样坦诚……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12870
translate schinese ep12_np2_mjmc_label_a386c763:

    # mc "I've had a great time together with you two, and I will always remember the things we did together."
    mc "和你们两个在一起的日子非常美好，我们共同经历的一切，我永远都会记得。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12875
translate schinese ep12_np2_mjmc_label_0deb0f48:

    # mc "I'm fully aware there's been friction between you two, and truth be told... I haven't felt 100%% about our relationship either."
    mc "我完全知道你们之间一直有摩擦。说实话……我对我们的关系也并非 100%% 确定。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12876
translate schinese ep12_np2_mjmc_label_fbfd2ab1:

    # mc "And the more time I've spent at parties - not having to deal with our problems..."
    mc "而且我参加的派对越多——越不用面对我们之间的问题……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12877
translate schinese ep12_np2_mjmc_label_ba7c509a:

    # mc "I felt more relaxed and more like myself."
    mc "我就越放松，也越像真正的自己。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12882
translate schinese ep12_np2_mjmc_label_8291c61a:

    # mc "I can't say if I'd have felt differently if I'd only been in a relationship with one of you..."
    mc "如果我只和你们其中一个交往，我不知道自己的感受会不会不同……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12883
translate schinese ep12_np2_mjmc_label_987684e2:

    # mc "But if you two want a break from each other, I feel like I need one too. From both of you."
    mc "但如果你们想暂时离开彼此，我觉得我也需要休息一下。暂时离开你们两个人。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12889
translate schinese ep12_np2_mjmc_label_77f4667e:

    # js "That's not what I expected to hear, but I don't blame you for it. This whole thing has been a mess, hasn't it?"
    js "这不是我预想中的回答，但我不怪你。这整件事一直乱成一团，对吧？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12894
translate schinese ep12_np2_mjmc_label_38d92aee:

    # mc "Don't say that."
    mc "别这么说。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12899
translate schinese ep12_np2_mjmc_label_0acf6b53:

    # js "But that's what it feels like right now."
    js "可我现在就是这种感觉。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12905
translate schinese ep12_np2_mjmc_label_92d2eb25:

    # my "It makes me sad to hear that you also want a break, but maybe it is for the best."
    my "听到你也想分开，我很难过。但也许这样才是最好的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12908
translate schinese ep12_np2_mjmc_label_22017360:

    # js "It sounds like we're on the same page..."
    js "看来我们想的一样……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12910
translate schinese ep12_np2_mjmc_label_e41c031d:

    # my "Yeah... I guess that's a good thing."
    my "是啊……这大概算是件好事。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12915
translate schinese ep12_np2_mjmc_label_df1dd26c:

    # mc "*{i}Sigh{/i}* I did not expect this tonight..."
    mc "*{i}叹气{/i}* 真没想到今晚会变成这样……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12927
translate schinese ep12_np2_mjmc_label_68809528:

    # js "I know you're in love with Maya."
    js "我知道你爱着Maya。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12935
translate schinese ep12_np2_mjmc_label_0a8b3d3e:

    # mc "I'm in love with you, too..."
    mc "我也爱你……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12940
translate schinese ep12_np2_mjmc_label_e0b43dea:

    # js "*{i}Sigh of relief{/i}* I feel the same way about you."
    js "*{i}如释重负地叹气{/i}* 我对你也是一样的感觉。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12941
translate schinese ep12_np2_mjmc_label_fcd31664:

    # js "I love you, [name]. I really do..."
    js "我爱你，[name]。我真的爱你……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12942
translate schinese ep12_np2_mjmc_label_a7e22493:

    # js "But that makes this so much more difficult."
    js "可这也让事情变得更加艰难。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12949
translate schinese ep12_np2_mjmc_label_527c6d36:

    # js "And that's good, [name]... You two deserve happiness."
    js "这样很好，[name]……你们两个都值得幸福。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12955
translate schinese ep12_np2_mjmc_label_8d7c834c:

    # my "You're in love with Josy, [name]... We both know it."
    my "你爱着Josy，[name]……我们都知道。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12963
translate schinese ep12_np2_mjmc_label_0a8b3d3e_1:

    # mc "I'm in love with you, too..."
    mc "我也爱你……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12968
translate schinese ep12_np2_mjmc_label_4f9ecc06:

    # my "I...love you too, [name]."
    my "我……也爱你，[name]。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12975
translate schinese ep12_np2_mjmc_label_43e53720:

    # my "And I don't blame you for it. It makes sense."
    my "我不会因此怪你，这很合理。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12980
translate schinese ep12_np2_mjmc_label_53b73eef:

    # mc "Where does that leave us?"
    mc "那我们最后会变成什么样？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12985
translate schinese ep12_np2_mjmc_label_befcb0a3:

    # js "We don't expect you to decide right now, but I think you understand where this is heading, [name]."
    js "我们不指望你现在就做决定，但我想你明白事情会走向哪里，[name]。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12990
translate schinese ep12_np2_mjmc_label_a6e77117:

    # mc "You expect me to choose between you two?"
    mc "你们想让我在你们两个人之间选一个？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12991
translate schinese ep12_np2_mjmc_label_2dbf1134:

    # mc "I'm not the one who wants a break. I want to be with both of you."
    mc "想暂时分开的不是我。我想和你们两个人都在一起。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:12996
translate schinese ep12_np2_mjmc_label_edec7fac:

    # my "We know, [name]..."
    my "我们知道，[name]……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13003
translate schinese ep12_np2_mjmc_label_270e0a4d:

    # js "I've had a crush on you too."
    js "我也一直喜欢你。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13005
translate schinese ep12_np2_mjmc_label_49fb2e1d:

    # js "I'm so happy you wanted to come over this weekend."
    js "你愿意这周末过来，我真的很开心。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13006
translate schinese ep12_np2_mjmc_label_9ae8e0e3:

    # js "It's been on my mind every day since you called..."
    js "自从你打电话后，我每天都在想这件事……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13008
translate schinese ep12_np2_mjmc_label_1e5f46f5:

    # js "Well... That feeling split with guilt..."
    js "只是……这种感觉里也夹杂着内疚……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13009
translate schinese ep12_np2_mjmc_label_289eb9a8:

    # js "Because of..."
    js "因为……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13010
translate schinese ep12_np2_mjmc_label_de83b4e3:

    # js "You know..."
    js "你知道的……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13012
translate schinese ep12_np2_mjmc_label_3ceb1acd:

    # mc "You don't seem happy in that relationship, Josy."
    mc "你在那段关系里似乎并不快乐，Josy。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13013
translate schinese ep12_np2_mjmc_label_ad3bd4d6:

    # mc "I know it's not my thing to say...but you're attracted to me and I'm attracted to you."
    mc "我知道这话不该由我说……但你喜欢我，我也喜欢你。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13014
translate schinese ep12_np2_mjmc_label_63f0168a:

    # mc "I don't want to be the other guy, but look at us right now."
    mc "我不想当第三者，可看看我们现在的样子。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13015
translate schinese ep12_np2_mjmc_label_41e03d00:

    # mc "Don't you want this?"
    mc "难道你不想要这一切吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13016
translate schinese ep12_np2_mjmc_label_4ce170f5:

    # mc "Or am I just here because you're lonely?"
    mc "还是说，我会在这里仅仅因为你太孤单？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13018
translate schinese ep12_np2_mjmc_label_85179e74:

    # js "No...you're not here just because I'm lonely."
    js "不……我让你留下不只是因为孤单。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13019
translate schinese ep12_np2_mjmc_label_69c6683c:

    # js "You're right...I want this, but..."
    js "你说得对……我确实想要，可是……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13020
translate schinese ep12_np2_mjmc_label_c17391f5:

    # js "...it's complicated..."
    js "……事情很复杂……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13021
translate schinese ep12_np2_mjmc_label_a3f53e3b:

    # js "...and I feel like I shouldn't."
    js "……而且我觉得自己不该这样。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13023
translate schinese ep12_np2_mjmc_label_012d9681:

    # mc "Dammit..."
    mc "该死……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13024
translate schinese ep12_np2_mjmc_label_37df8b43:

    # my "Haha. Do you need a hand?"
    my "哈哈，需要帮忙吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13025
translate schinese ep12_np2_mjmc_label_21f8e37c:

    # mc "Oh, hi..."
    mc "哦，嗨……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13027
translate schinese ep12_np2_mjmc_label_d6571be1:

    # my "I don't have a boyfriend."
    my "我没有男朋友。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13028
translate schinese ep12_np2_mjmc_label_c60a2590:

    # my "I tell guys I have a boyfriend because I'm not interested in attracting them."
    my "我告诉那些男生自己有男朋友，是因为我不想引起他们的兴趣。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13029
translate schinese ep12_np2_mjmc_label_577adfa5:

    # my "It may sound weird...but it's the only way that seems to work."
    my "听起来也许很奇怪……但似乎只有这招管用。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13031
translate schinese ep12_np2_mjmc_label_2f70bf77:

    # mc "Ok, so you don't want me to be attracted to you?"
    mc "好吧，所以你不希望我被你吸引？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13033
translate schinese ep12_np2_mjmc_label_67997c25:

    # my "Hey...you promised not to ask any more questions..."
    my "喂……你答应过不再问问题的……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13034
translate schinese ep12_np2_mjmc_label_fc645303:

    # my "..."
    my "……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13036
translate schinese ep12_np2_mjmc_label_11a1c719:

    # my "...but yeah..."
    my "……不过，是的……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13037
translate schinese ep12_np2_mjmc_label_14d25e7a:

    # my "...it would probably be for the best if you weren't."
    my "……如果你没有被我吸引，可能对大家都好。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13040
translate schinese ep12_np2_mjmc_label_2b35b6fe:

    # mc "..."
    mc "……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13041
translate schinese ep12_np2_mjmc_label_8ff69b8f:

    # mc "I think it's too late for that."
    mc "我想现在已经太迟了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13043
translate schinese ep12_np2_mjmc_label_f2d63017:

    # my "Oh..."
    my "哦……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13045
translate schinese ep12_np2_mjmc_label_cf704817:

    # mc "Ok. I'll try."
    mc "好吧，我会努力的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13054
translate schinese ep12_np2_mjmc_label_45e168c7:

    # mc "You know... I've spent so much time and energy on making sure you both felt good. That you both felt loved."
    mc "你知道吗……我花了那么多时间和心力，只为确保你们两个都过得开心，都能感受到被爱。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13055
translate schinese ep12_np2_mjmc_label_fca902f2:

    # mc "And now you're telling me this."
    mc "可现在你们却告诉我这些。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13060
translate schinese ep12_np2_mjmc_label_01f55140:

    # mc "I understand that you're not feeling those feelings for each other, but I love both of you."
    mc "我明白你们对彼此已经没有那种感觉，但我爱你们两个。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13061
translate schinese ep12_np2_mjmc_label_65edbc1c:

    # mc "I love you... So much..."
    mc "我爱你们……爱得那么深……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13062
translate schinese ep12_np2_mjmc_label_801985d8:

    # mc "I'm not choosing, because to me...my love for you two is equal."
    mc "我不会选。因为对我来说……我对你们两个人的爱是一样的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13067
translate schinese ep12_np2_mjmc_label_ac97f428:

    # mc "I don't love you more than I love Josy..."
    mc "我对你的爱并不比对Josy更多……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13072
translate schinese ep12_np2_mjmc_label_8e58cead:

    # mc "And I don't love you more than I love Maya..."
    mc "我对你的爱也不比对Maya更多……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13077
translate schinese ep12_np2_mjmc_label_253515b5:

    # mc "I love us. And if you're telling me that us is not an option..."
    mc "我爱的是我们三个人。如果你们告诉我，“我们”已经不再是选项……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13078
translate schinese ep12_np2_mjmc_label_bda5d177:

    # mc "Then I refuse to choose."
    mc "那我拒绝选择。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13079
translate schinese ep12_np2_mjmc_label_97caf5db:

    # mc "We'll all have a break then."
    mc "我们三个都暂时分开吧。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13084
translate schinese ep12_np2_mjmc_label_56d11963:

    # js "[name]... I know it's hard, but..."
    js "[name]……我知道这很难，可是……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13089
translate schinese ep12_np2_mjmc_label_86e27e87:

    # mc "I can't break either of your hearts. I'd rather break my own."
    mc "我无法伤害你们任何一个。我宁愿伤害自己。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13102
translate schinese ep12_np2_mjmc2_label_2a2808ce:

    # mc "Expecting me to choose between you two is cruel..."
    mc "逼我在你们两个之间选择，真的太残忍了……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13107
translate schinese ep12_np2_mjmc2_label_6693a6cd:

    # my "This whole situation is cruel. I wish we didn't have to put you through it."
    my "整个局面都很残忍。我真希望不用让你经历这些。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13112
translate schinese ep12_np2_mjmc2_label_9e895caf:

    # mc "So, don't..."
    mc "那就别这么做……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13117
translate schinese ep12_np2_mjmc2_label_c9458689:

    # js "You have to try and see it from our perspective, [name]."
    js "你必须试着站在我们的角度看问题，[name]。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13118
translate schinese ep12_np2_mjmc2_label_e4cef572:

    # js "We're both dying to get some sort of normalcy in our lives. A break from everything we've gone through this semester and before that."
    js "我们都渴望生活能恢复一点正常，暂时摆脱这学期乃至更早以前经历的一切。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13123
translate schinese ep12_np2_mjmc2_label_e6d6759f:

    # my "And this relationship that we're in together won't give us that. We need that break."
    my "而我们三个人的这段关系无法给我们这样的生活。我们需要暂停一下。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13128
translate schinese ep12_np2_mjmc2_label_fc230754:

    # mc "But how can I look one of you in the eyes and break up with you? To me, that's not me taking a break from someone..."
    mc "可我怎么可能看着你们其中一个的眼睛说分手？对我来说，那根本不是暂时离开某个人……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13129
translate schinese ep12_np2_mjmc2_label_20b25bbf:

    # mc "That's me putting it out there. That I'd rather be with one over the other."
    mc "而是在公开宣告，我宁愿和另一个人在一起。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13134
translate schinese ep12_np2_mjmc2_label_acd28057:

    # js "It would hurt to hear, yes... But we knew this would hurt even so."
    js "听到这种话当然会很痛……但我们早就知道，无论如何都会受伤。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13139
translate schinese ep12_np2_mjmc2_label_d44e35b5:

    # my "We've been honest with you, [name]. We want you to be honest with us too."
    my "我们已经对你坦诚了，[name]。也希望你能坦诚面对我们。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13145
translate schinese ep12_np2_mjmc2_label_e2f65de8:

    # mc "Josy and I... We've developed something I'm not willing to give up..."
    mc "Josy和我之间……已经建立了我不愿放弃的感情……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13146
translate schinese ep12_np2_mjmc2_label_26f1a020:

    # mc "Maya... I'm so sorry."
    mc "Maya……真的对不起。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13151
translate schinese ep12_np2_mjmc2_label_a5c32921:

    # mc "I hate that you're doing this to me. I hate it."
    mc "我恨你们逼我做这种事。我真的恨。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13156
translate schinese ep12_np2_mjmc2_label_ece8e14f:

    # my "*{i}Sigh{/i}* I understand, [name]... I understand."
    my "*{i}叹气{/i}* 我明白，[name]……我明白。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13171
translate schinese ep12_np2_mjmc2_label_aca07614:

    # mc "I've grown attached to both of you... But I believe I have developed a special bond to Maya."
    mc "我已经深深依恋上你们两个人……但我相信，自己和Maya之间有一种更特别的联系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13172
translate schinese ep12_np2_mjmc2_label_647ec76a:

    # mc "I'm not willing to give that up. I'm so sorry, Josy..."
    mc "我不愿放弃它。真的对不起，Josy……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13177
translate schinese ep12_np2_mjmc2_label_5e89d566:

    # js "It's... It's ok... *{i}Sniffles{/i}*"
    js "没……没关系……*{i}抽泣{/i}*"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13178
translate schinese ep12_np2_mjmc2_label_c0c85d50:

    # mc "It's not ok, Josy..."
    mc "这根本就不是没关系，Josy……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13189
translate schinese ep12_np2_mjmc2_label_6e901075:

    # my "You're in love with Josy, [name]... We both know it. And I don't blame you for it. It makes sense."
    my "你爱着Josy，[name]……我们都知道。我不会因此怪你，这很合理。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13190
translate schinese ep12_np2_mjmc2_label_59c5456b:

    # my "While this is hard, I'm going to make this easy for you, [name]."
    my "虽然这很难受，但我会让你的选择简单一点，[name]。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13191
translate schinese ep12_np2_mjmc2_label_f01c07c7:

    # my "You two belong together. I think it's obvious."
    my "你们两个本来就该在一起，这再明显不过了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13193
translate schinese ep12_np2_mjmc2_label_369e05a0:

    # my "So, I'll leave..."
    my "所以，我会离开……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13195
translate schinese ep12_np2_mjmc2_label_4df15aae:

    # mc "Maya..."
    mc "Maya……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13197
translate schinese ep12_np2_mjmc2_label_e07a3608:

    # my "You'll always have a special place in my heart, [name]. But this is how it has to be."
    my "你在我心里永远都有一个特别的位置，[name]。但事情只能这样了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13199
translate schinese ep12_np2_mjmc2_label_f05663bd:

    # js "I love you, [name]..."
    js "我爱你，[name]……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13201
translate schinese ep12_np2_mjmc2_label_c6d06790:

    # mc "I love you too. And there shouldn't be a \"but\" that follows that sentence, but there is..."
    mc "我也爱你。这句话后面本来不该有一个“但是”，可偏偏就是有……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13203
translate schinese ep12_np2_mjmc2_label_821a7775:

    # js "I know. It's ok."
    js "我知道。没关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13205
translate schinese ep12_np2_mjmc2_label_3173640a:

    # mc "No, it's not ok."
    mc "不，这并不是没关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13219
translate schinese ep12_np2_mjmc2_label_68809528:

    # js "I know you're in love with Maya."
    js "我知道你爱着Maya。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13220
translate schinese ep12_np2_mjmc2_label_527c6d36:

    # js "And that's good, [name]... You two deserve happiness."
    js "这样很好，[name]……你们两个都值得幸福。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13221
translate schinese ep12_np2_mjmc2_label_59e32fe8:

    # js "I'll be the one to say it... [name], you should be with Maya."
    js "那就由我来说吧……[name]，你应该和Maya在一起。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13226
translate schinese ep12_np2_mjmc2_label_11455b53:

    # mc "What?"
    mc "什么？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13231
translate schinese ep12_np2_mjmc2_label_9784819c:

    # js "We could pretend that you and I would make it work one day, but I see the chemistry you share with Maya and I can't compare."
    js "我们可以假装你和我有朝一日能走下去，但我看得到你和Maya之间的默契，我根本比不上。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13232
translate schinese ep12_np2_mjmc2_label_8a87743b:

    # js "She's the one for you. I'm not. And I know she loves you."
    js "她才是适合你的人，我不是。而且我知道她爱你。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13237
translate schinese ep12_np2_mjmc2_label_1689360c:

    # my "I do. I love you, [name]."
    my "是的。我爱你，[name]。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13242
translate schinese ep12_np2_mjmc2_label_c6d06790_1:

    # mc "I love you too. And there shouldn't be a \"but\" that follows that sentence, but there is..."
    mc "我也爱你。这句话后面本来不该有一个“但是”，可偏偏就是有……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13247
translate schinese ep12_np2_mjmc2_label_bf65ac23:

    # js "It's ok."
    js "没关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13252
translate schinese ep12_np2_mjmc2_label_3173640a_1:

    # mc "No, it's not ok."
    mc "不，这并不是没关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13261
translate schinese ep12_np2_mjmc2_label_ce3ba818:

    # js "We both feel that our break extends to you."
    js "我们都觉得，这次分开也应该包括你。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13263
translate schinese ep12_np2_mjmc2_label_11455b53_1:

    # mc "What?"
    mc "什么？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13265
translate schinese ep12_np2_mjmc2_label_b2523d5a:

    # js "We need to be sure what we're feeling, and right now we aren't."
    js "我们需要确定自己的真实感受，可现在我们还不能确定。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13267
translate schinese ep12_np2_mjmc2_label_df5d101f:

    # my "So, we think it's for the best if we all go our separate ways for a while."
    my "所以，我们觉得大家暂时各走各的才是最好的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13268
translate schinese ep12_np2_mjmc2_label_0e65a2d1:

    # my "And if that feels right, well... Then we made the right choice."
    my "如果这样感觉没错……那就说明我们做了正确的选择。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13270
translate schinese ep12_np2_mjmc2_label_dd4da72b:

    # js "And if we feel different, then we'll know that too."
    js "如果感受不同，我们同样会知道答案。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13272
translate schinese ep12_np2_mjmc2_label_fbbb9dad:

    # mc "So... We'll all have a break then."
    mc "所以……我们三个都暂时分开。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13274
translate schinese ep12_np2_mjmc2_label_2144456c:

    # js "[name]... I know it's hard... But can you tell either of us with a straight face that this is working out?"
    js "[name]……我知道这很难……但你能直视我们任何一个人的眼睛，说这段关系现在真的顺利吗？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13276
translate schinese ep12_np2_mjmc2_label_7d4e2ee6:

    # mc "I mean... We've had great times together. We've had amazing sex. And I care so much about both of you."
    mc "我是说……我们一起度过了很多美好时光，做爱也棒极了。我真的非常在乎你们两个。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13278
translate schinese ep12_np2_mjmc2_label_24d2a8c1:

    # my "That's all true... And while I have loved our time together, and I love you as a person... I don't think I'm in love with you."
    my "这些都是真的……我很珍惜我们共度的时光，也爱你这个人……但我不觉得自己爱上了你。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13280
translate schinese ep12_np2_mjmc2_label_e2f7568b:

    # js "And that's what we need to feel sure about."
    js "而这正是我们需要确认的事。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13282
translate schinese ep12_np2_mjmc2_label_2b35b6fe:

    # mc "..."
    mc "……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13296
translate schinese ep12_np2_mjmc2_label_22b2256a:

    # mc "Sorry, but I think I need to be alone..."
    mc "对不起，但我想一个人静一静……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13298
translate schinese ep12_np2_mjmc2_label_53f8b49c:

    # mc "I can't take more of this... I need to be alone."
    mc "我承受不住更多了……我需要一个人待着。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13301
translate schinese ep12_np2_mjmc2_label_05ad94a8:

    # js "We've talked about this for weeks now."
    js "这件事我们已经谈了几个星期。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13303
translate schinese ep12_np2_mjmc2_label_ae2054c2:

    # my "And it's been months in the making."
    my "而且已经酝酿了好几个月。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13304
translate schinese ep12_np2_mjmc2_label_b168a0d6:

    # my "I think we'll have a very beautiful friendship. After all, I feel like that's what we've had as of late."
    my "我想我们会拥有一段非常美好的友谊。毕竟最近这段时间，我们之间其实一直更像朋友。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13306
translate schinese ep12_np2_mjmc2_label_9dcd3bc6:

    # js "..."
    js "……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13308
translate schinese ep12_np2_mjmc2_label_d4bd47b2:

    # js "I feel sad."
    js "我很难过。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13310
translate schinese ep12_np2_mjmc2_label_4f5668d0:

    # my "Me too. But it's the right choice."
    my "我也是。但这是正确的选择。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13311
translate schinese ep12_np2_mjmc2_label_31dde978:

    # my "We keep fighting with each other when it comes to us, but have the best time together when we hang out as a group."
    my "一涉及我们的感情，我们就不停争吵；可作为朋友一起出去玩时，却总是特别开心。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13312
translate schinese ep12_np2_mjmc2_label_a657d47f:

    # my "You deserve more than what I can give you."
    my "你值得得到比我能给你的更多。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13314
translate schinese ep12_np2_mjmc2_label_89376c63:

    # js "And you deserve more than the options you've had to choose between."
    js "你也不该只能在那些选项里为难地选择。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13316
translate schinese ep12_np2_mjmc2_label_fc645303:

    # my "..."
    my "……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13319
translate schinese ep12_np2_mjmc2_label_bde18a06:

    # my "I don't want to give you any false hope. Even if things are different for me in a few years from now..."
    my "我不想给你虚假的希望。就算几年后我的想法变了……"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13320
translate schinese ep12_np2_mjmc2_label_d78e2c04:

    # my "I think this truly is it for us."
    my "我想我们真的到此为止了。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13322
translate schinese ep12_np2_mjmc2_label_cc70754f:

    # js "I know."
    js "我知道。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13324
translate schinese ep12_np2_mjmc2_label_5864c8b8:

    # my "A break then... We finally agreed on something."
    my "那就暂时分开吧……我们终于在一件事上达成了一致。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13326
translate schinese ep12_np2_mjmc2_label_d54166a7:

    # js "Yes, but I wish it wasn't this."
    js "是啊，可我真希望不是这件事。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13330
translate schinese ep12_np2_mjmc2_label_df5407e8:

    # my "We'll get through it together."
    my "我们会一起挺过去的。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13332
translate schinese ep12_np2_mjmc2_label_45128028:

    # js "Haha, I don't think we're supposed to do it that way."
    js "哈哈，我觉得分手后可不该这么做。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13334
translate schinese ep12_np2_mjmc2_label_d02c18ab:

    # my "Let's face it. We've never been normal."
    my "面对现实吧，我们从来就没正常过。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13335
translate schinese ep12_np2_mjmc2_label_cdbb70cc:

    # my "We're different, but there's nothing wrong with that."
    my "我们与众不同，但这没有什么不好。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13340
translate schinese ep12_np2_mjmc2_label_d6c4f927:

    # mc "Look at you two holding hands in public."
    mc "瞧瞧你们两个，居然当众牵着手。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13342
translate schinese ep12_np2_mjmc2_label_fb0f6a74:

    # js "It's not what you think. It's the opposite."
    js "不是你想的那样，正好相反。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13344
translate schinese ep12_np2_mjmc2_label_c3d37e39:

    # mc "What was I thinking?"
    mc "你觉得我想成什么样了？"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13346
translate schinese ep12_np2_mjmc2_label_3645e22a:

    # my "We've decided to take a break from our relationship tonight."
    my "我们今晚决定暂时结束这段关系。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13348
translate schinese ep12_np2_mjmc2_label_d2671a5c:

    # mc "Oh... I'm sorry to hear that."
    mc "哦……听到这个消息，我很遗憾。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13350
translate schinese ep12_np2_mjmc2_label_61634507:

    # js "Don't be. It was the right call for us."
    js "不用遗憾，这是最适合我们的决定。"

# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:13353
