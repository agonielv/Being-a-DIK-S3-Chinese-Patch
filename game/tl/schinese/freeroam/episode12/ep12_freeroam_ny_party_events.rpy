    ja "你的良心现在好受点了吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:818



translate schinese ep12_np_jkey2_label_9c2ab989:







    # mc "It's too early to tell. It felt like crap breaking up with her."



    mc "还太早下结论。跟她说拜拜的感觉糟透了。"







