translate schinese ep12_np_jkey3_label_e9185514:







    # ja "It's been a mix of accusations, curse words, and hate."



    ja "这阵子全是指责、脏话和恨意。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:850



translate schinese ep12_np_jkey3_label_bbe50918:







    # mc "I'm sorry..."



    mc "真抱歉..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:852



translate schinese ep12_np_jkey3_label_6f9e6c84:







    # ja "*{i}Snorts{/i}*"



    ja "*{i}嗤笑{/i}*"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:853



translate schinese ep12_np_jkey3_label_4fb3527e:







    # ja "I don't think she'll ever trust me again. She doesn't even believe me when I tell her the truth."



    ja "我觉得她这辈子都不会再信任我了。她甚至不相信我告诉她真相。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:855



translate schinese ep12_np_jkey3_label_1224be45:







    # mc "It's because you withheld it."



    mc "就是因为你不告诉我。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:857



translate schinese ep12_np_jkey3_label_227d50a0:







    # ja "That, and she believes I don't care about how it affected her. Which I do."



    ja "而且她觉得我不在乎这件事对她造成了什么影响。其实我真的很在乎。"







