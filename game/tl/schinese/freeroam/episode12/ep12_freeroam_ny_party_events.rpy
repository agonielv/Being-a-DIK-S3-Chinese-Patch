    # isa "I was a happy and bubbly girl."



    isa "我那时候是个开心又爱笑的女孩。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3125



translate schinese ep12_np_bmc_label_0ab89f6a:







    # mc "That's a long time ago. You were in college back then."



    mc "那已经是很久以前的事了。那时候你还在上大学。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3127



translate schinese ep12_np_bmc_label_8815cde3:







    # isa "It has nothing to do with age, [name]. It has everything to do with life experiences."



    isa "这与年龄无关[name]这与人生经历息息相关。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3128



translate schinese ep12_np_bmc_label_955e7cb5:







    # isa "Do you know how hard it is to be happy when the world is falling down around you?"



    isa "你知道在世界崩塌的时候，还能保持快乐有多难吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3130



translate schinese ep12_np_bmc_label_f4b2f81c:







    # isa "It takes a certain kind of person to push through the pain and stay true to themselves."



    isa "要能顶住痛苦，还坚持做自己，得是种什么样的人啊。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3131



translate schinese ep12_np_bmc_label_0c6e7087:







    # isa "I want to be that person, but I'm not."



    isa "我想成为那样的人，但我不是。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3132



translate schinese ep12_np_bmc_label_6f6a0ed6:







