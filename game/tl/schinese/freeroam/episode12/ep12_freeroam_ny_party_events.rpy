    # de "I'll gladly receive your thanks after you realize it works, [mc_de]."



    de "我乐意在你意识到它有效后接受你的感谢，[mc_de]."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4636



translate schinese ep12_np2_jd_label_2fbdd6e2:







    # mc "That's funny because Wendy told me you only lasted six minutes with her."



    mc "这很有趣，因为Wendy跟我说你和她只撑了六分钟。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4637



translate schinese ep12_np2_jd_label_7de1d62e:







    # mc "A fact I'm desperately trying to forget."



    mc "一个我拼命想忘掉的事实。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4639



translate schinese ep12_np2_jd_label_3497ae1b:







    # de "This trick only works if you WANT to last longer. With Wendy...hell no."



    de "这个把戏只有当你真想坚持更久的时候才管用。至于Wendy……绝不可能。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4640



translate schinese ep12_np2_jd_label_efce14d2:







    # de "She was only a tad better than the wank you do when donating sperm."



    de "她比你捐精子时那种手淫强点而已。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4642



translate schinese ep12_np2_jd_label_a7b99616:







    # jm "You did that?"



    jm "你干了这事儿？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4644



translate schinese ep12_np2_jd_label_05edc898:







    # de "Someone's gonna carry the Derek genes into the future, and it sure as shit won't be me. Also, I needed the money."



    de "有人会把Derek的基因传下去，那肯定不是我。还有，我需要那笔钱。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4646



translate schinese ep12_np2_jd_label_29c75fca:







    # mc "I'm out of this discussion. Jamie... Don't listen to his advice too much."



    mc "我退出这场讨论了。Jamie……别太听他的建议。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4654



translate schinese ep12_np2_tc_label_327e7902:







    # ch "You shouldn't have come here tonight."



    ch "你今晚不该来这儿。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4656



translate schinese ep12_np2_tc_label_1305b6af:







    # troy "Great to see you too..."



    troy "真高兴见到你啊..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4658



translate schinese ep12_np2_tc_label_de4cc51e:







    # ch "With the threat and all, we can't be seen together."



    ch "有这威胁在，我们可不能被看到一起。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4660



translate schinese ep12_np2_tc_label_9579e394:







    # troy "Don't worry about that, I'm sticking to the DIKs' side of the party."



    troy "别担心，我会站在DIKs那边。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4662



translate schinese ep12_np2_tc_label_128ac847:







    # ch "That doesn't make it better. What if someone's watching you too?"



    ch "这不就更糟了。万一有人在盯着你呢？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4670



translate schinese ep12_np2_tc_label_eeca2f35:







    # mc "Everything ok?"



    mc "一切都好吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4672



translate schinese ep12_np2_tc_label_5f36622c:







    # troy "Chad doesn't want me to talk about it."



    troy "Chad不想让我提这件事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4674



translate schinese ep12_np2_tc_label_3e504c64:







    # mc "What's up with Chad? He told me to fuck off earlier tonight."



    mc "怎么了，Chad？他刚才还让我滚蛋呢。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4675



translate schinese ep12_np2_tc_label_40ba26c3:







    # mc "We're not exactly buddies, but it felt weird."



    mc "我们不算是特别熟，但感觉有点怪。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4677



translate schinese ep12_np2_tc_label_d7515c8d:







    # troy "He got another letter."



    troy "他又收到一封信了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4679



translate schinese ep12_np2_tc_label_5567540b:







    # mc "Another threat?"



    mc "另一个威胁？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4681



translate schinese ep12_np2_tc_label_1124930d:







    # troy "Yeah... Someone doesn't want the two of you to get close."



    troy "有人不想你们俩走得太近。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4683



translate schinese ep12_np2_tc_label_2eed3f79:







    # mc "How would anyone even know about it?"



    mc "怎么有人会知道这些事？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4684



translate schinese ep12_np2_tc_label_7ae3b394:







    # mc "All I've done is send him some texts in private, and we discreetly met once in the library."



    mc "我只给他发过一些私下的短信，我们也在图书馆低调见了一次面。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4686



translate schinese ep12_np2_tc_label_041b2de9:







    # troy "Chad thinks it might be one of the tri-alphas."



    troy "Chad觉得可能是其中一个三兄弟之一。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4688



translate schinese ep12_np2_tc_label_b043fd1d:







    # mc "His brothers?"



    mc "他的兄弟？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4690



translate schinese ep12_np2_tc_label_ac01d5c1:







    # troy "Yeah. Maybe one of them read your texts somehow or followed him to the library."



    troy "嗯，可能是其中一个家伙 不知怎么 看到了你的短信，或者跟着他去了图书馆。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4691



translate schinese ep12_np2_tc_label_2c20726a:







    # troy "Or maybe it was you or your fault."



    troy "或者也许是你或者你的错。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4693



translate schinese ep12_np2_tc_label_a6846c64:







    # mc "It wasn't me, Troy. Is he seriously suspecting me again?"



    mc "不是我，Troy。他不会又在怀疑我吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4695



translate schinese ep12_np2_tc_label_660c6ea0:







    # troy "He's paranoid."



    troy "他就是个疑神疑鬼的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4696



translate schinese ep12_np2_tc_label_1d15399b:







    # troy "*{i}Sigh{/i}* It's not you, right?"



    troy "*{i}叹气{/i}* 不是你干的，对吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4698



translate schinese ep12_np2_tc_label_34c8596c:







    # mc "Hand on my heart. I had nothing to do with it."



    mc "手心贴着胸口。我跟这事一点关系都没有。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4700



translate schinese ep12_np2_tc_label_8c7bb55b:







    # troy "Even if you're not involved, he doesn't want to risk anything."



    troy "就算你没参与，他也不想冒任何风险。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4701



translate schinese ep12_np2_tc_label_33958bec:







    # troy "There's too much at stake for him."



    troy "这对他来说风险太大了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4703



translate schinese ep12_np2_tc_label_9769a3a5:







    # mc "Alright. Let him know what I said."



    mc "好，让他知道我说了什么。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4705



translate schinese ep12_np2_tc_label_05b2e0d9:







    # troy "I will."



    troy "我这就去告诉他你说了什么。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4725



translate schinese ep12_np2_an_label_efcf0b58:







    # an "Ahhh..."



    an "啊啊啊..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4727



translate schinese ep12_np2_an_label_2e5bfc0f:







    # ja "You're not doing what I think you're doing, are you?"



    ja "你可别以为自己在搞什么鬼，对吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4729



translate schinese ep12_np2_an_label_cbd0cf3a:







    # an "The bathroom is on their side of the party. And there was a line to the keg."



    an "洗手间在他们那边的派对区，而且啤酒桶前还排着队。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4731



translate schinese ep12_np2_an_label_fc956727:







    # ja "Put that thing back inside your pants, or I'll have you leave early tonight."



    ja "把那玩意儿收回去，不然今晚你就提前走人。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4732



translate schinese ep12_np2_an_label_7b8e25a2:







    # ja "Either stop your childish fraternal games and use the restroom like a grown-up, or take your business someplace else."



    ja "要么停止你幼稚的兄弟会游戏，像成年人一样去洗手间，要么把你的事带到别处去。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4734



translate schinese ep12_np2_an_label_fc9c13eb:







    # an "Like outside?"



    an "像在外面一样？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4736



translate schinese ep12_np2_an_label_8a6a6d01:







    # ja "*{i}Sigh{/i}* Leave."



    ja "*{i}叹气{/i}* 走吧。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4748



translate schinese ep12_np2_jade_label_9b34857f:







    # mc "Aren't you freezing?"



    mc "你不冷吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4750



translate schinese ep12_np2_jade_label_0e283ec4:







    # ja "It is cold, but peaceful out here."



    ja "这里挺冷的，但挺安静的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4752



translate schinese ep12_np2_jade_label_2fbb0bbe:







    # mc "Are you on a break?"



    mc "你有空吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4754



translate schinese ep12_np2_jade_label_766228d8:







    # ja "Could you imagine that a college party isn't all that fun when you're my age?"



    ja "你能想象吗？到了我们这个年纪，大学派对根本就没那么好玩了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4756



translate schinese ep12_np2_jade_label_6caabb53:







    # mc "I can."



    mc "我可以。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4757



translate schinese ep12_np2_jade_label_897033f5:







    # mc "You didn't have to volunteer. You could have been off doing something more fun."



    mc "你没必要自告奋勇，你完全可以去干点更有趣的事。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4759



translate schinese ep12_np2_jade_label_9e614b1f:







    # ja "Cathy is celebrating with her company, and I wanted to avoid running into Stephen at other parties."



    ja "Cathy和公司的人一起庆祝，我又不想在其他派对碰见Stephen。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4760



translate schinese ep12_np2_jade_label_f860911a:







    # ja "While I'm technically working, this option was the winner for this year."



    ja "严格说来我还在工作，不过今年大家都选了这个方案。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4762



translate schinese ep12_np2_jade_label_cab8bcda:







    # mc "I'm sorry that you've had a rough year."



    mc "真希望你这一年来能好过点。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4764



translate schinese ep12_np2_jade_label_04473717:







    # ja "It couldn't end fast enough."



    ja "这事儿快点结束吧。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4766



translate schinese ep12_np2_jade_label_642134b3:







    # ja "Enough about me and my misery... How about you and yours?"



    ja "够了，别提我的倒霉事了……说说你自己的糟心事吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4768



translate schinese ep12_np2_jade_label_451a61a6:







    # mc "Hah. My misery?"



    mc "哈。我的痛苦？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4769



translate schinese ep12_np2_jade_label_794eaba1:







    # mc "I can't complain."



    mc "我可没抱怨什么。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4772



translate schinese ep12_np2_jade_label_bf845a92:







    # mc "Over the holidays, I got a girlfriend. I wanted to tell you that in person."



    mc "假期的时候我谈了个女朋友。我想当面告诉你这个消息。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4774



translate schinese ep12_np2_jade_label_eca83143:







    # ja "I suppose that's a fitting end to this year."



    ja "这大概就是今年该有的结局了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4776



translate schinese ep12_np2_jade_label_e3784745:







    # mc "I'm sorry. I had a great time with you, but..."



    mc "真抱歉，和你在一起的时光很愉快，但..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4778



translate schinese ep12_np2_jade_label_e2becf04:







    # ja "I understand, [name]."



    ja "我明白，[name]."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4779



translate schinese ep12_np2_jade_label_88e15abc:







    # ja "You were one of the highlights of my year. But it makes sense that you've found someone more age-appropriate."



    ja "你是其中一个让我这一年特别难忘的人。但你找到一个更合适的年龄匹配的人，也挺合理的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4781



translate schinese ep12_np2_jade_label_e90beb83:







    # mc "The age gap was never an issue for me."



    mc "年龄差距对我来说从来就不是问题。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4782



translate schinese ep12_np2_jade_label_c4f8a453:







    # mc "I love this girl, and that's why I can't continue with you."



    mc "我喜欢这个女孩，所以我不能继续和你在一起。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4783



translate schinese ep12_np2_jade_label_1871de7b:







    # mc "I look forward to staying your friend, though."



    mc "我也期待能继续做你的朋友。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4785



translate schinese ep12_np2_jade_label_6f3167da:







    # ja "I look forward to that too."



    ja "我也很期待。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4789



translate schinese ep12_np2_jade_label_607029cb:







    # ja "Get back inside, [name]. Enjoy that party for both of us."



    ja "回屋里去。[name]为我们俩享受那个派对吧。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4795



translate schinese ep12_np2_jade_label_0457b7da:







    # mc "It's been an eventful year. Weird, but eventful."



    mc "这一年过得挺热闹。奇怪，但确实挺热闹的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4797



translate schinese ep12_np2_jade_label_2d022263:







    # ja "And what about your predictions for the next year? Will it be as eventful?"



    ja "那你觉得明年会像今年一样精彩吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4799



translate schinese ep12_np2_jade_label_eb4250b0:







    # mc "I hope I find time for an adventure or two."



    mc "希望我还能有时间来一场或两场冒险。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4801



translate schinese ep12_np2_jade_label_825aaac5:







    # ja "Haha! I bet you will. You seem to have a knack for it."



    ja "哈哈！我打赌你会的。你好像挺有这方面的天赋。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4802



translate schinese ep12_np2_jade_label_58793d0d:







    # ja "What about us? Do you think we'll have a joint adventure?"



    ja "那我们呢？你觉得我们会一起冒险吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4804



translate schinese ep12_np2_jade_label_cb3a4fb6:







    # mc "That depends on you."



    mc "这取决于你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4806



translate schinese ep12_np2_jade_label_0418b93e:







    # ja "You have free will, too."



    ja "你也有自由意志。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4808



translate schinese ep12_np2_jade_label_88d9fddf:







    # mc "And parts of me have a will of their own."



    mc "而我身体的某些部分，也有自己的想法。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4809



translate schinese ep12_np2_jade_label_6542008d:







    # mc "I love the fun we've had together."



    mc "我喜欢和你一起玩的那些乐趣。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4811



translate schinese ep12_np2_jade_label_5614c7ed:







    # ja "As I see it, we could continue doing it. But for every day it goes on, we're casting the die."



    ja "在我看来，我们还能继续下去。但每一天过去，我们就是在掷骰子。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4812



translate schinese ep12_np2_jade_label_6c8bfde4:







    # ja "What happens if we get caught? But also, what happens if we don't?"



    ja "如果我们被抓住了会怎样？但同样，如果我们没被抓住又会怎样？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4814



translate schinese ep12_np2_jade_label_f724a65e:







    # ja "There's no easy answer. There's a logical and convenient answer, and there's a passionate and adventurous one."



    ja "没有简单的答案。有一个逻辑上方便的答案，还有一个充满激情和冒险的答案。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4815



translate schinese ep12_np2_jade_label_febf8d45:







    # ja "Introspection says I should go with the first answer, but every time I talk to you, I lean toward the second one."



    ja "内省告诉我应该选第一个答案，但每次和你说话，我总是倾向于第二个。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:4817



translate schinese ep12_np2_jade_label_e59e3af7:







    # mc "I don't want to stop you if you feel like this has run its course, but I see a lot of potential with you."



