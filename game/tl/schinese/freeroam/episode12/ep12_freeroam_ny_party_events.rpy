# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6600



translate schinese ep12_np2_zu_label_b6785a56:







    # mc "Why are you getting defensive?"



    mc "你为什么这么防备？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6602



translate schinese ep12_np2_zu_label_2ce3c04c:







    # zo "Well, what do you want coming at me like that?"



    zo "那你想干嘛，冲我来这么一嗓子？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6604



translate schinese ep12_np2_zu_label_4b71b7e3:







    # mc "I'm not coming at you. Stop trying to pick a fight."



    mc "我没在挑衅你。别故意找茬。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6606



translate schinese ep12_np2_zu_label_0372604a:







    # zo "..."



    zo "..."







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6608



translate schinese ep12_np2_zu_label_84a23f26:







    # zo "This isn't gonna work, is it?"



    zo "这事儿怕是搞不成了，对吧？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6611



translate schinese ep12_np2_zu_label_162d73bd:







    # zo "I had no other plans for tonight, and I didn't want to spend it alone."



    zo "我今晚本来也没别的安排，不想一个人待着。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6612



translate schinese ep12_np2_zu_label_b54c8f00:







    # zo "I wasn't sure if you were ready to talk."



    zo "我不确定你有没有准备好谈谈。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6614



translate schinese ep12_np2_zu_label_09af6661:







    # mc "Do you feel ready?"



    mc "你感觉准备好了吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6616



translate schinese ep12_np2_zu_label_0fa40d57:







    # zo "Yeah. I know how I feel."



    zo "嗯，我知道自己感觉怎么样。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6617



translate schinese ep12_np2_zu_label_5c93ba58:







    # zo "You may not feel the same, but I want to stay friends."



    zo "你可能不会感觉一样，但我还是想做朋友。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6618



translate schinese ep12_np2_zu_label_23b7097b:







    # zo "That way you'd still be in my life, even if it's not the way I had hoped."



    zo "这样你就算不是以我期望的方式留在我的生活中，至少还能在我生活中出现。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6624



translate schinese ep12_np2_zu_label_ae13fd3e:







    # mc "Not if this is how we talk to each other."



    mc "如果这是我们之间说话的方式，那就不必了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6625



translate schinese ep12_np2_zu_label_f213723b:







    # mc "Let's dial it back."



    mc "我们放低点。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6627



translate schinese ep12_np2_zu_label_8083c248:







    # mc "I still want to be your friend, Zoey."



    mc "我仍然想做你的朋友，Zoey。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6628



translate schinese ep12_np2_zu_label_041b4be3:







    # mc "But we have to find a way that works for both of us."



    mc "但我们要找到一个双方都能接受的方式。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6630



translate schinese ep12_np2_zu_label_ace0bf71:







    # mc "It will be tough, but you mean too much to me."



    mc "这会很难，但你对我来说太重要了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6631



translate schinese ep12_np2_zu_label_11933256:







    # mc "It's because of you that I am who I am today. Well... You and Dad."



    mc "正是因为有你，我才能成为今天的我。嗯……你和我爸。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6632



translate schinese ep12_np2_zu_label_2fab5fe6:







    # mc "I'm willing to give it another shot, but only if you feel the same."



    mc "我愿意再试一次，但只希望你也有同样的感觉。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6635



translate schinese ep12_np2_zu_label_48285d2d:







    # mc "I feel the same. It will be hard, but I still want to be your friend, Zoey."



    mc "我感觉一样。这会很难，但我还是想做你的朋友，Zoey。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6636



translate schinese ep12_np2_zu_label_ccfb1111:







    # mc "You mean so much to me."



    mc "你对我来说意义重大。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6637



translate schinese ep12_np2_zu_label_1e6cca09:







    # mc "It's because of you that I am who I am today."



    mc "正是因为你，我才会成为今天的我。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6638



translate schinese ep12_np2_zu_label_d333be04:







    # mc "Well... You and Dad."



    mc "好吧……你和我爸。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6640



translate schinese ep12_np2_zu_label_4569b716:







    # zo "Friends..."



    zo "朋友……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6642



translate schinese ep12_np2_zu_label_0374506a:







    # mc "Strangers shake hands. Friends hug."



    mc "陌生人握手。朋友拥抱。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6644



translate schinese ep12_np2_zu_label_9e6850c2:







    # zo "Thank you, [name]... Thank you for not giving up on me."



    zo "谢谢，[name]谢谢你没有放弃我。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6646



translate schinese ep12_np2_zu_label_d1e15c16:







    # mc "You were there for me when I was at a low point in my life."



    mc "你在我人生最低谷的时候一直陪着我。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6647



translate schinese ep12_np2_zu_label_d427a169:







    # mc "There's no question about it. I'll be there for you, too."



    mc "这事儿没得说，我也会在你身边的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6648



translate schinese ep12_np2_zu_label_84125b60:







    # mc "We just have to get past this awkward phase. And we will."



    mc "我们只要熬过这个尴尬的阶段就行。而且我们一定能做到。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6653



translate schinese ep12_np2_zu_label_367b66cc:







    # mc "If we can't even be at the same party without fighting, how do you think it will work in college?"



    mc "如果我们连在同一个派对上都忍不住吵架，你觉得在大学里能行吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6655



translate schinese ep12_np2_zu_label_693edc2b:







    # zo "You don't want me to come now?"



    zo "你不想我现在就来吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6657



translate schinese ep12_np2_zu_label_3605711c:







    # mc "That's not what I'm saying."



    mc "那不是我的意思。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6659



translate schinese ep12_np2_zu_label_429190f6:







    # zo "It sounds like it. I'm not going anywhere."



    zo "听起来是这么个情况。我不会走的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6660



translate schinese ep12_np2_zu_label_f21b6d66:







    # zo "If I get accepted, I'm taking that chance. And that's not because of you, it's because of me and my ambitions."



    zo "如果我被录取了，我就会抓住这个机会。这不是因为你的缘故，而是因为我自己的野心和追求。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6662



translate schinese ep12_np2_zu_label_3c515e98:







    # zo "Friend or not, you have to find a way to be cool with that."



    zo "无论朋友与否，你得学会和这事儿和平相处。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6664



translate schinese ep12_np2_zu_label_d5a77d17:







    # mc "We're not gonna be friends anymore, Zoey."



    mc "我们以后就不是朋友了，Zoey。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6665



translate schinese ep12_np2_zu_label_060a42c9:







    # mc "Thank you for everything you did growing up with me."



    mc "谢谢你一直以来陪我长大。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6667



translate schinese ep12_np2_zu_label_68c3fe23:







    # mc "You were a fantastic friend, and I will always remember our friendship."



    mc "你曾是个很棒的朋友，我会永远记得我们的友情。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6668



translate schinese ep12_np2_zu_label_fc2e9dfa:







    # mc "But we have outgrown each other. It's too hard for me to continue having you in my life."



    mc "但我们已经走得太远，彼此都变了。对我来说，继续和你在一起已经太难了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6671



translate schinese ep12_np2_zu_label_2eacdefa:







    # mc "And out of respect to my girlfriends... I think this is for the best."



    mc "并且出于对我的女朋友的尊重……我觉得这样最好。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6673



translate schinese ep12_np2_zu_label_e8d571f9:







    # mc "And out of respect to my girlfriend... I think this is for the best."



    mc "而且为了尊重我的女朋友……我觉得这样最好。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6674



translate schinese ep12_np2_zu_label_dd3630f9:







    # mc "I think we both will be happier without each other."



    mc "我觉得我们分开后，彼此都会更开心。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6676



translate schinese ep12_np2_zu_label_31ba6383:







    # mc "I don't care if you want to stick around or hang out with my friends."



    mc "我不在乎你是否想继续留下或者和我的朋友一起玩。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6677



translate schinese ep12_np2_zu_label_b0c1ec84:







    # mc "You do what you want, but now you know how I feel."



    mc "你爱干啥干啥，现在你该明白我的感受了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6678



translate schinese ep12_np2_zu_label_f29a0f02:







    # mc "Good luck to you."



    mc "祝你一切顺利。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6680



translate schinese ep12_np2_zu_label_3cce0d1b:







    # mc "You're right... I don't feel the same way you do."



    mc "你说得对……我感觉不到你对我的那种感情。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6681



translate schinese ep12_np2_zu_label_0364b773:







    # mc "I don't think I can be your friend anymore, Zoey."



    mc "我觉得我没办法再当你的朋友了，Zoey。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6682



translate schinese ep12_np2_zu_label_060a42c9_1:







    # mc "Thank you for everything you did growing up with me."



    mc "谢谢你一直以来陪我长大。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6684



translate schinese ep12_np2_zu_label_68c3fe23_1:







    # mc "You were a fantastic friend, and I will always remember our friendship."



    mc "你曾是个很棒的朋友，我会永远记得我们的友情。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6685



translate schinese ep12_np2_zu_label_fc2e9dfa_1:







    # mc "But we have outgrown each other. It's too hard for me to continue having you in my life."



    mc "但我们已经走得太远，对我来说，继续让你留在我的生活中太难了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6688



translate schinese ep12_np2_zu_label_2eacdefa_1:







    # mc "And out of respect to my girlfriends... I think this is for the best."



    mc "出于对我的女朋友的尊重……我觉得这样最好。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6690



translate schinese ep12_np2_zu_label_e8d571f9_1:







    # mc "And out of respect to my girlfriend... I think this is for the best."



    mc "而且为了尊重我的女朋友……我觉得这样最好。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6691



translate schinese ep12_np2_zu_label_dd3630f9_1:







    # mc "I think we both will be happier without each other."



    mc "我觉得我们分开后，彼此都会更开心。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6693



translate schinese ep12_np2_zu_label_fd38d359:







    # mc "If you decide to come here to B&R and hang around my friends and such, that's up to you."



    mc "如果你决定来我这儿找B&R，和我朋友混在一起，那随你便。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6694



translate schinese ep12_np2_zu_label_20370204:







    # mc "I wouldn't mind it. You do what you want, but it will be without me."



    mc "我无所谓。你想做什么就做什么，只是别再有我了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6696



translate schinese ep12_np2_zu_label_e1f2d49f:







    # zo "Is that what you want?"



    zo "这是你想要的吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6698



translate schinese ep12_np2_zu_label_0287e7eb:







    # mc "It's what I need."



    mc "这就是我需要的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6699



translate schinese ep12_np2_zu_label_f29a0f02_1:







    # mc "Good luck to you."



    mc "祝你好运。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6716



translate schinese ep12_np2_cg_label_922c6bf4:







    # mc "Did you guys break out the cards?"



    mc "你们拿出来牌了吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6718



translate schinese ep12_np2_cg_label_006d64ff:







    # sa "Why not? You planned for this, but no one cared to play so far."



    sa "为什么不行？你早有打算，但到目前为止没人愿意玩。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6720



translate schinese ep12_np2_cg_label_22075917:







    # mc "I thought people would get bored, but everyone has kept busy eating, dancing, and drinking."



    mc "我以为大家会无聊，但每个人都忙得不可开交，吃喝玩乐都没停过。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6725



translate schinese ep12_np2_cg_label_04b73c98:







    # my "The party has been great, [name]. You should feel proud."



    my "这派对很棒，[name]你应该感到自豪。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6727



translate schinese ep12_np2_cg_label_f21d278d:







    # sa "Yeah, I'm most impressed that you guys didn't fight the tri-alphas. Kudos to you."



    sa "嗯，你们没跟三阿尔法打起来，这点我很佩服。给你们点个赞。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6732



translate schinese ep12_np2_cg_label_21b975d5:







    # de "The line separating us helped a lot."



    de "这道分隔我们的线帮了大忙。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6739



translate schinese ep12_np2_cg_label_6c57cef9:







    # mc "Can I join you?"



    mc "我能加入你们吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6741



translate schinese ep12_np2_cg_label_66a35e4c:







    # mc "Well, have fun! I'm off to drink some more."



    mc "那就好好玩吧！我先去喝点东西了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6749



translate schinese ep12_np2_cg_label_b44d28a2:







    # de "Yeah, we're just getting started."



    de "嗯，我们才刚刚开始。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6754



translate schinese ep12_np2_cg_label_7e6b19fd:







    # my "How do you play this game again?"



    my "这游戏怎么玩啊？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6756



translate schinese ep12_np2_cg_label_26ba9b60:







    # sa "This game is one of my favorites. It's called \"Wrong Questions and Answers\"."



    sa "这游戏是我最喜欢的之一，叫“错题问答”。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6757



translate schinese ep12_np2_cg_label_12e1fb9e:







    # sa "It's a game where you try to be as funny as possible by playing cards that you think will make each other laugh."



    sa "这是一款通过出牌来尽可能搞笑的游戏，你出的牌要让对方笑出来。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6759



translate schinese ep12_np2_cg_label_4db0c973:







    # mc "That sounds fun. Are the rules hard to learn?"



    mc "这听起来挺有意思的。规则难学吗？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6761



translate schinese ep12_np2_cg_label_63066870:







    # sa "Not at all."



    sa "一点都不难。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6763



translate schinese ep12_np2_cg_label_5dd35d80:







    # sa "You get five answer cards in your hand. And you can swap up to three answer cards during the game."



    sa "你手上有五张答案卡，游戏过程中你可以最多交换三张答案卡。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6764



translate schinese ep12_np2_cg_label_9e55aff9:







    # my "Why would I want to swap an answer card?"



    my "为什么我要换一张答案卡？"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6765



translate schinese ep12_np2_cg_label_c6c5510e:







    # sa "Let's say you get a boring answer card. Then you can exchange it."



    sa "比如说你拿到一张无聊的答案卡，那你就可以换掉它。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6767



translate schinese ep12_np2_cg_label_722a2144:







    # sa "Then we take turns reading from a question card."



    sa "然后我们轮流从问题卡上读出问题。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6768



translate schinese ep12_np2_cg_label_b831ff0f:







    # sa "The person who reads the question card is also the judge for that round."



    sa "读问题卡的人同时也是这一轮的评判者。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:6769



translate schinese ep12_np2_cg_label_46d15bb3:







