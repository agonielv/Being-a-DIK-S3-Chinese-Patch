translate schinese ep12_np_jkey2_label_5e08c3ad:







    # mc "My feelings haven't been sorted yet. I don't know what's what."



    mc "我的感觉还没理清楚，我还不知道到底发生了什么。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:821



translate schinese ep12_np_jkey2_label_8d02042c:







    # ja "I'm sorry, [name]. It was my fault."



    ja "对不起，[name]是我的错。"







