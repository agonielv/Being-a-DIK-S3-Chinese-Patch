    isa "我希望还能继续进步。感觉挺好的。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3115



translate schinese ep12_np_bmc_label_74342d8a:







    # isa "In some ways, I feel more like myself than I have in many years."



    isa "在某些方面，我感觉比很多年来的自己更像原来的我了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3116



translate schinese ep12_np_bmc_label_4857e0c4:







    # isa "Even before James left me. Like, before my parents passed away."



    isa "就算在James离开我之前，我也没好过。比如在我父母去世之前，就已经这样了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3118



translate schinese ep12_np_bmc_label_b5c0bcdb:







    # mc "Putting it mildly, you've had it rough..."



    mc "说白了，你过得真不容易……"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3120



translate schinese ep12_np_bmc_label_1ff5ed65:







    # isa "That's an apt description. And it kills me..."



    isa "这描述真是贴切。而且……它把我给杀了。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3121



translate schinese ep12_np_bmc_label_e7be2979:







    # isa "Before all of that. Before James disappeared, before my parents died, I was so much different."



    isa "在那之前，在James消失之前，在我父母去世之前，我完全不一样。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:3123



