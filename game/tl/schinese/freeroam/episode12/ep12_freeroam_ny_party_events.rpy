translate schinese ep12_np_jkey3_label_d6f2e631:







    # mc "It's likely she hasn't told you, but she wants you to be there for her."



    mc "她可能还没告诉你，但她希望你能陪在她身边。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:830



translate schinese ep12_np_jkey3_label_0bdda40e:







    # mc "She wants you to talk to her about your feelings and ask her about hers. But she's unsure how to reach you."



    mc "她希望你和她谈谈你的感受，也问问她的想法。但她不确定该怎么联系你。"







# freeroam\episode12\ep12_freeroam_ny_party_events.rpy:832



translate schinese ep12_np_jkey3_label_f84508d1:







    # ja "How to reach me? I'm always there for her."



    ja "怎么联系我？我一直在她身边。"







