# freeroam\episode12\ep12_freeroam_room3_events.rpy:7
translate schinese ep12_freeroam_room3_label_01a40ddd:

    # zo "Just a few more weeks and then I know for sure."
    zo "再过几周我就知道了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:9
translate schinese ep12_freeroam_room3_label_4d502e96:

    # mc "I'm hoping for the best."
    mc "我希望能有最好的结果。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:11
translate schinese ep12_freeroam_room3_label_dd3492da:

    # zo "Should we prepare for the worst?"
    zo "我们得为最坏的情况做准备吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:13
translate schinese ep12_freeroam_room3_label_d9d720e0:

    # mc "That you don't get in?"
    mc "你进不去吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:15
translate schinese ep12_freeroam_room3_label_cecb8359:

    # zo "Yeah."
    zo "嗯。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:17
translate schinese ep12_freeroam_room3_label_3e0b06d4:

    # mc "I don't want to think that way."
    mc "我不想这么想。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:19
translate schinese ep12_freeroam_room3_label_f7566027:

    # zo "I wanna be closer to you. If I don't get in, that's gonna be an issue, I feel."
    zo "我想离你更近一点。如果我进不去，那就会出问题，我感觉。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:21
translate schinese ep12_freeroam_room3_label_c6f564eb:

    # mc "It won't be an issue."
    mc "这不会有问题。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:23
translate schinese ep12_freeroam_room3_label_82030b28:

    # zo "I'd have to keep working. Maybe I could find a job closer to here."
    zo "我得继续打工。也许能找到一份离这儿近点的工作。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:24
translate schinese ep12_freeroam_room3_label_a6b6d212:

    # mc "Where would you live?"
    mc "你打算住哪儿？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:26
translate schinese ep12_freeroam_room3_label_d904ff64:

    # zo "With you?"
    zo "跟你一起？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:28
translate schinese ep12_freeroam_room3_label_8aa73b0a:

    # mc "Are we talking about moving in already?"
    mc "我们是在说搬进来的事吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:30
translate schinese ep12_freeroam_room3_label_9ed84022:

    # zo "I could crash here once in a while, at least."
    zo "我可以偶尔住这儿，至少。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:32
translate schinese ep12_freeroam_room3_label_65f1e055:

    # mc "Well, yeah. But you can't live here permanently. We're not allowed to do that."
    mc "当然，但你不能一直住这儿。我们没这个权限。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:34
translate schinese ep12_freeroam_room3_label_69dd8bc1:

    # zo "*{i}Sigh{/i}* I know. I wish we could skip forward two weeks and know for sure."
    zo "*{i}叹气{/i}*我知道。我希望我们能快进两周，确定一切。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:36
translate schinese ep12_freeroam_room3_label_95cb2fca:

    # mc "We'll survive, whatever the outcome is."
    mc "我们能撑过去的，不管结果如何。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:38
translate schinese ep12_freeroam_room3_label_1e384013:

    # zo "I love that you're so confident about it."
    zo "我喜欢你这么确定。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:40
translate schinese ep12_freeroam_room3_label_10f64be8:

    # zo "It feels weird to wear this dress today."
    zo "今天穿这条裙子感觉怪怪的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:42
translate schinese ep12_freeroam_room3_label_f18dabe2:

    # mc "You could have borrowed my clothes."
    mc "你完全可以穿我的衣服。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:44
translate schinese ep12_freeroam_room3_label_5678433b:

    # zo "Nah, I should get back home at some point."
    zo "我得回家了，总得回去点。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:46
translate schinese ep12_freeroam_room3_label_94801cbb:

    # mc "Working tomorrow?"
    mc "明天有事吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:48
translate schinese ep12_freeroam_room3_label_51477b26:

    # zo "Yep. And what about you? You'll be free until classes start, or what?"
    zo "嗯，你呢？你到上课前应该都空闲吧？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:50
translate schinese ep12_freeroam_room3_label_46c93697:

    # mc "We'll see. I'll take it day by day."
    mc "咱们走着瞧。一天一天过吧。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:52
translate schinese ep12_freeroam_room3_label_5e01f172:

    # zo "*{i}Smack{/i}* I'll call you later tonight."
    zo "*{i}一巴掌{/i}*我稍后会给你打电话。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:54
translate schinese ep12_freeroam_room3_label_3fc7ef81:

    # mc "Get back home safely."
    mc "平安到家。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:57
translate schinese ep12_freeroam_room3_label_f37cf375:

    # mc "*{i}Yawns{/i}*"
    mc "*{i}哈欠{/i}*"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:58
translate schinese ep12_freeroam_room3_label_cd0bc383:

    # mc "(I can't wait to get out of these clothes. I need a shower.)"
    mc "（我真恨不得脱掉这些衣服，洗个澡。）"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:60
translate schinese ep12_freeroam_room3_label_0c8570a5:

    # mc "(Ah... As good as new.)"
    mc "（啊……好舒服，像新的一样。）"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:63
translate schinese ep12_freeroam_room3_label_429316e2:

    # sa "*{i}Groans{/i}* It's too damn bright already."
    sa "*{i}呻吟{/i}*这他妈太亮了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:65
translate schinese ep12_freeroam_room3_label_345840b6:

    # mc "That's usually the case with...noon."
    mc "这通常是中午的情况。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:67
translate schinese ep12_freeroam_room3_label_37a4d481:

    # sa "Why are you dressed and so chipper? Shouldn't you be sleeping too?"
    sa "你穿得整整齐齐还这么精神？该不会是又熬夜了吧？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:69
translate schinese ep12_freeroam_room3_label_6b967ba7:

    # mc "I slept in. And I'm feeling good today."
    mc "我睡过头了，今天感觉超棒的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:71
translate schinese ep12_freeroam_room3_label_bb997963:

    # sa "You didn't drink enough."
    sa "你没喝够。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:73
translate schinese ep12_freeroam_room3_label_a1c03371:

    # mc "Maybe that was it."
    mc "也许就是这个原因。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:75
translate schinese ep12_freeroam_room3_label_9d247347:

    # sa "Ugh..."
    sa "唔..."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:77
translate schinese ep12_freeroam_room3_label_7f7f9090:

    # mc "I know you're hungover, but I gotta say I love waking up next to you."
    mc "我知道你还在头疼，但我要说，能睡在你身边醒来真的很棒。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:79
translate schinese ep12_freeroam_room3_label_a61fa843:

    # sa "Less talking, more fetching me coffee."
    sa "少说点，多给我去倒咖啡。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:81
translate schinese ep12_freeroam_room3_label_b7e70984:

    # mc "Haha! I'll get right on it."
    mc "哈哈！我这就去弄。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:85
translate schinese ep12_freeroam_room3_label_fd11da6d:

    # mc "Morning."
    mc "早上好。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:87
translate schinese ep12_freeroam_room3_label_9d981a45:

    # qu "Don't shout."
    qu "别喊。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:89
translate schinese ep12_freeroam_room3_label_1b993669:

    # mc "I wasn't. Hungover?"
    mc "我没醉。你问是不是？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:91
translate schinese ep12_freeroam_room3_label_4d1dac67:

    # qu "The question is, why aren't you?"
    qu "问题是，你为什么不在？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:93
translate schinese ep12_freeroam_room3_label_890aec74:

    # mc "I think it was the food. I rarely get hungover after eating a lot."
    mc "我想是吃的那部分。我很少吃很多东西后还会头疼。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:95
translate schinese ep12_freeroam_room3_label_fb482258:

    # qu "Lucky you."
    qu "你运气真好。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:97
translate schinese ep12_freeroam_room3_label_8670a46d:

    # mc "Can I get you something for the hangover? Coffee?"
    mc "我能给你来点缓解宿醉的东西吗？咖啡？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:99
translate schinese ep12_freeroam_room3_label_18e6d0cc:

    # qu "A shot."
    qu "一枪。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:101
translate schinese ep12_freeroam_room3_label_a31340dd:

    # mc "Really?"
    mc "真的？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:103
translate schinese ep12_freeroam_room3_label_7d8760ff:

    # qu "It's far more effective."
    qu "这效果更管用。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:105
translate schinese ep12_freeroam_room3_label_8edc1a0c:

    # mc "I'm not sure if we have any. We brought most of our liquor to the party."
    mc "不确定我们这儿有没有。我们大部分酒都带去派对了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:107
translate schinese ep12_freeroam_room3_label_e323014a:

    # qu "It's fine. I'll head home for one."
    qu "没事，我回去了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:109
translate schinese ep12_freeroam_room3_label_397e189e:

    # mc "Not staying for breakfast?"
    mc "不打算吃早餐了？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:110
translate schinese ep12_freeroam_room3_label_3457f773:

    # qu "Nah..."
    qu "不。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:112
translate schinese ep12_freeroam_room3_label_0c6370f5:

    # mc "Are you sure? I can even bring it to you."
    mc "你确定？我甚至可以把它带来给你。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:114
translate schinese ep12_freeroam_room3_label_e26fe755:

    # qu "I stayed the night, didn't I? Take the fucking win."
    qu "我昨晚留宿了，对吧？拿这胜利算了吧。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:116
translate schinese ep12_freeroam_room3_label_ce31a538:

    # qu "*{i}Smack{/i}*"
    qu "*{i}一巴掌{/i}*"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:118
translate schinese ep12_freeroam_room3_label_ecfc0b7d:

    # mc "Talk later then."
    mc "回头再说。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:128
translate schinese ep12_freeroam_room3_label_d1c25fde:

    # mc "(Yep... It's already decided. I'm not doing shit today.)"
    mc "（嗯……已经决定了。今天我啥也不干了。）"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:133
translate schinese ep12_fr_sage_event_label_bbea7d17:

    # mc "Feeling better?"
    mc "感觉好点了吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:135
translate schinese ep12_fr_sage_event_label_c9076c97:

    # sa "Just slightly."
    sa "只是稍微有点。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:137
translate schinese ep12_fr_sage_event_label_151188a6:

    # mc "No sweat. It's not like we have something better to do today. Clean-up can wait, yeah?"
    mc "不打紧。今天又不是有什么更重要的事要做。收拾一下也等会儿再说，对吧？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:139
translate schinese ep12_fr_sage_event_label_1a80acaa:

    # sa "Yeah."
    sa "嗯。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:141
translate schinese ep12_fr_sage_event_label_a61738e5:

    # mc "So, what do you want to talk about?"
    mc "那你想聊点啥？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:143
translate schinese ep12_fr_sage_event_label_03cee579:

    # sa "I'm more of a listener today, if you don't mind."
    sa "我今天更想当个听众，如果你不介意的话。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:146
translate schinese ep12_fr_sage_event_label_5284a9aa:

    # mc "If that's the case, I have something I'd like to talk about."
    mc "如果真是这样，我有件事想和你谈谈。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:147
translate schinese ep12_fr_sage_event_label_158b3f8f:

    # mc "After I won the fight, I was approached by a scout. She offered me her services and a partnership."
    mc "打赢比赛后，一位星探找上了我。她提出为我提供服务，还想和我合作。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:149
translate schinese ep12_fr_sage_event_label_f428587b:

    # sa "For what? Like, fighting professionally?"
    sa "为了啥？像，当职业选手？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:151
translate schinese ep12_fr_sage_event_label_f0a48dc3:

    # mc "Yeah. It's a stepping stone, for sure."
    mc "当然。这肯定是个起步。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:152
translate schinese ep12_fr_sage_event_label_2936855f:

    # mc "The guys in the club couldn't believe it. Apparently, it's not that common."
    mc "俱乐部里的家伙们简直不敢相信。 看来，这种情况还真不常见。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:154
translate schinese ep12_fr_sage_event_label_34ef231d:

    # mc "But the thing is, I'm unsure if I want to do this for a living."
    mc "但问题是，我还不确定是否真的想靠这个谋生。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:156
translate schinese ep12_fr_sage_event_label_daaec58a:

    # sa "Could you stay here while doing that?"
    sa "你能在那边做这事的时候留在这儿吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:158
translate schinese ep12_fr_sage_event_label_7a27146c:

    # mc "Yeah. I think so."
    mc "嗯，我想是的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:159
translate schinese ep12_fr_sage_event_label_0f031577:

    # mc "I told the scout that I'm in college and such, and she said that wasn't a problem."
    mc "我告诉那位星探自己还在上大学，她说这不是问题。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:161
translate schinese ep12_fr_sage_event_label_e573989c:

    # mc "I could still study and maybe even get a job without it affecting the deal much."
    mc "我还能继续读书，说不定还能打工，对这件事影响应该不大。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:162
translate schinese ep12_fr_sage_event_label_1cb78ce9:

    # mc "As long as I fight, I guess, it's ok to do other things too."
    mc "只要我还在拼，想干别的也行。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:164
translate schinese ep12_fr_sage_event_label_61958182:

    # mc "I've been looking at her card every day since I got it."
    mc "我从拿到她的卡那天起就一直在看。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:165
translate schinese ep12_fr_sage_event_label_88a9caa8:

    # mc "A part of me thinks it's too much for me. That I'm not cut out for that life."
    mc "我有一部分觉得这对我来说太重了，我可能根本不适合那种生活。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:166
translate schinese ep12_fr_sage_event_label_4f9b6f2a:

    # mc "And there's another part saying I'm stupid for wasting this opportunity."
    mc "还有另一部分在说，我傻乎乎地浪费了这个机会。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:167
translate schinese ep12_fr_sage_event_label_afd74152:

    # mc "What do you think?"
    mc "你觉得怎么样？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:169
translate schinese ep12_fr_sage_event_label_78bccba9:

    # sa "I think you already know the answer without me telling you."
    sa "我觉得你已经知道答案了，不用我告诉你。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:170
translate schinese ep12_fr_sage_event_label_b8bf659c:

    # sa "You're checking that card daily. That doesn't sound like someone who doesn't want to go through with something."
    sa "你天天盯着那张卡看，这可不像个不想干的人。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:171
translate schinese ep12_fr_sage_event_label_10a01aeb:

    # sa "It sounds like you're hesitant to pull the trigger."
    sa "听起来你还在犹豫要不要行动。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:173
translate schinese ep12_fr_sage_event_label_a6814fc0:

    # mc "It is scary... Because it might be binding..."
    mc "这很可怕……因为那可能会是永久性的……"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:175
translate schinese ep12_fr_sage_event_label_5a3f967e:

    # sa "Call her and find out."
    sa "给她打电话，问清楚。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:177
translate schinese ep12_fr_sage_event_label_37c5067d:

    # mc "Thanks. I'm gonna."
    mc "谢谢。我打算。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:180
translate schinese ep12_fr_sage_event_label_5284a9aa_1:

    # mc "If that's the case, I have something I'd like to talk about."
    mc "如果真是这样，我有件事想和你谈谈。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:181
translate schinese ep12_fr_sage_event_label_fb4e7026:

    # mc "This guy at the faculty party asked me if I wanted a summer job at his company."
    mc "这个家伙在教职工聚会上问我，要不要去他公司做暑假工。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:183
translate schinese ep12_fr_sage_event_label_d32dffb2:

    # sa "Oh? Who and what company?"
    sa "哦？是哪个家伙？哪家公司？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:185
translate schinese ep12_fr_sage_event_label_a3857cf1:

    # mc "His name is David Cerus Baxter."
    mc "他叫David·塞勒斯·巴克斯特。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:187
translate schinese ep12_fr_sage_event_label_20adf24a:

    # sa "Wow, you remembered his full name."
    sa "哇，你居然记得他全名。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:189
translate schinese ep12_fr_sage_event_label_4772c342:

    # mc "I got his business card. He's the CEO of BaxTec. It's a MedTech company."
    mc "我留了他的名片。他是BaxTec的CEO，那是一家医疗科技公司。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:191
translate schinese ep12_fr_sage_event_label_9e3831f7:

    # sa "Flashy. He just offered you a job like that?"
    sa "真够阔气的。他就这么直接给了你一份工作？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:193
translate schinese ep12_fr_sage_event_label_0023f74a:

    # mc "Yeah. He liked my vibe."
    mc "对，他喜欢我的气质。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:195
translate schinese ep12_fr_sage_event_label_563580fd:

    # sa "Maybe that's not all he liked."
    sa "也许他喜欢的不止是这个。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:197
translate schinese ep12_fr_sage_event_label_30f9b90c:

    # mc "I know I'm hot, but no, that wasn't the vibe I got, ok?"
    mc "我知道自己很性感，但不是，我感觉他对我可没那种意思，行了吧？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:199
translate schinese ep12_fr_sage_event_label_de6a1d2e:

    # sa "[name] got a new boyfriend."
    sa "[name]有了个新男朋友。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:201
translate schinese ep12_fr_sage_event_label_e52c776a:

    # sa "Damn... I sure know how to pick 'em. That's two for two."
    sa "该死...我真是知道怎么挑人的。这已经是两战两胜了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:203
translate schinese ep12_fr_sage_event_label_90acae2c:

    # mc "Shut up. I thought you were gonna listen."
    mc "闭嘴。我以为你会上心。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:205
translate schinese ep12_fr_sage_event_label_c8e0e5c5:

    # sa "Haha!"
    sa "哈哈！"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:207
translate schinese ep12_fr_sage_event_label_8bf3fecf:

    # mc "So, what do you think?"
    mc "那你觉得呢？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:209
translate schinese ep12_fr_sage_event_label_f686118b:

    # sa "It's great that you landed a summer job."
    sa "你找到暑期工了，挺不错的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:211
translate schinese ep12_fr_sage_event_label_67c61306:

    # mc "I haven't contacted him about that yet."
    mc "我还没跟他提这事呢。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:213
translate schinese ep12_fr_sage_event_label_8bd2e00e:

    # sa "But you're gonna, right?"
    sa "但你肯定会联系他，对吧？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:215
translate schinese ep12_fr_sage_event_label_0dd5f904:

    # mc "I think so, yeah."
    mc "我觉得是的，对。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:216
translate schinese ep12_fr_sage_event_label_a433cabe:

    # mc "But it's silly..."
    mc "但这也挺傻的..."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:218
translate schinese ep12_fr_sage_event_label_d4bc65f1:

    # sa "What is?"
    sa "什么情况？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:220
translate schinese ep12_fr_sage_event_label_155c3d71:

    # mc "A part of me thought I'd be going back home to Dad this summer and maybe work at the minimart again or something like that."
    mc "我有一部分想法是这个夏天回家看看爸爸， 也许 去便利店打工或者干点类似的事。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:222
translate schinese ep12_fr_sage_event_label_652c3a09:

    # sa "It sounds like someone needs to step out of his comfort zone, if you ask me."
    sa "这听起来像是有人该走出自己的舒适区了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:224
translate schinese ep12_fr_sage_event_label_29bbaa7e:

    # mc "You think that's playing it too safe?"
    mc "你觉得这样太保守了？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:226
translate schinese ep12_fr_sage_event_label_213cba0a:

    # sa "You got an opportunity for a job in a field you're studying for. What do you think?"
    sa "你有个在你所学领域工作的机会，你怎么看？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:227
translate schinese ep12_fr_sage_event_label_e59f2a30:

    # sa "Why waste that on going back to doing something you already did in the past? What's the point of even going to college if you're gonna regress?"
    sa "为什么要把时间浪费在回到过去做过的事情上？如果你连大学都读了，结果还打算退步，那读它干嘛？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:229
translate schinese ep12_fr_sage_event_label_5b1e5211:

    # mc "When you put it like that, you make me feel stupid."
    mc "你这么一说，我感觉自己真蠢。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:231
translate schinese ep12_fr_sage_event_label_14987b6b:

    # sa "Good. Don't be a fool. Call your boyfriend already."
    sa "好。别傻了。赶紧给你男朋友打电话。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:233
translate schinese ep12_fr_sage_event_label_fcc52df7:

    # mc "Bah... I'm gonna."
    mc "唉……我会去的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:235
translate schinese ep12_fr_sage_event_label_51a96a63:

    # sa "Haha! You even got tired of denying it."
    sa "哈哈！你连否认都开始累了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:238
translate schinese ep12_fr_sage_event_label_0e4d850a:

    # mc "That's alright. I don't have much to talk about, anyway."
    mc "这样就行。我也没什么好说的了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:240
translate schinese ep12_fr_sage_event_label_d2df5251:

    # sa "That works for me too."
    sa "这对我也行。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:255
translate schinese ep12_fr_sage_leave_label_2ecd6ab4:

    # sa "I'm gonna head back home, grab a shower, and put on some fresh clothes."
    sa "我得回去了，洗个澡，换身干净衣服。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:257
translate schinese ep12_fr_sage_leave_label_c8617089:

    # mc "Why? You look great wearing mine."
    mc "为什么？你穿我的外套看起来很棒。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:259
translate schinese ep12_fr_sage_leave_label_bf229725:

    # sa "I do like the jacket. Can I borrow it?"
    sa "我也挺喜欢这件夹克的。能借我穿一下吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:261
translate schinese ep12_fr_sage_leave_label_2c732e45:

    # mc "Sure. And remember, if you want to pledge the DIKs, it's almost time."
    mc "当然。记住，如果你想加入DIKs，时间快到了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:263
translate schinese ep12_fr_sage_leave_label_bb53cd9f:

    # sa "Ugh... Don't remind me. We have to accept more HOTs again."
    sa "唉...别提了。我们又要接受更多HOT了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:264
translate schinese ep12_fr_sage_leave_label_ef9c8c6f:

    # sa "Talk later. Thanks for everything."
    sa "回头聊。谢谢一切。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:266
translate schinese ep12_fr_sage_leave_label_798a0d24:

    # sa "Love you."
    sa "爱你。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:269
translate schinese ep12_fr_sage_leave_label_74fc6761:

    # mc "Me too."
    mc "我也是。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:276
translate schinese ep12_fr_dav_event_label_2e616342:

    # mc "(I'm doing it.)"
    mc "（我干了。）"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:278
translate schinese ep12_fr_dav_event_label_61608813:

    # dav "*{i}Hoarse voice{/i}* Yeah, it's David."
    dav "*{i}沙哑的声音{/i}*对，我是David。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:280
translate schinese ep12_fr_dav_event_label_325ff486:

    # mc "David! Hi! It's...uh...[name]. From the Christmas party."
    mc "David！你好！我是……呃……[name]，圣诞派对上见过的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:282
translate schinese ep12_fr_dav_event_label_185ebf66:

    # dav "Oh. Excuse me, one second."
    dav "哦，不好意思，我一下。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:286
translate schinese ep12_fr_dav_event_label_5e1748b6:

    # dav "I'm back. Sorry about that. I'm a bit hungover from yesterday."
    dav "我回来了。抱歉，刚才有点事。昨天喝多了，现在还有点晕。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:288
translate schinese ep12_fr_dav_event_label_52e3350a:

    # mc "Oh... I hope I didn't wake you up."
    mc "哦……我真希望没吵醒你。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:290
translate schinese ep12_fr_dav_event_label_cb50eb5a:

    # dav "Don't worry, I should get out of bed anyway."
    dav "别担心，我本来也该起床了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:292
translate schinese ep12_fr_dav_event_label_64e0a0b5:

    # mc "I wanted to tell you that I'm interested in that summer job, if the offer is still on the table."
    mc "我想告诉你，我对那个暑假的工作很感兴趣，如果这个机会还有效的话。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:294
translate schinese ep12_fr_dav_event_label_aa6cc07c:

    # dav "Yeah, yeah. I'm glad to hear that. Haha, you could have sent me an e-mail like I asked, though."
    dav "嗯，嗯。听到你这么说我很高兴。哈哈，你本来可以像我要求的那样发个邮件给我啊。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:296
translate schinese ep12_fr_dav_event_label_aa8fc0e4:

    # mc "Oh, right. I'm sorry about that. I thought I'd make a better impression by giving you a call, but - haha - I clearly did not."
    mc "哦，对了，我抱歉。我本来是想给你打电话，给你留下更好的印象，但——哈哈——我显然没做到。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:298
translate schinese ep12_fr_dav_event_label_2105f158:

    # dav "Haha. No sweat. It's me who should have given you a better impression."
    dav "哈哈，没事的。该我给你留下好印象才对。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:299
translate schinese ep12_fr_dav_event_label_562cd29f:

    # dav "How about we forget this phone call, and you send me an e-mail with your info? Then I'll set up a meeting later this year regarding the job."
    dav "那我们就算了这通电话，你发个邮件给我你的信息吧。然后我今年晚些时候安排个见面，谈谈这份工作的事。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:301
translate schinese ep12_fr_dav_event_label_d4dbced4:

    # mc "Yes. That sounds perfect! I'll do that."
    mc "嗯，这样最好了！我这就去办。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:302
translate schinese ep12_fr_dav_event_label_fcc09085:

    # mc "Uh... Thanks again for this opportunity! Oh! And Happy New Year!"
    mc "嗯...再次感谢这次机会！噢！还有新年快乐！"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:304
translate schinese ep12_fr_dav_event_label_ff1f19af:

    # dav "You too, [name]."
    dav "你也是[name]."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:310
translate schinese ep12_fr_dav_event_label_f02c70f6:

    # sa "What did he say?"
    sa "他怎么说的？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:312
translate schinese ep12_fr_dav_event_label_6297a22b:

    # mc "He said he was hungover from last year's party..."
    mc "他提到他去年派对后还处于宿醉状态……"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:313
translate schinese ep12_fr_dav_event_label_318fff24:

    # mc "I should have waited to call him. Fuck..."
    mc "我应该等几天再给他打电话的。操..."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:315
translate schinese ep12_fr_dav_event_label_2ab76c28:

    # sa "That's how it is with dating. You don't call the guy immediately; you have to wait at least a week, or you'll look too clingy."
    sa "这就是谈恋爱的规矩，你不能一有空就打电话给他，得等至少一周，不然看起来太黏人了。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:317
translate schinese ep12_fr_dav_event_label_6d06bc3b:

    # mc "Well, he still offered me the job, but told me to send my info over e-mail."
    mc "好吧，他还是给了我工作机会，但让我把资料发到邮箱里。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:318
translate schinese ep12_fr_dav_event_label_8f2f963f:

    # mc "I'll get called to an interview sometime later this year."
    mc "我今年晚些时候会被叫去面试。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:320
translate schinese ep12_fr_dav_event_label_8a7109c0:

    # sa "Congratulations."
    sa "恭喜。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:322
translate schinese ep12_fr_dav_event_label_58fe7fe6:

    # mc "Thanks... It feels good!"
    mc "谢谢...感觉真不错！"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:331
translate schinese ep12_fr_jen_event_label_2e616342:

    # mc "(I'm doing it.)"
    mc "（我干了。）"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:333
translate schinese ep12_fr_jen_event_label_fa1b21e2:

    # jen "Byson."
    jen "拜森。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:335
translate schinese ep12_fr_jen_event_label_bd5bf5d6:

    # mc "Um... Hi! It's [name]. [name] [lname]. I don't know if you remember me..."
    mc "嗯……嗨！[name]. [name] [lname]我不知道你是否还记得我..."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:337
translate schinese ep12_fr_jen_event_label_9aaff216:

    # jen "Of course, I remember you, [name]. Happy New Year!"
    jen "当然记得你，[name]新年快乐！"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:339
translate schinese ep12_fr_jen_event_label_03a8ce22:

    # mc "Oh! Happy New Year! Did you have a nice time yesterday?"
    mc "哦！新年快乐！你昨天玩得开心吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:341
translate schinese ep12_fr_jen_event_label_76459bfe:

    # jen "I went to a party with my friends. We had a great time, thanks for asking. And you?"
    jen "我和朋友们去参加了一个派对，玩得很开心，谢谢你问。你呢？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:343
translate schinese ep12_fr_jen_event_label_2ee9d7d6:

    # mc "My frat co-hosted a party. We also had a nice end to the year."
    mc "我兄弟会和另一个兄弟会合办了派对。我们这一年也过得挺圆满的。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:345
translate schinese ep12_fr_jen_event_label_f75e895f:

    # jen "Sounds lovely. So, [name], are you calling me with good or bad news?"
    jen "听起来真棒。所以，[name]你是在给我带好消息还是坏消息？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:347
translate schinese ep12_fr_jen_event_label_60d253d9:

    # mc "I'm calling to ask you a question."
    mc "我打电话是想问你一个问题。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:349
translate schinese ep12_fr_jen_event_label_6f7fdaa2:

    # jen "Shoot."
    jen "啧。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:351
translate schinese ep12_fr_jen_event_label_fcffc2a4:

    # mc "If I accept your representation... Is it binding?"
    mc "如果我接受你的代理... 这个合同是具有约束力的吗？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:353
translate schinese ep12_fr_jen_event_label_784ffda6:

    # jen "The terms depend on the fighter. My agency has signed contracts binding fighters from one year to five years."
    jen "条款取决于选手本身。我这边签的合同，有的选手签一年，有的签五年。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:354
translate schinese ep12_fr_jen_event_label_0ce2fcdb:

    # jen "Sometimes, we even base the contracts on a set number of fights."
    jen "有时候，我们甚至会根据固定的比赛场次来签订合同。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:355
translate schinese ep12_fr_jen_event_label_1977456e:

    # jen "And many contracts can be renewed with updated terms."
    jen "很多合同在期满后还能根据新情况续约。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:357
translate schinese ep12_fr_jen_event_label_be1292d1:

    # jen "We would rather sign long-term contracts, as it's a big investment on our end and we might not see a return for quite some time."
    jen "我们更倾向于签长期合同，因为对我们来说这是一笔大投资，而且可能要很久才能看到回报。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:358
translate schinese ep12_fr_jen_event_label_4d207059:

    # jen "That's why I would recommend that we sign a three-year contract, or 15 fights."
    jen "这就是为什么我建议我们签一份三年合同，或者打满15场比赛。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:360
translate schinese ep12_fr_jen_event_label_8e9b111c:

    # jen "It is binding, yes. And we will get exclusive rights to you as a fighter. But we can get into every clause, should you wish to sign."
    jen "是的，合同是具有约束力的。我们会获得你作为拳手的独家权利。不过如果你想签的话，我们也可以逐条讨论条款。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:362
translate schinese ep12_fr_jen_event_label_a7bcf340:

    # mc "I see..."
    mc "我明白了..."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:364
translate schinese ep12_fr_jen_event_label_84059ada:

    # jen "Is that what worries you - that it is binding?"
    jen "这是让你担心的事——它会生效？"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:366
translate schinese ep12_fr_jen_event_label_0d05d27b:

    # mc "I'm worried about what would happen if I regret it, that's all."
    mc "我担心的是如果我以后后悔了会怎样，就这么简单。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:368
translate schinese ep12_fr_jen_event_label_4952035b:

    # jen "Given that you're new to all of this, I understand your trepidation."
    jen "考虑到你对这一切都是新手，我理解你的顾虑。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:369
translate schinese ep12_fr_jen_event_label_240e6053:

    # jen "We could do a trial period, and if you still feel the same after that, you'll get an out."
    jen "我们可以先试个期，如果你试完之后还是觉得合适，那合同就可以签。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:371
translate schinese ep12_fr_jen_event_label_d64d2805:

    # mc "Hm... Ok..."
    mc "嗯... 好吧..."

# freeroam\episode12\ep12_freeroam_room3_events.rpy:373
translate schinese ep12_fr_jen_event_label_9319bbce:

    # jen "Let's set up a meeting next week. I'll have our lawyer present to explain the contract in depth."
    jen "我们下周安排一次会面，我会让我们的律师在场，详细解释合同内容。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:375
translate schinese ep12_fr_jen_event_label_7adbb9bc:

    # mc "*{i}Exhales{/i}* This is more scary than the fight, haha."
