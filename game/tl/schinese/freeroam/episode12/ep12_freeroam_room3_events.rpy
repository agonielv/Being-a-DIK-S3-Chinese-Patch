translate schinese ep12_fr_jen_event_label_3999512e:

    # jen "Haha! I still think we should have a meeting, but I love your answer."
    jen "哈哈！我仍然觉得我们应该开个会，但我喜欢你的回答。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:386
translate schinese ep12_fr_jen_event_label_1bd6a641:

    # mc "Yes. Let's have a meeting. *{i}Phew{/i}*"
