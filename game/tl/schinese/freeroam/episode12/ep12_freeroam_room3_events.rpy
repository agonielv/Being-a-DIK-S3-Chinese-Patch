    # sa "Congratulations!"
    sa "恭喜！"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:412
translate schinese ep12_fr_jen_event_label_163e1a8e:

    # mc "Thanks! Wow... I don't know why, but it's like a weight came off my shoulders."
    mc "谢谢！哇……我也不知道为什么，但感觉像卸下了一块大石头。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:414
translate schinese ep12_fr_jen_event_label_d8418db4:

    # sa "See! You knew you wanted this."
    sa "看吧！你早就想这样了。"

