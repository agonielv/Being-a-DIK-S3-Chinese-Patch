translate schinese ep12_fr_jen_event_label_41fc9411:

    # mc "We're gonna meet next week and talk about it. Most likely, we're talking about a three-year contract with a trial period."
    mc "我们下周见面再详细聊聊。大概率是谈一个三年合同，带试用期。"

# freeroam\episode12\ep12_freeroam_room3_events.rpy:410
