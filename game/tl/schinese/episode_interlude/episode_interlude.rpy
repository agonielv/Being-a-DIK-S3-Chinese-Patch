translate schinese epi_after_drawing3_label_ac8800a2:

    # bre "Is something wrong?"
    bre "出什么事了吗？"

# episode_interlude\episode_interlude.rpy:3235
translate schinese epi_after_drawing3_label_45c4d9ce:

    # zo "Lately... Yeah."
    zo "最近啊……嗯。"

# episode_interlude\episode_interlude.rpy:3238
translate schinese epi_after_drawing3_label_bff8a9f1:

    # bre "It's not about Ems again, right?"
    bre "不是又因为艾玛吧？"

# episode_interlude\episode_interlude.rpy:3240
translate schinese epi_after_drawing3_label_53b0621f:

    # bre "It's not the thing with Ems, right?"
    bre "不是艾玛那件事吧？"

# episode_interlude\episode_interlude.rpy:3243
translate schinese epi_after_drawing3_label_7f5dc581:

    # zo "No, I'm way over that post."
    zo "不，那条帖子我早放下了。"

# episode_interlude\episode_interlude.rpy:3245
translate schinese epi_after_drawing3_label_aba3f397:

    # zo "No, I couldn't give less of a shit about her."
    zo "不，我他妈的才不在乎她呢。"

# episode_interlude\episode_interlude.rpy:3247
translate schinese epi_after_drawing3_label_b63de77d:

    # bre "Then, what's bugging you?"
    bre "那到底什么事烦你了？"

# episode_interlude\episode_interlude.rpy:3249
translate schinese epi_after_drawing3_label_67638e53:

    # zo "Where do I start...?"
    zo "我从哪儿开始说啊……"

# episode_interlude\episode_interlude.rpy:3251
translate schinese epi_after_drawing3_label_54b74a62:

    # bre "Somewhere... Anywhere?"
    bre "随便哪里都行……？"

# episode_interlude\episode_interlude.rpy:3253
translate schinese epi_after_drawing3_label_88aee0c6:

    # zo "I'm running out of money."
    zo "我快没钱了。"

# episode_interlude\episode_interlude.rpy:3255
translate schinese epi_after_drawing3_label_e4427780:

    # bre "Shit... I know the pay is bad, but I'll see what I can do about it-"
    bre "操……我知道工资很低，不过我会想想办法——"

# episode_interlude\episode_interlude.rpy:3257
translate schinese epi_after_drawing3_label_65cb1768:

    # zo "No, don't. I know you're already stretching your budget more than you can afford."
    zo "不，别这样。我知道你已经把预算撑得超过承受能力了。"

# episode_interlude\episode_interlude.rpy:3259
translate schinese epi_after_drawing3_label_f8376bca:

    # bre "I wish I could tell you no to that, but you already know the nasty truth."
    bre "我真希望能说你猜错了，不过你早就知道那个残酷的真相。"

# episode_interlude\episode_interlude.rpy:3261
translate schinese epi_after_drawing3_label_e316d4c1:

    # bre "Well, you could look for another job. Don't let me keep you from it."
    bre "那你可以找份别的工作，别让我耽误你。"

# episode_interlude\episode_interlude.rpy:3262
translate schinese epi_after_drawing3_label_4548bea1:

    # bre "There would be no hard feelings if you did."
    bre "你要是真这么做了，我不会怪你的。"

# episode_interlude\episode_interlude.rpy:3264
translate schinese epi_after_drawing3_label_48b310be:

    # zo "It's not just about the money."
    zo "这不只是钱的问题。"

# episode_interlude\episode_interlude.rpy:3266
translate schinese epi_after_drawing3_label_da979ae2:

    # bre "Then what is it?"
    bre "那到底是什么？"

# episode_interlude\episode_interlude.rpy:3268
translate schinese epi_after_drawing3_label_5f7bc21b:

    # zo "When I came here, I wanted to pursue a dream, you know?"
    zo "我来这里的时候，是想追寻一个梦想，你明白吧？"

# episode_interlude\episode_interlude.rpy:3269
translate schinese epi_after_drawing3_label_446fa198:

    # zo "Thanks to my grandma, I could give it a go, but the money she left me didn't last as long as I thought it would..."
    zo "多亏了我外婆，我才能来试一试，可她留给我的钱没有我想象中那么经花……"

# episode_interlude\episode_interlude.rpy:3271
translate schinese epi_after_drawing3_label_009b079a:

    # zo "And that makes me feel like I've wasted it all."
    zo "这让我觉得自己把她的钱全浪费了。"

# episode_interlude\episode_interlude.rpy:3272
translate schinese epi_after_drawing3_label_acdccf5e:

    # zo "I'm not a surfer. And Floyd was right; I can't make any money off it."
    zo "我不是冲浪选手。而且Floyd说得对，我靠这个赚不到钱。"

# episode_interlude\episode_interlude.rpy:3274
translate schinese epi_after_drawing3_label_68335ceb:

    # zo "I honestly like it way less than I thought I would."
    zo "老实说，我没想象中那么喜欢冲浪。"

# episode_interlude\episode_interlude.rpy:3276
translate schinese epi_after_drawing3_label_44bbaf9e:

    # zo "I love the skateboard she got me. Not just because it reminds me of her but because it's something I'm good at."
    zo "我喜欢她送我的滑板，不只是因为它让我想起她，更因为它是我擅长的事。"

# episode_interlude\episode_interlude.rpy:3277
translate schinese epi_after_drawing3_label_d8102461:

    # zo "Just like drawing... That's also something I'm great at!"
    zo "就像画画一样……那也是我特别擅长的事！"

# episode_interlude\episode_interlude.rpy:3279
translate schinese epi_after_drawing3_label_41fe7b9a:

    # zo "The waves aren't me. This apartment isn't me. The reception of your tattoo studio isn't me."
    zo "海浪不适合我，这间公寓不属于我，做你纹身店的前台也不是我想要的。"

# episode_interlude\episode_interlude.rpy:3280
translate schinese epi_after_drawing3_label_a63e30f5:

    # zo "{b}This{/b} isn't me."
    zo "{b}这样的生活{/b}不是我。"

# episode_interlude\episode_interlude.rpy:3282
translate schinese epi_after_drawing3_label_deddc75f:

    # zo "And it fucking hurts. Because all this time, I thought that it was me."
    zo "而且真的很痛。因为一直以来，我都以为这就是自己。"

# episode_interlude\episode_interlude.rpy:3283
translate schinese epi_after_drawing3_label_080300c6:

    # zo "I wanted it to be me. And now..."
    zo "我曾希望这就是我。可现在……"

# episode_interlude\episode_interlude.rpy:3285
translate schinese epi_after_drawing3_label_3b24d949:

    # zo "I fucking let her down. *{i}Sobs{/i}*"
    zo "我他妈让她失望了。*{i}抽泣{/i}*"

# episode_interlude\episode_interlude.rpy:3287
translate schinese epi_after_drawing3_label_786cdfef:

    # bre "Hey..."
    bre "嘿……"

# episode_interlude\episode_interlude.rpy:3289
translate schinese epi_after_drawing3_label_1b2acdf0:

    # zo "I miss her so fucking much, Bret."
    zo "我他妈太想她了，Bret。"

# episode_interlude\episode_interlude.rpy:3290
translate schinese epi_after_drawing3_label_839efb02:

    # zo "It still hurts. And I didn't even get to say goodbye to her."
    zo "心里还是会痛。而且我连跟她道别的机会都没有。"

# episode_interlude\episode_interlude.rpy:3292
translate schinese epi_after_drawing3_label_92b714db:

    # zo "Everyone I've talked to says that time will take care of it, but it's not doing that for me!"
    zo "每个人都说时间会治愈一切，可对我根本没用！"

# episode_interlude\episode_interlude.rpy:3293
translate schinese epi_after_drawing3_label_d03a911c:

    # zo "I feel so much more alone than I ever did when she was alive."
    zo "我感觉比她还在的时候还要孤单。"

# episode_interlude\episode_interlude.rpy:3297
translate schinese epi_after_drawing3_label_0053d68b:

    # bre "I didn't know your grandma, but based on the stories you've told me about her..."
    bre "我不认识你外婆，不过从你讲过的那些故事来看……"

# episode_interlude\episode_interlude.rpy:3298
translate schinese epi_after_drawing3_label_1474bc1c:

    # bre "I can't imagine that she'd feel let down by you not liking it here."
    bre "我无法想象她会因为你不喜欢这里而感到失望。"

# episode_interlude\episode_interlude.rpy:3299
translate schinese epi_after_drawing3_label_188f48cd:

    # bre "She wanted you to pursue what made you happy in life, didn't she?"
    bre "她希望你去追求生活中让你快乐的东西，不是吗？"

# episode_interlude\episode_interlude.rpy:3301
translate schinese epi_after_drawing3_label_ca51c293:

    # zo "That's all she ever wanted for me."
    zo "这就是她对我唯一的愿望。"

# episode_interlude\episode_interlude.rpy:3303
translate schinese epi_after_drawing3_label_4e50dc21:

    # bre "You jumped on a train, leaving your old life behind for this because you thought you wanted it."
    bre "你坐上火车，抛下过去的一切来到这里，因为你以为自己想要这样的生活。"

# episode_interlude\episode_interlude.rpy:3304
translate schinese epi_after_drawing3_label_7062a120:

    # bre "And when you realize that it isn't what you wanted, her wish for you doesn't change, does it?"
    bre "即使你发现这不是自己想要的，她对你的愿望也不会改变，对吧？"

# episode_interlude\episode_interlude.rpy:3306
translate schinese epi_after_drawing3_label_b0fae401:

    # bre "She'd still want you to go for whatever you want next."
    bre "她还是会希望你继续追求你接下来想做的事。"

# episode_interlude\episode_interlude.rpy:3307
translate schinese epi_after_drawing3_label_2b2ecd66:

    # bre "And you should keep doing that."
    bre "你该继续这么干下去。"

# episode_interlude\episode_interlude.rpy:3308
translate schinese epi_after_drawing3_label_32cfff08:

    # bre "If I were your grandma, I would have been proud as fuck."
    bre "要是我是你外婆，我早就骄傲死了。"

# episode_interlude\episode_interlude.rpy:3310
translate schinese epi_after_drawing3_label_371307eb:

    # zo "*{i}Sniffs{/i}* Haha... If you were my grandma..."
    zo "*{i}抽鼻子{/i}* 哈哈……如果你是我外婆……"

# episode_interlude\episode_interlude.rpy:3311
translate schinese epi_after_drawing3_label_a72c2b6d:

    # zo "Thanks, Bret..."
    zo "谢谢你，Bret……"

# episode_interlude\episode_interlude.rpy:3313
translate schinese epi_after_drawing3_label_2e354d73:

    # bre "So, what do you feel? What are you dreaming of right now?"
    bre "那现在呢？你心里是什么感觉？又在梦想什么？"

# episode_interlude\episode_interlude.rpy:3317
translate schinese epi_after_drawing3_label_6968502f:

    # zo "I dream..."
    zo "我的梦想是……"

# episode_interlude\episode_interlude.rpy:3318
translate schinese epi_after_drawing3_label_e44653ca:

    # zo "I dream of going back home."
    zo "回家。"

# episode_interlude\episode_interlude.rpy:3320
translate schinese epi_after_drawing3_label_069a5dc4:

    # bre "Wow..."
    bre "哇……"

# episode_interlude\episode_interlude.rpy:3321
translate schinese epi_after_drawing3_label_2294770b:

    # bre "You're gonna make me cry, too, you know."
    bre "你也快把我弄哭了，知道吗？"

# episode_interlude\episode_interlude.rpy:3323
translate schinese epi_after_drawing3_label_cde0b491:

    # bre "How can I say that I want you to do that while knowing how much I will miss you?"
    bre "明知道我会有多想你，又怎么说得出口让你走？"

# episode_interlude\episode_interlude.rpy:3325
translate schinese epi_after_drawing3_label_42bf6f1c:

    # zo "I know."
    zo "我知道。"

# episode_interlude\episode_interlude.rpy:3327
translate schinese epi_after_drawing3_label_c9db92c6:

    # zo "You've meant so much to me, Bret. You, Jonah, and Ems are the reasons why it's hard to leave."
    zo "你对我意义重大，Bret。你、Jonah和艾玛，才是让我难以离开的原因。"

# episode_interlude\episode_interlude.rpy:3329
translate schinese epi_after_drawing3_label_4d3c321a:

    # zo "You've meant so much to me, Bret. You and Jonah are the reasons why it's hard to leave."
    zo "你对我意义重大，Bret。你和Jonah，才是让我难以离开的原因。"

# episode_interlude\episode_interlude.rpy:3331
translate schinese epi_after_drawing3_label_76bafd52:

    # bre "The good old days..."
    bre "曾经的美好时光……"

# episode_interlude\episode_interlude.rpy:3333
translate schinese epi_after_drawing3_label_8441f762:

    # zo "I think you still have a few good years in you."
    zo "我觉得你还有几年好日子能过。"

# episode_interlude\episode_interlude.rpy:3335
translate schinese epi_after_drawing3_label_9f4ee898:

    # bre "Promise you'll call once in a while."
    bre "答应我偶尔打个电话。"

# episode_interlude\episode_interlude.rpy:3337
translate schinese epi_after_drawing3_label_014e1b77:

    # zo "Call? I'll fucking come back to visit. You know it."
    zo "打电话？我他妈还会回来探望你呢。你知道的。"

# episode_interlude\episode_interlude.rpy:3338
translate schinese epi_after_drawing3_label_2bd6fb64:

    # zo "And we can meet up somewhere too, you know."
    zo "我们也可以在别的地方碰面。"

# episode_interlude\episode_interlude.rpy:3340
translate schinese epi_after_drawing3_label_5d29aa30:

    # zo "Here..."
    zo "给……"

# episode_interlude\episode_interlude.rpy:3341
translate schinese epi_after_drawing3_label_1901927a:

    # zo "I drew this for you."
    zo "我给你画的。"

# episode_interlude\episode_interlude.rpy:3343
translate schinese epi_after_drawing3_label_bf0b8161:

    # bre "Bret's Metal and Ink?"
    bre "“Bret的金属与墨水”？"

# episode_interlude\episode_interlude.rpy:3344
translate schinese epi_after_drawing3_label_58da0437:

    # zo "In case you wanted a different name or whatever."
    zo "万一你想换个名字什么的。"

# episode_interlude\episode_interlude.rpy:3346
translate schinese epi_after_drawing3_label_86c08ffd:

    # bre "Zoey... I love it. Thanks."
    bre "Zoey……我太喜欢了。谢谢。"

# episode_interlude\episode_interlude.rpy:3354
translate schinese epi_train_home_label_6f63c9b0:

    # zo "{i}And here we are...{/i}"
    zo "{i}现在……我们走到了这里。{/i}"

# episode_interlude\episode_interlude.rpy:3355
translate schinese epi_train_home_label_7123d1db:

    # zo "{i}I gave it my all, but it wasn't as good as young Zoey dreamt it would be when she played with a wooden plank as a surfboard as her grandma cheered her on.{/i}"
    zo "{i}我尽了全力，可它并没有小时候的Zoey想象中那么美好。那时她拿木板当冲浪板，外婆在旁边替她加油。{/i}"

# episode_interlude\episode_interlude.rpy:3357
translate schinese epi_train_home_label_a7f56321:

    # zo "{i}In reality, the waves swallowed me and my surfboard whole before I learned how to ride them.{/i}"
    zo "{i}现实中的海浪在我学会驾驭它们之前，就已经把我连同冲浪板一起吞没了。{/i}"

# episode_interlude\episode_interlude.rpy:3358
translate schinese epi_train_home_label_7839f03b:

    # zo "{i}I will always bear those feelings with me.{/i}"
    zo "{i}我会永远铭记这些感受。{/i}"

# episode_interlude\episode_interlude.rpy:3359
translate schinese epi_train_home_label_3005f8d9:

    # zo "{i}The feeling of how I hated being a loser when I fell off the surfboard.{/i}"
    zo "{i}从冲浪板摔下时，我有多痛恨自己像个失败者。{/i}"

# episode_interlude\episode_interlude.rpy:3361
translate schinese epi_train_home_label_ffc5d26c:

    # zo "{i}The feeling of how I didn't enjoy surfing and how cold the water was.{/i}"
    zo "{i}我有多不喜欢冲浪，海水又有多冷。{/i}"

# episode_interlude\episode_interlude.rpy:3362
translate schinese epi_train_home_label_2ab61e45:

    # zo "{i}The wonderful feeling of skating back home to take a hot shower after a day of pretending I was a banana in the ocean.{/i}"
    zo "{i}在海里扮了一天香蕉后，踩着滑板回家洗热水澡的美妙感觉。{/i}"

# episode_interlude\episode_interlude.rpy:3363
translate schinese epi_train_home_label_307f5b04:

    # zo "{i}The people I met and how much they came to mean to me.{/i}"
    zo "{i}那些遇见的人，后来对我变得多么重要。{/i}"

# episode_interlude\episode_interlude.rpy:3365
translate schinese epi_train_home_label_0c7b85b0:

    # zo "{i}But ultimately...the feeling that I was missing something I couldn't put my finger on.{/i}"
    zo "{i}但最终……我总觉得缺少了什么，却说不上来。{/i}"

# episode_interlude\episode_interlude.rpy:3366
translate schinese epi_train_home_label_f8723cb7:

    # zo "{i}The feeling I tried so hard to push back and ignore.{/i}"
    zo "{i}那种我拼命压下、刻意忽略的感觉。{/i}"

# episode_interlude\episode_interlude.rpy:3371
translate schinese epi_train_home_label_78ea1c00:

    # zo "{i}Home blindness.{/i}"
    zo "{i}家乡盲区。{/i}"

# episode_interlude\episode_interlude.rpy:3373
translate schinese epi_train_home_label_9cd659c0:

    # zo "{i}It took a black-haired badass, a shaven teddy bear, and a red-haired, tight-pants-wearing goofball to teach me to love my hometown and the people in it.{/i}"
    zo "{i}是一个黑发酷妞、一只剃光毛的泰迪熊，还有一个穿紧身裤的红发傻瓜，教会了我热爱家乡和那里的人。{/i}"

# episode_interlude\episode_interlude.rpy:3375
translate schinese epi_train_home_label_9e4e25b8:

    # zo "{i}It took a black-haired bitch, a shaven teddy bear, and a red-haired, tight-pants-wearing goofball to teach me to love my hometown and the people in it.{/i}"
    zo "{i}是一个黑发婊子、一只剃光毛的泰迪熊，还有一个穿紧身裤的红发傻瓜，教会了我热爱家乡和那里的人。{/i}"

# episode_interlude\episode_interlude.rpy:3377
translate schinese epi_train_home_label_9078d883:

    # zo "{i}So, now...{/i}"
    zo "{i}所以，现在……{/i}"

# episode_interlude\episode_interlude.rpy:3378
translate schinese epi_train_home_label_0d3d75d9:

    # zo "{i}I'm heading back home.{/i}"
    zo "{i}我要回家了。{/i}"

# episode_interlude\episode_interlude.rpy:3452
translate schinese mc_ending_epi_label_f03e5225:

    # "*{i}Cellphone rings{/i}*"
    "*{i}手机铃声{/i}*"

# episode_interlude\episode_interlude.rpy:3457
translate schinese mc_ending_epi_label_8c963516:

    # mc "Dad. Now is not a good time for me. I-"
    mc "爸，我现在不方便。我——"

# episode_interlude\episode_interlude.rpy:3461
translate schinese mc_ending_epi_label_6621676e:

    # mc "Wait, what!?"
    mc "等等，什么！？"

# episode_interlude\episode_interlude.rpy:3462
translate schinese mc_ending_epi_label_8663eb6c:

    # mc "S-she's back? Why?"
    mc "她、她回来了？为什么？"

# episode_interlude\episode_interlude.rpy:3464
translate schinese mc_ending_epi_label_9fcc19f5:

    # mc "Uh... I guess..."
    mc "呃……我想……"

# episode_interlude\episode_interlude.rpy:3466
translate schinese mc_ending_epi_label_2b35b6fe:

    # mc "..."
    mc "……"

# episode_interlude\episode_interlude.rpy:3468
translate schinese mc_ending_epi_label_0c0769a7:

    # mc "Give her my new number."
    mc "把我的新号码给她。"

# episode_interlude\episode_interlude.rpy:3469
translate schinese mc_ending_epi_label_9d607768:

    # mc "Yeah, my old phone is switched off."
    mc "对，我的旧手机关机了。"

# episode_interlude\episode_interlude.rpy:3471
translate schinese mc_ending_epi_label_a15d334c:

    # mc "Hey..."
    mc "嘿……"

# episode_interlude\episode_interlude.rpy:3472
translate schinese mc_ending_epi_label_232861a3:

    # mc "Is she ok?"
    mc "她还好吗？"

# episode_interlude\episode_interlude.rpy:3476
translate schinese mc_ending_epi_label_054c5ee0:

    # mc "I see."
    mc "明白了。"

# episode_interlude\episode_interlude.rpy:3479
translate schinese mc_ending_epi_label_23e58dc5:

