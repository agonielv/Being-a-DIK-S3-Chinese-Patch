    zo "你真的不能一起来吗？就……跟我上火车吧。"

# episode_interlude\episode_interlude.rpy:719
translate schinese epi_leaving_label_72fed627:

    # mc "I want to, but I can't. I wanna graduate first..."
    mc "我想去，但我不能。我得先毕业……"

# episode_interlude\episode_interlude.rpy:721
translate schinese epi_leaving_label_0372604a:

    # zo "..."
    zo "……"

# episode_interlude\episode_interlude.rpy:722
translate schinese epi_leaving_label_31292ec1:

    # mc "And you can't wait until next summer?"
    mc "你不能等到明年夏天吗？"

# episode_interlude\episode_interlude.rpy:724
translate schinese epi_leaving_label_ba1ead1e:

    # zo "[name]... I can't find it in me to finish that class."
    zo "[name]……我实在没办法把那门课读完。"

# episode_interlude\episode_interlude.rpy:725
translate schinese epi_leaving_label_6359773f:

    # zo "I don't feel anything anymore..."
    zo "我已经什么感觉都没有了……"

# episode_interlude\episode_interlude.rpy:726
translate schinese epi_leaving_label_870a355f:

    # zo "I need to do this."
    zo "我得这么做。"

# episode_interlude\episode_interlude.rpy:728
translate schinese epi_leaving_label_3e1fe83c:

    # mc "For your grandma?"
    mc "为了你外婆？"

# episode_interlude\episode_interlude.rpy:730
translate schinese epi_leaving_label_8dd27d77:

    # zo "She was the only one who believed in me and my dreams."
    zo "她是唯一相信我、相信我梦想的人。"

# episode_interlude\episode_interlude.rpy:731
translate schinese epi_leaving_label_f57d4cc2:

    # zo "It's for her, but it's also for me."
    zo "这是为了她，也是为了我自己。"

# episode_interlude\episode_interlude.rpy:732
translate schinese epi_leaving_label_e251b94e:

    # zo "I need to feel something again."
    zo "我需要重新感受到些什么。"

# episode_interlude\episode_interlude.rpy:734
translate schinese epi_leaving_label_c5d3e248:

    # mc "I understand..."
    mc "我懂……"

# episode_interlude\episode_interlude.rpy:739
translate schinese epi_leaving_label_48e4c6bb:

    # zo "So... That's my ride."
    zo "那么……我的车来了。"

# episode_interlude\episode_interlude.rpy:741
translate schinese epi_leaving_label_69c25b65:

    # mc "Yeah..."
    mc "嗯……"

# episode_interlude\episode_interlude.rpy:742
translate schinese epi_leaving_label_3b10ac92:

    # mc "How do we do this?"
    mc "我们该怎么告别？"

# episode_interlude\episode_interlude.rpy:744
translate schinese epi_leaving_label_1bae6d2c:

    # zo "I don't know. I suck at goodbyes."
    zo "不知道。我最不会告别了。"

# episode_interlude\episode_interlude.rpy:745
translate schinese epi_leaving_label_ddf1094b:

    # zo "Casual wave?"
    zo "随便挥挥手？"

# episode_interlude\episode_interlude.rpy:749
translate schinese epi_leaving_label_60365026:

    # zo "Or this..."
    zo "或者这张……"

# episode_interlude\episode_interlude.rpy:753
translate schinese epi_leaving_label_b4ec2f9b:

    # mc "Just so you know..."
    mc "有件事你得知道……"

# episode_interlude\episode_interlude.rpy:754
translate schinese epi_leaving_label_f7a7f5a4:

    # mc "Your grandma isn't the only one who believes in you."
    mc "相信你的不只你外婆。"

# episode_interlude\episode_interlude.rpy:756
translate schinese epi_leaving_label_0372604a_1:

    # zo "..."
    zo "……"

# episode_interlude\episode_interlude.rpy:758
translate schinese epi_leaving_label_29f5575b:

    # mc "Let me know when you get there."
    mc "到了给我发个消息。"

# episode_interlude\episode_interlude.rpy:760
translate schinese epi_leaving_label_7b245ba9:

    # zo "Yeah, I will. And if you see Mom, once in a while..."
    zo "嗯，我会的。还有……如果你偶尔碰见我妈……"

# episode_interlude\episode_interlude.rpy:762
translate schinese epi_leaving_label_50e5a661:

    # mc "I'll drop by and talk to her from time to time."
    mc "我会时不时去跟她聊聊。"

# episode_interlude\episode_interlude.rpy:767
translate schinese epi_leaving_label_73def9cd:

    # zo "Thanks... I really appreciate that."
    zo "谢谢……我真的很感激。"

# episode_interlude\episode_interlude.rpy:769
translate schinese epi_leaving_label_84959a21:

    # mc "It's not a problem."
    mc "小事一桩。"

# episode_interlude\episode_interlude.rpy:772
translate schinese epi_leaving_label_6bec673f:

    # zo "You don't have to do that. A simple hi is enough."
    zo "你不用特意这么做。偶尔打声招呼就够了。"

# episode_interlude\episode_interlude.rpy:774
translate schinese epi_leaving_label_75aec66e:

    # mc "No, I want to."
    mc "不，我愿意。"

# episode_interlude\episode_interlude.rpy:787
translate schinese epi_leaving_label_d7209b5e:

    # zo "Shitballs..."
    zo "妈的……"

# episode_interlude\episode_interlude.rpy:817
translate schinese epi_after_drawing1_label_93862c76:

    # cn "Ticket, please."
    cn "请出示车票。"

# episode_interlude\episode_interlude.rpy:917
translate schinese epi_san_diego_label_35545881:

    # zo "{i}San Diego...{/i}"
    zo "{i}圣地亚哥……{/i}"

# episode_interlude\episode_interlude.rpy:918
translate schinese epi_san_diego_label_660f4505:

    # zo "{i}Everyone's last guess to where you're going when you say you're heading to California.{/i}"
    zo "{i}每当你说要去加州时，大家最后才会猜到的地方。{/i}"

# episode_interlude\episode_interlude.rpy:919
translate schinese epi_san_diego_label_1822c161:

    # zo "{i}Hey, it's still California! It's cheaper than LA, but you get the same waves, if not better.{/i}"
    zo "{i}嘿，这里还是加州呢！比洛杉矶便宜，但浪却一样，说不定还更好。{/i}"

# episode_interlude\episode_interlude.rpy:920
translate schinese epi_san_diego_label_84394013:

    # zo "{i}Maybe it's bullshit, but that's what the website said.{/i}"
    zo "{i}也许这是扯淡，但网站是这么说的。{/i}"

# episode_interlude\episode_interlude.rpy:922
translate schinese epi_san_diego_label_05f028e6:

    # zo "{i}The first question my friends asked me was if I was going to Tijuana.{/i}"
    zo "{i}我的朋友们第一个问题是问我是不是要去蒂华纳。{/i}"

# episode_interlude\episode_interlude.rpy:923
translate schinese epi_san_diego_label_a1368abe:

    # zo "{i}I heard there's a crossing near the border that's one-way only. Drive down that road, and you're fucked - or you're going to Mexico - whichever way you'd rather look at it.{/i}"
    zo "{i}我听说边境附近有条路只能单向通行。开下去你就完蛋了——或者说，你就到墨西哥了——看你愿意怎么理解。{/i}"

# episode_interlude\episode_interlude.rpy:924
translate schinese epi_san_diego_label_ca911bff:

    # zo "{i}And to answer their question... No, I don't plan on visiting Mexico.{/i}"
    zo "{i}至于他们的问题……不，我不打算去墨西哥。{/i}"

# episode_interlude\episode_interlude.rpy:925
translate schinese epi_san_diego_label_23d45e7a:

    # zo "{i}Then again, I didn't plan to come here either. It just kinda happened.{/i}"
    zo "{i}说起来，我也没打算来这儿。事情就这样发生了。{/i}"

# episode_interlude\episode_interlude.rpy:927
translate schinese epi_san_diego_label_2792f670:

    # zo "{i}Grandma... You shouldn't have left me that money. All of your savings will go to waste because of me.{/i}"
    zo "{i}外婆……你不该把那笔钱留给我。你的全部积蓄都会被我浪费掉。{/i}"

# episode_interlude\episode_interlude.rpy:928
translate schinese epi_san_diego_label_d90fa98b:

    # zo "{i}Well, at least the part that you gave to me. I can't believe I got more than Joline...{/i}"
    zo "{i}好吧，至少是你留给我的那部分。我真不敢相信我分到的比乔琳还多……{/i}"

# episode_interlude\episode_interlude.rpy:929
translate schinese epi_san_diego_label_a51d3911:

    # zo "{i}The look on her face was...uh... Never mind...{/i}"
    zo "{i}她脸上的表情……呃……算了。{/i}"

# episode_interlude\episode_interlude.rpy:930
translate schinese epi_san_diego_label_5192e372:

    # zo "{i}You always encouraged me with my dreams... And dreams do cost money.{/i}"
    zo "{i}你总是鼓励我的梦想……而梦想确实需要花钱。{/i}"

# episode_interlude\episode_interlude.rpy:932
translate schinese epi_san_diego_label_d9038d98:

    # zo "{i}I promise to make that money last as long as I can. I'm not here for a vacation.{/i}"
    zo "{i}我保证会尽可能让这笔钱多撑一段时间。我来这里不是来度假的。{/i}"

# episode_interlude\episode_interlude.rpy:933
translate schinese epi_san_diego_label_9cb5f705:

    # zo "{i}I just need to...{/i}"
    zo "{i}我只需要……{/i}"

# episode_interlude\episode_interlude.rpy:934
translate schinese epi_san_diego_label_bba6d958:

    # zo "{i}Find some purpose in life.{/i}"
    zo "{i}找到活下去的目标。{/i}"

# episode_interlude\episode_interlude.rpy:935
translate schinese epi_san_diego_label_e373b547:

    # zo "{i}And also, to fucking find out if my awesome skateboarding skills translate to a board with no wheels cruising big-ass ocean waves.{/i}"
    zo "{i}还得他妈弄明白，我这身了不起的滑板技术，换到一块没轮子的板上、面对海里的巨浪，还管不管用。{/i}"

# episode_interlude\episode_interlude.rpy:937
translate schinese epi_san_diego_label_44afd8fd:

    # zo "{i}I couldn't have picked a better month to come here. Surfing season is here!{/i}"
    zo "{i}我来这儿的月份可真是选对了。冲浪季来了！{/i}"

# episode_interlude\episode_interlude.rpy:938
translate schinese epi_san_diego_label_0d7af738:

    # zo "{i}It'll last until November. That gives me time to figure it out.{/i}"
    zo "{i}冲浪季会一直持续到11月，够我慢慢摸索了。{/i}"

# episode_interlude\episode_interlude.rpy:939
translate schinese epi_san_diego_label_3f51b9c3:

    # zo "{i}The best part of it all...is the freedom.{/i}"
    zo "{i}这一切中最棒的部分……是自由。{/i}"

# episode_interlude\episode_interlude.rpy:940
translate schinese epi_san_diego_label_6a494037:

    # zo "{i}I love her, but Mom's rules never did anything good for me.{/i}"
    zo "{i}我爱她，但妈妈那些规矩从没给我带来过什么好处。{/i}"

# episode_interlude\episode_interlude.rpy:942
translate schinese epi_san_diego_label_a346af06:

    # zo "{i}Now, this is Freedom. Capital F.{/i}"
    zo "{i}这才叫“自由”——还是大写的自由。{/i}"

# episode_interlude\episode_interlude.rpy:943
translate schinese epi_san_diego_label_220f7355:

    # zo "{i}Alone in a new city.{/i}"
    zo "{i}独自一人在陌生城市。{/i}"

# episode_interlude\episode_interlude.rpy:944
translate schinese epi_san_diego_label_87566d8c:

    # zo "{i}No Mom here to tell me what I can't do.{/i}"
    zo "{i}这里没人管我做什么。{/i}"

# episode_interlude\episode_interlude.rpy:947
translate schinese epi_san_diego_label_89799393:

    # host "No alcohol."
    host "不准喝酒。"

# episode_interlude\episode_interlude.rpy:949
translate schinese epi_san_diego_label_7ce5924d:

    # zo "'scuse me, can you repeat that?"
    zo "你说什么？能再说一遍吗？"

# episode_interlude\episode_interlude.rpy:952
translate schinese epi_san_diego_label_46394508:

    # host "You cannot drink unless you're 21. That cannot be news to you, darling."
    host "你得满21岁才能喝酒。这对你来说应该不是什么新鲜事，亲爱的。"

# episode_interlude\episode_interlude.rpy:957
translate schinese epi_san_diego_label_df03a871:

    # zo "But I am 21."
    zo "但我已经21了。"

# episode_interlude\episode_interlude.rpy:959
translate schinese epi_san_diego_label_b6e91b93:

    # host "If that's not the case, it's going to get awkward when I ask for your ID in a minute."
    host "要真是这样，待会儿我让你出示证件时可就尴尬了。"

# episode_interlude\episode_interlude.rpy:961
translate schinese epi_san_diego_label_2c886727:

    # zo "Fuck..."
    zo "操。"

# episode_interlude\episode_interlude.rpy:964
translate schinese epi_san_diego_label_cdc73504:

    # zo "What if I do it in my room?"
    zo "那我在自己房间里喝呢？"

# episode_interlude\episode_interlude.rpy:966
translate schinese epi_san_diego_label_8ac70701:

    # host "No, that's prohibited too."
    host "不，这也不行。"

# episode_interlude\episode_interlude.rpy:968
translate schinese epi_san_diego_label_ce2b5cb8:

    # zo "Ugh..."
    zo "唉……"

# episode_interlude\episode_interlude.rpy:974
translate schinese epi_san_diego_label_66a62151:

    # host "You'll have to wear this red wristband when you're in the bar, and we have a collaboration with other hostels and bars in the area..."
    host "你进酒吧时必须戴着这条红腕带，而且我们和附近其他旅舍、酒吧都有合作……"

# episode_interlude\episode_interlude.rpy:975
translate schinese epi_san_diego_label_76e4d7f0:

    # host "...so, my advice is to always keep that wristband on."
    host "所以，我的建议是永远别把它摘下来。"

# episode_interlude\episode_interlude.rpy:979
translate schinese epi_san_diego_label_d7209b5e:

    # zo "Shitballs..."
    zo "妈的……"

# episode_interlude\episode_interlude.rpy:987
translate schinese epi_san_diego_label_5b3d41d4:

    # zo "(I'm finally here...)"
    zo "（我终于到了……）"

# episode_interlude\episode_interlude.rpy:988
translate schinese epi_san_diego_label_9c2afe96:

    # zo "(I need to find some fucking friends who can score me beer.)"
    zo "（得他妈找几个能帮我搞到啤酒的朋友。）"

# episode_interlude\episode_interlude.rpy:1044
translate schinese epi_surf_label_5acd3e24:

    # zo "{i}Surfing class - day one... It's...uh... It's something.{/i}"
    zo "{i}冲浪课第一天……怎么说呢……挺一言难尽的。{/i}"

# episode_interlude\episode_interlude.rpy:1045
translate schinese epi_surf_label_460eb6c8:

    # zo "{i}You know when you get taught how to ski, and they tell you to either go \"pizza\" or \"French fries\" to learn how to position your skis?{/i}"
    zo "{i}教你滑雪时，教练会说做“披萨”或“薯条”动作，帮你掌握雪板姿势，对吧？{/i}"

# episode_interlude\episode_interlude.rpy:1047
translate schinese epi_surf_label_94f01d5e:

    # zo "{i}When you surf, you go \"banana\". It's kind of the first state used when you paddle.{/i}"
    zo "{i}冲浪则要摆成“香蕉”。这差不多是划水时最先学的姿势。{/i}"

# episode_interlude\episode_interlude.rpy:1048
translate schinese epi_surf_label_fd5d3f5b:

    # zo "{i}We didn't start off in the water, though. You start learning on land. We barely got wet during the first lesson.{/i}"
    zo "{i}不过我们没直接下水，而是先在陆地上学。第一节课几乎都没沾到水。{/i}"

# episode_interlude\episode_interlude.rpy:1049
translate schinese epi_surf_label_e5db90d1:

    # zo "{i}We learned about paddling, the surfboard anatomy, popping up to stand on the board, and the surfing stance. All of this we got taught on the sand.{/i}"
    zo "{i}我们学了划水、冲浪板各部位、起身上板和冲浪站姿。这些全是在沙滩上教的。{/i}"

# episode_interlude\episode_interlude.rpy:1051
translate schinese epi_surf_label_6257c00d:

    # zo "{i}The instructor also taught us about setup, dangers, tides, flags, and a shitload of other information...{/i}"
    zo "{i}教练还讲了准备工作、安全风险、潮汐、旗语，以及一大堆别的知识……{/i}"

# episode_interlude\episode_interlude.rpy:1052
translate schinese epi_surf_label_c89c8131:

    # zo "{i}Surprisingly little was actually about how to ride the waves.{/i}"
    zo "{i}真正讲怎么乘浪的内容反倒少得出奇。{/i}"

# episode_interlude\episode_interlude.rpy:1054
translate schinese epi_surf_label_30c01a4c:

    # zo "{i}But that's what surfing is. It's much more than actually riding the waves. You don't even stand up on your board most of the time.{/i}"
    zo "{i}但冲浪本来就不只乘浪。大部分时间甚至都不站在板上。{/i}"

# episode_interlude\episode_interlude.rpy:1055
translate schinese epi_surf_label_7180d07f:

    # zo "{i}It's very different from what I came here thinking.{/i}"
    zo "{i}跟我来之前想象的完全不一样。{/i}"

# episode_interlude\episode_interlude.rpy:1058
translate schinese epi_surf_label_9dd193ff:

    # zo "{i}Anyway, the first rule of surfing over here is always surf with a buddy.{/i}"
    zo "{i}总之，这里冲浪的第一条规矩是：一定要有同伴。{/i}"

# episode_interlude\episode_interlude.rpy:1059
translate schinese epi_surf_label_de489811:

    # zo "{i}So, I had to find one...{/i}"
    zo "{i}所以，我不得不找一个……{/i}"

# episode_interlude\episode_interlude.rpy:1062
translate schinese epi_surf_label_771f5284:

    # em "Emma. You?"
    em "Emma。你呢？"

# episode_interlude\episode_interlude.rpy:1064
translate schinese epi_surf_label_7d1da27e:

    # zo "Zoey."
    zo "Zoey。"

# episode_interlude\episode_interlude.rpy:1066
translate schinese epi_surf_label_1b4bac09:

    # em "Cool name! You don't sound like you're from here."
    em "好名字！你听起来好像不是本地人。"

# episode_interlude\episode_interlude.rpy:1068
translate schinese epi_surf_label_23efcefa:

    # zo "I wish I were, but nah. You?"
    zo "我倒是希望是，但没那回事。你呢？"

# episode_interlude\episode_interlude.rpy:1070
translate schinese epi_surf_label_e790cb59:

    # em "Born on the beach, die on the beach."
    em "在海边出生，就死在海边。"

# episode_interlude\episode_interlude.rpy:1072
translate schinese epi_surf_label_c8ef820e:

    # zo "You've had this all your life, and you're only learning to surf now? What gives?"
    zo "你从小住海边，怎么现在才学冲浪？什么情况？"

# episode_interlude\episode_interlude.rpy:1074
translate schinese epi_surf_label_503e7925:

    # em "Have you ever heard of home blindness?"
    em "你听说过“家乡盲区”吗？"

# episode_interlude\episode_interlude.rpy:1076
translate schinese epi_surf_label_5a6a18b4:

    # zo "Nope, never."
    zo "没听说过。"

# episode_interlude\episode_interlude.rpy:1078
translate schinese epi_surf_label_56712fcc:

    # em "I met a tourist who taught me about it."
    em "我遇到个游客跟我讲了这个。"

# episode_interlude\episode_interlude.rpy:1079
translate schinese epi_surf_label_b6cdcef7:

    # em "He came here and was all like, \"Wow, this city is so amazing! I bet you're swimming and surfing daily\"."
    em "他一来就说：“哇，这座城市太棒了！我敢打赌你每天都游泳、冲浪。”"

# episode_interlude\episode_interlude.rpy:1081
translate schinese epi_surf_label_da6598db:

    # em "And I was like, \"Nope. I don't, actually\"."
    em "我就说：“没有，我其实不这么干。”"

# episode_interlude\episode_interlude.rpy:1083
translate schinese epi_surf_label_bde57f49:

    # em "So, being home blind is how you spend your life living somewhere, and you get so used to it that you don't see what's awesome about it."
    em "所谓“家乡盲区”，就是在一个地方住久了、习以为常，反而看不到它有多棒。"

# episode_interlude\episode_interlude.rpy:1084
translate schinese epi_surf_label_ac9e7ffd:

    # em "It took a pasty-ass tourist to teach me to love my hometown. So, now..."
    em "一个白得跟鬼似的游客，才让我学会喜欢自己的家乡。所以现在……"

