    my "[name]..."

# episode11\ep11_hangout.rpy:231
translate schinese ep11_ho_maya_label_c23f622c:

    # my "How can I possibly thank you enough for what you have done for me?"
    my "你为我做了这么多，我怎么感谢你都不够。"

# episode11\ep11_hangout.rpy:234
translate schinese ep11_ho_maya_label_c5cff9a4:

    # mc "You don't owe me anything, Maya. I'm happy everything will work out. I know you've still got things to deal with, but..."
    mc "Maya，你不欠我什么。一切能顺利解决，我就很高兴了。我知道你还有些事要处理，不过……"

# episode11\ep11_hangout.rpy:236
translate schinese ep11_ho_maya_label_5a456cda:

    # mc "You don't owe me anything, Maya. I'm happy you've figured things out. I know you've still got things to deal with, but..."
    mc "Maya，你不欠我什么。你能想清楚，我就很高兴了。我知道你还有些事要处理，不过……"

# episode11\ep11_hangout.rpy:238
translate schinese ep11_ho_maya_label_27af8da6:

    # my "I know. Me too."
    my "我知道。我也是。"

