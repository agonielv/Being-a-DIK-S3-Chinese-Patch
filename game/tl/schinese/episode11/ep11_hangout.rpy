    # mc "Let me know if you want to discuss what happened between you and Patrick..."
    mc "如果你想聊聊你和Patrick之间的事，随时告诉我……"

# episode11\ep11_hangout.rpy:242
translate schinese ep11_ho_maya_label_fc645303:

    # my "..."
    my "..."

# episode11\ep11_hangout.rpy:244
