# episode11\update11.rpy:2617
translate schinese ep11_zoey_home_label_66e28537:

    # mc "Are you under the weather?"
    mc "你是不是不舒服？"

# episode11\update11.rpy:2619
translate schinese ep11_zoey_home_label_1a78f189:

    # zo "Yeah, I think I caught something at the party. You should keep your distance."
    zo "嗯，我想是在派对上着凉了。你最好离我远点。"

# episode11\update11.rpy:2621
translate schinese ep11_zoey_home_label_f8f9f0f1:

    # mc "Oh... Well, you look tired."
    mc "哦……你看起来很累。"

# episode11\update11.rpy:2623
translate schinese ep11_zoey_home_label_db644855:

    # zo "*{i}Groans{/i}* Thanks..."
    zo "*{i}哼了一声{/i}* 谢了……"

# episode11\update11.rpy:2625
translate schinese ep11_zoey_home_label_43ea8ed2:

    # mc "I was home over the weekend and wanted to check in on you."
    mc "我周末回家了，想来看看你。"

# episode11\update11.rpy:2626
translate schinese ep11_zoey_home_label_f5b446d6:

    # mc "You left the party before I could say goodbye."
    mc "你在我还没来得及说再见之前就离开了派对。"

# episode11\update11.rpy:2628
translate schinese ep11_zoey_home_label_c5b794e3:

    # zo "Yeah, I... I was in a hurry. I didn't want to miss my ride home."
    zo "嗯，我赶时间，不想错过回家的车。"

# episode11\update11.rpy:2630
translate schinese ep11_zoey_home_label_26ac6388:

    # mc "I had this weird feeling it had something to do with our talk."
    mc "我有种奇怪的感觉，这事儿和我们刚才的谈话有关。"

# episode11\update11.rpy:2632
translate schinese ep11_zoey_home_label_5d2f4f29:

    # zo "No, no. It's all good."
    zo "不，不。都好着呢。"

# episode11\update11.rpy:2634
translate schinese ep11_zoey_home_label_ab392662:

    # zo "What about you? You didn't catch anything, did you?"
    zo "你呢？你没抓到什么吧？"

# episode11\update11.rpy:2636
translate schinese ep11_zoey_home_label_82b755d3:

    # mc "No, I'm feeling fine."
    mc "不，我感觉挺好的。"

# episode11\update11.rpy:2638
translate schinese ep11_zoey_home_label_3f717136:

    # mc "So... What are you up to? Drawing?"
    mc "那……你最近在忙什么？画画吗？"

# episode11\update11.rpy:2641
translate schinese ep11_zoey_home_label_5df4187a:

    # zo "Yeah. Same old, you know?"
    zo "对，还是老样子，你也知道吧？"

# episode11\update11.rpy:2643
translate schinese ep11_zoey_home_label_4759d6d0:

    # mc "I bet I missed out on many cool sketches."
    mc "我肯定错过好多好画了。"

# episode11\update11.rpy:2645
translate schinese ep11_zoey_home_label_dd5a6006:

    # zo "Another time, maybe."
    zo "下次吧。"

# episode11\update11.rpy:2647
translate schinese ep11_zoey_home_label_2b35b6fe:

    # mc "..."
    mc "..."

# episode11\update11.rpy:2649
translate schinese ep11_zoey_home_label_3e763a23:

    # mc "Look... I was out of line telling you those things at the party."
    mc "看着你，我有点后悔在派对上说那些话了。"

# episode11\update11.rpy:2650
translate schinese ep11_zoey_home_label_fc49ee4a:

    # mc "You wanted me to tell you what I felt and I did. And I know it must have felt sudden to you."
    mc "你让我告诉你我的感受，而我确实说了。我知道对你来说这可能来得有点突然。"

# episode11\update11.rpy:2652
translate schinese ep11_zoey_home_label_654fd8b1:

    # mc "I think I had to say those things to you because I couldn't be your friend if I didn't."
    mc "我觉得我必须对你说那些话，因为如果我不说，我就不能做你的朋友了。"

# episode11\update11.rpy:2653
translate schinese ep11_zoey_home_label_13b4945a:

    # mc "I've never been one to hide my feelings around you, and it felt like I was."
    mc "我从不习惯在你面前隐藏自己的感受，那时候我就是这么觉得的。"

# episode11\update11.rpy:2655
translate schinese ep11_zoey_home_label_0372604a:

    # zo "..."
    zo "..."

# episode11\update11.rpy:2657
translate schinese ep11_zoey_home_label_f9f862f2:

    # zo "It did take me by surprise."
    zo "这让我很意外。"

# episode11\update11.rpy:2659
translate schinese ep11_zoey_home_label_20fe07dc:

    # mc "I knew it."
    mc "我知道。"

# episode11\update11.rpy:2660
translate schinese ep11_zoey_home_label_12add74d:

    # mc "You might think you'd hurt me by telling me you don't feel the same."
    mc "你可能以为告诉我不再对你有感觉会伤害到我。"

# episode11\update11.rpy:2661
translate schinese ep11_zoey_home_label_7f0d932b:

    # mc "That's why I think it's best if you don't say anything, and that's why I stopped you from answering."
    mc "这就是为什么我觉得你最好什么也不要说，这也是为什么我阻止你回答。"

# episode11\update11.rpy:2662
translate schinese ep11_zoey_home_label_0890d4de:

    # mc "Truth is, I've tried my best to move on, and I don't know how I'd react to being rejected by you and learning that I was the only one having those feelings."
    mc "说实在的，我一直在努力放下，我不知道如果被你拒绝，还发现只有我一个人有这些感觉，我会怎么反应。"

# episode11\update11.rpy:2664
translate schinese ep11_zoey_home_label_4736fc87:

    # zo "(What if I told you I was?)"
    zo "（如果你告诉我我是个什么？）"

# episode11\update11.rpy:2666
translate schinese ep11_zoey_home_label_6cdaf3e1:

    # zo "I respect that."
    zo "我尊重你的选择。"

# episode11\update11.rpy:2675
translate schinese ep11_zoey_home_label_0ac8f80d:

    # mc "Anyway... I'm sorry. I could have handled it better."
    mc "总之...我很抱歉。我本可以处理得更好的。"

# episode11\update11.rpy:2677
translate schinese ep11_zoey_home_label_2bb9d895:

    # zo "Don't be sorry."
    zo "别道歉。"

# episode11\update11.rpy:2682
translate schinese ep11_zoey_home_label_42dc5863:

    # mc "I hope this doesn't make things turn weird between us."
    mc "我希望这不会让我们的关系变得奇怪。"

# episode11\update11.rpy:2684
translate schinese ep11_zoey_home_label_d962e40e:

    # zo "Who are we kidding? It already was weird."
    zo "我们还装什么？本来就已经很奇怪了。"

# episode11\update11.rpy:2686
translate schinese ep11_zoey_home_label_88f3b528:

    # mc "Yeah, you're right."
    mc "嗯，你说得对。"

# episode11\update11.rpy:2688
translate schinese ep11_zoey_home_label_ec9a2b83:

    # mc "So...? Hug it out?"
    mc "那……就这么算了？抱抱就完事了？"

# episode11\update11.rpy:2698
translate schinese ep11_zoey_home_label_9fed9f9b:

    # zo "That's a pretty damn good hug..."
    zo "那是个相当不错的拥抱……"

# episode11\update11.rpy:2700
translate schinese ep11_zoey_home_label_c1dff962:

    # mc "Oh..."
    mc "哦..."

# episode11\update11.rpy:2702
translate schinese ep11_zoey_home_label_b776d44a:

    # zo "What?"
    zo "什么？"

# episode11\update11.rpy:2704
translate schinese ep11_zoey_home_label_7ea51e21:

    # mc "You wanted me to keep my distance."
    mc "你希望我保持距离。"

# episode11\update11.rpy:2706
translate schinese ep11_zoey_home_label_4a10b8a9:

    # zo "Huh?"
    zo "嗯？"

# episode11\update11.rpy:2708
translate schinese ep11_zoey_home_label_56080a44:

    # mc "You're sick."
    mc "你病了。"

# episode11\update11.rpy:2710
translate schinese ep11_zoey_home_label_a66e0fad:

    # zo "Oh! Fuck..."
    zo "哦！见鬼..."

# episode11\update11.rpy:2712
translate schinese ep11_zoey_home_label_8d426778:

    # mc "It's fine. I'll take my chances."
    mc "没关系，我自认倒霉。"

# episode11\update11.rpy:2716
translate schinese ep11_zoey_home_label_fb6145dd:

    # mc "I hope you'll feel better soon."
    mc "希望你早日好起来。"

# episode11\update11.rpy:2718
translate schinese ep11_zoey_home_label_b850cb04:

    # zo "No sweat. Thanks for dropping by."
    zo "不打紧。谢谢来看我。"

# episode11\update11.rpy:2726
translate schinese ep11_zoey_home_label_fb6145dd_1:

    # mc "I hope you'll feel better soon."
    mc "希望你早日好起来。"

# episode11\update11.rpy:2728
translate schinese ep11_zoey_home_label_b850cb04_1:

    # zo "No sweat. Thanks for dropping by."
    zo "不打紧，谢谢来看我。"

# episode11\update11.rpy:2743
translate schinese ep11_sj_label_679d6b12:

    # sa "I've walked by this place many times but never went inside."
    sa "我以前经常路过这里，但从来没进去过。"

# episode11\update11.rpy:2745
translate schinese ep11_sj_label_4858acd7:

    # ji "Are you loving it yet?"
    ji "你还喜欢吗？"

# episode11\update11.rpy:2747
translate schinese ep11_sj_label_5bd8f59e:

    # sa "They seem great at what they're doing."
    sa "他们似乎很擅长自己的工作。"

# episode11\update11.rpy:2749
translate schinese ep11_sj_label_bb8dda64:

    # ji "What did you decide to get?"
    ji "你决定点什么？"

# episode11\update11.rpy:2751
translate schinese ep11_sj_label_ec9fb32c:

    # sa "Anything that keeps me from chewing on my nails."
    sa "任何能让我不咬指甲的东西。"

# episode11\update11.rpy:2753
translate schinese ep11_sj_label_f23da0b8:

    # ji "Oh, are you one of those?"
    ji "哦，你是那种人吗？"

# episode11\update11.rpy:2755
translate schinese ep11_sj_label_952364aa:

    # sa "Only when I get bored. Or when I study. Sometimes, those two coincide."
    sa "只有当我无聊或者学习的时候才会这么做。有时候这两件事刚好同时发生。"

# episode11\update11.rpy:2757
translate schinese ep11_sj_label_b0b93f87:

    # ji "I hope you're feeling better today."
    ji "希望你今天感觉好点。"

# episode11\update11.rpy:2759
translate schinese ep11_sj_label_c671f740:

    # sa "I know what you're getting at, but I don't want to have this conversation now."
    sa "我知道你想说什么，但现在不想谈这个。"

# episode11\update11.rpy:2761
translate schinese ep11_sj_label_791b0581:

    # ji "I understand. If you feel like you want to at some point..."
    ji "我明白。如果你哪天想的话……"

# episode11\update11.rpy:2765
translate schinese ep11_sj_label_04a19734:

    # sa "Sorry... I didn't mean to sound like a bitch. I appreciate that you ask, but another thing has soured my mood."
    sa "抱歉...我刚才说话有点像泼妇。谢谢你关心，但还有别的事让我心情不好。"

# episode11\update11.rpy:2767
translate schinese ep11_sj_label_a599b912:

    # ji "Do you mind sharing?"
    ji "你介意分享一下吗？"

# episode11\update11.rpy:2769
translate schinese ep11_sj_label_c74935ab:

    # sa "I went back home with [name] to meet his dad and have some late Thanksgiving dinner."
    sa "我跟[name]回了趟家，见了他爸爸，还吃了顿迟来的感恩节晚餐。"

# episode11\update11.rpy:2771
translate schinese ep11_sj_label_9453764d:

    # ji "Sorry for interrupting, but are you and [name]...?"
    ji "抱歉打扰，但你和[name]...?"

# episode11\update11.rpy:2773
translate schinese ep11_sj_label_71b8fde2:

    # sa "He's my boyfriend, yeah."
    sa "他是我男朋友，没错。"

# episode11\update11.rpy:2776
translate schinese ep11_sj_label_c68126fe:

    # ji "I see."
    ji "我明白了。"

# episode11\update11.rpy:2779
translate schinese ep11_sj_label_e4c5b147:

    # ji "That's sweet."
    ji "这挺甜的。"

# episode11\update11.rpy:2781
translate schinese ep11_sj_label_eefb3fc7:

    # sa "[name] wanted to help me take my mind off the divorce and it worked."
    sa "[name]想帮我转移离婚的烦恼，结果还真有效。"

# episode11\update11.rpy:2782
translate schinese ep11_sj_label_7b568cd8:

    # sa "Everything was great until we went to bed, and he told me he still spent time with his ex."
    sa "一切都很好，直到我们上床后，他告诉我他还是和前妻保持联系。"

# episode11\update11.rpy:2784
translate schinese ep11_sj_label_1dbef914:

    # ji "Oh?"
    ji "哦？"

# episode11\update11.rpy:2786
translate schinese ep11_sj_label_4b0d8fb8:

    # sa "Yeah! \"Oh?\" indeed."
    sa "对！确实是“哦？”啊。"

# episode11\update11.rpy:2787
translate schinese ep11_sj_label_56b551db:

    # sa "We got into a stupid argument about it, and it was hard to sleep after."
    sa "我们为此吵了一架，吵得挺傻的，之后根本睡不着。"

# episode11\update11.rpy:2789
translate schinese ep11_sj_label_a22854d4:

    # sa "Look, I get it. He's got a past, and he's had sex before..."
    sa "我明白，他有过去，也做过一些事……"

# episode11\update11.rpy:2790
translate schinese ep11_sj_label_d379d775:

    # sa "But why can't he leave that girl in the past where she belongs? Especially now, when he's with me."
    sa "但为什么他不能把那个女人留在属于她的过去里？尤其是现在，他跟我在一起的时候。"

# episode11\update11.rpy:2792
translate schinese ep11_sj_label_1a876a17:

    # sa "He told me he would see her today because they recently started reconnecting after being on a hiatus."
    sa "他跟我说今天要见她，因为他们最近重新联系上了，之前有一段冷战期。"

# episode11\update11.rpy:2793
translate schinese ep11_sj_label_a73136ac:

    # sa "And because she was his best friend from childhood, he feels that it trumps her being his ex-girlfriend."
    sa "因为他从小就是她最好的朋友，所以他觉得这点比她曾经是他的前任更重要。"

# episode11\update11.rpy:2795
translate schinese ep11_sj_label_57e69545:

    # ji "And naturally... You don't feel that way."
    ji "自然...你也没这种感觉。"

# episode11\update11.rpy:2797
translate schinese ep11_sj_label_c773a43e:

    # sa "Nope. Not one bit."
    sa "没有，一点都没有。"

# episode11\update11.rpy:2798
translate schinese ep11_sj_label_77dd5ea4:

    # sa "He wants to spend private time with his ex - a girl he fucked and had feelings for?"
    sa "他想和前任独处——一个他睡过也动过心的女孩？"

# episode11\update11.rpy:2799
translate schinese ep11_sj_label_f369f3fd:

    # sa "And I'm supposed to be ok with that? Nuh-uh. I don't think so."
    sa "难道我还该接受这种事吗？想都别想。"

# episode11\update11.rpy:2801
translate schinese ep11_sj_label_cc45bfa9:

    # ji "But if it's his best friend from childhood, she clearly means a lot to him."
    ji "但如果她是他的儿时挚友，那她显然对他意义重大。"

# episode11\update11.rpy:2803
translate schinese ep11_sj_label_21da165d:

    # sa "And that's the problem!"
    sa "这才是问题所在！"

# episode11\update11.rpy:2804
translate schinese ep11_sj_label_6207eb7a:

    # sa "Girl, that friend{b}ship{/b} sailed the moment she sat on his dick."
    sa "家伙，那个朋友{b}船{/b}坐上了他的阴茎就立刻出发了。"

# episode11\update11.rpy:2805
translate schinese ep11_sj_label_27e2700c:

    # sa "It's a hierarchy, yeah? And best friend is..."
    sa "这是个等级制度，对吧？而最好的朋友就……"

# episode11\update11.rpy:2807
translate schinese ep11_sj_label_efb71af6:

    # sa "...waaay below ex-girlfriend. In that hierarchy, it's either up and get promoted to a spouse or get the fuck out."
    sa "……远远在前任女友之下。在那个等级体系里，要么往上爬，升到配偶的位置，要么干脆滚蛋。"

# episode11\update11.rpy:2809
translate schinese ep11_sj_label_3eeccf1c:

    # sa "You can't get demoted back to best friend once you've gotten that promotion."
    sa "你一旦升职了，就别想再降回普通朋友了。"

# episode11\update11.rpy:2811
translate schinese ep11_sj_label_6cb38882:

    # ji "I wish I could advise you on what to do, but I can only sympathize with you."
    ji "我希望我能给你一些建议，但我也只能和你感同身受。"

# episode11\update11.rpy:2812
translate schinese ep11_sj_label_deb46c0e:

    # ji "Ultimately, I think it comes down to trust. I think that's what you need in a relationship."
    ji "最终来说，我觉得这都取决于信任。我觉得在一段关系里，你需要的就是信任。"

# episode11\update11.rpy:2814
translate schinese ep11_sj_label_fc892676:

    # sa "I trust him, but I don't trust her. What are her intentions?"
    sa "我相信他，但我不相信她。她有什么企图？"

# episode11\update11.rpy:2815
translate schinese ep11_sj_label_f2718545:

    # sa "She probably knows all the right buttons to push with him, too."
    sa "她大概也知道该按哪些按钮来撩他。"

# episode11\update11.rpy:2816
translate schinese ep11_sj_label_15498d39:

    # sa "I know way too little about her to trust that something won't happen between them again."
    sa "我知道她太少了，根本没法确定他们之间不会再次出事。"

# episode11\update11.rpy:2817
translate schinese ep11_sj_label_cdaf8822:

    # sa "Sorry... I'm rambling."
    sa "抱歉...我有点说多了。"

# episode11\update11.rpy:2819
translate schinese ep11_sj_label_d114b906:

    # ji "It's good. You're agitated and need to say these things to someone."
    ji "这挺好。你有点激动，需要有人听你说这些话。"

# episode11\update11.rpy:2821
translate schinese ep11_sj_label_14dca3ed:

    # sa "I should have tried to keep my cool around him..."
    sa "我应该试着在他面前保持冷静……"

# episode11\update11.rpy:2822
translate schinese ep11_sj_label_c222848f:

    # sa "I basically scolded him and sent him off to the embrace of his ex."
    sa "我基本上是责备了他，然后把他赶去投奔他前任了。"

# episode11\update11.rpy:2824
translate schinese ep11_sj_label_d0ece18e:

    # ji "I don't think you did. You're being too hard on yourself."
    ji "我觉得你没那么糟糕。你对自己太苛刻了。"

# episode11\update11.rpy:2825
translate schinese ep11_sj_label_68718485:

    # ji "Sometimes, it's good to wear your heart on your sleeve."
    ji "有时候，把心掏出来也没什么不好。"

# episode11\update11.rpy:2827
translate schinese ep11_sj_label_d36f6da3:

    # sa "If you knew me better, you'd know I usually don't."
    sa "如果你更了解我，就会知道我通常不这样。"

# episode11\update11.rpy:2829
translate schinese ep11_sj_label_1c999e37:

    # ji "Then, I'm happy you're comfortable enough sharing this with me."
    ji "然后，我很高兴你能放心跟我分享这些。"

# episode11\update11.rpy:2831
translate schinese ep11_sj_label_570365af:

    # sa "Thanks for listening and caring. Usually, I talk to [name] when I need to vent, but I can't do that this time."
    sa "谢谢你愿意听，也谢谢你关心我。平时心里难受，我都会找[name]倾诉，但这次不行。"

# episode11\update11.rpy:2833
translate schinese ep11_sj_label_07c0755a:

    # ji "Of course."
    ji "当然。"

# episode11\update11.rpy:2835
translate schinese ep11_sj_label_7ef7d717:

    # sa "[name] taught me how to fight. Little did he know that I'd end up using those moves on his ex-girlfriend."
    sa "是[name]教我打架的。他肯定没想到，我最后会把那些招式用在他前女友身上。"

# episode11\update11.rpy:2836
translate schinese ep11_sj_label_6cfae374:

    # sa "I'm gonna break the nails we make here today on her face."
    sa "我要把我们今天做的这些指甲都砸她脸上。"

# episode11\update11.rpy:2838
translate schinese ep11_sj_label_5944d2a2:

    # ji "Hahaha! Oh God. That's way too graphic!"
    ji "哈哈哈！哦天啊，这太血腥了！"

# episode11\update11.rpy:2840
translate schinese ep11_sj_label_871b714b:

    # sa "Hahaha!"
    sa "哈哈哈！"

# episode11\update11.rpy:2843
translate schinese ep11_sj_label_6d0a2291:

    # ji "I will make it my mission today to convince you not to do that."
    ji "我今天一定要说服你别这么做。"

# episode11\update11.rpy:2846
translate schinese ep11_sj_label_2c8f1016:

    # sa "Thanks."
    sa "谢谢。"

# episode11\update11.rpy:2848
