    # lan "Beer doesn't do it for me either."
    lan "啤酒对我也没用。"

# episode11\update11.rpy:379
translate schinese ep11_intro_label_6b9c0cf9:

    # than2 "How do you even know what coke does for you?"
    than2 "你怎么知道可卡因对你有什么效果？"

# episode11\update11.rpy:381
translate schinese ep11_intro_label_41149381:

    # lan "Lex told me it was awesome and she stayed up all night partying after having some."
    lan "莱克斯说那东西特别棒，抽完以后嗨了整整一夜，根本没睡。"

# episode11\update11.rpy:383
translate schinese ep11_intro_label_c55d00c0:

    # than2 "Then, get it from Alex."
    than2 "然后从Alex那儿搞点来。"

# episode11\update11.rpy:385
translate schinese ep11_intro_label_f2ff410e:

    # lan "{i}Lex{/i} doesn't have any. She only got to try it because a guy wanted to bang her at a party."
    lan "{i}莱克斯{/i}她什么都没得到。只是因为有个家伙在派对上想和她发生关系，才让她试了一下。"

# episode11\update11.rpy:387
translate schinese ep11_intro_label_58ab448d:

    # than2 "I don't have any either."
    than2 "我也没得用。"

# episode11\update11.rpy:389
translate schinese ep11_intro_label_8313b5a9:

    # lan "Fine... I'll have to ask everyone at the party for some. Let's hope there aren't any narcs there."
    lan "好吧……我只能在派对上挨个问问谁有了。希望那里没有告密的家伙。"

# episode11\update11.rpy:391
translate schinese ep11_intro_label_1771fa26:

    # than2 "That reverse psychology doesn't work on me."
    than2 "这种心理战术对我没用。"

# episode11\update11.rpy:393
translate schinese ep11_intro_label_e863f099:

    # lan "Why are you so against trying it?"
    lan "你为什么这么反对试试看？"

# episode11\update11.rpy:395
translate schinese ep11_intro_label_07b04221:

    # than2 "Because I'm not as curious about it as you are."
    than2 "因为我对这个东西没你那么好奇。"

# episode11\update11.rpy:397
translate schinese ep11_intro_label_c76a8bbd:

    # lan "Then let me have some. You don't have to try it."
    lan "那我来拿点吧。你不用试了。"

# episode11\update11.rpy:399
translate schinese ep11_intro_label_99ddc4b9:

    # than2 "And... I'd rather not deal with those guys more than when I need to buy something. They creep me out."
    than2 "而且...我宁愿不要和那些家伙打交道，除非我真的需要买东西。他们让我感到很不舒服。"

# episode11\update11.rpy:401
translate schinese ep11_intro_label_85888291:

    # lan "Aw! Are you scared?"
    lan "哎呀，你怕了？"

# episode11\update11.rpy:403
translate schinese ep11_intro_label_70eb8d68:

    # than2 "I'm not scared."
    than2 "我不怕。"

# episode11\update11.rpy:405
translate schinese ep11_intro_label_54e33ff0:

    # lan "Li'l Than is scured."
    lan "小泰害怕了。"

# episode11\update11.rpy:407
translate schinese ep11_intro_label_98c6cc5c:

    # than2 "Stop that."
    than2 "别那样。"

# episode11\update11.rpy:409
translate schinese ep11_intro_label_4b64ac6a:

    # lan "The big boys are scury. Than is walking on his tippy toes to avoid them."
    lan "那些大块头很吓人。坦正踮着脚尖躲着他们走。"

# episode11\update11.rpy:411
translate schinese ep11_intro_label_30e12328:

    # than2 "You think you're cute, but you're just annoying."
    than2 "你以为自己很可爱，但你只是在烦人。"

# episode11\update11.rpy:413
translate schinese ep11_intro_label_6d6f8eeb:

    # lan "Wrong! I wanted to be annoying."
    lan "错啦！我想当个烦人精。"

# episode11\update11.rpy:415
translate schinese ep11_intro_label_b597c153:

    # lan "*{i}Smack{/i}*"
    lan "*{i}打耳光{/i}*"

# episode11\update11.rpy:417
translate schinese ep11_intro_label_6ae8b4bd:

    # than2 "Big birthday party next week?"
    than2 "下周有个大生日派对？"

# episode11\update11.rpy:419
translate schinese ep11_intro_label_ebde19d5:

    # lan "The only party I'm interested in is tonight."
    lan "我唯一感兴趣的派对就是今晚的。"

# episode11\update11.rpy:421
translate schinese ep11_intro_label_aaf1d4d4:

    # than2 "I know, but..."
    than2 "我知道，但..."

# episode11\update11.rpy:423
translate schinese ep11_intro_label_a76157a6:

    # lan "No buts. I'm done pretending everything is fine with my family."
    lan "没得商量。我受够了假装家里一切安好。"

# episode11\update11.rpy:424
translate schinese ep11_intro_label_9d43b6b1:

    # lan "Another year older, another level of their bitching."
    lan "又大一岁，他们抱怨的层次也又上了一个台阶。"

# episode11\update11.rpy:426
translate schinese ep11_intro_label_7afddc70:

    # than2 "I thought you said they were trying with you."
    than2 "我以为你刚才说他们是在试着引导你。"

# episode11\update11.rpy:430
translate schinese ep11_intro_label_0f9ebcea:

    # lan "Trying, as in they're expecting me to \"grow up\" and will wait for it to happen."
    lan "尝试着，就像他们希望我“长大”，等着我自然就长大了。"

# episode11\update11.rpy:431
translate schinese ep11_intro_label_702141ac:

    # lan "But they don't want me to grow up how I want to. They're impossible."
    lan "但他们不让我按照自己想的方式长大。他们真是难搞。"

# episode11\update11.rpy:433
translate schinese ep11_intro_label_4fa008eb:

    # lan "And I know they're doing that with Jill, too. Seeing how they failed with me makes them try harder with her."
    lan "而且我知道他们也在对Jill这么做。看到他们没能控制我，只会让他们更想控制她。"

# episode11\update11.rpy:434
translate schinese ep11_intro_label_b297d038:

    # lan "They're so controlling! Jill isn't a lump of clay they can shape however they want."
    lan "他们管得太宽了！Jill不是一块任他们随意捏塑的泥巴。"

# episode11\update11.rpy:435
translate schinese ep11_intro_label_1756c4e3:

    # lan "What about her dreams, thoughts, and ideas, which she shares with me when we're alone? Don't they matter?"
    lan "她那些梦想、想法和念头呢？我们独处时她和我分享的一切，难道就不重要了吗？"

# episode11\update11.rpy:437
translate schinese ep11_intro_label_6a1f48f2:

    # than2 "That's parents for you. Mine are the same, but at least they act like my lifestyle doesn't bother them."
    than2 "这就是父母嘛。我爸妈也一样，至少他们装作不介意我的生活方式。"

# episode11\update11.rpy:438
translate schinese ep11_intro_label_3681f190:

    # than2 "I don't want to be a doctor or a realtor. Just because they're smart doesn't mean that I am."
    than2 "我不想当医生或者房地产中介。他们聪明不代表我也是。"

# episode11\update11.rpy:440
translate schinese ep11_intro_label_87e5de77:

    # lan "But you are smart. You're talented and have way more brains than you give yourself credit for."
    lan "但你很聪明。你有才华，脑子比你自己认为的要灵光得多。"

# episode11\update11.rpy:442
translate schinese ep11_intro_label_5afe2f1c:

    # than2 "I'm not smart. I'm stupid and I'm perfectly fine with that. I have nothing to prove, especially not to my parents."
    than2 "我不聪明。我就是个蠢货，我挺满意的。我没什么好证明的，尤其是给我的父母看。"

# episode11\update11.rpy:444
translate schinese ep11_intro_label_2caa25ca:

    # lan "I'll go to the birthday party... But I'm only going because of Jill."
    lan "我会上那个生日派对……但我只去是因为Jill。"

# episode11\update11.rpy:445
translate schinese ep11_intro_label_04dab143:

    # lan "Mom had already spoiled the surprise and told me that Jill had made me something in school. That was Mom's way of making sure I'd show up."
    lan "我妈已经把惊喜搞砸了，告诉我Jill在学校给我做了点什么。这是她确保我到场的手段。"

# episode11\update11.rpy:446
translate schinese ep11_intro_label_8371d108:

    # lan "She knows Jill's the only reason I'm still going back there."
    lan "她知道Jill是我还愿意回去的唯一原因。"

# episode11\update11.rpy:453
translate schinese ep11_intro_label_61a60509:

    # lan "Well... Jill and the weed. But Mom doesn't have to know about my secret stash."
    lan "嗯……Jill，还有大麻。不过我妈不必知道我藏着私货。"

# episode11\update11.rpy:454
translate schinese ep11_intro_label_c50d7d1a:

    # lan "I'd hide it at your place if I trusted you not to smoke it."
    lan "我会把它们藏在你那儿，如果我相信你不会抽掉的话。"

# episode11\update11.rpy:458
translate schinese ep11_intro_label_9d09e0e4:

    # than2 "That's hilarious because it's the other way around, and you know it..."
    than2 "这可真好笑，情况正好相反，你心里清楚。"

# episode11\update11.rpy:460
translate schinese ep11_intro_label_5dbcbf15:

    # lan "I'm bored... Wanna head to the party early?"
    lan "我有点无聊……要不要提前去派对？"

# episode11\update11.rpy:462
translate schinese ep11_intro_label_bcc2ef40:

    # than2 "Yeah. But let's make a stop on the way."
    than2 "嗯。不过我们路上停一下。"

# episode11\update11.rpy:464
translate schinese ep11_intro_label_18e0d7c2:

    # lan "Where at?"
    lan "在哪？"

# episode11\update11.rpy:466
translate schinese ep11_intro_label_c2f62ecc:

    # than2 "At the scary big boys."
    than2 "在那些可怕的家伙那儿。"

# episode11\update11.rpy:468
translate schinese ep11_intro_label_70216893:

    # lan "No way!?"
    lan "不可能！？"

# episode11\update11.rpy:470
translate schinese ep11_intro_label_b7f0b2bd:

    # than2 "But you can't use your birthday on me again until next year."
    than2 "但你得等明年才能用生日来要挟我了。"

# episode11\update11.rpy:472
translate schinese ep11_intro_label_7a45ffce:

    # lan "Haha! I don't have to use it. Christmas is coming."
    lan "哈哈！我可不用这个。圣诞节快到了。"

# episode11\update11.rpy:474
translate schinese ep11_intro_label_d3a51317:

    # than2 "Yeah, and you're still wearing shorts. What the fuck is wrong with you?"
    than2 "是啊，你居然还穿着短裤。你他妈有什么毛病？"

# episode11\update11.rpy:476
translate schinese ep11_intro_label_bb4c6182:

    # lan "Do you want me to wear the clothes Mom laid out for me? Is that a secret fetish of yours?"
    lan "你想让我穿妈妈给我准备的衣服吗？这难道是你的什么隐秘癖好？"

# episode11\update11.rpy:478
translate schinese ep11_intro_label_2458fe43:

    # than2 "Freeze to death, then. Be my guest."
    than2 "那就冻死吧，随你便。"

# episode11\update11.rpy:479
translate schinese ep11_intro_label_b7d6f0f1:

    # lan "You sound just like her."
    lan "你听起来跟她一模一样。"

# episode11\update11.rpy:481
translate schinese ep11_intro_label_0516e2d3:

    # than2 "Wait here."
    than2 "等一下。"

# episode11\update11.rpy:483
translate schinese ep11_intro_label_5e813f3d:

    # lan "I thought you said I could come with you."
    lan "我以为你跟我说过我可以跟你一起去。"

# episode11\update11.rpy:485
translate schinese ep11_intro_label_c2461334:

    # than2 "I need to use the payphone and call ahead. They're not cool with me walking in there unannounced."
    than2 "我得用付费电话提前打个招呼，他们不欢迎我突然闯进去。"

# episode11\update11.rpy:487
translate schinese ep11_intro_label_d3ecd366:

    # lan "Oh, alright."
    lan "哦，行吧。"

# episode11\update11.rpy:500
translate schinese ep11_intro_label_4faa4087:

    # lan "So?"
    lan "所以呢？"

# episode11\update11.rpy:502
translate schinese ep11_intro_label_bd9ba0e7:

    # than2 "You're not getting much. You're getting some."
    than2 "你没捞到多少，就那么一点。"

# episode11\update11.rpy:504
translate schinese ep11_intro_label_9ef5c25f:

    # lan "Is that your call or his?"
    lan "这是你决定的还是他？"

# episode11\update11.rpy:506
translate schinese ep11_intro_label_d3d351ee:

    # than2 "Why do you gotta be difficult all the time?"
    than2 "你干嘛总是这么难搞？"

# episode11\update11.rpy:508
translate schinese ep11_intro_label_59d85bab:

    # lan "Got it. It's your call."
    lan "明白了，这由你决定。"

# episode11\update11.rpy:510
translate schinese ep11_intro_label_25a702a0:

    # than2 "Since it's your first time, I'm not letting you have much."
    than2 "既然你是第一次，我可不会让你拿太多。"

# episode11\update11.rpy:512
translate schinese ep11_intro_label_4a145bc8:

    # lan "You don't even know what much of it is."
    lan "你连多少算多都不知道。"

# episode11\update11.rpy:514
translate schinese ep11_intro_label_a4d8fd50:

    # than2 "But they do. I told him I wanted a party's worth for a rookie."
    than2 "但他们会的。我跟他说过，作为新人，我想要一场派对的份量。"

# episode11\update11.rpy:516
translate schinese ep11_intro_label_45c3cebd:

    # lan "Haha! He's gonna think you're the rookie now."
    lan "哈哈！他现在可要以为你是新手了。"

# episode11\update11.rpy:518
translate schinese ep11_intro_label_4bcee788_1:

    # than2 "..."
    than2 "..."

# episode11\update11.rpy:519
translate schinese ep11_intro_label_751239d3:

    # than2 "Damn... I didn't think about that."
    than2 "他妈的，我都没想到这点。"

# episode11\update11.rpy:521
translate schinese ep11_intro_label_20660c22:

    # than2 "But they will see you with me and understand it."
    than2 "但他们会看到我和你在一起，自然就懂了。"

# episode11\update11.rpy:523
translate schinese ep11_intro_label_9f871e46:

    # lan "Drug dealers are all understanding, aren't they?"
    lan "毒贩子们都很理解人，不是吗？"

# episode11\update11.rpy:525
translate schinese ep11_intro_label_e37bb589:

    # than2 "On second thought... Maybe it's best if you wait in the car."
    than2 "三思之下……也许你最好还是待在车里。"

# episode11\update11.rpy:527
translate schinese ep11_intro_label_f4f1644c:

    # lan "Then who's gonna protect you from the big boys?"
    lan "那谁来保护你这些大块头呢？"

# episode11\update11.rpy:529
translate schinese ep11_intro_label_83765e8e:

    # than2 "I'm not joking around. They carry guns."
    than2 "我可不是开玩笑。他们带着枪。"

# episode11\update11.rpy:531
translate schinese ep11_intro_label_690ea16a:

    # lan "I'm not scared of them."
    lan "我才不怕他们。"

# episode11\update11.rpy:533
translate schinese ep11_intro_label_8cd29169:

    # than2 "And that makes me scared."
    than2 "这让我有点害怕。"

# episode11\update11.rpy:534
translate schinese ep11_intro_label_bd9e4f12:

    # than2 "Look, it's just a business transaction. We walk in, we present him the money, he hands us the merchandise, and we're on our way."
    than2 "说白了，这不过是一场生意。我们进去，给他钱，他给我们货，然后我们就走人。"

# episode11\update11.rpy:535
translate schinese ep11_intro_label_6d84905d:

    # than2 "No pleasantries or other exchange of words."
    than2 "没有寒暄或者其他废话。"

# episode11\update11.rpy:537
translate schinese ep11_intro_label_b25322fd:

    # lan "You sound like Dad when you talk all formal like that."
    lan "你说话的样子真像你爸，整天板着脸一本正经的。"

# episode11\update11.rpy:539
translate schinese ep11_intro_label_21206d56:

    # than2 "Your dad used coke?"
    than2 "你爸用过可卡因吗？"

# episode11\update11.rpy:541
translate schinese ep11_intro_label_a289ec36:

    # lan "I wouldn't put it past him, at least when he was young. Not that he'd ever tell me."
    lan "我可不会觉得他做不到，至少在他年轻的时候。不是说他现在会告诉我这些。"

# episode11\update11.rpy:543
translate schinese ep11_intro_label_7d34cd98:

    # than2 "I think Dad used it, too."
    than2 "我想我爸也用过。"

# episode11\update11.rpy:545
translate schinese ep11_intro_label_2e9508bc:

    # lan "That's likely why they get along so well. Double standards galore."
    lan "这大概就是他们相处这么融洽的原因。双重标准一大堆。"

# episode11\update11.rpy:547
translate schinese ep11_intro_label_ea12c857:

    # than2 "Ok. No more talking until we're back in the car. Be cool and quiet."
    than2 "好，别再说话，等我们回到车里再说。保持酷劲，别出声。"

# episode11\update11.rpy:550
translate schinese ep11_intro_label_fda48dfd:

    # lan "When am I not cool?"
    lan "我什么时候不酷？"

# episode11\update11.rpy:552
translate schinese ep11_intro_label_ad3cc74a:

    # than2 "When are you ever quiet?"
    than2 "你什么时候能安静下来？"

# episode11\update11.rpy:554
translate schinese ep11_intro_label_d3f78280:

    # lan "Haha, shut up! I'll show you."
    lan "哈哈，闭嘴！我让你看看。"

# episode11\update11.rpy:560
translate schinese ep11_intro_label_e86942d2:

    # bd "That's what I'm saying! With the rats!"
    bd "这就是我说的！那些老鼠！"

# episode11\update11.rpy:562
translate schinese ep11_intro_label_22bf8a9f:

    # bd "He should have killed him, pushed him over the ledge and down there in the gutter-"
    bd "他应该直接杀了他，把他推下悬崖，扔进下水道里——"

# episode11\update11.rpy:564
translate schinese ep11_intro_label_75dc9928:

    # bd "-there's the fucking rat!"
    bd "那儿就是那只他妈的耗子！"

# episode11\update11.rpy:566
translate schinese ep11_intro_label_fcb2db01:

    # rx "That would have fucked with the whole message of the movie!"
    rx "那会毁掉整部电影想表达的意思！"

# episode11\update11.rpy:567
translate schinese ep11_intro_label_721f0abc:

    # rx "The rat was the message!"
    rx "老鼠就是信息！"

# episode11\update11.rpy:569
translate schinese ep11_intro_label_e9eba9c5:

    # rx "Yeah, it was a bit cheesy, I'll give you that. But point is, no matter how high you climb..."
    rx "嗯，确实有点俗套，我承认。但重点是，不管你爬得多高……"

# episode11\update11.rpy:571
translate schinese ep11_intro_label_05312774:

    # rx "...the rats find their way to get to you. You can't get rid of the rats."
    rx "……老鼠总能找到你，你甩不掉它们。"

# episode11\update11.rpy:572
translate schinese ep11_intro_label_e0c617da:

    # bd "That rat was some CGI bullshit anyway."
    bd "那只老鼠本来就是一堆CGI垃圾罢了。"

# episode11\update11.rpy:574
translate schinese ep11_intro_label_f51fb07f:

    # rx "Hehe! You don't think they trained one to do that?"
    rx "嘿嘿！你不会以为他们训练了一只来干这个的吧？"

# episode11\update11.rpy:576
translate schinese ep11_intro_label_de686c98:

    # rx "You know, like a- What's the word?"
    rx "你懂的，就像——那个词叫什么？"

# episode11\update11.rpy:578
translate schinese ep11_intro_label_a57ea057:

    # rx "Off you go."
    rx "你走吧。"

# episode11\update11.rpy:580
translate schinese ep11_intro_label_dcb6c222:

    # bd "Like a circus?"
    bd "像马戏团一样？"

# episode11\update11.rpy:581
translate schinese ep11_intro_label_0e828ec2:

    # rx "Yeah, something like that."
    rx "对，差不多吧。"

# episode11\update11.rpy:583
translate schinese ep11_intro_label_c07ff4ae:

    # bd "I fucking hate rats."
    bd "我他妈恨老鼠。"

# episode11\update11.rpy:586
translate schinese ep11_intro_label_af08cc70:

    # than2 "Are you good?"
    than2 "你还好吗？"

# episode11\update11.rpy:589
translate schinese ep11_intro_label_e1f1c41c:

    # lan "I'm not gonna lie. When I heard them talking about killing someone, my heart skipped a beat."
    lan "说实话，听到他们谈论杀人时，我的心都漏跳了一拍。"

# episode11\update11.rpy:591
translate schinese ep11_intro_label_61875642:

    # than2 "I think it was movie talk."
    than2 "我想他们是在谈电影。"

# episode11\update11.rpy:593
translate schinese ep11_intro_label_fa9fdabf:

    # lan "Yeah, I got that. But fuck..."
    lan "嗯，我懂了。但操……"

# episode11\update11.rpy:595
translate schinese ep11_intro_label_17380fd2:

    # than2 "Aw..."
    than2 "啊..."

# episode11\update11.rpy:597
translate schinese ep11_intro_label_4b385846:

    # lan "Aw, what?"
    lan "哎呀，怎么了？"

# episode11\update11.rpy:599
translate schinese ep11_intro_label_69a1b27b:

    # than2 "Is Li'l Lana scured?"
