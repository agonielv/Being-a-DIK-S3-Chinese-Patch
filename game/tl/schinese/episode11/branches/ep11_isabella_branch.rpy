# episode11\branches\ep11_isabella_branch.rpy:6
translate schinese ep11_bella_home_label_251d266b:

    # mc "Yikes..."
    mc "啧..."

# episode11\branches\ep11_isabella_branch.rpy:8
translate schinese ep11_bella_home_label_592f54d6:

    # isa "That's Ephraim. He goes by the window."
    isa "那是埃弗雷姆，把它放在窗边。"

# episode11\branches\ep11_isabella_branch.rpy:9
translate schinese ep11_bella_home_label_0d3010d4:

    # mc "Do you mean I should throw it out of the window? Because I'll be happy to. He's hideous."
    mc "你是指我应该把它扔出窗外吗？因为我很乐意这么做。他丑得要命。"

# episode11\branches\ep11_isabella_branch.rpy:10
translate schinese ep11_bella_home_label_813dcdee:

    # isa "He's not hideous. He's a cute little Santa."
    isa "他不丑，他是个可爱的小圣诞老人。"

# episode11\branches\ep11_isabella_branch.rpy:12
translate schinese ep11_bella_home_label_a8c78b0a:

    # mc "You can't possibly call this squished-up thing cute."
    mc "这皱巴巴的小东西，你居然觉得可爱？"

# episode11\branches\ep11_isabella_branch.rpy:14
translate schinese ep11_bella_home_label_6be62d60:

    # isa "He is. There's a switch under his feet, too. Flip it and see if the batteries are still working."
    isa "就是可爱。它脚底还有个开关呢，拨一下，看看电池还有没有电。"

# episode11\branches\ep11_isabella_branch.rpy:17
translate schinese ep11_bella_home_label_c1996fae:

    # mc "He lights up?"
    mc "他亮起来啦？"

# episode11\branches\ep11_isabella_branch.rpy:19
translate schinese ep11_bella_home_label_19e32089:

    # isa "Neat, huh?"
    isa "挺好玩吧？"

# episode11\branches\ep11_isabella_branch.rpy:21
translate schinese ep11_bella_home_label_07912d5f:

    # mc "What a shame... He'll steal the attention from everything else in here. Are you sure that you want that?"
    mc "真可惜……他肯定会抢走这里所有人的注意力。你确定要这样吗？"

# episode11\branches\ep11_isabella_branch.rpy:23
translate schinese ep11_bella_home_label_d05bd518:

    # isa "It's not Christmas without Ephraim."
    isa "没有埃弗雷姆，就不是圣诞节。"

# episode11\branches\ep11_isabella_branch.rpy:25
translate schinese ep11_bella_home_label_3d22e6bf:

    # mc "Do you always have this much decoration?"
    mc "你每次都摆这么多装饰吗？"

# episode11\branches\ep11_isabella_branch.rpy:27
translate schinese ep11_bella_home_label_3a8db2ba:

    # isa "Not always. Only during Christmas."
    isa "不总是。只在圣诞节的时候。"

# episode11\branches\ep11_isabella_branch.rpy:29
translate schinese ep11_bella_home_label_37853777:

    # mc "You knew what I meant."
    mc "你明白我的意思。"

# episode11\branches\ep11_isabella_branch.rpy:31
translate schinese ep11_bella_home_label_479e2c51:

    # isa "If you don't want to help, you don't have to. You can sit down and watch me do the rest or get started on the cookies."
    isa "如果你不想帮忙，那就不帮好了。你可以坐下来看着我搞定剩下的，或者先去开始做饼干。"

# episode11\branches\ep11_isabella_branch.rpy:33
translate schinese ep11_bella_home_label_cddd7310:

    # mc "I didn't say I didn't want to help, but it's a lot of work for one holiday."
    mc "我没说我不想帮忙，但一个节日要干这么多活确实挺累的。"

# episode11\branches\ep11_isabella_branch.rpy:35
translate schinese ep11_bella_home_label_035c799e:

    # isa "It is. And I force myself to enjoy doing it."
    isa "它就是。我强迫自己享受这个过程。"

# episode11\branches\ep11_isabella_branch.rpy:37
translate schinese ep11_bella_home_label_ee014b96:

    # mc "If you force yourself to enjoy it, you're not enjoying it."
    mc "如果你强迫自己去享受，那你就根本没在享受。"

# episode11\branches\ep11_isabella_branch.rpy:39
translate schinese ep11_bella_home_label_3fcb9f21:

    # isa "That's Christmas... Not everyone enjoys it."
    isa "这就是圣诞节……并不是每个人都喜欢它。"

# episode11\branches\ep11_isabella_branch.rpy:41
translate schinese ep11_bella_home_label_688e227f:

    # mc "Hey, then you're like me. I don't like winter."
    mc "嘿，那你跟我一样。我不喜欢冬天。"

# episode11\branches\ep11_isabella_branch.rpy:43
translate schinese ep11_bella_home_label_b51a5a5b:

    # isa "Not quite. I like winter, but not Christmas anymore."
    isa "不完全是。我喜欢冬天，但不再喜欢圣诞节了。"

# episode11\branches\ep11_isabella_branch.rpy:45
translate schinese ep11_bella_home_label_ab5024c4:

    # mc "That's odd."
    mc "这有点奇怪。"

# episode11\branches\ep11_isabella_branch.rpy:47
translate schinese ep11_bella_home_label_5dfee003:

    # isa "Not really. Christmas is for family to celebrate. I used to love Christmas."
    isa "也不奇怪。圣诞节是和家人一起过的。我以前很喜欢圣诞节。"

# episode11\branches\ep11_isabella_branch.rpy:49
translate schinese ep11_bella_home_label_c1dff962:

    # mc "Oh..."
    mc "哦..."

# episode11\branches\ep11_isabella_branch.rpy:51
translate schinese ep11_bella_home_label_b7c419fc:

    # isa "Many people are alone during the holidays. That's just how it is."
    isa "很多人在假期的时候都是一个人。这就是现实。"

# episode11\branches\ep11_isabella_branch.rpy:53
translate schinese ep11_bella_home_label_efbbaa3a:

    # mc "What about your relatives?"
    mc "那你的亲戚呢？"

# episode11\branches\ep11_isabella_branch.rpy:55
translate schinese ep11_bella_home_label_7437240a:

    # isa "*{i}Groans{/i}*"
    isa "*{i}呻吟{/i}*"

# episode11\branches\ep11_isabella_branch.rpy:57
translate schinese ep11_bella_home_label_ccd65f9b:

    # isa "Please don't feel bad for me. It's just for a few days. And besides, this year, I get to celebrate it with you guys."
    isa "别为我感到难过。就几天而已。而且今年，我还能和你们一起庆祝。"

# episode11\branches\ep11_isabella_branch.rpy:59
translate schinese ep11_bella_home_label_61adbbae:

    # mc "(That's why she's so excited about it... I should have stopped to think. Of course, that's why.)"
    mc "（原来这才是她这么期待的原因……我早该好好想想。当然是因为这个啊。）"

# episode11\branches\ep11_isabella_branch.rpy:61
translate schinese ep11_bella_home_label_66b74ffe:

    # mc "Then we'll make this celebration count. I'm looking forward to it."
    mc "那我们就让这次庆祝变得有意义。我可期待了。"

# episode11\branches\ep11_isabella_branch.rpy:63
translate schinese ep11_bella_home_label_75cb2883:

    # isa "That's the spirit."
    isa "这才对嘛。"

# episode11\branches\ep11_isabella_branch.rpy:64
translate schinese ep11_bella_home_label_c0888c34:

    # isa "And what about you? Do you at least enjoy Christmas?"
    isa "那你是怎么过的？你至少喜欢圣诞节吗？"

# episode11\branches\ep11_isabella_branch.rpy:66
translate schinese ep11_bella_home_label_97ea6d50:

    # mc "I do. I guess we are opposites."
    mc "喜欢。看来我们正好相反。"

# episode11\branches\ep11_isabella_branch.rpy:67
translate schinese ep11_bella_home_label_7fd246bc:

    # mc "It's just Dad and I who celebrate, but that's what my holidays always were growing up. It's our tradition."
    mc "就我和我爸两个人过节，但这就是我小时候过节的样子。一直都是我们的传统。"

# episode11\branches\ep11_isabella_branch.rpy:69
translate schinese ep11_bella_home_label_dd48c373:

    # isa "Do you bake cookies and decorate the home, too?"
    isa "你也会烤饼干、布置家里吗？"

# episode11\branches\ep11_isabella_branch.rpy:71
translate schinese ep11_bella_home_label_9aec75aa:

    # mc "Some decorations, yes. Like a Christmas tree. You gotta have that."
    mc "有些装饰，比如圣诞树，你得弄一个。"

# episode11\branches\ep11_isabella_branch.rpy:72
translate schinese ep11_bella_home_label_c5e82d1a:

    # mc "The cookies are usually store-bought."
    mc "通常都是买的现成的。"

# episode11\branches\ep11_isabella_branch.rpy:74
translate schinese ep11_bella_home_label_a0b64ca4:

    # mc "I'd invite you over for Christmas, but..."
    mc "我本想邀请你来家里过圣诞节，但……"

# episode11\branches\ep11_isabella_branch.rpy:75
translate schinese ep11_bella_home_label_9fbf9016:

    # mc "I haven't figured out how I should broach the subject of us with Dad."
    mc "我还没想好该怎么跟爸爸提起我们俩的事。"

# episode11\branches\ep11_isabella_branch.rpy:76
translate schinese ep11_bella_home_label_76cb492d:

    # mc "I told him about you, but he's under the impression that you're my age."
    mc "我跟他提过你，但他以为你跟我年纪差不多。"

# episode11\branches\ep11_isabella_branch.rpy:78
translate schinese ep11_bella_home_label_b20b9ce4:

    # isa "You don't have to explain. If you ask me, I think it's for the best that you don't."
    isa "你不用解释。要我说，我觉得你不用说出来最好。"

# episode11\branches\ep11_isabella_branch.rpy:80
translate schinese ep11_bella_home_label_c18529a0:

    # isa "How do I put this?"
    isa "我该怎么说呢？"

# episode11\branches\ep11_isabella_branch.rpy:81
translate schinese ep11_bella_home_label_1cdd7159:

    # isa "What we have is...new and exciting. It's a special connection that others won't understand."
    isa "我们之间有的是……新鲜又刺激的感觉。这是一种别人无法理解的特别联系。"

# episode11\branches\ep11_isabella_branch.rpy:83
translate schinese ep11_bella_home_label_3fd25fd5:

    # isa "They will look at us and see a 36-year-old woman together with a 19-year-old \"boy\" and find it inappropriate."
    isa "他们看到我们会觉得是一个36岁的女人和一个19岁的“男孩”在一起，会觉得不合适。"

# episode11\branches\ep11_isabella_branch.rpy:85
translate schinese ep11_bella_home_label_d2560664:

    # mc "Is that how you feel about it? Are you ashamed of our age gap?"
    mc "这正是你对这件事的感觉吗？你对我们年龄差感到羞耻吗？"

# episode11\branches\ep11_isabella_branch.rpy:87
translate schinese ep11_bella_home_label_31d30dc0:

    # isa "I wouldn't say I'm ashamed of it. But I'm ashamed of the teacher-student aspect of our relationship."
    isa "我不觉得我为此感到羞耻。但我觉得我们关系里老师和学生的那一面才让人难堪。"

# episode11\branches\ep11_isabella_branch.rpy:89
translate schinese ep11_bella_home_label_95e31ddc:

    # mc "But that's not an issue for us."
    mc "但这对我们来说不是问题。"

# episode11\branches\ep11_isabella_branch.rpy:91
translate schinese ep11_bella_home_label_fb623a7e:

    # isa "..."
    isa "..."

# episode11\branches\ep11_isabella_branch.rpy:93
translate schinese ep11_bella_home_label_71815f54:

    # isa "*{i}Sigh{/i}* Crap..."
    isa "*{i}叹气{/i}* 糟了……"

# episode11\branches\ep11_isabella_branch.rpy:95
translate schinese ep11_bella_home_label_11455b53:

    # mc "What?"
    mc "什么？"

# episode11\branches\ep11_isabella_branch.rpy:97
translate schinese ep11_bella_home_label_b9728ffa:

    # isa "I haven't been completely honest with you. About the handbook..."
    isa "我还没完全对你坦白。关于那本手册……"

# episode11\branches\ep11_isabella_branch.rpy:98
translate schinese ep11_bella_home_label_94334ebd:

    # isa "B&R doesn't allow teachers to date students."
    isa "B&R 不允许老师和学生谈恋爱。"

# episode11\branches\ep11_isabella_branch.rpy:100
translate schinese ep11_bella_home_label_1a0a0355:

    # mc "Whoa, whoa, whoa. What? Are you serious? You said it was fine."
    mc "等等，等等。什么？你认真的？你不是说没问题吗？"

# episode11\branches\ep11_isabella_branch.rpy:102
translate schinese ep11_bella_home_label_c83b366f:

    # isa "I said the lines were blurry, and they are. It doesn't say anything about employees dating students, but now that I'm your teacher, it's a different story..."
    isa "我说过界限模糊，现在确实如此。它没说员工不能和学生谈恋爱，但现在我成了你的老师，情况就不同了……"

# episode11\branches\ep11_isabella_branch.rpy:103
translate schinese ep11_bella_home_label_282a1e42:

    # isa "They allow disclosed relationships, but I believe that rule exists to cover fringe cases, such as when teachers are re-educated through B&R while married to another staff member."
    isa "规定允许已报备的关系，但我想，那是为了照顾一些特殊情况。比如老师回 B&R 进修，而配偶也是这里的教职员工。"

# episode11\branches\ep11_isabella_branch.rpy:105
translate schinese ep11_bella_home_label_1c7c7eef:

    # mc "You knew this all this time and didn't tell me?"
    mc "你早知道这件事，却一直没告诉我？"

# episode11\branches\ep11_isabella_branch.rpy:107
translate schinese ep11_bella_home_label_d3efd05f:

    # isa "No, not all this time. I looked it up after we broached the subject."
    isa "不是，不是一直都知道。我们谈到这个话题后，我查了一下规定。"

# episode11\branches\ep11_isabella_branch.rpy:108
translate schinese ep11_bella_home_label_21030908:

    # isa "I'm sorry. I should have told you, but I thought you'd get upset and maybe try to do something about it."
    isa "对不起，我应该早点告诉你，但我以为你会生气，也许会想办法解决这个问题。"

# episode11\branches\ep11_isabella_branch.rpy:109
translate schinese ep11_bella_home_label_38919b38:

    # isa "We'll be fine if we keep this between us."
    isa "我们只要保持低调就行。"

# episode11\branches\ep11_isabella_branch.rpy:111
translate schinese ep11_bella_home_label_e5b5d8d1:

    # mc "Do we have to hide it?"
    mc "我们得藏起来吗？"

# episode11\branches\ep11_isabella_branch.rpy:113
translate schinese ep11_bella_home_label_a4b5e649:

    # isa "We already did. It doesn't make much of a difference."
    isa "我们本来就在瞒着，没多大区别。"

# episode11\branches\ep11_isabella_branch.rpy:115
translate schinese ep11_bella_home_label_9e7839b1:

    # mc "It does to me..."
    mc "对我来说，有区别……"

# episode11\branches\ep11_isabella_branch.rpy:116
translate schinese ep11_bella_home_label_7cec7eaa:

    # mc "I was hoping we could be more open about it at some point... Maybe after we had figured out what this is and if we wanted to take the next step."
    mc "我原本希望，到了某个时候，我们可以公开一些……也许等我们弄清楚彼此的关系，决定要不要更进一步之后。"

# episode11\branches\ep11_isabella_branch.rpy:118
translate schinese ep11_bella_home_label_3e00bb77:

    # isa "I know. I don't want this rulebook to come between us."
    isa "我知道。我不想这条规矩把我们给分开了。"

# episode11\branches\ep11_isabella_branch.rpy:119
translate schinese ep11_bella_home_label_3e64f39d:

    # isa "And I'm not confident enough in our relationship to risk anything yet."
    isa "而且我现在还不确定我们的关系够稳定，能承担起任何风险。"

# episode11\branches\ep11_isabella_branch.rpy:121
translate schinese ep11_bella_home_label_b2b9e19d:

    # mc "What do you mean?"
    mc "你是什么意思？"

# episode11\branches\ep11_isabella_branch.rpy:123
translate schinese ep11_bella_home_label_3afd537a:

    # isa "Changing jobs or stopping teaching altogether are solutions, but it's too soon to consider. I hope you understand that."
    isa "换工作或者干脆停止教学都是解决办法，但现在还太早了。我希望你能理解这一点。"

# episode11\branches\ep11_isabella_branch.rpy:125
translate schinese ep11_bella_home_label_1f76665b:

    # mc "I would never ask you to do that... I could change some classes in my curriculum or something."
    mc "我绝不会要求你那么做……我可以换几门课，或者想点别的办法。"

# episode11\branches\ep11_isabella_branch.rpy:127
translate schinese ep11_bella_home_label_309c0780:

    # isa "It doesn't matter. I'm still a teacher, and you're still a student. And I don't want you to change your studies because of me."
    isa "那也没用。我还是老师，你还是学生。而且，我不想让你为了我改变学业安排。"

# episode11\branches\ep11_isabella_branch.rpy:129
translate schinese ep11_bella_home_label_7e0a9bc8:

    # isa "I'm sorry, [name]. I should have told you the minute I found out...but I was scared I'd lose you..."
    isa "对不起，[name]我应该一发现就告诉你……但我害怕会失去你"

# episode11\branches\ep11_isabella_branch.rpy:130
translate schinese ep11_bella_home_label_e5f34b73:

    # isa "And I was angry...because the moment I started to feel happy again, this happened."
    isa "而我那时很生气……因为就在我觉得自己又能开心起来的时候，这种事情发生了。"

# episode11\branches\ep11_isabella_branch.rpy:132
translate schinese ep11_bella_home_label_07d29665:

    # mc "What are the consequences if they find out? Would they fire you?"
    mc "如果他们知道了会有什么后果？他们会开除你吗？"

# episode11\branches\ep11_isabella_branch.rpy:134
translate schinese ep11_bella_home_label_af048062:

    # isa "Most likely, yes."
    isa "很可能，是的。"

# episode11\branches\ep11_isabella_branch.rpy:136
translate schinese ep11_bella_home_label_29d45477:

    # mc "And what about me? Would I get suspended? I mean, I'm an adult. I don't see why they should have a say in this."
    mc "那我呢？我会被停学吗？我是说，我已经成年了。不明白学校凭什么管这件事。"

# episode11\branches\ep11_isabella_branch.rpy:138
translate schinese ep11_bella_home_label_c2854699:

    # isa "These rules exist to protect B&R from lawsuits. Teachers have a power position over students, and that's why it's an issue."
    isa "这些规定是为了让 B&R 免受诉讼。老师对学生有权力优势，所以这种关系才会有问题。"

# episode11\branches\ep11_isabella_branch.rpy:139
translate schinese ep11_bella_home_label_a86575c2:

    # isa "I don't think anything would happen to you... But I can't say for sure, and I don't want to find out the hard way."
    isa "我想，你应该不会受什么处罚……但也不敢保证，更不想等出事了才知道。"

# episode11\branches\ep11_isabella_branch.rpy:141
translate schinese ep11_bella_home_label_1d77a111:

    # isa "And I also don't want to stop."
    isa "而且我也不想停下。"

# episode11\branches\ep11_isabella_branch.rpy:143
translate schinese ep11_bella_home_label_891b8af2:

    # mc "Well, neither do I."
    mc "我也不想。"

# episode11\branches\ep11_isabella_branch.rpy:144
translate schinese ep11_bella_home_label_d6d9579c:

    # mc "Bella, you should have told me earlier. I wouldn't have rushed off to do something irrational."
    mc "贝拉，你早该告诉我了。我不会那么冲动地去做什么不理智的事。"

# episode11\branches\ep11_isabella_branch.rpy:146
translate schinese ep11_bella_home_label_c357c746:

    # isa "You're right. I'm sorry."
    isa "你说得对，抱歉。"

# episode11\branches\ep11_isabella_branch.rpy:147
translate schinese ep11_bella_home_label_31e593db:

    # isa "I only did it because I care a lot about you."
    isa "我只这么做是因为我真的很在乎你。"

# episode11\branches\ep11_isabella_branch.rpy:151
translate schinese ep11_bella_home_label_61d1a832:

    # isa "It's not you who I'm ashamed of, [name]. It's the situation we're in. And that's a big difference."
    isa "[name]，让我感到难堪的不是你，而是我们现在的处境。这两者差别很大。"

# episode11\branches\ep11_isabella_branch.rpy:153
translate schinese ep11_bella_home_label_292a4c71:

    # mc "It sucks that we have to hide... But it would be even worse if we had to stop altogether."
    mc "必须躲躲藏藏，确实很难受……可要是因此彻底结束，那就更糟了。"

# episode11\branches\ep11_isabella_branch.rpy:154
translate schinese ep11_bella_home_label_831e56c6:

    # mc "I want to continue and see where this will lead. Maybe it will be good, or maybe it will be bad..."
    mc "我想继续下去，看看这条路会带我们去哪。也许会很好，也许会很糟……"

# episode11\branches\ep11_isabella_branch.rpy:155
translate schinese ep11_bella_home_label_c7e1098d:

    # mc "But I want to decide that for myself."
    mc "但我希望自己做决定。"

# episode11\branches\ep11_isabella_branch.rpy:157
translate schinese ep11_bella_home_label_c830eadf:

    # isa "I said almost the exact same thing to Jill. I couldn't agree more."
