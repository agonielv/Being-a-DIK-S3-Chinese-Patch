    js "嗯……"

# episode11\branches\ep11_jm_branch.rpy:441
translate schinese ep11_jsolo_label_66becdb0:

    # ir "Don't tell me you forgot it's our turn to have you over this year."
    ir "别跟我说你忘了今年轮到我们请你来家里了。"

# episode11\branches\ep11_jm_branch.rpy:443
