    # js "Yeah, she did..."
    js "嗯，她确实那样了..."

# episode11\branches\ep11_jm_branch.rpy:510
translate schinese ep11_jsolo_label_3ebb7228:

    # js "She's a fashion designer and runs her own company. She designs rather expensive clothes."
    js "她是个时装设计师，自己开公司。她设计的衣服相当贵。"

