    # ir "Fashion photography? Why haven't you told me?"
    ir "时尚摄影？怎么没提前跟我说？"

# episode11\branches\ep11_jm_branch.rpy:451
translate schinese ep11_jsolo_label_e9a8555f:

    # js "I would have, but it's pretty new and not primarily about fashion."
    js "我本来想的，但这个博客还很新，而且不主要是关于时尚的。"

