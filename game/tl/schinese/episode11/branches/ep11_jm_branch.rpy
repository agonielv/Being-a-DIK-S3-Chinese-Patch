    # js "No, I'll be there."
    js "不，我会去的。"

# episode11\branches\ep11_jm_branch.rpy:445
translate schinese ep11_jsolo_label_907e5e62:

    # ir "What did you say about a blog? What's that about?"
    ir "你刚才说什么博客？那是什么回事？"

# episode11\branches\ep11_jm_branch.rpy:447
translate schinese ep11_jsolo_label_316a34c3:

    # js "I've started a blog, and we're taking pictures for it. Fashion photography and such."
    js "我开了个博客，我们正在为它拍照。时尚摄影之类的。"

# episode11\branches\ep11_jm_branch.rpy:449
