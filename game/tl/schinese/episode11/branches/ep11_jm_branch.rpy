translate schinese ep11_jsolo_label_cd0affff:

    # ir "All the clothes and materials you use are deductible from your income."
    ir "你用的所有衣服和材料都可以从收入中扣除。"

# episode11\branches\ep11_jm_branch.rpy:487
translate schinese ep11_jsolo_label_d733f04e:

    # js "I know all those things already. But I haven't gotten around to it."
    js "我知道这些事。但还没来得及做。"

