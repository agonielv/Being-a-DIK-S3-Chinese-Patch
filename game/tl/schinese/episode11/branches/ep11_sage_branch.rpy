translate schinese ep11_sage_party_label_023723af:

    # mc "But after reading her diary, I've become less afraid of learning new things about her."
    mc "但读完她的日记后，我反而对了解她更多的事物不再那么害怕了。"

# episode11\branches\ep11_sage_branch.rpy:415
translate schinese ep11_sage_party_label_fcc42abb:

    # mc "I can't imagine how you feel not knowing anything. I bet it's tough..."
    mc "对她一无所知是什么感觉，我无法想象。一定很难受……"

# episode11\branches\ep11_sage_branch.rpy:417
translate schinese ep11_sage_party_label_e0132fb4:

    # sa "Now you know."
    sa "现在你都知道了。"

# episode11\branches\ep11_sage_branch.rpy:418
translate schinese ep11_sage_party_label_7d53cf6d:

    # sa "I haven't told anyone about this. And I mean no one."
    sa "我没跟任何人说过这件事。我是说，真的没人。"

# episode11\branches\ep11_sage_branch.rpy:419
translate schinese ep11_sage_party_label_896e7aea:

    # sa "Mom and Dad know more than I do, but I have never asked them about it for the same reason."
    sa "爸妈知道得比我多，但我从来没问过他们，原因一样。"

# episode11\branches\ep11_sage_branch.rpy:424
translate schinese ep11_sage_party_label_97566f3f:

    # mc "Thank you for telling me. It means a lot to me."
    mc "谢谢你告诉我。对我来说意义很大。"

# episode11\branches\ep11_sage_branch.rpy:427
translate schinese ep11_sage_party_label_8515d866:

    # mc "Thank you for telling me."
    mc "谢谢你告诉我。"

# episode11\branches\ep11_sage_branch.rpy:429
translate schinese ep11_sage_party_label_a57a36b0:

    # sa "I'm sorry it took me this long to say it."
    sa "抱歉我花了这么长时间才说出来。"

# episode11\branches\ep11_sage_branch.rpy:433
translate schinese ep11_sage_party_label_a2b202e8:

    # mc "Don't be. You had your reasons."
    mc "别这么说。你有你的理由。"

# episode11\branches\ep11_sage_branch.rpy:437
translate schinese ep11_sage_party_label_e3332e86:

    # mc "{i}Sage needed me to be her rock.{/i}"
    mc "{i}Sage需要我成为她的依靠。{/i}"

# episode11\branches\ep11_sage_branch.rpy:438
translate schinese ep11_sage_party_label_9cc7eb57:

    # mc "{i}And there I was, still deciding what to do with her.{/i}"
    mc "{i}而我却还在犹豫，该怎样处理和她的关系。{/i}"

# episode11\branches\ep11_sage_branch.rpy:439
translate schinese ep11_sage_party_label_9ef16f5b:

    # mc "{i}Imagining that there was a fourth option that would make everything ok.{/i}"
    mc "{i}想象着有一个第四种选择能让一切变得好起来。{/i}"

# episode11\branches\ep11_sage_branch.rpy:441
translate schinese ep11_sage_party_label_747a6bd3:

    # mc "{i}I wanted to be her rock.{/i}"
    mc "{i}我想成为她的依靠。{/i}"

# episode11\branches\ep11_sage_branch.rpy:442
translate schinese ep11_sage_party_label_b96156a3:

    # mc "{i}But deep down, I knew that I could never be it.{/i}"
    mc "{i}但内心深处，我知道我永远无法成为那样的人。{/i}"

# episode11\branches\ep11_sage_branch.rpy:453
translate schinese ep11_ssolo_label_00168b31:

    # sa "*{i}Groans{/i}*"
    sa "*{i}呻吟{/i}*"

# episode11\branches\ep11_sage_branch.rpy:454
translate schinese ep11_ssolo_label_023b86b2:

    # mc "You almost got it."
    mc "你差点就搞定了。"

# episode11\branches\ep11_sage_branch.rpy:456
translate schinese ep11_ssolo_label_f8b87467:

    # sa "Stop saying I got it! I'm nowhere close, and my hand hurts."
    sa "别再说我搞定了！我离那还远着呢，手也疼得厉害。"

# episode11\branches\ep11_sage_branch.rpy:458
translate schinese ep11_ssolo_label_8b0cc667:

    # mc "But you almost have it."
    mc "但你几乎掌握了。"

# episode11\branches\ep11_sage_branch.rpy:460
translate schinese ep11_ssolo_label_67cf64f3:

    # sa "This F chord can F off!"
    sa "这 F 和弦，烦死了，给我滚！"

# episode11\branches\ep11_sage_branch.rpy:462
translate schinese ep11_ssolo_label_1c010f4a:

    # mc "Maybe that's enough practice for today."
    mc "也许今天够了。"

# episode11\branches\ep11_sage_branch.rpy:465
translate schinese ep11_ssolo_label_91b1122d:

    # "*{i}Phone rings{/i}*"
    "*{i}电话铃声响起{/i}*"

# episode11\branches\ep11_sage_branch.rpy:467
translate schinese ep11_ssolo_label_c73e70c3:

    # sa "Yeah?"
    sa "嗯？"

# episode11\branches\ep11_sage_branch.rpy:469
translate schinese ep11_ssolo_label_bfd3a3af:

    # sa "Nothing. I'm hanging out with [name]."
    sa "没干什么，和[name]待着呢。"

# episode11\branches\ep11_sage_branch.rpy:470
translate schinese ep11_ssolo_label_66eee626:

    # sa "What? Now?"
    sa "什么？现在？"

# episode11\branches\ep11_sage_branch.rpy:472
translate schinese ep11_ssolo_label_ee8ef466:

    # sa "Uh... No, he didn't tell me anything about it either. Where's he going? And what about you?"
    sa "呃……他也没跟我说什么。他要去哪儿？你呢？"

# episode11\branches\ep11_sage_branch.rpy:474
translate schinese ep11_ssolo_label_7bc19553:

    # sa "Yeah, I get it."
    sa "我懂。"

# episode11\branches\ep11_sage_branch.rpy:475
translate schinese ep11_ssolo_label_d09bdf04:

    # sa "But I'm busy with [name] tonight."
    sa "可我今晚已经约了[name]。"

# episode11\branches\ep11_sage_branch.rpy:477
translate schinese ep11_ssolo_label_651353b0:

    # sa "Alright, but I'm bringing him with me!"
    sa "好，不过我带他一起来！"

# episode11\branches\ep11_sage_branch.rpy:478
translate schinese ep11_ssolo_label_a20ec4d2:

    # sa "I don't care! He's my boyfriend! If you're gonna fight, then so be it. He already knows that you do."
    sa "我不管！他是我男朋友！你们要吵就吵吧，他早就知道你们会吵架了。"

# episode11\branches\ep11_sage_branch.rpy:480
translate schinese ep11_ssolo_label_ebc861d7:

    # sa "So what? Do you think it was fun for me last time?"
    sa "那又怎样？你以为上次对我来说是件好玩的事吗？"

# episode11\branches\ep11_sage_branch.rpy:481
translate schinese ep11_ssolo_label_5a25f3ba:

    # sa "You said horrible things to Dad!"
    sa "你对爸爸说了些可怕的话！"

# episode11\branches\ep11_sage_branch.rpy:483
translate schinese ep11_ssolo_label_9d9a25fa:

    # sa "Yeah. He said those things, too. I know."
    sa "他也是这么说的。我知道。"

# episode11\branches\ep11_sage_branch.rpy:484
translate schinese ep11_ssolo_label_1ece6ddb:

    # sa "Stop yelling!"
    sa "别喊了！"

# episode11\branches\ep11_sage_branch.rpy:486
translate schinese ep11_ssolo_label_9cf3a273:

    # sa "We'll be there soon. Bye."
    sa "我们很快就到。拜拜。"

# episode11\branches\ep11_sage_branch.rpy:488
translate schinese ep11_ssolo_label_8c26cb31:

    # mc "What's going on?"
    mc "怎么了？"

# episode11\branches\ep11_sage_branch.rpy:490
translate schinese ep11_ssolo_label_acae8579:

    # sa "Dad was in the middle of moving out, and it caught Mom by surprise because he didn't mention that he was gonna."
    sa "爸爸当时正在搬出去，这事让妈妈措手不及，因为他根本没提过要搬。"

# episode11\branches\ep11_sage_branch.rpy:491
translate schinese ep11_ssolo_label_67297b14:

    # sa "She wants me to be there helping out."
    sa "她让我过去帮忙。"

# episode11\branches\ep11_sage_branch.rpy:493
translate schinese ep11_ssolo_label_10105fd5:

    # mc "Tonight?"
    mc "今晚？"

# episode11\branches\ep11_sage_branch.rpy:495
translate schinese ep11_ssolo_label_eb876eb1:

    # sa "Yeah. I know we're supposed to hang out, but it sounded urgent."
    sa "嗯，我知道我们本来约好要出去玩，但听起来挺急的。"

# episode11\branches\ep11_sage_branch.rpy:496
translate schinese ep11_ssolo_label_cfa77695:

    # sa "I think Mom isn't handling it well. I need to be there."
    sa "我觉得我妈现在处理得不太好，我得去那边帮忙。"

# episode11\branches\ep11_sage_branch.rpy:498
translate schinese ep11_ssolo_label_00e3752c:

    # mc "I heard you say \"we\"."
    mc "我听到你说“我们”。"

# episode11\branches\ep11_sage_branch.rpy:500
translate schinese ep11_ssolo_label_1d18ccf2:

    # sa "Yeah, you don't mind, do you?"
    sa "嗯，你不会介意吧？"

# episode11\branches\ep11_sage_branch.rpy:505
translate schinese ep11_ssolo_label_588bcc1b:

    # mc "No, I don't mind. Of course, I'll be there for you."
    mc "不，我不介意。当然，我会在你身边。"

# episode11\branches\ep11_sage_branch.rpy:508
translate schinese ep11_ssolo_label_986f33b9:

    # sa "Thank you."
    sa "谢谢。"

# episode11\branches\ep11_sage_branch.rpy:510
translate schinese ep11_ssolo_label_ed7718a5:

    # mc "Honestly, I'd rather not come with you. It sounds like it's private."
    mc "说实话，我宁愿不跟你一起去。听起来像是私事。"

# episode11\branches\ep11_sage_branch.rpy:512
translate schinese ep11_ssolo_label_12fbbebb:

    # sa "You're a big part of my life, [name]. Are you telling me that you won't be there to support me when I need you?"
    sa "你是我生命中很重要的一部分[name]你是在说我需要你的时候不会在我身边支持我吗？"

# episode11\branches\ep11_sage_branch.rpy:517
translate schinese ep11_ssolo_label_63fe3299:

    # mc "No, of course. I'll be there to support you; I'm coming with you."
    mc "不，当然会。我会支持你的，我跟你一起去。"

# episode11\branches\ep11_sage_branch.rpy:520
translate schinese ep11_ssolo_label_986f33b9_1:

    # sa "Thank you."
    sa "谢谢。"

# episode11\branches\ep11_sage_branch.rpy:523
translate schinese ep11_ssolo_label_b2e1defc:

    # mc "I don't think I should be there tonight."
    mc "我觉得今晚我最好别去。"

# episode11\branches\ep11_sage_branch.rpy:525
translate schinese ep11_ssolo_label_36f779f9:

    # mc "With how you described it last time, I don't want to be caught in the middle of a fight."
    mc "上次你这么描述过，我不想被卷进一场争吵里。"

# episode11\branches\ep11_sage_branch.rpy:527
translate schinese ep11_ssolo_label_1293e593:

    # sa "Do you think I want that? I need you, [name]."
    sa "你以为我想这样吗？[name]，我需要你。"

# episode11\branches\ep11_sage_branch.rpy:530
translate schinese ep11_ssolo_label_2b35b6fe:

    # mc "..."
    mc "..."

# episode11\branches\ep11_sage_branch.rpy:531
translate schinese ep11_ssolo_label_dca78da4:

    # mc "Ok, I'll come with you."
    mc "好，我跟你去。"

# episode11\branches\ep11_sage_branch.rpy:537
translate schinese ep11_ssolo_label_dc68c6c0:

    # ja "No, put that down! That is not his; it's mine!"
    ja "不，放下那个！那不是他的，是我的！"

# episode11\branches\ep11_sage_branch.rpy:539
translate schinese ep11_ssolo_label_64370df3:

    # wo2 "I'm just following orders, ma'am. You'll have to take it up with your husband."
    wo2 "我只是奉命行事，女士。你得去找你丈夫说这件事。"

# episode11\branches\ep11_sage_branch.rpy:541
translate schinese ep11_ssolo_label_4117e52b:

    # ja "He's not my husband! And don't you dare take my ornament!"
    ja "他不是我丈夫！你敢把我的摆件拿走试试！"

# episode11\branches\ep11_sage_branch.rpy:543
translate schinese ep11_ssolo_label_9e99ac79:

    # sa "Mom?"
    sa "妈？"

# episode11\branches\ep11_sage_branch.rpy:545
translate schinese ep11_ssolo_label_ece6f366:

    # ja "Where is Stephen!? Did you see him anywhere?"
    ja "Stephen在哪儿！？你们看见他了吗？"

# episode11\branches\ep11_sage_branch.rpy:547
translate schinese ep11_ssolo_label_8a976746:

    # sa "He's not here?"
    sa "他不在这里？"

# episode11\branches\ep11_sage_branch.rpy:549
translate schinese ep11_ssolo_label_18ce3938:

    # ja "He's somewhere. And he sent these god-awful workers to move our belongings without consulting me."
    ja "他就在某个地方。他还派人把这些见鬼的工人叫来搬我们的东西，连我都没问一声。"

# episode11\branches\ep11_sage_branch.rpy:551
translate schinese ep11_ssolo_label_965328a9:

    # sa "I'll try calling him."
    sa "我会试着给他打电话。"

# episode11\branches\ep11_sage_branch.rpy:553
translate schinese ep11_ssolo_label_1cfc6754:

    # mc "What can I do to help?"
    mc "我能帮你做什么？"

# episode11\branches\ep11_sage_branch.rpy:555
translate schinese ep11_ssolo_label_4637adea:

    # sa "Stay with Mom. Try to calm her down."
    sa "陪着我妈，想办法让她冷静一点。"

# episode11\branches\ep11_sage_branch.rpy:558
translate schinese ep11_ssolo_label_3367240e:

    # mc "(I'd rather call your dad...)"
    mc "（我宁愿去给你爸打电话……）"

# episode11\branches\ep11_sage_branch.rpy:560
translate schinese ep11_ssolo_label_1588e139:

    # ja "What are you doing here?"
    ja "你在这儿干嘛？"

# episode11\branches\ep11_sage_branch.rpy:562
translate schinese ep11_ssolo_label_63cd561d:

    # mc "I'm here because Sage wanted me to come with her."
    mc "Sage想让我陪她，所以我来了。"

# episode11\branches\ep11_sage_branch.rpy:565
translate schinese ep11_ssolo_label_3856febb:

    # ja "How stupid are you? Stephen could be here at any minute."
    ja "你到底有多蠢？Stephen随时可能过来。"

# episode11\branches\ep11_sage_branch.rpy:566
translate schinese ep11_ssolo_label_d07470a1:

    # ja "Do you want to expose what you have done to my daughter?"
    ja "你想让我女儿知道你干过的那些事吗？"

# episode11\branches\ep11_sage_branch.rpy:568
translate schinese ep11_ssolo_label_c3802040:

    # mc "Should I have told her I couldn't come because of the love triangle I'm involved in with her mom and dad?"
    mc "我应该告诉她我因为和她爸妈卷入了三角恋而不能来吗？"

# episode11\branches\ep11_sage_branch.rpy:570
translate schinese ep11_ssolo_label_f8640d04:

    # ja "Do you find this amusing, you sick son of a bitch?"
    ja "你觉得很好笑吗，你这个变态混蛋？"

# episode11\branches\ep11_sage_branch.rpy:572
translate schinese ep11_ssolo_label_c2ccfa2e:

    # mc "Not one bit. I'd undo everything if I could."
    mc "一点都不。如果可以，我宁愿那些事从来没发生过。"

# episode11\branches\ep11_sage_branch.rpy:574
translate schinese ep11_ssolo_label_0fb73196:

    # ja "I could strangle you."
    ja "我恨不得掐死你。"

# episode11\branches\ep11_sage_branch.rpy:577
translate schinese ep11_ssolo_label_f8640d04_1:

    # ja "Do you find this amusing, you sick son of a bitch?"
    ja "你觉得很好笑吗，你这个变态混蛋？"

# episode11\branches\ep11_sage_branch.rpy:579
translate schinese ep11_ssolo_label_3957aa06:

    # mc "Not one bit."
    mc "一点都不觉得好笑。"

# episode11\branches\ep11_sage_branch.rpy:582
translate schinese ep11_ssolo_label_d8248b92:

    # mc "(How do you expect me to do that?)"
    mc "（你让我怎么安抚她啊？）"

# episode11\branches\ep11_sage_branch.rpy:584
translate schinese ep11_ssolo_label_1588e139_1:

    # ja "What are you doing here?"
    ja "你来这里干什么？"

# episode11\branches\ep11_sage_branch.rpy:586
translate schinese ep11_ssolo_label_63cd561d_1:

    # mc "I'm here because Sage wanted me to come with her."
    mc "Sage想让我陪她，所以我来了。"

# episode11\branches\ep11_sage_branch.rpy:588
translate schinese ep11_ssolo_label_0a8998c4:

    # ja "Have you told her anything?"
    ja "你跟她说了什么？"

# episode11\branches\ep11_sage_branch.rpy:590
translate schinese ep11_ssolo_label_eaa8ee47:

    # mc "About what?"
    mc "关于什么？"

# episode11\branches\ep11_sage_branch.rpy:592
translate schinese ep11_ssolo_label_95ed7ed1:

    # ja "What happened between us in class."
    ja "我们上课时发生了什么。"

# episode11\branches\ep11_sage_branch.rpy:594
translate schinese ep11_ssolo_label_318f0a30:

    # mc "No. Because that's on your conscience, not mine."
    mc "不，因为那是你的良心问题，不是我的。"

# episode11\branches\ep11_sage_branch.rpy:595
translate schinese ep11_ssolo_label_07a8cfdc:

    # mc "I'm not letting that affect my relationship with Sage."
    mc "我不会让那件事影响我和Sage的关系。"

# episode11\branches\ep11_sage_branch.rpy:597
translate schinese ep11_ssolo_label_7bb94501:

    # ja "Good. It better stay that way. Got it?"
    ja "好。这样最好。记住了？"

# episode11\branches\ep11_sage_branch.rpy:599
translate schinese ep11_ssolo_label_1e1d7f54:

    # mc "I don't care about you. I care about Sage."
    mc "我不在乎你，我在乎的是Sage。"

# episode11\branches\ep11_sage_branch.rpy:600
translate schinese ep11_ssolo_label_8e62b55a:

    # mc "Whatever you tried to do with me, it's water under the bridge."
    mc "不管你对我做了什么，那都成了过去的事。"

# episode11\branches\ep11_sage_branch.rpy:603
translate schinese ep11_ssolo_label_c7bc4ec3:

    # sa "Good news. He's on his way over here."
    sa "好消息，他正往这边来。"

# episode11\branches\ep11_sage_branch.rpy:606
translate schinese ep11_ssolo_label_4f5b2351:

    # ja "*{i}Grunts{/i}*"
    ja "*{i}咕哝声{/i}*"

# episode11\branches\ep11_sage_branch.rpy:608
translate schinese ep11_ssolo_label_636dd51c:

    # sa "How's it going?"
    sa "咋样？"

# episode11\branches\ep11_sage_branch.rpy:610
translate schinese ep11_ssolo_label_b3cbafd9:

    # mc "She's...agitated."
    mc "她有点激动。"

# episode11\branches\ep11_sage_branch.rpy:612
translate schinese ep11_ssolo_label_692ff6f7:

    # sa "At least she hasn't started throwing things."
    sa "至少她还没开始扔东西。"

# episode11\branches\ep11_sage_branch.rpy:614
translate schinese ep11_ssolo_label_d8013aae:

    # mc "She does that?"
    mc "她还会摔东西？"

# episode11\branches\ep11_sage_branch.rpy:616
translate schinese ep11_ssolo_label_9a4d11d3:

    # sa "She did it last time."
    sa "她上次就是这样做的。"

# episode11\branches\ep11_sage_branch.rpy:617
translate schinese ep11_ssolo_label_b46eff7f:

    # sa "I can't believe he's moving out... It's really happening."
    sa "我真不敢相信他要搬出去了……这事儿真的要发生了。"

# episode11\branches\ep11_sage_branch.rpy:619
translate schinese ep11_ssolo_label_e05ab314:

    # mc "Are you ok?"
    mc "你没事吧？"

# episode11\branches\ep11_sage_branch.rpy:621
translate schinese ep11_ssolo_label_584df6f8:

    # sa "No, I'm not ok. This is my home..."
    sa "不，我不好。这可是我的家……"

# episode11\branches\ep11_sage_branch.rpy:622
translate schinese ep11_ssolo_label_7f61d5f1:

    # sa "Come, I wanna show you my room before it gets emptied."
    sa "来，我想在它被清空之前给你看看我的房间。"

# episode11\branches\ep11_sage_branch.rpy:625
translate schinese ep11_ssolo_label_c7fa827b:

    # sa "Not that it matters because, as you know, it's nothing like it was when I lived here."
    sa "不，这没什么大不了的，就像你明白的，它已经完全不是我住在这里时的样子了。"

# episode11\branches\ep11_sage_branch.rpy:627
translate schinese ep11_ssolo_label_290839b1:

    # mc "I can tell. I wouldn't have guessed this was your room."
    mc "我能看出来。我之前根本想不到这是你的房间。"

# episode11\branches\ep11_sage_branch.rpy:629
translate schinese ep11_ssolo_label_da04519e:

    # sa "And soon, it will be someone else's room. This will be someone else's home."
    sa "很快，这里就会变成另一个人的房间。这也会变成另一个人的家。"

# episode11\branches\ep11_sage_branch.rpy:630
translate schinese ep11_ssolo_label_00bd0bf4:

    # sa "I wonder where Mom will move... I'm sure she's already panicking trying to figure that out."
    sa "不知道妈妈会搬去哪儿……她肯定已经为这事急得团团转了。"

# episode11\branches\ep11_sage_branch.rpy:632
translate schinese ep11_ssolo_label_60ba9b92:

    # sa "I wanted the first time you met my parents to be like how it was for me to meet Neil."
    sa "我本来希望，你第一次见我父母，也能像我见Neil时那样。"

# episode11\branches\ep11_sage_branch.rpy:633
translate schinese ep11_ssolo_label_aeab7778:

    # sa "But you already met them before you became my boyfriend. So, that moment is gone. And now everything is chaotic."
    sa "但你早在成为我男朋友之前就见过他们了，所以那个时刻已经过去了。现在一切都乱成一团。"

# episode11\branches\ep11_sage_branch.rpy:635
translate schinese ep11_ssolo_label_97a9c9ed:

    # sa "That phone call with Mom before we came here was the first time I told her that you are my boyfriend."
    sa "那通电话是我第一次跟妈妈说你是我的男朋友，就是在我们来这儿之前打的。"

# episode11\branches\ep11_sage_branch.rpy:636
translate schinese ep11_ssolo_label_8cdb91e2:

    # sa "I didn't think I would be yelling at her when I told her about you, either."
    sa "我也没想到自己会对着她大喊大叫，跟她说起你的时候。"

# episode11\branches\ep11_sage_branch.rpy:641
translate schinese ep11_ssolo_label_9c1c0a1f:

    # mc "How is your relationship with your mom? How...important is it to you?"
    mc "你和你妈的关系怎么样？对你来说，这有多重要？"

# episode11\branches\ep11_sage_branch.rpy:643
translate schinese ep11_ssolo_label_73210368:

    # sa "What do you mean? She's my mom. It's very important to me."
    sa "你这话是什么意思？她是我妈。对我来说非常重要。"

# episode11\branches\ep11_sage_branch.rpy:644
translate schinese ep11_ssolo_label_8c2f4348:

    # sa "We don't always see eye to eye on things, but I love her."
    sa "我们不总能意见一致，但我爱她。"

# episode11\branches\ep11_sage_branch.rpy:646
translate schinese ep11_ssolo_label_b89ed878:

    # sa "And even though Dad may not have wanted kids...or asked to be my father..."
    sa "而且即使爸爸可能根本不想当父亲……或者根本没想过要当我的父亲……"

# episode11\branches\ep11_sage_branch.rpy:647
translate schinese ep11_ssolo_label_727665bf:

    # sa "I love him, too."
    sa "我也爱他。"

# episode11\branches\ep11_sage_branch.rpy:650
translate schinese ep11_ssolo_label_a3ffb2e1:

    # sa "I don't think Dad's reaction to hearing about you and me will be much better than Mom's."
    sa "我觉得我爸听到我们俩的事，反应可能也不会比我妈好多少。"

# episode11\branches\ep11_sage_branch.rpy:652
translate schinese ep11_ssolo_label_66406be0:

    # mc "That's ok. I understand why it wouldn't."
    mc "这没关系。我明白为什么你会这么想。"

# episode11\branches\ep11_sage_branch.rpy:654
translate schinese ep11_ssolo_label_a1ff50ea:

    # sa "You must think my family is crazy."
    sa "你肯定觉得我家人挺疯狂的。"

# episode11\branches\ep11_sage_branch.rpy:656
translate schinese ep11_ssolo_label_dd253a22:

    # mc "Name one family without issues."
    mc "说一个没有问题的家庭。"

# episode11\branches\ep11_sage_branch.rpy:658
translate schinese ep11_ssolo_label_7346d0b6:

    # sa "Yours."
    sa "你的。"

# episode11\branches\ep11_sage_branch.rpy:660
translate schinese ep11_ssolo_label_d30c1cfa:

    # mc "Uh... No. It depends on how you look at it. But we're far from perfect."
    mc "嗯……不，这得看你怎么看。但我们远不是完美的。"

# episode11\branches\ep11_sage_branch.rpy:661
translate schinese ep11_ssolo_label_d36ed48a:

    # mc "And my family is basically Dad."
    mc "我家就我爸一个人。"

# episode11\branches\ep11_sage_branch.rpy:663
translate schinese ep11_ssolo_label_e624ee49:

    # sa "What about other relatives?"
    sa "那其他亲戚呢？"

# episode11\branches\ep11_sage_branch.rpy:665
translate schinese ep11_ssolo_label_cd8f308a:

    # mc "Dad was an only child and left his parents during his teens. So, there are no grandparents or close relatives on his side of the family who are part of our lives."
    mc "爸爸是独生子，十几岁就离开父母了。所以他那边没有祖父母或者其他在我们生活中出现过的亲戚。"

# episode11\branches\ep11_sage_branch.rpy:666
translate schinese ep11_ssolo_label_c8fca30f:

    # mc "As for Mom's side... I go by what Dad has told me."
    mc "至于我妈那边……我都是听我爸说的。"

# episode11\branches\ep11_sage_branch.rpy:668
translate schinese ep11_ssolo_label_0f2733fd:

    # mc "Mom had no siblings, and her parents didn't get along with Dad."
    mc "妈妈也没有兄弟姐妹，她爸妈和爸爸关系也不太好。"

# episode11\branches\ep11_sage_branch.rpy:669
translate schinese ep11_ssolo_label_0312cd1b:

    # mc "As a result, it's a small family."
    mc "结果就是，我们家挺小的。"

# episode11\branches\ep11_sage_branch.rpy:671
translate schinese ep11_ssolo_label_43934b58:

    # sa "But also, not a lot of issues."
    sa "不过，也就没那么多问题了。"

# episode11\branches\ep11_sage_branch.rpy:673
translate schinese ep11_ssolo_label_86305d1e:

    # mc "Sure, that's something."
    mc "确实，这也算个好处。"

# episode11\branches\ep11_sage_branch.rpy:674
translate schinese ep11_ssolo_label_fc896afd:

    # mc "But..."
    mc "但..."

# episode11\branches\ep11_sage_branch.rpy:676
translate schinese ep11_ssolo_label_e3d1c6f0:

    # sa "But what?"
    sa "但是什么？"

# episode11\branches\ep11_sage_branch.rpy:678
translate schinese ep11_ssolo_label_fcd7bb49:

    # mc "I feel like I've missed out on a lot because of it."
    mc "我觉得因为这样，我错过了很多东西。"

# episode11\branches\ep11_sage_branch.rpy:679
translate schinese ep11_ssolo_label_de3a0e07:

    # mc "Like not having grandparents or siblings..."
    mc "比如没有祖父母或者兄弟姐妹之类的……"

# episode11\branches\ep11_sage_branch.rpy:681
translate schinese ep11_ssolo_label_2b3fe8b9:

    # mc "I've got none of those family relations that most seem to have and take for granted."
    mc "我没有那些大多数人都拥有并理所当然的亲属关系。"

# episode11\branches\ep11_sage_branch.rpy:682
translate schinese ep11_ssolo_label_b56e58e8:

    # mc "It would have been nice to have a bigger family."
    mc "有个更大的家庭该多好啊。"

# episode11\branches\ep11_sage_branch.rpy:683
translate schinese ep11_ssolo_label_20e91441:

    # mc "That's the issue with my family."
    mc "这就是我家庭的问题。"

# episode11\branches\ep11_sage_branch.rpy:689
translate schinese ep11_ssolo_label_4049fab4:

    # sa "What about your future family?"
    sa "你未来的家庭呢？"

# episode11\branches\ep11_sage_branch.rpy:691
translate schinese ep11_ssolo_label_a5f80501:

    # mc "My future family?"
    mc "我未来的家庭？"

# episode11\branches\ep11_sage_branch.rpy:693
translate schinese ep11_ssolo_label_bf9de766:

    # sa "Yeah. What do you see when you close your eyes and imagine your future family? Try it."
    sa "对啊。闭上眼，想象自己未来的家庭，你会看见什么？试试嘛。"

# episode11\branches\ep11_sage_branch.rpy:695
translate schinese ep11_ssolo_label_816a26bb:

    # sa "Tell me... What's going on in that pretty little head of yours?"
    sa "告诉我……你脑子里到底在想些什么？"

# episode11\branches\ep11_sage_branch.rpy:697
translate schinese ep11_ssolo_label_c6aeae02:

    # mc "Hm... I see..."
    mc "嗯……我看到了……"

# episode11\branches\ep11_sage_branch.rpy:699
translate schinese ep11_ssolo_label_f2364c09:

    # mc "Well, there's me and Dad. Surprisingly, in the future, we will still look the same as we do now. We haven't aged one bit."
    mc "嗯，还有我跟老爸。想不到吧，将来我们俩还是跟现在一样，一点都没老。"

# episode11\branches\ep11_sage_branch.rpy:700
translate schinese ep11_ssolo_label_29ec62e8:

    # sa "Uh-huh. What else?"
    sa "嗯，还有啥？"

# episode11\branches\ep11_sage_branch.rpy:702
translate schinese ep11_ssolo_label_304673c9:

    # mc "There's a girl next to me. It could be my wife."
    mc "旁边有个女孩。她可能是我的妻子。"

# episode11\branches\ep11_sage_branch.rpy:708
translate schinese ep11_ssolo_label_e94ba74b:

    # mc "It could be you."
    mc "这可能是你。"

# episode11\branches\ep11_sage_branch.rpy:711
translate schinese ep11_ssolo_label_15aadb73:

    # mc "I don't see her face."
    mc "我没看到她的脸。"

# episode11\branches\ep11_sage_branch.rpy:714
translate schinese ep11_ssolo_label_15aadb73_1:

    # mc "I don't see her face."
    mc "我没看到她的脸。"

# episode11\branches\ep11_sage_branch.rpy:715
translate schinese ep11_ssolo_label_712bbab9:

    # mc "We look happy together."
    mc "我们看起来挺幸福的。"

# episode11\branches\ep11_sage_branch.rpy:720
translate schinese ep11_ssolo_label_ad72ec48:

    # mc "I see toys on the floor."
    mc "我看到地板上有很多玩具。"

# episode11\branches\ep11_sage_branch.rpy:723
translate schinese ep11_ssolo_label_9b0d134f:

    # mc "But I don't see any kids."
    mc "但我没看到任何孩子。"

# episode11\branches\ep11_sage_branch.rpy:725
translate schinese ep11_ssolo_label_861ef88a:

    # mc "And I see all these dark silhouettes around us. I think they're part of our family."
    mc "我看到周围全是暗色的影子。我想它们也是我们家的一员。"

# episode11\branches\ep11_sage_branch.rpy:726
translate schinese ep11_ssolo_label_fcb4af16:

    # mc "They might be our close friends too."
    mc "他们也可能是我们很亲近的朋友。"

# episode11\branches\ep11_sage_branch.rpy:727
translate schinese ep11_ssolo_label_e4ad6d15:

    # mc "Yeah, we're not alone here. We're a big family."
    mc "嗯，我们并不孤单，是个大家庭。"

# episode11\branches\ep11_sage_branch.rpy:738
translate schinese ep11_ssolo_label_d8f55474:

    # sa "That sounds like a wonderful future family."
    sa "这听起来像是个美好的未来家庭。"

# episode11\branches\ep11_sage_branch.rpy:741
translate schinese ep11_ssolo_label_06bc9f70:

    # sa "It does sound like a nice future family, but is that how you feel?"
    sa "这听起来像是个不错的未来家庭，但你真的这么觉得吗？"

# episode11\branches\ep11_sage_branch.rpy:744
translate schinese ep11_ssolo_label_8a229cf6:

    # mc "I think so..."
    mc "我想是吧..."

# episode11\branches\ep11_sage_branch.rpy:746
translate schinese ep11_ssolo_label_43e9a0da:

    # sa "Ok."
    sa "嗯。"

# episode11\branches\ep11_sage_branch.rpy:750
translate schinese ep11_ssolo_label_ae1b051b:

    # sa "That sounds like a nice future family."
    sa "这听起来像是个不错的未来家庭。"

# episode11\branches\ep11_sage_branch.rpy:754
translate schinese ep11_ssolo_label_066f0d3f:

    # ja "You can't decide what to take without conferring with me!"
    ja "不跟我商量，你凭什么决定搬走什么！"

# episode11\branches\ep11_sage_branch.rpy:756
translate schinese ep11_ssolo_label_a7487f1d:

    # sa "Dad is here... Let's help out."
    sa "爸爸来了……我们帮忙吧。"

# episode11\branches\ep11_sage_branch.rpy:758
translate schinese ep11_ssolo_label_842f4e18:

    # ja "What else have you ordered them to move? My wardrobe?"
    ja "还有什么别的东西让他们搬走？我的衣橱？"

# episode11\branches\ep11_sage_branch.rpy:760
translate schinese ep11_ssolo_label_bb379172:

    # sb "You're overreacting, as usual. They're moving my office, one of the bathrooms, the guest room-"
    sb "你又在过度反应了，照旧。他们只是在搬我的办公室，其中一个浴室，还有客房——"

# episode11\branches\ep11_sage_branch.rpy:762
translate schinese ep11_ssolo_label_11f8f049:

    # sa "*{i}Whispers{/i}* That's Tybalt's old room."
    sa "*{i}小声{/i}* 那是Tybalt以前的房间。"

# episode11\branches\ep11_sage_branch.rpy:764
translate schinese ep11_ssolo_label_a2068099:

    # sb "-and the living room. You can keep the rest."
    sb "还有客厅。你可以保留剩下的。"

# episode11\branches\ep11_sage_branch.rpy:766
translate schinese ep11_ssolo_label_5320a7bb:

    # ja "Oh!? Can I keep the rest? Aren't you Mr. Wonderful!?"
    ja "哦！？剩下的我都能留着？你可真是个大好人啊！"

# episode11\branches\ep11_sage_branch.rpy:768
translate schinese ep11_ssolo_label_6ab0b10c:

    # sa "Mom, calm down. I know it's hard, but listen to what he's saying. Those are the rooms they are moving, and you'll still have the rest until you decide to move."
    sa "妈妈，冷静点。我知道这很难，但听他说说。那些就是他们要搬走的房间，你还能继续用剩下的，直到你决定搬走。"

# episode11\branches\ep11_sage_branch.rpy:770
translate schinese ep11_ssolo_label_23e4309f:

    # sa "I'm sure Dad still wants you to have dignity. Right, Dad?"
    sa "我相信爸爸还是想给你留体面的。对吧，爸？"

# episode11\branches\ep11_sage_branch.rpy:772
translate schinese ep11_ssolo_label_e54a86d5:

    # sb "You shouldn't have come here tonight."
    sb "你今晚不该来这儿。"

# episode11\branches\ep11_sage_branch.rpy:773
translate schinese ep11_ssolo_label_e4e5bfe4:

    # sb "I know this is sudden, but I can't reason with your mother anymore. So, I won't bother doing it."
    sb "我知道这很突然，但我已经和你妈讲不通了。所以，我就不费劲了。"

# episode11\branches\ep11_sage_branch.rpy:775
translate schinese ep11_ssolo_label_1b467b09:

    # ja "Go to hell!"
    ja "去他妈的！"

# episode11\branches\ep11_sage_branch.rpy:777
translate schinese ep11_ssolo_label_1aed069d:

    # sb "What are you doing here?"
    sb "你怎么在这里？"

# episode11\branches\ep11_sage_branch.rpy:779
translate schinese ep11_ssolo_label_a34a9e6e:

    # sa "Mom asked me to come."
    sa "妈妈让我来的。"

# episode11\branches\ep11_sage_branch.rpy:780
translate schinese ep11_ssolo_label_ac6dccb0:

    # sa "Dad, this is my boyfriend. I'm sure you remember him from before."
    sa "爸爸，这是我男朋友。我确定你以前见过他。"

# episode11\branches\ep11_sage_branch.rpy:783
translate schinese ep11_ssolo_label_5ac36c94:

    # sb "Your boyfriend?"
    sb "你男朋友？"

# episode11\branches\ep11_sage_branch.rpy:786
translate schinese ep11_ssolo_label_708f0ba1:

    # sb "We are going to have a word, you and I. Follow me."
    sb "我们得好好谈谈，你和我。跟我来。"

# episode11\branches\ep11_sage_branch.rpy:788
translate schinese ep11_ssolo_label_ac8935e0:

    # sa "Dad?"
    sa "爸爸？"

# episode11\branches\ep11_sage_branch.rpy:791
translate schinese ep11_ssolo_label_a4a4f38c:

    # sb "Close the door."
    sb "关上门。"

# episode11\branches\ep11_sage_branch.rpy:795
translate schinese ep11_ssolo_label_fbb496a8:

    # sb "That video you recorded..."
    sb "你录的那视频..."

# episode11\branches\ep11_sage_branch.rpy:797
translate schinese ep11_ssolo_label_d2d008e5:

    # sb "Screwing my wife in my bed."
    sb "在我的床上干我老婆。"

# episode11\branches\ep11_sage_branch.rpy:798
translate schinese ep11_ssolo_label_8a602627:

    # sb "It ended up in my inbox."
    sb "结果进了我的邮箱。"

# episode11\branches\ep11_sage_branch.rpy:802
translate schinese ep11_ssolo_label_278b23a1:

    # sb "You fucked my wife, and now you're dating my daughter..."
    sb "你他妈的跟我的老婆上过床，现在还跟我的女儿约会……"

# episode11\branches\ep11_sage_branch.rpy:803
translate schinese ep11_ssolo_label_15e7b159:

    # sb "You've got some serious nerve, kid. Or perhaps it's brain damage."
    sb "小子，你胆子真够大的。或者说，脑子坏掉了。"

# episode11\branches\ep11_sage_branch.rpy:804
translate schinese ep11_ssolo_label_eefab854:

    # sb "Are you doing this to provoke me? To elicit some response?"
    sb "你这是在激怒我吗？想引我做出什么反应？"

# episode11\branches\ep11_sage_branch.rpy:808
translate schinese ep11_ssolo_label_ce298cfc:

    # sb "Although it was not your intention, that video was just what I needed."
    sb "虽然不是你故意的，但那视频正好是我需要的。"

# episode11\branches\ep11_sage_branch.rpy:809
translate schinese ep11_ssolo_label_0e02b497:

    # sb "That video has helped me greatly."
    sb "那视频对我帮助很大。"

# episode11\branches\ep11_sage_branch.rpy:810
translate schinese ep11_ssolo_label_8179e845:

    # sb "You, [name], have helped me greatly. By fucking my wife in my bed."
    sb "[name]，你帮了我一个大忙。在我的床上干了我老婆。"

# episode11\branches\ep11_sage_branch.rpy:826
translate schinese ep11_ssolo_label_4ba6a217:

    # sb "But what are your intentions?"
    sb "但你到底打的什么主意？"

# episode11\branches\ep11_sage_branch.rpy:827
translate schinese ep11_ssolo_label_2920ba03:

    # sb "Surely, they aren't hostile. Because I will tell you right now, there's nothing for you to gain from me, my wife, or my daughter by any of this."
    sb "你应该没有恶意吧。因为我现在就告诉你，搞这些事，你从我、我妻子、我女儿身上，都得不到任何好处。"

# episode11\branches\ep11_sage_branch.rpy:829
translate schinese ep11_ssolo_label_253b4c88:

    # sb "But there's a hell of a lot to lose."
    sb "但你有好多东西要失去。"

# episode11\branches\ep11_sage_branch.rpy:830
translate schinese ep11_ssolo_label_1e53a2f0:

    # sb "And you are staring into the face of the judge, jury, and executioner."
    sb "你正面对着审判者、陪审团和行刑者。"

# episode11\branches\ep11_sage_branch.rpy:834
translate schinese ep11_ssolo_label_8e882429:

    # sb "You know what? Don't tell me your intentions."
    sb "算了，不必告诉我你的目的。"

# episode11\branches\ep11_sage_branch.rpy:835
translate schinese ep11_ssolo_label_6f0351f1:

    # sb "Let them be an enigma. I like to think there's a plan behind your actions that I can't quite comprehend."
    sb "就让它是个谜吧。我倒愿意相信，你做这些事是有什么计划，只是我还没想明白。"

# episode11\branches\ep11_sage_branch.rpy:836
translate schinese ep11_ssolo_label_4576edc5:

    # sb "At least you're wise enough to stay silent..."
    sb "至少你还有点明白该保持沉默……"

# episode11\branches\ep11_sage_branch.rpy:838
translate schinese ep11_ssolo_label_eece9fc8:

    # sb "And I also think you should remain a man of few words. After all, speech is silver, but silence is golden."
    sb "我也觉得，你应该继续少说话。毕竟，言语是银，沉默是金。"

# episode11\branches\ep11_sage_branch.rpy:839
translate schinese ep11_ssolo_label_b082f2cf:

    # sb "So, that tape, this conversation, everything about you and my soon-to-be ex-wife... Remember..."
    sb "所以，那段视频、这次谈话，还有你和我那即将成为前妻的女人之间的一切……记住……"

# episode11\branches\ep11_sage_branch.rpy:841
translate schinese ep11_ssolo_label_ebfd2775:

    # sb "Speech is silver; silence is golden."
    sb "言语是银，沉默是金。"

# episode11\branches\ep11_sage_branch.rpy:845
translate schinese ep11_ssolo_label_628bdb45:

    # sb "There's the door."
    sb "门在那里。"

# episode11\branches\ep11_sage_branch.rpy:851
translate schinese ep11_ssolo_label_0d7bb86d:

    # sa "What did Dad want?"
    sa "爸爸找你干什么？"

# episode11\branches\ep11_sage_branch.rpy:853
translate schinese ep11_ssolo_label_8114a09f:

    # mc "Uh..."
    mc "嗯……"

# episode11\branches\ep11_sage_branch.rpy:855
