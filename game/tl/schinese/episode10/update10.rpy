translate schinese after_math_result_ep10_label_433ce53c:

    # ly "Did you pass the test?"
    ly "你考过了吗？"

# episode10\update10.rpy:3113
translate schinese after_math_result_ep10_label_a8c039a7:

    # mc "I did. You?"
    mc "我过了。你呢？"

