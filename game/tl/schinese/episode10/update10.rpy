translate schinese ep10_yoga2_label_03a8d1f0:

    # isa "Because it's an easy way to spend time together in public."
    isa "因为这样能在公众场合一起消磨时间，还挺方便的。"

# episode10\update10.rpy:5779
translate schinese ep10_yoga2_label_342eaae8:

    # mc "Are you sure they won't laugh?"
    mc "你确定他们不会笑？"

# episode10\update10.rpy:5781
