    # pa "Honey!? Do you need help?"
    pa "甜心？你没事吧？需要帮忙吗？"

# episode10\update10.rpy:378
translate schinese ep10_intro_label_ac6f771b:

    # hl "No! It's fine!"
    hl "不！没事的！"

# episode10\update10.rpy:380
translate schinese ep10_intro_label_85371ac8:

    # hl "*{i}Sobs{/i}*"
    hl "*{i}抽泣{/i}*"

# episode10\update10.rpy:382
translate schinese ep10_intro_label_525b654d:

    # pa "Come here."
    pa "过来。"

# episode10\update10.rpy:385
translate schinese ep10_intro_label_564f5018:

    # "*{i}Baby cries{/i}*"
    "*{i}婴儿哭声{/i}*"

# episode10\update10.rpy:387
translate schinese ep10_intro_label_907acd8c:

    # hl "Darn it. I woke them up."
    hl "该死，我吵醒他们了。"

# episode10\update10.rpy:389
translate schinese ep10_intro_label_e6025495:

    # pa "I'll take care of this. Go hold our babies."
    pa "我来处理这事。你去抱抱我们的宝宝。"

# episode10\update10.rpy:399
translate schinese ep10_intro_label_9034dbe2:

    # pa "Did they fall asleep?"
    pa "他们睡着了吗？"

# episode10\update10.rpy:402
translate schinese ep10_intro_label_e7d4656c:

    # hl "Yes."
    hl "嗯。"

# episode10\update10.rpy:403
translate schinese ep10_intro_label_5882316c:

    # hl "They are so beautiful - our tiny miracles."
    hl "他们真漂亮——我们的小奇迹。"

# episode10\update10.rpy:407
translate schinese ep10_intro_label_a673a4ce:

    # hl "What if...?"
    hl "如果……？"

# episode10\update10.rpy:408
translate schinese ep10_intro_label_1dc96709:

    # hl "What if the day comes when I can't hold them anymore?"
    hl "如果有一天我抱不动他们了怎么办？"

# episode10\update10.rpy:409
translate schinese ep10_intro_label_94fc8fba:

    # hl "When they grow too heavy and I am too weak?"
    hl "当他们变得太重，而我却太虚弱了？"

# episode10\update10.rpy:411
translate schinese ep10_intro_label_44d04008:

    # pa "That's not going to happen."
    pa "不会发生那种事的。"

# episode10\update10.rpy:413
translate schinese ep10_intro_label_3ec8e01a:

    # hl "It could. What if I drop them like I dropped that plate?"
    hl "它可能发生。如果我像摔那个盘子一样，把它们也摔了呢？"

# episode10\update10.rpy:415
translate schinese ep10_intro_label_3d9d2b04:

    # pa "If that happens, they'll be grown up and you won't have to worry about holding them by then."
    pa "如果那样的话，他们就已经长大成人了，你也不用再担心抱着他们了。"

# episode10\update10.rpy:417
translate schinese ep10_intro_label_5387ee51:

    # hl "What if it happens sooner than that?"
    hl "如果事情发生得比预期早呢？"

# episode10\update10.rpy:418
translate schinese ep10_intro_label_73ee7eda:

    # hl "I don't recognize my body anymore. I've become a stranger to it."
    hl "我都不认识自己的身体了，我变得连自己都陌生。"

# episode10\update10.rpy:420
translate schinese ep10_intro_label_72b60e3d:

    # pa "Then I'll hold them for you."
    pa "那我就替你抱着他们。"

# episode10\update10.rpy:422
translate schinese ep10_intro_label_01207752_1:

    # hl "..."
    hl "..."

# episode10\update10.rpy:424
translate schinese ep10_intro_label_32dfcd12:

    # pa "Dinner is ready."
    pa "晚饭好了。"

# episode10\update10.rpy:426
translate schinese ep10_intro_label_6d554457:

    # hl "Easy there, hungry."
    hl "慢点，饿狼。"

# episode10\update10.rpy:428
translate schinese ep10_intro_label_d3295a6c:

    # pa "*{i}Mmpff{/i}* Right."
    pa "*{i}唔嗯{/i}* 好吧。"

# episode10\update10.rpy:430
translate schinese ep10_intro_label_537ee9ce:

    # hl "Do you want to say it tonight?"
    hl "你今晚想说吗？"

# episode10\update10.rpy:432
translate schinese ep10_intro_label_7beb2443:

    # pa "No, I'm not good with the words."
    pa "不，我不太会说这些词。"

# episode10\update10.rpy:434
translate schinese ep10_intro_label_3d36f1c1:

    # hl "Our Heavenly Father."
    hl "我们天上的父。"

# episode10\update10.rpy:435
translate schinese ep10_intro_label_66b0879f:

    # hl "We thank you for our food and our drink. We are so thankful."
    hl "我们感谢你赐予我们的食物和饮品，我们非常感恩。"

# episode10\update10.rpy:436
translate schinese ep10_intro_label_e06dd79b:

    # hl "In a world where many go hungry, we share this food with grateful hearts."
    hl "在一个许多人挨饿的世界里，我们怀着感恩的心分享这食物。"

# episode10\update10.rpy:438
translate schinese ep10_intro_label_ea8b27ea:

    # pa "You've always been wonderful with your words, Helen. I admire you for it."
    pa "你一直很会表达，Helen。我很钦佩这一点。"

# episode10\update10.rpy:440
translate schinese ep10_intro_label_c42ce03a:

    # hl "It's not hard saying a prayer, love. You just let your heart speak loudly to him."
    hl "这不难，亲爱的。你只要让心里的话大声对祂说就行了。"

# episode10\update10.rpy:441
translate schinese ep10_intro_label_d7b9165c:

    # hl "You should try it more."
    hl "你得多试试。"

# episode10\update10.rpy:443
translate schinese ep10_intro_label_2a7599e2:

    # pa "What do you pray for?"
    pa "你祈祷什么？"

# episode10\update10.rpy:445
translate schinese ep10_intro_label_1817cebe:

    # hl "I pray for us."
    hl "我为咱们祈祷。"

# episode10\update10.rpy:446
translate schinese ep10_intro_label_2ecbb496:

    # hl "I pray for our well-being."
    hl "我为我们的幸福祈求。"

# episode10\update10.rpy:447
translate schinese ep10_intro_label_1b75f16f:

    # hl "I pray for our children and that they grow up to live long and happy lives."
    hl "我为我们的孩子祈祷，愿他们长大后能过上长久而幸福的生活。"

# episode10\update10.rpy:449
translate schinese ep10_intro_label_e665a4fe:

    # hl "I pray to see them graduate and become adults."
    hl "我祈祷他们能毕业，成为真正的成年人。"

# episode10\update10.rpy:451
translate schinese ep10_intro_label_8339d02a:

    # hl "I pray that, one day..."
    hl "我祈祷有一天……"

# episode10\update10.rpy:452
translate schinese ep10_intro_label_3f5def82:

    # hl "I get to see their father walk them down the aisle."
    hl "我能看到他们的父亲牵着他们走过礼堂的过道。"

# episode10\update10.rpy:453
translate schinese ep10_intro_label_37d4b234:

    # hl "And I pray for beautiful grandkids and a long and healthy life together with you by my side."
    hl "我祈求能有漂亮可爱的孙子孙女，还有能和你一起健康长久地生活。"

# episode10\update10.rpy:455
translate schinese ep10_intro_label_c5468c4c:

    # pa "Those are indeed things worth praying for."
    pa "这些都是值得祈祷的事。"

# episode10\update10.rpy:458
translate schinese ep10_intro_label_564f5018_1:

    # "*{i}Baby cries{/i}*"
    "*{i}婴儿哭声{/i}*"

# episode10\update10.rpy:459
translate schinese ep10_intro_label_c48630ca:

    # pa "I've got it this time."
    pa "这次交给我吧。"

# episode10\update10.rpy:461
translate schinese ep10_intro_label_3a8ec1ef:

    # hl "No, please. Let me."
    hl "不，求你了。让我来。"

# episode10\update10.rpy:463
translate schinese ep10_intro_label_d7f00e29:

    # pa "Of course, sweetheart."
    pa "当然，亲爱的。"

# episode10\update10.rpy:468
translate schinese ep10_intro_label_fc2cc0d6:

    # pa "Are you full?"
    pa "你吃饱了吗？"

# episode10\update10.rpy:470
translate schinese ep10_intro_label_0e9cbb46:

    # hl "No, I'm not full! My medication hasn't helped yet and I don't have an appetite this time of the day! You know that!"
    hl "不，我还没饱！我的药还没起作用，而且今天这个时候我一点胃口都没有！你明白的！"

# episode10\update10.rpy:471
translate schinese ep10_intro_label_bfbf5e3b:

    # hl "And I'm sweating too much! I'm overheating! I need to lie down!"
    hl "我也是，我太出汗了！我快要热死了！我需要躺下！"

# episode10\update10.rpy:473
translate schinese ep10_intro_label_6c744f38:

    # my "Derek! Stop it! DAAAD!!!"
    my "Derek！住手！爸——！！！"

# episode10\update10.rpy:474
translate schinese ep10_intro_label_e0d99e44:

    # my "Derek took my doll!!!"
    my "Derek抢走了我的娃娃！！！"

# episode10\update10.rpy:476
translate schinese ep10_intro_label_33a1352b:

    # pa "Derek! Be nice to your sister! You only get one!"
    pa "Derek！对你妹妹好一点！你可只有这一个妹妹！"

# episode10\update10.rpy:478
translate schinese ep10_intro_label_559f58e2:

    # pa "I have to return to work, but I'll try coming home early."
    pa "我得回去上班，但我会尽量早点回来。"

# episode10\update10.rpy:479
translate schinese ep10_intro_label_17cb35c1:

    # pa "Call Susan if you need to, you know she won't mind and she's just next door."
    pa "如果需要的话就打个电话给苏珊，她不会介意的，而且就在隔壁。"

# episode10\update10.rpy:481
translate schinese ep10_intro_label_a48cc476:

    # hl "You don't have to remind me! Go to work! That's all you ever do."
    hl "用不着你提醒！去工作吧！反正你永远只会工作。"

# episode10\update10.rpy:482
translate schinese ep10_intro_label_1d3d8cf0:

    # hl "And it's a constant reminder of what I can't do."
    hl "它无时无刻不在提醒我，自己什么也做不了。"

# episode10\update10.rpy:483
translate schinese ep10_intro_label_aaff2695:

    # hl "Work, work, work..."
    hl "工作，工作，工作……"

# episode10\update10.rpy:485
translate schinese ep10_intro_label_cb16be87:

    # pa "..."
    pa "..."

# episode10\update10.rpy:487
translate schinese ep10_intro_label_f230badc:

    # pa "If you're looking for a reliable RV, this is it."
    pa "如果你想找个靠谱的房车，这就是了。"

# episode10\update10.rpy:488
translate schinese ep10_intro_label_001141d7:

    # pa "I own a caravan of the same brand and it's been a blessing every summer with the wife and kids and all."
    pa "我也有同品牌的房车，每年夏天带着老婆孩子用它都特别幸福。"

# episode10\update10.rpy:489
translate schinese ep10_intro_label_c1deaffc:

    # pa "Getting away from daily life and being one with nature..."
    pa "远离日常生活的喧嚣，与自然融为一体……"

# episode10\update10.rpy:490
translate schinese ep10_intro_label_1c944c07:

    # pa "This RV is even a step up. You'd be lucky to own it."
    pa "这辆房车可不止是普通款，你要是能开上它，那真是赚到了。"

# episode10\update10.rpy:492
translate schinese ep10_intro_label_d897850e:

    # cs "It sure looks the part, but I'll have to look around more before I decide."
    cs "这辆确实挺像那么回事，但我得再多看看再做决定。"

# episode10\update10.rpy:494
translate schinese ep10_intro_label_cdf64144:

    # pa "Absolutely! If you need me for anything, I'll be in my office. Please don't hesitate."
    pa "当然！如果你需要我帮忙，随时来找我。我的办公室见。别犹豫。"

# episode10\update10.rpy:500
translate schinese ep10_intro_label_cb16be87_1:

    # pa "..."
    pa "..."

# episode10\update10.rpy:502
translate schinese ep10_intro_label_323ac06a:

    # pa "Father...? Uh..."
    pa "天父……？呃……"

# episode10\update10.rpy:503
translate schinese ep10_intro_label_11452641:

    # pa "I know we don't talk much and I haven't been the most devout Christian, but..."
    pa "我知道自己很少向你祈祷，也算不上最虔诚的基督徒，可是……"

# episode10\update10.rpy:504
translate schinese ep10_intro_label_115e1c78:

    # pa "I don't know where else to turn."
    pa "我不知道还能找谁求助了。"

# episode10\update10.rpy:505
translate schinese ep10_intro_label_b61eb7ef:

    # pa "I've tried to learn from Helen, but forgive me if I say the wrong things."
    pa "我一直试着向Helen学习，如果说错了什么，请原谅我。"

# episode10\update10.rpy:507
translate schinese ep10_intro_label_1b735d72:

    # pa "I want to ask you..."
    pa "我想问你..."

# episode10\update10.rpy:508
translate schinese ep10_intro_label_24bbaf82:

    # pa "Why...?"
    pa "为什么...？"

# episode10\update10.rpy:509
translate schinese ep10_intro_label_327bfbde:

    # pa "Why are you doing this to me?"
    pa "为什么你要这样对我？"

# episode10\update10.rpy:511
translate schinese ep10_intro_label_9681ecad:

    # pa "I work and I make a great living. I can provide for my family."
    pa "我工作，赚得不少。我有能力养活我的家人。"

# episode10\update10.rpy:512
translate schinese ep10_intro_label_1ef07b79:

    # pa "And while I can give my wife a lot, I cannot give her health."
    pa "而我虽然能给她很多，却无法给她健康。"

# episode10\update10.rpy:513
translate schinese ep10_intro_label_fc02e022:

    # pa "I cannot give her a normal life. How I wish I could."
    pa "我无法给她一个正常的生活。我多希望我能做到。"

# episode10\update10.rpy:515
translate schinese ep10_intro_label_862167cf:

    # pa "I wish I had healing hands to restore her to what she used to be."
    pa "我希望我有治愈的手，能把她带回从前的样子。"

# episode10\update10.rpy:516
translate schinese ep10_intro_label_5bf7f310:

    # pa "I wish there were medication strong enough to take her pain away, even if it's just for one day."
    pa "我希望有足够强的药能让她一天不疼，哪怕只是一天。"

# episode10\update10.rpy:517
translate schinese ep10_intro_label_17e61cd0:

    # pa "I'd even accept her pain, to feel what she feels."
    pa "我甚至愿意承受她的痛苦，去感受她所经历的一切。"

# episode10\update10.rpy:519
translate schinese ep10_intro_label_f9d434b6:

    # pa "I wish for all of her dreams to come true."
    pa "我希望她所有的梦想都能实现。"

# episode10\update10.rpy:520
translate schinese ep10_intro_label_1f84ac4e:

    # pa "You already took away one of them; don't take away the rest."
    pa "你已经拿走了一个，别把剩下的也拿走。"

# episode10\update10.rpy:521
translate schinese ep10_intro_label_b7246ee0:

    # pa "Please?"
    pa "请？"

# episode10\update10.rpy:524
translate schinese ep10_intro_label_65ad5c97:

    # cs "Excuse me."
    cs "打扰一下。"

# episode10\update10.rpy:525
translate schinese ep10_intro_label_ba39ac3e:

    # pa "Yes?"
    pa "什么事？"

# episode10\update10.rpy:526
translate schinese ep10_intro_label_528e3a22:

    # cs "I've made up my mind. I'll take it."
    cs "我决定了，我要了。"

# episode10\update10.rpy:528
translate schinese ep10_intro_label_e45ef058:

    # pa "That's...great! I'll get the paperwork ready."
    pa "那...太好了！我这就准备文件。"

# episode10\update10.rpy:531
translate schinese ep10_intro_label_bdd26578:

    # pa "{i}I pray for you, Helen.{/i}"
    pa "{i}我为你祈祷，Helen。{/i}"

# episode10\update10.rpy:532
translate schinese ep10_intro_label_e89a45f3:

    # pa "{i}I know who you are deep down inside. And I have learned to separate your sickness from the real you.{/i}"
    pa "{i}我知道真实的你是什么样，也学会了把疾病造成的改变和真正的你分开。{/i}"

# episode10\update10.rpy:534
translate schinese ep10_intro_label_84501643:

    # pa "{i}I'll be there for you, through thick and thin.{/i}"
    pa "{i}我会一直陪在你身边，无论顺境逆境。{/i}"

# episode10\update10.rpy:535
translate schinese ep10_intro_label_6d29df35:

    # pa "{i}Just like I promised you in our vows, I promise this to you now...{/i}"
    pa "{i}就像我当初在誓言中承诺你的那样，我现在再次向你承诺……{/i}"

# episode10\update10.rpy:537
translate schinese ep10_intro_label_15d78623:

    # pa "{i}I'll do it all for you. Every wish I can fulfill will come true.{/i}"
    pa "{i}我会为你做这一切。只要是我能实现的愿望，都会成真。{/i}"

# episode10\update10.rpy:538
translate schinese ep10_intro_label_f4cd1d42:

    # pa "{i}I'll bounce our kids on my knees for you.{/i}"
    pa "{i}我会替你把孩子们抱在膝头逗他们开心。{/i}"

# episode10\update10.rpy:540
translate schinese ep10_intro_label_5f54a7c1:

    # pa "{i}I'll make sure that you'll live long enough to see our children grow old.{/i}"
    pa "{i}我会确保你活到看到我们的孩子长大成人。{/i}"

# episode10\update10.rpy:542
translate schinese ep10_intro_label_27dc75a2:

    # pa "{i}To see them graduate.{/i}"
    pa "{i}看到他们毕业。{/i}"

# episode10\update10.rpy:544
translate schinese ep10_intro_label_c13ed9c4:

    # pa "{i}To see them walk down the aisle.{/i}"
    pa "{i}看着他们步入婚礼殿堂。{/i}"

# episode10\update10.rpy:546
translate schinese ep10_intro_label_da90469f:

    # pa "{i}To see them have children of their own.{/i}"
    pa "{i}看到他们有自己的孩子。{/i}"

# episode10\update10.rpy:549
translate schinese ep10_intro_label_c6956c28:

    # pa "{i}All of this...{/i}"
    pa "{i}这一切……{/i}"

# episode10\update10.rpy:550
translate schinese ep10_intro_label_45e01f9f:

    # pa "{i}I promise you.{/i}"
    pa "{i}我向你保证。{/i}"

# episode10\update10.rpy:561
translate schinese ep10_intro_label_91840957:

    # zo "Fuck! Shitballs! Fuck!"
    zo "操！见鬼了！操！"

# episode10\update10.rpy:602
translate schinese ep10_dik_intro_label_90429ecd:

    # jac "Tell me there's hot coffee in that pot..."
    jac "快告诉我，那壶里有热咖啡……"

# episode10\update10.rpy:607
translate schinese ep10_dik_intro_label_ff5c44d5:

    # mc "Yeah, help yourself. I'm on cup three already."
    mc "有，自己倒吧。我已经喝到第三杯了。"

# episode10\update10.rpy:609
translate schinese ep10_dik_intro_label_856e5d3d:

    # jac "That sounds like a nasty hangover."
    jac "听起来像是个该死的宿醉。"

# episode10\update10.rpy:611
translate schinese ep10_dik_intro_label_7ed05ab0:

    # mc "It's not bad. I'm mostly feeling tired. That party drained me."
    mc "不算严重，主要就是累。昨晚的派对把我耗干了。"

# episode10\update10.rpy:614
translate schinese ep10_dik_intro_label_9903ef3e:

    # jac "I bet that something did drain you, you lucky dog."
    jac "我打赌肯定有什么东西把你榨干了，你这幸运鬼。"

# episode10\update10.rpy:616
translate schinese ep10_dik_intro_label_2fdef52b:

    # jac "Same. I had one too many shots. Derek knows how to make them."
    jac "我也是，多喝了一杯烈酒。Derek真会调酒。"

# episode10\update10.rpy:617
translate schinese ep10_dik_intro_label_f40ca05d:

    # jac "I woke up at 8 a.m. and had to hurl."
    jac "我八点就醒来了，然后吐了一地。"

# episode10\update10.rpy:619
translate schinese ep10_dik_intro_label_f59d44e4:

    # de "[mc_de_up]?"
    de "[mc_de_up]？"

# episode10\update10.rpy:622
translate schinese ep10_dik_intro_label_871a3580:

    # mc "Coffee?"
    mc "咖啡？"

# episode10\update10.rpy:624
translate schinese ep10_dik_intro_label_cd98c178:

    # de "Nah, I'm good."
    de "不用，我还好。"

# episode10\update10.rpy:627
translate schinese ep10_dik_intro_label_e3598aab:

    # mc "Hey, he lives."
    mc "嘿，你总算活过来了。"

# episode10\update10.rpy:629
translate schinese ep10_dik_intro_label_466e6bdf:

    # jac "Hungover, yet? Or are you still buzzing?"
    jac "宿醉了吗？还是酒劲还没退？"

# episode10\update10.rpy:631
translate schinese ep10_dik_intro_label_bf06249a:

    # de "I don't get hangovers."
    de "我从不会宿醉。"

# episode10\update10.rpy:633
translate schinese ep10_dik_intro_label_794c7ed1:

    # jac "Man, fuck you. You're lucky."
    jac "狗日的，你他妈真走运。"

# episode10\update10.rpy:635
translate schinese ep10_dik_intro_label_f2ab36a4:

    # de "[mc_de_up]? A word?"
    de "[mc_de_up]，能聊几句吗？"

# episode10\update10.rpy:637
translate schinese ep10_dik_intro_label_606e2d02:

    # mc "Sure."
    mc "当然。"

# episode10\update10.rpy:642
translate schinese ep10_dik2_intro_label_9e32b2fc:

    # mc "If it's about earlier... Let me just say that I'm sorry it came out that way."
    mc "如果刚才那事...我只想说，很抱歉它会变成那样。"

# episode10\update10.rpy:644
translate schinese ep10_dik2_intro_label_191559e1:

    # mc "What's up?"
    mc "咋了？"

# episode10\update10.rpy:648
translate schinese ep10_dik2_intro_label_66383011:

    # de "It's not about that."
    de "不是刚才那件事。"

# episode10\update10.rpy:649
translate schinese ep10_dik2_intro_label_ed862fd2:

    # mc "Ok..."
    mc "嗯……"

# episode10\update10.rpy:650
translate schinese ep10_dik2_intro_label_c815e560:

    # mc "Why are you closing the drapes?"
    mc "你干嘛拉上窗帘？"

# episode10\update10.rpy:652
translate schinese ep10_dik2_intro_label_9f2ab5b2:

    # mc "Sunlight's that bad, huh? You don't have to pretend you don't get hangovers if you do."
    mc "阳光就这么难受？你要是真宿醉，也不用假装自己不会。"

# episode10\update10.rpy:653
translate schinese ep10_dik2_intro_label_72f46204:

    # mc "I wouldn't think less of you if you did."
    mc "你这么做我不会觉得你丢脸。"

# episode10\update10.rpy:655
translate schinese ep10_dik2_intro_label_4d122796:

    # de "Help me check the ceiling for any flashing lights."
    de "帮我检查天花板上有没有闪烁的灯光。"

# episode10\update10.rpy:657
translate schinese ep10_dik2_intro_label_59e1c81b:

    # mc "Are you feeling ok?"
    mc "你感觉还好吗？"

# episode10\update10.rpy:659
translate schinese ep10_dik2_intro_label_98201d10:

    # de "I'm feeling a bit sick, but I'm fine."
    de "我感觉有点不舒服，但没事。"

# episode10\update10.rpy:665
translate schinese ep10_dik2_intro_label_519ed196:

    # mc "That does sound like a hangover to me."
    mc "这听起来像醉酒后的后遗症。"

# episode10\update10.rpy:667
translate schinese ep10_dik2_intro_label_d5fa11b6:

    # de "It's not that. Can you find anything?"
    de "不是宿醉。你发现什么了吗？"

# episode10\update10.rpy:669
translate schinese ep10_dik2_intro_label_d6724cdc:

    # mc "No, everything is dark. Can we let some sunlight in or...?"
    mc "不，这里什么都看不见。要不我们开个窗，或者……？"

# episode10\update10.rpy:673
translate schinese ep10_dik2_intro_label_cf74aef2:

    # de "This room seems clean."
    de "这房间看起来挺干净的。"

# episode10\update10.rpy:675
translate schinese ep10_dik2_intro_label_8d868080:

    # mc "Clean from what?"
    mc "没有什么？"

# episode10\update10.rpy:677
translate schinese ep10_dik2_intro_label_98da4a25:

    # de "Listen, this has to stay between you and me."
    de "听着，这事只能你我之间知道。"

# episode10\update10.rpy:678
translate schinese ep10_dik2_intro_label_f0733e60:

    # de "You're the only one I can trust."
    de "你是唯一一个我能信任的人。"

# episode10\update10.rpy:680
translate schinese ep10_dik2_intro_label_564f4cca:

    # mc "What's the matter? Why are you so secretive?"
    mc "怎么了？你干嘛这么神秘？"

# episode10\update10.rpy:682
translate schinese ep10_dik2_intro_label_1bac0fb2:

    # de "I found something in my room today."
    de "我今天在房间里发现了一些东西。"

# episode10\update10.rpy:683
translate schinese ep10_dik2_intro_label_3951c932:

    # de "When I woke up, I saw this faint red flashing light in one of my ceiling spotlights."
    de "我醒来的时候，看见天花板灯里闪着一盏微弱的红光。"

# episode10\update10.rpy:685
translate schinese ep10_dik2_intro_label_f9a30f6d:

    # de "I found this inside of it."
    de "我在里面发现了这个。"

# episode10\update10.rpy:686
translate schinese ep10_dik2_intro_label_7a0e86b4:

    # mc "What is that?"
    mc "那是什么？"

# episode10\update10.rpy:687
translate schinese ep10_dik2_intro_label_b8c50405:

    # de "What does it look like? It's some kind of a security camera, no?"
    de "还能是什么？某种监控摄像头，对吧？"

# episode10\update10.rpy:689
translate schinese ep10_dik2_intro_label_6b5e9511:

    # mc "Why would there be a security camera in your closet?"
    mc "为什么你的衣橱里会有一台监控摄像头？"

# episode10\update10.rpy:691
translate schinese ep10_dik2_intro_label_e26e1962:

    # de "That's what I'm trying to figure out."
    de "这就是我正试着弄清楚的事。"

# episode10\update10.rpy:693
translate schinese ep10_dik2_intro_label_da9d45ee:

    # mc "Did someone put it there last night?"
    mc "有人昨晚把它放那儿的？"

# episode10\update10.rpy:695
translate schinese ep10_dik2_intro_label_a8135f6b:

    # de "Nah, no way."
    de "没那回事。"

# episode10\update10.rpy:697
translate schinese ep10_dik2_intro_label_8967c66d:

    # mc "But if it was flashing, you would have spotted it earlier."
    mc "但如果它在闪烁，你早就该发现了。"

# episode10\update10.rpy:699
translate schinese ep10_dik2_intro_label_a1a9216f:

    # de "Yeah. Unless something happened to it during that blackout. What if it's been there all this time?"
    de "对。除非昨晚停电时它出了故障。万一它其实一直都在那里呢？"

# episode10\update10.rpy:700
translate schinese ep10_dik2_intro_label_115f892e:

    # de "What if someone has spied on me in that room?"
    de "如果有人在我房间里偷看我怎么办？"

# episode10\update10.rpy:702
translate schinese ep10_dik2_intro_label_5519caab:

    # mc "Why would someone spy on you?"
    mc "为什么有人要监视你？"

# episode10\update10.rpy:704
translate schinese ep10_dik2_intro_label_987271e4:

    # de "I have no clue, but you're the only one I can trust with this. Because I know you'd never do that to me."
    de "我真不知道，但你是我唯一能信任的人。因为我知道你绝不会对我做这种事。"

# episode10\update10.rpy:706
translate schinese ep10_dik2_intro_label_29ca1d5e:

    # mc "Wait... Are you suggesting that a DIK put it there?"
    mc "等等……你是说DIK把它放那儿的？"

# episode10\update10.rpy:708
translate schinese ep10_dik2_intro_label_5d343462:

    # de "It sure as hell wasn't installed at a party."
    de "这玩意儿肯定不是在派对上装的。"

# episode10\update10.rpy:710
translate schinese ep10_dik2_intro_label_7d697ef0:

    # mc "How can you be sure?"
    mc "你怎么能这么确定？"

# episode10\update10.rpy:712
translate schinese ep10_dik2_intro_label_4da5f618:

    # de "Look at the cable... I had to rip it out. It's not a simple plug-in camera... This one requires some proper installation."
    de "看看这根线...我不得不把它扯出来。这不是个简单的插电式摄像头...这个需要好好安装。"

# episode10\update10.rpy:713
translate schinese ep10_dik2_intro_label_ae7bb898:

    # de "Who else would have the time and opportunity to install it besides someone living here?"
    de "还有谁有时间和机会装这个，除了住在这里的人？"

# episode10\update10.rpy:714
translate schinese ep10_dik2_intro_label_bedda2ac:

    # de "Didn't we change the lights after the alphas trashed the mansion?"
    de "阿尔法砸了豪宅之后，我们不是换过灯吗？"

# episode10\update10.rpy:716
translate schinese ep10_dik2_intro_label_f182ad78:

    # mc "Yeah, I remember we replaced some broken ones. Were there any broken lights in your room?"
    mc "对，我记得我们换过一些坏掉的灯泡。你房间有坏掉的灯吗？"

# episode10\update10.rpy:718
translate schinese ep10_dik2_intro_label_c79a0559:

    # de "I don't remember. Every room was a mess back then. Who replaced the lights?"
    de "我记不清了。那时候每个房间都乱得一塌糊涂。是谁换的灯？"

# episode10\update10.rpy:720
translate schinese ep10_dik2_intro_label_8f4ff141:

    # mc "I can't remember. We could ask Rusty if he does."
    mc "我不记得了。可以问问Rusty，看他记不记得。"

# episode10\update10.rpy:722
translate schinese ep10_dik2_intro_label_ca37df98:

    # de "We could, but it's his laptop, right? What if it has a direct feed to the camera?"
    de "我们是可以这么做，但那是他的笔记本电脑，对吧？要是它直接连着摄像头怎么办？"

# episode10\update10.rpy:724
translate schinese ep10_dik2_intro_label_fbbdf2d2:

    # mc "Are you saying we can't even trust Rusty? I thought you two were close."
    mc "你是说我们连Rusty都不能信？我还以为你们俩很亲近。"

# episode10\update10.rpy:726
translate schinese ep10_dik2_intro_label_571eca32:

    # de "We are close and I'm not saying that... But like I said, I can only trust you right now."
    de "我们关系不错，我可没说……但就像我说的，现在我只能信任你。"

# episode10\update10.rpy:727
translate schinese ep10_dik2_intro_label_019817f4:

    # de "I've done some nasty stuff in that closet, and if someone has recordings of me..."
    de "我在那间储物间里干过不少见不得人的事，如果有人录下了我……"

# episode10\update10.rpy:728
translate schinese ep10_dik2_intro_label_0acac6ae:

    # de "Not only would that be it for my reputation, but it could also hurt Ashley."
    de "这不仅会毁掉我的名声，还可能伤害Ashley。"

# episode10\update10.rpy:729
translate schinese ep10_dik2_intro_label_320acb02:

    # de "I want to understand this better before I start confronting people about it."
    de "我想先弄清楚这件事的来龙去脉，再开始跟别人对质。"

# episode10\update10.rpy:731
translate schinese ep10_dik2_intro_label_5f2d002c:

    # mc "Ok. I'm with you."
    mc "好，我跟你走。"

# episode10\update10.rpy:733
translate schinese ep10_dik2_intro_label_1b02c1df:

    # de "I will check if I can find more flashing red lights in the mansion. If you get the chance to check some rooms, do it."
    de "我会检查豪宅里还有没有闪烁的红灯。你要是有机会进其他房间，也帮忙查看。"

# episode10\update10.rpy:735
translate schinese ep10_dik2_intro_label_1c968398:

    # mc "I'll be discreet and check what I can."
    mc "我会小心查探，看看能发现什么。"

# episode10\update10.rpy:737
translate schinese ep10_dik2_intro_label_40c56222:

    # de "Flip the light to the room and look for anything that flashes."
    de "把灯调到房间那边，看看有没有什么在闪烁的。"

# episode10\update10.rpy:738
translate schinese ep10_dik2_intro_label_4b0dbf14:

    # de "[mc_de_up]... Thanks."
    de "[mc_de_up]谢谢。"

# episode10\update10.rpy:740
translate schinese ep10_dik2_intro_label_aa82d6a1:

    # mc "Any time, bro."
    mc "随时奉陪，老兄。"

# episode10\update10.rpy:743
translate schinese ep10_dik2_intro_label_6aa46d04:

    # mc "(It sounds crazy that someone would put a hidden camera in his closet... Who would do that?)"
    mc "（有人会在自己的衣橱里装隐藏摄像头，这听起来真疯狂……到底是谁干的？）"

# episode10\update10.rpy:752
translate schinese ep10_ip_label_01404690:

    # isa "Professor Hoff, can I borrow a moment of your time?"
    isa "霍夫教授，能占用您一点时间吗？"

# episode10\update10.rpy:754
translate schinese ep10_ip_label_ad8c4c74:

    # ph "Certainly, Mrs. Roberts. What can I do for you?"
    ph "当然，罗伯茨女士。您需要什么帮助？"

# episode10\update10.rpy:756
translate schinese ep10_ip_label_ef4c2075:

    # isa "It's about the midterms for our freshman classes."
    isa "是关于我们新生们的期中考试。"

# episode10\update10.rpy:758
translate schinese ep10_ip_label_72509615:

    # ph "Yes, of course. What about them?"
    ph "当然，那又如何？"

# episode10\update10.rpy:760
translate schinese ep10_ip_label_5762742a:

    # isa "I wanted to ask if you have noticed anything unusual when correcting the tests."
    isa "我想问问你批改试卷的时候有没有注意到什么异常的情况。"

# episode10\update10.rpy:762
translate schinese ep10_ip_label_a9fed70f:

    # ph "Anything unusual? No, I can't say that I have. There was a healthy mix of pass and fail."
    ph "没什么特别的，我不能说有。成绩分布挺正常的，有人及格，也有人不及格。"

# episode10\update10.rpy:763
translate schinese ep10_ip_label_9d1bbf04:

    # ph "There were a couple of students who were nowhere near close to passing. And on the other side of the spectrum, a handful of students excelled."
    ph "有一两个学生连及格线都差得远，而另一些学生则表现得相当出色。"

# episode10\update10.rpy:765
translate schinese ep10_ip_label_0cef2176:

    # isa "About the students who excelled... Did all of their test answers seem coherent to you?"
    isa "关于那些表现突出的学生……你认为他们所有的答题都合乎逻辑吗？"

# episode10\update10.rpy:767
translate schinese ep10_ip_label_f1c8f4ff:

    # ph "Meaning?"
    ph "意思是什么？"

# episode10\update10.rpy:769
translate schinese ep10_ip_label_25b938bf:

    # isa "Did their conclusions seem logical for all answers?"
    isa "他们的答案结论看起来合乎逻辑吗？"

# episode10\update10.rpy:771
translate schinese ep10_ip_label_31385dcb:

    # ph "Um, yes? Honestly, I'm unsure what you're asking me right now."
    ph "嗯，说实话，我现在也不太确定你到底在问什么。"

# episode10\update10.rpy:774
translate schinese ep10_ip_label_eaddf484:

    # isa "Let me explain. When I corrected my tests, I came across one that had odd answers."
    isa "让我解释一下。当我批改试卷的时候，我发现有一份答卷的答案很奇怪。"

# episode10\update10.rpy:775
translate schinese ep10_ip_label_427a9596:

    # isa "Seeing that several answers had discrepancies, while others were spot on made me analyze the test in detail."
    isa "看到几道题答案有出入，而其他题又完全正确，这让我不得不仔细分析那张试卷。"

# episode10\update10.rpy:776
translate schinese ep10_ip_label_5472ba7e:

    # isa "I suspect that this student may have cheated on the test somehow."
    isa "我怀疑这个学生可能在考试中作弊了。"

# episode10\update10.rpy:778
translate schinese ep10_ip_label_2c6caf00:

    # isa "Let me explain. When I corrected my tests, I came across a couple of tests that had odd answers and shared the same reasoning for multiple answers."
    isa "让我解释一下。当我批改试卷的时候，我发现有几份试卷的答案很奇怪，而且多个问题的解题思路居然是一样的。"

# episode10\update10.rpy:779
translate schinese ep10_ip_label_d2997b12:

    # isa "Seeing that several answers had discrepancies, while others were spot on made me analyze the tests in detail."
    isa "看到几道题答案有出入，而其他题目却完全正确，这让我仔细分析了试卷。"

# episode10\update10.rpy:780
translate schinese ep10_ip_label_3eb31e10:

    # isa "I suspect that these students may have cheated on the test somehow."
    isa "我怀疑这些学生可能在考试中作弊了。"

# episode10\update10.rpy:783
translate schinese ep10_ip_label_d7d14762:

    # ph "And you want to inquire if the same student shows signs of cheating on my test."
    ph "你这是想查查那些学生是不是也在我的考卷上作弊了？"

# episode10\update10.rpy:785
translate schinese ep10_ip_label_f3617bf0:

    # ph "And you want to inquire if the same students show signs of cheating on my test."
    ph "你这是想查一下同样的学生在我试卷上有没有作弊的迹象。"

# episode10\update10.rpy:787
translate schinese ep10_ip_label_e14d3544:

    # isa "Exactly."
    isa "没错。"

# episode10\update10.rpy:789
translate schinese ep10_ip_label_21e4177c:

    # ph "This is tough, Mrs. Roberts. While I don't condone cheating, students are entitled to anonymity and privacy regarding the test results."
    ph "这挺难的，罗伯茨女士。虽然我不赞成作弊，但学生有权在考试成绩方面保持匿名和隐私。"

# episode10\update10.rpy:792
translate schinese ep10_ip_label_156ba8fe:

    # isa "I'm not asking you to divulge the test results to me. I'm asking you to take a closer look at one of your tests and see if you can find something."
    isa "我没让你把考试结果告诉我，我只是让你仔细看看其中一份试卷，看看能不能发现点什么。"

# episode10\update10.rpy:794
translate schinese ep10_ip_label_15a01719:

    # isa "I'm not asking you to divulge the test results to me. I'm asking you to take a closer look at two of your tests and see if you can find something."
    isa "我不是要你把考试结果告诉我，我是让你仔细看看其中两份试卷，看看能不能发现点什么。"

# episode10\update10.rpy:797
translate schinese ep10_ip_label_ae68f1a4:

    # ph "Do you have the student ID?"
    ph "你有学生ID吗？"

# episode10\update10.rpy:799
translate schinese ep10_ip_label_e6e1a301:

    # ph "Do you have their student IDs?"
    ph "你有他们的学生证号吗？"

# episode10\update10.rpy:801
translate schinese ep10_ip_label_ecf5755a:

    # isa "Thank you."
    isa "谢谢。"

# episode10\update10.rpy:806
translate schinese ep10_perks_update_label_eeab1438:

    # ji "It wouldn't have been a problem to help out with the cleaning."
    ji "这本来帮忙打扫也没啥大不了的。"

# episode10\update10.rpy:808
translate schinese ep10_perks_update_label_0a2abf0d:

    # mc "I know, but it was our party. I didn't want to make you do chores; I only wanted you to have fun."
    mc "我知道，但那是我们的派对。我不想让你做家务，我只是想让你玩得开心。"

# episode10\update10.rpy:810
translate schinese ep10_perks_update_label_7f341191:

    # ji "Next time, I will stay and help regardless."
    ji "下次我一定会留下来帮忙。"

# episode10\update10.rpy:812
translate schinese ep10_perks_update_label_1ed78737:

    # mc "Oh, there will be a next time?"
    mc "哦，下次还会有的？"

# episode10\update10.rpy:814
translate schinese ep10_perks_update_label_2584ebe8:

    # ji "Won't there?"
    ji "不会吗？"

# episode10\update10.rpy:816
translate schinese ep10_perks_update_label_cdb90aa2:

    # mc "There will be many parties, but from what I hear, I'm not sure if you'd be interested in them."
    mc "会有许多聚会，但据我所知，我不确定你是否会对它们感兴趣。"

# episode10\update10.rpy:818
translate schinese ep10_perks_update_label_c15ff0fd:

    # ji "Halloween was very fun. I'm starting to think that you think I can't handle your kind of parties."
    ji "万圣节过得挺开心的。我开始觉得你可能觉得我受不了你们这种派对。"

# episode10\update10.rpy:820
translate schinese ep10_perks_update_label_e590fbaa:

    # mc "There are things the guys want to do that I'm sure you would mind."
    mc "有些事情男生们想做，我敢肯定你会介意。"

# episode10\update10.rpy:822
translate schinese ep10_perks_update_label_d994f143:

    # ji "Try me!"
    ji "试试看？"

# episode10\update10.rpy:824
translate schinese ep10_perks_update_label_b1c99005:

    # mc "Tommy's been talking about some kind of a panty party, where I believe everyone's dressed in underwear."
    mc "Tommy一直在说什么内衣派对，我想参加的人都只穿内衣。"

# episode10\update10.rpy:825
translate schinese ep10_perks_update_label_7a9085cd:

    # mc "Would you be able to handle that?"
    mc "你能撑住吗？"

# episode10\update10.rpy:827
translate schinese ep10_perks_update_label_409d49a8:

    # ji "Ok, now I think that you know me better than I thought."
    ji "现在我觉得你比我想象的更了解我了。"

# episode10\update10.rpy:829
translate schinese ep10_perks_update_label_8289c56e:

    # mc "Haha! See? I'm only looking out for you."
    mc "哈哈！瞧瞧，我这不就是在为你着想嘛。"

# episode10\update10.rpy:831
translate schinese ep10_perks_update_label_9a135c74:

    # ji "I like that you are, but please don't feel like you have to protect me from what you guys are up to."
    ji "我喜欢你这样，但请别觉得你得为你们那些计划保护我。"

# episode10\update10.rpy:833
translate schinese ep10_perks_update_label_ddc787d3:

    # mc "I promise I won't make choices for you and to ask if you're interested, even if I can probably guess the answer. How does that sound?"
