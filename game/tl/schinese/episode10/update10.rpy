# episode10\update10.rpy:1644
translate schinese ep10_science_intro_label_ee847125:

    # mc "I wasn't. But that's fine. I like you more when you drink."
    mc "我没那个意思。不过没关系，我更喜欢你喝醉的时候。"

# episode10\update10.rpy:1648
translate schinese ep10_science_intro_label_cccabf0a:

    # mc "Whatever works for you."
    mc "随便你。"

# episode10\update10.rpy:1651
