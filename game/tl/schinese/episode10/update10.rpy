translate schinese ep10_maya_solo_label_5d36ee09:

    # my "Oh, right! It's time to test that TV for real!"
    my "哦，对了！该真正测试一下这台电视了！"

# episode10\update10.rpy:6832
translate schinese ep10_maya_solo_label_83a3710f:

    # my "Have you even been watching it?"
    my "你有在看吗？"

# episode10\update10.rpy:6834
translate schinese ep10_maya_solo_label_32e4cbc2:

    # mc "Not a lot. Some here and there."
    mc "没看多少。零零散散地看了些。"

# episode10\update10.rpy:6835
translate schinese ep10_maya_solo_label_a82538f9:

    # mc "But I wanna watch a movie on it with you."
    mc "但我真想和你一起在这台电视上看个电影。"

# episode10\update10.rpy:6837
translate schinese ep10_maya_solo_label_2e3de819:

    # my "Aw, have you been saving that moment for me?"
    my "哎，你是不是特意留着这个时刻给我？"

# episode10\update10.rpy:6839
translate schinese ep10_maya_solo_label_a0bf26d0:

    # mc "You are the first one I thought of, for sure."
    mc "你肯定是第一个我想到的人，毫无疑问。"

# episode10\update10.rpy:6842
translate schinese ep10_maya_solo_label_99fccf78:

    # my "This is gonna be so much fun!"
    my "这一定会特别好玩！"

# episode10\update10.rpy:6843
translate schinese ep10_maya_solo_label_aa56fd6c:

    # my "I need this distraction."
    my "我需要转移一下注意力。"

# episode10\update10.rpy:6845
translate schinese ep10_maya_solo_label_3640e7e0:

    # my "I've both been looking forward to and dreading tonight."
    my "我既期待又害怕今晚。"

# episode10\update10.rpy:6846
translate schinese ep10_maya_solo_label_1aab7bd2:

    # my "But I can't deny that I need this distraction."
    my "但我不能否认，自己确实需要转移注意力。"

# episode10\update10.rpy:6849
translate schinese ep10_maya_solo_label_141e3a1c:

    # mc "I know you do."
    mc "我知道你确实需要这个。"

# episode10\update10.rpy:6850
translate schinese ep10_maya_solo_label_af730b4a:

    # mc "About that... Things will work out. You know that, right?"
    mc "关于那个……事情会顺利解决的。你明白吧？"

# episode10\update10.rpy:6852
translate schinese ep10_maya_solo_label_cd51b057:

    # mc "I'm happy you wanted to come; I wasn't sure if you would."
    mc "我很高兴你愿意来；我本来还担心你不会来。"

# episode10\update10.rpy:6853
translate schinese ep10_maya_solo_label_3d6c375a:

    # mc "And I know you could use a distraction from the other thing, too."
    mc "而且我知道你也很需要从那件事上转移一下注意力。"

# episode10\update10.rpy:6854
translate schinese ep10_maya_solo_label_05f90290:

    # mc "And about that... Things will work out. You know that, right?"
    mc "关于那个……事情会顺利解决的。你明白吧？"

# episode10\update10.rpy:6856
translate schinese ep10_maya_solo_label_354951b8:

    # my "I'm glad you're sure about it."
    my "我很高兴你确定了。"

# episode10\update10.rpy:6858
translate schinese ep10_maya_solo_label_68a07b98:

    # mc "I have a feeling, don't you?"
    mc "我也有这种感觉，对吧？"

# episode10\update10.rpy:6859
translate schinese ep10_maya_solo_label_d6d9e43b:

    # mc "Everyone is rooting for you and doing their best to help out."
    mc "每个人都在为你加油，都在尽自己最大的努力帮你。"

# episode10\update10.rpy:6861
translate schinese ep10_maya_solo_label_c4d04467:

    # my "I can feel that, yes."
    my "我能感觉到，没错。"

# episode10\update10.rpy:6863
translate schinese ep10_maya_solo_label_7735355c:

    # mc "No matter what happens on Thanksgiving..."
    mc "不管感恩节会发生什么……"

# episode10\update10.rpy:6864
translate schinese ep10_maya_solo_label_01803742:

    # mc "Remember that you have our support."
    mc "记住，我们都在支持你。"

# episode10\update10.rpy:6866
translate schinese ep10_maya_solo_label_fc645303:

    # my "..."
    my "..."

# episode10\update10.rpy:6868
translate schinese ep10_maya_solo_label_dc3ccd56:

    # my "Do you have a plan on how to do it?"
    my "你有打算怎么搞吗？"

# episode10\update10.rpy:6870
translate schinese ep10_maya_solo_label_2e7fbf20:

    # mc "How to get the contract?"
    mc "怎么拿到合同？"

# episode10\update10.rpy:6872
translate schinese ep10_maya_solo_label_7d3c15cc:

    # my "Yeah. You can't just waltz in there."
    my "你不能就这么直接冲进去。"

# episode10\update10.rpy:6874
translate schinese ep10_maya_solo_label_78d73e5d:

    # mc "Maybe I'll excuse myself, head to the bathroom and get {i}lost{/i} on the way."
    mc "也许我会找个借口，去趟洗手间然后{i}失去{/i}在路上。"

# episode10\update10.rpy:6876
translate schinese ep10_maya_solo_label_344dd1cd:

    # my "And if Dad spots you in his office, snooping around his papers...then what?"
    my "如果你爸在办公室看到你，翻他的文件……那又怎么办？"

# episode10\update10.rpy:6880
translate schinese ep10_maya_solo_label_6d7081ed:

    # mc "I'll think of something. But let's hope it doesn't come to that."
    mc "我会想个办法。但希望到时候不至于用到这个。"

# episode10\update10.rpy:6884
translate schinese ep10_maya_solo_label_abb4eb25:

    # mc "If I do it while having my dick out I believe I can sell him a story that I was looking for toilet paper."
    mc "如果我边走边翘着家伙，我相信我能编个故事，说我是在找厕纸。"

# episode10\update10.rpy:6886
translate schinese ep10_maya_solo_label_6ad2926e:

    # my "Hahaha!"
    my "哈哈哈！"

# episode10\update10.rpy:6888
translate schinese ep10_maya_solo_label_5877e48d:

    # mc "Derek had an idea that he wanted to talk to me about."
    mc "Derek有个主意想和我谈谈。"

# episode10\update10.rpy:6889
translate schinese ep10_maya_solo_label_6b8216be:

    # mc "I'm not sure what it is, but he seemed confident it would work."
    mc "我不确定到底是什么，但他看起来挺有信心的，觉得这招能行。"

# episode10\update10.rpy:6892
translate schinese ep10_maya_solo_label_29c0cfe3:

    # my "Whatever happens... I trust you."
    my "无论发生什么……我都相信你。"

# episode10\update10.rpy:6895
translate schinese ep10_maya_solo_label_a95de0b6:

    # mc "That's good. I would be a bad boyfriend if you couldn't trust me."
    mc "这很好。如果你不能信任我，我当个男朋友就太差劲了。"

# episode10\update10.rpy:6897
translate schinese ep10_maya_solo_label_fa2c13e9:

    # my "It still feels weird hearing or saying those words."
    my "听起来还是怪怪的，听到或说出来都一样。"

# episode10\update10.rpy:6899
translate schinese ep10_maya_solo_label_65d498c5:

    # mc "To me, it feels right."
    mc "对我来说，感觉挺对的。"

# episode10\update10.rpy:6901
translate schinese ep10_maya_solo_label_d6cfefb1:

    # my "I'm very happy about it."
    my "我对此感到非常开心。"

# episode10\update10.rpy:6903
translate schinese ep10_maya_solo_label_fb4416e6:

    # my "Um..."
    my "嗯……"

# episode10\update10.rpy:6904
translate schinese ep10_maya_solo_label_9aa3d3cc:

    # my "The only thing that feels a bit weird is that Josy's not here tonight."
    my "唯一让我有点别扭的是 Josy 今晚没在这儿。"

# episode10\update10.rpy:6906
translate schinese ep10_maya_solo_label_90a7c170:

    # mc "Yeah, but I thought having some alone time with you would feel nice."
    mc "嗯，不过我觉得和你独处一下应该挺舒服的。"

# episode10\update10.rpy:6908
translate schinese ep10_maya_solo_label_55edaffd:

    # my "I also want to have alone time with you, but I can't shake that thought."
    my "我也想和你有独处的时间，但那个念头我甩不掉。"

# episode10\update10.rpy:6910
translate schinese ep10_maya_solo_label_08239be8:

    # mc "Look, you have alone time with her, too, right?"
    mc "你看，你也有和她独处的时间，对吧？"

# episode10\update10.rpy:6912
translate schinese ep10_maya_solo_label_d617e729:

    # my "Yeah."
    my "嗯。"

# episode10\update10.rpy:6914
translate schinese ep10_maya_solo_label_70713d38:

    # mc "And so can I if I want to. I think you're making too big of a deal of it."
    mc "那我也可以啊，我想你把这事儿想得太严重了。"

# episode10\update10.rpy:6915
translate schinese ep10_maya_solo_label_e3f0cd2f:

    # mc "I wanted to sit on this couch and watch a movie with you tonight - just the two of us."
    mc "我想今晚坐在沙发上跟你一起看场电影——就我们俩。"

# episode10\update10.rpy:6917
translate schinese ep10_maya_solo_label_0d9156e4:

    # my "Is that why you locked the door?"
    my "这是为什么你锁了门？"

# episode10\update10.rpy:6919
translate schinese ep10_maya_solo_label_49782914:

    # mc "Well... You're wearing thigh-high knee socks, and that's one of my weaknesses."
    mc "嗯……你穿着及膝的袜子，这可是我最受不了的弱点之一。"

# episode10\update10.rpy:6921
translate schinese ep10_maya_solo_label_fa7094c1:

    # my "Guess what?"
    my "猜猜看？"

# episode10\update10.rpy:6923
translate schinese ep10_maya_solo_label_11455b53:

    # mc "What?"
    mc "什么？"

# episode10\update10.rpy:6925
translate schinese ep10_maya_solo_label_8e5b3f52:

    # my "*{i}Whispers{/i}* I wouldn't be wearing them if I didn't already know that."
    my "*{i}耳语{/i}我不会穿着它们的，如果我不已经知道的话。"

# episode10\update10.rpy:6927
translate schinese ep10_maya_solo_label_f480384a:

    # mc "See! You're as sneaky as I am about this."
    mc "看吧，你在这事上跟我一样狡猾。"

# episode10\update10.rpy:6928
translate schinese ep10_maya_solo_label_6ad2926e_1:

    # my "Hahaha!"
    my "哈哈哈！"

# episode10\update10.rpy:6930
translate schinese ep10_maya_solo_label_7b0e87a6:

    # my "Are we gonna watch a movie? Because it feels like you won't be able to focus."
    my "我们看个电影吧？因为感觉你没法集中注意力。"

# episode10\update10.rpy:6932
translate schinese ep10_maya_solo_label_44586f05:

    # mc "Maybe we can watch one after...?"
    mc "也许我们看完之后还能看一部？"

# episode10\update10.rpy:6934
translate schinese ep10_maya_solo_label_8d5b6234:

    # my "After what?"
    my "之后的事？"

# episode10\update10.rpy:6936
translate schinese ep10_maya_solo_label_c603c9ef:

    # mc "After, you know?"
    mc "之后啊，你懂的。"

# episode10\update10.rpy:6938
translate schinese ep10_maya_solo_label_665f6a1f:

    # my "I don't think I could focus either, so...sure."
    my "我也没法集中注意力，那……好吧。"

# episode10\update10.rpy:6940
translate schinese ep10_maya_solo_label_b75b4875:

    # mc "Wanna go to the bed?"
    mc "要上床吗？"

# episode10\update10.rpy:6941
translate schinese ep10_maya_solo_label_87d59758:

    # my "No, I had something else in mind."
    my "不，我有别的想法。"

# episode10\update10.rpy:6944
translate schinese ep10_maya_solo_label_cb5a9641:

    # my "I can feel that you care a lot about me."
    my "我能感觉到你对我也很在意。"

# episode10\update10.rpy:6946
translate schinese ep10_maya_solo_label_f792b313:

    # mc "Good. Because I do."
    mc "好，因为我想。"

# episode10\update10.rpy:6948
translate schinese ep10_maya_solo_label_37620401:

    # my "And I want you to know I care a lot about you, too."
    my "而且我也很在乎你，真的。"

# episode10\update10.rpy:6951
translate schinese ep10_maya_solo_label_149fb10c:

    # my "I wish it were different between us. But I'm also happy that you're happy. You deserve that."
    my "我希望我们之间能不一样。但我也很高兴你能开心。你值得拥有这样的快乐。"

# episode10\update10.rpy:6952
translate schinese ep10_maya_solo_label_705c907f:

    # my "And I wouldn't want you to stay with me and Josy if you weren't truly happy. That would have felt a lot worse."
    my "而且如果我不真正在意你，我也不希望你一直和我还有Josy在一起。那样会更难受。"

# episode10\update10.rpy:6954
translate schinese ep10_maya_solo_label_2b0d52dc:

    # mc "It means the world to me that we still can hang out like this. I'm not sure if this is normal, but it doesn't feel like it is."
    mc "这对我来说意义重大，我们还能像这样一起待着。我不确定这算不算正常，但感觉一点都不像。"

# episode10\update10.rpy:6956
translate schinese ep10_maya_solo_label_37f57b70:

    # my "Who's normal?"
    my "谁正常？"

# episode10\update10.rpy:6958
translate schinese ep10_maya_solo_label_08a2eeb4:

    # my "Do you want to talk about her?"
    my "你想和她谈谈吗？"

# episode10\update10.rpy:6960
translate schinese ep10_maya_solo_label_128efe1b:

    # mc "About who?"
    mc "关于谁？"

# episode10\update10.rpy:6962
translate schinese ep10_maya_solo_label_2ff0247a:

    # my "Your girlfriend."
    my "你女朋友。"

# episode10\update10.rpy:6965
translate schinese ep10_maya_solo_label_c379fc36:

    # mc "Jill is great. We are unlike each other in many ways, but that doesn't stop us."
    mc "Jill很棒。我们有很多地方不一样，但这反而让关系更特别。"

# episode10\update10.rpy:6966
translate schinese ep10_maya_solo_label_22b7a070:

    # mc "We learn a lot from each other and can relate more than you'd think."
    mc "我们从彼此身上学到了很多，比你想象的更能产生共鸣。"

# episode10\update10.rpy:6967
translate schinese ep10_maya_solo_label_fd5114f8:

    # mc "I started dating her early when I came here, but our feelings grew pretty fast."
    mc "我从刚来这儿的时候就开始和她交往了，但我们的感情发展得挺快的。"

# episode10\update10.rpy:6970
translate schinese ep10_maya_solo_label_d0d6377d:

    # mc "Sage is amazing, but she's not my girlfriend yet."
    mc "Sage很厉害，但还没到女朋友那一步。"

# episode10\update10.rpy:6971
translate schinese ep10_maya_solo_label_306b3f6f:

    # mc "We have made a great connection, but we're still learning how to handle each other."
    mc "我们之间建立了很深的联系，但还在学习如何相处。"

# episode10\update10.rpy:6972
translate schinese ep10_maya_solo_label_d43a5dd9:

    # mc "We're both emotional but in different ways."
    mc "我们俩都挺感性的，只是方式不一样。"

# episode10\update10.rpy:6973
translate schinese ep10_maya_solo_label_ceb7335d:

    # mc "Ever since I met her, she's grown as a person in my eyes, and my feelings for her grew, too."
    mc "自从我遇见她之后，她在我的眼里变得越来越优秀，我对她的感情也跟着一起成长了。"

# episode10\update10.rpy:6976
translate schinese ep10_maya_solo_label_14eb1b9f:

    # mc "I shouldn't."
    mc "我不能。"

# episode10\update10.rpy:6978
translate schinese ep10_maya_solo_label_996d6b6e:

    # my "Why are you so secretive about it?"
    my "你为什么对这事这么藏着掖着？"

# episode10\update10.rpy:6980
translate schinese ep10_maya_solo_label_2b35b6fe:

    # mc "..."
    mc "..."

# episode10\update10.rpy:6981
translate schinese ep10_maya_solo_label_24ea8c40:

    # mc "Because I have to."
    mc "因为我必须。"

# episode10\update10.rpy:6983
translate schinese ep10_maya_solo_label_44f18746:

    # my "[name]... Who is it?"
    my "[name]是谁？"

# episode10\update10.rpy:6985
translate schinese ep10_maya_solo_label_2b35b6fe_1:

    # mc "..."
    mc "..."

# episode10\update10.rpy:6987
translate schinese ep10_maya_solo_label_482b66c4:

    # my "[name]. You can trust me. It's me."
    my "[name]你可以相信我。就是我。"

# episode10\update10.rpy:6989
translate schinese ep10_maya_solo_label_3c130cc5:

    # mc "It's..."
    mc "是伊莎贝拉。"

# episode10\update10.rpy:6990
translate schinese ep10_maya_solo_label_e4baa3f9:

    # mc "It's Isabella."
    mc "是Isabella。"

# episode10\update10.rpy:6992
translate schinese ep10_maya_solo_label_fc645303_1:

    # my "..."
    my "..."

# episode10\update10.rpy:6994
translate schinese ep10_maya_solo_label_16aaef03:

    # my "I did not expect that."
    my "我没料到会是这样。"

# episode10\update10.rpy:6995
translate schinese ep10_maya_solo_label_0401d20c:

    # my "How?"
    my "怎么？"

# episode10\update10.rpy:6997
translate schinese ep10_maya_solo_label_2d70a652:

    # mc "If I only knew where to begin."
    mc "如果我早知道该从哪里说起就好了。"

# episode10\update10.rpy:6998
translate schinese ep10_maya_solo_label_8a4b34f4:

    # mc "It's been growing since my first week here. Before I knew she'd be our teacher."
    mc "这段时间一直都在增长，从我刚到这里的第一周就开始了。在我知道她会成为我的老师之前，就已经这样了。"

# episode10\update10.rpy:6999
translate schinese ep10_maya_solo_label_f57f75e3:

    # mc "She helped me out when I came here and we quickly got a good connection that led to something more."
    mc "她刚来的时候帮我不少忙，我们很快建立了不错的联系，后来发展成了更进一步的关系。"

# episode10\update10.rpy:7000
translate schinese ep10_maya_solo_label_d5822d00:

    # mc "And after we found out she'd be teaching me, we couldn't announce it to the world."
    mc "然后我们得知她会教我，就忍不住想立刻告诉全世界。"

# episode10\update10.rpy:7002
translate schinese ep10_maya_solo_label_d151572e:

    # my "I can't believe you're living in the same situation as I am."
    my "我真不敢相信你居然也处在同样的处境里。"

# episode10\update10.rpy:7004
translate schinese ep10_maya_solo_label_1292de5a:

    # mc "Hey, you're right... I kind of am."
    mc "嘿，你说得对……我确实有点那个。"

# episode10\update10.rpy:7006
translate schinese ep10_maya_solo_label_23d091b2:

    # my "You don't have to explain it to me, [name]."
    my "你不用向我解释，[name]。"

# episode10\update10.rpy:7007
translate schinese ep10_maya_solo_label_73f38505:

    # my "If Isabella makes you happy, that's who you should be with. But..."
    my "如果Isabella能让你幸福，你就该和她在一起。可是……"

# episode10\update10.rpy:7008
translate schinese ep10_maya_solo_label_5c1ca2c7:

    # my "I thought she was married."
    my "我以为她结过婚了。"

# episode10\update10.rpy:7010
translate schinese ep10_maya_solo_label_5b947d59:

    # mc "Yeah, she is, but... It's complicated. And she does make me happy. A lot."
    mc "是的，她确实让我很开心，很多。但……情况挺复杂的。"

# episode10\update10.rpy:7011
translate schinese ep10_maya_solo_label_ae4e0411:

    # mc "And meanwhile, with you and Josy... It felt amazing but also hard."
    mc "与此同时，和你还有Josy在一起，感觉既棒又难熬。"

# episode10\update10.rpy:7013
translate schinese ep10_maya_solo_label_01112675:

    # mc "I enjoyed spending time with you two and loved everything we did together."
    mc "我和你们俩在一起的时候真的很开心，喜欢我们一起做的一切。"

# episode10\update10.rpy:7014
translate schinese ep10_maya_solo_label_954f2a05:

    # mc "But eventually, I had to make a choice."
    mc "但最终我不得不做出选择。"

# episode10\update10.rpy:7016
translate schinese ep10_maya_solo_label_483fffca:

    # my "I know."
    my "我知道。"

# episode10\update10.rpy:7017
translate schinese ep10_maya_solo_label_ec049b4f:

    # my "And you followed your heart like you always do."
    my "你就像以前一样，跟着自己的心走。"

# episode10\update10.rpy:7019
translate schinese ep10_maya_solo_label_7222bac4:

    # mc "I did."
