    dwy "你得冷静点，伙计。这种冲动的脾气只会给你带来麻烦。"

# episode10\update10.rpy:6592
translate schinese ep10_spar2_label_3de85157:

    # dwy "Trust me. I know all about it."
    dwy "信我，我全都了解。"

