translate schinese ep10_tg2_label_d6606c49:

    # pa "Ok, because I assumed you were close because you shared a dorm."
    pa "哦，我之前以为你们关系挺近，是因为你们住同一个宿舍。"

# episode10\update10.rpy:11091
translate schinese ep10_tg2_label_26bed9fa:

    # mc "Oh...right! That too."
    mc "哦……对！住过同一间宿舍也是一个原因。"

# episode10\update10.rpy:11095
translate schinese ep10_tg2_label_ef8ba2b9:

    # mc "But I moved out. I live in a fraternity now."
    mc "但我搬出去住了，现在住在兄弟会里。"

# episode10\update10.rpy:11097
translate schinese ep10_tg2_label_476e1641_1:

    # my "I've told you about that, Dad."
    my "我跟你说过这事了，老爸。"

# episode10\update10.rpy:11099
translate schinese ep10_tg2_label_941515b3:

    # pa "I remember."
    pa "我记得。"

# episode10\update10.rpy:11100
translate schinese ep10_tg2_label_06341517:

    # pa "Maya, will you help me out in the kitchen with dinner?"
    pa "Maya，能来厨房帮我准备晚餐吗？"

# episode10\update10.rpy:11102
translate schinese ep10_tg2_label_14cb1a58:

    # my "Sure..."
    my "当然..."

# episode10\update10.rpy:11105
translate schinese ep10_tg2_label_43198c4d:

    # "*{i}Vibrations{/i}*"
    "*{i}震动{/i}*"

# episode10\update10.rpy:11106
translate schinese ep10_tg2_label_9223249a:

    # mc "(Two for go. That's my cue. Time to look around.)"
    mc "（震两下就是行动。这是给我的信号，该去四处找找了。）"

# episode10\update10.rpy:11111
translate schinese ep10_ending_label_5b34e9d8:

    # mc "{i}What am I thankful for?{/i}"
    mc "{i}我有什么值得感恩的？{/i}"

# episode10\update10.rpy:11112
translate schinese ep10_ending_label_a8398185:

    # mc "{i}I'm thankful for that Thanksgiving. It brought everyone a lot closer.{/i}"
    mc "{i}我很感谢那个感恩节。它让大家都更亲近了。{/i}"

# episode10\update10.rpy:11114
translate schinese ep10_ending_label_689fce31:

    # mc "{i}Which is ironic, because it was also the worst Thanksgiving I've ever experienced.{/i}"
    mc "{i}这很讽刺，因为那也是我经历过的最糟糕的感恩节。{/i}"

# episode10\update10.rpy:11119
translate schinese ep10_ending_label_92f9fcb9:

    # mc "{i}And that horrible holiday weekend was only just beginning.{/i}"
    mc "{i}而那个可怕的假期周末才刚刚开始。{/i}"

# episode10\update10.rpy:11133
translate schinese ep10_ending_label_d53b118b:

    # mc "{i}I got to see new sides of both Derek and Maya. And I understand them much better for it.{/i}"
    mc "{i}我看到了Derek和Maya不为人知的一面，也因此更加理解他们。{/i}"

# episode10\update10.rpy:11134
translate schinese ep10_ending_label_01e9f0e7:

    # mc "{i}Derek wanted his sister to be safe. And out of all the things he's ever told me - usually disgusting - this was the most beautiful thing he ever said.{/i}"
    mc "{i}Derek希望妹妹平安无事。在他对我说过的所有话里——通常都很恶心——这是最动人的一句。{/i}"

# episode10\update10.rpy:11135
translate schinese ep10_ending_label_debca4a4:

    # mc "{i}Who doesn't want someone they love to be safe?{/i}"
    mc "{i}谁不想自己爱的人平安无事？{/i}"

# episode10\update10.rpy:11137
translate schinese ep10_ending_label_7f107dbc:

    # mc "{i}Who doesn't want to feel safe?{/i}"
    mc "{i}谁不想感觉安全？{/i}"

# episode10\update10.rpy:11141
translate schinese ep10_ending_label_91b1122d:

    # "*{i}Phone rings{/i}*"
    "*{i}电话铃声响起{/i}*"

# episode10\update10.rpy:11143
translate schinese ep10_ending_label_02c94a51:

    # ri "Quinn? Yeah, it went ok, but listen-"
    ri "Quinn？嗯，还算顺利，但你听我说——"

# episode10\update10.rpy:11145
translate schinese ep10_ending_label_4e8e24a2:

    # ri "I'm on my way, but I think I'm being followed. Can you meet me up?"
    ri "我正往你这边赶，但我感觉有人在跟踪我。你能先到那儿等我吗？"

# episode10\update10.rpy:11147
translate schinese ep10_ending_label_ca56e004:

    # ri "Vinny?"
    ri "Vinny？"

