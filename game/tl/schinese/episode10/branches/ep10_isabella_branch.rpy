    # isa "Aren't you?"
    isa "你不觉得吗？"

# episode10\branches\ep10_isabella_branch.rpy:271
translate schinese ep10_bsolo_label_f22b44d3:

    # mc "No. I don't see why I should be worried. Teachers eat lunch with their students on campus, too."
    mc "不，我没什么好担心的。老师也会在校园里和学生一起吃午饭的。"

# episode10\branches\ep10_isabella_branch.rpy:272
translate schinese ep10_bsolo_label_c5807c0b:

    # mc "If anything, it's weirder eating off-campus."
    mc "要是在校外吃就更奇怪了。"

# episode10\branches\ep10_isabella_branch.rpy:274
translate schinese ep10_bsolo_label_84622732:

    # mc "Yeah, a bit. But I don't know why. We hung out and had lunch before we...you know?"
    mc "有点。但我不知道为什么。我们之前一起吃过饭，然后……你懂的？"

# episode10\branches\ep10_isabella_branch.rpy:276
translate schinese ep10_bsolo_label_09516749:

    # isa "At least we can talk more freely here."
    isa "至少我们在这里可以更自在地聊天。"

# episode10\branches\ep10_isabella_branch.rpy:277
translate schinese ep10_bsolo_label_22ccbb70:

    # isa "So, about your frat mate... Is there any development I should know about?"
    isa "那说说你那个兄弟会的兄弟，有没有什么进展我应该知道的？"

# episode10\branches\ep10_isabella_branch.rpy:279
translate schinese ep10_bsolo_label_0f130cdb:

    # mc "Nick? No, he hasn't said a word about us. And I've checked with him two times."
    mc "Nick？没有，他根本没提我们的事。我还跟他确认了两遍。"

# episode10\branches\ep10_isabella_branch.rpy:280
translate schinese ep10_bsolo_label_260264d8:

    # mc "I thought he'd at least mention it to one of our brothers, but...nope. He's keeping a tight lid on it."
    mc "我以为他至少会跟我们兄弟中的一个提一下，但……没这回事。他把这事捂得严严实实的。"

# episode10\branches\ep10_isabella_branch.rpy:282
translate schinese ep10_bsolo_label_cf775adb:

    # isa "That's good."
    isa "这挺好。"

# episode10\branches\ep10_isabella_branch.rpy:284
translate schinese ep10_bsolo_label_d017d0d0:

    # mc "And the thing you were supposed to check... Did you do it yet?"
    mc "你该查的东西……你查了吗？"

# episode10\branches\ep10_isabella_branch.rpy:286
translate schinese ep10_bsolo_label_aae142ec:

    # isa "The handbook?"
    isa "手册？"

# episode10\branches\ep10_isabella_branch.rpy:288
translate schinese ep10_bsolo_label_f800bed0:

    # mc "Yes."
    mc "嗯。"

# episode10\branches\ep10_isabella_branch.rpy:290
translate schinese ep10_bsolo_label_870b2161:

    # isa "Don't worry about it."
    isa "别担心。"

# episode10\branches\ep10_isabella_branch.rpy:292
translate schinese ep10_bsolo_label_449ca2a4:

    # mc "You checked it. What did it say?"
    mc "你看了。里面说了什么？"

# episode10\branches\ep10_isabella_branch.rpy:294
translate schinese ep10_bsolo_label_82ae5aba:

    # isa "It's ok."
    isa "没关系。"

# episode10\branches\ep10_isabella_branch.rpy:296
translate schinese ep10_bsolo_label_441f5af4:

    # mc "It is? What's in there about it?"
    mc "这是什么？里面写了什么？"

# episode10\branches\ep10_isabella_branch.rpy:298
translate schinese ep10_bsolo_label_ed2efa0d:

    # isa "The lines are blurry, but let's not be concerned."
    isa "线条有点模糊，但咱们别太担心。"

# episode10\branches\ep10_isabella_branch.rpy:299
translate schinese ep10_bsolo_label_263c4be6:

    # isa "We'll be fine if we keep this between us and try our best to act normal on campus."
    isa "我们只要保持低调，尽量在校园里表现正常，应该就没问题。"

# episode10\branches\ep10_isabella_branch.rpy:301
translate schinese ep10_bsolo_label_7a74c902:

    # mc "That's amazing... Wow! I was kinda expecting the worst."
    mc "这太棒了……哇！我本来还担心最糟的情况呢。"

# episode10\branches\ep10_isabella_branch.rpy:302
translate schinese ep10_bsolo_label_b6192d99:

    # mc "I thought you'd have to stop seeing me, but I'm so happy this can continue."
    mc "我以为你得跟我断了，但能继续下去我太开心了。"

# episode10\branches\ep10_isabella_branch.rpy:304
translate schinese ep10_bsolo_label_5cd643e4:

    # isa "Me too."
    isa "我也是。"

# episode10\branches\ep10_isabella_branch.rpy:306
translate schinese ep10_bsolo_label_4b17dd4e:

    # mc "Now that we've dealt with that...I guess we can start focusing on each other differently."
    mc "既然我们已经解决了那个问题……我想我们现在可以开始以不同的方式关注彼此了。"

# episode10\branches\ep10_isabella_branch.rpy:308
translate schinese ep10_bsolo_label_540281b0:

    # isa "Like how?"
    isa "像这样？"

# episode10\branches\ep10_isabella_branch.rpy:310
translate schinese ep10_bsolo_label_a8202b08:

    # mc "Getting to know each other and all."
    mc "互相了解之类的。"

# episode10\branches\ep10_isabella_branch.rpy:312
translate schinese ep10_bsolo_label_d4202216:

    # isa "I think we've done a decent job of that in the past."
    isa "我觉得我们过去在这方面已经做得不错了。"

# episode10\branches\ep10_isabella_branch.rpy:314
translate schinese ep10_bsolo_label_859fde4a:

    # mc "Sure, sure. But there are things we've yet to learn."
    mc "当然，当然。但还有一些事情我们还没学到。"

# episode10\branches\ep10_isabella_branch.rpy:315
translate schinese ep10_bsolo_label_e811125b:

    # mc "Like...um... How long have you been working at B&R?"
    mc "比如……呃……你在B&R工作多久了？"

# episode10\branches\ep10_isabella_branch.rpy:317
translate schinese ep10_bsolo_label_7edc0449:

    # isa "A little bit over two years."
    isa "刚超过两年。"

# episode10\branches\ep10_isabella_branch.rpy:319
translate schinese ep10_bsolo_label_d2217617:

    # mc "Huh? Not longer? I thought you'd been here for at least five or maybe even ten years."
    mc "咦？没那么久？我以为你在这里至少待了五年，甚至可能十年呢。"

# episode10\branches\ep10_isabella_branch.rpy:321
translate schinese ep10_bsolo_label_07cdd404:

    # isa "No, I worked at another library before that. Uh..."
    isa "不，我之前在另一家图书馆工作过。呃……"

# episode10\branches\ep10_isabella_branch.rpy:322
translate schinese ep10_bsolo_label_04ba2985:

    # isa "It's a sensitive topic for me."
    isa "这是个让我很敏感的话题。"

# episode10\branches\ep10_isabella_branch.rpy:324
translate schinese ep10_bsolo_label_d5fafa00:

    # mc "Ok. Well, two years is nothing. You fit in very well here."
    mc "嗯，两年算什么。你在这里挺合群的。"

# episode10\branches\ep10_isabella_branch.rpy:326
translate schinese ep10_bsolo_label_0aea9e31:

    # isa "I do like it here."
    isa "我挺喜欢这里的。"

# episode10\branches\ep10_isabella_branch.rpy:327
translate schinese ep10_bsolo_label_43a268e6:

    # isa "The teaching I could do without, but the library work I enjoy."
    isa "我倒是挺喜欢图书馆的工作，教学嘛……就免了吧。"

# episode10\branches\ep10_isabella_branch.rpy:329
translate schinese ep10_bsolo_label_f34b8b8c:

    # mc "Sorry that our class isn't that great to teach at times."
    mc "抱歉，我们的课有时候教起来不太顺手。"

# episode10\branches\ep10_isabella_branch.rpy:331
translate schinese ep10_bsolo_label_767a9448:

    # isa "It's not your class that's the issue. It's me."
    isa "这不关你的课的事，是我。"

# episode10\branches\ep10_isabella_branch.rpy:332
translate schinese ep10_bsolo_label_d52c9f54:

    # isa "I'm sure everyone has to endure activities or people they could live without at work, and teaching is that for me."
    isa "我相信每个人在工作中都得忍受一些自己根本不想碰的事情，教学就是我最不想碰的那类。"

# episode10\branches\ep10_isabella_branch.rpy:333
translate schinese ep10_bsolo_label_8813579b:

    # isa "It's not that I hate it, but it's not what I pictured myself doing."
    isa "我不是讨厌这份工作，只是它跟我想象中做的不一样。"

# episode10\branches\ep10_isabella_branch.rpy:334
translate schinese ep10_bsolo_label_4f47d1ac:

    # isa "And lately, I've been given increased responsibilities for classes, which is a bummer."
    isa "最近我被安排了更多课程上的责任，真是烦人。"

# episode10\branches\ep10_isabella_branch.rpy:336
translate schinese ep10_bsolo_label_5bcf0383:

    # mc "Yeah? What was your dream job?"
    mc "你当初的梦想工作是什么？"

# episode10\branches\ep10_isabella_branch.rpy:338
translate schinese ep10_bsolo_label_a81e959c:

    # isa "During my first job interviews after college, they liked to ask what I pictured myself doing in five years, and I was naive back then."
    isa "大学毕业后第一次参加面试时，他们总爱问我五年后想做什么，那时候我真是天真。"

# episode10\branches\ep10_isabella_branch.rpy:339
translate schinese ep10_bsolo_label_2c37174f:

    # isa "I answered wholeheartedly, in a way that didn't scream \"prospective long-term employee\"."
    isa "我回答得非常认真，但没让人觉得我是个想长期待下去的员工。"

# episode10\branches\ep10_isabella_branch.rpy:340
translate schinese ep10_bsolo_label_983cc21e:

    # isa "After I realized they weren't going to hire someone who said they wanted to start their own business - a small bookshop or similar - I changed my answer to something more pleasing."
    isa "意识到他们不会雇用那些说想自己创业的人——哪怕只是开个小书店之类的——之后，我改了答案，听起来更讨喜。"

# episode10\branches\ep10_isabella_branch.rpy:342
translate schinese ep10_bsolo_label_e0b9c87e:

    # mc "Is that what you dreamt of? To start your own business?"
    mc "这真的是你梦想的工作吗？开自己的店？"

# episode10\branches\ep10_isabella_branch.rpy:344
translate schinese ep10_bsolo_label_69e275b0:

    # isa "I didn't want something big, just something that I could manage on my own or perhaps with the help of my husband."
    isa "我不想搞什么大事业，就想要一个能自己打理，或者和我丈夫一起经营的小生意。"

# episode10\branches\ep10_isabella_branch.rpy:345
translate schinese ep10_bsolo_label_27af23f6:

    # isa "I know bookshops are going extinct in this digital age, but there are ways you could adapt."
    isa "我知道书店在这个数字时代快要灭绝了，但你还是能找到办法适应的。"

# episode10\branches\ep10_isabella_branch.rpy:346
translate schinese ep10_bsolo_label_d1e0997e:

    # isa "And as an avid reader, I strongly advocate reading paperback books instead of tablets."
    isa "而且作为一个爱书之人，我强烈支持读纸质书，而不是在平板上阅读。"

# episode10\branches\ep10_isabella_branch.rpy:348
translate schinese ep10_bsolo_label_c28194c0:

    # isa "Books have a feeling that cannot be replaced by modern technology."
    isa "书籍有一种现代科技无法替代的感觉。"

# episode10\branches\ep10_isabella_branch.rpy:349
translate schinese ep10_bsolo_label_5020930e:

    # isa "Even though audiobooks have gained popularity, I assume there will be enough demand for books during my lifetime to make it work."
    isa "虽然有声书越来越流行，但我认为在我有生之年，纸质书的需求还是足够的，能让我这个生意活下去。"

# episode10\branches\ep10_isabella_branch.rpy:350
translate schinese ep10_bsolo_label_8d06546f:

    # isa "So, I think that kind of store would suit me well."
    isa "所以，我觉得这样的店应该挺适合我的。"

# episode10\branches\ep10_isabella_branch.rpy:352
translate schinese ep10_bsolo_label_46b54011:

    # mc "It sounds like you've got the complete picture of it."
    mc "听起来你对这个想法已经了如指掌了。"

# episode10\branches\ep10_isabella_branch.rpy:354
translate schinese ep10_bsolo_label_7aaec3c9:

    # isa "In my mind, it was a vivid dream."
    isa "在我脑子里，那是个鲜活的梦。"

# episode10\branches\ep10_isabella_branch.rpy:356
translate schinese ep10_bsolo_label_347f1aae:

    # mc "How come it never happened?"
    mc "怎么就从来没发生过呢？"

# episode10\branches\ep10_isabella_branch.rpy:358
translate schinese ep10_bsolo_label_3fba83ac:

    # isa "For many different reasons... I had little work experience, for a start. And I lacked the funds to get it going."
    isa "因为各种各样的原因……我几乎没有工作经验，首先就是这个。而且我也没有足够的资金来启动这个项目。"

# episode10\branches\ep10_isabella_branch.rpy:359
translate schinese ep10_bsolo_label_2ff1157f:

    # isa "But mostly... The idea of diving in headfirst scared me. There were days when I was close to doing it."
    isa "但最主要的是……一头扎进去的想法让我害怕。有几次我差点就那么做了。"

# episode10\branches\ep10_isabella_branch.rpy:360
translate schinese ep10_bsolo_label_811977b0:

    # isa "But as I researched what it would require of me, I felt overwhelmed and scared."
    isa "但当我研究起这件事需要我付出什么时，我感到一阵窒息和恐惧。"

# episode10\branches\ep10_isabella_branch.rpy:362
translate schinese ep10_bsolo_label_27d3ba81:

    # isa "Having a full-time job with a secure employer is not something most are willing to gamble with."
    isa "拥有一个稳定雇主的全职工作，可不是大多数人愿意拿去冒险的东西。"

# episode10\branches\ep10_isabella_branch.rpy:363
translate schinese ep10_bsolo_label_131c4eea:

    # isa "And other factors came into play too at that time..."
    isa "而且当时还有其他因素……"

# episode10\branches\ep10_isabella_branch.rpy:364
translate schinese ep10_bsolo_label_5bfbdbe0:

    # isa "And so, it never happened."
    isa "于是，这个梦想最终没有实现。"

# episode10\branches\ep10_isabella_branch.rpy:366
translate schinese ep10_bsolo_label_8ddb1ae1:

    # mc "Do you still dream of it?"
    mc "你还会梦到那件事吗？"

# episode10\branches\ep10_isabella_branch.rpy:368
translate schinese ep10_bsolo_label_501ae900:

    # isa "No... I let go of that dream quite some time ago."
    isa "没有……我早就放下了那个梦想。"

# episode10\branches\ep10_isabella_branch.rpy:369
translate schinese ep10_bsolo_label_bd9d0941:

    # isa "It's a mere memory of who I used to be."
    isa "这不过是曾经的我罢了。"

# episode10\branches\ep10_isabella_branch.rpy:370
translate schinese ep10_bsolo_label_93dfee8f:

    # isa "Life didn't turn out the way I expected it to."
    isa "生活并没有按照我预期的方向发展。"

# episode10\branches\ep10_isabella_branch.rpy:371
translate schinese ep10_bsolo_label_7dfcc901:

    # isa "But the important thing for me right now is that I'm still here, doing my best."
    isa "但对我现在来说，重要的是我还在这里，尽我最大的努力。"

# episode10\branches\ep10_isabella_branch.rpy:373
translate schinese ep10_bsolo_label_c39d68eb:

    # mc "I'm sure many like you didn't get to do what they dreamt of, or maybe their dreams changed with time."
    mc "我敢说很多人像你一样，没能实现自己梦想的东西，或者他们的梦想随着时间改变了。"

# episode10\branches\ep10_isabella_branch.rpy:374
translate schinese ep10_bsolo_label_0c750d0d:

    # mc "I'm not sure what I dream of, and thinking too much about the future scares me."
    mc "我不确定自己现在还梦想着什么，想太多未来反而让我害怕。"

# episode10\branches\ep10_isabella_branch.rpy:375
translate schinese ep10_bsolo_label_7c0ca2f7:

    # mc "Being in college is nice and all, but after these years...then what? Will I have even figured myself out by then?"
    mc "上大学挺好的，但这么多年过去后呢？到时候我甚至可能还没弄清楚自己是谁。"

# episode10\branches\ep10_isabella_branch.rpy:377
translate schinese ep10_bsolo_label_4b856393:

    # isa "I know that feeling all too well."
    isa "我太懂这种感觉了。"

# episode10\branches\ep10_isabella_branch.rpy:378
translate schinese ep10_bsolo_label_a7138f06:

    # isa "My best advice would be to enjoy every moment you feel happy because one day you will look back at those moments and they will keep you warm inside."
    isa "我最好的建议就是尽情享受你感到快乐的每一刻，因为有一天你回望这些时刻时，它们会一直在你心里暖着。"

# episode10\branches\ep10_isabella_branch.rpy:380
translate schinese ep10_bsolo_label_30c7cc18:

    # mc "That's some nice advice."
    mc "这建议挺中肯的。"

# episode10\branches\ep10_isabella_branch.rpy:382
translate schinese ep10_bsolo_label_669deaa3:

    # isa "Thanks for lunch."
    isa "谢谢午餐。"

# episode10\branches\ep10_isabella_branch.rpy:385
translate schinese ep10_bsolo_label_5294e4a6:

    # mc "It was my pleasure."
    mc "这是我的荣幸。"

# episode10\branches\ep10_isabella_branch.rpy:387
translate schinese ep10_bsolo_label_5c1973a1:

    # mc "Well, we had to eat, and it was pretty good."
    mc "我们总得吃饭，而且那顿还挺不错的。"

# episode10\branches\ep10_isabella_branch.rpy:388
translate schinese ep10_bsolo_label_de4bcc7f:

    # mc "By the way... When can I stay at your place again?"
    mc "顺便问一句...我什么时候能再住你那儿？"

# episode10\branches\ep10_isabella_branch.rpy:390
translate schinese ep10_bsolo_label_6f424194:

    # isa "My weekend is wide open. Unless you have another party to attend, you can stop by."
    isa "这个周末我空闲得很。除非你还有别的聚会要去，不然随时可以来。"

# episode10\branches\ep10_isabella_branch.rpy:392
translate schinese ep10_bsolo_label_d79c5018:

    # mc "I have plans on Friday, but Saturday works."
    mc "我周五有安排，但周六可以。"

# episode10\branches\ep10_isabella_branch.rpy:393
translate schinese ep10_bsolo_label_783fa17a:

    # mc "I don't think there will be another big party until Thanksgiving."
    mc "我觉得下次大聚会得等到感恩节了。"

# episode10\branches\ep10_isabella_branch.rpy:396
translate schinese ep10_bsolo_label_695a7f61:

    # isa "Saturday it is."
    isa "周六就周六吧。"

# episode10\branches\ep10_isabella_branch.rpy:414
translate schinese ep10_bella_solo_label_5a145a79:

    # mc "You have a lot of channels..."
    mc "你有很多频道啊..."

# episode10\branches\ep10_isabella_branch.rpy:415
translate schinese ep10_bella_solo_label_6adba418:

    # mc "I thought it would end at some point, but it keeps going."
    mc "我以为它会到此为止，但它一直没完。"

# episode10\branches\ep10_isabella_branch.rpy:417
translate schinese ep10_bella_solo_label_8bd42666:

    # isa "You don't have to browse through all of them."
    isa "你不用一个个都看。"

# episode10\branches\ep10_isabella_branch.rpy:419
translate schinese ep10_bella_solo_label_373e737f:

    # mc "What do you wanna watch?"
    mc "你想看什么？"

# episode10\branches\ep10_isabella_branch.rpy:421
translate schinese ep10_bella_solo_label_7057d64d:

    # isa "It doesn't matter to me. But I'd rather spend the night talking to you than watching a movie."
    isa "对我来说无所谓。不过我宁愿和你聊一整晚，也不愿看一部电影。"

# episode10\branches\ep10_isabella_branch.rpy:423
translate schinese ep10_bella_solo_label_b6a84317:

    # mc "Then it does matter what I choose."
    mc "那我选什么就很重要了。"

# episode10\branches\ep10_isabella_branch.rpy:425
translate schinese ep10_bella_solo_label_5abbafba:

    # isa "Again. You don't have to browse through all of them."
    isa "又来了。你不用浏览所有频道。"

# episode10\branches\ep10_isabella_branch.rpy:427
translate schinese ep10_bella_solo_label_26867191:

    # mc "There are so many crappy channels that I don't know what's good to watch."
    mc "这里头烂频道多得我都挑花眼了，根本不知道哪个值得看。"

# episode10\branches\ep10_isabella_branch.rpy:429
translate schinese ep10_bella_solo_label_6678c436:

    # mc "Whoa! What are these channels?"
    mc "哇！这些频道是啥？"

# episode10\branches\ep10_isabella_branch.rpy:431
translate schinese ep10_bella_solo_label_40b8de0c:

    # isa "These are obviously the adult ones."
    isa "这些明显是成人频道。"

# episode10\branches\ep10_isabella_branch.rpy:433
translate schinese ep10_bella_solo_label_9ca2e0cd:

    # mc "Why do you have these?"
    mc "你为什么会看这些？"

# episode10\branches\ep10_isabella_branch.rpy:435
translate schinese ep10_bella_solo_label_e3007623:

    # isa "I don't know. They must be included in the package."
    isa "我不知道。它们应该是在套餐里自带的。"

# episode10\branches\ep10_isabella_branch.rpy:437
translate schinese ep10_bella_solo_label_3fe7fe09:

