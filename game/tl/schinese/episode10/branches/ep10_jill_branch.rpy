translate schinese ep10_jill_fam_label_d35f62f4:

    # jim "Jill's recital. You're the one who assisted Jill, aren't you?"
    jim "Jill的演奏会。你就是协助Jill的那个人，对吧？"

# episode10\branches\ep10_jill_branch.rpy:754
translate schinese ep10_jill_fam_label_5ece15f0:

    # ge "Oh! Is that it?"
    ge "哦！原来是这样？"

# episode10\branches\ep10_jill_branch.rpy:756
translate schinese ep10_jill_fam_label_158aef93:

    # ge "Oh! Is that right?"
    ge "哦！原来是这样？"

# episode10\branches\ep10_jill_branch.rpy:758
translate schinese ep10_jill_fam_label_079a9f38:

    # ji "Yes. This is him."
    ji "是的，这就是他。"

# episode10\branches\ep10_jill_branch.rpy:760
translate schinese ep10_jill_fam_label_e7db1c52:

    # jim "Well, that's lovely."
    jim "嗯，这下可真不错。"

# episode10\branches\ep10_jill_branch.rpy:763
translate schinese ep10_jill_fam_label_cb9eb5bf:

    # jim "It's lovely having you over."
    jim "有你来真不错。"

# episode10\branches\ep10_jill_branch.rpy:764
translate schinese ep10_jill_fam_label_8aa970cb:

    # jim "Please make yourselves comfortable. Let me get your jacket and coat."
    jim "请各位随意坐。我这就去拿你们的外套和大衣。"

# episode10\branches\ep10_jill_branch.rpy:767
translate schinese ep10_jill_fam_label_300ff880:

    # mc "(There's something off about Amelia.)"
    mc "（Amelia有些不对劲。）"

# episode10\branches\ep10_jill_branch.rpy:768
translate schinese ep10_jill_fam_label_ea13ded4:

    # mc "(It's as if her expressions don't match her words. I can't figure out if she is excited or bored by this.)"
    mc "她的表情和说话不一致，我搞不懂她到底是兴奋还是无聊。"

# episode10\branches\ep10_jill_branch.rpy:769
translate schinese ep10_jill_fam_label_4012df02:

    # mc "(And Geoff... I can't be mistaken, he's drunk.)"
    mc "（还有Geoff……我敢肯定他喝醉了。）"

# episode10\branches\ep10_jill_branch.rpy:771
translate schinese ep10_jill_fam_label_ad394a9b:

    # ji "Um... Are you ok?"
    ji "你没事吧？"

# episode10\branches\ep10_jill_branch.rpy:773
translate schinese ep10_jill_fam_label_4c7586b3:

    # mc "What's up with your dad?"
    mc "你爸怎么了？"

# episode10\branches\ep10_jill_branch.rpy:775
translate schinese ep10_jill_fam_label_1f08308b:

    # ji "You noticed it too..."
    ji "你也察觉到了吧..."

# episode10\branches\ep10_jill_branch.rpy:777
translate schinese ep10_jill_fam_label_08d5eb33:

    # mc "I could smell it on his breath. He's been drinking."
    mc "我能闻到他身上的酒味。他喝醉了。"

# episode10\branches\ep10_jill_branch.rpy:779
translate schinese ep10_jill_fam_label_be633127:

    # ji "I'm so ashamed."
    ji "我真丢脸。"

# episode10\branches\ep10_jill_branch.rpy:780
translate schinese ep10_jill_fam_label_8a8cda33:

    # ji "He isn't always like this. I didn't think he'd be drinking today."
    ji "他不是一直都这样。我没想到他今天会喝酒。"

# episode10\branches\ep10_jill_branch.rpy:782
translate schinese ep10_jill_fam_label_eb5b4b97:

    # jim "Your sister's birthday isn't far off. Did you forget?"
    jim "你妹妹的生日也不远了，你忘了吗？"

# episode10\branches\ep10_jill_branch.rpy:784
translate schinese ep10_jill_fam_label_dab67798:

    # ji "Of course, I haven't."
    ji "当然没忘。"

# episode10\branches\ep10_jill_branch.rpy:786
translate schinese ep10_jill_fam_label_128fdd03:

    # jim "[name], please excuse us for a moment."
    jim "[name]请原谅我们一下。"

# episode10\branches\ep10_jill_branch.rpy:788
translate schinese ep10_jill_fam_label_476e62d8:

    # mc "(Oof... Uncomfortable...)"
    mc "（唔...有点不舒服...）"

# episode10\branches\ep10_jill_branch.rpy:790
translate schinese ep10_jill_fam_label_dcb525dd:

    # ge "[name]! Sit down. I got you something to drink."
    ge "[name]坐下。我给你带了点喝的。"

# episode10\branches\ep10_jill_branch.rpy:792
translate schinese ep10_jill_fam_label_d7d1a956:

    # mc "I'm fine, thanks."
    mc "我没事，谢谢。"

# episode10\branches\ep10_jill_branch.rpy:794
translate schinese ep10_jill_fam_label_299abbf3:

    # ge "Are you sure?"
    ge "你确定吗？"

# episode10\branches\ep10_jill_branch.rpy:798
translate schinese ep10_jill_fam_label_f6a6254c:

    # mc "Yeah, thanks."
    mc "谢谢。"

# episode10\branches\ep10_jill_branch.rpy:801
translate schinese ep10_jill_fam_label_df39a49e:

    # mc "I'm not 21."
    mc "我才19。"

# episode10\branches\ep10_jill_branch.rpy:803
translate schinese ep10_jill_fam_label_a9cf276b:

    # ge "Oh, sorry! I thought you were."
    ge "啊，抱歉！我刚才以为你是……"

# episode10\branches\ep10_jill_branch.rpy:805
translate schinese ep10_jill_fam_label_b8a69469:

    # ge "*{i}Deep breath{/i}*"
    ge "*{i}深呼吸{/i}*"

# episode10\branches\ep10_jill_branch.rpy:806
translate schinese ep10_jill_fam_label_31da5c59:

    # ge "Excuse me; I didn't catch your full name."
    ge "不好意思，我刚才没听清你的全名。"

# episode10\branches\ep10_jill_branch.rpy:808
translate schinese ep10_jill_fam_label_d7562933:

    # mc "Oh, it's [name] [lname]."
    mc "哦，原来是[name] [lname]。"

# episode10\branches\ep10_jill_branch.rpy:810
translate schinese ep10_jill_fam_label_034f42cd:

    # ge "Ah. Tell me, [lname]. Are you into horses?"
    ge "啊。告诉 我，[lname]你对马感兴趣吗？"

# episode10\branches\ep10_jill_branch.rpy:812
translate schinese ep10_jill_fam_label_973fdfef:

    # mc "Sorry, I'm not."
    mc "抱歉，我不是很。"

# episode10\branches\ep10_jill_branch.rpy:814
translate schinese ep10_jill_fam_label_c845ef93:

    # ge "You don't have to be sorry about that. That's actually good!"
    ge "你不用为这个道歉，这其实挺好的！"

# episode10\branches\ep10_jill_branch.rpy:815
translate schinese ep10_jill_fam_label_4d9fd57a:

    # ge "I could use the company around here of someone who doesn't like them, haha!"
    ge "我这儿正缺一个不喜欢马的人陪着，哈哈！"

# episode10\branches\ep10_jill_branch.rpy:817
translate schinese ep10_jill_fam_label_7d26ae51:

    # ge "See, Amelia loves horses. She spends a lot of her day with them."
    ge "你看，Amelia特别喜欢马，她成天都和它们待在一起。"

# episode10\branches\ep10_jill_branch.rpy:818
translate schinese ep10_jill_fam_label_1b9231ae:

    # ge "I never understood their charm. They smell and crave so much care and attention."
    ge "我从没弄懂它们的魅力。它们又臭又爱挑食，需要这么多照顾和关注。"

# episode10\branches\ep10_jill_branch.rpy:820
translate schinese ep10_jill_fam_label_5fc99a54:

    # mc "Did you ever ride one?"
    mc "你骑过马吗？"

# episode10\branches\ep10_jill_branch.rpy:822
translate schinese ep10_jill_fam_label_8c32a908:

    # ge "Yes, of course. I've ridden plenty, but I don't enjoy it."
    ge "当然，我骑过不少，但一点都不喜欢。"

# episode10\branches\ep10_jill_branch.rpy:823
translate schinese ep10_jill_fam_label_94cd4b87:

    # ge "It's mostly been for the girls."
    ge "主要都是为了家里的姑娘们。"

# episode10\branches\ep10_jill_branch.rpy:825
translate schinese ep10_jill_fam_label_8a95d9dc:

    # mc "The girls?"
    mc "那些女孩？"

# episode10\branches\ep10_jill_branch.rpy:827
translate schinese ep10_jill_fam_label_7f523905:

    # ge "Amelia, Jill and Lana."
    ge "Amelia、Jill和兰娜。"

# episode10\branches\ep10_jill_branch.rpy:829
translate schinese ep10_jill_fam_label_75fa7515:

    # mc "Ah! Those girls."
    mc "啊！那些女孩。"

# episode10\branches\ep10_jill_branch.rpy:831
translate schinese ep10_jill_fam_label_b8aebc21:

    # ge "..."
    ge "..."

# episode10\branches\ep10_jill_branch.rpy:833
translate schinese ep10_jill_fam_label_1fc9245e:

    # mc "If not horses, what are you into?"
    mc "如果你不是喜欢马，那你喜欢什么？"

# episode10\branches\ep10_jill_branch.rpy:835
translate schinese ep10_jill_fam_label_6e7bcf3f:

    # ge "Oh, you stole my question right in front of me. Haha!"
    ge "哦，你直接抢了我的问题，当着我的面！哈哈！"

# episode10\branches\ep10_jill_branch.rpy:837
translate schinese ep10_jill_fam_label_4e2f11f9:

    # ge "I'm into vehicles. Predominantly cars, motorbikes and boats. I'm a bit of a collector."
    ge "我喜欢车。主要是汽车、摩托车和船。我有点收藏癖。"

# episode10\branches\ep10_jill_branch.rpy:838
translate schinese ep10_jill_fam_label_f1576992:

    # ge "Do you own an automobile?"
    ge "你有汽车吗？"

# episode10\branches\ep10_jill_branch.rpy:840
translate schinese ep10_jill_fam_label_9231d9bd:

    # mc "No, I have a bike - a bicycle, that is - back home at Dad's place, but that's my only vehicle."
    mc "不，我有一辆自行车——就是那种普通的自行车——放在爸爸家，那是我唯一的交通工具。"

# episode10\branches\ep10_jill_branch.rpy:842
translate schinese ep10_jill_fam_label_f6a2f50e:

    # ge "You haven't had your first car yet? Oh, you're going to be in for a treat."
    ge "你还没开过第一辆车？哦，你可要准备好享受惊喜了。"

# episode10\branches\ep10_jill_branch.rpy:843
translate schinese ep10_jill_fam_label_74953779:

    # ge "Much like your first love, you never forget your first car."
    ge "就像你第一次恋爱一样，你永远都不会忘记你的第一辆车。"

# episode10\branches\ep10_jill_branch.rpy:845
translate schinese ep10_jill_fam_label_0bcd5bc6:

    # ge "The Maverick... Ah... The things we did together. Freedom, capital F."
    ge "那辆Maverick……啊……我们一起经历过的一切。那才是真正的自由。"

# episode10\branches\ep10_jill_branch.rpy:847
translate schinese ep10_jill_fam_label_495eadf6:

    # ge "Where are my manners? You haven't seen the place yet, have you?"
    ge "我这是怎么了？你还没见过这地方吧？"

# episode10\branches\ep10_jill_branch.rpy:848
translate schinese ep10_jill_fam_label_a411797b:

    # ge "Let me give you the grand tour."
    ge "让我带你好好逛逛。"

# episode10\branches\ep10_jill_branch.rpy:850
translate schinese ep10_jill_fam_label_0a136793:

    # mc "Oh... Sure!"
    mc "哦……当然了！"

# episode10\branches\ep10_jill_branch.rpy:852
translate schinese ep10_jill_fam_label_a9b31bb1:

    # mc "(Maybe I should have waited for Jill, but this seems harmless enough.)"
    mc "（也许我应该等Jill，但这样看起来也没什么大不了的。）"

# episode10\branches\ep10_jill_branch.rpy:854
translate schinese ep10_jill_fam_label_de44124e:

    # ge "This is Jill's bedroom. She doesn't stay here often these days, but it's still hers whenever she comes home to visit."
    ge "这是Jill的卧室。她现在很少住这儿，但每次回家探亲还是她的房间。"

# episode10\branches\ep10_jill_branch.rpy:856
translate schinese ep10_jill_fam_label_f840d191:

    # mc "That sounds like my dad. He insists on keeping my room as it was before I left for college."
    mc "这听起来跟我爸一模一样。他坚持要把我的房间保持我离开上大学前的样子。"

# episode10\branches\ep10_jill_branch.rpy:857
translate schinese ep10_jill_fam_label_54614304:

    # mc "It's only been a few months since I moved out, but I don't think he'll ever change it."
    mc "不过我搬出去才几个月，但我感觉他这辈子都不会改了。"

# episode10\branches\ep10_jill_branch.rpy:859
translate schinese ep10_jill_fam_label_f8c46b21:

    # ge "That's parents for you. He sounds like a good man."
    ge "这就是当爹妈的了。他听起来是个不错的家伙。"

# episode10\branches\ep10_jill_branch.rpy:861
translate schinese ep10_jill_fam_label_51c18294:

    # mc "Yeah, he's my role model."
    mc "对，他就是我的榜样。"

# episode10\branches\ep10_jill_branch.rpy:863
translate schinese ep10_jill_fam_label_e26b26a3:

    # ge "Down the hall is the master bedroom, but I'll spare you that room."
    ge "走廊尽头是主卧，不过我就不带你去那儿了。"

# episode10\branches\ep10_jill_branch.rpy:864
translate schinese ep10_jill_fam_label_5d3aaa6f:

    # ge "I wouldn't want you to be too uncomfortable, hehe."
    ge "我可不想让你太不自在，嘿嘿。"

# episode10\branches\ep10_jill_branch.rpy:865
translate schinese ep10_jill_fam_label_a85652d2:

    # ge "Let's continue upstairs."
    ge "我们继续往上走。"

# episode10\branches\ep10_jill_branch.rpy:867
translate schinese ep10_jill_fam_label_a4a9890e:

    # mc "What's that room?"
    mc "那间房是哪间？"

# episode10\branches\ep10_jill_branch.rpy:868
translate schinese ep10_jill_fam_label_52ed8f97:

    # ge "*{i}Grunts{/i}*"
    ge "*{i}咕哝声{/i}*"

# episode10\branches\ep10_jill_branch.rpy:870
translate schinese ep10_jill_fam_label_c56f06c2:

    # mc "(Huh? Oh! Maybe that was Lana's room... Fuck... Me and my stupid mouth.)"
    mc "（嗯？哦！可能是Lana的房间……操……我这张破嘴。）"

# episode10\branches\ep10_jill_branch.rpy:872
translate schinese ep10_jill_fam_label_e1e2ad4f:

    # ge "And up here is my favorite place. Nothing beats this view."
    ge "这里是我最喜欢的地方。没什么能比得上这景色。"

# episode10\branches\ep10_jill_branch.rpy:874
translate schinese ep10_jill_fam_label_ed98ffcb:

    # mc "Wow! What a view!"
    mc "哇！这景色真棒！"

# episode10\branches\ep10_jill_branch.rpy:876
translate schinese ep10_jill_fam_label_50c5c4b1:

    # ge "You can see the stables from here. Down there."
    ge "你可以从这里看到马厩。那边。"

# episode10\branches\ep10_jill_branch.rpy:878
translate schinese ep10_jill_fam_label_db2bd6ed:

    # ge "And on the other side is where the sun sets."
    ge "另一边是日落的地方。"

# episode10\branches\ep10_jill_branch.rpy:880
translate schinese ep10_jill_fam_label_cf324338:

    # mc "It's amazing. Thanks for showing me."
    mc "真他妈棒。谢谢你带我来看。"

# episode10\branches\ep10_jill_branch.rpy:884
translate schinese ep10_jill_fam_label_bb1572ed:

    # ge "I never followed up on that question from earlier, did I?"
    ge "我之前问你的那个问题，我还没接着问呢，对吧？"

# episode10\branches\ep10_jill_branch.rpy:885
translate schinese ep10_jill_fam_label_f082aeac:

    # ge "What are you into, [lname]?"
    ge "你平时有什么爱好，[lname]？"

# episode10\branches\ep10_jill_branch.rpy:887
translate schinese ep10_jill_fam_label_4f100ff3:

    # mc "I like martial arts. I've been practicing kickboxing since I was young."
    mc "我喜欢武术。我从小就开始练习踢拳。"

# episode10\branches\ep10_jill_branch.rpy:889
translate schinese ep10_jill_fam_label_ac4346f3:

    # ge "Kickboxing? That sounds violent."
    ge "拳击？听起来挺暴力的。"

# episode10\branches\ep10_jill_branch.rpy:891
translate schinese ep10_jill_fam_label_ca6cd335:

    # mc "It's mostly for self-defense. When I was a kid, I was bullied at school."
    mc "主要是为了自保。小时候在学校里被欺负过。"

# episode10\branches\ep10_jill_branch.rpy:892
translate schinese ep10_jill_fam_label_53cd4418:

    # mc "My dad taught me kickboxing to be able to defend myself."
    mc "我爸爸教我踢拳是为了能保护自己。"

# episode10\branches\ep10_jill_branch.rpy:894
translate schinese ep10_jill_fam_label_61bdcec6:

    # ge "Bullies. *{i}Sigh{/i}* They are horrible."
    ge "恶霸。{i}叹气{/i}他们很糟糕。"

# episode10\branches\ep10_jill_branch.rpy:895
translate schinese ep10_jill_fam_label_4ddfdc2a:

    # ge "I bet Jillybean can relate an awful lot to your history."
    ge "我想吉尔宝一定很能理解你的经历。"

# episode10\branches\ep10_jill_branch.rpy:897
translate schinese ep10_jill_fam_label_a95ecf9e:

    # mc "Yeah, I think she can. We do have a lot in common."
    mc "是啊，我觉得她会理解的。我们确实有很多共同点。"

# episode10\branches\ep10_jill_branch.rpy:899
translate schinese ep10_jill_fam_label_a015986f:

    # ge "You do? Enlighten me."
    ge "你也是？给我讲讲。"

# episode10\branches\ep10_jill_branch.rpy:901
translate schinese ep10_jill_fam_label_b7e3a74e:

    # mc "We're both into music. I've played the guitar since I was young."
    mc "我们俩都喜欢音乐，我从小就开始弹吉他了。"

# episode10\branches\ep10_jill_branch.rpy:903
translate schinese ep10_jill_fam_label_3c75c80e:

    # ge "That makes sense. I can see why music is mutual ground for you two."
    ge "这倒是合情合理。我明白为什么音乐能成为你们俩的共同话题。"

# episode10\branches\ep10_jill_branch.rpy:905
translate schinese ep10_jill_fam_label_a85ba2d3:

    # ji "There you are! We've been looking all over for you."
    ji "你终于出现了！我们到处找你呢。"

# episode10\branches\ep10_jill_branch.rpy:907
translate schinese ep10_jill_fam_label_dc41e000:

    # ge "I was giving [lname] the grand tour and getting to know him."
    ge "我正在给[lname]大巡游和了解他。"

# episode10\branches\ep10_jill_branch.rpy:909
translate schinese ep10_jill_fam_label_633d915b:

    # ji "Ok. Um, Dad. Mom needs you downstairs."
    ji "哦，爸，妈妈让你下去。"

# episode10\branches\ep10_jill_branch.rpy:911
translate schinese ep10_jill_fam_label_5e76a07d:

    # ge "As always. I'll be right back."
    ge "一如既往。我马上回来。"

# episode10\branches\ep10_jill_branch.rpy:913
translate schinese ep10_jill_fam_label_7796c8bf:

    # ji "I'm sorry about that."
    ji "我刚才那句话是说对不起。"

# episode10\branches\ep10_jill_branch.rpy:915
translate schinese ep10_jill_fam_label_82da3f67:

    # mc "There's nothing to be sorry about."
    mc "没关系的。"

# episode10\branches\ep10_jill_branch.rpy:916
translate schinese ep10_jill_fam_label_8de7fbb3:

    # mc "Yeah, he's a bit drunk, but he's not being rude to me. It's the opposite; he's being very friendly."
    mc "是的，他有点喝醉了，但没对我没礼貌。相反，他非常友好。"

# episode10\branches\ep10_jill_branch.rpy:918
translate schinese ep10_jill_fam_label_a04ef7a8:

    # ji "That's how he gets when he drinks - overly friendly."
    ji "这就是他喝醉后的样子——过分热情。"

# episode10\branches\ep10_jill_branch.rpy:919
translate schinese ep10_jill_fam_label_76194437:

    # ji "It's not the real him."
    ji "这不是他真正的样子。"

# episode10\branches\ep10_jill_branch.rpy:920
translate schinese ep10_jill_fam_label_2836a558:

    # ji "I talked to Mom about it just now. He's been depressed lately. More so than usual..."
    ji "我刚刚跟妈妈聊了这件事。他最近情绪很低落，比平时更严重……"

# episode10\branches\ep10_jill_branch.rpy:922
translate schinese ep10_jill_fam_label_280d7757:

    # ji "I wish he didn't have to resort to alcohol...but it doesn't matter what we say or do."
    ji "真希望他不用靠酒精来逃避……但不管我们说什么做什么，都改变不了什么。"

# episode10\branches\ep10_jill_branch.rpy:923
translate schinese ep10_jill_fam_label_6fcd6bac:

    # ji "We've had interventions in the past, but..."
    ji "我们以前也试过干预，但……"

# episode10\branches\ep10_jill_branch.rpy:924
translate schinese ep10_jill_fam_label_21418013:

    # ji "This is what I meant when I said he's changed."
    ji "这就是我之前说他变了的意思。"

# episode10\branches\ep10_jill_branch.rpy:926
translate schinese ep10_jill_fam_label_532b0731:

    # ji "He's carrying this deep sorrow for what happened with Lana, and instead of facing it...he never did."
    ji "Lana的事给他留下了很深的伤痛。他本该直面它，却始终没有真正做到。"

# episode10\branches\ep10_jill_branch.rpy:927
translate schinese ep10_jill_fam_label_aacc0e5e:

    # ji "And Mom...she... *{i}Sniff{/i}*"
    ji "还有妈妈……她……*{i}抽鼻子{/i}*"

# episode10\branches\ep10_jill_branch.rpy:928
translate schinese ep10_jill_fam_label_25d19d79:

    # ji "Mom's trying her best, but she's almost given up on him."
    ji "妈妈在尽力，但她几乎放弃了他。"

# episode10\branches\ep10_jill_branch.rpy:930
translate schinese ep10_jill_fam_label_e05ab314:

    # mc "Are you ok?"
    mc "你没事吧？"

# episode10\branches\ep10_jill_branch.rpy:932
translate schinese ep10_jill_fam_label_fe34fa65:

    # ji "This is not how I wanted today to go. I wanted to present you to my parents and have a happy day with you."
    ji "这可不是我想要的一天。我原本想带你介绍给我的父母，和你一起过个开心的日子。"

# episode10\branches\ep10_jill_branch.rpy:933
translate schinese ep10_jill_fam_label_47c4240a:

    # ji "Instead, they pretty much force me to tell you all of this. Because you deserve an explanation and I don't want you to regret coming here with me."
    ji "相反，他们几乎逼我全都告诉你。因为你值得一个解释，我不想你跟我一起来这里后后悔。"

# episode10\branches\ep10_jill_branch.rpy:935
translate schinese ep10_jill_fam_label_ecbee836:

    # mc "Jill..."
    mc "Jill……"

# episode10\branches\ep10_jill_branch.rpy:936
translate schinese ep10_jill_fam_label_6593adf7:

    # mc "Whose family is perfect? Trust me, no one's perfect."
    mc "谁家的家族是完美的？信我，没人是完美的。"

# episode10\branches\ep10_jill_branch.rpy:937
translate schinese ep10_jill_fam_label_e16ab201:

    # mc "Don't worry about this. It doesn't ruin this day. It's still a big day for both of us."
    mc "别担心，这不会毁了今天。对我们俩来说，今天还是个大日子。"

# episode10\branches\ep10_jill_branch.rpy:939
translate schinese ep10_jill_fam_label_e9870ec7:

    # mc "It's the next step in our relationship and I'm happy to take it."
    mc "这是我们关系的下一步，我很乐意去经历。"

# episode10\branches\ep10_jill_branch.rpy:940
translate schinese ep10_jill_fam_label_fac0a654:

    # mc "I got to see how you lived, and your dad showed me your room."
    mc "我看到了你平时是怎么生活的，你爸还带我去了你的房间。"

# episode10\branches\ep10_jill_branch.rpy:942
translate schinese ep10_jill_fam_label_d6a04eb6:

    # ji "Haha, he did?"
    ji "哈哈，他真这么做了？"

# episode10\branches\ep10_jill_branch.rpy:944
translate schinese ep10_jill_fam_label_b75a1d7a:

    # mc "Yeah, he did. By the way, the room upstairs from it...was that your sister's?"
    mc "嗯，他确实这么做了。对了，楼上那间房……那是你姐姐的吗？"

# episode10\branches\ep10_jill_branch.rpy:946
translate schinese ep10_jill_fam_label_53816ef7:

    # ji "Yes. Did he show you it?"
    ji "是的。他让你看过吗？"

# episode10\branches\ep10_jill_branch.rpy:948
translate schinese ep10_jill_fam_label_446d728e:

    # mc "No, we walked past it."
    mc "不，我们只是从旁边走过的。"

# episode10\branches\ep10_jill_branch.rpy:950
translate schinese ep10_jill_fam_label_d94dcb6e:

    # ji "Do you want to see it?"
    ji "你想看看吗？"

# episode10\branches\ep10_jill_branch.rpy:953
translate schinese ep10_jill_fam_label_26735370:

    # mc "Would that be ok? Considering..."
    mc "这可以吗？考虑到..."

# episode10\branches\ep10_jill_branch.rpy:955
translate schinese ep10_jill_fam_label_9dbb4113:

    # ji "I want you to see it."
    ji "我想让你看看。"

# episode10\branches\ep10_jill_branch.rpy:962
translate schinese ep10_jill_fam_label_a7543e87:

    # ji "This is my sister. Her spirit still lives here."
    ji "这是我的姐姐，她的灵魂还在这里。"

# episode10\branches\ep10_jill_branch.rpy:964
translate schinese ep10_jill_fam_label_2c9a23fd:

    # mc "Wow..."
    mc "哇..."

# episode10\branches\ep10_jill_branch.rpy:965
translate schinese ep10_jill_fam_label_ff92d3b2:

    # mc "This room is totally different from all the other rooms."
    mc "这间屋子和别的房间完全不一样。"

# episode10\branches\ep10_jill_branch.rpy:967
translate schinese ep10_jill_fam_label_b229ee28:

    # ji "Yes. It's a sanctuary for Lana now."
    ji "是啊，这里现在就像是纪念Lana的圣地。"

# episode10\branches\ep10_jill_branch.rpy:968
translate schinese ep10_jill_fam_label_6e74a4c2:

    # ji "When they clean her room, they even put the books and records back as they were to keep it the same as it used to be."
    ji "当他们打扫她的房间时，甚至把书和唱片都放回原位，只为保持它和以前一模一样。"

# episode10\branches\ep10_jill_branch.rpy:970
translate schinese ep10_jill_fam_label_4e71fcc2:

    # ji "How do you feel standing in here?"
    ji "你站在这里感觉怎么样？"

# episode10\branches\ep10_jill_branch.rpy:972
translate schinese ep10_jill_fam_label_3410b918:

    # mc "How do I explain it? It makes me feel weird and sad."
    mc "我该怎么说呢？这让我感觉怪怪的，还有点难过。"

# episode10\branches\ep10_jill_branch.rpy:973
translate schinese ep10_jill_fam_label_b0a53a08:

    # mc "It feels like I'm in someone's room that I know."
    mc "这感觉像是我进到了一个我认识的人的房间里。"

# episode10\branches\ep10_jill_branch.rpy:975
translate schinese ep10_jill_fam_label_b44607a4:

    # mc "Look! I have this album! It's from my favorite band. I wear their T-shirts all the time."
    mc "看！我有这张专辑！是我最喜欢的乐队出的，我经常穿他们家的T恤。"

# episode10\branches\ep10_jill_branch.rpy:977
translate schinese ep10_jill_fam_label_49361c96:

    # ji "You have things in common..."
    ji "你们有共同的东西……"

# episode10\branches\ep10_jill_branch.rpy:979
translate schinese ep10_jill_fam_label_01240124:

    # mc "I see the posters, her belongings, and style... It feels like I know her, in a sense."
    mc "我看到她的海报、她的物品，还有她的风格……某种程度上，我感觉我认识她。"

# episode10\branches\ep10_jill_branch.rpy:980
translate schinese ep10_jill_fam_label_210c5c6c:

    # mc "What I mean is that it's hard to imagine that she's not with us anymore."
    mc "我的意思是，很难想象她已经不在我们身边了。"

# episode10\branches\ep10_jill_branch.rpy:982
translate schinese ep10_jill_fam_label_69b0a633:

    # ji "Right?"
    ji "对吧？"

# episode10\branches\ep10_jill_branch.rpy:983
translate schinese ep10_jill_fam_label_b119e877:

    # ji "That's exactly how I feel, too."
    ji "那我也是这么觉得。"

# episode10\branches\ep10_jill_branch.rpy:984
translate schinese ep10_jill_fam_label_ebe8d649:

    # ji "One look at her things and I get transported back in time."
    ji "一看她的东西，我就仿佛被拉回了过去。"

# episode10\branches\ep10_jill_branch.rpy:986
translate schinese ep10_jill_fam_label_86f0f4b8:

    # ji "I can see her sitting on that bean bag chair, listening to music."
    ji "我能看到她坐在那个豆袋椅上，听着音乐。"

# episode10\branches\ep10_jill_branch.rpy:988
translate schinese ep10_jill_fam_label_270399c6:

    # ji "I used to jump in her bed because Mom didn't let me do it in mine."
    ji "我以前总跳进她的床上，我妈不让我在我自己的床上这么做。"

# episode10\branches\ep10_jill_branch.rpy:989
translate schinese ep10_jill_fam_label_f49c77f9:

    # ji "But Lana never minded it."
    ji "但Lana从不在意这些。"

# episode10\branches\ep10_jill_branch.rpy:991
translate schinese ep10_jill_fam_label_c6f1863c:

    # mc "Whoa!"
    mc "哇哦！"

# episode10\branches\ep10_jill_branch.rpy:992
translate schinese ep10_jill_fam_label_2769e732:

    # ji "What is it?"
    ji "这是什么？"

# episode10\branches\ep10_jill_branch.rpy:993
translate schinese ep10_jill_fam_label_a34dc976:

    # mc "Is that a custom Strutter!? Did she play?"
    mc "那可是定制款Strutter！她真的会弹吗？"

# episode10\branches\ep10_jill_branch.rpy:995
translate schinese ep10_jill_fam_label_07481ba2:

    # ji "Mom and Dad encouraged her to play an instrument and she chose that guitar."
    ji "我妈和我爸鼓励她学乐器，她选了那把吉他。"

# episode10\branches\ep10_jill_branch.rpy:996
translate schinese ep10_jill_fam_label_81c69b08:

    # ji "But I think she played it twice before she quit and never touched it again."
    ji "但我以为她是在退出之前只弹过两次，之后就再也没碰过它了。"

# episode10\branches\ep10_jill_branch.rpy:998
translate schinese ep10_jill_fam_label_1b2b06fa:

    # ji "The strings snapped quite some time ago and no one has touched it since then."
    ji "琴弦早就断了，从那以后没人碰过它。"

# episode10\branches\ep10_jill_branch.rpy:999
translate schinese ep10_jill_fam_label_eefded2a:

    # mc "That's such a shame. It looks so cool and those guitars aren't cheap. I could never afford one like that."
    mc "真可惜啊。那吉他看起来超酷的，这种吉他可不便宜。我可买不起这种。"

# episode10\branches\ep10_jill_branch.rpy:1001
translate schinese ep10_jill_fam_label_2004c40b:

    # mc "Is this her?"
    mc "这是她的？"

# episode10\branches\ep10_jill_branch.rpy:1002
translate schinese ep10_jill_fam_label_c8233838:

    # ji "Yes."
    ji "是的。"

# episode10\branches\ep10_jill_branch.rpy:1003
translate schinese ep10_jill_fam_label_0924f94a:

    # mc "You look so much alike."
    mc "你们俩看起来简直一模一样。"

# episode10\branches\ep10_jill_branch.rpy:1005
translate schinese ep10_jill_fam_label_1ffaa671:

    # ji "Really!? Do you mean that?"
    ji "真的吗？你是说真的？"

# episode10\branches\ep10_jill_branch.rpy:1007
translate schinese ep10_jill_fam_label_bd628832:

    # mc "Yeah, if you were the same age, you could be twins."
    mc "是啊，要是年龄相同，你们俩看起来简直像双胞胎。"

# episode10\branches\ep10_jill_branch.rpy:1008
translate schinese ep10_jill_fam_label_962ec1e4:

    # mc "If you put on her clothes, I could barely tell the difference."
    mc "如果你穿上她的衣服，我几乎分不清你俩的区别。"

# episode10\branches\ep10_jill_branch.rpy:1009
translate schinese ep10_jill_fam_label_65b054e4:

    # ji "I could never wear clothes like hers."
    ji "我根本穿不了她那种衣服。"

# episode10\branches\ep10_jill_branch.rpy:1011
translate schinese ep10_jill_fam_label_484aeff1:

    # mc "Did you ever try?"
    mc "你试过吗？"

# episode10\branches\ep10_jill_branch.rpy:1013
translate schinese ep10_jill_fam_label_86c96e05:

    # ji "No. Haha, I mean... It's not me."
    ji "不。哈哈，我是说……那不是我。"

# episode10\branches\ep10_jill_branch.rpy:1014
translate schinese ep10_jill_fam_label_5016515b:

    # ji "When I was young, Mom and Dad bought me clothes, and that's the style I've kept as I grew older."
    ji "小时候，爸妈给我买了衣服，我就是一直保持着那种风格。"

# episode10\branches\ep10_jill_branch.rpy:1015
translate schinese ep10_jill_fam_label_6229f9dc:

    # ji "It would feel weird to wear something like that, I think."
    ji "我觉得穿那种东西会有点怪。"

# episode10\branches\ep10_jill_branch.rpy:1017
translate schinese ep10_jill_fam_label_5ad2f2e8:

    # ji "But one of her belongings I kept for myself was her hat. It has a cute pin of a cat on it."
    ji "但有一样她的物品，我留着自己用了，是她的帽子，上面别着一个可爱的猫咪发夹。"

# episode10\branches\ep10_jill_branch.rpy:1018
translate schinese ep10_jill_fam_label_5dd303bf:

    # ji "She used to wear it a lot, and in my last memory of her, she wore it..."
    ji "她以前经常戴，而我最后一次见到她时，她也戴着……"

# episode10\branches\ep10_jill_branch.rpy:1019
translate schinese ep10_jill_fam_label_92e0cc7f:

    # ji "Sometimes, when I think about her, I put it on and feel much stronger. It's my little secret."
    ji "有时候，我想到她的时候，就会戴上它，感觉整个人都变得有力量了。这是我的小秘密。"

# episode10\branches\ep10_jill_branch.rpy:1021
translate schinese ep10_jill_fam_label_0c80bbd9:

    # mc "And now it's mine too."
    mc "现在它也是我的了。"

# episode10\branches\ep10_jill_branch.rpy:1023
translate schinese ep10_jill_fam_label_5176e234:

    # jim "*{i}Cough{/i}* Lunch is served."
    jim "*{i}咳嗽{/i}午餐上桌了。"

# episode10\branches\ep10_jill_branch.rpy:1025
translate schinese ep10_jill_fam_label_4f1023fa:

    # ji "Oh! I was showing [name] Lana's room and telling him more about her."
    ji "哦！我在带[name]参观Lana的房间，跟他多讲一些她的事。"

# episode10\branches\ep10_jill_branch.rpy:1029
translate schinese ep10_jill_fam_label_bae9bfc9:

    # ji "Sorry, [name]."
    ji "抱歉，[name]。"

# episode10\branches\ep10_jill_branch.rpy:1031
translate schinese ep10_jill_fam_label_bc18190f:

    # mc "You don't have to keep saying that. Let's have lunch."
    mc "你不用一直说这些。我们吃饭吧。"

# episode10\branches\ep10_jill_branch.rpy:1036
translate schinese ep10_jill_fam_label_549c4dd8:

    # jim "[name]. Tell me about yourself. Are you in college, too?"
    jim "[name]跟我说说你自己。你也上大学吗？"

# episode10\branches\ep10_jill_branch.rpy:1038
translate schinese ep10_jill_fam_label_30c8e194:

    # mc "Yes. Yes, I am. I'm a freshman studying engineering."
    mc "是的。是的，我在读大一，学的是工程专业。"

# episode10\branches\ep10_jill_branch.rpy:1040
translate schinese ep10_jill_fam_label_7c4d217a:

    # ge "Engineering? In what field?"
    ge "工程学？哪个领域？"

# episode10\branches\ep10_jill_branch.rpy:1042
translate schinese ep10_jill_fam_label_202ab5bd:

    # mc "The scientific kind."
    mc "科学类的。"

# episode10\branches\ep10_jill_branch.rpy:1044
translate schinese ep10_jill_fam_label_a8320af6:

    # ge "The world needs scientists!"
    ge "世界需要科学家！"

# episode10\branches\ep10_jill_branch.rpy:1046
translate schinese ep10_jill_fam_label_59a57280:

    # mc "It's always been fascinating to me."
    mc "这一直让我着迷。"

# episode10\branches\ep10_jill_branch.rpy:1048
translate schinese ep10_jill_fam_label_6cf165fd:

    # jim "Jill told me you're from here or nearby, at least. Who are your family?"
    jim "你跟我说你是本地人或者附近来的，至少。你家里人都是谁？"

# episode10\branches\ep10_jill_branch.rpy:1050
translate schinese ep10_jill_fam_label_a1fc5066:

    # mc "It's just me and my dad. We're a small family."
    mc "就我和我爸两个人，我们家挺小的。"

# episode10\branches\ep10_jill_branch.rpy:1052
translate schinese ep10_jill_fam_label_4c0c5593:

    # jim "What's your dad's name?"
    jim "你爸爸叫什么？"

# episode10\branches\ep10_jill_branch.rpy:1054
translate schinese ep10_jill_fam_label_ea4642aa:

    # mc "It's Neil [lname]. He works as a carpenter."
    mc "Neil·[lname]，他是一名木匠。"

# episode10\branches\ep10_jill_branch.rpy:1056
translate schinese ep10_jill_fam_label_bb25a6c8:

    # ge "Oh! Where at? Maybe we've hired them."
    ge "哦！在哪儿？也许我们请过他们。"

# episode10\branches\ep10_jill_branch.rpy:1058
translate schinese ep10_jill_fam_label_101f9858:

    # mc "Kovak's Carpentry."
    mc "科瓦克木工坊。"

# episode10\branches\ep10_jill_branch.rpy:1060
translate schinese ep10_jill_fam_label_ba375815:

    # ge "Oh, they are reputable! I've heard of them, but I've never had the pleasure of working with them."
    ge "哦，他们很有名！我听说过他们，但还没机会和他们合作过。"

# episode10\branches\ep10_jill_branch.rpy:1061
translate schinese ep10_jill_fam_label_4dab593c:

    # ge "A practical dad with an academic son. He must feel proud!"
    ge "一个务实的老爸，有个搞学术的儿子，他肯定挺自豪的。"

# episode10\branches\ep10_jill_branch.rpy:1063
translate schinese ep10_jill_fam_label_4cacf628:

    # mc "Yeah, he's very proud that I got accepted to college."
    mc "他挺自豪我考上大学了。"

# episode10\branches\ep10_jill_branch.rpy:1065
translate schinese ep10_jill_fam_label_3fd03f5f:

    # jim "And your mother?"
    jim "你妈呢？"

# episode10\branches\ep10_jill_branch.rpy:1067
translate schinese ep10_jill_fam_label_fb9f23cd:

    # ji "Mom..."
    ji "妈的..."

# episode10\branches\ep10_jill_branch.rpy:1069
translate schinese ep10_jill_fam_label_b04b4189:

    # mc "It's fine. She died at childbirth."
    mc "没关系。她生产时去世了。"

# episode10\branches\ep10_jill_branch.rpy:1071
translate schinese ep10_jill_fam_label_48a5078b:

    # jim "I'm sorry to hear that."
    jim "真遗憾听到那个消息。"

# episode10\branches\ep10_jill_branch.rpy:1073
translate schinese ep10_jill_fam_label_4a8953e3:

    # jim "So... Any siblings?"
    jim "所以……有兄弟姐妹吗？"

# episode10\branches\ep10_jill_branch.rpy:1075
translate schinese ep10_jill_fam_label_6e876e15:

    # mc "No, I'm an only child. Dad didn't find someone else after Mom, so..."
    mc "不，我是个独生女。妈妈去世后，爸爸也没再找别人，所以……"

# episode10\branches\ep10_jill_branch.rpy:1077
translate schinese ep10_jill_fam_label_7f56261c:

    # ji "Perhaps we could talk about something else?"
    ji "也许我们聊聊别的？"

# episode10\branches\ep10_jill_branch.rpy:1080
translate schinese ep10_jill_fam_label_d1906003:

    # mc "I love your home. How long have you lived here?"
    mc "我挺喜欢你家的。在这住多久了？"

# episode10\branches\ep10_jill_branch.rpy:1082
translate schinese ep10_jill_fam_label_3d49a022:

    # jim "Oh, my. How long has it been? I want to say...19 years?"
    jim "哦，天哪。这都多久了？我想说……19年了？"

# episode10\branches\ep10_jill_branch.rpy:1084
translate schinese ep10_jill_fam_label_7e7bb60d:

    # jim "Geoff? Help me out here."
    jim "Geoff？帮我解释一下。"

# episode10\branches\ep10_jill_branch.rpy:1086
translate schinese ep10_jill_fam_label_83c1d02a:

    # ge "Yes, yes. 19. That sounds about right."
    ge "嗯，嗯。19年。听起来挺对的。"

# episode10\branches\ep10_jill_branch.rpy:1088
translate schinese ep10_jill_fam_label_7009846b:

    # ge "I got the tip from my friend - eh, back then, business associate - Maynard."
    ge "我从我一个朋友——呃，当时算是生意伙伴——马纳德那儿打听到的。"

# episode10\branches\ep10_jill_branch.rpy:1090
