# episode10\branches\ep10_jill_branch.rpy:373
translate schinese ep10_jill_solo_label_95d06166:

    # mc "And I didn't think coming here tonight would do that. Being with you is the best thing I know."
    mc "而且我也没想到今晚来这里会让我有这种感觉。和你在一起是我知道的最好的事。"

# episode10\branches\ep10_jill_branch.rpy:375
translate schinese ep10_jill_solo_label_d1ae6fdf:

    # mc "And today, I found so many ways to ruin it...yet you're still lying here next to me. And I ask myself why."
