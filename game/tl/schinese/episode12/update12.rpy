# episode12\update12.rpy:3054
translate schinese ep12_jocks_label_ea6f7635:

    # dw "I get it, but I thought we agreed on waiting until after the competition to fight them."
    dw "我明白，但我以为我们已经说好等比赛结束后再对付他们。"

# episode12\update12.rpy:3056
translate schinese ep12_jocks_label_7974e4ee:

    # an "I saw him in the corridors and I snapped. I don't have it in me, Dawe."
    an "我看到他在走廊里，我直接就控制不住了。我真没那个胆子，Dawe。"

# episode12\update12.rpy:3057
translate schinese ep12_jocks_label_d53538ab:

