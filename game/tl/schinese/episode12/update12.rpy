    be "谁知道呢？时间久了，也许一切又能回到从前。"

# episode12\update12.rpy:3018
translate schinese ep12_sally_label_cf626102:

    # sy "Things will never be the same between us again. Magnar made sure of it."
    sy "事情再也不会和从前一样了。Magnar已经确保了这一点。"

# episode12\update12.rpy:3020
translate schinese ep12_sally_label_8264c5ff:

    # be "Maybe not between you and Magnar, but between the rest of us."
    be "也许你和Magnar之间不会，但对我们其他人来说，也许还能回到从前。"

# episode12\update12.rpy:3021
translate schinese ep12_sally_label_ad24874a:

    # be "Magnar finally found Excalibus."
    be "Magnar终于找到了Excalibus。"

# episode12\update12.rpy:3023
translate schinese ep12_sally_label_9232cdae:

