# episode12\update12.rpy:3031
translate schinese ep12_sally_label_63a9e153:

    # sy "What do you mean?"
    sy "你是什么意思？"

# episode12\update12.rpy:3033
translate schinese ep12_sally_label_3690421d:

    # be "The vendetta. All the frats are going to pay for it. And we are starting with the DIKs."
    be "这仇必须报。所有兄弟会都要为这事付出代价。我们先从DIKs开始。"

# episode12\update12.rpy:3034
translate schinese ep12_sally_label_af59fbfd:

