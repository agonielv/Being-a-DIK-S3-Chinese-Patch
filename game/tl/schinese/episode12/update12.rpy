    al "你是在骗自己，伙计。"

# episode12\update12.rpy:3070
translate schinese ep12_jocks_label_4be90b57:

    # dw "My point is, if we fight them out in the open, we're gambling with the competition, guys..."
    dw "我的意思是，如果我们公开跟他们干架，就是在跟对手赌博，伙计们……"

# episode12\update12.rpy:3071
translate schinese ep12_jocks_label_2630e6d8:

