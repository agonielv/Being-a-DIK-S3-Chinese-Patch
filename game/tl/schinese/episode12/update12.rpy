    # mc "(*{i}Phew{/i}* Here we go... One test, and it's 30%% of my grade...)"
    mc "（*{i}呼气{/i}*要开始了……一场考试，占总成绩的30%%……）"

# episode12\update12.rpy:8970
translate schinese after_math_result_ep12_label_bebcabbe:

    # mc "(One final test, then we're home free.)"
    mc "（最后一场考试，搞定就解放了。）"

# episode12\update12.rpy:9000
translate schinese after_eng_test_ep12_label_83d920b1:

    # mc "(Ugh! Focusing like this made me feel like I'm drunk. But that's it... I'm done!)"
    mc "（啧！这样集中注意力让我感觉像喝醉了一样。但就这样了……我写完了！）"

# episode12\update12.rpy:9001
translate schinese after_eng_test_ep12_label_45ca4f1c:

    # mc "(Sweet winter break, here I come.)"
    mc "（终于可以好好休息一下了，寒假来啦。）"

# episode12\update12.rpy:9005
translate schinese after_eng_test_ep12_label_ecf5755a:

    # isa "Thank you."
    isa "谢谢。"

# episode12\update12.rpy:9007
translate schinese after_eng_test_ep12_label_a099f82a:

    # mc "Have a nice Christmas, Bella."
    mc "圣诞快乐，贝拉。"

# episode12\update12.rpy:9009
translate schinese after_eng_test_ep12_label_b8e23a55:

    # isa "You too."
    isa "你也是。"

# episode12\update12.rpy:9014
translate schinese after_eng_test_ep12_label_3038a9f5:

    # isa "Are you off to spend your holiday tonight? Or can I drop by later?"
    isa "今晚你打算过节去吗？还是我之后再来找你？"

# episode12\update12.rpy:9016
translate schinese after_eng_test_ep12_label_8e5ad634:

    # mc "Sure, I'm not going home for a few more days."
    mc "当然，我还要过几天才回家。"

# episode12\update12.rpy:9018
translate schinese after_eng_test_ep12_label_e0558549:

    # isa "See you soon then."
    isa "回头见。"

# episode12\update12.rpy:9021
translate schinese after_eng_test_ep12_label_fc6b731d:

    # isa "Went well?"
    isa "玩得开心吗？"

# episode12\update12.rpy:9023
translate schinese after_eng_test_ep12_label_8761b870:

    # mc "I hope I did enough for the 70%% of my grade that wasn't on this test."
    mc "我希望我做得够多得70分%%我成绩里没在这次考试上的部分。"

# episode12\update12.rpy:9026
translate schinese after_eng_test_ep12_label_6ee9a5b5:

    # isa "I'm sure you did."
    isa "你肯定做得不错。"

# episode12\update12.rpy:9027
translate schinese after_eng_test_ep12_label_08d78549:

    # isa "Are you off to spend your holiday tonight?"
    isa "今晚有假期安排吗？"

# episode12\update12.rpy:9029
translate schinese after_eng_test_ep12_label_f39357bc:

    # mc "No, not for a few days."
    mc "不是，还要几天。"

# episode12\update12.rpy:9031
translate schinese after_eng_test_ep12_label_d0df52e9:

    # isa "Let's talk later tonight, then. If you're free..."
    isa "我们晚点再聊，如果你有空的话……"

# episode12\update12.rpy:9033
translate schinese after_eng_test_ep12_label_606e2d02:

    # mc "Sure."
    mc "当然。"

# episode12\update12.rpy:9035
translate schinese after_eng_test_ep12_label_1e4636fa:

    # isa "I'll drop by."
    isa "我待会儿过去。"

# episode12\update12.rpy:9038
translate schinese after_eng_test_ep12_label_6ee9a5b5_1:

    # isa "I'm sure you did."
    isa "你肯定去玩了。"

# episode12\update12.rpy:9039
translate schinese after_eng_test_ep12_label_75bbcb00:

    # isa "Off to enjoy your holiday, [name]. I wish you a nice one."
    isa "去享受你的假期吧，[name]祝你玩得愉快。"

# episode12\update12.rpy:9041
translate schinese after_eng_test_ep12_label_0dfdcd09:

    # mc "You too."
    mc "你也是。"

# episode12\update12.rpy:9066
translate schinese ep12_nic_date_label_7ff0bb24:

    # nic "How were the finals?"
    nic "考试怎么样？"

# episode12\update12.rpy:9068
translate schinese ep12_nic_date_label_d2bbf58b:

    # mc "I had two exams today... They could have spread it out over the week, but they didn't."
    mc "我今天考了两门……他们本可以分开放在一周里，但没这么做。"

# episode12\update12.rpy:9069
translate schinese ep12_nic_date_label_866c1a6e:

    # mc "As a result, my head feels...full and empty at the same time."
    mc "结果，我脑袋感觉……又满又空。"

# episode12\update12.rpy:9071
translate schinese ep12_nic_date_label_53912577:

    # mc "I don't want to see another math exercise until January."
    mc "我不想再看到数学题了，直到一月。"

# episode12\update12.rpy:9073
translate schinese ep12_nic_date_label_8eb8989a:

    # nic "Aw, you poor thing."
    nic "唉，你这可怜的小家伙。"

# episode12\update12.rpy:9074
translate schinese ep12_nic_date_label_196fe603:

    # nic "It's good that you came here. We'll have a relaxed night together."
    nic "你来这儿挺好的，我们今晚可以好好放松一下。"

# episode12\update12.rpy:9076
translate schinese ep12_nic_date_label_51b684ce:

    # mc "Thanks! I need it."
    mc "谢谢！我需要这个。"

# episode12\update12.rpy:9077
translate schinese ep12_nic_date_label_875a0bda:

    # mc "And how about you? How have you been?"
    mc "那你怎么了？最近怎么样？"

# episode12\update12.rpy:9079
translate schinese ep12_nic_date_label_40834e2e:

    # nic "There's not much excitement in my life at the moment, but there is plenty of stress to go around."
    nic "现在我的生活没什么刺激，但压力可是一点不缺。"

# episode12\update12.rpy:9080
translate schinese ep12_nic_date_label_e27fd5ea:

    # nic "That's holidays for you."
    nic "这就是假期的滋味。"

# episode12\update12.rpy:9082
translate schinese ep12_nic_date_label_21a9e3e4:

    # mc "Oh, yeah. You're having your kid over Christmas, right?"
    mc "哦，对了，你圣诞假期是带孩子回来吗？"

# episode12\update12.rpy:9084
translate schinese ep12_nic_date_label_03719804:

    # nic "Yes. I've been re-shopping for Christmas gifts this week."
    nic "对，这周我一直在重新买圣诞礼物。"

# episode12\update12.rpy:9086
translate schinese ep12_nic_date_label_721d4483:

    # mc "What do you mean by that?"
    mc "你这话是什么意思？"

# episode12\update12.rpy:9088
translate schinese ep12_nic_date_label_7e2c8788:

    # nic "Well, I already bought him what he wanted, but apparently Luke got him the same toy, so one of us had to replace the gift."
    nic "嗯，我本来已经给他买了他想要的东西，但 看来 卢克 也给他买了同样的玩具，所以得有人把礼物换了。"

# episode12\update12.rpy:9089
translate schinese ep12_nic_date_label_723e48d5:

    # nic "And, like always, I caved."
    nic "而且，像往常一样，我妥协了。"

# episode12\update12.rpy:9091
translate schinese ep12_nic_date_label_1182e138:

    # mc "It sounds like you're too nice."
    mc "听起来你太好说话了吧。"

# episode12\update12.rpy:9093
translate schinese ep12_nic_date_label_c71ebe47:

    # nic "Don't I know it... Holidays are rough, [name]."
    nic "可不是吗……假期很难熬，[name]。"

# episode12\update12.rpy:9095
translate schinese ep12_nic_date_label_a07e77c4:

    # mc "Is it hard to get along with Luke?"
    mc "和卢克处得来吗？"

# episode12\update12.rpy:9097
translate schinese ep12_nic_date_label_81e009f2:

    # nic "With both him and his family."
    nic "和他还有他的家人在一起。"

# episode12\update12.rpy:9098
translate schinese ep12_nic_date_label_403c5fc6:

    # nic "When Marvin was younger, we tried to have joint celebrations for his sake."
    nic "当马文还小的时候，我们为了他好，试着一起过节。"

# episode12\update12.rpy:9099
translate schinese ep12_nic_date_label_b900d5e6:

    # nic "We thought it would mean a lot to Marvin if he got to see his mom and dad get along together, but it made me feel like the third wheel."
    nic "我们认为如果马文能看见他爸妈好好相处，对他来说意义重大，但结果却让我觉得自己像个多余的人。"

# episode12\update12.rpy:9101
translate schinese ep12_nic_date_label_b2d90cf5:

    # nic "His relatives didn't want to talk to me, and when they did, they loved giving me a hard time."
    nic "他的亲戚们根本不想跟我说话，一开口就爱拿我寻开心。"

# episode12\update12.rpy:9102
translate schinese ep12_nic_date_label_67e255a1:

    # nic "Mostly, I suffered through dinner in silence."
    nic "我基本上只能一言不发地熬过那顿晚餐。"

# episode12\update12.rpy:9103
translate schinese ep12_nic_date_label_2b5d3b53:

    # nic "After bringing up how I felt with Luke, we decided to have separate celebrations."
    nic "在和卢克聊完我之前的感觉后，我们决定分开庆祝。"

# episode12\update12.rpy:9105
translate schinese ep12_nic_date_label_38f2851f:

    # mc "That sucks... But is it working better now or...?"
    mc "那太糟了……不过现在情况好点了吗，还是……？"

# episode12\update12.rpy:9107
translate schinese ep12_nic_date_label_066c97a4:

    # nic "Yes, and no."
    nic "是的，也不完全是。"

# episode12\update12.rpy:9108
translate schinese ep12_nic_date_label_3f4915d5:

    # nic "I was supposed to have Marvin for New Year's Eve this year, but Luke's parents invited Marvin to their party."
    nic "我本来打算和马文一起过新年，但卢克的父母邀请马文去他们家聚会了。"

# episode12\update12.rpy:9109
translate schinese ep12_nic_date_label_16c82ead:

    # nic "Marvin got all excited and practically begged me to let him celebrate with them..."
    nic "马文一下子激动起来，几乎是央求我让他跟他们一起庆祝……"

# episode12\update12.rpy:9111
translate schinese ep12_nic_date_label_0e032d84:

    # nic "So, I'm free for New Year's Eve..."
    nic "所以，我这 跨年夜 可以自由安排了……"

# episode12\update12.rpy:9113
translate schinese ep12_nic_date_label_13abb12c:

    # mc "You caved again?"
    mc "你又投降了？"

# episode12\update12.rpy:9115
translate schinese ep12_nic_date_label_41d90fcb:

    # nic "They knew exactly what they were doing when they asked Marvin directly, rather than me or Luke."
    nic "他们直接问马文，而不是问我或者卢克，这说明他们早就有主意了。"

# episode12\update12.rpy:9116
translate schinese ep12_nic_date_label_cb4d5d20:

    # nic "If I had said no, it would have put me in a bad light, and Marvin would have blamed me."
    nic "如果我当时拒绝了，就会显得我很不讲道理，而马文也会怪罪我。"

# episode12\update12.rpy:9118
translate schinese ep12_nic_date_label_c22b8d9b:

    # nic "Maybe it was wrong of me to fall for their trick, but I felt it was the best way to go..."
    nic "也许我上当了，但我觉得这是最好的办法……"

# episode12\update12.rpy:9120
translate schinese ep12_nic_date_label_569fe262:

    # nic "I can't say that I would throw a better New Year's celebration for Marvin."
    nic "我可不敢说我会为马文办得比这更好。"

# episode12\update12.rpy:9128
translate schinese ep12_nic_date_label_9c6f92aa:

    # mc "If you're free, you're welcome to celebrate New Year's Eve with us."
    mc "如果你有空，欢迎和我们一起庆祝新年夜。"

# episode12\update12.rpy:9130
translate schinese ep12_nic_date_label_acf40611:

    # nic "Would you like that?"
    nic "你想要吗？"

# episode12\update12.rpy:9132
translate schinese ep12_nic_date_label_2150f560:

    # mc "Of course. We planned on inviting you, girls."
    mc "当然。我们本来就是打算邀请你们俩的。"

# episode12\update12.rpy:9134
translate schinese ep12_nic_date_label_2003c7f0:

    # nic "Actually, Tommy already invited us. But I'm happy you want us there too."
    nic "其实Tommy已经邀请过我们了。不过你想要我们来，我也挺高兴的。"

# episode12\update12.rpy:9135
translate schinese ep12_nic_date_label_59687fbc:

    # nic "Here. Have some."
    nic "来，来点。"

# episode12\update12.rpy:9137
translate schinese ep12_nic_date_label_091be793:

    # nic "Fair warning, it's strong."
    nic "提醒你，这酒挺烈的。"

# episode12\update12.rpy:9139
translate schinese ep12_nic_date_label_84008545:

    # mc "*{i}Coughs{/i}*"
    mc "*{i}咳嗽{/i}*"

# episode12\update12.rpy:9140
translate schinese ep12_nic_date_label_c8297d97:

    # nic "Told you."
    nic "早说了。"

# episode12\update12.rpy:9142
translate schinese ep12_nic_date_label_80162b06:

    # mc "My lungs sting..."
    mc "我的肺好疼..."

# episode12\update12.rpy:9144
translate schinese ep12_nic_date_label_22f0ad06:

    # nic "You'll get better at it. Have some more."
    nic "你会越来越适应的。再来点。"

# episode12\update12.rpy:9146
translate schinese ep12_nic_date_label_02d04670:

    # mc "Are you trying to get me fucked up?"
    mc "你是不是想让我醉成这样？"

# episode12\update12.rpy:9148
translate schinese ep12_nic_date_label_283fac66:

    # nic "I figured you'd need it too."
    nic "我想你肯定也需要。"

# episode12\update12.rpy:9152
translate schinese ep12_nic_date_label_2ba5ae29:

    # mc "I'm sorry things are rough for you with Marvin and all..."
    mc "抱歉你和马文那边搞得这么难。"

# episode12\update12.rpy:9153
translate schinese ep12_nic_date_label_a188e604:

    # mc "Don't let them walk right over you."
    mc "别让他们轻易踩过你。"

# episode12\update12.rpy:9155
translate schinese ep12_nic_date_label_6103be43:

    # nic "I choose my battles. It's better that way."
    nic "我挑着该打的仗。这样更好。"

# episode12\update12.rpy:9157
translate schinese ep12_nic_date_label_3086b95e:

    # nic "Enough about me... What are you doing for your holidays?"
    nic "够了，说说你假期打算干嘛？"

# episode12\update12.rpy:9159
translate schinese ep12_nic_date_label_a8d98a2b:

    # mc "A calm and quiet Christmas with Dad. That's about it."
    mc "和爸爸一起度过一个平静安静的圣诞节。差不多就这些。"

# episode12\update12.rpy:9160
translate schinese ep12_nic_date_label_7a831ccc:

    # mc "We eat and give each other gifts."
    mc "我们吃点东西，互相送点礼物。"

# episode12\update12.rpy:9162
translate schinese ep12_nic_date_label_bf53dc0f:

    # mc "I think I'll stay with him for a couple of days before coming back here."
    mc "我想先在他那儿待几天，然后再回来这里。"

# episode12\update12.rpy:9163
translate schinese ep12_nic_date_label_91920439:

    # mc "Even though it's winter break, I feel like I want to spend it at the DIKs."
    mc "虽然现在是寒假，但我感觉还是想在DIKs过。"

# episode12\update12.rpy:9165
translate schinese ep12_nic_date_label_f668f51b:

    # nic "Doing what? Aren't your brothers at home for the break too?"
    nic "做啥？你兄弟们不也放假回家了吗？"

# episode12\update12.rpy:9168
translate schinese ep12_nic_date_label_05eb201d:

    # mc "I bet they are. But I want to work out more and prepare for a competition."
    mc "我打赌他们肯定在。但我现在想多锻炼一下，为比赛做准备。"

# episode12\update12.rpy:9170
translate schinese ep12_nic_date_label_181144fa:

    # nic "What competition?"
    nic "什么比赛？"

# episode12\update12.rpy:9172
translate schinese ep12_nic_date_label_db2ce7c0:

    # mc "A fighting one. I train with some guys at the gym, and they invited me to join a competition on the 29th."
    mc "一个打斗的比赛。我在健身房跟一些家伙训练，他们邀请我参加29号的比赛。"

# episode12\update12.rpy:9173
translate schinese ep12_nic_date_label_c9caf970:

    # mc "I'll be fighting someone. It's my first fight like that ever."
    mc "我要跟一个人打。这是我第一次这么打。"

# episode12\update12.rpy:9175
translate schinese ep12_nic_date_label_78e6499c:

    # nic "Can I watch you fight?"
    nic "我能看看你打架吗？"

# episode12\update12.rpy:9177
translate schinese ep12_nic_date_label_17bd4a2c:

    # mc "Yeah, if you want. Are you free that day?"
    mc "嗯，如果你想的话。那天你有空吗？"

# episode12\update12.rpy:9179
translate schinese ep12_nic_date_label_91525c8c:

    # nic "I should be, but I'll double-check."
    nic "我应该有空，不过我得再确认一下。"

# episode12\update12.rpy:9181
translate schinese ep12_nic_date_label_59021db6:

    # mc "I would love to have you there."
    mc "我真希望你能来。"

# episode12\update12.rpy:9182
translate schinese ep12_nic_date_label_3190369f:

    # mc "Damn... Now I hope I don't lose."
    mc "他妈的...现在我只希望别输。"

# episode12\update12.rpy:9184
translate schinese ep12_nic_date_label_d42ba055:

    # nic "You won't. I'll cheer you on as much as I can."
    nic "你不会的。我会尽我所能为你加油。"

# episode12\update12.rpy:9186
translate schinese ep12_nic_date_label_faa03e1a:

    # mc "Haha."
    mc "哈哈。"

# episode12\update12.rpy:9188
translate schinese ep12_nic_date_label_e7573926:

    # mc "I bet they are. But I want to work out more, and I need to practice for a performance."
    mc "我打赌他们肯定在那儿。但我得继续锻炼，还得为一场演出练习。"

# episode12\update12.rpy:9190
translate schinese ep12_nic_date_label_63996303:

    # nic "What performance?"
    nic "什么表演？"

# episode12\update12.rpy:9192
translate schinese ep12_nic_date_label_012e95a3:

    # mc "I'm playing guitar at the faculty's Christmas party on the 29th."
    mc "我在29号 教职工 的圣诞派对上弹吉他。"

# episode12\update12.rpy:9194
translate schinese ep12_nic_date_label_7d7d43a3:

    # nic "A Christmas party after Christmas?"
    nic "圣诞节后办圣诞派对？"

# episode12\update12.rpy:9196
translate schinese ep12_nic_date_label_a9752652:

    # mc "The faculty is off for winter break, too. According to my Professor, it's one of the highlights of the year for them."
    mc "校方也放假了，据我教授说，这可是他们一年中最期待的活动之一。"

# episode12\update12.rpy:9197
translate schinese ep12_nic_date_label_ec7253f9:

    # mc "He asked me to play guitar for them, and I need to put together a performance."
    mc "他让我为他们演奏吉他，我得准备一个表演。"

# episode12\update12.rpy:9199
translate schinese ep12_nic_date_label_0dafde3d:

    # nic "Then it's good you'll have some time for it after Christmas. I wish I could hear you play."
    nic "那圣诞后你有时间准备就很好。我真希望也能听听你弹琴。"

# episode12\update12.rpy:9201
translate schinese ep12_nic_date_label_19deb11e:

    # mc "I'll play for you sometime if you want."
    mc "如果你想听，我什么时候都可以给你演奏。"

# episode12\update12.rpy:9203
translate schinese ep12_nic_date_label_6b012f53:

    # nic "I'd love it."
    nic "我正想听你弹吉他呢。"

# episode12\update12.rpy:9205
translate schinese ep12_nic_date_label_5f831b51:

    # mc "I bet they are. But I want to work out more and relax."
    mc "我猜他们也是。但我现在想多锻炼一下，放松一下。"

# episode12\update12.rpy:9207
translate schinese ep12_nic_date_label_61b490d5:

    # nic "I get it. Alone time is nice. You need to recuperate after the finals."
    nic "我懂。一个人待着也挺好。你得在期末考后好好放松一下。"

# episode12\update12.rpy:9209
translate schinese ep12_nic_date_label_656e94ed:

    # mc "Yeah... Before I know it, next semester is here, and it's back to studying."
    mc "嗯……说起来，转眼就到了下学期，又得开始学习了。"

# episode12\update12.rpy:9222
translate schinese ep12_nic_lewd_label_c1dff962:

    # mc "Oh..."
    mc "哦……"

# episode12\update12.rpy:9224
translate schinese ep12_nic_lewd_label_84eee32a:

    # nic "Yeah... You can feel it too, can't you?"
    nic "嗯... 你也能感觉到吧？"

# episode12\update12.rpy:9228
translate schinese ep12_nic_lewd_label_692aedf3:

    # nic "Haha... I'll stop talking. Enjoy the feeling together with me."
    nic "哈哈...我就不多说了。一起享受这感觉吧。"

# episode12\update12.rpy:9234
translate schinese ep12_nic_lewd_label_b92ffd86:

    # mc "How strong was that blunt?"
    mc "这记重拳有多猛？"

# episode12\update12.rpy:9236
