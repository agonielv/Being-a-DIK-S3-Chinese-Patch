    mc "你这话是什么意思？"

# episode12\update12.rpy:2903
translate schinese ep12_sally_label_43227dc4:

    # sy "Are you an overachiever like me, or do you settle for a passing grade?"
    sy "你是像我这样爱拼的人，还是只求及格就满足？"

# episode12\update12.rpy:2915
translate schinese ep12_sally_label_72349988:

