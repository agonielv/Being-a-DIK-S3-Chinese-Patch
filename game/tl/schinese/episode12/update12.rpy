    al "哈！我知道你也是对那帮DIKs们生气，我他妈早就料到啦！"

# episode12\update12.rpy:3096
translate schinese ep12_jocks_label_bf7c94bc:

    # al "What was in your letter?"
    al "你信里写了啥？"

# episode12\update12.rpy:3098
translate schinese ep12_jocks_label_dd164555:

