translate schinese ep12_zoey_label_bf50a08f:

    # mc "She thinks you don't see me as a friend anymore, and that makes her uncomfortable."
    mc "她觉得你不再把我当朋友，这让她很不舒服。"

# episode12\update12.rpy:10930
translate schinese ep12_zoey_label_eb0af7bd:

    # mc "Truth be told, my girlfriends had some opinions on that."
    mc "说实话，我女朋友们对这事有些看法。"

# episode12\update12.rpy:10931
translate schinese ep12_zoey_label_66178d56:

    # mc "They understood our situation, but I could sense that they didn't like the idea of me being close to you."
    mc "他们理解我们的处境，但我能感觉到他们不太喜欢我跟你走得太近。"

# episode12\update12.rpy:10933
translate schinese ep12_zoey_label_652ed680_1:

    # mc "Co-exist on campus when you come to B&R, sure. But friends... I... I don't know."
    mc "在你来B&R的时候，我们可以在校园里共存，这没问题。但朋友……我……我真不知道。"

# episode12\update12.rpy:10935
translate schinese ep12_zoey_label_5e30c3f4:

    # zo "So, we can't hang out anymore?"
    zo "所以，我们不能再一起出去了吗？"

# episode12\update12.rpy:10937
translate schinese ep12_zoey_label_eb19af2d:

    # mc "I'm not sure."
    mc "我不确定。"

# episode12\update12.rpy:10939
translate schinese ep12_zoey_label_22e39219:

    # zo "Then why are you even here? I don't get it."
    zo "那你怎么还在这儿？我真搞不懂。"

# episode12\update12.rpy:10941
translate schinese ep12_zoey_label_dc4f30b4:

    # mc "*{i}Sigh{/i}* I was worried about you."
    mc "*{i}叹气{/i}*我担心你。"

# episode12\update12.rpy:10942
translate schinese ep12_zoey_label_a57cbb25:

    # mc "Do you think it's possible to stay friends? Is that something you'd want?"
    mc "你觉得我们还能当朋友吗？你希望这样吗？"

# episode12\update12.rpy:10944
translate schinese ep12_zoey_label_debe4cf1:

    # zo "How would I know when you don't?"
    zo "我怎么知道你什么时候不想要呢？"

# episode12\update12.rpy:10946
translate schinese ep12_zoey_label_75db0a0f:

    # zo "I thought we got along great ever since I came back from San Diego."
    zo "我以为从我从圣地亚哥回来之后，我们一直相处得挺好的。"

# episode12\update12.rpy:10948
translate schinese ep12_zoey_label_7ecfa766:

    # zo "I thought we got along great lately."
    zo "我以为我们最近相处得挺好的。"

# episode12\update12.rpy:10951
translate schinese ep12_zoey_label_ab25e53c:

    # mc "We did."
    mc "我们确实这样过。"

# episode12\update12.rpy:10953
translate schinese ep12_zoey_label_b267ed72:

    # mc "We did. Um... Somewhat, at least."
    mc "我们确实这样过。嗯……至少某种程度上是。"

# episode12\update12.rpy:10954
translate schinese ep12_zoey_label_0372604a:

    # zo "..."
    zo "..."

# episode12\update12.rpy:10956
translate schinese ep12_zoey_label_9f4e01af:

    # zo "So, neither of us knows if we want to stay friends after this."
    zo "所以我们俩都不知道，这之后要不要继续当朋友。"

# episode12\update12.rpy:10957
translate schinese ep12_zoey_label_6044890c:

    # zo "How do we find out for sure?"
    zo "我们怎么才能确定呢？"

# episode12\update12.rpy:10959
translate schinese ep12_zoey_label_1238c333:

    # mc "We just have to decide..."
    mc "我们只需要决定……"

# episode12\update12.rpy:10960
translate schinese ep12_zoey_label_31f6e33f:

    # mc "You're coming to B&R next semester. Ignoring this won't make it go away or make us feel better."
    mc "你下学期要来B&R。无视这个事实不会让它消失，也不会让我们感觉好受一点。"

# episode12\update12.rpy:10962
translate schinese ep12_zoey_label_df2a2e28:

    # zo "If I even get in."
    zo "如果我还能进得去。"

# episode12\update12.rpy:10964
translate schinese ep12_zoey_label_bea6e776_1:

    # zmom "Zoey? [name]? There's cocoa down here if you want it."
    zmom "Zoey？[name]这里有助手咖啡。"

# episode12\update12.rpy:10966
translate schinese ep12_zoey_label_51315aa0:

    # mc "Maybe I should get going."
    mc "也许我该走了。"

# episode12\update12.rpy:10968
translate schinese ep12_zoey_label_306ac081:

    # zo "Yeah. Next time, use the phone if this is how it's going to be."
    zo "那下次要是这样，就用电话联系吧。"

# episode12\update12.rpy:10979
translate schinese ep12_nerds_label_8fbe49d9:

    # mg "You do one wrong thing, and it's game over like that!?"
    mg "你只要做一件错事，游戏就直接结束了？！"

# episode12\update12.rpy:10980
translate schinese ep12_nerds_label_261dcd69:

    # mg "Aargh! Fucking shit game!"
    mg "哎呀！这他妈的破游戏！"

# episode12\update12.rpy:10983
translate schinese ep12_nerds_label_aaeb967c:

    # be "It's just a game."
    be "不过是个游戏。"

# episode12\update12.rpy:10985
translate schinese ep12_nerds_label_99f26596:

    # mg "Well, I hate it!"
    mg "反正我讨厌它！"

# episode12\update12.rpy:10990
translate schinese ep12_nerds_label_545c491a:

    # rn "Why the rage? Didn't get the toys you wished for Christmas?"
    rn "为啥这么火大？圣诞没拿到你想要的玩具？"

# episode12\update12.rpy:10994
translate schinese ep12_nerds_label_dacc4592:

    # mg "Do you know what I didn't get for Christmas?"
    mg "你知道圣诞节我没收到什么礼物吗？"

# episode12\update12.rpy:10995
translate schinese ep12_nerds_label_32be1650:

    # mg "Retribution."
    mg "报复。"

# episode12\update12.rpy:10997
translate schinese ep12_nerds_label_73957097:

    # rn "*{i}Sigh{/i}* It's coming. But it will take longer than we thought."
    rn "*{i}叹气{/i}*它要来了。但比我们想的要花更长时间。"

# episode12\update12.rpy:10999
translate schinese ep12_nerds_label_671249f9:

    # mg "It's not coming fast enough. Give them another semester, and they'll grow even bigger!"
    mg "它来得太慢了。再给他们一个学期，他们只会变得更大！"

# episode12\update12.rpy:11000
translate schinese ep12_nerds_label_ae2d793c:

    # mg "We have to hit them while they're small and insignificant."
    mg "我们必须趁他们还小、还无足轻重的时候动手。"

# episode12\update12.rpy:11002
translate schinese ep12_nerds_label_b8f51fe4:

    # be "So, the letters we sent out achieved nothing?"
    be "所以，我们寄出去的那些信根本没用？"

# episode12\update12.rpy:11004
translate schinese ep12_nerds_label_b5330573:

    # rn "They had an effect, alright. Anthony beat up Derek because of it."
    rn "他们确实有作用，Anthony就是因为这个打了Derek。"

# episode12\update12.rpy:11006
translate schinese ep12_nerds_label_5eff8225:

    # be "Oh, good. Derek had it coming."
    be "哦，不错。Derek活该。"

# episode12\update12.rpy:11007
translate schinese ep12_nerds_label_c721eaf2:

    # be "The guy would fart when I was in the dorm with him. Unapologetic rancid farts!"
    be "我和那家伙住宿舍时，他会当着我的面放屁，还毫无歉意，臭得要命！"

# episode12\update12.rpy:11009
translate schinese ep12_nerds_label_be71b429:

    # rn "Hahaha!"
    rn "哈哈哈！"

# episode12\update12.rpy:11011
translate schinese ep12_nerds_label_21415bf6:

    # be "It was NOT funny! His poo particles went into my nose."
    be "一点也不好笑！他的粪便颗粒都钻进我鼻子里了。"

# episode12\update12.rpy:11013
translate schinese ep12_nerds_label_2bc48c6a:

    # mg "A mere beating isn't enough."
    mg "打一顿可不够。"

# episode12\update12.rpy:11015
translate schinese ep12_nerds_label_71a5d073:

    # rn "He did it in front of everyone! Security even got involved. There will be disciplinary actions, I'm sure."
    rn "他当着所有人面前干的！保安都介入了。肯定会有纪律处分。"

# episode12\update12.rpy:11017
translate schinese ep12_nerds_label_0404d1a9:

    # mg "For Anthony, maybe. But what about the rest of them!? Why aren't they raging mad right now? We gave them all the ammo!"
    mg "对于Anthony，也许可以。但其他那些人呢？为什么他们现在一点都不愤怒？我们可是给了他们所有证据！"

# episode12\update12.rpy:11018
translate schinese ep12_nerds_label_f7839dd8:

    # mg "The Alpha Nu Omegas aren't doing anything! And I thought they would be the ones to seal the deal."
    mg "阿尔法·努·欧米伽一点动静也没有！我还以为他们会来一锤定音。"

# episode12\update12.rpy:11020
translate schinese ep12_nerds_label_20050cf9:

    # rn "I told you the letters were too vague. The jocks need things to be pointed out to them, and the preps might need extra motivation."
    rn "我跟你说过，那些信太模糊了。那些橄榄球队员需要有人直接指出来，而那些预备生可能还需要点额外的刺激。"

# episode12\update12.rpy:11022
translate schinese ep12_nerds_label_91bfc1f5:

    # mg "What are you suggesting?"
    mg "你有什么主意？"

# episode12\update12.rpy:11024
translate schinese ep12_nerds_label_eb986a65:

    # rn "Let's do plan B already. Let's bring them all together."
    rn "那咱们就直接执行计划B吧。把他们都叫来一起。"

# episode12\update12.rpy:11026
translate schinese ep12_nerds_label_555d3e84:

    # be "The jocks and the preps in the same room as us?"
    be "把橄榄球队和那些有钱人放在我们同一个房间里？"

# episode12\update12.rpy:11028
translate schinese ep12_nerds_label_3ea61a09:

    # rn "Yeah. Let's try the honest approach to speed things along."
    rn "嗯，咱们就用正经点的方式，加快点进度吧。"

# episode12\update12.rpy:11029
translate schinese ep12_nerds_label_4953a212:

    # rn "Let's call the VPs and Ps to a meeting and make the case for a joint complaint to the counselors. That ought to get rid of the DIKs in no time."
    rn "我们叫上VP和P们开个会，向辅导员们提出联合投诉。这样应该能很快解决DIKs的问题。"

# episode12\update12.rpy:11031
translate schinese ep12_nerds_label_4f1e7147:

    # mg "We have operated in the shadows for so long. Sticking out our necks like that now... Is it too soon?"
    mg "我们已经藏在暗处这么久了。现在突然把脖子伸出来……是不是太早了？"

# episode12\update12.rpy:11033
translate schinese ep12_nerds_label_0f846d62:

    # rn "If it works, then why worry about it?"
    rn "既然管用，还有什么好担心的？"

# episode12\update12.rpy:11035
translate schinese ep12_nerds_label_c225f7a4:

    # be "If we got their attention with the letters, it's an easy in."
    be "如果我们用信件引起他们的注意，那就很容易入手了。"

# episode12\update12.rpy:11037
translate schinese ep12_nerds_label_27cd1df9:

    # rn "Yeah, we can say we got letters too or something. They don't have to know we were behind it all."
    rn "那我们也可以说我们也有信，或者类似的东西。他们没必要知道我们一直在背后搞这些。"

# episode12\update12.rpy:11039
translate schinese ep12_nerds_label_e0c2a0e8:

    # mg "The Trojan Horse. It's not a bad idea."
    mg "特洛伊木马。这主意不坏。"

# episode12\update12.rpy:11042
translate schinese ep12_nerds_label_18ea390b:

    # rn "Alright. It's my turn; pass the controller."
    rn "好，轮到我了；传控制器。"

# episode12\update12.rpy:11056
translate schinese ep12_jsolo_label_95025483:

    # js "The finals were hard, but I think we both managed."
    js "期末考挺难的，不过我想我们俩都应付过来了。"

# episode12\update12.rpy:11058
translate schinese ep12_jsolo_label_c0ba2259:

    # mc "Honestly, I'm not that sure about it. I'm second-guessing my answers now that I think about them."
    mc "说实话，我现在也不太确定了。现在想想，我开始怀疑自己刚才的答案了。"

# episode12\update12.rpy:11059
translate schinese ep12_jsolo_label_a3d143bd:

    # mc "We'll have to wait until after Christmas break to know for sure."
    mc "我们得等到寒假结束后才能确定结果。"

# episode12\update12.rpy:11062
translate schinese ep12_jsolo_label_8312de5b:

    # js "The finals were hard, but I think I managed."
    js "期末考挺难的，但我觉得自己还是应付过来了。"

# episode12\update12.rpy:11067
translate schinese ep12_jsolo_label_9fcbe9b9:

    # ir "If you're having issues this early on in college, you should consider private tutoring."
    ir "如果你在大学刚开始就遇到这种问题，最好考虑请个私人辅导。"

# episode12\update12.rpy:11068
translate schinese ep12_jsolo_label_a9219dfc:

    # ir "It will only get harder from here on in, I hope you realize."
    ir "从现在开始只会越来越难，我希望你能明白。"

# episode12\update12.rpy:11073
translate schinese ep12_jsolo_label_51277a8a:

    # js "I'm not worried. It has gotten easier over the course of the semester."
    js "我没担心。这门课这学期变得容易多了。"

# episode12\update12.rpy:11074
translate schinese ep12_jsolo_label_da0bc274:

    # js "It's just that math got harder faster than I thought it would."
    js "数学变得比我想的更快更难了。"

# episode12\update12.rpy:11076
translate schinese ep12_jsolo_label_1e3fb8b1:

    # cli "Isn't economics all about numbers? How will you manage if you're struggling with math?"
    cli "经济学不都是数字吗？你连数学都搞不定，怎么应付得了？"

# episode12\update12.rpy:11082
translate schinese ep12_jsolo_label_1df5e1d9:

    # mc "Didn't you go to school when you were young? I bet you struggled with something too."
    mc "你小时候上学的时候，难道就没遇到过难懂的东西吗？我打赌你肯定也经历过。"

# episode12\update12.rpy:11084
translate schinese ep12_jsolo_label_b92c6c67:

    # cli "Sorry?"
    cli "抱歉？"

# episode12\update12.rpy:11086
translate schinese ep12_jsolo_label_9548ef9a:

    # mc "It's not uncommon for some subjects to be hard, especially in college."
    mc "有些科目本来就不容易，尤其是在大学里。"

# episode12\update12.rpy:11087
translate schinese ep12_jsolo_label_833a41e5:

    # mc "And it's college math, too. Most of us won't even have a daily use for it beyond college."
    mc "而且还是大学数学，我们大多数人连毕业之后都不会用上。"

# episode12\update12.rpy:11093
translate schinese ep12_jsolo_label_e4f6997f:

    # js "Like everyone else, no one knows what they are being taught when they start a class."
    js "跟大家一样，谁一开始上课的时候知道自己在学什么。"

# episode12\update12.rpy:11094
translate schinese ep12_jsolo_label_59ff1b0d:

    # js "If they did, they wouldn't have to be there."
    js "如果他们真的懂，就不用来了。"

# episode12\update12.rpy:11096
translate schinese ep12_jsolo_label_ef616bfc:

    # ir "An excellent point, Josephine."
    ir "一个很好的观点，乔西。"

# episode12\update12.rpy:11099
translate schinese ep12_jsolo_label_40090a2e:

    # js "Like everyone else. No one knows what they are being taught when they start a class."
    js "像所有人一样，没人知道自己一开始上课时到底在学什么。"

# episode12\update12.rpy:11100
translate schinese ep12_jsolo_label_59ff1b0d_1:

    # js "If they did, they wouldn't have to be there."
    js "如果他们知道，就不用坐在那里了。"

# episode12\update12.rpy:11102
translate schinese ep12_jsolo_label_ef616bfc_1:

    # ir "An excellent point, Josephine."
    ir "好点子，乔西。"

# episode12\update12.rpy:11103
translate schinese ep12_jsolo_label_2c72b566:

    # ir "Now, I've been waiting for you to tell me all about that blog of yours."
    ir "现在，我一直在等你跟我说说你的那个博客。"

# episode12\update12.rpy:11104
translate schinese ep12_jsolo_label_460dbe27:

    # ir "Have you registered it as a business yet?"
    ir "你把这当成正式生意注册了吗？"

# episode12\update12.rpy:11109
translate schinese ep12_jsolo_label_0ace1a90:

    # js "As a matter of fact, I have."
    js "事实上，我已经有注册了。"

# episode12\update12.rpy:11110
translate schinese ep12_jsolo_label_6b8e9e9b:

    # js "Because I started accepting donations from subscribers and didn't want to end up with lots of problems later."
    js "因为我开始接受订阅者的捐款，不想以后搞得问题一大堆。"

# episode12\update12.rpy:11115
translate schinese ep12_jsolo_label_0e85bc20:

    # ir "Who's managing your bookkeeping?"
    ir "谁在帮你管账？"

# episode12\update12.rpy:11120
translate schinese ep12_jsolo_label_ffdc662c:

    # js "You're looking at her."
    js "你正看着她。"

# episode12\update12.rpy:11125
translate schinese ep12_jsolo_label_93590dce:

    # ir "Are you doing that by yourself?"
    ir "你自己在做吗？"

# episode12\update12.rpy:11128
translate schinese ep12_jsolo_label_9b6794e7:

    # mc "Wow, that's amazing. Can you do that?"
    mc "哇，这太棒了。你能做到吗？"

# episode12\update12.rpy:11132
translate schinese ep12_jsolo_label_61f75d29:

    # js "It's not that hard."
    js "这不难。"

# episode12\update12.rpy:11134
translate schinese ep12_jsolo_label_9ccce3d0:

    # ir "It doesn't surprise me that you found it simple."
    ir "这倒不让我意外。"

# episode12\update12.rpy:11135
translate schinese ep12_jsolo_label_2fa6ac98:

    # ir "But I was surprised you'd waste your time on something that doesn't bring value to your company."
    ir "但我没想到你会浪费时间在一件对你们公司毫无价值的事情上。"

# episode12\update12.rpy:11140
translate schinese ep12_jsolo_label_de1fe6e1:

    # js "It keeps me out of trouble with the IRS. I consider that value."
    js "这能让我避开税务局的麻烦，我觉得这就是价值。"

# episode12\update12.rpy:11142
translate schinese ep12_jsolo_label_c01da564:

    # ir "What I mean is that your time is what brings value to your company and product."
    ir "我的意思是，你的时间才是给公司和产品带来价值的东西。"

# episode12\update12.rpy:11143
translate schinese ep12_jsolo_label_a4a672a0:

    # ir "Simple tasks that others can handle shouldn't be your concern."
    ir "简单的事情，别人能处理的，就不该是你担心的事。"

# episode12\update12.rpy:11145
translate schinese ep12_jsolo_label_b7a7e971:

    # ir "It's not expensive to hire a bookkeeper for a small-scale company. I will refer you to one."
    ir "聘请一个会计对小公司来说并不贵，我可以介绍一个给你。"

# episode12\update12.rpy:11150
translate schinese ep12_jsolo_label_4d3029e2:

    # js "I want to handle it by myself, thanks."
    js "谢谢，我想自己处理。"

# episode12\update12.rpy:11153
translate schinese ep12_jsolo_label_7fcfefe4:

    # cli "You don't have to be snarky when Iris offers you advice. She only means well."
    cli "你没必要在Iris给你建议时摆出一副嘲讽的样子。她只是好心。"

# episode12\update12.rpy:11159
translate schinese ep12_jsolo_label_e2959dd4:

    # mc "She's not snarky. Josy is passionate about doing it on her own."
    mc "她没那么刻薄。Josy就是想自己来，很认真。"

# episode12\update12.rpy:11160
translate schinese ep12_jsolo_label_64087c3c:

    # mc "If anything, calling it simple is putting her down. I couldn't do what she's doing."
    mc "说它简单其实是在贬低她。我可做不到她现在做的事。"

# episode12\update12.rpy:11163
translate schinese ep12_jsolo_label_7201ff47:

    # mc "(I want to say something, but I should stay out of it...)"
    mc "（我想说点什么，但还是别插手了……）"

# episode12\update12.rpy:11165
translate schinese ep12_jsolo_label_2a3de351:

    # js "I don't need her help. I like doing things on my own. That's the point I'm trying to make."
    js "我不需要她的帮助。我喜欢自己动手。这就是我想表达的意思。"

# episode12\update12.rpy:11168
translate schinese ep12_jsolo_label_2a3de351_1:

    # js "I don't need her help. I like doing things on my own. That's the point I'm trying to make."
    js "我不需要她的帮助。我喜欢自己动手。这就是我想表达的意思。"

# episode12\update12.rpy:11170
translate schinese ep12_jsolo_label_4b310b89:

    # ir "I didn't realize you wanted to stand completely on your own two feet."
    ir "我没意识到你想要完全靠自己站着。"

# episode12\update12.rpy:11171
translate schinese ep12_jsolo_label_e874d802:

    # ir "That's admirable."
    ir "这很值得敬佩。"

# episode12\update12.rpy:11176
translate schinese ep12_jsolo_label_61f0ca4f:

    # js "Thank you... If I wanted advice, I'd ask you."
    js "谢谢... 如果我需要建议，我会向你寻求帮助。"

# episode12\update12.rpy:11181
translate schinese ep12_jsolo_label_a958909b:

    # ir "Other than the boring aspects of running a business, tell me about the rest."
    ir "除了经营生意那些无聊的部分，跟我说说其他方面吧。"

# episode12\update12.rpy:11186
translate schinese ep12_jsolo_label_f2417dc0:

    # js "Nothing is boring about it. I find everything fun."
    js "没什么是无聊的。我覺得每件事都挺有意思的。"

# episode12\update12.rpy:11191
translate schinese ep12_jsolo_label_9336c6da:

    # ir "Yes, yes. But what about your actual product? Tell me more about it."
    ir "是的，是的。但你自己的产品呢？多跟我说说。"

# episode12\update12.rpy:11196
translate schinese ep12_jsolo_label_1afb880c:

    # js "Well, I have some exciting news. One of the bigger bloggers on the platform contacted me the other week and asked for my permission to repost my photos."
    js "我有个令人兴奋的消息。前几周，平台上一位很有名气的博主联系我，问能不能转载我的照片。"

# episode12\update12.rpy:11197
translate schinese ep12_jsolo_label_9e841c72:

    # js "She posted a collection of winter fashion, and I was in it."
    js "她发了一组冬日时尚照，我还在里面。"

# episode12\update12.rpy:11199
translate schinese ep12_jsolo_label_20c8e6fb:

    # js "She credited me for my pictures, and I saw more than a 300%% increase in followers in two days."
    js "她称赞了我的照片，我看到了超过300张%%两天内追随者数量的增加。"

# episode12\update12.rpy:11201
translate schinese ep12_jsolo_label_991ebc5e:

    # ir "Now that's a smart move."
    ir "这招真聪明。"

# episode12\update12.rpy:11206
translate schinese ep12_jsolo_label_2fb2fd3a:

    # js "Thank you."
    js "谢谢。"

# episode12\update12.rpy:11208
translate schinese ep12_jsolo_label_664b7ce8:

    # ir "I meant by the other blogger."
    ir "我是说那个其他博主。"

# episode12\update12.rpy:11213
translate schinese ep12_jsolo_label_b607dcc6:

    # js "Come again?"
    js "你再说一遍？"

# episode12\update12.rpy:11215
translate schinese ep12_jsolo_label_0b5d7fb5:

    # ir "She obviously got your content for free, dear. That's minimal effort on her end."
    ir "她明显是白拿了你的内容，亲爱的。对她来说简直轻而易举。"

# episode12\update12.rpy:11220
translate schinese ep12_jsolo_label_f1837a62:

    # js "But I got publicity. She didn't shaft me, if that's what you're saying."
    js "但我得到了宣传，她没占我便宜，如果你是这个意思的话。"

# episode12\update12.rpy:11222
translate schinese ep12_jsolo_label_14e091cc:

    # ir "No, no. That wasn't what I was saying. I was making the point that it was a smart move for her to utilize her power position."
    ir "不，不，我没那个意思。我是想说，她利用自己的地位，这招挺聪明的。"

# episode12\update12.rpy:11223
translate schinese ep12_jsolo_label_20fddd01:

    # ir "Of course, smaller bloggers will jump at the chance to get a splash of her notoriety."
    ir "当然，那些小博主们肯定会抢着蹭她的名气。"

# episode12\update12.rpy:11225
translate schinese ep12_jsolo_label_3fa8aa3e:

    # ir "Meanwhile, her business thrives on unique content for free."
    ir "与此同时，她的事业正靠着免费的独特内容蓬勃发展。"

# episode12\update12.rpy:11226
translate schinese ep12_jsolo_label_694b3c72:

    # ir "And that's how she will continue to stay ahead. She gets it."
    ir "这就是她能一直保持领先的原因。她占了便宜。"

# episode12\update12.rpy:11231
translate schinese ep12_jsolo_label_86809f2f:

    # js "It still sounds like you're saying that she used me."
    js "这还是听起来像你在说她利用了我。"

# episode12\update12.rpy:11236
translate schinese ep12_jsolo_label_6d05f47e:

    # ir "No, I'm saying she got the better end of that deal. But, of course, you have to start somewhere."
    ir "不，我说的是她占了便宜。不过，当然了，你得从某个地方开始。"

# episode12\update12.rpy:11237
translate schinese ep12_jsolo_label_e872dd50:

    # ir "In your position, it was a good choice too."
    ir "你当时的选择也挺明智的。"

# episode12\update12.rpy:11257
translate schinese ep12_ret2_label_41549d3c:

    # rs "This is the place."
    rs "这就是地方。"

# episode12\update12.rpy:11259
translate schinese ep12_ret2_label_af06820d:

    # mc "Hm... Are we all gonna fit in here? It will get cramped."
    mc "嗯……我们都能挤得下吗？这地方会很挤。"

# episode12\update12.rpy:11261
translate schinese ep12_ret2_label_5bbe1ec2:

    # rs "There's another room like this one down the hall. They are the dining halls."
    rs "还有这间屋子的另一个房间在走廊尽头，那是食堂。"

# episode12\update12.rpy:11262
translate schinese ep12_ret2_label_21af0859:

    # rs "Tommy came up with the idea of splitting the dining rooms and keeping the frats separate."
    rs "是Tommy想出的主意，把食堂分开，让兄弟会保持独立。"

# episode12\update12.rpy:11264
translate schinese ep12_ret2_label_64a054bb:

    # mc "Is everyone ok with that?"
    mc "大家都没意见吧？"

# episode12\update12.rpy:11266
translate schinese ep12_ret2_label_d014cc3b:

    # rs "The jocks loved the idea. Sage was the only one who put up a little bit of a fight."
    rs "橄榄球队的人都很喜欢这个主意，只有Sage稍微反对了一下。"

# episode12\update12.rpy:11270
translate schinese ep12_ret2_label_3afc7f11:

    # mc "Why didn't Sage like it?"
    mc "为什么Sage不喜欢这个主意？"

# episode12\update12.rpy:11272
translate schinese ep12_ret2_label_9d229d21:

    # rs "She didn't want us to act like kids in a divorced family and suggested we all could share the dining rooms."
    rs "她不想我们像离婚家庭里的孩子一样闹别扭，还建议我们大家还是可以一起用食堂。"

# episode12\update12.rpy:11273
translate schinese ep12_ret2_label_8724b95e:

    # rs "But the votes were two frats against one sorority, so..."
    rs "但投票结果是两个兄弟会反对一个姐妹会，所以……"

# episode12\update12.rpy:11275
translate schinese ep12_ret2_label_0979fa99:

    # mc "Yeah, so we'll split the party. No big deal. It sounds like a good approach to me."
    mc "嗯，所以我们就分两派吧。没什么大不了的。听起来这个办法挺不错的。"

# episode12\update12.rpy:11277
translate schinese ep12_ret2_label_8fb4de9b:

    # mc "I'm surprised they liked it."
    mc "我倒是挺意外他们居然喜欢这个主意。"

# episode12\update12.rpy:11279
translate schinese ep12_ret2_label_67994614:

    # rs "Yeah, it was weird seeing them agree with Tommy."
    rs "嗯，看到他们同意Tommy确实有点奇怪。"

# episode12\update12.rpy:11281
translate schinese ep12_ret2_label_ad16c5d1:

    # mc "But it sounds like a good approach. I think it will make the party more relaxed."
    mc "但这听起来是个不错的办法。我觉得这样会让派对更轻松些。"

# episode12\update12.rpy:11283
translate schinese ep12_ret2_label_34b8f5a5:

    # rs "Come."
    rs "来。"

# episode12\update12.rpy:11285
translate schinese ep12_ret2_label_3ad9784b:

    # rs "This is where we'll drink and dance the night away."
    rs "这就是我们要喝酒跳舞、彻夜狂欢的地方。"

# episode12\update12.rpy:11287
translate schinese ep12_ret2_label_b607b431:

    # mc "What is this place? You've got a gymnasium here and conference rooms over there."
    mc "这是什么地方？你这儿有体育馆，那边还有会议室。"

# episode12\update12.rpy:11289
translate schinese ep12_ret2_label_2f105f48:

    # rs "It's an old building from before the campus gym was built. Nowadays, it's mostly used for conferences."
    rs "这栋楼是校园体育馆建起来之前的老建筑，现在 基本上 用来开会议。"

# episode12\update12.rpy:11290
translate schinese ep12_ret2_label_16f314bb:

    # rs "I believe they use this gym for some local sports competitions, but that's about it."
    rs "我相信他们偶尔会在这儿办一些本地体育比赛，但也就这么多了。"

# episode12\update12.rpy:11291
translate schinese ep12_ret2_label_b23952f7:

    # rs "So, what do you think?"
    rs "那你觉得怎么样？"

# episode12\update12.rpy:11293
translate schinese ep12_ret2_label_a2a05b33:

    # mc "It will work. It's not like we have any better options."
    mc "这就行。我们也没什么更好的选择。"

# episode12\update12.rpy:11295
translate schinese ep12_ret2_label_84dee9f4:

    # rs "I'll be here helping out every day until New Year's Eve. If you're free, you're welcome to join me."
    rs "我会在这里帮忙直到除夕。如果你有空，随时可以来一起。"

# episode12\update12.rpy:11298
translate schinese ep12_ret2_label_7e8eb8f0:

    # mc "I'll help out as much as I can, but I have a fighting competition on the 29th. It will take all day."
    mc "我会尽我所能帮忙，但我29号有一场搏击比赛，得一整天。"

# episode12\update12.rpy:11300
translate schinese ep12_ret2_label_cf33d9b1:

    # rs "Any time you can spare is appreciated."
    rs "任何你有空的时间都很感激。"

# episode12\update12.rpy:11302
translate schinese ep12_ret2_label_ea59e85f:

    # mc "I'll help out as much as I can, but I'm off on the 29th. I'm performing at the faculty's Christmas party."
    mc "我尽我所能帮忙，但我29号得出去表演，是学院圣诞派对的节目。"

# episode12\update12.rpy:11304
translate schinese ep12_ret2_label_cf33d9b1_1:

    # rs "Any time you can spare is appreciated."
    rs "任何你能抽空的时间我都感激。"

# episode12\update12.rpy:11306
translate schinese ep12_ret2_label_ad8d715e:

    # mc "I have a clean slate. I'll be here."
    mc "我重新开始过了，我会在这里的。"

# episode12\update12.rpy:11308
translate schinese ep12_ret2_label_508b2aaf:

    # rs "I appreciate it."
    rs "我谢了。"

# episode12\update12.rpy:11310
translate schinese ep12_ret2_label_51a5d3d2:

    # mc "What about the rest of the DIKs?"
    mc "那其他DIKs呢？"

# episode12\update12.rpy:11312
translate schinese ep12_ret2_label_aeed62d0:

    # rs "Tommy and Leon should be back tomorrow. The rest, I don't know for sure."
    rs "Tommy和Leon明天应该就能回来。其他的人，我还不确定。"

# episode12\update12.rpy:11313
translate schinese ep12_ret2_label_752c483e:

    # rs "The jocks are already helping out, and several HOTs, too."
    rs "健美社的人已经帮忙了，还有一些HOT们也加入了。"

# episode12\update12.rpy:11316
translate schinese ep12_ret2_label_70439e98:

    # rs "I hope you don't mind me asking, but is everything ok between you and Sage?"
    rs "希望你别介意我问这个，你和Sage之间还好吗？"

# episode12\update12.rpy:11319
translate schinese ep12_ret2_label_edaecedb:

    # mc "No. We broke up recently."
    mc "不，我们最近分手了。"

# episode12\update12.rpy:11321
translate schinese ep12_ret2_label_657a3a36:

    # rs "Oh, so that's why..."
    rs "哦，原来是这样……"

# episode12\update12.rpy:11323
translate schinese ep12_ret2_label_1ccaa5e1:

    # mc "No. Something happened, but I don't want to get into it."
    mc "不，发生了一些事，但我现在不想说。"

# episode12\update12.rpy:11325
translate schinese ep12_ret2_label_c7cd2416:

    # rs "I noticed her being short with me when I mentioned you."
    rs "我注意到她在我提到你的时候态度有点冷淡。"

# episode12\update12.rpy:11327
translate schinese ep12_ret2_label_a9108909:

    # mc "Yeah. It's not the best situation to plan a party together with someone who doesn't want to be around you..."
    mc "嗯. 它不是个好主意，跟一个不想跟你待在一起的人一起策划派对..."

# episode12\update12.rpy:11329
translate schinese ep12_ret2_label_562c08bf:

    # rs "If that's the case, leave the rest of the planning to me. You did a great job with it as it is."
    rs "如果情况是这样，那剩下的计划就交给我吧。你现在的安排已经做得很好了。"

# episode12\update12.rpy:11332
translate schinese ep12_ret2_label_ea36c38b:

    # mc "Thanks for showing me the place. It's gonna be awesome! I'm off to the gym."
    mc "谢谢带我来这地方， 会 很棒！我先去健身房了。"

# episode12\update12.rpy:11334
translate schinese ep12_ret2_label_54f156e5:

    # rs "Burning off that Christmas food?"
    rs "燃掉那些圣诞吃的？"

# episode12\update12.rpy:11336
translate schinese ep12_ret2_label_a4d785bd:

    # mc "Hah! Something like it."
    mc "哈！正合我意。"

# episode12\update12.rpy:11341
translate schinese ep12_ret2_label_f92cbff1:

    # mc "Hey, it's me."
    mc "嘿，是我。"

# episode12\update12.rpy:11343
translate schinese ep12_ret2_label_b0d0c834:

    # bia "I've waited for your call."
    bia "我等你电话了。"

# episode12\update12.rpy:11345
translate schinese ep12_ret2_label_08eaef3b:

    # mc "Sorry for keeping you waiting. I'm back on campus."
    mc "抱歉让你等了，我回来了，已经在校园里了。"

# episode12\update12.rpy:11347
translate schinese ep12_ret2_label_6a27bf1d:

    # bia "Uh huh."
    bia "嗯，今晚？"

# episode12\update12.rpy:11349
translate schinese ep12_ret2_label_4f2a866e:

    # mc "And I was thinking... Wanna come over?"
    mc "而且我正想着……你来我家怎么样？"

# episode12\update12.rpy:11351
translate schinese ep12_ret2_label_e9ac6f02:

    # bia "Tonight?"
    bia "今晚？"

# episode12\update12.rpy:11353
translate schinese ep12_ret2_label_778527ec:

    # mc "If you're free."
    mc "你有空吗？"

# episode12\update12.rpy:11356
translate schinese ep12_ret2_label_42b8f622:

    # bia "Are you sure you want to do this?"
    bia "你确定要这么做吗？"

# episode12\update12.rpy:11359
translate schinese ep12_ret2_label_70b29b40:

    # mc "I am. But also, you should know that I broke up with Bella."
    mc "我是。不过你也得知道，我跟贝拉分手了。"

# episode12\update12.rpy:11361
translate schinese ep12_ret2_label_ea17596c:

    # bia "You did?"
    bia "你真的？"

# episode12\update12.rpy:11363
translate schinese ep12_ret2_label_a87a337b:

    # mc "Yep."
    mc "嗯。"

# episode12\update12.rpy:11365
translate schinese ep12_ret2_label_6e293b2a:

    # bia "That changes things for you, but for me it's still... You know?"
    bia "这对你来说改变了什么，但对我来说还是……你懂的？"

# episode12\update12.rpy:11367
translate schinese ep12_ret2_label_60edbadd:

    # mc "I know. I haven't stopped thinking about you."
    mc "我知道。我一直在想你。"

# episode12\update12.rpy:11371
translate schinese ep12_ret2_label_30eff5e1:

    # mc "I am. But also, you should know that I broke up with Jill."
    mc "是的。不过你也该知道，我和Jill分手了。"

# episode12\update12.rpy:11373
translate schinese ep12_ret2_label_e1de567f:

    # bia "Actually, I heard. But Jill never told me why."
    bia "其实我听说了。但Jill从来没跟我说过原因。"

# episode12\update12.rpy:11374
translate schinese ep12_ret2_label_ef2ac040:

    # bia "I didn't inquire because I was scared it had something to do with me."
    bia "我没问是因为我怕这事和我有关。"

# episode12\update12.rpy:11376
translate schinese ep12_ret2_label_41b9ccaf:

    # mc "No, it was about something I did in the past. We can leave it at that."
    mc "不，那是关于我过去做过的事。我们就这样算了。"

# episode12\update12.rpy:11378
translate schinese ep12_ret2_label_6e293b2a_1:

    # bia "That changes things for you, but for me it's still... You know?"
    bia "这对你来说改变了什么，但对我来说还是……你明白吗？"

# episode12\update12.rpy:11380
translate schinese ep12_ret2_label_d3f810cd:

    # mc "I know. I haven't stopped thinking about you. I gotta have you."
    mc "我知道。我还没停止想你。我必须拥有你。"

# episode12\update12.rpy:11383
translate schinese ep12_ret2_label_167e81a3:

    # mc "I haven't stopped thinking about you. I gotta have you."
    mc "我一刻都没停止想你。我必须拥有你。"

# episode12\update12.rpy:11386
translate schinese ep12_ret2_label_bafb6896:

    # bia "Haha... I get a kick from hearing that."
    bia "哈哈...听到这话我挺兴奋的。"

# episode12\update12.rpy:11388
translate schinese ep12_ret2_label_40ab33a4:

    # mc "My blood is pumping now, too. I'm thinking about everything I want to do with you."
    mc "我的血液现在也沸腾了，我脑子里全是想和你做什么的事。"

# episode12\update12.rpy:11390
translate schinese ep12_ret2_label_20298217:

    # bia "Mmm... Sounds hot. Tonight then."
    bia "嗯……听起来真带劲。今晚就搞吧。"

# episode12\update12.rpy:11392
translate schinese ep12_ret2_label_1b0c65c5:

    # mc "You can enter from my window. Wear something sexy."
    mc "你可以从我的窗户进来。穿点性感点的。"

# episode12\update12.rpy:11394
translate schinese ep12_ret2_label_bcacb663:

    # bia "I think I have something."
    bia "我想我有东西了。"

# episode12\update12.rpy:11398
translate schinese ep12_gym_label_4a1e2673:

    # dwy "Sure, I'll show. How big of a party are we talking about?"
    dwy "当然可以，我来展示一下。咱们这聚会大概能有多大阵仗？"

# episode12\update12.rpy:11400
translate schinese ep12_gym_label_cd74ff2e:

    # mc "The guest list isn't final, but we're around 100 guests, if not more."
    mc "宾客名单还没最终确定，但大概有一百人，可能更多。"

# episode12\update12.rpy:11402
translate schinese ep12_gym_label_a11c4519:

    # dwy "Is it cool if I invite some more people?"
    dwy "可以再请几个人来吗？"

# episode12\update12.rpy:11404
translate schinese ep12_gym_label_85d51034:

    # mc "Like who?"
    mc "像谁？"

# episode12\update12.rpy:11406
translate schinese ep12_gym_label_4527933f:

    # dwy "I'd bring my girl, and maybe Chao wants to come too. I heard he didn't have any plans."
    dwy "我带我女朋友来，可能Chao也想来。我听说他也没啥安排。"

# episode12\update12.rpy:11408
translate schinese ep12_gym_label_aec23b77:

    # mc "The more the merrier. I'll give you Sage's number, and you can shoot her the details."
    mc "人越多越热闹。我把Sage的号码给你，你可以把详情发给她。"

# episode12\update12.rpy:11409
translate schinese ep12_gym_label_a20858a9:

    # mc "But please do it soon. There's some planning involved with the food and such."
    mc "但请尽快处理。食物这些方面还需要一些安排。"

# episode12\update12.rpy:11411
translate schinese ep12_gym_label_22cad3cb:

    # dwy "Is she in charge of the guest list?"
    dwy "她负责安排客人名单吗？"

# episode12\update12.rpy:11413
translate schinese ep12_gym_label_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# episode12\update12.rpy:11415
translate schinese ep12_gym_label_8e988207:

    # dwy "What type of party is it?"
    dwy "这是什么类型的聚会？"

# episode12\update12.rpy:11417
translate schinese ep12_gym_label_ac913207:

    # mc "Dinner, dancing, and drinking. There's a dress code, too."
    mc "晚餐、跳舞和喝酒。还有着装要求呢。"

# episode12\update12.rpy:11419
translate schinese ep12_gym_label_3cfa6caa:

    # dwy "Dress to impress and move to the groove. Gotcha. I appreciate the invite."
    dwy "穿得体面点，跟着节奏舞动。明白了，谢谢你的邀请。"

# episode12\update12.rpy:11421
translate schinese ep12_gym_label_f03b031f:

    # mc "Haha! It's going to be weird to see you without gym clothes."
    mc "哈哈！见到你没穿健身房衣服可真有意思。"

# episode12\update12.rpy:11423
translate schinese ep12_gym_label_5aa55c8f:

    # dwy "Tell me about it. I wear this more than I wear casual clothes."
    dwy "跟我说说，我这身衣服比我随便穿的还多。"

# episode12\update12.rpy:11424
translate schinese ep12_gym_label_f455efe8:

    # dwy "When clients see me outside of the gym, they get shocked."
    dwy "当客户在我不在健身房的时候看到我，他们都会震惊。"

# episode12\update12.rpy:11426
translate schinese ep12_gym_label_abc65936:

    # mc "Do you dress that poorly?"
    mc "你穿得这么差？"

# episode12\update12.rpy:11428
translate schinese ep12_gym_label_a0901c30:

    # dwy "HAH! Big mouth on you. Focus more on your reps, boy."
    dwy "哈！你这张嘴真大。多注意你的训练次数，小子。"

# episode12\update12.rpy:11430
translate schinese ep12_gym_label_c91ab911:

    # dwy "Oh, and don't forget to show up early for the competition."
    dwy "哦，对了，别忘了比赛那天要早点来。"

# episode12\update12.rpy:11432
translate schinese ep12_gym_label_3ced51fb:

    # mc "I'm aware. I'll help out."
    mc "我知道。我会帮忙的。"

# episode12\update12.rpy:11434
translate schinese ep12_gym_label_3715af9b:

    # dwy "Awesome."
    dwy "牛逼。"

# episode12\update12.rpy:11446
translate schinese ep12_gym_label_7c35334a:

    # troy "Got a sec?"
    troy "有空吗？"

# episode12\update12.rpy:11448
translate schinese ep12_gym_label_66ed3bd4:

    # mc "I'm between sets here."
    mc "我现在在组间休息。"

# episode12\update12.rpy:11450
translate schinese ep12_gym_label_ab874ac1:

    # troy "It won't take long."
    troy "不会花太久。"

# episode12\update12.rpy:11452
translate schinese ep12_gym_label_def0ad19:

    # mc "What is it?"
    mc "什么事？"

# episode12\update12.rpy:11454
translate schinese ep12_gym_label_c4f848f8:

    # troy "Looking strong."
    troy "看起来状态不错。"

# episode12\update12.rpy:11456
translate schinese ep12_gym_label_bc24f4b7:

    # mc "Feeling strong too. I don't know what it is."
    mc "感觉也挺有劲的。我也不知道怎么回事。"

# episode12\update12.rpy:11458
translate schinese ep12_gym_label_3325282e:

    # troy "It's most likely the rest you've gotten from the winter break."
    troy "这大概是因为你寒假睡得太多了。"

# episode12\update12.rpy:11460
translate schinese ep12_gym_label_4e7c3bfb:

    # mc "I have slept in more than usual. How about you?"
    mc "我睡得比平时多了。你呢？"

