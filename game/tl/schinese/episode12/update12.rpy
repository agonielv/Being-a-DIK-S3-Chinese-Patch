# episode12\update12.rpy:12009
translate schinese ep12_zbret_label_c158dd89:

    # bre "I know you love him and all, but when push comes to shove, he sounds like a wishy-washy tool."
    bre "我知道你爱他，但说到底，他听起来像个优柔寡断的废物。"

# episode12\update12.rpy:12011
translate schinese ep12_zbret_label_ed8bdf56:

    # bre "He wants your friendship when you return, but now he has issues with it because you told him you love him."
    bre "他想要你回来后继续做朋友，但现在因为你告诉他你爱他，他开始对这段友谊有抵触了。"

# episode12\update12.rpy:12012
translate schinese ep12_zbret_label_8c68ff88:

    # bre "And he comes to your home at Christmas to talk about it, but he doesn't have much to say."
    bre "他圣诞节到你家来找你谈这件事，但也没什么好说的。"

# episode12\update12.rpy:12014
translate schinese ep12_zbret_label_189dc4b7:

    # bre "He doesn't even know what he wants for himself. Is he expecting you to solve everything for him?"
    bre "他连自己想要什么都不知道。他是不是指望你替他解决一切？"

# episode12\update12.rpy:12015
translate schinese ep12_zbret_label_238b068c:

    # bre "Is he waiting for you to make a choice and to go along with it, or is he trying to string you along?"
    bre "他是不是在等你做决定然后跟着他走，还是在拖着你？"

# episode12\update12.rpy:12016
translate schinese ep12_zbret_label_cbb2a689:

    # bre "What do you make of a guy like this?"
    bre "你觉得这种人该怎么看待？"

# episode12\update12.rpy:12018
translate schinese ep12_zbret_label_3fc6d461:

    # zo "I think he's conflicted because of our past."
    zo "我觉得他是因为我们过去的经历而内心矛盾。"

# episode12\update12.rpy:12019
translate schinese ep12_zbret_label_21f98fb7:

    # zo "If we hadn't grown up together, he wouldn't even have considered a friendship now."
    zo "如果我们没一起长大，他现在连交朋友都不会考虑。"

# episode12\update12.rpy:12021
translate schinese ep12_zbret_label_7fed570c:

    # bre "How do you know?"
    bre "你怎么知道的？"

# episode12\update12.rpy:12023
translate schinese ep12_zbret_label_f1d5aeef:

    # zo "Because that's how I feel about it."
    zo "因为这就是我感觉这样。"

# episode12\update12.rpy:12024
translate schinese ep12_zbret_label_9a16da02:

    # zo "What normal person wants to be around someone they got rejected by unless there's a strong bond between them?"
    zo "什么正常人会想和一个曾经拒绝过自己的人保持联系，除非他们之间有很强的羁绊？"

# episode12\update12.rpy:12026
translate schinese ep12_zbret_label_a5205e4d:

    # zo "It's self-destructive behavior."
    zo "这是自毁的行为。"

# episode12\update12.rpy:12028
translate schinese ep12_zbret_label_585446ac:

    # bre "And the bond makes the difference, huh?"
    bre "而且这种纽带才是关键，对吧？"

# episode12\update12.rpy:12030
translate schinese ep12_zbret_label_7ad020f0:

    # zo "That's what I'm trying to decide."
    zo "这就是我正在努力决定的。"

# episode12\update12.rpy:12031
translate schinese ep12_zbret_label_c57722cd:

    # zo "I mean... Look at you and Emma."
    zo "我是说...看看你和Emma。"

# episode12\update12.rpy:12033
translate schinese ep12_zbret_label_110fc0ca:

    # bre "Listen... I don't want you to do something stupid."
    bre "听着，我不想你做傻事。"

# episode12\update12.rpy:12034
translate schinese ep12_zbret_label_a952a4fc:

    # bre "Whatever choice you make... Be selfish about this."
    bre "无论你做出什么选择……都别太顾及别人。"

# episode12\update12.rpy:12053
translate schinese ep12_fcomp_label_b740b2b5:

    # aud "*{i}Gasps{/i}*"
    aud "*{i}惊呼{/i}*"

# episode12\update12.rpy:12057
translate schinese ep12_fcomp_label_e411c874:

    # ann "And that's it! The ref called it! Chao wins on TKO!"
    ann "而且这就是结局！裁判判了！Chao以TKO获胜！"

# episode12\update12.rpy:12059
translate schinese ep12_fcomp_label_34fb1398:

    # aud "*{i}Cheers{/i}*"
    aud "*{i}干杯{/i}*"

# episode12\update12.rpy:12063
translate schinese ep12_fcomp_label_e4dd3fc2:

    # mc "You can do this. You can do this..."
    mc "你可以做到。你可以做到……"

# episode12\update12.rpy:12065
translate schinese ep12_fcomp_label_73ab9692:

    # tate "Hey, [name]! You missed it!"
    tate "嘿，[name]你错过了！"

# episode12\update12.rpy:12067
translate schinese ep12_fcomp_label_39ca800a:

    # mc "I missed my fight!?"
    mc "我错过比赛了？！"

# episode12\update12.rpy:12069
translate schinese ep12_fcomp_label_46a08443:

    # tate "What? No! Chao won on TKO!"
    tate "什么？不！Chao是靠技术性击倒获胜的！"

# episode12\update12.rpy:12070
translate schinese ep12_fcomp_label_006508a3:

    # tate "He sure showed the City Fighters who they're up against. We're one up!"
    tate "他可真是让城战团见识了我们的实力。我们现在领先了！"

# episode12\update12.rpy:12072
translate schinese ep12_fcomp_label_dda13195:

    # mc "That's awesome. Great!"
    mc "这太棒了，真不错！"

# episode12\update12.rpy:12074
translate schinese ep12_fcomp_label_33fb5347:

    # tate "How are you doing? You look pale."
    tate "你怎么样？脸色看起来不太好。"

# episode12\update12.rpy:12076
translate schinese ep12_fcomp_label_fdd98115:

    # mc "I think it's the nerves. I've never fought in front of an audience before. You know, with a referee, an announcer and all."
    mc "我想是紧张吧。我从来没在观众面前打过架。你知道的，有裁判、有解说员，一整套流程。"

# episode12\update12.rpy:12077
translate schinese ep12_fcomp_label_aad85440:

    # mc "I didn't think this competition would be at this level. I thought it was something...a bit less of everything, you know?"
    mc "我没想到比赛会这么高水平。我原本以为它会是……稍微简单点的东西，你懂吧？"

# episode12\update12.rpy:12079
translate schinese ep12_fcomp_label_b006f467:

    # tate "I wimped out during my first fight, too."
    tate "我第一次打的时候也怂了。"

# episode12\update12.rpy:12080
translate schinese ep12_fcomp_label_60642fed:

    # tate "Don't pay too much attention to the people around you. The announcer is there to make things more fun for the audience."
    tate "别太在意周围那些人。解说员的存在就是为了让观众看得更开心。"

# episode12\update12.rpy:12081
translate schinese ep12_fcomp_label_cefa5275:

    # tate "And you gotta have a referee, don't you?"
    tate "你还得有个裁判，对吧？"

# episode12\update12.rpy:12083
translate schinese ep12_fcomp_label_63cac586:

    # mc "I know. It just hit me now how much I want this. Like... I want to give it my all."
    mc "我知道。现在我才意识到我有多想要这个机会。就像……我想全力以赴地去拼。"

# episode12\update12.rpy:12085
translate schinese ep12_fcomp_label_831f1f69:

    # tate "That's the spirit! Hold on to that!"
    tate "这才是该有的精神！坚持住！"

# episode12\update12.rpy:12087
translate schinese ep12_fcomp_label_1af6df69:

    # mc "But what if I'm not good enough?"
    mc "但万一我还不够好呢？"

# episode12\update12.rpy:12089
translate schinese ep12_fcomp_label_c3e3b3b2:

    # tate "And the spirit is gone..."
    tate "精神没了..."

# episode12\update12.rpy:12090
translate schinese ep12_fcomp_label_09c6813e:

    # tate "Everyone doubts themselves at some point. And those who say they don't, they're lying."
    tate "每个人都会有自我怀疑的时候。那些说自己不会的，其实都是在撒谎。"

# episode12\update12.rpy:12092
translate schinese ep12_fcomp_label_1fa466de:

    # tate "Win or lose, it doesn't matter today. You can still give it your all."
    tate "赢了或者输了，今天都不打紧。你还能全力以赴。"

# episode12\update12.rpy:12095
translate schinese ep12_fcomp_label_0fc5ac79:

    # mc "*{i}Pukes{/i}*"
    mc "*{i}干呕{/i}*"

# episode12\update12.rpy:12096
translate schinese ep12_fcomp_label_89f5b15f:

    # tate "Bro..."
    tate "兄弟……"

# episode12\update12.rpy:12098
translate schinese ep12_fcomp_label_11c47f19:

    # mc "I'll make it."
    mc "我能做到。"

# episode12\update12.rpy:12100
translate schinese ep12_fcomp_label_07a03b3c:

    # dwy "[name]. You're up. Wrapped up and ready?"
    dwy "[name]你上场了？收拾好了，准备好了吗？"

# episode12\update12.rpy:12102
translate schinese ep12_fcomp_label_fb5f4cc0:

    # mc "Yeah... I'm ready."
    mc "嗯，我准备好了。"

# episode12\update12.rpy:12104
translate schinese ep12_fcomp_label_b7d0a1a2:

    # dwy "I need to talk to you. Walk with me."
    dwy "我有话想跟你说，走，跟我走一趟。"

# episode12\update12.rpy:12107
translate schinese ep12_fcomp_label_6997a076:

    # dwy "You're gonna do great today. Keep your mind on your goal."
    dwy "你今天一定会很棒。别忘了你的目标。"

# episode12\update12.rpy:12109
translate schinese ep12_fcomp_label_73fba9d7:

    # mc "My goal, yeah..."
    mc "我的目标，嗯……"

# episode12\update12.rpy:12111
translate schinese ep12_fcomp_label_7885d4ab:

    # mc "Knock the fucker out."
    mc "干掉他。"

# episode12\update12.rpy:12113
translate schinese ep12_fcomp_label_0589d383:

    # dwy "That's the attitude. But you know... Be respectful too."
    dwy "这才是态度。不过你得知道...也要有分寸。"

# episode12\update12.rpy:12115
translate schinese ep12_fcomp_label_f33a7a3f:

    # mc "Do my best, keep it clean, and try to win."
    mc "尽力而为，保持冷静，争取赢下比赛。"

# episode12\update12.rpy:12117
translate schinese ep12_fcomp_label_cad9117e:

    # dwy "Sounds good. You could do with more attitude, though."
    dwy "听起来不错。不过你还需要多点狠劲。"

# episode12\update12.rpy:12118
translate schinese ep12_fcomp_label_993f6848:

    # dwy "Rumor has it, there's a scout in the audience."
    dwy "听说观众席里有位星探。"

# episode12\update12.rpy:12120
translate schinese ep12_fcomp_label_587edd22:

    # mc "A scout?"
    mc "星探？"

# episode12\update12.rpy:12122
translate schinese ep12_fcomp_label_2719541f:

    # dwy "Yeah. Someone is keeping an eye out for promising talent."
    dwy "对，有人在暗中留意着有潜力的新人。"

# episode12\update12.rpy:12123
translate schinese ep12_fcomp_label_b5b66d24:

    # dwy "I don't know who he is or who he works for, but scouts mean sponsors and sponsors mean money."
    dwy "我不知道她是谁、替谁工作，但有星探就意味着赞助商，有赞助商就意味着有钱。"

# episode12\update12.rpy:12124
translate schinese ep12_fcomp_label_353ac365:

    # dwy "Aim to impress."
    dwy "瞄准表现。"

# episode12\update12.rpy:12128
translate schinese ep12_fcomp_label_06d956d3:

    # troy "[name], you got this. We're rooting for you."
    troy "[name]你行的，我们支持你。"

# episode12\update12.rpy:12131
translate schinese ep12_fcomp_label_e2a747ce:

    # chao "Let's go, [name]!"
    chao "走吧，[name]!"

# episode12\update12.rpy:12133
translate schinese ep12_fcomp_label_38918496:

    # mc "This is a bigger audience than I expected."
    mc "这观众比我想的还多。"

# episode12\update12.rpy:12135
translate schinese ep12_fcomp_label_66dd0b49:

    # dwy "I know, I know. Zone that shit out. They don't matter during your fight."
    dwy "我知道，我知道。别管那些杂碎。你打比赛的时候，他们根本不值一提。"

# episode12\update12.rpy:12136
translate schinese ep12_fcomp_label_299e5301:

    # dwy "They're just noise, trying to distract you."
    dwy "这都是杂音，想分散你的注意力。"

# episode12\update12.rpy:12138
translate schinese ep12_fcomp_label_d5ac8edf:

    # dwy "I have vetted your opponent. He's undefeated with 7-0. He likes to keep it technical and wait for clean shots."
    dwy "我分析过你的对手。他7战全胜，喜欢打技术流，等着找机会一击必杀。"

# episode12\update12.rpy:12139
translate schinese ep12_fcomp_label_e9c64cb3:

    # dwy "He's not a risk-taker, and his fists are what you need to look out for."
    dwy "他不是那种喜欢冒险的人，你得提防他的拳头。"

# episode12\update12.rpy:12141
translate schinese ep12_fcomp_label_008d353a:

    # mc "What about his leg game?"
    mc "他腿上功夫怎么样？"

# episode12\update12.rpy:12143
translate schinese ep12_fcomp_label_dbe4b95d:

    # dwy "He'll likely throw in a low kick here and there to wear you out and open you up."
    dwy "他可能会时不时来一脚低踢，让你疲于应对，进而露出破绽。"

# episode12\update12.rpy:12144
translate schinese ep12_fcomp_label_a7c40b6e:

    # dwy "Don't fall for it. Keep your guard up until you're within range, and then unleash multiple attacks when you commit."
    dwy "别上当。保持警觉，直到接近对手，然后集中发动多次攻击。"

# episode12\update12.rpy:12145
translate schinese ep12_fcomp_label_5b6c7166:

    # dwy "Chain your moves together. Overwhelm his defense, and you'll have the upper hand."
    dwy "连招衔接起来，压垮他的防守，你就能掌握主动。"

# episode12\update12.rpy:12148
translate schinese ep12_fcomp_label_72cada7f:

    # dwy "Trust your instincts. I'm in your corner."
    dwy "相信你的直觉。我在你这边。"

# episode12\update12.rpy:12151
translate schinese ep12_fcomp_label_0b7ca672:

    # ann "In the blue corner: he's a 6'1\" fighter, weighing in at 182 pounds. He's a first-time fighter, fighting for the Burgmeister & Royce campus gym."
    ann "蓝角这边：他是个身高六英尺一英寸、体重一百八十二磅的拳手，是第一次参加比赛，代表伯格梅斯特与罗伊斯校园健身房出战。"

# episode12\update12.rpy:12154
translate schinese ep12_fcomp_label_fd9e9e81:

    # ann "Give it up for... [name] [lname]!"
    ann "让位给……[name] [lname]!"

# episode12\update12.rpy:12155
translate schinese ep12_fcomp_label_34fb1398_1:

    # aud "*{i}Cheers{/i}*"
    aud "*{i}干杯{/i}*"

# episode12\update12.rpy:12158
translate schinese ep12_fcomp_label_0cb8f61e:

    # js "Yes! Go [name]!!!"
    js "是！去[name]!!!"

# episode12\update12.rpy:12159
translate schinese ep12_fcomp_label_393aad18:

    # my "WOOO!!!"
    my "呜呼！！！"

# episode12\update12.rpy:12160
translate schinese ep12_fcomp_label_d3ce09e6:

    # sa "WHOOP! WHOOP!"
    sa "哇哦！加油！"

# episode12\update12.rpy:12163
translate schinese ep12_fcomp_label_49b9a67b:

    # zo "*{i}Cheers{/i}* [name]!!!"
    zo "*{i}干杯{/i}* [name]!!!"

# episode12\update12.rpy:12166
translate schinese ep12_fcomp_label_5a4fe5d8:

    # nic "Let's go!!! [name]!!!"
    nic "走啊！！！[name]!!!"

# episode12\update12.rpy:12172
translate schinese ep12_fcomp_label_1a4c1767:

    # ann "In the red corner: he's a 5'10\" fighter, weighing in at 183 pounds. He stands at 7 wins and 0 losses, fighting for the City Fighters gym."
    ann "红角这边：他身高五英尺十英寸，体重一百八十三磅。战绩七胜零负，为城市格斗馆出战。"

# episode12\update12.rpy:12176
translate schinese ep12_fcomp_label_fff5e1ad:

    # ann "Give it up for - well, I'll be damned - Johnny Stevens!"
    ann "给这小子加油——天哪，居然是约翰尼·史蒂文斯！"

# episode12\update12.rpy:12178
translate schinese ep12_fcomp_label_8d4d5f15:

    # ann "Give it up for Johnny Stevens!"
    ann "为约翰尼·史蒂文斯加油！"

# episode12\update12.rpy:12180
translate schinese ep12_fcomp_label_34fb1398_2:

    # aud "*{i}Cheers{/i}*"
    aud "*{i}干杯{/i}*"

# episode12\update12.rpy:12181
translate schinese ep12_fcomp_label_8930f377:

    # aud "GO, JOHNNY!!!"
    aud "上啊，乔尼！！！"

# episode12\update12.rpy:12183
translate schinese ep12_fcomp_label_e969ed75:

    # mc "(I can take this guy.)"
    mc "（我能对付这个家伙。）"

# episode12\update12.rpy:12185
translate schinese ep12_fcomp_label_3d70e11b:

    # ref "Ok, guys. I want to see a clean fight. Follow my instructions at all times."
    ref "好，伙计们，我要看到一场干净的比赛。随时听从我的指示。"

# episode12\update12.rpy:12186
translate schinese ep12_fcomp_label_92da6b27:

    # ref "Touch gloves if you want. Let's do this."
    ref "如果你想碰拳就碰吧。我们开始吧。"

# episode12\update12.rpy:12191
translate schinese ep12_fcomp_label_7738f596:

    # ann "Touching gloves is a sign of respect for the sport and your opponent, but [name] doesn't want to do it."
    ann "握手是表达对这项运动和对手尊重的一种方式，但[name]不想做。"

# episode12\update12.rpy:12192
translate schinese ep12_fcomp_label_5c4220be:

    # ann "Maybe he's trying to get into his opponent's head."
    ann "也许他想扰乱对手的心思。"

# episode12\update12.rpy:12195
translate schinese ep12_fcomp_label_f82c1383:

    # ann "And the fighters touch gloves and make their way back to their corners for the fight."
    ann "双方选手互相击掌后，回到各自的角落准备开始比赛。"

# episode12\update12.rpy:12197
translate schinese ep12_fcomp_label_16943865:

    # ref "FIGHT!"
    ref "战斗开始！"

# episode12\update12.rpy:12198
translate schinese ep12_fcomp_label_c2266746:

    # ann "And the fight is on!"
    ann "战斗开始了！"

# episode12\update12.rpy:12229
translate schinese ep12_fcomp_round1_end_label_a74e0a98:

    # ann "[name] with a heel kick!"
    ann "[name]以高跟鞋踢出！"

# episode12\update12.rpy:12230
translate schinese ep12_fcomp_round1_end_label_750b96ff:

    # ann "It connects!"
    ann "它接上了！"

# episode12\update12.rpy:12232
translate schinese ep12_fcomp_round1_end_label_be5d2d4e:

    # ann "That has got to rattle his opponent."
    ann "这下肯定让对手有点发懵。"

# episode12\update12.rpy:12236
translate schinese ep12_fcomp_round1_end_label_a74e0a98_1:

    # ann "[name] with a heel kick!"
    ann "[name]以高跟鞋踢出！"

# episode12\update12.rpy:12237
translate schinese ep12_fcomp_round1_end_label_1c8106a0:

    # ann "He dodged that one."
    ann "他闪开了。"

# episode12\update12.rpy:12240
translate schinese ep12_fcomp_round1_end_label_edadd2ce:

    # ann "And he counters with a clean shot to the head."
    ann "他立刻反击，一记干净利落的头部重击。"

# episode12\update12.rpy:12243
translate schinese ep12_fcomp_round1_end_label_2a0a53ef:

    # ann "Whoa! A hard kick to the body. Johnny is switching things up late in the first."
    ann "哇！一脚重踢到腹部。乔尼在第一回合末尾突然换了招式。"

# episode12\update12.rpy:12247
translate schinese ep12_fcomp_round1_end_label_d898e33d:

    # "*{i}Bell rings{/i}*"
    "*{i}铃响{/i}*"

# episode12\update12.rpy:12248
translate schinese ep12_fcomp_round1_end_label_f4678edc:

    # ann "And there's the bell. Fighters go back to their corners."
    ann "铃响了，选手们回到各自的角落。"

# episode12\update12.rpy:12250
translate schinese ep12_fcomp_round1_end_label_34fb1398:

    # aud "*{i}Cheers{/i}*"
    aud "*{i}干杯{/i}*"

# episode12\update12.rpy:12251
translate schinese ep12_fcomp_round1_end_label_a19013c8:

    # dwy "Sit down."
    dwy "坐下。"

# episode12\update12.rpy:12254
translate schinese ep12_fcomp_round1_end_label_e0997ab2:

    # dwy "You're doing amazing. Don't let that leg kick bother you."
    dwy "你表现得太棒了。别让那条腿踢影响到你。"

# episode12\update12.rpy:12255
translate schinese ep12_fcomp_round1_end_label_550871aa:

    # dwy "He'll try to surprise you in the second round too. It's all that he's got."
