    zo "我一点都不怕我们得面对的任何挑战或麻烦。"

# episode12\update12.rpy:10849
translate schinese ep12_zoey_label_ddf86920:

    # mc "Neither am I."
    mc "我也不怕。"

# episode12\update12.rpy:10853
translate schinese ep12_zoey_label_bea6e776:

