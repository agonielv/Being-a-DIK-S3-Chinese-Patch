# episode12\update12.rpy:15188
translate schinese ep12_sally_end_label_e0e03dbb:

    # mc "Oh! Rich? That blonde guy?"
    mc "哦！Rich？那个金发男？"

# episode12\update12.rpy:15193
translate schinese ep12_sally_end_label_e1197215:

    # sy "Yes. His father owned this mansion."
    sy "对。这栋豪宅以前属于他父亲。"

# episode12\update12.rpy:15194
translate schinese ep12_sally_end_label_6e10f4e5:

    # sy "The tri-betas tried to plead to Rich for help, but the Alpha Nu Omegas laughed in their faces."
    sy "三贝塔试着求Rich帮忙，却被阿尔法·努·欧米伽当面嘲笑。"

# episode12\update12.rpy:15198
translate schinese ep12_sally_end_label_95a62743:

    # sy "They couldn't care less about what happened to the tri-betas."
    sy "他们根本不在乎tri-betas发生了什么。"

# episode12\update12.rpy:15200
translate schinese ep12_sally_end_label_1e516102:

    # sy "And then you guys came. Rusty's dad bought the mansion. And just like that, the tri-betas were vacated on short notice."
    sy "然后你们来了。Rusty他爸买了这栋房子。结果那些三贝塔就被赶出来了，而且是临时通知。"

# episode12\update12.rpy:15201
translate schinese ep12_sally_end_label_467f1181:

    # sy "They were ordered to leave, and everything inside the mansion was included in the purchase."
    sy "她们被勒令搬走，豪宅里的一切也都包含在交易中。"

# episode12\update12.rpy:15203
translate schinese ep12_sally_end_label_3cd78086:

    # sy "They were livid about it. They saw it as being kicked out by both the Alpha Nu Omegas and the DIKs."
    sy "她们气疯了，觉得自己同时被阿尔法·努·欧米伽和DIKs赶了出去。"

# episode12\update12.rpy:15205
translate schinese ep12_sally_end_label_2114707a:

    # sy "And now they were forced to live in dorms like commoners. What kind of a fraternity lives in dorms!?"
    sy "现在他们被迫和普通人一样住在宿舍里。什么玩意儿叫兄弟会还住宿舍？"

# episode12\update12.rpy:15206
translate schinese ep12_sally_end_label_399e6b98:

    # sy "But that was merely the start of their problems."
    sy "但这只是他们麻烦的开始。"

# episode12\update12.rpy:15207
translate schinese ep12_sally_end_label_ea3ad45c:

    # sy "And here comes the big one... And I swore to them that I'd never tell anyone about it."
    sy "这里才是大招……我发誓过不会告诉任何人这件事。"

# episode12\update12.rpy:15209
translate schinese ep12_sally_end_label_2224b803:

    # sy "But they have treated me like disposable waste, and now that you have shown me you guys aren't as bad as I thought..."
    sy "但他们把我当垃圾一样对待，现在你让我看到你们其实没我想象中那么糟糕……"

# episode12\update12.rpy:15210
translate schinese ep12_sally_end_label_546684e8:

    # sy "I have to tell you."
    sy "我必须告诉你。"

# episode12\update12.rpy:15212
translate schinese ep12_sally_end_label_70312b8a:

    # sy "But you have to promise me this stays between us. I'd be in so much trouble if it doesn't."
    sy "但你得答应我，这件事只能我们之间知道。如果传出去了，我可就麻烦大了。"

# episode12\update12.rpy:15213
translate schinese ep12_sally_end_label_89ea1dd5:

    # sy "And not just me... The tri-betas, too."
    sy "不只是我……还有tri-betas也一样。"

# episode12\update12.rpy:15215
translate schinese ep12_sally_end_label_fa8ebbb5:

    # mc "You're trusting me with a secret because you see me as a friend."
    mc "你把秘密告诉我，是因为你把我当朋友。"

# episode12\update12.rpy:15216
translate schinese ep12_sally_end_label_4e96897e:

    # mc "I'm not going to betray your trust. I'll put your best interest first, since that's what you're doing with the DIKs and me now."
    mc "我不会背叛你的信任。我会把你的利益放在第一位，因为现在你正把DIKs和我当成最重要的事来对待。"

# episode12\update12.rpy:15218
translate schinese ep12_sally_end_label_4e05fe49:

    # sy "Thank you..."
    sy "谢谢..."

# episode12\update12.rpy:15220
translate schinese ep12_sally_end_label_b840f334:

    # sy "It's all because of what's on your desk."
    sy "都是因为你桌上的东西。"

# episode12\update12.rpy:15222
translate schinese ep12_sally_end_label_5848414a:

    # mc "My desk?"
    mc "我的桌子？"

# episode12\update12.rpy:15226
translate schinese ep12_sally_end_label_9c22f7d8:

    # sy "It's because of this."
    sy "都是因为这个。"

# episode12\update12.rpy:15228
translate schinese ep12_sally_end_label_1838b9c4:

    # sy "The Pandora's box that caused all of it."
    sy "潘多拉的盒子，就是这一切的起因。"

# episode12\update12.rpy:15229
translate schinese ep12_sally_end_label_101ae418:

    # sy "Where did you find it?"
    sy "你是在哪儿找到的？"

# episode12\update12.rpy:15231
translate schinese ep12_sally_end_label_07c8a7c1:

    # mc "That box? I found it in here when I was cleaning up to make the room inhabitable."
    mc "那个盒子？我是在整理房间，把它弄得能住人的时候在这儿找到的。"

# episode12\update12.rpy:15232
translate schinese ep12_sally_end_label_b979d7d3:

    # mc "I put it aside because it struck me as something special. But I didn't think much more about it until later."
    mc "我把它放在一边，因为我觉得它挺特别的。但后来我才没怎么想它。"

# episode12\update12.rpy:15234
translate schinese ep12_sally_end_label_b609a455:

    # mc "And not that long ago, I opened it. But there's nothing inside of it, Sally. It's empty."
    mc "不久之前，我把它打开了。但里面什么都没有，Sally。它是空的。"

# episode12\update12.rpy:15236
translate schinese ep12_sally_end_label_ba1f09ef:

    # mc "And not that long ago, Derek opened it. But there's nothing inside of it, Sally. It's empty."
    mc "不久之前，Derek把它打开了。但里面什么都没有，Sally。空的。"

# episode12\update12.rpy:15240
translate schinese ep12_sally_end_label_e88e8d49:

    # sy "This is the tri-betas' best-kept secret. Not everyone of the tri-betas even knows of its existence."
    sy "这是tri-betas最保守的秘密。并不是所有tri-betas的人都知道它的存在。"

# episode12\update12.rpy:15242
translate schinese ep12_sally_end_label_ad8750f7:

    # sy "This box belonged to Duke, the tri-beta president before Magnar."
    sy "这个盒子是杜克的，他以前是三贝塔的主席，现在是Magnar的主席。"

# episode12\update12.rpy:15243
translate schinese ep12_sally_end_label_2cb5175b:

    # sy "And in it, he kept something so valuable and illegal that he feared the consequences if someone else found out about it."
    sy "里面放着一些价值连城又违法的东西，他生怕被人发现会惹上大麻烦。"

# episode12\update12.rpy:15246
translate schinese ep12_sally_end_label_cd808f29:

    # mc "What was in it?"
    mc "里面有什么？"

# episode12\update12.rpy:15248
translate schinese ep12_sally_end_label_72635641:

    # sy "That's the next part of the story..."
    sy "这就是故事的下一部分了..."

# episode12\update12.rpy:15251
translate schinese ep12_sally_end_label_5b906c0d:

    # sy "Duke wasn't like the other tri-betas. And he wasn't like any of the fraternity presidents you'd ever seen."
    sy "杜克跟其他兄弟会主席完全不一样，也跟tri-betas根本不是一路人。"

# episode12\update12.rpy:15252
translate schinese ep12_sally_end_label_6bc8f47d:

    # sy "He was this short and skinny guy, but still managed to rule the tri-betas with an iron hand."
    sy "他又矮又瘦，却还是用铁腕统治着整个三贝塔。"

# episode12\update12.rpy:15253
translate schinese ep12_sally_end_label_371ef502:

    # sy "And how?"
    sy "怎么个聪明法？"

# episode12\update12.rpy:15255
translate schinese ep12_sally_end_label_c0b4532c:

    # sy "Because he was the smartest tri-beta you'd ever seen."
    sy "因为他是你见过最聪明的三贝塔成员。"

# episode12\update12.rpy:15256
translate schinese ep12_sally_end_label_5e61de8b:

    # sy "And the other tri-betas admired Duke for his brilliance."
    sy "其他兄弟会成员也崇拜杜克的聪明才智。"

# episode12\update12.rpy:15258
translate schinese ep12_sally_end_label_acb131fc:

    # sy "And Magnar was his biggest admirer and suck-up."
    sy "Magnar则是他最狂热的崇拜者和马屁精。"

# episode12\update12.rpy:15260
translate schinese ep12_sally_end_label_3e10bb65:

    # sy "Duke would cockily describe himself as a big party guy. And whenever the tri-betas hosted a party, he'd be the first one trying to get laid."
    sy "杜克总是自吹自擂地说自己是个派对高手。每次tri-betas办派对，他都是第一个想上床的人。"

# episode12\update12.rpy:15261
translate schinese ep12_sally_end_label_efcd84fc:

    # sy "I have heard others describe him as a nerd with a filthy mind who could only get with girls because of his presidential title."
    sy "我听别人说他是个书呆子，脑子里满是下流想法，只能靠当学生会主席才能和女生上床。"

# episode12\update12.rpy:15263
translate schinese ep12_sally_end_label_946107c7:

    # sy "But mostly, Duke was known for his computer and technical skills."
    sy "但最出名的还是他的电脑和专业技术能力。"

# episode12\update12.rpy:15265
translate schinese ep12_sally_end_label_c705acce:

    # sy "Today, he's working as a lead programmer at a billion-dollar company in Silicon Valley."
    sy "今天，他正在硅谷一家价值数十亿美元的公司担任首席程序员。"

# episode12\update12.rpy:15267
translate schinese ep12_sally_end_label_cd0cab98:

    # sy "Duke graduated with the highest possible grades from B&R... but you wouldn't guess why."
    sy "杜克从B&R毕业时拿到了最高分……但你根本猜不到为什么。"

# episode12\update12.rpy:15271
translate schinese ep12_sally_end_label_e4877ece:

    # sy "By the time Duke graduated, Magnar had earned Duke's trust and friendship."
    sy "到杜克毕业的时候，Magnar已经赢得了杜克的信任和友谊。"

# episode12\update12.rpy:15272
translate schinese ep12_sally_end_label_1e03a023:

    # sy "Duke passed the presidential title and the puzzle box onto Magnar."
    sy "杜克把总统头衔和那个谜题盒子交给了Magnar。"

# episode12\update12.rpy:15273
translate schinese ep12_sally_end_label_57d6c4ed:

    # sy "Magnar was told to keep the box to himself and never to disclose its content or where he got it from to anyone."
    sy "Magnar被叮嘱要独自保管这个盒子，绝不能向任何人透露里面的东西，也不能说他是从哪儿得到的。"

# episode12\update12.rpy:15275
translate schinese ep12_sally_end_label_d245064b:

    # sy "Duke's one mistake during his time at B&R was thinking that Magnar would honor his wish."
    sy "杜克在B&R期间犯下的一个错误，就是以为Magnar会尊重他的愿望。"

# episode12\update12.rpy:15276
translate schinese ep12_sally_end_label_3d7d9424:

    # sy "After Magnar found out what was in the box, he saw the power he could wield."
    sy "在得知盒子里面是什么之后，他看到了自己能掌控的力量。"

# episode12\update12.rpy:15277
translate schinese ep12_sally_end_label_c50dab13:

    # sy "As if being the president of the fraternity wasn't good enough, he wanted to ensure that his fratmates would be completely loyal to him."
    sy "就像当上兄弟会主席还不够，他还想确保自己的兄弟们都绝对忠于他。"

# episode12\update12.rpy:15278
translate schinese ep12_sally_end_label_d1028e7d:

    # sy "To accomplish this, Magnar chose to let his closest friends in on it."
    sy "为了达成这个目的，Magnar决定让最亲近的朋友也知晓这件事。"

# episode12\update12.rpy:15280
translate schinese ep12_sally_end_label_ec7c496d:

    # sy "And when I got together with him, he let me in on its secrets, too."
    sy "当我和他在一起的时候，他也把我拉进了这个秘密。"

# episode12\update12.rpy:15282
translate schinese ep12_sally_end_label_117908f6:

    # sy "But there was a big problem..."
    sy "但有个大问题……"

# episode12\update12.rpy:15283
translate schinese ep12_sally_end_label_2824eae1:

    # sy "He had lost that box in this mansion."
    sy "他把那个盒子弄丢在这座宅子里了。"

# episode12\update12.rpy:15285
translate schinese ep12_sally_end_label_dbc8f8bf:

    # sy "He used to keep it in this room, on a bookshelf behind books."
    sy "他以前总把盒子藏在这个房间的书架后面，夹在书里。"

# episode12\update12.rpy:15287
translate schinese ep12_sally_end_label_82edeb55:

    # sy "Magnar was paranoid that someone would find it or that someone who knew about its existence would steal it, so he'd frequently change the hiding spot."
    sy "Magnar总是担心有人会发现它，或者那些知道它存在的人会偷走它，所以经常换地方藏起来。"

# episode12\update12.rpy:15288
translate schinese ep12_sally_end_label_8ac8df33:

    # sy "Never finding a perfect place for it."
    sy "从未找到一个完美的藏身处。"

# episode12\update12.rpy:15290
translate schinese ep12_sally_end_label_f25ac235:

    # sy "The day the tri-betas were evicted, they packed their belongings and left."
    sy "当三贝塔们被赶出去的那天，他们收拾了东西就离开了。"

# episode12\update12.rpy:15291
translate schinese ep12_sally_end_label_b9038172:

    # sy "But Magnar - that idiot - forgot to bring the box with him."
    sy "但Magnar——那个蠢货——忘记把盒子带走了。"

# episode12\update12.rpy:15293
translate schinese ep12_sally_end_label_cc47de45:

    # sy "When he realized his mistake, he needed to get back inside the mansion to get it."
    sy "他意识到犯错后，需要回到豪宅里把它拿出来。"

# episode12\update12.rpy:15294
translate schinese ep12_sally_end_label_57d84b98:

    # sy "But the DIKs had already moved in and wouldn't let him enter."
    sy "但DIKs已经搬进去了，不让他进去。"

# episode12\update12.rpy:15296
translate schinese ep12_sally_end_label_c7c65743:

    # sy "He pleaded to Rusty and Tommy to let him in for a minute or two, but they didn't trust his intentions and refused."
    sy "他恳求让Rusty和Tommy让他进去待几分钟，但他们不信他的意图，直接拒绝了。"

# episode12\update12.rpy:15298
translate schinese ep12_sally_end_label_1129866f:

    # sy "He thought he had lost the box, and he had to make peace with it."
    sy "他以为自己丢了那个箱子，只能认栽了。"

# episode12\update12.rpy:15301
translate schinese ep12_sally_end_label_7c8a8dbb:

    # mc "You have to tell me... What was in the box?"
    mc "你得告诉我……那个盒子里到底装了什么？"

# episode12\update12.rpy:15303
translate schinese ep12_sally_end_label_b08a9b4c:

    # sy "A USB stick."
    sy "U盘。"

# episode12\update12.rpy:15304
translate schinese ep12_sally_end_label_71a49424:

    # mc "A USB stick? That's it?"
    mc "U盘？就这么个东西？"

# episode12\update12.rpy:15305
translate schinese ep12_sally_end_label_e3cf9158:

    # sy "A golden USB stick with the entire database that B&R uses to generate their tests and exams."
    sy "一个金色的U盘，里面装着B&R用来生成考试和测验的全部数据库。"

# episode12\update12.rpy:15306
translate schinese ep12_sally_end_label_440f4346:

    # sy "It has the answers and questions to all the tests."
    sy "它里面装着所有考试的题目和答案。"

# episode12\update12.rpy:15308
translate schinese ep12_sally_end_label_6d0cccd8:

    # sy "And I don't know if you're aware, but B&R barely updates those databases."
    sy "而且我还不知道你有没有意识到，B&R几乎不更新那些数据库。"

# episode12\update12.rpy:15309
translate schinese ep12_sally_end_label_4b5696ca:

    # sy "Why waste time and money on changing perfect questions and answers to classes that have the same curriculum?"
    sy "为什么还要花时间和钱去改写那些完美的题目和答案，给那些课程大纲一模一样的班级呢？"

# episode12\update12.rpy:15310
translate schinese ep12_sally_end_label_79998426:

    # sy "They can reuse everything and create new tests from a new mix of questions and answers. It saves them both time and money."
    sy "他们可以重复使用所有内容，再从问题和答案的新组合中创建新的试卷。这样既省时又省钱。"

# episode12\update12.rpy:15311
translate schinese ep12_sally_end_label_2d17fda5:

    # sy "And that USB stick held the key to getting perfect scores on every test. You could graduate as an A student with ease."
    sy "而这根U盘就是拿到每场考试满分的关键。你轻轻松松就能毕业，成为成绩顶尖的A级学生。"

# episode12\update12.rpy:15313
translate schinese ep12_sally_end_label_f2be5cf7:

    # sy "Just like Duke."
    sy "就像杜克一样。"

# episode12\update12.rpy:15314
translate schinese ep12_sally_end_label_adb7d4b4:

    # sy "Duke managed to access the B&R database and downloaded everything onto that USB stick."
    sy "杜克成功入侵了B&R的数据库，把所有东西都拷贝到了那个U盘里。"

# episode12\update12.rpy:15316
translate schinese ep12_sally_end_label_32949731:

    # mc "Holy shit... You weren't kidding. That's huge..."
    mc "我操……你没开玩笑，真的好大……"

# episode12\update12.rpy:15318
translate schinese ep12_sally_end_label_2c3518b2:

    # sy "I know!"
    sy "我知道！"

# episode12\update12.rpy:15319
translate schinese ep12_sally_end_label_af4edafd:

    # sy "So much for Duke's brilliant mind."
    sy "所以杜克那聪明的脑袋也就到此为止了。"

# episode12\update12.rpy:15320
translate schinese ep12_sally_end_label_a7664227:

    # sy "And Magnar followed in Duke's footsteps, relying on the USB stick for his college classes."
    sy "并且Magnar也踩着杜克的脚印，用那根U盘应付他的大学课程。"

# episode12\update12.rpy:15322
translate schinese ep12_sally_end_label_b495d575:

    # sy "Magnar had printed out questions and answers to the classes he was taking at the time he lost the USB stick."
    sy "Magnar当时丢了U盘，就打印了那几门课的题目和答案。"

# episode12\update12.rpy:15323
translate schinese ep12_sally_end_label_2c23c341:

    # sy "But after he passed those classes, he couldn't get the answers for his next semester because he didn't have the box."
    sy "但等他过了那些课后，下一学期就没法再拿到答案了，因为他已经没那个盒子了。"

# episode12\update12.rpy:15325
translate schinese ep12_sally_end_label_bae428a1:

    # sy "And that's when reality hit him. Magnar wasn't an A student. He wasn't THAT smart."
    sy "现实终于击中了他。Magnar根本不是个A级学生，他根本没那么聪明。"

# episode12\update12.rpy:15326
translate schinese ep12_sally_end_label_4728a9f7:

    # sy "He needed that database to excel, and he felt the pressure."
    sy "他需要那个数据库才能脱颖而出，他感到压力很大。"

# episode12\update12.rpy:15328
translate schinese ep12_sally_end_label_29c409b0:

    # sy "Magnar has tried to rebuild the knowledge of the USB stick by buying old tests and notes from students."
    sy "Magnar 试图通过从学生那里买旧试卷和笔记来重建U盘里的知识。"

# episode12\update12.rpy:15329
translate schinese ep12_sally_end_label_826169e7:

    # sy "He also did that to stay in charge and keep his fratmates' trust."
    sy "他这么做也是为了保持领导地位，不辜负兄弟会兄弟们的信任。"

# episode12\update12.rpy:15330
translate schinese ep12_sally_end_label_891aad6b:

    # sy "But whatever he could get from students would never measure up to the B&R database."
    sy "但不管他从学生那儿得到什么，都比不上B&R数据库。"

# episode12\update12.rpy:15332
translate schinese ep12_sally_end_label_46817a32:

    # sy "Magnar reached out to Duke, but he wouldn't help him retrieve the database. And the USB stick had the only copy of it."
    sy "Magnar联系了杜克，但他不肯帮忙找回数据库。而那个U盘里存着唯一的副本。"

# episode12\update12.rpy:15334
translate schinese ep12_sally_end_label_a365beb7:

    # sy "Enter me..."
    sy "进来吧..."

# episode12\update12.rpy:15335
translate schinese ep12_sally_end_label_d547f870:

    # sy "Magnar gave me what he had printed for my first semester here. And I, too, aced my classes."
    sy "Magnar 给了我他打印的第一学期的资料。我也没辜负他，考试全拿了高分。"

# episode12\update12.rpy:15337
translate schinese ep12_sally_end_label_47c64c36:

    # sy "And I know he's helped new fratmates pass their tests in the same way, too."
    sy "而且我知道他也是用同样的方法帮新入会的兄弟们通过考试的。"

# episode12\update12.rpy:15338
translate schinese ep12_sally_end_label_f962fa5b:

    # sy "He has enticed them with perfect grades in exchange for loyalty - all to keep ruling the tri-betas the way he wants."
    sy "他用满分成绩引诱她们效忠，好继续随心所欲地控制三贝塔。"

# episode12\update12.rpy:15339
translate schinese ep12_sally_end_label_7bd742c7:

    # sy "If he has dirt on everyone in the frat, they must obey him. He only accepted new pledges if he sensed that a member could be manipulated."
    sy "如果他手里有兄弟会每个人的把柄，他们就必须听他的。他只接受那些他觉得能被操控的新成员。"

# episode12\update12.rpy:15341
translate schinese ep12_sally_end_label_ff4359b3:

    # sy "Magnar got the idea to use me to get the box back."
    sy "Magnar打算利用我拿回那个盒子。"

# episode12\update12.rpy:15343
translate schinese ep12_sally_end_label_88c6d534:

    # sy "I started partying with the DIKs, and for the first time since they left the mansion, the tri-betas had someone on the inside of it again."
    sy "我开始参加DIKs的派对。三贝塔搬离豪宅后，终于又有了一个能从内部打探消息的人。"

# episode12\update12.rpy:15345
translate schinese ep12_sally_end_label_379c9658:

    # sy "Imagine my surprise when I walked into this room and saw heavy bookshelves on the floor and an uninhabitable mess."
    sy "想象我走进这间屋子时的惊讶，地上堆着满是书的书架，整个地方糟得没法住人。"

# episode12\update12.rpy:15347
translate schinese ep12_sally_end_label_6cb523de:

    # sy "The room reeked of piss, and trash littered every corner."
    sy "这房间臭得要命，到处都是垃圾。"

# episode12\update12.rpy:15348
translate schinese ep12_sally_end_label_18171b66:

    # mc "Yeah, I remember how it looked."
    mc "嗯，我记得那地方是什么样。"

# episode12\update12.rpy:15350
translate schinese ep12_sally_end_label_7b7eed20:

    # sy "I couldn't find the damned box in here, and I wasn't strong enough to move shelves around."
    sy "我在这儿找不到那个该死的箱子，而且也没力气搬动书架。"

# episode12\update12.rpy:15351
translate schinese ep12_sally_end_label_4d517e25:

    # sy "And the bookshelves that were still standing had so many books in them that it would have taken me hours to scour through them without drawing suspicion."
    sy "而那些还能站得住的书架上堆满了书，光是翻一遍不引起怀疑就得花好几个小时。"

# episode12\update12.rpy:15353
translate schinese ep12_sally_end_label_27ff257a:

    # sy "I attempted it multiple times without luck."
    sy "我试了好几次都没成功。"

# episode12\update12.rpy:15354
translate schinese ep12_sally_end_label_e99ae7ff:

    # sy "Magnar started suspecting that you guys had already found the box..."
    sy "Magnar开始怀疑你们早就找到了那个箱子……"

# episode12\update12.rpy:15356
translate schinese ep12_sally_end_label_6f8adf35:

    # sy "And that's when he wanted access to any computer you had to check for himself."
    sy "就在那时，他想要查看你们手头的电脑自己确认一下。"

# episode12\update12.rpy:15357
translate schinese ep12_sally_end_label_e2b3343b:

    # sy "A tall order... But after some digging, I found out that you guys had a laptop and were sharing and synchronizing files on your phones."
    sy "这任务很难……不过经过调查，我发现你们有台笔记本电脑，还会在手机之间共享和同步文件。"

# episode12\update12.rpy:15359
translate schinese ep12_sally_end_label_1afa0dcc:

    # sy "Magnar told me to get hold of a phone by any means necessary."
    sy "我被叫去想办法搞到一部手机。"

# episode12\update12.rpy:15361
translate schinese ep12_sally_end_label_418a31bd:

    # sy "And I did..."
    sy "而且我确实这么做了..."

# episode12\update12.rpy:15366
translate schinese ep12_sally_end_label_cc79f79f:

    # sy "At the start of this semester, you guys had a party, and I hooked up with Jamie."
    sy "这个学期一开始，你们搞了个派对，我跟Jamie上了。"

# episode12\update12.rpy:15367
translate schinese ep12_sally_end_label_5d2702cb:

    # sy "He was wasted. He was the perfect target."
    sy "他喝得烂醉，是完美的目标。"

# episode12\update12.rpy:15369
translate schinese ep12_sally_end_label_7e642c65:

    # sy "I saw him fiddle with his phone and figured out how he opened it."
    sy "我看到他摆弄手机，猜到了他是怎么打开它的。"

# episode12\update12.rpy:15370
translate schinese ep12_sally_end_label_4cdb3194:

    # sy "4321. Bah! What an original passcode."
    sy "4321. 哼！这密码也太普通了吧。"

# episode12\update12.rpy:15372
translate schinese ep12_sally_end_label_f6f45582:

    # sy "After he had passed out, I left with his phone."
    sy "在他醉倒之后，我带着他的手机离开了。"

# episode12\update12.rpy:15374
translate schinese ep12_sally_end_label_ba51b9c4:

    # sy "When I told Magnar what I had done to get the phone, he was furious."
    sy "当我告诉Magnar我怎么拿到那部手机时，他气得暴跳如雷。"

# episode12\update12.rpy:15376
translate schinese ep12_sally_end_label_1b60bbcc:

    # sy "He called me a cheater and a whore. But he had told me to do anything it took, and I had."
    sy "他骂我是作弊者和妓女。可他明明说过，为了成功可以不择手段，而我照做了。"

# episode12\update12.rpy:15378
translate schinese ep12_sally_end_label_d5193262:

    # sy "Magnar browsed Jamie's phone and extracted all the files he could access from the DIKs' PinkCloud account."
    sy "Magnar翻看了Jamie的手机，把他能从DIKs的PinkCloud账户访问到的文件全都提取了出来。"

# episode12\update12.rpy:15379
translate schinese ep12_sally_end_label_1d181fe9:

    # sy "And he kept monitoring it for any activity, too. But he never found a trace of the database."
    sy "他还一直在监控着它，看有没有什么动静。但什么痕迹都没找到。"

# episode12\update12.rpy:15381
translate schinese ep12_sally_end_label_f1db22b3:

    # sy "He told me I had to retrieve the laptop, too. But I could sense it on him..."
    sy "他让我也把笔记本电脑拿回来。但我能感觉到他心里其实……"

# episode12\update12.rpy:15382
translate schinese ep12_sally_end_label_72cfba71:

    # sy "He detested me for what I had done with Jamie."
    sy "他恨我，因为我跟Jamie干了那些事。"

# episode12\update12.rpy:15384
translate schinese ep12_sally_end_label_a6f07ad4:

    # sy "And little did I know... He used what he found on Jamie's phone to get back at you guys."
    sy "我当时根本不知道……他利用从Jamie手机里找到的东西报复你们。"

# episode12\update12.rpy:15386
translate schinese ep12_sally_end_label_b0c1b978:

    # sy "He sent the tri-alphas pictures of DIKs having sex with one of their girls."
    sy "他把三阿尔法们的照片发了出去，照片里DIKs正和他们其中一个女孩发生关系。"

# episode12\update12.rpy:15388
translate schinese ep12_sally_end_label_3c5b7d30:

    # sy "And along with those, he also sent pictures Ron had snapped of an unexposed gay jock couple as a threat."
    sy "并且他还附上了他拍下的、一个没被曝光的同性啦啦队情侣的照片作为威胁。"

# episode12\update12.rpy:15390
translate schinese ep12_sally_end_label_1a0bb0c3:

    # sy "Together with the DIKs' photos, he hoped that it would further pin the blame on you guys."
    sy "连同DIKs的照片，他希望这能进一步把责任推到你们头上。"

# episode12\update12.rpy:15392
translate schinese ep12_sally_end_label_2fb42b37:

    # mc "It was Magnar who was behind those letters!? You can't be serious?"
    mc "那些信居然是Magnar搞的！？你不是在开玩笑吧？"

# episode12\update12.rpy:15393
translate schinese ep12_sally_end_label_3af9f47c:

    # mc "I've been trying to find out who the hell it was."
    mc "我一直在查是谁干的。"

# episode12\update12.rpy:15395
translate schinese ep12_sally_end_label_a83398b2:

    # sy "I know. And it wasn't just Magnar, by the way. He had help from Bert and Ron."
    sy "我知道。而且这事不只是Magnar干的，顺便说一句，他还有Bert和Ron帮忙。"

# episode12\update12.rpy:15396
translate schinese ep12_sally_end_label_59424ce7:

    # sy "Bert and Ron were also privy to Pandora's box. And they were just as motivated as Magnar to get it back. Anyone loyal to Magnar would be."
    sy "Bert和Ron也知道了潘多拉的盒子。他们和Magnar一样，都急着把它拿回来。任何忠于Magnar的人也一样。"

# episode12\update12.rpy:15398
translate schinese ep12_sally_end_label_4b8aa0db:

    # sy "Ron had been sneaking around the gym and taking pictures."
    sy "Ron一直在健身房偷偷摸摸地拍照。"

# episode12\update12.rpy:15399
translate schinese ep12_sally_end_label_744321fc:

    # sy "At first, it was for his own perverted reasons, but he later figured out he could use them to blackmail the DIKs."
    sy "起初是为了他自己的变态目的，后来他才意识到可以拿这些来勒索DIKs。"

# episode12\update12.rpy:15400
translate schinese ep12_sally_end_label_b432e2c9:

    # sy "He hoped to snap a picture of some naked girl and blame the DIKs, but he ended up getting something much better."
    sy "他原本想拍个裸女照片栽赃给DIKs，结果却意外得到了更劲爆的东西。"

# episode12\update12.rpy:15402
translate schinese ep12_sally_end_label_2cf28054:

    # mc "Cathy?"
    mc "Cathy？"

# episode12\update12.rpy:15403
translate schinese ep12_sally_end_label_c172bd12:

    # sy "Yes."
    sy "是的。"

# episode12\update12.rpy:15404
translate schinese ep12_sally_end_label_7647780e:

    # sy "I wasn't in on the blackmailing. I want to make that clear..."
    sy "我没参与勒索的事。我得说明白……"

# episode12\update12.rpy:15406
translate schinese ep12_sally_end_label_c609b12a:

    # mc "So it was Magnar, Ron, and Bert?"
    mc "所以是Magnar、Ron和Bert？"

# episode12\update12.rpy:15408
translate schinese ep12_sally_end_label_a81a3035:

    # sy "They were all ok with it."
    sy "他们都没意见。"

# episode12\update12.rpy:15410
translate schinese ep12_sally_end_label_284fd91e:

    # sy "During one of your Hell Week parties, I finally got the opportunity we had been waiting for."
    sy "在一次地狱周派对上，我终于等到了我们一直在等的机会。"

# episode12\update12.rpy:15411
translate schinese ep12_sally_end_label_bf1f8822:

    # sy "I found the laptop in Rusty's room."
    sy "我在Rusty的房间里找到了那台笔记本电脑。"

# episode12\update12.rpy:15413
translate schinese ep12_sally_end_label_876e1a23:

    # sy "I walked in there, and I saw Nick using it."
    sy "我一推门进去，就看见Nick在用那台电脑。"

# episode12\update12.rpy:15415
translate schinese ep12_sally_end_label_c7ca9b24:

    # mc "Nick was using it!?"
    mc "Nick在用它！？"

# episode12\update12.rpy:15416
translate schinese ep12_sally_end_label_31ea315f:

    # sy "Yeah. He was watching a homemade sextape of Heather and Tommy, and he got flustered when I caught him."
    sy "对。他当时正在看Heather和Tommy的自制性爱录像，被我撞见后一下子慌了。"

# episode12\update12.rpy:15418
translate schinese ep12_sally_end_label_155bf7a0:

    # sy "He closed the video, but before he could shut down the laptop, I told him I didn't feel comfortable knowing he did that."
    sy "他关掉了视频，但在我让他关机之前，我就告诉他我不舒服知道他做了这种事。"

# episode12\update12.rpy:15419
translate schinese ep12_sally_end_label_fbe89298:

    # sy "I told him that Heather was upstairs and that I would talk to her."
    sy "我告诉他 Heather 在楼上，说我要跟她谈谈。"

# episode12\update12.rpy:15421
translate schinese ep12_sally_end_label_2487a59a:

    # sy "He pulled me aside into the kitchen, explained he had accidentally viewed the video, and begged me not to tell Heather."
    sy "他把我拉到厨房，解释说他不小心看到了视频，然后求我别告诉Heather。"

# episode12\update12.rpy:15422
translate schinese ep12_sally_end_label_5ee14316:

    # sy "Nick's face was pale... I knew I had something good on him, but I didn't want to take it too far."
    sy "Nick的脸色苍白……我知道我手里有把柄，但不想把事闹大。"

# episode12\update12.rpy:15424
translate schinese ep12_sally_end_label_f0fe567d:

    # sy "I calmed him down, said I wouldn't tell anyone about it, and he thanked me before going up to his room."
    sy "我安抚了他，说不会告诉任何人，他谢了我，然后上楼回自己房间去了。"

# episode12\update12.rpy:15425
translate schinese ep12_sally_end_label_7c100b5a:

    # sy "Walking with a hardon, I figured he was going to finish himself off."
    sy "带着硬核，我想他大概是要自己解决了。"

# episode12\update12.rpy:15427
translate schinese ep12_sally_end_label_85573474:

    # sy "I saw the opportunity, and I seized it."
    sy "我抓住了机会，我立刻行动了。"

# episode12\update12.rpy:15429
translate schinese ep12_sally_end_label_dbf8a48b:

    # sy "I texted Magnar to meet me outside the library, and I went there with the laptop that I had put in a bag."
    sy "我给Magnar发了消息约在图书馆外见面，我带着装在包里的笔记本电脑去了那里。"

# episode12\update12.rpy:15431
translate schinese ep12_sally_end_label_faa06e1e:

    # sy "I let Magnar in, and while I guarded the door, he did his thing."
    sy "我让他进来了，我守着门，他就在里面干他的事。"

# episode12\update12.rpy:15433
translate schinese ep12_sally_end_label_5f805cdc:

    # sy "But he still couldn't find any trace of the database."
    sy "但他还是找不到任何数据库的踪迹。"

# episode12\update12.rpy:15435
translate schinese ep12_sally_end_label_9bf70208:

    # sy "Frantically, he started looking around the room for the box."
    sy "他疯狂地在房间里四处翻找那个箱子。"

# episode12\update12.rpy:15436
translate schinese ep12_sally_end_label_0e70dacb:

    # sy "He commanded me to help him find it, but I was getting nervous that someone would show up."
    sy "他让我帮忙找，但我开始担心有人会来。"

# episode12\update12.rpy:15438
translate schinese ep12_sally_end_label_8b6f1ffd:

    # sy "Yet again... No box was found. But before Magnar left, he wanted to leave the DIKs with a surprise."
    sy "又一次……没找到那个箱子。但在他离开之前，他还想给DIKs留个惊喜。"

# episode12\update12.rpy:15439
translate schinese ep12_sally_end_label_c1362a20:

    # sy "He transferred the picture of Cathy to the laptop and posted it on Rooster using your frat account."
    sy "他把Cathy的照片传到了笔记本电脑上，用你的兄弟会账号发到了Rooster。"

# episode12\update12.rpy:15441
translate schinese ep12_sally_end_label_6134e0af:

    # sy "Then he left me there with the laptop!"
    sy "然后他就把我一个人留在那儿，拿着笔记本电脑！"

# episode12\update12.rpy:15442
translate schinese ep12_sally_end_label_66bb86b1:

    # sy "I was stunned when I saw what he had posted, and I started to panic."
    sy "我看到他发的东西时愣住了，然后就开始慌了。"

# episode12\update12.rpy:15444
translate schinese ep12_sally_end_label_abf39ae4:

    # sy "I exited the library and put the bag down. I don't even remember what I was doing when trying to cover everything up."
    sy "我走出图书馆，把包放下。我甚至不记得自己当时在忙什么，就为了掩盖一切。"

# episode12\update12.rpy:15445
translate schinese ep12_sally_end_label_43a78548:

    # sy "It was too risky to return anything now."
    sy "现在把东西还回去太危险了。"

# episode12\update12.rpy:15447
translate schinese ep12_sally_end_label_452fed04:

    # sy "I saw people around me react to the cluck, so I locked myself inside the bathroom to hide."
    sy "我看到周围的人对那张照片反应很大，于是我锁了自己在厕所里躲起来。"

# episode12\update12.rpy:15449
translate schinese ep12_sally_end_label_4c795cc0:

    # sy "It wasn't the best move. But what choice did I have?"
    sy "这招可不太妙。但当时我也没别的选择。"

# episode12\update12.rpy:15450
translate schinese ep12_sally_end_label_31e5bff7:

    # sy "I could hear people through the door, talking about the cluck. I heard Rusty run around and tell people to help him look for the laptop."
    sy "我能听见门外的人在议论那条Cluck，还听见Rusty到处跑，叫人帮忙找笔记本电脑。"

# episode12\update12.rpy:15452
translate schinese ep12_sally_end_label_cd32293f:

    # sy "I figured I'd ride the storm out in the bathroom."
    sy "我决定在厕所里躲一躲，等这阵风过去。"

# episode12\update12.rpy:15453
translate schinese ep12_sally_end_label_db83c264:

    # sy "But people outside needed to use the bathroom too."
    sy "但外面的人也需要上厕所。"

# episode12\update12.rpy:15455
translate schinese ep12_sally_end_label_ff82bbec:

    # sy "Eventually, I left the bathroom. I told the girls waiting in line that I was feeling ill."
    sy "最后我还是离开了洗手间，我告诉排队的女生们我感觉不太舒服。"

# episode12\update12.rpy:15456
translate schinese ep12_sally_end_label_080c64a1:

    # sy "And then I quietly left the party..."
    sy "然后我悄悄离开了派对……"

# episode12\update12.rpy:15458
translate schinese ep12_sally_end_label_c1f62cc1:

    # sy "Magnar had betrayed me by doing what he did."
    sy "Magnar背叛了我，做了他该做的事。"

# episode12\update12.rpy:15460
translate schinese ep12_sally_end_label_4800d8d9:

    # sy "I confronted him about it, but he tried to justify it."
    sy "我质问他这件事，但他试图为自己的行为找借口。"

# episode12\update12.rpy:15462
translate schinese ep12_sally_end_label_a150a049:

    # sy "Our relationship took a turn for the worse."
    sy "我们的关系变得越来越糟了。"

# episode12\update12.rpy:15463
translate schinese ep12_sally_end_label_8a576578:

    # sy "We tried to move past everything, but it didn't feel the same as before, and we fought more than usual."
    sy "我们试着把过去的事都抛在脑后，但感觉再也回不到从前了，争吵也比以前更频繁了。"

# episode12\update12.rpy:15465
translate schinese ep12_sally_end_label_03c21971:

    # sy "I thought that was it for the box. I thought that he had given up on it."
    sy "我以为那件事就到此为止了。我以为他放弃了。"

# episode12\update12.rpy:15466
translate schinese ep12_sally_end_label_00f5bfd9:

    # sy "But then something happened to you guys."
    sy "但然后你们身上发生了点事。"

# episode12\update12.rpy:15468
translate schinese ep12_sally_end_label_b50a79cd:

    # sy "The tri-alphas broke into your home and ruined it."
    sy "三角兄弟会的人闯进了你们家，把地方毁了。"

# episode12\update12.rpy:15470
translate schinese ep12_sally_end_label_23b1755e:

    # sy "After Magnar got wind of it, he watched you guys closely. He watched you empty the mansion of ruined furniture."
    sy "在得知这件事后，他一直暗中盯着你们。他看着你们把豪宅里的破烂家具都搬空了。"

# episode12\update12.rpy:15471
translate schinese ep12_sally_end_label_6d48f8bc:

    # sy "And maybe even...ruined bookshelves..."
    sy "说不定……连书架都毁了……"

# episode12\update12.rpy:15473
translate schinese ep12_sally_end_label_5acaaefb:

    # sy "At night, he came here to rummage through the trash and the container you put behind the mansion."
    sy "夜里，他来这里翻垃圾和你藏在庄园后面的容器。"

# episode12\update12.rpy:15475
translate schinese ep12_sally_end_label_2e768b37:

    # sy "He thought that he could enter through the broken glass, but you had already moved into the room."
    sy "他以为能从碎玻璃那里溜进来，但你已经搬进房间了。"

# episode12\update12.rpy:15477
translate schinese ep12_sally_end_label_0644ab9a:

    # sy "He didn't find the box outside among the debris..."
    sy "他没在废墟外面找到那个箱子……"

# episode12\update12.rpy:15479
translate schinese ep12_sally_end_label_b56378b4:

    # sy "After you got the windows fixed, he looked inside and saw how neat the room was."
    sy "你们把窗户修好后，他探头进去，看到房间收拾得整整齐齐。"

# episode12\update12.rpy:15480
translate schinese ep12_sally_end_label_bb6fca4b:

    # sy "If you hadn't already thrown the box in the dumpster he had scoured, it had to be in your room."
    sy "如果你还没把那个盒子扔进垃圾桶，他肯定是在你房间里。"

# episode12\update12.rpy:15481
translate schinese ep12_sally_end_label_7704e369:

    # sy "You must have found it by now, and who would throw away such a mesmerizing box?"
    sy "你肯定已经找到了，谁会扔掉这样一个迷人的箱子呢？"

# episode12\update12.rpy:15482
translate schinese ep12_sally_end_label_e5b3ec26:

    # sy "He got new hope for it..."
    sy "他重新燃起了希望……"

# episode12\update12.rpy:15484
translate schinese ep12_sally_end_label_f614e39e:

    # sy "He asked me to help him again, but I refused. I didn't want him to use me like that anymore."
    sy "他让我再帮他一次，但我拒绝了。我不想再被他这样利用了。"

# episode12\update12.rpy:15486
translate schinese ep12_sally_end_label_ab1a7155:

    # sy "I almost got caught last time, and I would have been blamed for everything..."
    sy "我上次差点被抓住，到时候一切责任都会算在我头上……"

# episode12\update12.rpy:15488
translate schinese ep12_sally_end_label_fb7f66b5:

    # sy "After he failed to convince me... He broke up with me."
    sy "他没能说服我之后……他跟我分手了。"

# episode12\update12.rpy:15489
translate schinese ep12_sally_end_label_2c301645:

    # sy "That was what I was to him... The means to an end."
    sy "这就是我对他而言的……达成目的的手段。"

# episode12\update12.rpy:15490
translate schinese ep12_sally_end_label_ed49de53:

    # sy "And when the tool is broken, you discard it and get a new one."
    sy "当工具坏了，你就扔掉它，换一个。"

# episode12\update12.rpy:15492
translate schinese ep12_sally_end_label_3abf5ace:

    # sy "Without my help, I thought he wouldn't try it again."
    sy "没有我的帮忙，我以为他不会再试了。"

# episode12\update12.rpy:15493
translate schinese ep12_sally_end_label_512b30a9:

    # sy "But I didn't give him enough credit."
    sy "但我低估了他。"

# episode12\update12.rpy:15495
translate schinese ep12_sally_end_label_e50918ee:

    # sy "Halloween provided the perfect opportunity."
    sy "万圣节给了我们完美的机会。"

# episode12\update12.rpy:15501
translate schinese ep12_sally_end_label_c8db1e7d:

    # sy "With the costumes, no one would question why Ron and Magnar were at your party."
    sy "穿着戏服，没人会怀疑为什么Ron和Magnar会出现在你的派对上。"

# episode12\update12.rpy:15503
translate schinese ep12_sally_end_label_d39d7f88:

    # sy "But your party was too crowded... Getting into your room without anyone noticing proved hard..."
    sy "但你家派对人太多……想在没人注意的情况下进到你房间可不容易……"

# episode12\update12.rpy:15505
translate schinese ep12_sally_end_label_f4625808:

    # sy "Especially since people came and went to have their pictures taken."
    sy "尤其是因为人们来来往往拍照。"

# episode12\update12.rpy:15507
translate schinese ep12_sally_end_label_62e64a46:

    # sy "I recognized Magnar's and Ron's costumes from LARPing together with them, and I confronted them."
    sy "我认出了Magnar和Ron的装扮，我们之前一起玩过真人角色扮演，我上去跟他们对峙了。"

# episode12\update12.rpy:15509
translate schinese ep12_sally_end_label_c8b65b0e:

    # sy "Magnar told Ron to hit the lights, and I tried talking Magnar out of doing something stupid."
    sy "Magnar让Ron关灯，我试图劝Magnar别干傻事。"

# episode12\update12.rpy:15514
translate schinese ep12_sally_end_label_3b415871:

    # sy "But Ron, he went for it."
    sy "但你，你还是上了。"

# episode12\update12.rpy:15519
translate schinese ep12_sally_end_label_39a27eae:

    # sy "Magnar couldn't be reasoned with."
    sy "Magnar根本听不进去。"

# episode12\update12.rpy:15521
translate schinese ep12_sally_end_label_217f35c7:

    # sy "The moment the lights went out..."
    sy "灯光一黑，我就知道事情要出岔子了。"

# episode12\update12.rpy:15526
translate schinese ep12_sally_end_label_e41cda29:

    # sy "He went into your room to search for the box."
    sy "他冲进你房间去找那个盒子。"

# episode12\update12.rpy:15528
translate schinese ep12_sally_end_label_7ea342c2:

    # sy "I went after him, trying to stop him as he rummaged around."
    sy "我追了上去，想拦住他，他正翻来翻去地找东西。"

# episode12\update12.rpy:15530
translate schinese ep12_sally_end_label_5132cd4c:

    # sy "But he was obsessed... Almost failing at the midterms got to him. He needed that box!"
    sy "但他沉迷其中……期中考试差点挂掉，也让他更疯狂了。他需要那个盒子！"

# episode12\update12.rpy:15532
translate schinese ep12_sally_end_label_54bea56a:

    # sy "And he found it..."
    sy "他找到了……"

# episode12\update12.rpy:15533
translate schinese ep12_sally_end_label_14de3a1b:

    # sy "...proudly displayed on your desk. It was like a gift waiting to be unwrapped."
    sy "……骄傲地摆放在你的书桌上。就像一份等待拆开的礼物。"

# episode12\update12.rpy:15535
translate schinese ep12_sally_end_label_c7c615ef:

    # sy "I couldn't believe my eyes. I had heard him talk about that box for so long that I thought it was a myth."
    sy "我简直不敢相信自己的眼睛。我听他讲了那么久那个盒子，还以为只是个传说。"

# episode12\update12.rpy:15536
translate schinese ep12_sally_end_label_287575eb:

    # sy "But he opened it... And there it was."
    sy "但他打开了……就在那里。"

# episode12\update12.rpy:15538
translate schinese ep12_sally_end_label_e7cd5c24:

    # sy "The golden USB stick. Excalibus, as Magnar likes to call it."
    sy "金色的U盘。Magnar喜欢叫它“Excalibus”，就像把“Excalibur”和“USB”玩了个文字游戏。"

# episode12\update12.rpy:15539
translate schinese ep12_sally_end_label_0d735e28:

    # mc "Do you mean Excalibur? Like the legendary sword?"
    mc "你是指亚瑟王的王者之剑？像那种传说中的宝剑？"

# episode12\update12.rpy:15541
translate schinese ep12_sally_end_label_e6194b50:

    # sy "No. Excalibus, as in a play on the word Excalibur and the word bus in USB. It's a nerd thing..."
    sy "不，是“Excalibus”。这是把“Excalibur”和USB里的“bus”拼在一起的双关，就是个宅男梗……"

# episode12\update12.rpy:15543
translate schinese ep12_sally_end_label_8685f31c:

    # sy "Magnar put the box back and left with Ron and the USB stick before the lights came back on."
    sy "Magnar把盒子放回去，和Ron一起带着那个U盘离开了，灯光重新亮起之前他们就走了。"

# episode12\update12.rpy:15545
translate schinese ep12_sally_end_label_58aa900d:

    # sy "And me... I was too drunk to do anything about it."
    sy "而我……我喝得太多了，什么都做不了。"

# episode12\update12.rpy:15547
translate schinese ep12_sally_end_label_d91bf805:

    # sy "They are back to using the USB stick again. And they wouldn't let me have any of the answers."
    sy "他们又开始用那个U盘了。而且他们根本不愿意分我任何答案。"

# episode12\update12.rpy:15548
translate schinese ep12_sally_end_label_c240a95c:

    # sy "They shut me out completely."
    sy "他们完全把我排除在外。"

# episode12\update12.rpy:15549
translate schinese ep12_sally_end_label_1a6f02b1:

    # sy "I bet they passed the finals with flying colors... But not me."
    sy "我敢打赌他们考试肯定考得很好……但没我什么事。"

# episode12\update12.rpy:15551
translate schinese ep12_sally_end_label_2f452b41:

    # sy "They couldn't even throw me some scraps after what I did for them."
    sy "他们连我一点残羹冷炙都不给我。"

# episode12\update12.rpy:15552
translate schinese ep12_sally_end_label_2b127f19:

    # sy "Bert was the only one I could almost reason with."
    sy "Bert是我唯一能勉强说上话的人。"

# episode12\update12.rpy:15553
translate schinese ep12_sally_end_label_29138108:

    # sy "He said he understood me, but that his hands were tied."
    sy "他说他理解我，但他的手被捆住了。"

# episode12\update12.rpy:15555
translate schinese ep12_sally_end_label_9d669bf6:

    # sy "And Bert told me that after the other frats all got what's coming to them, he'd try to get Magnar to help me again."
    sy "而且Bert告诉我，等其他兄弟会都尝到苦头之后，他会试着再次拉拢Magnar帮我。"

# episode12\update12.rpy:15556
translate schinese ep12_sally_end_label_f875d752:

    # sy "And that's when I realized that the blackmailing wouldn't stop, even though they got Excalibus back."
    sy "就在这时我才意识到，就算他们夺回了Excalibus，勒索也不会停止。"

# episode12\update12.rpy:15558
translate schinese ep12_sally_end_label_a973f702:

    # sy "Magnar didn't only want Excalibus. He wanted revenge."
    sy "Magnar不仅想要回Excalibus，他还想报仇。"

# episode12\update12.rpy:15560
translate schinese ep12_sally_end_label_ac64490d:

    # sy "Revenge against the Alpha Nu Omegas for kicking the tri-betas out of their home..."
    sy "向阿尔法·努·欧米伽复仇，因为他们把三贝塔赶出了家园……"

# episode12\update12.rpy:15562
translate schinese ep12_sally_end_label_7a72bb1c:

    # sy "Revenge against the tri-alphas for the bullying throughout the years..."
    sy "复仇针对三阿尔法，因为他们多年来对我们的欺凌……"

# episode12\update12.rpy:15564
translate schinese ep12_sally_end_label_1f362727:

    # sy "And revenge against the DIKs for buying their home, keeping the box from him, the bullying, and for what Jamie did with me."
    sy "对迪克兄弟会的报复，因为他们买下了他们的房子，扣留了那个箱子，还一直欺负他们，还有Jamie对我做的事。"

# episode12\update12.rpy:15565
translate schinese ep12_sally_end_label_fb68e6bb:

    # sy "And they are starting with the DIKs because they know how to get the jocks and the preps to turn on you..."
    sy "他们现在先拿DIKs开刀，因为他们知道怎么让橄榄球队和预备役生把你逼到绝境。"

# episode12\update12.rpy:15586
translate schinese ep12_qend_label_6f53e847:

    # qu "I did it, Dad."
    qu "我干了，老爸。"

# episode12\update12.rpy:15588
translate schinese ep12_qend_label_e0e28c98:

    # qu "Buddy is in jail..."
    qu "Buddy进了监狱..."

# episode12\update12.rpy:15590
translate schinese ep12_qend_label_cee4d29c:

    # qu "Mick is dead..."
    qu "Mick死了..."

# episode12\update12.rpy:15592
translate schinese ep12_qend_label_827d61dd:

    # qu "Vinny is gone..."
    qu "Vinny不见了..."

# episode12\update12.rpy:15594
translate schinese ep12_qend_label_457d8efa:

    # qu "I've got the drugs..."
    qu "我手上有药..."

# episode12\update12.rpy:15596
translate schinese ep12_qend_label_de76c502:

    # qu "I've got the money..."
    qu "我手头有钱……"

# episode12\update12.rpy:15600
translate schinese ep12_qend_label_0474a684:

    # qu "Checkmate."
    qu "残局。"

# episode12\update12.rpy:15606
translate schinese ep12_qend_label_41656702:

    # qu "Ahh..."
    qu "啊……"

# episode12\update12.rpy:15610
translate schinese ep12_qend_label_f881a9f5:

    # qu "Have you made up your mind?"
    qu "你决定了吗？"

# episode12\update12.rpy:15613
translate schinese ep12_qend_label_a7470885:

    # qu "I can see it in your eyes..."
    qu "我能从你眼里看出来……"

# episode12\update12.rpy:15615
translate schinese ep12_qend_label_0be90bef:

    # qu "You need this. We all do."
    qu "你需要这个。我们所有人都需要。"

# episode12\update12.rpy:15616
translate schinese ep12_qend_label_4f6736ef:

    # qu "Don't think of this as an easy escape."
    qu "别把它当成一条简单的退路。"

# episode12\update12.rpy:15617
translate schinese ep12_qend_label_a313d2ff:

    # qu "Think of it as liberation."
    qu "把它当成解脱吧。"

# episode12\update12.rpy:15619
translate schinese ep12_qend_label_2e667bca:

    # qu "With just a single prick..."
    qu "只需一针……"

# episode12\update12.rpy:15620
translate schinese ep12_qend_label_46442fc6:

    # qu "...all of our troubles go-"
    qu "……我们所有的烦恼都烟消云散了。"

# episode12\update12.rpy:15622
translate schinese ep12_qend_label_3a380015:

    # qu "Poof!"
    qu "啪！"

# episode12\update12.rpy:15624
translate schinese ep12_qend_label_833ef975:

    # qu "I promise you...it's not addictive..."
    qu "我向你保证……这不会上瘾……"

# episode12\update12.rpy:15625
translate schinese ep12_qend_label_1e0f103f:

    # qu "Look, we'll do it together."
    qu "看吧，我们一块来。"

# episode12\update12.rpy:15626
translate schinese ep12_qend_label_22fbc371:

    # qu "I'll take half and you'll take the rest. Here!"
    qu "我来一半，你来剩下的。来吧！"

# episode12\update12.rpy:15628
translate schinese ep12_qend_label_c39fe7b1:

    # qu "There...Mmmm..."
    qu "那里……嗯……"

# episode12\update12.rpy:15629
translate schinese ep12_qend_label_c66d1988:

    # qu "Just...do...it..."
    qu "只...做...吧..."

# episode12\update12.rpy:15631
translate schinese ep12_qend_label_8543d059:

    # qu "Join me..."
    qu "来吧..."

