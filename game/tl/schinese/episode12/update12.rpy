    mc "里奥娜... 我早该想到会是这样，但..."

# episode12\update12.rpy:6798
translate schinese ep12_campus_label_f3b3d28f:

    # mc "What's wrong?"
    mc "怎么了？"

# episode12\update12.rpy:6799
