# episode12\update12.rpy:3650
translate schinese ep12_js2_label_68117fe9:

    # sa "No, but he picked up that instrument a few months ago. How good can he have gotten?"
    sa "不，但他几个月前才开始学那乐器。他能好到哪儿去？"

# episode12\update12.rpy:3652
translate schinese ep12_js2_label_b67a2dee:

    # ji "I don't think there has been much progress. He even stopped playing it at the mansion."
    ji "我觉得他也没进步多少。他甚至在庄园里都停了演奏。"

# episode12\update12.rpy:3654
translate schinese ep12_js2_label_62509f99:

    # sa "What the hell is he thinking? He's going to make a fool of himself."
    sa "他他妈的在想什么？他要让自己出丑。"

# episode12\update12.rpy:3656
translate schinese ep12_js2_label_6ce6ade7:

    # ji "I...kind of want to see that."
    ji "我...其实挺想看看的。"

# episode12\update12.rpy:3658
translate schinese ep12_js2_label_21ef1c0d:

    # sa "Hahaha! You're bad!"
    sa "哈哈哈！你真会开玩笑！"

# episode12\update12.rpy:3660
translate schinese ep12_js2_label_9b127d5e:

    # ji "I'm sorry! But I do."
    ji "对不起！但我想看。"

# episode12\update12.rpy:3661
translate schinese ep12_js2_label_26d181eb:

    # ji "He's put me through a lot this year. I think it's only fair that he embarrasses himself."
    ji "他今年让我吃了不少苦头，我觉得他出点丑也挺公平的。"

# episode12\update12.rpy:3663
translate schinese ep12_js2_label_ae8ee795:

    # sa "I'd so want to see that."
    sa "我真想看看。"

# episode12\update12.rpy:3665
translate schinese ep12_js2_label_683fb94c:

    # ji "You should come."
    ji "你该来。"

# episode12\update12.rpy:3667
translate schinese ep12_js2_label_b071955d:

    # sa "Isn't it just for the faculty?"
    sa "这不正是给教职员工准备的吗？"

# episode12\update12.rpy:3669
translate schinese ep12_js2_label_734a2bb3:

    # ji "Yes, but I can take care of it."
    ji "是的，但我会处理的。"

# episode12\update12.rpy:3672
translate schinese ep12_js2_label_b2e047b0:

    # sa "Well... [name] is participating in a fighting competition that day. I want to be there for him."
    sa "嗯……[name]他那天正在参加一场格斗比赛。我想陪在他身边。"

# episode12\update12.rpy:3674
translate schinese ep12_js2_label_724cc594:

    # ji "The party is in the evening. When is the competition done?"
    ji "派对是在晚上，比赛什么时候结束？"

# episode12\update12.rpy:3676
translate schinese ep12_js2_label_f598b733:

    # sa "I'm not sure. But maybe I can make it to both."
    sa "我不确定。但也许我能赶过去参加两个。"

# episode12\update12.rpy:3677
translate schinese ep12_js2_label_b7939cf0:

    # sa "Yeah, what the hell. Sign me up."
    sa "嗯，算了吧。给我报名。"

# episode12\update12.rpy:3679
translate schinese ep12_js2_label_fb11f2c8:

    # sa "Sign me up. I want to watch you and [name] play."
    sa "给我报名。我想看着你和[name]玩。"

# episode12\update12.rpy:3681
translate schinese ep12_js2_label_b7939cf0_1:

    # sa "Yeah, what the hell. Sign me up."
    sa "嗯，管他呢。我报名了。"

# episode12\update12.rpy:3683
translate schinese ep12_js2_label_65dc38d1:

    # ji "Then it's settled."
    ji "那就这么定了。"

# episode12\update12.rpy:3685
translate schinese ep12_js2_label_06268871:

    # sa "I'm sure you'll do great. Don't overthink it when you play."
    sa "你肯定能玩得很好。比赛的时候别想太多。"

# episode12\update12.rpy:3690
translate schinese ep12_js2_label_936a070b:

    # ji "I'll try."
    ji "我会试试看。"

# episode12\update12.rpy:3695
translate schinese ep12_js2_label_cece1968:

    # sa "Hey... Um..."
    sa "嘿……嗯……"

# episode12\update12.rpy:3696
translate schinese ep12_js2_label_236a6533:

    # sa "Does it feel weird to you when I talk about my problems with [name]?"
    sa "和你谈论我的问题时，会不会觉得奇怪？[name]?"

# episode12\update12.rpy:3698
translate schinese ep12_js2_label_afe8b564:

    # ji "Weird how?"
    ji "奇怪的是什么？"

# episode12\update12.rpy:3700
translate schinese ep12_js2_label_673de2a0:

    # sa "[name] told me you two dated."
    sa "[name]告诉我你俩交往过。"

# episode12\update12.rpy:3702
translate schinese ep12_js2_label_bd797ba0:

    # ji "..."
    ji "..."

# episode12\update12.rpy:3704
translate schinese ep12_js2_label_582037e7:

    # ji "I wasn't sure if you were aware of that."
    ji "我也不确定你是不是知道这件事。"

# episode12\update12.rpy:3706
translate schinese ep12_js2_label_41406951:

    # sa "He told me about it. Well, not in great detail or anything. But it came up."
    sa "他跟我提过这事。嗯，不是特别详细地讲，但提到了。"

# episode12\update12.rpy:3708
translate schinese ep12_js2_label_34cbe06a:

    # ji "Maybe I should have let you know earlier..."
    ji "也许我应该早点告诉你……"

# episode12\update12.rpy:3709
translate schinese ep12_js2_label_aa431bf4:

    # ji "Considering your situation with Zoey and him... Do you feel weird around me, too?"
    ji "考虑到你和Zoey还有他的关系……你和我待在一起时也会觉得奇怪吗？"

# episode12\update12.rpy:3711
translate schinese ep12_js2_label_06e90f39:

    # sa "As I gather, you didn't...progress with [name]. Right?"
    sa "看来你没...进展到[name]对吧？"

# episode12\update12.rpy:3713
translate schinese ep12_js2_label_7c16e8ff:

    # ji "I'm not sure what you are getting at."
    ji "我不太确定你想说什么。"

# episode12\update12.rpy:3715
translate schinese ep12_js2_label_cb53fe98:

    # sa "[name] told me you two never slept together."
    sa "[name]告诉我你俩从来没发生过关系。"

# episode12\update12.rpy:3717
translate schinese ep12_js2_label_d32ec943:

    # ji "We slept in the same bed, but we weren't intimate..."
    ji "我们睡过同一个床，但没发生过亲密的事……"

# episode12\update12.rpy:3718
translate schinese ep12_js2_label_6351b23e:

    # ji "I mean, I suppose it depends on what you mean by intimate."
    ji "我是说，我猜这得看你说的“亲密”是什么意思。"

# episode12\update12.rpy:3720
translate schinese ep12_js2_label_cacde930:

    # sa "Oh?"
    sa "哦？"

# episode12\update12.rpy:3722
translate schinese ep12_js2_label_ad07d3d6:

    # ji "We never had sex, if that's what you're asking."
    ji "我们从来没发生过性关系，如果你是这个意思的话。"

# episode12\update12.rpy:3724
translate schinese ep12_js2_label_30065b05:

    # sa "How come?"
    sa "怎么了？"

# episode12\update12.rpy:3726
translate schinese ep12_js2_label_a8693d3e:

    # ji "Now it feels weird."
    ji "现在感觉怪怪的。"

# episode12\update12.rpy:3728
translate schinese ep12_js2_label_79c22a55:

    # sa "I think it would feel weirder for me if we didn't finish this conversation."
    sa "我觉得如果我们不把这番话谈完，对我而言会更奇怪。"

# episode12\update12.rpy:3730
translate schinese ep12_js2_label_7ffff9c5:

    # ji "It was because of me."
    ji "是因为我。"

# episode12\update12.rpy:3731
translate schinese ep12_js2_label_751ad56b:

    # ji "I haven't done that before-"
    ji "我以前没试过——"

# episode12\update12.rpy:3733
translate schinese ep12_js2_label_dad745d1:

    # sa "What? Never?"
    sa "什么？从没做过？"

# episode12\update12.rpy:3735
translate schinese ep12_js2_label_3de4aaad:

    # ji "No."
    ji "不。"

# episode12\update12.rpy:3737
translate schinese ep12_js2_label_4a7cebbb:

    # sa "Jill..."
    sa "Jill..."

# episode12\update12.rpy:3739
translate schinese ep12_js2_label_076db86c:

    # ji "It just never happened."
    ji "它就是没发生。"

# episode12\update12.rpy:3740
translate schinese ep12_js2_label_1659cbba:

    # ji "I had strong feelings for him... It would have happened eventually, but I needed more time."
    ji "我对他的感觉也很强烈……本来迟早会发生的事，但我需要更多时间。"

# episode12\update12.rpy:3742
translate schinese ep12_js2_label_e24220dc:

    # ji "He ended it with me before Halloween because he had stronger feelings for you."
    ji "他万圣节前就跟我分手了，因为他对你的感觉更强。"

# episode12\update12.rpy:3744
translate schinese ep12_js2_label_07cd6b38:

    # sa "..."
    sa "..."

# episode12\update12.rpy:3746
translate schinese ep12_js2_label_997b6024:

    # sa "Now I feel horrible..."
    sa "现在我感觉糟透了..."

# episode12\update12.rpy:3748
translate schinese ep12_js2_label_e919af74:

    # ji "Sage... Don't."
    ji "Sage……别这样。"

# episode12\update12.rpy:3750
translate schinese ep12_js2_label_79ec16f7:

    # sa "I've been bitching about my problems to you. Talking your ear off about everything he's done and our relationship..."
    sa "我一直在跟你抱怨我的问题，跟你唠叨他做了什么，我们之间的关系……"

# episode12\update12.rpy:3751
translate schinese ep12_js2_label_e0e37723:

    # sa "How could you sit through that? Why didn't you stop me?"
    sa "你怎么能坐视不管？为什么不阻止我？"

# episode12\update12.rpy:3753
translate schinese ep12_js2_label_75e5e82b:

    # ji "I'm still his friend, and I want to be yours."
    ji "我还是他的朋友，也想成为你的朋友。"

# episode12\update12.rpy:3754
translate schinese ep12_js2_label_fcb32018:

    # ji "My feelings for him are different now."
    ji "我对他的感觉已经不一样了。"

# episode12\update12.rpy:3756
translate schinese ep12_js2_label_d3463479:

    # sa "Are you sure?"
    sa "你确定吗？"

# episode12\update12.rpy:3758
translate schinese ep12_js2_label_0001fdf1:

    # ji "It still hurts from time to time, but..."
    ji "偶尔还是会痛，但……"

# episode12\update12.rpy:3759
translate schinese ep12_js2_label_4cb8c8b6:

    # ji "It's not going to stop me from spending time with you guys."
    ji "这不会阻止我花时间陪你们。"

# episode12\update12.rpy:3761
translate schinese ep12_js2_label_d3b15060:

    # sa "Wow... You're a lot stronger than I am."
    sa "哇……你比我强多了。"

# episode12\update12.rpy:3763
translate schinese ep12_js2_label_228ee498:

    # ji "Oh? Did I make you feel weird about our friendship now?"
    ji "哦？我让你现在对我们的友谊感到别扭了吗？"

# episode12\update12.rpy:3765
translate schinese ep12_js2_label_3cc3e5f5:

    # sa "No. I pictured myself in your shoes. I don't see myself handling it as well as you."
    sa "不，我想象过自己处在你的位置。我没觉得自己能像你这样处理得好。"

# episode12\update12.rpy:3773
translate schinese ep12_js2_label_1817bfcf:

    # sa "What an absolute ass."
    sa "这他妈真是个混蛋。"

# episode12\update12.rpy:3775
translate schinese ep12_js2_label_6eaf8de8:

    # ji "I thought I meant something more to him than that."
    ji "我以为我对他的意义远不止如此。"

# episode12\update12.rpy:3776
translate schinese ep12_js2_label_b8f2538a:

    # ji "He never told me about his feelings for his ex-girlfriend. But they must have been there all along."
    ji "他从来没跟我说过他对前任女友的感觉。但那些感觉肯定一直都存在。"

# episode12\update12.rpy:3777
translate schinese ep12_js2_label_40044a87:

    # ji "To think that he told me there was nothing left between them, and then he does that to me."
    ji "想不到他跟我说他们之间已经没什么了，结果却对我做了这种事。"

# episode12\update12.rpy:3779
translate schinese ep12_js2_label_f024c9fd:

    # sa "Yeah, it's wrong. He gaslit you."
    sa "这事儿确实不对，他让你吃了一肚子闷亏。"

# episode12\update12.rpy:3780
translate schinese ep12_js2_label_40eef2ec:

    # sa "I can't believe [name] would do that."
    sa "我简直不敢相信[name]会这么做。"

# episode12\update12.rpy:3782
translate schinese ep12_js2_label_bb230b44:

    # ji "There wasn't even a discussion about it. He just dropped that bombshell on me."
    ji "连个讨论都没来得及说，他直接就甩给我这颗炸弹。"

# episode12\update12.rpy:3783
translate schinese ep12_js2_label_0aaa4987:

    # ji "I feel so stupid for trusting him and giving him the benefit of the doubt."
    ji "我真是蠢透了，竟然还相信他，还给他留了余地。"

# episode12\update12.rpy:3785
translate schinese ep12_js2_label_5f7b2bcd:

    # ji "How could I have been so blind!? I even tried to defend his actions to you."
    ji "我怎么会这么盲目！我甚至还试图向你为他的行为辩护。"

# episode12\update12.rpy:3786
translate schinese ep12_js2_label_fe29c0b2:

    # ji "I should have listened to you. You knew what it was from the moment you heard about it."
    ji "我应该听你的。你从一开始就知道是怎么回事。"

# episode12\update12.rpy:3788
translate schinese ep12_js2_label_be816efd:

    # sa "Yeah, but I don't think you could have stopped this. Reacting differently would only have saved you some of the heartache."
    sa "不过，我觉得你也不可能阻止这一切。换种反应只会让你少些心碎罢了。"

# episode12\update12.rpy:3789
translate schinese ep12_js2_label_e39d2722:

    # sa "I think [name] made up his mind the moment he started hanging out with Zoey. He allowed himself to feel for her, and he relapsed."
    sa "我想[name]他从一开始和Zoey相处就下定决心了。他允许自己对她产生感情，又再次沉溺其中。"

# episode12\update12.rpy:3791
translate schinese ep12_js2_label_3036c92b:

    # ji "I'm so disappointed in him."
    ji "我对他太失望了。"

# episode12\update12.rpy:3793
translate schinese ep12_js2_label_812ab408:

    # sa "Disappointed? You should be fucking furious."
    sa "失望？你该他妈的气疯了。"

# episode12\update12.rpy:3794
translate schinese ep12_js2_label_5a68e631:

    # sa "He's not worthy of you."
    sa "他不配你。"

# episode12\update12.rpy:3797
translate schinese ep12_js2_label_891d255f:

    # sa "If you guys hadn't already broken up, I would have given you another reason for it."
    sa "如果你们还没分手，我还会给你们另一个分手的理由。"

# episode12\update12.rpy:3798
translate schinese ep12_js2_label_8179a8bc:

    # sa "[name] had sex with my mother."
    sa "[name]和我妈妈发生了关系。"

# episode12\update12.rpy:3800
translate schinese ep12_js2_label_1dcc6be6:

    # ji "He what!?"
    ji "他干了什么！？"

# episode12\update12.rpy:3802
translate schinese ep12_js2_label_992b2ceb:

    # sa "He had sex with her, recorded it, and used it for Hell Week to score points with his brothers."
    sa "他和她发生了关系，还录下来了，然后在地狱周用这段视频去讨好他的兄弟们。"

# episode12\update12.rpy:3804
translate schinese ep12_js2_label_1dd39152:

    # ji "I can't believe what I'm hearing. [name] did that?"
    ji "我简直不敢相信我听到的。[name]做过了？"

# episode12\update12.rpy:3805
translate schinese ep12_js2_label_00a53fc1:

    # ji "That's gross! You think you know someone and..."
    ji "太恶心了！你以为自己了解一个人，可是……"

# episode12\update12.rpy:3807
translate schinese ep12_js2_label_5ba61644:

    # sa "He claims he didn't know who she was before doing it."
    sa "他声称在做那事之前根本不知道她是谁。"

# episode12\update12.rpy:3809
translate schinese ep12_js2_label_0b9490d0:

    # ji "Bah! As if that makes it excusable."
    ji "呸！像这样就没事了？"

# episode12\update12.rpy:3811
translate schinese ep12_js2_label_e9afc607:

    # sa "And after hearing what he did to you... Ugh..."
    sa "而且听完他对你做的那些事……唉……"

# episode12\update12.rpy:3812
translate schinese ep12_js2_label_ed796517:

    # sa "It makes me sick."
    sa "这让我作呕。"

# episode12\update12.rpy:3815
translate schinese ep12_js2_label_3d5d74c3:

    # sa "He threw away your relationship for what?"
    sa "他为了什么就把你的关系扔了？"

# episode12\update12.rpy:3816
translate schinese ep12_js2_label_4e711e41:

    # sa "Trust me. Their relationship won't last, and he'll come begging for you to have him back."
    sa "相信我，他们的关系撑不了多久，他到时候会跪着求你回头。"

# episode12\update12.rpy:3818
translate schinese ep12_js2_label_e2340c8e:

    # ji "I'm so done with him."
    ji "我受够他了。"

# episode12\update12.rpy:3820
translate schinese ep12_js2_label_6e10cc13:

    # sa "You don't need him. You have our friends and me."
    sa "你不需要他。你有我们的朋友和我。"

# episode12\update12.rpy:3822
translate schinese ep12_js2_label_fb5cc444:

    # ji "I don't want him anywhere near me."
    ji "我不想让他靠近我。"

# episode12\update12.rpy:3825
translate schinese ep12_js2_label_c81fb520:

    # sa "You don't have to convince me. I'm with you."
    sa "你不用说服我，我站在你这边。"

# episode12\update12.rpy:3826
translate schinese ep12_js2_label_449d9012:

    # sa "So much for our joint circle of friends..."
    sa "那我们所谓的铁杆朋友圈，也就到此为止了..."

# episode12\update12.rpy:3828
translate schinese ep12_js2_label_3fad70a2:

    # ji "I have to tell Josy and Maya about this."
    ji "我得跟Josy和Maya说说这事。"

# episode12\update12.rpy:3830
translate schinese ep12_js2_label_6ead84a0:

    # sa "What about Bella?"
    sa "那贝拉呢？"

# episode12\update12.rpy:3832
translate schinese ep12_js2_label_db80fec9:

    # ji "I called her the moment after he broke up with me."
    ji "我刚一分手就给她打了电话。"

# episode12\update12.rpy:3834
translate schinese ep12_js2_label_3a832d27:

    # sa "Let's tell them."
    sa "我们告诉她们吧。"

# episode12\update12.rpy:3836
translate schinese ep12_js2_label_8e94c7cb:

    # ji "Now?"
    ji "现在？"

# episode12\update12.rpy:3839
translate schinese ep12_js2_label_801d2455:

    # sa "Trust me. You'll feel better having their support."
    sa "相信我，有她们的支持你会感觉好很多。"

# episode12\update12.rpy:3846
translate schinese ep12_js2_label_d26311e6:

    # sa "How do I tell you this...?"
    sa "我该怎么跟你说这件事……"

# episode12\update12.rpy:3848
translate schinese ep12_js2_label_a67df1e0:

    # ji "You can tell me anything. What did [name] do?"
    ji "你可以告诉我任何事。你做了什么[name]你问什么？"

# episode12\update12.rpy:3850
translate schinese ep12_js2_label_9a276081:

    # sa "He had sex with my mother."
    sa "他和我妈妈发生了关系。"

# episode12\update12.rpy:3852
translate schinese ep12_js2_label_1dcc6be6_1:

    # ji "He what!?"
    ji "他干了什么？！"

# episode12\update12.rpy:3854
translate schinese ep12_js2_label_992b2ceb_1:

    # sa "He had sex with her, recorded it, and used it for Hell Week to score points with his brothers."
    sa "他和她发生了关系，还录了下来，然后在地狱周用这段视频来给兄弟们加分。"

# episode12\update12.rpy:3856
translate schinese ep12_js2_label_bd797ba0_1:

    # ji "..."
    ji "..."

# episode12\update12.rpy:3858
translate schinese ep12_js2_label_bc5dc78b:

    # sa "I know. It came as a shock to me, too."
    sa "我知道。这件事对我也挺震惊的。"

# episode12\update12.rpy:3860
translate schinese ep12_js2_label_5e8b89e4:

    # ji "Are you completely sure?"
    ji "你确定吗？"

# episode12\update12.rpy:3862
translate schinese ep12_js2_label_dcf317c0:

    # sa "My brother showed me the recording. There's no doubt about it, and [name] even admitted to it."
    sa "我的兄弟给我看了录像。毫无疑问，而且[name]甚至承认了这一点。"

# episode12\update12.rpy:3864
translate schinese ep12_js2_label_01b70cb4:

    # ji "I can't believe what I'm hearing. That's... That's..."
