    ri "别慌。"

# episode12\update12.rpy:6801
translate schinese ep12_campus_label_63b17026:

    # mc "Oh my God. What happened to you?"
    mc "天啊，你怎么了？"

# episode12\update12.rpy:6803
translate schinese ep12_campus_label_ab6ddc47:

    # ri "..."
    ri "..."

# episode12\update12.rpy:6805
translate schinese ep12_campus_label_9abd7b42:

    # ri "I..."
    ri "我...我怀孕了。"

# episode12\update12.rpy:6806
translate schinese ep12_campus_label_f3fd389d:

    # ri "I don't feel comfortable talking about it here."
    ri "这里不太方便说这些事。"

# episode12\update12.rpy:6808
translate schinese ep12_campus_label_5b36abcf:

    # mc "Follow me back to my room. We can talk in private there."
    mc "跟我回去我的房间，我们可以在那里私下谈谈。"

