    dw "快点！我们现在已经离竞争对手这么近了！"

# episode12\update12.rpy:3079
translate schinese ep12_jocks_label_b807e5bf:

    # an "I'm sorry, guys..."
    an "对不起，伙计们……"

# episode12\update12.rpy:3081
translate schinese ep12_jocks_label_7909f9f7:

    # dw "No one blames you. But you have to do better than this."
    dw "没人怪你们。但你们得比这做得更好。"

# episode12\update12.rpy:3082
translate schinese ep12_jocks_label_3135353a:

    # dw "Look at me! And look at Chad. Be more like us. Right, Chad?"
    dw "看我！再看看Chad。要像我们这样。对吧，Chad？"

