# episode12\update12.rpy:1582
translate schinese ep12_bellas_label_11d6ef44:

    # mc "I figured you'd get what it meant."
    mc "我想你明白它的意思。"

# episode12\update12.rpy:1584
translate schinese ep12_bellas_label_db2ffca3:

    # sa "*{i}Smack{/i}*"
    sa "*{i}一巴掌{/i}*"

# episode12\update12.rpy:1586
translate schinese ep12_bellas_label_86f13eb5:

    # sa "Thank you! It's such a romantic gift..."
    sa "谢谢！这可真是个浪漫的礼物……"

# episode12\update12.rpy:1588
translate schinese ep12_bellas_label_39ab406e:

    # mc "Merry Christmas, Sage."
    mc "圣诞快乐，Sage。"

# episode12\update12.rpy:1592
translate schinese ep12_bellas_label_72e3de11_1:

    # mc "I had to ask Rusty for some help to get this one, but I hope you'll like it."
    mc "我得找Rusty帮忙弄到这个，但希望你会喜欢。"

# episode12\update12.rpy:1594
translate schinese ep12_bellas_label_95b9092a:

    # sa "I will never say no to a bottle of whisky. Thank you, [name]."
    sa "我从不拒绝一瓶威士忌。谢谢，[name]."

# episode12\update12.rpy:1599
translate schinese ep12_bellas_label_db2ffca3_1:

    # sa "*{i}Smack{/i}*"
    sa "*{i}亲吻{/i}*"

# episode12\update12.rpy:1602
translate schinese ep12_bellas_label_4f6e3530_1:

    # mc "Here you go. I hope you'll like it."
    mc "给你。希望你会喜欢。"

# episode12\update12.rpy:1604
translate schinese ep12_bellas_label_9a5ff5b2:

    # sa "Wait... Are those guitar picks?"
    sa "等等...那些是吉他拨片吗？"

# episode12\update12.rpy:1605
translate schinese ep12_bellas_label_ec9ccb05:

    # mc "And that's your own personal case of them. I thought they looked pretty, and I hope they make you want to play more."
    mc "这可是你自己的专属款。我觉着它们挺好看的，希望它们能让你更想弹吉他。"

# episode12\update12.rpy:1607
translate schinese ep12_bellas_label_db2ffca3_2:

    # sa "*{i}Smack{/i}*"
    sa "*{i}一巴掌{/i}*"

# episode12\update12.rpy:1609
translate schinese ep12_bellas_label_914d5269:

    # sa "Thank you! It will be fun playing with these."
    sa "谢谢！用这些玩起来应该很有趣。"

# episode12\update12.rpy:1611
translate schinese ep12_bellas_label_39ab406e_1:

    # mc "Merry Christmas, Sage."
    mc "圣诞快乐，Sage。"

# episode12\update12.rpy:1616
translate schinese ep12_bellas_label_77474b2a_1:

    # mc "I'm sorry. I didn't get you anything."
    mc "对不起，我没给你买什么礼物。"

# episode12\update12.rpy:1619
translate schinese ep12_bellas_label_176f9614:

    # sa "You didn't have to. You already give me so much daily."
    sa "你没必要这么做。你已经每天给我很多了。"

# episode12\update12.rpy:1623
translate schinese ep12_bellas_label_136ac3de:

    # sa "It's ok. It's not like you promised that you would."
    sa "没关系。你又没答应过要给我什么。"

# episode12\update12.rpy:1628
translate schinese ep12_bellas_label_0cace0d9:

    # my "For me!? You didn't have to get me anything."
    my "对我？你没必要给我买什么。"

# episode12\update12.rpy:1630
translate schinese ep12_bellas_label_71e3d23c:

    # ji "Merry Christmas, Maya. I wish you a better next year."
    ji "圣诞快乐，Maya。祝你明年一切更好。"

# episode12\update12.rpy:1632
translate schinese ep12_bellas_label_ce771a04:

    # my "Merry Christmas."
    my "圣诞快乐。"

# episode12\update12.rpy:1635
translate schinese ep12_bellas_label_19007793:

    # isa "How are you doing?"
    isa "你怎么样？"

# episode12\update12.rpy:1637
translate schinese ep12_bellas_label_cd680a1d:

    # mc "Tonight has been...uh... Both terrible and nice. I'm not quite feeling myself."
    mc "今晚过得……呃……既糟糕又不错。我感觉自己不太对劲。"

# episode12\update12.rpy:1639
translate schinese ep12_bellas_label_ed61a389:

    # isa "Can I do something for you?"
    isa "我能为你做点什么吗？"

# episode12\update12.rpy:1641
translate schinese ep12_bellas_label_8433375e:

    # mc "I feel like I should ask you that."
    mc "我觉得我应该问问你。"

# episode12\update12.rpy:1643
translate schinese ep12_bellas_label_89e52d09:

    # isa "I know what I told you tonight scared you."
    isa "我知道我今晚对你说的话吓到你了。"

# episode12\update12.rpy:1645
translate schinese ep12_bellas_label_8599bec6:

    # mc "Scared me? I..."
    mc "怕我？我..."

# episode12\update12.rpy:1647
translate schinese ep12_bellas_label_46162724:

    # isa "I can tell that it did."
    isa "我能感觉到它确实吓到你了。"

# episode12\update12.rpy:1649
translate schinese ep12_bellas_label_6798b4c6:

    # mc "If I had known this earlier... I would have acted differently around you."
    mc "如果我早知道的话……我早就不该对你这么做了。"

# episode12\update12.rpy:1650
translate schinese ep12_bellas_label_be6eee57:

    # mc "Like... Um... Being forward with you."
    mc "比如……呃……对你有点直白。"

# episode12\update12.rpy:1651
translate schinese ep12_bellas_label_dc037799:

    # mc "I've been analyzing whether I said inappropriate things to you in the past."
    mc "我一直在想，我以前有没有对你说过什么不合适的话。"

# episode12\update12.rpy:1653
translate schinese ep12_bellas_label_a7df30e6:

    # isa "[name], I want you to be yourself around me."
    isa "[name]我在你面前想做真实的自己。"

# episode12\update12.rpy:1654
translate schinese ep12_bellas_label_75066811:

    # isa "You've said and done things that I know you wouldn't have if you had known about my past..."
    isa "你做过一些事，我知道那不是你本来的样子，如果你早知道我的过去……"

# episode12\update12.rpy:1656
translate schinese ep12_bellas_label_6e307cc4:

    # isa "But I'd hate it if you started walking on eggshells around me."
    isa "但我不想你开始对我处处小心翼翼。"

# episode12\update12.rpy:1657
translate schinese ep12_bellas_label_a6a425d3:

    # isa "So, keep being yourself. That's what you can do for me."
    isa "所以，继续做你自己。这就是你能为我做的。"

# episode12\update12.rpy:1659
translate schinese ep12_bellas_label_18b15f02:

    # mc "I still feel bad."
    mc "我仍然觉得很难受。"

# episode12\update12.rpy:1660
translate schinese ep12_bellas_label_f4d81650:

    # mc "Sure, I've gone through things, but I've never had to deal with this kind of pain in my life."
    mc "当然，我经历过一些事情，但这辈子从来没遇到过这种痛苦。"

# episode12\update12.rpy:1662
translate schinese ep12_bellas_label_e3533b24:

    # isa "Neither had I when I was your age. There will be days in your life when you realize there's no guide to follow."
    isa "我那时候也一样。你这辈子也会有那么一天，发现根本没有可以遵循的指南。"

# episode12\update12.rpy:1663
translate schinese ep12_bellas_label_8fc3088b:

    # isa "You will feel lost and clueless."
    isa "你会感到迷失和不知所措。"

# episode12\update12.rpy:1665
translate schinese ep12_bellas_label_90ef4ee4:

    # isa "Learning how to deal with it and to move on from there is a journey we all have to make at some point. Some face it sooner in life than others."
    isa "学会如何应对并从中走出来，是每个人都必须经历的一段旅程。有些人早些时候就面对了，有些人则要晚些时候才不得不面对。"

# episode12\update12.rpy:1667
translate schinese ep12_bellas_label_0419be82:

    # isa "And I've made many mistakes on my journey. But I believe I'm finally heading in the right direction again."
    isa "我在这条路上也犯过很多错。但我觉得自己终于又走在了正确的方向上。"

# episode12\update12.rpy:1669
translate schinese ep12_bellas_label_b0acd2f8:

    # isa "Give me a hug."
    isa "给我一个拥抱。"

# episode12\update12.rpy:1675
translate schinese ep12_bellas_label_1a22f1ff:

    # isa "I'm sorry for making you feel this way."
    isa "我也为让你感觉这样而道歉。"

# episode12\update12.rpy:1677
translate schinese ep12_bellas_label_09f652b5:

    # mc "I'm sorry too."
    mc "我也很抱歉。"

# episode12\update12.rpy:1679
translate schinese ep12_bellas_label_48761622:

    # mc "For a lot of things..."
    mc "对于很多事……"

# episode12\update12.rpy:1681
translate schinese ep12_bellas_label_57b06feb:

    # mc "For everything you've had to go through."
    mc "对于你所经历的一切。"

# episode12\update12.rpy:1684
translate schinese ep12_bellas_label_4b545ca1:

    # isa "I know this has affected you..."
    isa "我知道这一切都影响了你..."

# episode12\update12.rpy:1685
translate schinese ep12_bellas_label_157b1c4a:

    # isa "Does it change anything between us?"
    isa "这会改变我们之间的关系吗？"

# episode12\update12.rpy:1688
translate schinese ep12_bellas_label_39dcd442:

    # mc "I'm in a bad spot, right now..."
    mc "我现在处境很糟，对吧..."

# episode12\update12.rpy:1690
translate schinese ep12_bellas_label_7181f43d:

    # isa "So, it does..."
    isa "所以，它确实……"

# episode12\update12.rpy:1692
translate schinese ep12_bellas_label_a38a3675:

    # mc "No, it doesn't. But there's something else that does..."
    mc "不，这不会改变什么。但还有别的事会。"

# episode12\update12.rpy:1693
translate schinese ep12_bellas_label_fe21ec38:

    # mc "And I didn't want to bring that up tonight, and after hearing what you said, it was even harder to bring it up..."
    mc "我不想今晚提起那件事，但听完你的话，更难开口了……"

# episode12\update12.rpy:1694
translate schinese ep12_bellas_label_fb623a7e:

    # isa "..."
    isa "..."

# episode12\update12.rpy:1696
translate schinese ep12_bellas_label_18bb3cb9:

    # isa "Then, let's not ruin this night further."
    isa "那我们就不把这晚搞砸了。"

# episode12\update12.rpy:1698
translate schinese ep12_bellas_label_2b35b6fe_1:

    # mc "..."
    mc "..."

# episode12\update12.rpy:1701
translate schinese ep12_bellas_label_a5cac74f:

    # mc "I need time to digest it."
    mc "我需要时间消化一下。"

# episode12\update12.rpy:1703
translate schinese ep12_bellas_label_78732b19:

    # isa "Of course. I understand."
    isa "当然。我明白。"

# episode12\update12.rpy:1706
translate schinese ep12_bellas_label_459c9055:

    # isa "Here... Merry Christmas, [name]."
    isa "这里... 圣诞快乐，[name]."

# episode12\update12.rpy:1711
translate schinese ep12_bellas_label_03093a81:

    # mc "Merry Christmas to you too..."
    mc "你也圣诞快乐..."

# episode12\update12.rpy:1713
translate schinese ep12_bellas_label_4b38000d:

    # isa "I thought that brand would suit you. I hope I got the size right."
    isa "我觉得这个牌子挺适合你的。希望我选的尺码刚好合适。"

# episode12\update12.rpy:1715
translate schinese ep12_bellas_label_0929add6:

    # mc "Yeah, you did. It's perfect."
    mc "对，你选对了。正合适。"

# episode12\update12.rpy:1716
translate schinese ep12_bellas_label_73cba613:

    # mc "It's so soft... What a nice quality..."
    mc "这布料真软...质量真不错..."

# episode12\update12.rpy:1718
translate schinese ep12_bellas_label_aa090933:

    # isa "I'm happy you like it."
    isa "我很高兴你喜欢。"

# episode12\update12.rpy:1722
translate schinese ep12_bellas_label_5cd4e75c:

    # isa "Oh, my... [name]... You shouldn't have."
    isa "哦，天啊...[name]你本不该这样。"

# episode12\update12.rpy:1724
translate schinese ep12_bellas_label_91bae8ac:

    # mc "Do you like them?"
    mc "你喜欢吗？"

# episode12\update12.rpy:1726
translate schinese ep12_bellas_label_947b8611:

    # isa "You're not going to believe this, but I was going to buy these come spring."
    isa "你绝对想不到，我本来打算春天就买这双的。"

# episode12\update12.rpy:1728
translate schinese ep12_bellas_label_c58a3767:

    # mc "You were?"
    mc "你当时在哪儿？"

# episode12\update12.rpy:1730
translate schinese ep12_bellas_label_6e99ba94:

    # isa "I wanted a new pair for summer. You've got great taste."
    isa "我本来打算夏天换一双的，你眼光真不错。"

# episode12\update12.rpy:1732
translate schinese ep12_bellas_label_2d2058d0:

    # mc "I'm happy you'll use them. They suit you!"
    mc "我很高兴你能用上它们。它们很适合你！"

# episode12\update12.rpy:1734
translate schinese ep12_bellas_label_e4c0fb71:

    # isa "Thank you, [name]."
    isa "谢谢，[name]."

# episode12\update12.rpy:1737
translate schinese ep12_bellas_label_46a45967:

    # isa "My favorite student, huh?"
    isa "我最喜欢的学生，是吗？"

# episode12\update12.rpy:1739
translate schinese ep12_bellas_label_68eaf8a6:

    # mc "And I mean that."
    mc "我是认真的。"

# episode12\update12.rpy:1742
translate schinese ep12_bellas_label_538f477d:

    # isa "Haha... Thank you."
    isa "哈哈... 谢谢你。"

# episode12\update12.rpy:1744
translate schinese ep12_bellas_label_8597c40f:

    # isa "Haha... Not even close, but thank you."
    isa "哈哈... 还差得远呢，不过谢谢。"

# episode12\update12.rpy:1747
translate schinese ep12_bellas_label_9601a1a9:

    # mc "I thought you might need one for work."
    mc "我以为你工作可能需要一个。"

# episode12\update12.rpy:1749
translate schinese ep12_bellas_label_6f941270:

    # mc "Ouch... Well, I thought you might need one for work."
    mc "哎哟... 我是说，我本来以为你可能需要一个用来工作的。"

# episode12\update12.rpy:1751
translate schinese ep12_bellas_label_82b89d05:

    # isa "How thoughtful."
    isa "真贴心。"

# episode12\update12.rpy:1752
translate schinese ep12_bellas_label_7f2f6400:

    # isa "It will bring a smile to my face daily."
    isa "这玩意儿每天都能让我笑一笑。"

# episode12\update12.rpy:1758
translate schinese ep12_bellas_label_fb9a2df7:

    # my "Merry Christmas, [name]."
    my "圣诞快乐，[name]."

# episode12\update12.rpy:1764
translate schinese ep12_bellas_label_e0fce2af:

    # mc "Um... Stockings?"
    mc "嗯……丝袜？"

# episode12\update12.rpy:1766
translate schinese ep12_bellas_label_4564d048:

    # my "Feel away, [name]. Feel away."
    my "走开[name]走开。"

# episode12\update12.rpy:1768
translate schinese ep12_bellas_label_3a7260ce:

    # mc "Funny..."
    mc "好笑啊..."

# episode12\update12.rpy:1770
translate schinese ep12_bellas_label_6b8181a9:

    # my "Haha! I intend to wear those for you, in case you hadn't guessed."
    my "哈哈！我打算穿着它们来见你，你要是没猜到的话。"

# episode12\update12.rpy:1773
translate schinese ep12_bellas_label_291a7735:

    # mc "Feel away, [name]. Feel away."
    mc "想摸就摸吧，[name]。尽管摸。"

# episode12\update12.rpy:1775
translate schinese ep12_bellas_label_4101ea3b:

    # my "Look. There's more in the box."
    my "盒子里还有更多。"

# episode12\update12.rpy:1783
translate schinese ep12_bellas_label_4b767bfa:

    # my "How do I thank someone who's given me everything?"
    my "我该怎样感谢一个给我一切的人？"

# episode12\update12.rpy:1784
translate schinese ep12_bellas_label_250e53c4:

    # my "I couldn't think of a way, so... I bought you some candy."
    my "我想不出别的办法，所以……我给你买了点糖果。"

# episode12\update12.rpy:1786
translate schinese ep12_bellas_label_f45fc853:

    # my "I didn't know how to thank you for everything you've done."
    my "我不知道该怎么感谢你为我做的一切。"

# episode12\update12.rpy:1787
translate schinese ep12_bellas_label_2bf6a995:

    # my "So, I bought you some candy."
    my "所以我给你买了点糖果。"

# episode12\update12.rpy:1788
translate schinese ep12_bellas_label_7cca7024:

    # my "And I hope you can use the box for something special too."
    my "我也希望你能用这个盒子做点特别的事情。"

# episode12\update12.rpy:1790
translate schinese ep12_bellas_label_ecc4d211:

    # mc "Thank you, Maya. They look delicious."
    mc "谢谢，Maya。这些看起来真不错。"

# episode12\update12.rpy:1794
translate schinese ep12_bellas_label_cac52510:

    # mc "Merry Christmas."
    mc "圣诞快乐。"

# episode12\update12.rpy:1796
translate schinese ep12_bellas_label_1b588318:

    # my "Aw! My favorite drink...and two movie tickets!?"
    my "哇！我最爱的饮料……还有两张电影票！？"

# episode12\update12.rpy:1798
translate schinese ep12_bellas_label_b73c0614:

    # mc "For any movie of your choice."
    mc "随便你选哪部电影。"

# episode12\update12.rpy:1800
translate schinese ep12_bellas_label_72c4b39b:

    # my "Thank you, [name]. Now I can go to the movies twice."
    my "谢谢，[name]现在我可以去看两场电影了。"

# episode12\update12.rpy:1802
translate schinese ep12_bellas_label_2da5248e:

    # mc "Haha, or you could invite someone."
    mc "哈哈，你也可以叫上别人。"

# episode12\update12.rpy:1804
translate schinese ep12_bellas_label_9080f8f7:

    # my "Haha, I was joking."
    my "哈哈，我开玩笑的。"

# episode12\update12.rpy:1807
translate schinese ep12_bellas_label_cac52510_1:

    # mc "Merry Christmas."
    mc "圣诞快乐。"

# episode12\update12.rpy:1809
translate schinese ep12_bellas_label_c39654d6:

    # mc "That coupon can be used to stream a movie of your choice."
    mc "那张优惠券可以用来点播你选的任何电影。"

# episode12\update12.rpy:1811
translate schinese ep12_bellas_label_09b1753e:

    # my "Thank you, [name]."
    my "谢谢，[name]."

# episode12\update12.rpy:1816
translate schinese ep12_bellas_label_aac2ac73:

    # mc "I don't have anything for you... I'm sorry."
    mc "我没给你准备什么……对不起。"

# episode12\update12.rpy:1819
translate schinese ep12_bellas_label_23797a7e:

    # my "As I said, you've already given me everything. I don't need any gifts."
    my "正如我所说，你已经给我了一切，我什么都不需要了。"

# episode12\update12.rpy:1821
translate schinese ep12_bellas_label_540d1492:

    # my "You've done so much for me, [name]. I don't need any gifts."
    my "你为我做了这么多[name]我不需要任何礼物。"

# episode12\update12.rpy:1828
translate schinese ep12_bellas_label_7969f28c:

    # ji "Merry Christmas, [name]. This one is for you."
    ji "圣诞快乐，[name]这个是给你的。"

# episode12\update12.rpy:1830
translate schinese ep12_bellas_label_9da00e78:

    # ji "Now, this is part one of the gift. You'll have to wait for part two."
    ji "现在，这是第一部分的礼物。你得等第二部分。"

# episode12\update12.rpy:1833
translate schinese ep12_bellas_label_0bf7d5f7:

    # mc "You shouldn't have..."
    mc "你本就不该有这份心意。"

# episode12\update12.rpy:1836
translate schinese ep12_bellas_label_13f2df08:

    # mc "Two gifts? You're spoiling me."
    mc "两份礼物？你真是把我宠坏了。"

# episode12\update12.rpy:1838
translate schinese ep12_bellas_label_8eb88e4b:

    # mc "Wait... This is..."
    mc "等等...这是..."

# episode12\update12.rpy:1839
translate schinese ep12_bellas_label_bd91898f:

    # ji "It's Lana's poster. I saw the glow in your eyes when you spotted it."
    ji "这是Lana的海报。你发现它时，眼睛都亮了。"

# episode12\update12.rpy:1840
translate schinese ep12_bellas_label_2f6dd6f7:

    # ji "I figured you'd enjoy having it on your wall."
    ji "我猜你肯定喜欢挂在墙上。"

# episode12\update12.rpy:1842
translate schinese ep12_bellas_label_1ab8fec7:

    # mc "You have no idea..."
    mc "你根本不知道..."

# episode12\update12.rpy:1844
translate schinese ep12_bellas_label_5cd33113:

    # ji "It's not much, but remember, there's a part two to this."
    ji "这不算什么，不过记住，这还只是第一部分。"

# episode12\update12.rpy:1846
translate schinese ep12_bellas_label_b70d3347:

    # mc "This was already too much. These are hard to come by today; they stopped printing them."
    mc "这已经够多了。现在这种海报很难搞到，他们早就停印了。"

# episode12\update12.rpy:1848
translate schinese ep12_bellas_label_1d06f23e:

    # mc "And it was your sister's poster too... It's too much..."
    mc "而且这还是你妹妹的海报……这也太多了……"

# episode12\update12.rpy:1850
translate schinese ep12_bellas_label_5bdcdcfc:

    # mc "And it was your sister's poster too... This means a lot..."
    mc "而且还是你姐姐的海报……这对我来说意义很大……"

# episode12\update12.rpy:1853
translate schinese ep12_bellas_label_654fcd79:

    # mc "Acoustic guitar strings?"
    mc "你问的是木吉他弦吗？"

# episode12\update12.rpy:1854
translate schinese ep12_bellas_label_f70e826c:

    # ji "I wasn't sure of what brand you usually get, but these are supposed to be high-quality."
    ji "我本来不确定你平时用什么牌子，但这些应该算是高品质的。"

# episode12\update12.rpy:1856
translate schinese ep12_bellas_label_f0966b85:

    # mc "Yeah, these are top-of-the-line. I've never bought this brand because they are too expensive."
    mc "是的，这些是顶级的。我从来没买过这个牌子，因为太贵了。"

# episode12\update12.rpy:1857
translate schinese ep12_bellas_label_9973d234:

    # mc "Thank you so much!"
    mc "谢谢你的礼物，真的太好了。"

# episode12\update12.rpy:1859
translate schinese ep12_bellas_label_852df019:

    # ji "Enjoy them."
    ji "享受它们。"

# episode12\update12.rpy:1861
translate schinese ep12_bellas_label_860c1565:

    # mc "Oh, I will!"
    mc "哦，我这就给你！"

# episode12\update12.rpy:1864
translate schinese ep12_bellas_label_d8404dab:

    # mc "Hold on a second. I have something for you."
    mc "等一下，我有个东西给你。"

# episode12\update12.rpy:1866
translate schinese ep12_bellas_label_175353e0:

    # mc "Merry Christmas, Jill."
    mc "圣诞快乐，Jill。"

# episode12\update12.rpy:1868
translate schinese ep12_bellas_label_dbf1db51:

    # mc "I'm clueless when it comes to jewelry, but I saw this necklace and thought of you."
    mc "我对珠宝一窍不通，但看到这条项链就想到你了。"

# episode12\update12.rpy:1869
translate schinese ep12_bellas_label_e8c1f05d:

    # ji "This is so sweet... It's beautiful."
    ji "这太甜了……真漂亮。"

# episode12\update12.rpy:1872
translate schinese ep12_bellas_label_b9f2a893:

    # ji "I've never gotten jewelry from a guy before, and to get one from my boyfriend..."
    ji "我从没从男生那里收到过首饰，更别说是我男朋友了……"

# episode12\update12.rpy:1873
translate schinese ep12_bellas_label_f52253fa:

    # ji "It means a lot to me."
    ji "这对我来说意义很大。"

# episode12\update12.rpy:1875
translate schinese ep12_bellas_label_008c7171:

    # ji "I've never gotten jewelry from a guy before."
    ji "我从没从男生那里收到过首饰。"

# episode12\update12.rpy:1876
translate schinese ep12_bellas_label_e8a074b3:

    # ji "Thank you, [name]."
    ji "谢谢，[name]."

# episode12\update12.rpy:1878
translate schinese ep12_bellas_label_57184c13:

    # mc "You're welcome."
    mc "不客气。"

# episode12\update12.rpy:1880
translate schinese ep12_bellas_label_d8404dab_1:

    # mc "Hold on a second. I have something for you."
    mc "等一下，我有个东西给你。"

# episode12\update12.rpy:1882
translate schinese ep12_bellas_label_175353e0_1:

    # mc "Merry Christmas, Jill."
    mc "圣诞快乐，Jill。"

# episode12\update12.rpy:1885
translate schinese ep12_bellas_label_3eefd84e:

    # mc "It's for your camera. I figured you could use some more film for it."
    mc "这是给你相机的。我想你可能需要更多胶卷。"

# episode12\update12.rpy:1887
translate schinese ep12_bellas_label_75bf0815:

    # ji "That's so thoughtful. Thank you, [name]."
    ji "你想得真周到。谢谢你，[name]。"

# episode12\update12.rpy:1889
translate schinese ep12_bellas_label_4c98d15e:

    # ji "(I don't have the heart to tell him it's the wrong kind...)"
    ji "（我没心肠告诉他这是错的种类……）"

# episode12\update12.rpy:1892
translate schinese ep12_bellas_label_a230b310:

    # mc "I hope you like chocolate truffles."
    mc "希望你喜欢巧克力软糖。"

# episode12\update12.rpy:1894
translate schinese ep12_bellas_label_396812eb:

    # ji "I do! Thank you, [name]. I'll make sure to enjoy these with some sparkling wine."
    ji "我确实！谢谢，[name]我会确保用香槟来好好享受这些。"

# episode12\update12.rpy:1896
translate schinese ep12_bellas_label_57184c13_1:

    # mc "You're welcome."
    mc "不客气。"

# episode12\update12.rpy:1900
translate schinese ep12_bellas_label_5f4cb5b8:

    # mc "Merry Christmas, Jill... I'm sorry, but I didn't get you anything."
    mc "圣诞快乐，Jill……对不起，我什么都没给你准备。"

# episode12\update12.rpy:1907
translate schinese ep12_bellas_label_b3aa14f2:

    # ji "It's ok, [name]. Don't feel bad."
    ji "没关系[name]别难过。"

# episode12\update12.rpy:1911
translate schinese ep12_bellas_label_ab2f534c:

    # js "Thanks, everyone, for the gifts. Merry Christmas!"
    js "谢谢大家的礼物，圣诞快乐！"

# episode12\update12.rpy:1913
translate schinese ep12_bellas_label_65e509b5:

    # "Merry Christmas!"
    "圣诞快乐！"

# episode12\update12.rpy:1914
translate schinese ep12_bellas_label_a21e4be2:

    # mc "{i}And that was our weird family's Christmas.{/i}"
    mc "{i}我们这怪异家庭的圣诞节。{/i}"

# episode12\update12.rpy:1918
translate schinese ep12_bellas_label_e6b1037f:

    # mc "{i}Derek said Christmas was all about traditions, but I don't think there will be another Christmas like this one.{/i}"
    mc "{i}Derek 说圣诞节全靠传统，但我以为不会有另一个像今年这样特别的圣诞节了。{/i}"

# episode12\update12.rpy:1920
translate schinese ep12_bellas_label_3244c9ae:

    # mc "{i}Dismemberment and dark revelations put aside... We had a nice time together.{/i}"
    mc "{i}肢解和黑暗的真相暂且搁置……我们在一起度过了愉快的时光。{/i}"

# episode12\update12.rpy:1934
translate schinese ep12_war_label_fb27a64c:

    # cop1 "Alright, I checked with central... The caller said they saw people peddling drugs at this address."
    cop1 "我跟中央确认过了，打电话的人说他们在这一带看到有人在这地址卖毒品。"

# episode12\update12.rpy:1936
translate schinese ep12_war_label_875ed9fc:

    # con "Who made the call?"
    con "谁打的电话？"

# episode12\update12.rpy:1938
translate schinese ep12_war_label_a8700805:

    # cop1 "It was an anonymous tip from a concerned citizen."
    cop1 "这是一条匿名市民提供的线索。"

# episode12\update12.rpy:1940
translate schinese ep12_war_label_3eb79c8c:

    # con "What else can you tell me about the call?"
    con "还有什么能告诉我关于那个电话的？"

# episode12\update12.rpy:1942
translate schinese ep12_war_label_3924f89d:

    # cop1 "Not much. It was a female - a young voice."
    cop1 "没什么。是个女人——声音挺年轻。"

# episode12\update12.rpy:1944
translate schinese ep12_war_label_f0e6071c:

    # con "A kid?"
    con "一个小孩？"

# episode12\update12.rpy:1946
translate schinese ep12_war_label_fb658b5c:

    # cop1 "A woman. You'll have to listen to the call; that's all I know about it."
    cop1 "一个女人。你得听那通电话；我只知道这些。"

# episode12\update12.rpy:1948
translate schinese ep12_war_label_03832ed7:

    # con "This isn't a busy street, especially not at this time."
    con "这可不是一条繁忙的街道，尤其现在这个时间更不凑巧。"

# episode12\update12.rpy:1949
translate schinese ep12_war_label_f67adf86:

    # con "And that place back there is hidden from the view of what little public there is."
    con "而且那地方背后面是藏在少数几个路人视线之外的。"

# episode12\update12.rpy:1951
translate schinese ep12_war_label_6a669391:

    # cop1 "What are you getting at?"
    cop1 "你到底想说什么？"

# episode12\update12.rpy:1953
translate schinese ep12_war_label_9f937294:

    # con "Can you spot that something is going on back there from where you're standing?"
    con "你能从你站着的位置看出后面有什么不对劲的地方吗？"

# episode12\update12.rpy:1957
translate schinese ep12_war_label_24a52144:

    # cop1 "No."
    cop1 "不。"

# episode12\update12.rpy:1959
translate schinese ep12_war_label_77a3f88f:

    # con "And what does that tell you?"
    con "那又说明了什么？"

# episode12\update12.rpy:1961
translate schinese ep12_war_label_a79bda74:

    # cop1 "You're the detective."
    cop1 "你是侦探。"

# episode12\update12.rpy:1963
translate schinese ep12_war_label_8c8f6b7f:

    # con "Well, with a specific address and all... It tells me the caller knows more about it than they let on."
    con "那家伙还报了具体地址，这说明他比自己表现的知道得更多。"

# episode12\update12.rpy:1965
translate schinese ep12_war_label_607d2d7c:

    # cop1 "A squeaker?"
    cop1 "一个响鼻？"

# episode12\update12.rpy:1967
translate schinese ep12_war_label_3ce940df:

    # con "Possibly."
    con "可能。"

# episode12\update12.rpy:1970
translate schinese ep12_war_label_3d12d1a3:

    # "*{i}Dog barking{/i}*"
    "*{i}狗叫{/i}*"

# episode12\update12.rpy:1972
translate schinese ep12_war_label_3ffff326:

    # fc "Detective Conti. We're done in there. It's all yours."
    fc "侦探康蒂。里面的事我们处理完了，现在全交给你了。"

# episode12\update12.rpy:1974
translate schinese ep12_war_label_34ef1fc7:

    # con "That was fast work."
    con "干得挺快的。"

# episode12\update12.rpy:1976
translate schinese ep12_war_label_3879aa98:

    # fc "More like pointless work. Sully got one whiff of the place and went crazy."
    fc "更像是白费功夫。苏利一闻到那个地方就发疯了。"

# episode12\update12.rpy:1977
translate schinese ep12_war_label_9f709e41:

    # fc "The tip seems accurate. My best bet is that the safe is used to store the drugs, but it's most likely airtight because Sully didn't react to it."
    fc "线索看起来挺准的。我猜保险箱应该用来藏毒品，不过很可能是个密闭的，因为苏利在那附近闻了闻也没发疯。"

# episode12\update12.rpy:1979
translate schinese ep12_war_label_960a054a:

    # con "The locksmith is working on it."
    con "锁匠正在处理。"

# episode12\update12.rpy:1980
translate schinese ep12_war_label_2aadfdb9:

    # con "What about the other rooms?"
    con "那其他房间呢？"

# episode12\update12.rpy:1982
translate schinese ep12_war_label_2d2308f9:

    # fc "Search them too. As I said, Sully wouldn't stop barking in there."
    fc "也搜一搜那些房间。我说过，苏利一进去就不停地叫。"

# episode12\update12.rpy:1988
translate schinese ep12_war_label_ed604721:

    # cop2 "Detective. Take a look at what I found."
    cop2 "侦探，看看我找到什么了。"

# episode12\update12.rpy:1990
translate schinese ep12_war_label_4cad5c44:

    # con "Let me guess. It's the ledger."
    con "让我猜猜，这本账本。"

# episode12\update12.rpy:1992
translate schinese ep12_war_label_7745b401:

    # cop2 "Yeah, but it's written in code."
    cop2 "嗯，不过这是用密码写的。"

# episode12\update12.rpy:1994
translate schinese ep12_war_label_4b51fbcf:

    # con "Code? These are drug dealers, not World War 2 Germans."
    con "代码？他们可是毒贩，不是二战时期的德国人。"

# episode12\update12.rpy:1996
translate schinese ep12_war_label_dce6e233:

    # cop2 "Well, it is code. But I think I cracked it."
    cop2 "嗯，算是破译了。"

# episode12\update12.rpy:1998
translate schinese ep12_war_label_778966c6:

    # cop2 "Look here..."
    cop2 "看这儿..."

# episode12\update12.rpy:1999
translate schinese ep12_war_label_9b31d85a:

    # cop2 "Those letters are short for what drugs they sold, and that's the quantity."
    cop2 "那些字母代表他们卖的是什么毒品，还有数量。"

# episode12\update12.rpy:2001
translate schinese ep12_war_label_a54cb9e6:

    # cop2 "And those nicknames: Fox, Wolf, Eagle, Ermine, Bulldog, Tiger..."
    cop2 "那些绰号：狐狸、狼、鹰、雪兔、斗牛犬、老虎……"

# episode12\update12.rpy:2002
translate schinese ep12_war_label_b998e707:

    # cop2 "They are the customers."
    cop2 "他们是顾客。"

# episode12\update12.rpy:2004
translate schinese ep12_war_label_017b252c:

    # con "..."
    con "..."

# episode12\update12.rpy:2006
translate schinese ep12_war_label_d32dea14:

    # con "No. That's not what it is."
    con "这不就是那个意思。"

# episode12\update12.rpy:2008
translate schinese ep12_war_label_681e0f49:

    # cop2 "I'm sorry, detective. But you're mistaken. Look..."
    cop2 "抱歉，警探。但你是错的。看吧..."

# episode12\update12.rpy:2009
translate schinese ep12_war_label_97b6149b:

    # cop2 "The nicknames are recurring. Page after page. Wolf, Ermine, Tiger, Bulldog..."
    cop2 "这些绰号反复出现。一页又一页。狼、雪兔、老虎、斗牛犬……"

# episode12\update12.rpy:2011
translate schinese ep12_war_label_902805eb:

    # con "How many years have you been on the force?"
    con "你当了几年警察？"

# episode12\update12.rpy:2013
translate schinese ep12_war_label_82c554df:

    # cop2 "I'm closing in on four years."
    cop2 "我快满四年了。"

# episode12\update12.rpy:2015
translate schinese ep12_war_label_da2a0b7a:

    # con "Then, I take it you've seen your fair share of drug dens."
    con "那你是见过不少毒品窝点了吧。"

# episode12\update12.rpy:2017
translate schinese ep12_war_label_40b0dca3:

    # cop2 "Of course, sir. I've worked as a first responder on a couple of occasions."
    cop2 "当然，先生。我几次担任过第一响应者。"

# episode12\update12.rpy:2019
translate schinese ep12_war_label_39cf8dbd:

    # con "With your experience in mind..."
    con "有你这样的经验在身……"

# episode12\update12.rpy:2020
translate schinese ep12_war_label_25ee6ddc:

    # con "Tell me which kind of customer buys that amount every other week."
    con "告诉我哪种客户每周隔周都会买这么多毒品。"

# episode12\update12.rpy:2024
translate schinese ep12_war_label_47c68f8a:

    # con "It would be a dead customer."
    con "这可就不是普通用户了。"

# episode12\update12.rpy:2026
translate schinese ep12_war_label_a460ac67:

    # cop2 "That's too much drugs for personal use... You're right."
    cop2 "那家伙的用量太多了，根本不是自己用的……你说得对。"

# episode12\update12.rpy:2028
translate schinese ep12_war_label_532601ea:

    # con "I tend to be."
    con "我倾向于这样。"

# episode12\update12.rpy:2030
translate schinese ep12_war_label_e7546d89:

    # con "The names in that ledger are henchmen. And the guy we arrested is their boss."
    con "那本账本上的名字都是手下。而我们抓到的那个家伙是他们的老大。"

# episode12\update12.rpy:2032
translate schinese ep12_war_label_8c80c17d:

    # con "And that safe holds the motherlode."
    con "而且那个保险箱里装着大笔财富。"

# episode12\update12.rpy:2033
translate schinese ep12_war_label_f2af8a7b:

    # con "And based on that ledger, it should be a sight to behold."
    con "而且根据那本账本，那场面绝对值得一看。"

# episode12\update12.rpy:2035
translate schinese ep12_war_label_2c13be63:

    # cop2 "You're not saying they stored all their money and drugs in that safe, are you?"
    cop2 "你是不是在说他们把所有钱和毒品都存在那个保险箱里了？"

# episode12\update12.rpy:2036
translate schinese ep12_war_label_0d6eda0b:

    # cop2 "You can see it as soon as you walk inside."
    cop2 "你一进门就能看到。"

# episode12\update12.rpy:2041
translate schinese ep12_war_label_3750b96f:

    # con "Look at how disgusting this place is. How do you live like this?"
    con "看看这地方有多恶心，你怎么能住在这里？"

# episode12\update12.rpy:2042
translate schinese ep12_war_label_f96aedad:

    # con "Like I said, they are mere drug dealers. There's nothing genius about this. However, the nicknames are a cute touch."
    con "就像我刚才说的，他们不过是一群毒贩，这事儿没什么聪明可言。不过那些外号倒是很可爱。"

# episode12\update12.rpy:2046
translate schinese ep12_war_label_eb811605:

    # lc "And Bob's your uncle."
    lc "那就是了。"

# episode12\update12.rpy:2050
translate schinese ep12_war_label_d5d6c592:

    # cop2 "Is that it? How anti-climactic..."
    cop2 "这样就完了？怎么这么平淡无奇……"

# episode12\update12.rpy:2052
translate schinese ep12_war_label_77c993a6:

    # con "Hm..."
    con "嗯……"

# episode12\update12.rpy:2054
translate schinese ep12_war_label_12a899a3:

    # cop2 "What did you call it again? The motherlode?"
    cop2 "你刚才说的叫什么来着？母矿？"

# episode12\update12.rpy:2056
translate schinese ep12_war_label_5b3bb934:

    # con "Alright there, Enigma machine... I never said we arrested a kingpin. As it appears, we simply arrested a middleman."
    con "好吧，谜语人，我可没说我们抓到了大毒枭。看起来我们只是抓到了中间人而已。"

# episode12\update12.rpy:2057
translate schinese ep12_war_label_34cf80d0:

    # con "If those packages contain what I suspect, it's enough for a conviction."
    con "如果那些包裹里装着我怀疑的东西，就足以构成定罪。"

# episode12\update12.rpy:2058
translate schinese ep12_war_label_6b798731:

    # con "And maybe we can find out who the big fish is."
    con "也许我们能查出那个大鱼是谁。"

# episode12\update12.rpy:2060
translate schinese ep12_war_label_3c660429:

    # cop2 "*{i}Mumbles{/i}* Mr. Right, huh?"
    cop2 "*{i}嘟囔{/i}* 真命天子，是吧？"

# episode12\update12.rpy:2062
translate schinese ep12_war_label_f1cb4cbd:

    # cop2 "Detective? What about this?"
    cop2 "侦探？那这个呢？"

# episode12\update12.rpy:2064
translate schinese ep12_war_label_8e4208a6:

    # con "That's evidence. Bag it and leave it for the interrogation. And don't touch any more evidence without wearing gloves."
    con "这是证据。打包起来，留到审讯时用。别再没戴手套就碰任何证据了。"

# episode12\update12.rpy:2065
translate schinese ep12_war_label_44d5399d:

    # con "*{i}Mumbles{/i}* Four years on the force..."
    con "*{i}嘟囔{/i}*四年在警队打拼..."

# episode12\update12.rpy:2093
translate schinese ep12_war_label_51c91d11:

    # mc "Quinn?"
    mc "Quinn？"

# episode12\update12.rpy:2095
translate schinese ep12_war_label_c9004842:

    # qu "Did I wake you up?"
    qu "你把我吵醒了？"

# episode12\update12.rpy:2097
translate schinese ep12_war_label_e0fd8490:

    # mc "Yeah, but it's fine. What's wrong?"
    mc "嗯，但没关系。怎么了？"

# episode12\update12.rpy:2099
translate schinese ep12_war_label_b6a6a33a:

    # qu "Nothing is wrong. I...needed to hear your voice."
    qu "没什么事。我……需要听听你的声音。"

# episode12\update12.rpy:2101
translate schinese ep12_war_label_34ce789e:

    # mc "I'm right here."
    mc "我在这儿呢。"

# episode12\update12.rpy:2103
translate schinese ep12_war_label_30b1b0c9:

    # qu "How was your night?"
    qu "你昨晚过得怎么样？"

# episode12\update12.rpy:2105
translate schinese ep12_war_label_564f8ddb:

    # mc "Um... I was at a Christmas party with my friends."
    mc "嗯……我跟朋友们去参加了圣诞派对。"

# episode12\update12.rpy:2106
translate schinese ep12_war_label_04abbf2c:

    # mc "It was...an eventful evening. Derek chopped a part of his finger off with a sword."
    mc "那晚……挺刺激的。Derek用剑砍掉了自己手指的一部分。"

# episode12\update12.rpy:2108
translate schinese ep12_war_label_f8a354fa:

    # qu "Whoa... Is he ok?"
    qu "哇...他没事吧？"

# episode12\update12.rpy:2110
translate schinese ep12_war_label_95e61f73:

    # mc "After the trip to the hospital, yeah. They closed the wound, but he lost his fingertip for good."
    mc "去医院处理了一下，嗯。他们缝了伤口，但他那只手指头算是彻底保不住了。"

# episode12\update12.rpy:2112
translate schinese ep12_war_label_46bd428a:

    # qu "Shit. That must suck."
    qu "这他妈的真他妈的惨。"

# episode12\update12.rpy:2114
translate schinese ep12_war_label_ada8ffba:

    # mc "Yeah. He was high on painkillers for the rest of the night. We'll see how he feels tomorrow."
    mc "嗯，他整晚都在止痛药的作用下。我们得看看他明天感觉怎么样。"

# episode12\update12.rpy:2116
translate schinese ep12_war_label_ef139ffc:

    # qu "I haven't talked to him much, but he's a good guy."
    qu "我跟他没聊太多，但这家伙挺不错的。"

# episode12\update12.rpy:2117
translate schinese ep12_war_label_fceb3cf2:

    # qu "I remember how mad he got at me during Hell Week, when we pranked him."
    qu "我还记得地狱周时，我们捉弄他以后，他对我有多生气。"

# episode12\update12.rpy:2119
translate schinese ep12_war_label_5e7c7dc2:

    # mc "Which prank?"
    mc "哪个恶作剧？"

# episode12\update12.rpy:2121
translate schinese ep12_war_label_bdcde0a2:

    # qu "The same one we pulled on you. Tommy sent him to get underwear from us, and we made him strip nude before we threw his ass out on the streets."
    qu "同样的那个恶作剧。Tommy派他去我们这儿拿内裤，然后我们让他光着身子才放他走。"

# episode12\update12.rpy:2123
translate schinese ep12_war_label_6ba79868:

    # mc "Oh, that one. Yeah... Honestly, he's still not over it. Haha..."
    mc "哦，那个啊。嗯……说实话，他到现在还没放下这事。哈哈……"

# episode12\update12.rpy:2125
translate schinese ep12_war_label_998f6e20:

    # qu "I guess it rubbed him the wrong way."
    qu "我想他当时挺不爽的。"

# episode12\update12.rpy:2127
translate schinese ep12_war_label_dba64bc8:

    # mc "Kinda. But he doesn't talk badly about you."
    mc "算是吧。不过他说起你时并没有恶言相向。"

# episode12\update12.rpy:2129
translate schinese ep12_war_label_2b630b13:

    # qu "Wouldn't be anything I haven't heard before."
    qu "这话说得没错，我以前也听过不少。"

# episode12\update12.rpy:2131
translate schinese ep12_war_label_9ad711ba:

    # mc "Are you sure you're all right?"
    mc "你确定你没事吗？"

# episode12\update12.rpy:2133
translate schinese ep12_war_label_898e2650:

    # qu "I feel better now."
    qu "我现在感觉好多了。"

# episode12\update12.rpy:2135
translate schinese ep12_war_label_2ab26a1f:

    # mc "Listen, I thought about our last talk..."
    mc "听着，我仔细想了想我们上次的谈话……"

# episode12\update12.rpy:2137
translate schinese ep12_war_label_060c6a4f:

    # qu "Yeah?"
    qu "嗯？"

# episode12\update12.rpy:2139
translate schinese ep12_war_label_d982724b:

    # mc "I suppose there's nothing I can say to make you change your mind..."
    mc "我想说点什么来改变你的主意，但可能也没用。"

# episode12\update12.rpy:2140
translate schinese ep12_war_label_43faf28b:

    # mc "About the revenge and everything... Maybe there's another way to go."
    mc "关于复仇和那些事……也许还有别的办法。"

# episode12\update12.rpy:2142
translate schinese ep12_war_label_b2b7de5a:

    # qu "You're a little late for that."
    qu "你来得有点晚了。"

# episode12\update12.rpy:2144
translate schinese ep12_war_label_612c8ba9:

    # mc "What do you mean? Did you do something?"
    mc "你是什么意思？你做了什么？"

# episode12\update12.rpy:2146
translate schinese ep12_war_label_301eb94b:

    # qu "Doing something. Tonight."
    qu "做点什么。今晚。"

# episode12\update12.rpy:2148
translate schinese ep12_war_label_966fafaa:

    # mc "Did you call because you needed me? I'll come."
    mc "你打电话是想让我过来？我这就去。"

# episode12\update12.rpy:2150
translate schinese ep12_war_label_cc7d9657:

    # qu "No. Like I said, I needed to hear your voice."
    qu "没错，就像我刚才说的，我需要听到你的声音。"

# episode12\update12.rpy:2152
translate schinese ep12_war_label_7b1c2629:

    # mc "I won't be able to sleep now. Where are you?"
    mc "现在睡不着了。你在哪里？"

# episode12\update12.rpy:2154
translate schinese ep12_war_label_be47d936:

    # qu "Don't worry, [name]. It won't be dangerous. I'm cautious."
    qu "别担心，[name]这不会很危险。我小心谨慎。"

# episode12\update12.rpy:2156
translate schinese ep12_war_label_e5e9d4f2:

    # mc "Can you at least tell me what you're up to?"
    mc "你至少能告诉我你在干什么吗？"

# episode12\update12.rpy:2158
translate schinese ep12_war_label_cd292c27:

    # qu "Not over the phone."
    qu "电话里不行。"

# episode12\update12.rpy:2160
translate schinese ep12_war_label_5a58b6d3:

    # mc "Can you call me when you're done, or give me a time frame when I should start worrying?"
    mc "你做完就给我打个电话，或者告诉我个时间，我好知道什么时候开始担心。"

# episode12\update12.rpy:2162
translate schinese ep12_war_label_2ad93e35:

    # qu "Usually, I can't stand it when someone treats me like this."
    qu "通常我受不了有人这样对待我。"

# episode12\update12.rpy:2163
translate schinese ep12_war_label_e1dbfdbb:

    # qu "The whole coddling shit and feeling the need to protect me... I hate it."
    qu "这整套照顾我的劲儿，还有非要保护我的感觉……我他妈真烦。"

# episode12\update12.rpy:2165
translate schinese ep12_war_label_d7eb01c3:

    # mc "I can't help it. That's how I am."
    mc "我管不住自己。这就是我这人。"

# episode12\update12.rpy:2167
translate schinese ep12_war_label_d31a9a62:

    # qu "I said usually..."
    qu "我说通常..."

# episode12\update12.rpy:2168
translate schinese ep12_war_label_935dd55f:

    # qu "I hate to admit it, but... It does feel nice coming from you."
    qu "我真不想承认，但……从你这儿说出来确实挺舒服的。"

# episode12\update12.rpy:2170
translate schinese ep12_war_label_26732358:

    # mc "I do care."
    mc "我确实关心。"

# episode12\update12.rpy:2172
translate schinese ep12_war_label_3efffb93:

    # qu "I know. And for a long time, I didn't want you to."
    qu "我知道。而且很久以来，我都希望你不要。"

# episode12\update12.rpy:2175
translate schinese ep12_war_label_7668a293:

    # mc "Fuck... Quinn..."
    mc "操... Quinn..."

# episode12\update12.rpy:2177
translate schinese ep12_war_label_df997a3b:

    # qu "What?"
    qu "什么？"

# episode12\update12.rpy:2179
translate schinese ep12_war_label_690cbf33:

    # mc "There's something I have to tell you..."
    mc "有什么事要告诉我..."

# episode12\update12.rpy:2180
translate schinese ep12_war_label_cf9b957f:

    # mc "I'm getting back together with my ex."
    mc "我跟前女友重新在一起了。"

# episode12\update12.rpy:2184
translate schinese ep12_war_label_6d56c120:

    # mc "We recently reconnected, and I have unresolved feelings for her."
    mc "我们最近重新联系上了，我对她还有没解决的感觉。"

# episode12\update12.rpy:2185
translate schinese ep12_war_label_6cef66f4:

    # mc "I didn't want to tell you like this, and after our last talk, it didn't feel like I would have to."
    mc "我不想在这种情况下告诉你，而且在我们上次谈话之后，我觉得我也不用再说了。"

# episode12\update12.rpy:2187
translate schinese ep12_war_label_225b6c88:

    # mc "I felt you trusted me and all, but lately you haven't been around much, and that put me off."
    mc "我感觉你一直信任我，但最近你没怎么出现，这让我有点不爽。"

# episode12\update12.rpy:2188
translate schinese ep12_war_label_918fea83:

    # mc "I'm sorry."
    mc "对不起。"

# episode12\update12.rpy:2192
translate schinese ep12_war_label_c6959196:

    # mc "Quinn? Are you still there?"
    mc "Quinn？你还在吗？"

# episode12\update12.rpy:2194
translate schinese ep12_war_label_f29bea98:

    # qu "I'm sorry for treating you like that."
    qu "我之前那样对你，真的很抱歉。"

# episode12\update12.rpy:2196
translate schinese ep12_war_label_e224c56f:

    # mc "I know you have your reasons."
    mc "我知道你有你的理由。"

# episode12\update12.rpy:2198
translate schinese ep12_war_label_da9b11c5:

    # qu "It's for the best anyway."
    qu "这本来就是最好的结果。"

# episode12\update12.rpy:2199
translate schinese ep12_war_label_dcab7710:

    # qu "I'd only get you into trouble."
    qu "我只会让你惹上麻烦。"

# episode12\update12.rpy:2201
translate schinese ep12_war_label_216832ff:

    # mc "I'm not cut out for that, yeah?"
    mc "我可干不了那种事，对吧？"

# episode12\update12.rpy:2203
translate schinese ep12_war_label_27505ddc:

    # qu "You're not."
    qu "你不是。"

# episode12\update12.rpy:2207
translate schinese ep12_war_label_96d586a8:

    # qu "You should go back to sleep."
    qu "你该回去睡觉了。"

# episode12\update12.rpy:2209
translate schinese ep12_war_label_78f932e3:

    # mc "Stay safe..."
    mc "保重啊..."

# episode12\update12.rpy:2211
translate schinese ep12_war_label_d54ac797:

    # qu "I will. Good night."
    qu "我会的。晚安。"

# episode12\update12.rpy:2217
translate schinese ep12_war_label_9101c2e7:

    # mc "But now you do."
    mc "但现在你确实这么做了。"

# episode12\update12.rpy:2219
translate schinese ep12_war_label_14a02946:

    # qu "Don't push it."
    qu "别太过分。"

# episode12\update12.rpy:2221
translate schinese ep12_war_label_ab0e2ba0:

    # mc "If you were at home right now, I'd come over and kiss you."
    mc "如果你现在在家的话，我真想过去亲你一口。"

# episode12\update12.rpy:2223
translate schinese ep12_war_label_a5ef78e8:

    # qu "Well, I'm not. I'll be back tomorrow."
    qu "我可没那意思。我明天就回来。"

# episode12\update12.rpy:2225
translate schinese ep12_war_label_21210045:

    # mc "I've missed you."
    mc "我想你了。"

# episode12\update12.rpy:2227
translate schinese ep12_war_label_8f9f136e:

    # qu "Fucking broccoli, dude."
    qu "操，这破西兰花，哥们。"

# episode12\update12.rpy:2229
translate schinese ep12_war_label_ca4e7b15:

    # mc "It's not in public. Hell, it's not even face-to-face."
    mc "这不是在公众场合。要死，连面对面都不是。"

# episode12\update12.rpy:2231
translate schinese ep12_war_label_233cac9f:

    # qu "I'm not saying it back."
    qu "我没说。"

# episode12\update12.rpy:2233
translate schinese ep12_war_label_2cbfdab6:

    # mc "But you did too... Didn't you?"
    mc "但你也是...你不是也这样吗？"

# episode12\update12.rpy:2235
translate schinese ep12_war_label_76135072:

    # qu "What do you think?"
    qu "你觉得呢？"

# episode12\update12.rpy:2237
translate schinese ep12_war_label_20fe07dc:

    # mc "I knew it."
    mc "我知道了。"

# episode12\update12.rpy:2239
translate schinese ep12_war_label_96d586a8_1:

    # qu "You should go back to sleep."
    qu "你该回去睡觉了。"

# episode12\update12.rpy:2241
translate schinese ep12_war_label_ba9470d2:

    # mc "Send me something after you're done with whatever you're doing."
    mc "做完你那事之后给我发点东西。"

# episode12\update12.rpy:2243
translate schinese ep12_war_label_d54ac797_1:

    # qu "I will. Good night."
    qu "我会的。晚安。"

# episode12\update12.rpy:2253
translate schinese ep12_war_label_4721a030:

    # "*{i}Alarm beeps{/i}*"
    "*{i}警报声响起{/i}*"

# episode12\update12.rpy:2285
translate schinese ep12_war_label_15de524f:

    # rx "{i}I outsmarted you. By dangling something obvious and valuable in front of you...{/i}"
    rx "{i}我骗过了你。我故意把明显且有价值的东西挂在你面前...{/i}"

# episode12\update12.rpy:2286
translate schinese ep12_war_label_3f095f58:

    # rx "{i}...you didn't see what I tried to hide.{/i}"
    rx "{i}……你没看到我试图隐藏的东西。{/i}"

# episode12\update12.rpy:2288
translate schinese ep12_war_label_140a3598:

    # rx "{i}You've seen Daddy's safe, right? I wanna show you something.{/i}"
    rx "{i}你见过爸爸的保险箱吗？我想给你看看点东西。{/i}"

# episode12\update12.rpy:2289
translate schinese ep12_war_label_1b742e07:

    # rx "{i}And not a word to your mom, ok?{/i}"
    rx "{i}别跟你的老妈说，明白吗？{/i}"

# episode12\update12.rpy:2308
translate schinese ep12_war_label_ceb9ed7b:

    # rx "{i}Remember when you were born. Easy, huh?{/i}"
    rx "{i}记得你刚出生的时候。那么容易吗？{/i}"

# episode12\update12.rpy:2310
translate schinese ep12_war_label_1672e4fd:

    # rx "{i}My precious is guarding what's precious to me.{/i}"
    rx "{i}我珍贵的在守护我珍视的东西。{/i}"

# episode12\update12.rpy:2322
translate schinese ep12_war_label_ba5a01a4:

    # dl1 "Yeah, they got the decoy safe."
    dl1 "嗯，他们搞到了假保险箱。"

# episode12\update12.rpy:2324
translate schinese ep12_war_label_def845d2:

    # dl1 "Well, it was supposed to be a decoy safe, but Buddy got lazy at times. Beats me how much drugs and money he kept in it."
    dl1 "嗯，本来这保险箱是假的，但Buddy有时候挺懒的。我真搞不懂他里面到底藏了多少毒品和钱。"

# episode12\update12.rpy:2325
translate schinese ep12_war_label_efa35e95:

    # dl1 "Yeah, they probably got the ledger too."
    dl1 "嗯，他们大概也拿到了账本。"

# episode12\update12.rpy:2326
translate schinese ep12_war_label_e0afb9a9:

    # dl1 "Shit, I don't know! I think he kept it in there when he wasn't using it."
    dl1 "操，我真不知道！我想他不用的时候就把它藏在里面了。"

# episode12\update12.rpy:2328
translate schinese ep12_war_label_744036d2:

    # dl1 "My money is on a snitch."
    dl1 "我赌是告密者。"

# episode12\update12.rpy:2329
translate schinese ep12_war_label_64fa2adb:

    # dl1 "I have my suspicions."
    dl1 "我有我的怀疑。"

# episode12\update12.rpy:2331
translate schinese ep12_war_label_623455da:

    # dl1 "It could be one of the dealers getting revenge."
    dl1 "可能是其中一个毒贩在报复。"

# episode12\update12.rpy:2333
translate schinese ep12_war_label_33ca0f9e:

    # dl1 "Well, one fucker overcharged and pocketed the money, and that's because the other one started it and passed the idea on."
    dl1 "好吧，一个混蛋多收了钱还揣起来了，这都是因为另一个家伙先起头，然后传了这个主意下去。"

# episode12\update12.rpy:2334
translate schinese ep12_war_label_64ae0b73:

    # dl1 "We straightened him out, but the dude holds grudges."
    dl1 "我们把他教育了一番，但这家伙记仇。"

# episode12\update12.rpy:2336
translate schinese ep12_war_label_c0057f89:

    # dl1 "And get this... He ratted the other one out for doing the same thing he did. Snitching is his style."
    dl1 "而且更绝的是，他举报了另一个家伙，说他干了跟自己一模一样事儿。举报别人是他的风格。"

# episode12\update12.rpy:2337
translate schinese ep12_war_label_63df60d4:

    # dl1 "It wouldn't surprise me if he snitched on Buddy, too. Buddy cut his face up with a kitchen knife."
    dl1 "他很可能也举报了Buddy。Buddy用厨房刀划了他的脸。"

# episode12\update12.rpy:2339
translate schinese ep12_war_label_79fd234e:

    # dl1 "I'll look into it."
    dl1 "我这就查查。"

# episode12\update12.rpy:2340
translate schinese ep12_war_label_483296db:

    # dl1 "Yeah. Hold on. I'll check the main safe."
    dl1 "嗯，等一下。我去主保险箱看看。"

# episode12\update12.rpy:2344
translate schinese ep12_war_label_731b1b63:

    # dl1 "Fuck! They got this one, too."
    dl1 "操！他们也抓到他了。"

# episode12\update12.rpy:2346
translate schinese ep12_war_label_c33ce327:

    # dl1 "It's cleaned out. They searched everywhere. Fucking pigs!"
    dl1 "搞定了。他们翻遍了每个角落。操，这群猪！"

# episode12\update12.rpy:2347
translate schinese ep12_war_label_e3cd9521:

    # dl1 "Yeah. Buddy is in real trouble now. He could be a liability, but I don't think he would talk. Well, maybe he would, if he wanted to save his ass."
    dl1 "对，老兄现在麻烦大了。他可能会成为隐患，不过我觉得他不会开口。当然，如果是为了保住自己，也说不准。"

# episode12\update12.rpy:2348
translate schinese ep12_war_label_dc97faf5:

    # dl1 "No, no! Fuck him! I ain't loyal to him."
    dl1 "不，不！操他！我可不忠于他。"

# episode12\update12.rpy:2349
translate schinese ep12_war_label_8e7cb3cd:

    # dl1 "What do you want me to do? Name it."
    dl1 "你想让我怎么做？直接说吧。"

# episode12\update12.rpy:2351
translate schinese ep12_war_label_c56d44c1:

    # dl1 "Yeah. Got it. I'll let you know what I find out."
    dl1 "嗯，搞定了。我会告诉你我查到的消息。"

# episode12\update12.rpy:2352
translate schinese ep12_war_label_e0635844:

    # dl1 "What are you gonna do about Buddy?"
    dl1 "你打算怎么对付Buddy？"

# episode12\update12.rpy:2353
translate schinese ep12_war_label_1beca2bf:

    # dl1 "Hello?"
    dl1 "你好？"

# episode12\update12.rpy:2355
translate schinese ep12_war_label_0c6be1df:

    # dl1 "Fuck..."
    dl1 "操的。"

# episode12\update12.rpy:2391
translate schinese ep12_bd_label_96b970cb:

    # con "Good morning. I'm Detective Conti. Can you state your name for the record, please?"
    con "早上好。我是探长康蒂。请报上你的名字。"

# episode12\update12.rpy:2393
translate schinese ep12_bd_label_c3ffe4ff:

    # bd "..."
    bd "..."

# episode12\update12.rpy:2395
translate schinese ep12_bd_label_b9108994:

    # bd "Buddy."
    bd "老兄。"

# episode12\update12.rpy:2397
translate schinese ep12_bd_label_fe1bf729:

    # con "I meant your full legal name."
    con "你完整的正式名字。"

# episode12\update12.rpy:2399
translate schinese ep12_bd_label_c3ffe4ff_1:

    # bd "..."
    bd "..."

# episode12\update12.rpy:2401
translate schinese ep12_bd_label_8603d053:

    # con "Don't be difficult with me. I've had a long night."
    con "别跟我耍花样。我昨晚熬了一整夜。"

# episode12\update12.rpy:2402
translate schinese ep12_bd_label_aa16095c:

    # con "Besides, I already know most things about you."
    con "况且，我早就知道你很多事了。"

# episode12\update12.rpy:2405
translate schinese ep12_bd_label_ce761a6e:

    # con "Robert Dabbs. Also known as Robert Bobby Dabbs and Buddy."
    con "罗伯特·达布斯。也叫罗伯特·鲍比·达布斯，还有Buddy。"

# episode12\update12.rpy:2406
translate schinese ep12_bd_label_cc4be670:

    # con "Born in Minnesota. Spent 3 years in juvie due to substance abuse."
    con "生于明尼苏达州，在少年监狱待了三年，因为毒品滥用。"

# episode12\update12.rpy:2407
translate schinese ep12_bd_label_933aafbf:

    # con "During your time in juvie, you were accused of poisoning a fellow offender with fentanyl, but didn't face any charges because of a lack of evidence."
    con "在少年监狱期间，你被指控用芬太尼毒害了一名同囚犯，但因为证据不足，最终没有被起诉。"

# episode12\update12.rpy:2409
translate schinese ep12_bd_label_7fa45f89:

    # con "A couple of misdemeanors along the road and a big blank space on your record since."
    con "几起小罪案，然后你档案上就一片空白了。"

# episode12\update12.rpy:2410
translate schinese ep12_bd_label_e5a8d882:

    # con "Hell, your last known address is still in Minnesota, and now you resurface here."
    con "见鬼，你上次的地址还在明尼苏达，现在又突然出现在这里。"

# episode12\update12.rpy:2412
translate schinese ep12_bd_label_156fa709:

    # con "Tell me, Robert. What have you been up to lately?"
    con "跟我说说，罗伯特，最近你都在干什么？"

# episode12\update12.rpy:2414
translate schinese ep12_bd_label_0803b2a4:

    # bd "You seem to be the man with all the answers. You tell me."
    bd "你看起来像是个知道一切的人。你告诉我。"

# episode12\update12.rpy:2416
translate schinese ep12_bd_label_75c30997:

    # con "So, you're living on Easy Street these days?"
    con "现在你日子过得挺舒坦啊？"

# episode12\update12.rpy:2418
translate schinese ep12_bd_label_d3526223:

    # bd "I hang out there."
    bd "我就待在那里。"

# episode12\update12.rpy:2420
translate schinese ep12_bd_label_14ae3462:

    # con "Come on. You do more than hang out there."
    con "行啊，你可不止是去那儿晃悠。"

# episode12\update12.rpy:2422
translate schinese ep12_bd_label_a841f332:

    # bd "You lost me."
    bd "我搞不懂你在说什么。"

# episode12\update12.rpy:2424
translate schinese ep12_bd_label_373b0fed:

    # con "We found your fingerprints all over the place."
    con "我们在那些毒品上发现了你的指纹。"

# episode12\update12.rpy:2426
translate schinese ep12_bd_label_ddeb3787:

    # bd "What can I tell you?"
    bd "我能说什么呢？"

# episode12\update12.rpy:2429
translate schinese ep12_bd_label_cd9df359:

    # con "You can tell me about the drugs we found in the safe. They have your fingerprints on them, too."
    con "你可以跟我说说我们在保险箱里找到的那些毒品。它们上面也有你的指纹。"

# episode12\update12.rpy:2430
translate schinese ep12_bd_label_e052f09f:

    # con "Or the illegal firearm. Or the money. There was a lot of cash in that safe."
    con "或者这把非法枪支。或者这些钱。那个保险箱里有一大堆现金。"

# episode12\update12.rpy:2437
translate schinese ep12_bd_label_68190f55:

    # con "Or this. This is yours, too, yeah?"
    con "或者这个。这个也是你的，对吧？"

# episode12\update12.rpy:2439
translate schinese ep12_bd_label_58f1c220:

    # con "Bulldog. Fox. Tiger. Ermine. Eagle..."
    con "狗头. 狐狸. 老虎. 水獭. 鹰..."

# episode12\update12.rpy:2440
translate schinese ep12_bd_label_d32705fb:

    # con "I'm trying to figure out what these scribbles mean. Care to enlighten me?"
    con "我正试着弄清楚这些涂鸦是什么意思。你愿意告诉我吗？"

# episode12\update12.rpy:2442
translate schinese ep12_bd_label_8b7a55b8:

    # bd "I'm an animal lover."
    bd "我是个动物爱好者。"

# episode12\update12.rpy:2444
translate schinese ep12_bd_label_acc0eadc:

    # con "Haha! You're a funny guy."
    con "哈哈！你挺会整活的。"

# episode12\update12.rpy:2446
translate schinese ep12_bd_label_d6f1ec37:

    # con "I wonder, will you be the funny guy in prison, too?"
    con "你也会在监狱里当个搞笑的人吗？"

# episode12\update12.rpy:2447
translate schinese ep12_bd_label_235c0d14:

    # con "You have to be really funny to survive in there."
    con "你得在那儿活得挺有意思才行。"

# episode12\update12.rpy:2449
translate schinese ep12_bd_label_421ec9a6:

    # con "We both know what this ledger is. And we can link you to everything we found."
    con "我们俩都清楚这本账本是干什么用的。而且我们能把你和我们找到的一切都联系起来。"

# episode12\update12.rpy:2451
translate schinese ep12_bd_label_dc33c3c4:

    # con "You're going away, Robert, for a long time."
    con "你得在里面待上很久，罗伯特。"

# episode12\update12.rpy:2452
translate schinese ep12_bd_label_fd3fbffd:

    # con "And prison isn't like juvie either."
    con "而且监狱也不像少年犯管教所那样。"

# episode12\update12.rpy:2454
translate schinese ep12_bd_label_2b4ca535:

    # con "If you keep being difficult with me, it will be reflected in your sentence."
    con "如果你继续跟我顶牛，你的刑期会更长。"

# episode12\update12.rpy:2455
translate schinese ep12_bd_label_c173eb69:

    # con "But if you cooperate and tell me where you got the drugs from, maybe we can work something out."
    con "但如果你配合，告诉我你从哪儿弄到的毒品，也许我们还能商量个办法。"

# episode12\update12.rpy:2456
translate schinese ep12_bd_label_f3115b5a:

    # con "It's all up to you."
    con "这全看你的了。"

# episode12\update12.rpy:2458
translate schinese ep12_bd_label_a5c31369:

    # bd "I want a lawyer."
    bd "我要请律师。"

# episode12\update12.rpy:2461
translate schinese ep12_bd_label_d474ec86:

    # con "Now, that's the first smart thing you've said so far."
    con "现在这是你到目前为止说的第一句聪明话。"

# episode12\update12.rpy:2470
translate schinese ep12_prl_label_bc88aaf2:

    # tan "See you on Thursday!"
    tan "周四见！"

# episode12\update12.rpy:2472
translate schinese ep12_prl_label_77bff304:

    # nic "Bye, Tania."
    nic "拜拜，Tania。"

# episode12\update12.rpy:2478
translate schinese ep12_prl_label_e663a28c:

    # nic "Are you doing ok?"
    nic "你今晚还好吗？"

# episode12\update12.rpy:2480
translate schinese ep12_prl_label_f3c27d78:

    # ly "Yeah."
    ly "嗯。"

# episode12\update12.rpy:2482
translate schinese ep12_prl_label_c4ae5bcc:

    # nic "Are you sure? You seem off tonight."
    nic "你确定吗？你今晚看起来不太对劲。"

# episode12\update12.rpy:2484
translate schinese ep12_prl_label_a9fd7488:

    # ly "Why are you overly concerned? I said I was fine."
    ly "你怎么这么担心？我说了自己没事。"

# episode12\update12.rpy:2486
translate schinese ep12_prl_label_c772c117:

    # nic "I'm just making sure, considering..."
    nic "我只是担心，考虑到……"

# episode12\update12.rpy:2488
translate schinese ep12_prl_label_1c871203:

    # ly "Give it a rest. [name] and I had fun together; there was nothing more to it."
    ly "别再提了。[name]和我只是一起玩得很开心，没有别的。"

# episode12\update12.rpy:2489
translate schinese ep12_prl_label_9e7869ca:

    # ly "If you think that he's boyfriend material...you should go for it."
    ly "如果你觉得他有当男朋友的料，那你去追吧。"

# episode12\update12.rpy:2491
translate schinese ep12_prl_label_151c8e48:

    # nic "I'm trying to find out if he is boyfriend material, but I couldn't do that if you two were together."
    nic "我在试着确认他是不是当男朋友的料，但如果你们俩已经在一起了，我也没法这么做。"

# episode12\update12.rpy:2493
translate schinese ep12_prl_label_f700a856:

    # ly "We weren't together. We were having sex, it's not the same thing."
    ly "我们没在一起。我们只是在发生关系，这根本不是一回事。"

# episode12\update12.rpy:2495
translate schinese ep12_prl_label_6094d1f8:

    # nic "Yeah, but I don't want there to be any bad blood between us."
    nic "那倒是，但我可不想我们之间有什么隔阂。"

# episode12\update12.rpy:2497
translate schinese ep12_prl_label_74c3ec25:

    # ly "Look. What I think doesn't even matter. He chose you, didn't he?"
    ly "看吧，我怎么想都不重要。他选了你，不是吗？"

# episode12\update12.rpy:2499
translate schinese ep12_prl_label_9e0ea4b4:

    # nic "It still matters how you feel."
    nic "这对你来说还是重要的。"

# episode12\update12.rpy:2501
translate schinese ep12_prl_label_09f3cbbc:

    # ly "Nah, it doesn't. In fact, you did me a favor."
    ly "不，这不算什么。事实上，你帮了我一个忙。"

# episode12\update12.rpy:2503
translate schinese ep12_prl_label_fc9241a7:

    # nic "What's that supposed to mean?"
    nic "这是什么意思？"

# episode12\update12.rpy:2505
translate schinese ep12_prl_label_732cf074:

    # ly "You took him off my hands before he got clingy."
    ly "你在他变得黏人之前把他从我手里拿走了。"

# episode12\update12.rpy:2506
translate schinese ep12_prl_label_9d7626cf:

    # ly "I never wanted to date him because I couldn't date someone and work here."
    ly "我从没想过要和他约会，因为我不能一边在这里工作，一边和别人谈恋爱。"

# episode12\update12.rpy:2507
translate schinese ep12_prl_label_3677840c:

    # ly "But obviously, you can."
    ly "但显然，你也可以。"

# episode12\update12.rpy:2509
translate schinese ep12_prl_label_f98128c3:

    # nic "Work is work. What you do in private is a different thing."
    nic "工作是工作，私底下做什么是另一回事。"

# episode12\update12.rpy:2511
translate schinese ep12_prl_label_375f94e6:

    # ly "Well, I don't think I can grind on horny dudes and like [name] at the same time. That's not me."
    ly "嗯，我可不想跟那些色狼磨磨蹭蹭地泡在一起。[name]同时。那不是我。"

# episode12\update12.rpy:2513
translate schinese ep12_prl_label_8ed8214c:

    # nic "Do you like him? \"Like him\", like him?"
    nic "你喜欢他？“喜欢他”，是那种喜欢吗？"

# episode12\update12.rpy:2515
translate schinese ep12_prl_label_22235ed9:

    # ly "I'm not in love with him, if that's what you're getting at."
    ly "我不是爱上了他，如果你是这个意思的话。"

# episode12\update12.rpy:2516
translate schinese ep12_prl_label_9b5f57cc:

    # ly "I enjoyed his company."
    ly "我挺享受和他在一起的。"

# episode12\update12.rpy:2520
translate schinese ep12_prl_label_4fe3f721:

    # ly "Don't feel bad."
    ly "别难过。"

# episode12\update12.rpy:2526
translate schinese ep12_prl_label_ecd2e5a0:

    # nic "I need a vacation..."
    nic "我需要个假期..."

# episode12\update12.rpy:2528
translate schinese ep12_prl_label_4bcedbbd:

    # ly "Yeah? Where are we going?"
    ly "对? 咱们去哪儿？"

# episode12\update12.rpy:2530
translate schinese ep12_prl_label_8e18f29c:

    # nic "If I could choose, I'd stay in bed at home for a week and catch up on some sleep."
    nic "如果能选的话，我宁愿在家床上躺一星期，补补觉。"

# episode12\update12.rpy:2532
translate schinese ep12_prl_label_92606d08:

    # ly "That's not a vacation; that's just sad. Is this what life after 30 has to offer?"
    ly "那不是假期，那只是可悲。三十岁之后的生活，就只能这样了？"

# episode12\update12.rpy:2534
translate schinese ep12_prl_label_2ea437e5:

    # nic "It's what life after having a child offers."
    nic "这是有了孩子之后的生活才有的事。"

# episode12\update12.rpy:2536
translate schinese ep12_prl_label_a12ddb7f:

    # ly "Good thing I'm not doing that."
    ly "幸好我不会这么做。"

# episode12\update12.rpy:2538
translate schinese ep12_prl_label_dcc8e1fb:

    # nic "Ever?"
    nic "你也在考虑？"

# episode12\update12.rpy:2540
translate schinese ep12_prl_label_6764456f:

    # ly "Eh... It's not high on my to-do list; let's leave it at that."
    ly "嗯……这事儿不在我的优先清单上，咱们就到此为止吧。"

# episode12\update12.rpy:2541
translate schinese ep12_prl_label_86dbf99d:

    # ly "Besides, fat strippers aren't popular."
    ly "再说了，胖脱衣舞娘可不受欢迎。"

# episode12\update12.rpy:2542
translate schinese ep12_prl_label_61abe69b:

    # ly "And you're one of the lucky few who managed a pregnancy without having it ruin you."
    ly "你可是少数几个怀孕了还没被毁掉的人之一。"

# episode12\update12.rpy:2544
translate schinese ep12_prl_label_bd657ade:

    # nic "What a shallow take."
    nic "这看法也太肤浅了。"

# episode12\update12.rpy:2546
translate schinese ep12_prl_label_46f3ef2d:

    # ly "Yeah, see? I'm way too immature to be a mom."
    ly "对，看到了吧？我还太幼稚，当不了妈妈。"

# episode12\update12.rpy:2548
translate schinese ep12_prl_label_30418201:

    # nic "That's what I thought when I was your age, too - just saying."
    nic "那我年轻的时候也是这么想的，纯属实话。"

# episode12\update12.rpy:2550
translate schinese ep12_prl_label_feae7c1a:

    # ly "What's your holiday going to be like this year?"
    ly "你今年的假期打算怎么过？"

# episode12\update12.rpy:2552
translate schinese ep12_prl_label_3e7c8bbe:

    # nic "I got Marvin for Christmas, and I hope to find free time to spend with [name] on top of that."
    nic "我圣诞节得到了马文，希望找到空闲时间陪他[name]此外"

# episode12\update12.rpy:2554
translate schinese ep12_prl_label_c7387fdb:

    # ly "Has [name] met your kid?"
    ly "有[name]见过你家那小子了吗？"

# episode12\update12.rpy:2556
translate schinese ep12_prl_label_9e6eddab:

    # nic "No, he hasn't."
    nic "不，他还没见过。"

# episode12\update12.rpy:2558
translate schinese ep12_prl_label_fb7ed1fb:

    # ly "Will he?"
    ly "他会吗？"

# episode12\update12.rpy:2560
translate schinese ep12_prl_label_7b3227bc:

    # nic "We'll see. I think it would scare him away."
    nic "咱们走着瞧。我想这可能会把他吓跑。"

# episode12\update12.rpy:2562
translate schinese ep12_prl_label_5f2f882e:

    # ly "Because of his age?"
    ly "因为他的年龄？"

# episode12\update12.rpy:2564
translate schinese ep12_prl_label_14572cfc:

    # nic "The age gap isn't that big of an issue to me."
    nic "年龄差距对我来说不算什么大问题。"

# episode12\update12.rpy:2566
translate schinese ep12_prl_label_d5c208a6:

    # ly "It's not? Because without thinking, I can't tell if [name]'s age is closer to yours or Marvin's."
    ly "这句不是？因为不假思索，我无法判断[name]年龄更接近你或者马文的。"

# episode12\update12.rpy:2568
translate schinese ep12_prl_label_fd92332a:

    # nic "Don't put it like that. Stop it!"
    nic "别这么说。住口！"

# episode12\update12.rpy:2570
translate schinese ep12_prl_label_94fe7331:

    # ly "So... It is an issue after all."
    ly "所以……它确实是个问题。"

# episode12\update12.rpy:2572
translate schinese ep12_prl_label_2979a105:

    # nic "Not when we get older."
    nic "老了就不一样了。"

# episode12\update12.rpy:2574
translate schinese ep12_prl_label_0fde47b7:

    # ly "Yeah, but what about now?"
    ly "那现在呢？"

# episode12\update12.rpy:2576
translate schinese ep12_prl_label_d75bb038:

    # nic "I feel [name] is mature for his age."
    nic "我感觉[name]他这个年纪已经很成熟了。"

# episode12\update12.rpy:2578
translate schinese ep12_prl_label_710475f6:

    # ly "The guy who passed out naked in the park from a blunt is mature?"
    ly "那个在公园里抽大麻抽到晕倒光着身子的家伙，算成熟吗？"

# episode12\update12.rpy:2580
translate schinese ep12_prl_label_f599dca9:

    # nic "We were high and naked in the park, too."
    nic "我们也在公园里嗨翻了，光着身子。"

# episode12\update12.rpy:2582
translate schinese ep12_prl_label_36a14d51:

    # ly "Yeah, and as we already established, I'm not that mature."
    ly "对，而且我们已经说了，我也不算特别成熟。"

# episode12\update12.rpy:2584
translate schinese ep12_prl_label_8864eb5f:

    # nic "Still, I feel he is mature. On our date, we had a long and deep talk."
    nic "不过我觉得他挺成熟的。我们约会的时候，聊了很多，也聊得很深入。"

# episode12\update12.rpy:2585
translate schinese ep12_prl_label_6fd34938:

    # nic "Sure, he's a frat guy and goofs off at parties, but that's his playful side."
    nic "当然，他是个兄弟会的家伙，派对上爱开玩笑，但这只是他调皮的一面。"

# episode12\update12.rpy:2586
translate schinese ep12_prl_label_72f82ca4:

    # nic "There's another side to him that I've seen."
    nic "他还有另一面我见过。"

# episode12\update12.rpy:2588
translate schinese ep12_prl_label_837a7566:

    # ly "Hey, you're the one dating him. You don't have to convince me."
    ly "嘿，你才是跟他约会的人，你不用说服我。"

# episode12\update12.rpy:2589
translate schinese ep12_prl_label_2a86c910:

    # ly "But you might have to convince Luke that you haven't lost it."
    ly "但你可能得说服卢克，你还没疯。"

# episode12\update12.rpy:2591
translate schinese ep12_prl_label_87074e2e:

    # nic "Because I'm dating [name]?"
    nic "因为我正在约会[name]?"

# episode12\update12.rpy:2593
translate schinese ep12_prl_label_02620e42:

    # ly "All I'm saying is, hold off on introducing [name] to Marvin and you'll be good."
    ly "我只是说，先别急着介绍[name]给马文和你一起玩就很好。"

# episode12\update12.rpy:2601
translate schinese ep12_prl_label_b1d73135:

    # nic "Bad night?"
    nic "糟了？"

# episode12\update12.rpy:2603
translate schinese ep12_prl_label_10019fee:

    # ly "It was alright."
    ly "还行。"

# episode12\update12.rpy:2605
translate schinese ep12_prl_label_30bb6500:

    # nic "Then why the sad face?"
    nic "那为什么一脸丧气？"

# episode12\update12.rpy:2607
translate schinese ep12_prl_label_fbf02c18:

    # ly "Blame [name]... Everything is his fault."
    ly "责怪[name]一切都是他的错。"

# episode12\update12.rpy:2610
translate schinese ep12_prl_label_9f407a81:

    # nic "This doesn't have anything to do with me, right?"
    nic "这事儿可跟我不沾边，对吧？"

# episode12\update12.rpy:2612
translate schinese ep12_prl_label_9b5e98a7:

    # ly "Hm? No. It's not because of you."
    ly "哼？不，不是因为你。"

# episode12\update12.rpy:2614
translate schinese ep12_prl_label_13d15116:

    # nic "Then what did he do?"
    nic "那他做了什么？"

# episode12\update12.rpy:2617
translate schinese ep12_prl_label_f5feffb0:

    # nic "What did he do?"
    nic "他干了什么？"

# episode12\update12.rpy:2619
translate schinese ep12_prl_label_2afb0d26:

    # ly "He got into my head."
    ly "他钻进了我的脑子。"

# episode12\update12.rpy:2621
translate schinese ep12_prl_label_603d28e5:

    # nic "How?"
    nic "怎么了？"

# episode12\update12.rpy:2623
translate schinese ep12_prl_label_1ce1d5d7:

    # ly "For the first time since I started working here and met you girls, I felt I was doing something wrong tonight."
    ly "从我开始在这里工作，认识你们几个以来，今晚第一次觉得自己做错了什么。"

# episode12\update12.rpy:2624
translate schinese ep12_prl_label_af511ac5:

    # ly "You know that feeling, yeah?"
    ly "你懂那种感觉，对吧？"

# episode12\update12.rpy:2626
translate schinese ep12_prl_label_65fdff29:

    # nic "Sure do. I hated looking at my face in these mirrors for a long time."
    nic "我确实这么觉得。我很久都没能忍受看着镜子里自己的脸。"

# episode12\update12.rpy:2627
translate schinese ep12_prl_label_401d47fc:

    # nic "What did [name] say? Did he slam you for stripping?"
    nic "什么了[name]你问他是不是因为你脱衣服才打你的？"

# episode12\update12.rpy:2629
translate schinese ep12_prl_label_3fe8b936:

    # ly "He hasn't said a thing about it."
    ly "他什么都没说。"

# episode12\update12.rpy:2631
translate schinese ep12_prl_label_5d784e00:

    # nic "Then what did he say?"
    nic "那他到底说了什么？"

# episode12\update12.rpy:2633
