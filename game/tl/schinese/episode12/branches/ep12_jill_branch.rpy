translate schinese ep12_jill_break_label_9a128bab:

    # ji "[name]? I'm here."
    ji "[name]我在这儿。"

# episode12\branches\ep12_jill_branch.rpy:7
translate schinese ep12_jill_break_label_d3e82dbe:

    # mc "That was fast."
    mc "这么快就回来了？"

# episode12\branches\ep12_jill_branch.rpy:9
translate schinese ep12_jill_break_label_219e9257:

    # ji "I rushed back home. There was something in the sound of your voice that had me worried."
    ji "我一路狂奔回家，你声音里的某种情绪让我很担心。"

# episode12\branches\ep12_jill_branch.rpy:10
translate schinese ep12_jill_break_label_46addcf6:

    # ji "Are you doing well? Is this about last night?"
    ji "你最近怎么样？这是关于昨晚的事吗？"

# episode12\branches\ep12_jill_branch.rpy:12
translate schinese ep12_jill_break_label_a456a70c:

    # mc "Yesterday was rough, but it's not about that... You should sit down."
    mc "昨天挺难熬的，但不是那个事……你先坐下来。"

# episode12\branches\ep12_jill_branch.rpy:16
translate schinese ep12_jill_break_label_22a8167a:

    # ji "What's wrong?"
    ji "怎么了？"

# episode12\branches\ep12_jill_branch.rpy:18
translate schinese ep12_jill_break_label_2ff0506f:

    # mc "How do I say this?"
    mc "我该怎么说呢？"

# episode12\branches\ep12_jill_branch.rpy:19
translate schinese ep12_jill_break_label_2fffcb97:

    # mc "*{i}Sigh{/i}* I'm an asshole..."
    mc "*{i}叹气{/i}*我是个混蛋..."

# episode12\branches\ep12_jill_branch.rpy:21
translate schinese ep12_jill_break_label_4a27e06d:

    # mc "Remember Zoey?"
    mc "记得Zoey吗？"

# episode12\branches\ep12_jill_branch.rpy:23
translate schinese ep12_jill_break_label_d12f1e6c:

    # ji "Yes?"
    ji "你问什么？"

# episode12\branches\ep12_jill_branch.rpy:25
translate schinese ep12_jill_break_label_f3e72e73:

    # mc "I'm still in love with her. And she loves me too."
    mc "我还在爱着她。她也爱着我。"

# episode12\branches\ep12_jill_branch.rpy:29
translate schinese ep12_jill_break_label_b1951f4b:

    # ji "*{i}Scoffs{/i}*"
    ji "*{i}嗤笑{/i}*"

# episode12\branches\ep12_jill_branch.rpy:30
translate schinese ep12_jill_break_label_d1630022:

    # ji "I knew it."
    ji "我知道了。"

# episode12\branches\ep12_jill_branch.rpy:32
translate schinese ep12_jill_break_label_03635ee8:

    # mc "You knew it?"
    mc "你早该知道。"

# episode12\branches\ep12_jill_branch.rpy:34
translate schinese ep12_jill_break_label_a6126ddd:

    # ji "Damn you, [name]."
    ji "该死的你[name]."

# episode12\branches\ep12_jill_branch.rpy:36
translate schinese ep12_jill_break_label_c921def3:

    # mc "Jill, don't leave. Can we talk about it?"
    mc "Jill，别走。我们能谈谈吗？"

# episode12\branches\ep12_jill_branch.rpy:38
translate schinese ep12_jill_break_label_a632244e:

    # ji "What is there to say? It's over, isn't it?"
    ji "还有什么好说的？事情已经结束了，不是吗？"

# episode12\branches\ep12_jill_branch.rpy:40
translate schinese ep12_jill_break_label_92902afb:

    # ji "All this time together... Every meaningful moment..."
    ji "这一路上的时光……每一个有意义的瞬间……"

# episode12\branches\ep12_jill_branch.rpy:41
translate schinese ep12_jill_break_label_baa6c610:

    # ji "And you throw that away for what?"
    ji "你为了什么就把它扔了？"

# episode12\branches\ep12_jill_branch.rpy:43
translate schinese ep12_jill_break_label_cfff76d2:

    # mc "It wasn't easy. And you're right. The time I've spent with you has been so special to me..."
    mc "这并不容易。你说得对，和你相处的时光对我而言一直非常特别……"

# episode12\branches\ep12_jill_branch.rpy:44
translate schinese ep12_jill_break_label_50f8f9c3:

    # mc "...but I gotta listen to my heart."
    mc "但我要听从我内心的声音。"

# episode12\branches\ep12_jill_branch.rpy:46
translate schinese ep12_jill_break_label_6700df42:

    # ji "Yeah. Listen to your heart, [name]."
    ji "听从你的心。[name]."

# episode12\branches\ep12_jill_branch.rpy:47
translate schinese ep12_jill_break_label_7cb53648:

    # ji "Listen to your heart while you crush mine."
    ji "听你的心，却把我的碾碎。"

# episode12\branches\ep12_jill_branch.rpy:49
translate schinese ep12_jill_break_label_ecbee836:

    # mc "Jill..."
    mc "Jill..."

# episode12\branches\ep12_jill_branch.rpy:50
translate schinese ep12_jill_break_label_2b850d12:

    # ji "*{i}Sobs{/i}*"
    ji "*{i}抽泣{/i}*"

# episode12\branches\ep12_jill_branch.rpy:52
translate schinese ep12_jill_break_label_25cab9d1:

    # ji "I can't breathe."
    ji "我喘不过气了。"

# episode12\branches\ep12_jill_branch.rpy:54
translate schinese ep12_jill_break_label_7d9199bd:

    # mc "I'm so sorry."
    mc "我真的很抱歉。"

# episode12\branches\ep12_jill_branch.rpy:56
translate schinese ep12_jill_break_label_4be06a20:

    # ji "You reassured me that nothing was going on between you two."
    ji "你曾让我相信你和她之间什么都没发生。"

# episode12\branches\ep12_jill_branch.rpy:57
translate schinese ep12_jill_break_label_e164b9fe:

    # ji "I trusted you... Do you know how that makes me feel? To blindly trust you and have you betray that trust?"
    ji "我信任你……你知道这让我感觉怎么样吗？毫无保留地信任你，结果却让你背叛了这份信任？"

# episode12\branches\ep12_jill_branch.rpy:59
translate schinese ep12_jill_break_label_0863fca8:

    # mc "I didn't plan for it to happen. I didn't even know I felt that way about her."
    mc "我没打算让它发生的。我甚至不知道自己对她有那种感觉。"

# episode12\branches\ep12_jill_branch.rpy:60
translate schinese ep12_jill_break_label_91f2711e:

    # mc "But then she told me how she felt about me, and I knew it by then... That I felt the same."
    mc "可后来她告诉了我对我的感情，到那时我已经明白……我也有同样的感觉。"

# episode12\branches\ep12_jill_branch.rpy:62
translate schinese ep12_jill_break_label_5ca78d5d:

    # ji "Was it that easy for you? Really?"
    ji "这对你来说就这么简单？真的？"

# episode12\branches\ep12_jill_branch.rpy:63
translate schinese ep12_jill_break_label_fc29fb98:

    # ji "Wasn't I worth a moment of hesitation? No afterthought?"
    ji "我连让你犹豫片刻都不值得吗？你事后就没有想过我？"

# episode12\branches\ep12_jill_branch.rpy:65
translate schinese ep12_jill_break_label_1f436935:

    # mc "It doesn't mean that you mean nothing to me, Jill."
    mc "这并不意味着你对我来说毫无意义，Jill。"

# episode12\branches\ep12_jill_branch.rpy:66
translate schinese ep12_jill_break_label_93826ff5:

    # mc "It's love. There is no reasoning or logic when it comes to love."
    mc "这是爱情。爱情不需要理由，也不讲逻辑。"

# episode12\branches\ep12_jill_branch.rpy:68
translate schinese ep12_jill_break_label_081bf50d:

    # ji "Oh, spare me the clichés."
    ji "别跟我讲那些老套的台词。"

# episode12\branches\ep12_jill_branch.rpy:88
translate schinese ep12_jill_room_label_9a128bab:

    # ji "[name]? I'm here."
    ji "[name]我在这儿。"

# episode12\branches\ep12_jill_branch.rpy:90
translate schinese ep12_jill_room_label_a6479f69:

    # mc "I was wondering when you'd show up."
    mc "我还在想你什么时候能来。"

# episode12\branches\ep12_jill_branch.rpy:99
translate schinese ep12_jill_room_label_190ce818:

    # ji "I tried my best to hurry. You sounded somber in your voice."
    ji "我尽力加快了速度，你声音里听起来挺低落的。"

# episode12\branches\ep12_jill_branch.rpy:100
translate schinese ep12_jill_room_label_46addcf6:

    # ji "Are you doing well? Is this about last night?"
    ji "你最近还好吗？是关于昨晚的事吗？"

# episode12\branches\ep12_jill_branch.rpy:109
translate schinese ep12_jill_room_label_3ee3daba:

    # mc "I didn't mean to worry you with my call. Yeah, yesterday did a number on me. I'm still reeling from it."
    mc "我没想用电话让你担心。是的，昨天的事让我挺崩溃的，我现在还处在那种状态里。"

# episode12\branches\ep12_jill_branch.rpy:118
translate schinese ep12_jill_room_label_6b5107f7:

    # ji "That's understandable. I'm also feeling quite low today."
    ji "这可以理解。我今天也感觉挺低落的。"

# episode12\branches\ep12_jill_branch.rpy:127
translate schinese ep12_jill_room_label_8e5aabda:

    # mc "Wanna talk about it?"
    mc "想聊聊吗？"

# episode12\branches\ep12_jill_branch.rpy:136
translate schinese ep12_jill_room_label_0a95cf50:

    # ji "No... Not today."
    ji "不...今天不行。"

# episode12\branches\ep12_jill_branch.rpy:145
translate schinese ep12_jill_room_label_d319cfd6:

    # mc "Hey... You're wearing the outfit I picked out for you."
    mc "嘿……你穿着我给你挑的那套衣服。"

# episode12\branches\ep12_jill_branch.rpy:152
translate schinese ep12_jill_room_label_6ded947c:

    # ji "I am. Do you still like it?"
    ji "我穿着呢。你还是喜欢吗？"

# episode12\branches\ep12_jill_branch.rpy:162
translate schinese ep12_jill_room_label_523c56b8:

    # mc "It warms my heart to see you wear it."
    mc "看到你穿成这样，我真的很开心。"

# episode12\branches\ep12_jill_branch.rpy:164
translate schinese ep12_jill_room_label_80d0d8e8:

    # mc "You're so hot in it. It suits you perfectly."
    mc "你穿这身简直太HOT了。完美地衬托出你。"

# episode12\branches\ep12_jill_branch.rpy:165
translate schinese ep12_jill_room_label_d1c824bb:

    # mc "Did you wear it all day?"
    mc "你今天一直穿着它吗？"

# episode12\branches\ep12_jill_branch.rpy:172
translate schinese ep12_jill_room_label_8b9232fc:

    # ji "Mhm..."
    ji "嗯……"

# episode12\branches\ep12_jill_branch.rpy:179
translate schinese ep12_jill_room_label_5801b36b:

    # mc "That makes me very happy."
    mc "这让我很开心。"

# episode12\branches\ep12_jill_branch.rpy:186
translate schinese ep12_jill_room_label_32544a4d:

    # ji "My parents weren't as thrilled about it."
    ji "我爸妈也没那么激动。"

# episode12\branches\ep12_jill_branch.rpy:193
translate schinese ep12_jill_room_label_647dc330:

    # mc "Did you go to see them? What did they say?"
    mc "你去看了他们吗？他们说什么了？"

# episode12\branches\ep12_jill_branch.rpy:200
translate schinese ep12_jill_room_label_fd0bcf3a:

    # ji "I don't want to get into it. The look on Mom's face when she saw what I was wearing underneath my coat was enough."
    ji "我不想多说。我妈看到我外套底下穿的是什么时的表情，已经够让我难受的了。"

# episode12\branches\ep12_jill_branch.rpy:207
translate schinese ep12_jill_room_label_9265c367:

    # mc "You look great, Jill."
    mc "你看起来很棒，Jill。"

# episode12\branches\ep12_jill_branch.rpy:214
translate schinese ep12_jill_room_label_e8a074b3:

    # ji "Thank you, [name]."
    ji "谢谢，[name]."

# episode12\branches\ep12_jill_branch.rpy:217
translate schinese ep12_jill_room_label_4534f1e1:

    # mc "So... What's that?"
    mc "所以……那是什么？"

# episode12\branches\ep12_jill_branch.rpy:226
translate schinese ep12_jill_room_label_68bb78f3:

    # ji "It's the second part of your gift, and that's why it took me a while to get here."
    ji "这是你礼物的第二部分，正因如此我才花了不少时间才到这儿。"

# episode12\branches\ep12_jill_branch.rpy:227
translate schinese ep12_jill_room_label_41388dc5:

    # ji "I picked it up today, and that's why it was a secret."
    ji "我今天才拿到的，这就是为什么它是秘密。"

# episode12\branches\ep12_jill_branch.rpy:236
translate schinese ep12_jill_room_label_71cb9772:

    # mc "That's a big gift... Can I open it?"
    mc "这礼物可真够大的……我能打开吗？"

# episode12\branches\ep12_jill_branch.rpy:245
translate schinese ep12_jill_room_label_61042dbb:

    # ji "You may."
    ji "你可以。"

# episode12\branches\ep12_jill_branch.rpy:258
translate schinese ep12_jill_room_label_f0b9f929:

    # mc "This is Lana's guitar."
    mc "这是Lana的吉他。"

# episode12\branches\ep12_jill_branch.rpy:259
translate schinese ep12_jill_room_label_bd891ca9:

    # mc "Are you for real?"
    mc "你是认真的吗？"

# episode12\branches\ep12_jill_branch.rpy:268
translate schinese ep12_jill_room_label_6997e762:

    # ji "It was her guitar. And now it's yours."
    ji "这是她的吉他。现在归你了。"

# episode12\branches\ep12_jill_branch.rpy:269
translate schinese ep12_jill_room_label_8fca8b4c:

    # ji "The purpose of that guitar is to create music. Like the poster, you'd put the guitar to a much better use."
    ji "这把吉他存在的意义就是用来创造音乐。就像那张海报一样，你完全可以把它用得更好。"

# episode12\branches\ep12_jill_branch.rpy:270
translate schinese ep12_jill_room_label_a5fa0a69:

    # ji "Hold on, I left something out here, too."
    ji "等等，我刚才还漏掉一样东西在这里。"

# episode12\branches\ep12_jill_branch.rpy:279
translate schinese ep12_jill_room_label_2b6d005e:

    # mc "The speaker too... Jill... This is too much. What an incredible gift."
    mc "连音箱也送给我……Jill，这太贵重了。真是一份不可思议的礼物。"

# episode12\branches\ep12_jill_branch.rpy:288
translate schinese ep12_jill_room_label_dd8f081f:

    # ji "It's not going to make much sound without it. Haha!"
    ji "没有音箱的话，这玩意儿也发不出什么声音。哈哈！"

# episode12\branches\ep12_jill_branch.rpy:290
translate schinese ep12_jill_room_label_d492837c:

    # mc "How did you convince your parents to part with this?"
    mc "你是怎么说服你爸妈把这玩意儿交出来的？"

# episode12\branches\ep12_jill_branch.rpy:291
translate schinese ep12_jill_room_label_56767059:

    # mc "You told me Lana's room was treated as a sanctuary."
    mc "你跟我说过Lana的房间被当成了避风港。"

# episode12\branches\ep12_jill_branch.rpy:300
translate schinese ep12_jill_room_label_7349acfa:

    # ji "I had a long talk with them and explained how I felt."
    ji "我和他们聊了很久，解释了我内心的感受。"

# episode12\branches\ep12_jill_branch.rpy:301
translate schinese ep12_jill_room_label_8d9b4206:

    # ji "They always promised me that I could have some of her belongings when and if I wanted."
    ji "他们一直承诺，只要我想，随时可以拿走她的东西。"

# episode12\branches\ep12_jill_branch.rpy:310
translate schinese ep12_jill_room_label_24b63b01:

    # ji "I told them I wanted to give you these things as a gift to show you how much you mean to me."
    ji "我跟他们说，我想把这些东西送给你当礼物，来表达你对我来说有多重要。"

# episode12\branches\ep12_jill_branch.rpy:311
translate schinese ep12_jill_room_label_5407e5d2:

    # ji "Eventually, they agreed. But they asked me not to give away more of her things in return."
    ji "最终他们同意了。但他们让我别再拿走她更多的东西作为交换。"

# episode12\branches\ep12_jill_branch.rpy:320
translate schinese ep12_jill_room_label_e087b20d:

    # mc "I can't accept this. It's too much."
    mc "我不能接受这个。太重了。"

# episode12\branches\ep12_jill_branch.rpy:329
translate schinese ep12_jill_room_label_c2418667:

    # ji "I want you to have it."
    ji "我想你拥有它。"

# episode12\branches\ep12_jill_branch.rpy:339
translate schinese ep12_jill_room_label_7100f13c:

    # mc "That's such a beautiful gesture from you. I'm touched..."
    mc "这真是你很暖心的举动，我真的很感动……"

# episode12\branches\ep12_jill_branch.rpy:341
translate schinese ep12_jill_room_label_bf0537e9:

    # mc "You even put new strings on it."
    mc "你连琴弦都换了。"

# episode12\branches\ep12_jill_branch.rpy:342
translate schinese ep12_jill_room_label_0cb8effe:

    # ji "The guy in the shop did."
    ji "那家伙在店里干的。"

# episode12\branches\ep12_jill_branch.rpy:343
translate schinese ep12_jill_room_label_a934bf48:

    # mc "I can't believe this. My own custom Strutter. What a dream."
    mc "我真不敢相信。这是我自己的定制Strutter，太棒了。"

# episode12\branches\ep12_jill_branch.rpy:345
translate schinese ep12_jill_room_label_775f9bc6:

    # mc "Hm... The back panel of the speaker is loose."
    mc "嗯……音箱的后面板松了。"

# episode12\branches\ep12_jill_branch.rpy:354
translate schinese ep12_jill_room_label_4aa9bc2c:

    # ji "Is it broken?"
    ji "坏了？"

# episode12\branches\ep12_jill_branch.rpy:356
translate schinese ep12_jill_room_label_29273cdd:

    # mc "No, just loose. I can probably tighten the screws for it."
    mc "不，只是松了。我大概可以把它螺丝拧紧。"

# episode12\branches\ep12_jill_branch.rpy:357
translate schinese ep12_jill_room_label_36c8bb48:

    # mc "Wait... There's something lodged in there."
    mc "等等……里面卡着什么东西。"

# episode12\branches\ep12_jill_branch.rpy:366
translate schinese ep12_jill_room_label_875dfe5c:

    # ji "Inside the speaker? What is it?"
    ji "里面？那是什么？"

# episode12\branches\ep12_jill_branch.rpy:368
translate schinese ep12_jill_room_label_3daa5d1f:

    # mc "Um... I'm guessing this wasn't part of the gift."
    mc "嗯……我猜这玩意儿本来就不该是礼物的一部分。"

# episode12\branches\ep12_jill_branch.rpy:377
translate schinese ep12_jill_room_label_62ea573e:

    # ji "What is that? Is that...?"
    ji "那是什么？是...？"

# episode12\branches\ep12_jill_branch.rpy:379
translate schinese ep12_jill_room_label_e747c7c4:

    # mc "I think it's weed."
    mc "我想是大麻。"

# episode12\branches\ep12_jill_branch.rpy:388
translate schinese ep12_jill_room_label_939fc4d6:

    # ji "She kept drugs in the speaker..."
    ji "她把毒品藏在音箱里..."

# episode12\branches\ep12_jill_branch.rpy:390
translate schinese ep12_jill_room_label_bbe50918:

    # mc "I'm sorry..."
    mc "真抱歉..."

# episode12\branches\ep12_jill_branch.rpy:399
translate schinese ep12_jill_room_label_33808710:

    # ji "I wasn't aware that she kept that at home. But it makes sense that's where she'd hide it..."
    ji "我没想到她会把那玩意儿带回家。不过她藏在那儿也挺合理……"

# episode12\branches\ep12_jill_branch.rpy:400
translate schinese ep12_jill_room_label_e6a49064:

    # ji "Mom and Dad would look everywhere else for it."
    ji "他们爸妈会在别处找。"

# episode12\branches\ep12_jill_branch.rpy:402
translate schinese ep12_jill_room_label_53731a7f:

    # mc "She found a good hiding spot."
    mc "她找到了个不错的藏身之处。"

# episode12\branches\ep12_jill_branch.rpy:411
translate schinese ep12_jill_room_label_01f10530:

    # ji "You should throw that out."
    ji "你应该扔掉那些东西。"

# episode12\branches\ep12_jill_branch.rpy:420
translate schinese ep12_jill_room_label_36252585:

    # mc "This wasn't what killed her."
    mc "这并不是害死她的东西。"

# episode12\branches\ep12_jill_branch.rpy:429
translate schinese ep12_jill_room_label_beca16fb:

    # ji "Those are still her drugs."
    ji "那些还是她的东西。"

# episode12\branches\ep12_jill_branch.rpy:438
translate schinese ep12_jill_room_label_9c29a893:

    # mc "Don't feel down. You learned something new about your sister today."
    mc "别太沮丧。你今天从你姐姐身上学到了点新东西。"

# episode12\branches\ep12_jill_branch.rpy:447
translate schinese ep12_jill_room_label_e9a03b77:

    # ji "Well... That's true."
    ji "嗯……那倒是真的。"

# episode12\branches\ep12_jill_branch.rpy:466
translate schinese ep12_jill_room_label_63e4eb03:

    # ji "I want to hear you play."
    ji "我想听听你弹。"

# episode12\branches\ep12_jill_branch.rpy:471
translate schinese ep12_jill_room_label_06e338b2:

    # mc "Alright. Let's take this bad girl for a ride."
    mc "好，来带这个坏女孩上路吧。"

# episode12\branches\ep12_jill_branch.rpy:491
translate schinese ep12_jill_room_label_2c1c8d5a:

    # ji "It has a beautiful sound."
    ji "它听起来真不错。"

# episode12\branches\ep12_jill_branch.rpy:493
translate schinese ep12_jill_room_label_e7581b72:

    # mc "It really does. And such a small and tight neck."
    mc "它真的很有感觉。而且这脖子又小又紧。"

# episode12\branches\ep12_jill_branch.rpy:494
translate schinese ep12_jill_room_label_cd8e7b75:

    # mc "It's so smooth and easy to grip. And that tone..."
    mc "它握起来特别顺手，而且音色……"

# episode12\branches\ep12_jill_branch.rpy:496
translate schinese ep12_jill_room_label_40dadff3:

    # mc "I can imagine how this would sound with a full band..."
    mc "我可以想象如果有一整个乐队伴奏会是什么效果..."

# episode12\branches\ep12_jill_branch.rpy:499
translate schinese ep12_jill_room_label_007df238:

    # ji "Playing it like that makes you sound like a blues musician."
    ji "这样弹奏听起来像是在模仿蓝调音乐人。"

# episode12\branches\ep12_jill_branch.rpy:501
translate schinese ep12_jill_room_label_d034536c:

    # mc "Oh, I'm not good enough to be compared to those."
    mc "哦，我可没资格跟那些人比。"

# episode12\branches\ep12_jill_branch.rpy:502
translate schinese ep12_jill_room_label_6704456b:

    # mc "Did you know that some great guitarists name their guitars? Like, Lucille for one."
    mc "你知道吗，有些伟大的吉他手会给他们的吉他起名字，比如卢西尔。"

# episode12\branches\ep12_jill_branch.rpy:511
translate schinese ep12_jill_room_label_785349d3:

    # ji "Oh, yeah? Are you thinking of naming yours?"
    ji "哦，是吗？你是不是也在考虑给你的吉他起个名字？"

# episode12\branches\ep12_jill_branch.rpy:513
translate schinese ep12_jill_room_label_0c0e3720:

    # mc "Yeah. I think I'll call this guitar \"Lana\", if you don't mind."
    mc "嗯，我觉得就叫它 \"Lana\" 吧，如果你不介意的话。"

# episode12\branches\ep12_jill_branch.rpy:522
translate schinese ep12_jill_room_label_fa4fe83e:

    # ji "I love that."
    ji "我喜欢这个。"

# episode12\branches\ep12_jill_branch.rpy:540
translate schinese ep12_jill_solo_label_6fa637ed:

    # ji "You made it through your first semester at B&R. Regardless of how the tests went, that's a milestone."
    ji "你已经熬过了在B&R的第一个学期。不管考试考得怎么样，这都算得上是一个里程碑。"

# episode12\branches\ep12_jill_branch.rpy:542
translate schinese ep12_jill_solo_label_e2ce2a31:

    # mc "What kind of milestone is it if I have to retake the classes?"
    mc "如果我得重修课程，这算什么里程碑？"

# episode12\branches\ep12_jill_branch.rpy:544
translate schinese ep12_jill_solo_label_bb3ba13a:

    # ji "I think that's your mind playing tricks on you. I remember doubting myself after every test when I came here."
    ji "我觉得你这是脑子自己在捣鬼。我刚来这儿的时候，每次考完试都怀疑自己是不是搞砸了。"

# episode12\branches\ep12_jill_branch.rpy:546
translate schinese ep12_jill_solo_label_3795ec8e:

    # mc "I'd feel more comfortable seeing the answers to the tests... When do they publish those?"
    mc "我想看到考试的答案会更安心……那些答案什么时候公布？"

# episode12\branches\ep12_jill_branch.rpy:548
translate schinese ep12_jill_solo_label_3ddd2c6c:

    # ji "It depends on the teacher. In some cases, they publish them the same day, but in others you'll have to wait."
    ji "这得看老师怎么安排。有些老师当天就会公布答案，但有些你得等很久。"

# episode12\branches\ep12_jill_branch.rpy:549
translate schinese ep12_jill_solo_label_9601713b:

    # ji "I've also had tests where they didn't publish the answers at all."
    ji "我也遇到过一些考试，根本就没有公布答案。"

# episode12\branches\ep12_jill_branch.rpy:551
translate schinese ep12_jill_solo_label_f507edf0:

    # mc "Until then, I'm Schrodinger's student. I could have passed or failed the tests, but I won't know until I get the results."
    mc "直到结果出来之前，我就是薛定谔的学生。我可能通过了考试，也可能没通过，但直到拿到成绩前，我永远不知道。"

# episode12\branches\ep12_jill_branch.rpy:553
translate schinese ep12_jill_solo_label_b7877d0f:

    # ji "Think positive thoughts. And hey, it's winter break now!"
    ji "保持积极心态。对了，现在是寒假了！"

# episode12\branches\ep12_jill_branch.rpy:555
translate schinese ep12_jill_solo_label_f33c2ddf:

    # mc "True. And no one can take that away from us."
    mc "确实。没人能从我们这儿拿走这个。"

# episode12\branches\ep12_jill_branch.rpy:556
translate schinese ep12_jill_solo_label_aa8dc182:

    # mc "What about you? How did it go?"
    mc "你呢？怎么样？"

# episode12\branches\ep12_jill_branch.rpy:558
translate schinese ep12_jill_solo_label_c72040a8:

    # ji "I had an essay due this week, and today I had a test for my Macroeconomics II class."
    ji "这周我有一篇论文要交，今天还上了宏观经济学二的考试。"

# episode12\branches\ep12_jill_branch.rpy:559
translate schinese ep12_jill_solo_label_cd3f4393:

    # ji "I'm happy with my performance. I know I missed a couple of questions on the test, but I should pass it even so."
    ji "我对自己的表现挺满意的。我知道考试里我错了几题，但应该还是能及格的。"

# episode12\branches\ep12_jill_branch.rpy:561
translate schinese ep12_jill_solo_label_7b2a649c:

    # mc "You seem confident in that."
    mc "你看起来挺有把握的。"

# episode12\branches\ep12_jill_branch.rpy:563
translate schinese ep12_jill_solo_label_155cffa5:

    # ji "I am. I mean, you either know something or you don't. You're not going to be able to guess an answer correctly at this level."
    ji "我就是这个意思。你要么知道，要么不知道。到了这个水平，你不可能靠猜答对。"

# episode12\branches\ep12_jill_branch.rpy:565
translate schinese ep12_jill_solo_label_396489ee:

    # mc "You will, if there are multiple-choice questions."
    mc "你要是遇到选择题的话，就有可能侥幸蒙对。"

# episode12\branches\ep12_jill_branch.rpy:567
translate schinese ep12_jill_solo_label_a87b3c1e:

    # ji "They stopped including those in tests during sophomore year - at least for us."
    ji "他们在大二的时候就不再在考试里出那种题了——至少对我们来说是这样。"

# episode12\branches\ep12_jill_branch.rpy:568
translate schinese ep12_jill_solo_label_3782c310:

    # ji "Now, almost every question requires a lengthier answer. You're lucky if you can get away with writing a sentence or two."
    ji "现在，几乎每个问题都需要更长的回答。你要是能写个一两句就偷懒，那真是走运了。"

# episode12\branches\ep12_jill_branch.rpy:570
translate schinese ep12_jill_solo_label_28e4d6c3:

    # mc "Well done, then."
    mc "做得不错。"

# episode12\branches\ep12_jill_branch.rpy:572
translate schinese ep12_jill_solo_label_d218188f:

    # ji "Thank you."
    ji "谢谢。"

# episode12\branches\ep12_jill_branch.rpy:575
translate schinese ep12_jill_solo_label_93d5744e:

    # mc "Um... There's something I've been meaning to tell you since our Christmas party."
    mc "嗯……我有一件事一直想告诉你，从圣诞派对开始就一直想说。"

# episode12\branches\ep12_jill_branch.rpy:577
translate schinese ep12_jill_solo_label_8cd88574:

    # ji "At Bella's?"
    ji "在贝拉那儿？"

# episode12\branches\ep12_jill_branch.rpy:579
translate schinese ep12_jill_solo_label_c8674580:

    # mc "No. The one at the DIKs."
    mc "不，是DIKs那家的。"

# episode12\branches\ep12_jill_branch.rpy:580
translate schinese ep12_jill_solo_label_4857e0d6:

    # mc "You see... Something happened to me, and I've waited to get a chance to tell you."
    mc "你明白……有件事发生了，我一直等到现在才找到机会告诉你。"

# episode12\branches\ep12_jill_branch.rpy:581
translate schinese ep12_jill_solo_label_9228d56c:

    # mc "But there was always something that stopped me from telling you. I didn't want to ruin the good moments we had by bringing it up."
    mc "但总有什么东西让我一直没告诉你。我不想因为提起这件事，破坏我们之间那些美好的时光。"

# episode12\branches\ep12_jill_branch.rpy:583
translate schinese ep12_jill_solo_label_d85ba66a:

    # ji "What happened?"
    ji "怎么了？"

# episode12\branches\ep12_jill_branch.rpy:586
translate schinese ep12_jill_solo_label_7fa326de:

    # mc "You don't have to worry. Let me start by saying that."
    mc "你不用太担心。让我先说一句。"

# episode12\branches\ep12_jill_branch.rpy:588
translate schinese ep12_jill_solo_label_0d474483:

    # ji "Ok?"
    ji "嗯？"

# episode12\branches\ep12_jill_branch.rpy:590
translate schinese ep12_jill_solo_label_e4bde429:

    # mc "*{i}Sigh{/i}* Zoey told me that she's in love with me. And she tried to rekindle our relationship."
    mc "*{i}叹气{/i}* Zoey 告诉我她爱上了我。她试图重新点燃我们的关系。"

# episode12\branches\ep12_jill_branch.rpy:592
translate schinese ep12_jill_solo_label_77d172e2:

    # ji "She what!?"
    ji "她什么？！"

# episode12\branches\ep12_jill_branch.rpy:594
translate schinese ep12_jill_solo_label_001707cb:

    # mc "And I told her it was too late for that."
    mc "我告诉她，那已经太晚了。"

# episode12\branches\ep12_jill_branch.rpy:596
translate schinese ep12_jill_solo_label_7a4abc4e:

    # ji "Back up, please. This is not something you tell me in parts. I want to know everything she said; tell me every single detail."
    ji "退后点，别这样。这种事不能分段跟我说。我想知道她说了什么，把每一个细节都告诉我。"

# episode12\branches\ep12_jill_branch.rpy:598
translate schinese ep12_jill_solo_label_242afe7f:

    # mc "She came to the party, and we had a good time as friends. She mentioned she needed to talk to me, and we went to my room for a private chat."
    mc "她来参加了聚会，我们像朋友一样玩得很开心。她跟我说她有话要跟我说，我们就去我房间单独聊了聊。"

# episode12\branches\ep12_jill_branch.rpy:599
translate schinese ep12_jill_solo_label_f83865b5:

    # mc "She started reminiscing about our youth and about how we met."
    mc "她开始回忆起我们年轻时的事情，还有我们是怎么认识的。"

# episode12\branches\ep12_jill_branch.rpy:600
translate schinese ep12_jill_solo_label_d987668a:

    # mc "That conversation led her to say that she realized she was in love with me."
    mc "那次谈话让她意识到她爱上了我。"

# episode12\branches\ep12_jill_branch.rpy:602
translate schinese ep12_jill_solo_label_9f83a989:

    # mc "Then she tried to kiss me."
    mc "然后她试图吻我。"

# episode12\branches\ep12_jill_branch.rpy:604
translate schinese ep12_jill_solo_label_13b45f45:

    # mc "I was stunned... I stopped her and told her that I was in a relationship."
    mc "我愣住了……我拦住了她，告诉她我已经有女朋友了。"

# episode12\branches\ep12_jill_branch.rpy:605
translate schinese ep12_jill_solo_label_e072d768:

    # mc "But that didn't seem to deter her. She tried to convince me to have a change of heart."
    mc "但这似乎没让她退缩。她试图说服我改变主意。"

# episode12\branches\ep12_jill_branch.rpy:607
translate schinese ep12_jill_solo_label_001707cb_1:

    # mc "And I told her it was too late for that."
    mc "我告诉她已经太晚了。"

# episode12\branches\ep12_jill_branch.rpy:608
translate schinese ep12_jill_solo_label_1d442a99:

    # mc "She got upset and felt stupid for putting herself out there."
    mc "她很沮丧，觉得自己太傻了，竟然主动表白。"

# episode12\branches\ep12_jill_branch.rpy:609
translate schinese ep12_jill_solo_label_efad444e:

    # mc "And then she left. I haven't heard from her since."
    mc "然后她就走了。从那以后我再也没收到她的消息。"

# episode12\branches\ep12_jill_branch.rpy:611
translate schinese ep12_jill_solo_label_ac015165:

    # ji "Wow..."
    ji "哇……"

# episode12\branches\ep12_jill_branch.rpy:612
translate schinese ep12_jill_solo_label_5f62c7c5:

    # ji "I've been worried that this would happen."
    ji "我担心这种情况会发生。"

# episode12\branches\ep12_jill_branch.rpy:614
translate schinese ep12_jill_solo_label_cbef4322:

    # mc "You have?"
    mc "你有吗？"

# episode12\branches\ep12_jill_branch.rpy:616
translate schinese ep12_jill_solo_label_25dd7daa:

    # ji "From the moment you told me you two got back together as friends, there was a little voice in the back of my head that whispered bad things."
    ji "从你告诉我你们俩重新以朋友身份走到一起的那一刻起，我脑子里就一直有个小声音在嘀咕着不好的事情。"

# episode12\branches\ep12_jill_branch.rpy:617
translate schinese ep12_jill_solo_label_6ae7864d:

    # ji "What if [name] falls in love with her again? What if it's more than just a friendship?"
    ji "什么如果[name]再次爱上她？如果这不仅仅是友情呢？"

# episode12\branches\ep12_jill_branch.rpy:619
translate schinese ep12_jill_solo_label_db6baf9c:

    # ji "But I didn't dare to voice my concerns to you because I didn't want you to think I didn't trust you."
    ji "但我实在不敢向你表达这些担忧，我怕你会觉得我不信任你。"

# episode12\branches\ep12_jill_branch.rpy:621
translate schinese ep12_jill_solo_label_2d820902:

    # mc "You've been uncomfortable about that all this time, huh? Sage actually told me about it."
    mc "你一直都为那件事感到不自在，对吧？其实Sage跟我说过。"

# episode12\branches\ep12_jill_branch.rpy:623
translate schinese ep12_jill_solo_label_97d5effd:

    # ji "She did? I told her that in confidence..."
    ji "她真的说了？我可是跟她说过这是保密的……"

# episode12\branches\ep12_jill_branch.rpy:625
translate schinese ep12_jill_solo_label_72cce55d:

    # mc "She let me know in a good way, though. She asked me to treat you right and be more mindful."
    mc "她用一种让我舒服的方式告诉我这件事。她让我好好对你，多加注意。"

# episode12\branches\ep12_jill_branch.rpy:626
translate schinese ep12_jill_solo_label_b6d213ec:

    # mc "Sage had your back."
    mc "Sage替你说了话。"

# episode12\branches\ep12_jill_branch.rpy:628
translate schinese ep12_jill_solo_label_3e0fa635:

    # ji "Oh... That's sweet of her."
    ji "哦……她还挺为你着想的。"

# episode12\branches\ep12_jill_branch.rpy:631
translate schinese ep12_jill_solo_label_ce5489a5:

    # mc "You don't have to worry about Zoey stealing me from you. I'm all yours."
    mc "你不用担心Zoey会抢走我。我全属于你。"

# episode12\branches\ep12_jill_branch.rpy:632
translate schinese ep12_jill_solo_label_aa682d9c:

    # mc "Zoey is just my friend."
    mc "不管是哪种情况，Zoey 只是我的朋友。"

# episode12\branches\ep12_jill_branch.rpy:635
translate schinese ep12_jill_solo_label_1a513c35:

    # mc "Either way, Zoey is just my friend."
    mc "不管怎样，Zoey 只是我的朋友。"

# episode12\branches\ep12_jill_branch.rpy:640
translate schinese ep12_jill_solo_label_c89c5843:

    # ji "Do you think she wants to stay your friend now that you rejected her?"
    ji "你觉得她现在还想要当你的朋友吗？你拒绝了她之后？"

# episode12\branches\ep12_jill_branch.rpy:641
translate schinese ep12_jill_solo_label_ede3db60:

    # ji "Won't that be awkward for you two?"
    ji "这不挺尴尬的吗？"

# episode12\branches\ep12_jill_branch.rpy:646
translate schinese ep12_jill_solo_label_64441b19:

    # mc "Uh... It might be awkward, but what else can we do? I mean, she's still my childhood friend."
    mc "嗯……可能会有点尴尬，但除此之外我们还能怎么办？我是说，她还是我儿时的朋友。"

# episode12\branches\ep12_jill_branch.rpy:651
translate schinese ep12_jill_solo_label_cf872bbd:

    # ji "But that's not all that she is nowadays. She's also your ex-girlfriend and, more recently, someone who loves you more than a friend."
    ji "但现在的她可不止是你的朋友。她还是你前女友，而且最近更爱着你，比朋友还要多。"

# episode12\branches\ep12_jill_branch.rpy:656
translate schinese ep12_jill_solo_label_0027e2df:

    # mc "I know, but... *{i}Sigh{/i}* That's not how I look at her."
    mc "我知道，但……*{i}叹气{/i}*那不是我看她的样子。"

# episode12\branches\ep12_jill_branch.rpy:657
translate schinese ep12_jill_solo_label_66ca68e5:

    # mc "Does it still make you uncomfortable that I'm her friend?"
    mc "这会让你觉得不自在吗？她还是你的朋友。"

# episode12\branches\ep12_jill_branch.rpy:663
translate schinese ep12_jill_solo_label_9b0024e1:

    # ji "Honestly... Now even more so than before."
    ji "说实话……现在比之前更让人尴尬了。"

# episode12\branches\ep12_jill_branch.rpy:666
translate schinese ep12_jill_solo_label_b7663841:

    # mc "All I need you to know is that I'm not in love with Zoey. I don't feel that way about her anymore."
    mc "我只想让你知道，我并不爱Zoey。我对她已经没有那种感觉了。"

# episode12\branches\ep12_jill_branch.rpy:667
translate schinese ep12_jill_solo_label_4191bdf2:

    # mc "And I think that I have proved that."
    mc "而且我觉得我已经证明了这一点。"

# episode12\branches\ep12_jill_branch.rpy:669
translate schinese ep12_jill_solo_label_3ab26658:

    # ji "I agree, and I appreciate that you told me."
    ji "我同意，而且谢谢你告诉我。"

# episode12\branches\ep12_jill_branch.rpy:670
translate schinese ep12_jill_solo_label_d0e1d610:

    # ji "It wasn't easy to hear, and I'm sure it wasn't easy for you to tell me."
    ji "听你这么说，我也不太好受，我知道对你来说说出来也挺难的。"

# episode12\branches\ep12_jill_branch.rpy:671
translate schinese ep12_jill_solo_label_8b980375:

    # ji "But I feel good about how you handled it. That makes me more confident in our relationship."
    ji "但我觉得你处理得不错，这让我对我们的关系更有信心了。"

# episode12\branches\ep12_jill_branch.rpy:673
translate schinese ep12_jill_solo_label_c4742e29:

    # mc "Can we talk about something else? I don't want to ruin this evening anymore."
    mc "我们换个话题吧，我不想再搞砸这个晚上。"

# episode12\branches\ep12_jill_branch.rpy:675
translate schinese ep12_jill_solo_label_82d29f72:

    # ji "It's not ruined."
    ji "这晚还没毁。"

# episode12\branches\ep12_jill_branch.rpy:677
translate schinese ep12_jill_solo_label_fb7ccde7:

    # ji "*{i}Smack{/i}*"
    ji "*{i}打耳光{/i}*"

# episode12\branches\ep12_jill_branch.rpy:679
translate schinese ep12_jill_solo_label_9cbaee96:

    # mc "Oh! Tell me about your meeting with Jonathan."
    mc "哦！跟我说说你和Jonathan的见面怎么样。"

# episode12\branches\ep12_jill_branch.rpy:683
translate schinese ep12_jill_solo_label_c1a116ad:

    # mc "(Then you're not gonna like hearing about Bianca... Fuck... What am I even doing with Jill?)"
    mc "（然后你可别怪我讲起Bianca的事...操...我到底在跟Jill干嘛？）"

# episode12\branches\ep12_jill_branch.rpy:685
translate schinese ep12_jill_solo_label_8c18187a:

    # mc "(Jill... If this is how you react to me rejecting Zoey... *{i}Sigh{/i}* Relationships are hard...)"
    mc "（Jill... 如果这就是你对我拒绝 Zoey... *{i}叹气{/i}*关系很难处理）"

# episode12\branches\ep12_jill_branch.rpy:686
translate schinese ep12_jill_solo_label_7e482834:

    # mc "Can we talk about something else?"
    mc "我们换个话题聊聊？"

# episode12\branches\ep12_jill_branch.rpy:687
translate schinese ep12_jill_solo_label_d8c05ebf:

    # mc "Maybe you can tell me about your meeting with Jonathan or something."
    mc "也许你可以跟我聊聊你和Jonathan的见面，或者别的什么。"

# episode12\branches\ep12_jill_branch.rpy:693
translate schinese ep12_jill_solo_label_952e8649:

    # ji "Sure... Um..."
    ji "当然... 嗯..."

# episode12\branches\ep12_jill_branch.rpy:695
translate schinese ep12_jill_solo_label_67c3d172:

    # ji "We had a long talk about the campaign I wanted to start for Lana."
    ji "我们谈了很久，关于我想要为Lana发起的竞选活动。"

# episode12\branches\ep12_jill_branch.rpy:696
translate schinese ep12_jill_solo_label_f798e8da:

    # ji "And right now, the idea is that I'll set up a foundation honoring her memory."
    ji "现在这个想法是，我会设立一个基金会来纪念她的记忆。"

# episode12\branches\ep12_jill_branch.rpy:701
translate schinese ep12_jill_solo_label_47b339c0:

    # mc "How does that work?"
    mc "这怎么运作？"

# episode12\branches\ep12_jill_branch.rpy:706
translate schinese ep12_jill_solo_label_1d4823f1:

    # ji "Well, a foundation can be many things. In this case, I want it to help youth in situations like my sister's."
    ji "好吧，基金会可以有很多种形式。这次我想让它帮助像我姐姐那样的年轻人。"

# episode12\branches\ep12_jill_branch.rpy:707
translate schinese ep12_jill_solo_label_f98baefc:

    # ji "I want to raise awareness about the risks of substance abuse and inform teenagers how they can get help if they need it."
    ji "我想提高大家对毒品滥用风险的认识，并告诉青少年如果他们需要帮助，该怎么寻求援助。"

# episode12\branches\ep12_jill_branch.rpy:710
translate schinese ep12_jill_solo_label_889f43ac:

    # ji "Jonathan and I talked about hosting seminars and speaking at high schools, among other things."
    ji "我和 Jonathan 讨论过举办研讨会、去高中演讲之类的各种事情。"

# episode12\branches\ep12_jill_branch.rpy:715
translate schinese ep12_jill_solo_label_d7b9e4a9:

    # mc "It sounds like hard work."
    mc "听起来挺费劲的。"

# episode12\branches\ep12_jill_branch.rpy:720
translate schinese ep12_jill_solo_label_fa0157b7:

    # ji "It is. But it's also something I really want to do."
    ji "是的。但这也是我真正想做的事情。"

# episode12\branches\ep12_jill_branch.rpy:723
translate schinese ep12_jill_solo_label_d7e1d997:

    # mc "Can I help in any way?"
    mc "我能帮上什么忙吗？"

# episode12\branches\ep12_jill_branch.rpy:725
translate schinese ep12_jill_solo_label_b712f7cd:

    # ji "You want to help me?"
    ji "你愿意帮我吗？"

# episode12\branches\ep12_jill_branch.rpy:727
translate schinese ep12_jill_solo_label_7c0370f3:

    # mc "I'm not sure if I can, but if there's anything I can do - absolutely!"
    mc "我不确定自己能不能帮上忙，但如果有什么能做的——绝对没问题！"

# episode12\branches\ep12_jill_branch.rpy:729
translate schinese ep12_jill_solo_label_31c25c0f:

    # ji "You're so sweet! Thank you."
    ji "你真是个好人！谢谢！"

# episode12\branches\ep12_jill_branch.rpy:730
translate schinese ep12_jill_solo_label_f1c416a8:

    # ji "I'll let you know if something comes to mind."
    ji "如果你想到什么了，就告诉我。"

# episode12\branches\ep12_jill_branch.rpy:733
translate schinese ep12_jill_solo_label_8c0788e8:

    # mc "You should go for it then."
    mc "那你去试试吧。"

# episode12\branches\ep12_jill_branch.rpy:736
translate schinese ep12_jill_solo_label_adcad918:

    # ji "Right now, I'm at the stage of defining what it will be and gathering information on how to do it."
    ji "现在我正处在确定它会是什么样子，并收集如何做到这些信息的阶段。"

# episode12\branches\ep12_jill_branch.rpy:739
translate schinese ep12_jill_solo_label_11a254be:

    # ji "Speaking of Lana... When I visited to pick up her guitar for you, I also brought some of her clothes back with me."
    ji "说到Lana的事……我去她家拿吉他给你的时候，顺便也带了些她的衣服回来。"

# episode12\branches\ep12_jill_branch.rpy:744
translate schinese ep12_jill_solo_label_736ed73c:

    # mc "Lana's clothes?"
    mc "Lana的衣服？"

# episode12\branches\ep12_jill_branch.rpy:749
translate schinese ep12_jill_solo_label_4ddfc243:

    # ji "Yes. I don't know why I did it, but I wanted to try them on."
    ji "是的。我不知道自己为什么这么做，但我就是想试试看。"

# episode12\branches\ep12_jill_branch.rpy:750
translate schinese ep12_jill_solo_label_a8b48e76:

    # ji "I think it was because of you and our time at the mall."
    ji "我想大概是因为你和我们在商场的那段时间。"

# episode12\branches\ep12_jill_branch.rpy:755
translate schinese ep12_jill_solo_label_9aa385a9:

    # mc "Have you ever tried them on before?"
    mc "你以前试过穿吗？"

# episode12\branches\ep12_jill_branch.rpy:760
translate schinese ep12_jill_solo_label_a1ed28b2:

    # ji "No, I never did. Well, except for her hat. Oh! And one of her hoodies I used to find comfort in when I was younger."
    ji "没有，我从来没试过。嗯，除了她的帽子。噢！还有她的一件毛衣，我年轻的时候经常穿它来找点安慰。"

# episode12\branches\ep12_jill_branch.rpy:761
translate schinese ep12_jill_solo_label_99d5df9d:

    # ji "I brought that one with me, too."
    ji "我也带了那件过来。"

# episode12\branches\ep12_jill_branch.rpy:762
translate schinese ep12_jill_solo_label_b5a12cf9:

    # ji "Wanna see?"
    ji "想看看吗？"

# episode12\branches\ep12_jill_branch.rpy:767
translate schinese ep12_jill_solo_label_ef7fab3e:

    # mc "Sure! Bring on the fashion show."
    mc "当然，快开始你的时装秀吧。"

# episode12\branches\ep12_jill_branch.rpy:769
translate schinese ep12_jill_solo_label_eee38ace:

    # ji "It's hardly a fashion show, and it's not my style at all!"
    ji "这根本不算什么时装秀，而且完全不是我的风格！"

# episode12\branches\ep12_jill_branch.rpy:771
translate schinese ep12_jill_solo_label_8cdac67b:

    # mc "Hey, don't say that. Leave it for the judge."
    mc "嘿，别这么说。留着给法官说吧。"

# episode12\branches\ep12_jill_branch.rpy:774
translate schinese ep12_jill_solo_label_25334021:

    # ji "This was her hoodie and her hat."
    ji "这是她的连帽衫和帽子。"

# episode12\branches\ep12_jill_branch.rpy:776
translate schinese ep12_jill_solo_label_467a1760:

    # mc "Wow... I remember the picture you showed me of her."
    mc "哇……我记得你之前给我看过的她的照片。"

# episode12\branches\ep12_jill_branch.rpy:777
translate schinese ep12_jill_solo_label_d94c3b1d:

    # mc "You look even more like her now."
    mc "你现在看起来跟她越来越像了。"

# episode12\branches\ep12_jill_branch.rpy:779
translate schinese ep12_jill_solo_label_3126b766:

    # ji "Do you think?"
    ji "你觉得呢？"

# episode12\branches\ep12_jill_branch.rpy:781
translate schinese ep12_jill_solo_label_2f068911:

    # mc "I do."
    mc "我确实这么想。"

# episode12\branches\ep12_jill_branch.rpy:783
translate schinese ep12_jill_solo_label_69f885c2:

    # ji "But I can't pull this off as well as she did."
    ji "但我可没法像她那样完美地驾驭这套。"

# episode12\branches\ep12_jill_branch.rpy:785
translate schinese ep12_jill_solo_label_3b37c096:

    # mc "Don't say that. I think you can. You look cool wearing it!"
    mc "别这么说。我觉得你可以。你穿这个看起来很酷！"

# episode12\branches\ep12_jill_branch.rpy:787
translate schinese ep12_jill_solo_label_67b76fa5:

    # ji "(Haha... Maybe I can pull it off!?)"
    ji "（哈哈……说不定我也能做到！？）"

# episode12\branches\ep12_jill_branch.rpy:789
translate schinese ep12_jill_solo_label_c78efd07:

    # ji "Oh! And I also brought something else."
    ji "哦！我还带了点别的东西。"

# episode12\branches\ep12_jill_branch.rpy:790
translate schinese ep12_jill_solo_label_d8fe8449:

    # ji "Hold on for a second while I get changed. No peeking!"
    ji "等一下，我换衣服呢，别偷看！"

# episode12\branches\ep12_jill_branch.rpy:792
translate schinese ep12_jill_solo_label_f8954996:

    # mc "No peeking? I've seen you naked many times."
    mc "别偷看？我可是一直都见过你光着身子的。"

# episode12\branches\ep12_jill_branch.rpy:794
translate schinese ep12_jill_solo_label_1317c2c2:

    # ji "Haha! I mean, I don't want you to see the clothes until I'm fully dressed. That will ruin the element of surprise."
    ji "哈哈！我是说，我不想让你在我不完全穿好之前看到衣服。那样会破坏惊喜的元素。"

# episode12\branches\ep12_jill_branch.rpy:797
translate schinese ep12_jill_solo_label_de985271:

    # ji "There! You can look!"
    ji "搞定！你可以看了！"

# episode12\branches\ep12_jill_branch.rpy:799
translate schinese ep12_jill_solo_label_470ef408:

    # mc "Whoa! Did she wear that?"
    mc "哇！她穿这个了？"

# episode12\branches\ep12_jill_branch.rpy:801
translate schinese ep12_jill_solo_label_b360f222:

    # ji "Yeah. We're not the same size in some parts."
    ji "嗯。我们在某些地方尺寸不太一样。"

# episode12\branches\ep12_jill_branch.rpy:803
translate schinese ep12_jill_solo_label_4e62b165:

    # mc "You filled that out well. Wow..."
    mc "你穿得不错。哇……"

# episode12\branches\ep12_jill_branch.rpy:804
translate schinese ep12_jill_solo_label_97b9a591:

    # ji "Haha! Stop it!"
    ji "哈哈！别闹了！"

# episode12\branches\ep12_jill_branch.rpy:806
translate schinese ep12_jill_solo_label_1d2b4577:

    # mc "No, but seriously... You look so good."
    mc "不，但说真的……你看起来真的很棒。"

# episode12\branches\ep12_jill_branch.rpy:808
translate schinese ep12_jill_solo_label_3f6df6dc:

    # ji "[name], I'm not used to wearing clothes like this."
    ji "[name]我不习惯穿这种衣服。"

# episode12\branches\ep12_jill_branch.rpy:809
translate schinese ep12_jill_solo_label_890b5e18:

    # ji "If you look at my wardrobe, you'd know."
    ji "如果你看看我的衣柜，你就知道了。"

# episode12\branches\ep12_jill_branch.rpy:811
translate schinese ep12_jill_solo_label_a0d65f44:

    # mc "I don't have to look at your wardrobe; I've seen what you wear."
    mc "我用不着看你穿什么，我清楚你平时都怎么打扮。"

# episode12\branches\ep12_jill_branch.rpy:814
translate schinese ep12_jill_solo_label_46c1c7e4:

    # mc "And I'm not disrespecting your usual clothes because you always look beautiful..."
    mc "而且我并不是在贬低你平时穿的衣服，因为你一直都很好看……"

# episode12\branches\ep12_jill_branch.rpy:815
translate schinese ep12_jill_solo_label_d53bfe2b:

    # mc "I'm simply saying that you could wear this too."
    mc "我只是说你也可以这么穿。"

# episode12\branches\ep12_jill_branch.rpy:817
translate schinese ep12_jill_solo_label_baacef4b:

    # ji "Can you imagine me wearing this to class or walking around campus in it?"
    ji "你能想象我穿着这个去上课或者在校园里这么走吗？"

# episode12\branches\ep12_jill_branch.rpy:819
translate schinese ep12_jill_solo_label_6caabb53:

    # mc "I can."
    mc "我能。"

# episode12\branches\ep12_jill_branch.rpy:821
translate schinese ep12_jill_solo_label_311f9443:

    # ji "Everyone would turn their heads, wouldn't they?"
    ji "大家都会转过头来看你，不是吗？"

# episode12\branches\ep12_jill_branch.rpy:823
translate schinese ep12_jill_solo_label_5fee8565:

    # mc "They sure would. It's winter."
    mc "他们确实会。现在是冬天。"

# episode12\branches\ep12_jill_branch.rpy:825
translate schinese ep12_jill_solo_label_9ba5ac86:

    # ji "Ha-ha... I didn't mean it like that. I meant, they would notice the contrast of my usual self."
    ji "哈——哈……我可不是那个意思。我是说，他们会注意到我平时和现在之间的反差。"

# episode12\branches\ep12_jill_branch.rpy:827
translate schinese ep12_jill_solo_label_455de1da:

    # mc "Yeah, that too. But who gives a crap about what people think?"
    mc "那也对。但谁在乎别人怎么看？"

# episode12\branches\ep12_jill_branch.rpy:828
translate schinese ep12_jill_solo_label_c10c7ba0:

    # mc "I don't dress the way I do for others. I don't even give much thought to what I wear. Clothes are just clothes."
    mc "我穿这身不是为了取悦别人。我甚至不太在意自己穿什么。衣服不过就是衣服罢了。"

# episode12\branches\ep12_jill_branch.rpy:830
translate schinese ep12_jill_solo_label_f73069a5:

    # ji "So, you think I should wear this?"
    ji "所以，你觉得我该穿这身吗？"

# episode12\branches\ep12_jill_branch.rpy:832
translate schinese ep12_jill_solo_label_3b5b74fe:

    # mc "Would you want to wear it?"
    mc "你想要穿吗？"

# episode12\branches\ep12_jill_branch.rpy:834
translate schinese ep12_jill_solo_label_bd797ba0:

    # ji "..."
    ji "..."

# episode12\branches\ep12_jill_branch.rpy:836
translate schinese ep12_jill_solo_label_e9dc1c71:

    # ji "I think I look good."
    ji "我觉得我穿得不错。"

# episode12\branches\ep12_jill_branch.rpy:837
translate schinese ep12_jill_solo_label_345d382c:

    # ji "But I'm unsure... It's a scary thought. It feels like I'm doing something forbidden."
    ji "但我有点不确定……这想法挺可怕的。感觉好像在做一件被禁止的事。"

# episode12\branches\ep12_jill_branch.rpy:839
translate schinese ep12_jill_solo_label_3f4b0f51:

    # mc "Who forbade you to wear clothes like that?"
    mc "谁禁止你穿这种衣服？"

# episode12\branches\ep12_jill_branch.rpy:840
translate schinese ep12_jill_solo_label_bd797ba0_1:

    # ji "..."
    ji "..."

# episode12\branches\ep12_jill_branch.rpy:842
translate schinese ep12_jill_solo_label_3c73b0dc:

    # ji "Take a guess."
    ji "猜猜看。"

# episode12\branches\ep12_jill_branch.rpy:844
translate schinese ep12_jill_solo_label_06a3a8a1:

    # mc "Your parents?"
    mc "你爸妈？"

# episode12\branches\ep12_jill_branch.rpy:846
translate schinese ep12_jill_solo_label_d8c2fdbc:

    # ji "Mom wouldn't like it..."
    ji "我妈不会喜欢的..."

# episode12\branches\ep12_jill_branch.rpy:847
translate schinese ep12_jill_solo_label_eb51629e:

    # ji "That's why it feels like it's forbidden."
    ji "这就是为什么它感觉像是被禁止的。"

# episode12\branches\ep12_jill_branch.rpy:849
translate schinese ep12_jill_solo_label_5cccf421:

    # mc "I see. Do you know that for sure?"
    mc "我明白了。你确定吗？"

# episode12\branches\ep12_jill_branch.rpy:851
translate schinese ep12_jill_solo_label_98b701a5:

    # ji "Yes... I do. In fact, when I picked up your gift and these clothes, we got into an argument."
    ji "是的……我知道。事实上，当我接过你的礼物和这些衣服时，我们吵了一架。"

# episode12\branches\ep12_jill_branch.rpy:852
translate schinese ep12_jill_solo_label_d3d5225e:

    # ji "They worry about me."
    ji "他们担心我。"

# episode12\branches\ep12_jill_branch.rpy:854
translate schinese ep12_jill_solo_label_6e5e516f:

    # mc "Worry how?"
    mc "担心什么？"

# episode12\branches\ep12_jill_branch.rpy:857
translate schinese ep12_jill_solo_label_175d716f:

    # ji "They raised some concerns about you and our relationship."
    ji "他们对你，还有我们的关系，提出了一些担忧。"

# episode12\branches\ep12_jill_branch.rpy:859
translate schinese ep12_jill_solo_label_47764d9b:

    # ji "They saw how I dressed when I showed up, and they raised some concerns about you and our relationship."
    ji "他们看到我穿成什么样儿来了，就对我们俩的关系表示了担忧。"

# episode12\branches\ep12_jill_branch.rpy:860
translate schinese ep12_jill_solo_label_3923c44a:

    # ji "I think they are scared that I'm going to turn into my sister."
    ji "我想他们怕我会变成我姐姐那样的人。"

# episode12\branches\ep12_jill_branch.rpy:862
translate schinese ep12_jill_solo_label_6e13e447:

    # mc "Huh? Because of me?"
    mc "怎么？因为是我？"

# episode12\branches\ep12_jill_branch.rpy:864
translate schinese ep12_jill_solo_label_32d83ee0:

    # ji "I think they see Jonathan in you, and they see Lana in me."
    ji "我觉得他们从你身上看到了Jonathan，从我身上看到了Lana。"

# episode12\branches\ep12_jill_branch.rpy:866
translate schinese ep12_jill_solo_label_3928bee9:

    # mc "So, they don't like me? That's tough to hear."
    mc "所以他们不喜欢我？听到这个挺难接受的。"

# episode12\branches\ep12_jill_branch.rpy:868
translate schinese ep12_jill_solo_label_c1fa111a:

    # ji "It's not that they don't like you. It's more that they get flashbacks to how it was when Lana dated Jonathan."
    ji "不是他们不喜欢你，而是每次看到你，他们就会想起Lana和Jonathan在一起的时候。"

# episode12\branches\ep12_jill_branch.rpy:869
translate schinese ep12_jill_solo_label_a93336b9:

    # ji "I think it's uncalled for. But they are scarred from the trauma."
    ji "我觉得这有点过分。但他们的创伤还没好。"

# episode12\branches\ep12_jill_branch.rpy:870
translate schinese ep12_jill_solo_label_0bbb3563:

    # ji "So... If I dress like this, I know they would get increasingly concerned."
    ji "所以……如果我穿成这样，他们肯定会越来越担心。"

# episode12\branches\ep12_jill_branch.rpy:872
translate schinese ep12_jill_solo_label_6766a3b7:

    # mc "Well... Your mom doesn't go to B&R."
    mc "那你的老妈也不去你家啊。"

# episode12\branches\ep12_jill_branch.rpy:873
translate schinese ep12_jill_solo_label_e07cf8a3:

    # mc "I see this as you doing something for yourself. And there is nothing wrong with that."
    mc "我觉得你这么做是为了自己。这没什么不对的。"

# episode12\branches\ep12_jill_branch.rpy:875
translate schinese ep12_jill_solo_label_bd797ba0_2:

    # ji "..."
    ji "..."

# episode12\branches\ep12_jill_branch.rpy:877
translate schinese ep12_jill_solo_label_be59f087:

    # ji "You like this, right?"
    ji "你喜欢这样，对吧？"

# episode12\branches\ep12_jill_branch.rpy:879
translate schinese ep12_jill_solo_label_7f25b609:

    # mc "Yes, but I like you in your usual clothes too."
    mc "是的，但我也喜欢你平时穿的衣服。"

# episode12\branches\ep12_jill_branch.rpy:880
translate schinese ep12_jill_solo_label_756132d9:

    # mc "Men shouldn't tell women what to wear."
    mc "男人不该告诉女人穿什么衣服。"

# episode12\branches\ep12_jill_branch.rpy:881
