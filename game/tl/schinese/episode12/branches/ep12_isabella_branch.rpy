    # mc "How can I...uh...compete? Compare? Uh..."
    mc "我怎么...呃...竞争？比得上？呃..."

# episode12\branches\ep12_isabella_branch.rpy:184
translate schinese ep12_bella_lib_label_6c9f7871:

