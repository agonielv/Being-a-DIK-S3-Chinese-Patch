    # mc "Hey... Slow day?"
    mc "嘿……今天人真少？"

# episode12\branches\ep12_isabella_branch.rpy:10
translate schinese ep12_bella_lib_label_ab15b08a:

    # isa "No. It's been eventful."
    isa "不，挺热闹的。"

# episode12\branches\ep12_isabella_branch.rpy:12
translate schinese ep12_bella_lib_label_301451a2:

    # mc "I'm glad I caught you. I'm here to study, but..."
    mc "我很高兴现在能碰到你。我本来是来学习的，但是……"

# episode12\branches\ep12_isabella_branch.rpy:13
translate schinese ep12_bella_lib_label_f6409def:

    # mc "We...uh...should talk."
    mc "我们...呃...得谈谈。"

# episode12\branches\ep12_isabella_branch.rpy:15
translate schinese ep12_bella_lib_label_a8d6630a:

    # mc "There's something I need to tell you... Something that you should hear from me first..."
    mc "有件事我得告诉你……有些事你应该先从我这里听到……"

# episode12\branches\ep12_isabella_branch.rpy:17
translate schinese ep12_bella_lib_label_f66dd95b:

    # isa "I talked to Sage and Jill about an hour ago."
    isa "我一个小时之前就跟Jill和Sage谈过了。"

# episode12\branches\ep12_isabella_branch.rpy:19
translate schinese ep12_bella_lib_label_448842ec:

    # mc "Then you already know..."
    mc "那你已经知道了..."

# episode12\branches\ep12_isabella_branch.rpy:21
translate schinese ep12_bella_lib_label_21c47531:

    # isa "What I don't get is why it took you this long to tell me."
    isa "我就是不明白，你为什么到现在才告诉我这件事。"

# episode12\branches\ep12_isabella_branch.rpy:23
translate schinese ep12_bella_lib_label_f961874a:

    # mc "Mainly because I was ashamed. When I realized Jade was Sage's mom, the damage was already done."
    mc "主要因为我感到很羞愧。当我意识到Jade是Sage的妈妈时，事情已经无法挽回了。"

# episode12\branches\ep12_isabella_branch.rpy:25
translate schinese ep12_bella_lib_label_d850dea1:

    # isa "So, if she weren't her mother, it wouldn't have been a big deal to do that to Jade?"
    isa "所以，如果她不是你妈妈，你对Jade做那种事就没什么大不了的？"

# episode12\branches\ep12_isabella_branch.rpy:27
translate schinese ep12_bella_lib_label_5425cf97:

    # mc "Of course, it was..."
    mc "当然，那件事发生了……"

# episode12\branches\ep12_isabella_branch.rpy:29
translate schinese ep12_bella_lib_label_5e146271:

    # isa "Would you have done that to me?"
    isa "你也会对我这么做吗？"

# episode12\branches\ep12_isabella_branch.rpy:31
translate schinese ep12_bella_lib_label_4491cd8d:

    # mc "No! It was during Hell Week, Bella... You did things you're ashamed of, too, right?"
    mc "不！那是在地狱周，贝拉……你那时候也做了很多让你羞愧的事，对吧？"

# episode12\branches\ep12_isabella_branch.rpy:33
translate schinese ep12_bella_lib_label_d5913ca7:

    # isa "You know I did, but they aren't comparable to this. *{i}Sigh{/i}*"
    isa "你知道我做过，但那些事根本不能和这件事相比。*{i}叹气{/i}*"

# episode12\branches\ep12_isabella_branch.rpy:34
translate schinese ep12_bella_lib_label_72cddba2:

    # isa "Your moral compass is broken, [name]. And I suppose mine needs a tune-up too."
    isa "你的道德指南针坏了，[name]我的也该保养一下了。"

# episode12\branches\ep12_isabella_branch.rpy:38
translate schinese ep12_bella_lib_label_ea6169df:

    # mc "I made a big mistake."
    mc "我犯了个大错。"

# episode12\branches\ep12_isabella_branch.rpy:39
translate schinese ep12_bella_lib_label_9ee7f2c6:

    # mc "I don't think Sage will forgive me for it... Please, don't tell me you won't either."
    mc "我不觉得Sage会原谅我……求你了，别告诉我你也不会。"

# episode12\branches\ep12_isabella_branch.rpy:41
translate schinese ep12_bella_lib_label_436fa631:

    # isa "I wish I could tell you no, [name]. But I can't."
    isa "我希望我可以说不，[name]但我不行。"

# episode12\branches\ep12_isabella_branch.rpy:42
translate schinese ep12_bella_lib_label_fa7b86f2:

    # isa "Besides, why does it matter to you? You've made your choice about us already."
    isa "况且，这跟你有什么关系？你已经对我们的关系做了选择。"

# episode12\branches\ep12_isabella_branch.rpy:44
translate schinese ep12_bella_lib_label_7b6407fe:

    # mc "Yeah, but that was different. I'm still in love with my ex-girlfriend Zoey."
    mc "是的，但那不一样。我依然爱着我前女友Zoey。"

# episode12\branches\ep12_isabella_branch.rpy:46
translate schinese ep12_bella_lib_label_fa5eb4d6:

    # isa "The reason doesn't matter. It doesn't make it hurt less."
    isa "理由不重要。它不会让伤痛减轻。"

# episode12\branches\ep12_isabella_branch.rpy:47
translate schinese ep12_bella_lib_label_6637c76a:

    # isa "And in combination with Jade and Sage..."
    isa "再加上Jade和Sage……"

# episode12\branches\ep12_isabella_branch.rpy:48
translate schinese ep12_bella_lib_label_f96b80ff:

    # isa "Honestly, I think it's for the best that we both move on."
    isa "说实话，我觉得我们两个都往前看比较好。"

# episode12\branches\ep12_isabella_branch.rpy:50
translate schinese ep12_bella_lib_label_baf08d24:

    # mc "I can't let this go. You mean a lot to me."
    mc "我不能就这样放下。你对我来说意义很大。"

# episode12\branches\ep12_isabella_branch.rpy:52
translate schinese ep12_bella_lib_label_7ecf8b0b:

    # isa "You can't have it both ways, [name]. It doesn't work like that."
    isa "你不能两边都占着[name]那不是这么运作的。"

# episode12\branches\ep12_isabella_branch.rpy:54
translate schinese ep12_bella_lib_label_ebb51d36:

    # isa "If it helps you move on, I don't wish to be with you either."
    isa "如果这能帮你放下，我也不希望和你在一起了。"

# episode12\branches\ep12_isabella_branch.rpy:55
translate schinese ep12_bella_lib_label_c0aa2c9a:

    # isa "Whatever we had... It's over."
    isa "不管我们曾经有过什么…都结束了。"

# episode12\branches\ep12_isabella_branch.rpy:61
translate schinese ep12_bella_lib_label_6daf4e51:

    # isa "It's too much."
    isa "这已经太多了。"

# episode12\branches\ep12_isabella_branch.rpy:63
translate schinese ep12_bella_lib_label_3e6ed21d:

    # mc "We're not breaking up over this, right?"
    mc "我们不是因为这个要分手的，对吧？"

# episode12\branches\ep12_isabella_branch.rpy:65
translate schinese ep12_bella_lib_label_ef7b9a28:

    # isa "It doesn't bring us closer, [name]."
    isa "这并不能让我们更接近[name]."

# episode12\branches\ep12_isabella_branch.rpy:67
translate schinese ep12_bella_lib_label_e851b7a7:

    # mc "I care so much about you, Bella. I made a big mistake."
    mc "我真的很在乎你，贝拉。我犯了一个大错。"

# episode12\branches\ep12_isabella_branch.rpy:68
translate schinese ep12_bella_lib_label_9ee7f2c6_1:

    # mc "I don't think Sage will forgive me for it... Please, don't tell me you won't either."
    mc "我不觉得Sage会原谅我……求你了，别告诉我你也不会原谅我。"

# episode12\branches\ep12_isabella_branch.rpy:70
translate schinese ep12_bella_lib_label_ec2ddf38:

    # isa "I wish I could tell you no, [name]. But I can't. I need some time to process this."
    isa "我希望我可以说不，[name]但我不能。我需要一些时间来消化这件事。"

# episode12\branches\ep12_isabella_branch.rpy:71
translate schinese ep12_bella_lib_label_d95e5981:

    # isa "I have to ask you to give me space."
    isa "我需要你给我一些空间。"

# episode12\branches\ep12_isabella_branch.rpy:77
translate schinese ep12_bella_lib_label_20a0b8e6:

    # isa "Hi. Not exactly. The library is always extra busy during finals week."
    isa "嗨，不是这样的。考试周的时候图书馆总是特别忙。"

# episode12\branches\ep12_isabella_branch.rpy:79
translate schinese ep12_bella_lib_label_700d9d36:

    # mc "Ah... Of course."
    mc "啊……当然了。"

# episode12\branches\ep12_isabella_branch.rpy:81
translate schinese ep12_bella_lib_label_fd450187:

    # isa "But most of the students don't ask for my help. So, I've got ample time to do what I need to do."
    isa "但大多数学生都不会来找我帮忙。所以我有充足的时间做我需要做的事情。"

# episode12\branches\ep12_isabella_branch.rpy:82
translate schinese ep12_bella_lib_label_1402088d:

    # isa "I take it you're here to study, too."
    isa "我猜你是来学习的吧。"

# episode12\branches\ep12_isabella_branch.rpy:84
translate schinese ep12_bella_lib_label_0c8d02b1:

    # mc "I am, but I also needed to talk to you."
    mc "我也是，但我还需要和你谈谈。"

# episode12\branches\ep12_isabella_branch.rpy:86
translate schinese ep12_bella_lib_label_f6c59a7d:

    # isa "Follow me."
    isa "跟我来。"

# episode12\branches\ep12_isabella_branch.rpy:88
translate schinese ep12_bella_lib_label_478b9332:

    # mc "How are you feeling?"
    mc "你感觉怎么样？"

# episode12\branches\ep12_isabella_branch.rpy:90
translate schinese ep12_bella_lib_label_4f5add54:

    # isa "I've been experiencing emotional whiplash. How about you?"
    isa "我最近情绪起伏挺大的。你呢？"

# episode12\branches\ep12_isabella_branch.rpy:94
translate schinese ep12_bella_lib_label_d6b8c1ee:

    # mc "It's the same for me... I feel low."
    mc "我也是，感觉挺低落的。"

# episode12\branches\ep12_isabella_branch.rpy:95
translate schinese ep12_bella_lib_label_61461da5:

    # mc "I came here because we need to talk...and I didn't want to do it over the phone."
    mc "我来这里是因为我们得谈谈……我不想打电话说。"

# episode12\branches\ep12_isabella_branch.rpy:97
translate schinese ep12_bella_lib_label_01de88b0:

    # isa "[name]. You already told me face-to-face."
    isa "[name]你已经当面跟我说过了。"

# episode12\branches\ep12_isabella_branch.rpy:99
translate schinese ep12_bella_lib_label_3fdbe7ab:

    # mc "But I didn't tell you the reason."
    mc "但我没告诉你原因。"

# episode12\branches\ep12_isabella_branch.rpy:101
translate schinese ep12_bella_lib_label_592f00e6:

    # isa "I don't need to hear it because I can come up with several reasons of my own why it's the smartest choice."
    isa "我根本不需要听这些，我自己就能想出一大堆理由，证明这是最聪明的选择。"

# episode12\branches\ep12_isabella_branch.rpy:102
translate schinese ep12_bella_lib_label_248798bf:

    # isa "Hearing myself talk with you guys about James, my daughter, and everything that followed..."
    isa "听到自己和你们谈论James，我女儿，以及之后发生的一切……"

# episode12\branches\ep12_isabella_branch.rpy:103
translate schinese ep12_bella_lib_label_7aaee117:

    # isa "It's too much for us to handle. Isn't it?"
    isa "这对我们来说太沉重了，不是吗？"

# episode12\branches\ep12_isabella_branch.rpy:105
translate schinese ep12_bella_lib_label_c668ce1d:

    # mc "It's a lot, but I had made up my mind before you told me that."
    mc "这事儿挺多的，但我早在你告诉我之前就下定决心了。"

# episode12\branches\ep12_isabella_branch.rpy:106
translate schinese ep12_bella_lib_label_a02b2d02:

    # mc "And now I feel worse because I'm hurting you further... And you don't deserve it."
    mc "现在我感觉更糟了，因为我伤到了你……而你根本不该受到这种伤害。"

# episode12\branches\ep12_isabella_branch.rpy:107
translate schinese ep12_bella_lib_label_8ff8e9eb:

    # mc "I wanted to make sure that you understood that it's not because of you..."
    mc "我只是想确保你明白，这并不是因为你的缘故……"

# episode12\branches\ep12_isabella_branch.rpy:109
translate schinese ep12_bella_lib_label_c82fcbdf:

    # mc "I'm still in love with my ex-girlfriend Zoey. And she's in love with me, too."
    mc "我依然爱着我的前女友Zoey，她也还爱着我。"

# episode12\branches\ep12_isabella_branch.rpy:111
translate schinese ep12_bella_lib_label_454655fc:

    # isa "Neither reason would make it hurt less, [name]. The outcome is the same."
    isa "任何一个理由都不会让疼痛减轻[name]结果是一样的。"

# episode12\branches\ep12_isabella_branch.rpy:112
translate schinese ep12_bella_lib_label_8d99141d:

    # isa "That's why you didn't have to share it with me."
    isa "这就是为什么你不用跟我分享这些。"

# episode12\branches\ep12_isabella_branch.rpy:114
translate schinese ep12_bella_lib_label_d6424335:

    # mc "You told me that you were drowning...and that I was your air..."
    mc "你跟我说你快要淹死了……而我就是你呼吸的空气……"

# episode12\branches\ep12_isabella_branch.rpy:115
translate schinese ep12_bella_lib_label_ff99bd42:

    # mc "I'm worried, Bella."
    mc "我担心你，贝拉。"

# episode12\branches\ep12_isabella_branch.rpy:116
translate schinese ep12_bella_lib_label_fb623a7e:

    # isa "..."
    isa "..."

# episode12\branches\ep12_isabella_branch.rpy:118
translate schinese ep12_bella_lib_label_4e61ab6b:

    # isa "I did say that. And I meant it."
    isa "我确实说过，而且是认真的。"

# episode12\branches\ep12_isabella_branch.rpy:119
translate schinese ep12_bella_lib_label_778da15d:

    # isa "Just like how I don't want you to treat me differently because of my past, I don't want you to stay with me out of pity."
    isa "就像我不想因为你过去的事而对你另眼相看，我也不想你因为同情我才留下。"

# episode12\branches\ep12_isabella_branch.rpy:121
translate schinese ep12_bella_lib_label_95fdb9a5:

    # mc "Pity? I don't pity you, I-"
    mc "怜悯？我可没怜悯你，我——"

# episode12\branches\ep12_isabella_branch.rpy:123
translate schinese ep12_bella_lib_label_688af299:

    # isa "You don't have to worry."
    isa "你不用担心。"

# episode12\branches\ep12_isabella_branch.rpy:124
translate schinese ep12_bella_lib_label_13d3def4:

    # isa "It hurts... But I've been through much worse. I can handle this."
    isa "它疼...但比起我经历过的，这算不了什么。我应付得来。"

# episode12\branches\ep12_isabella_branch.rpy:126
translate schinese ep12_bella_lib_label_cfce055e:

    # mc "Are you sure?"
    mc "你确定吗？"

# episode12\branches\ep12_isabella_branch.rpy:128
translate schinese ep12_bella_lib_label_91a616fa:

    # isa "Let it go, [name]. And so will I."
    isa "放手吧，[name]我也会这样。"

# episode12\branches\ep12_isabella_branch.rpy:132
translate schinese ep12_bella_lib_label_baf08d24_1:

    # mc "I can't let this go. You mean a lot to me."
    mc "我不能放手。你对我来说意义重大。"

# episode12\branches\ep12_isabella_branch.rpy:134
translate schinese ep12_bella_lib_label_7ecf8b0b_1:

    # isa "You can't have it both ways, [name]. It doesn't work like that."
    isa "你不能两边都占着[name]那不是这么运作的。"

# episode12\branches\ep12_isabella_branch.rpy:136
translate schinese ep12_bella_lib_label_ebb51d36_1:

    # isa "If it helps you move on, I don't wish to be with you either."
    isa "如果这能帮你放下，我也不希望和你在一起了。"

# episode12\branches\ep12_isabella_branch.rpy:137
translate schinese ep12_bella_lib_label_c0aa2c9a_1:

    # isa "Whatever we had... It's over."
    isa "无论我们曾经有过什么…都结束了。"

# episode12\branches\ep12_isabella_branch.rpy:143
translate schinese ep12_bella_lib_label_f72c9e60:

    # mc "I understand. I'm hanging in there."
    mc "我明白。我还在坚持。"

# episode12\branches\ep12_isabella_branch.rpy:144
translate schinese ep12_bella_lib_label_d8b681f9:

    # mc "Thank you for the party again."
    mc "谢谢你的派对。"

# episode12\branches\ep12_isabella_branch.rpy:146
translate schinese ep12_bella_lib_label_3dd5de4c:

    # isa "At least it ended well."
    isa "至少结局不错。"

# episode12\branches\ep12_isabella_branch.rpy:148
translate schinese ep12_bella_lib_label_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# episode12\branches\ep12_isabella_branch.rpy:150
translate schinese ep12_bella_lib_label_9bc52c6b:

    # isa "Was there something on your mind?"
    isa "你脑子里是不是有什么事？"

# episode12\branches\ep12_isabella_branch.rpy:152
translate schinese ep12_bella_lib_label_113f6682:

    # mc "A lot of questions, but I don't know how to ask them."
    mc "一堆问题，但我不知道该怎么问。"

# episode12\branches\ep12_isabella_branch.rpy:153
translate schinese ep12_bella_lib_label_1c1eba23:

    # mc "Or maybe I already know the answers."
    mc "或者我早就知道答案了。"

# episode12\branches\ep12_isabella_branch.rpy:155
translate schinese ep12_bella_lib_label_3cc2f80d:

    # isa "Please, tell me what you're thinking."
    isa "请跟我说说你在想什么。"

# episode12\branches\ep12_isabella_branch.rpy:157
translate schinese ep12_bella_lib_label_5e889303:

    # mc "It's about James..."
    mc "这是关于James的……"

# episode12\branches\ep12_isabella_branch.rpy:158
translate schinese ep12_bella_lib_label_ee7da408:

    # mc "I know that he's not been around and all, and I've made up scenarios in my head that don't match reality."
    mc "我知道他一直没出现，我脑子里编了好多故事，但那些根本不符合现实。"

# episode12\branches\ep12_isabella_branch.rpy:159
translate schinese ep12_bella_lib_label_14a9c495:

    # mc "I always thought that he had left you somehow..."
    mc "我一直在想，他 不知怎么 离开了你……"

# episode12\branches\ep12_isabella_branch.rpy:161
translate schinese ep12_bella_lib_label_f5b6c9ef:

    # isa "Well, he did."
    isa "好吧，他确实这样了。"

# episode12\branches\ep12_isabella_branch.rpy:163
translate schinese ep12_bella_lib_label_28c9f790:

    # mc "Yes, but in another sense. In an unhappy way... I mean, not that the way it happened was happy, but..."
    mc "是的，但换个角度来说，是以一种不幸福的方式……我是说，不是说事情发生的本身是快乐的，但……"

# episode12\branches\ep12_isabella_branch.rpy:165
translate schinese ep12_bella_lib_label_31b2a28a:

    # isa "I get what you mean. You thought I was in an unhappy marriage."
    isa "我明白你的意思。你一直以为我处于一段不幸福的婚姻里。"

# episode12\branches\ep12_isabella_branch.rpy:167
translate schinese ep12_bella_lib_label_f36e5aec:

    # mc "Exactly."
    mc "正是这样。"

# episode12\branches\ep12_isabella_branch.rpy:168
translate schinese ep12_bella_lib_label_e4d177a4:

    # mc "And that thought made me feel confident about us."
    mc "那个想法让我对我们的关系更有信心了。"

# episode12\branches\ep12_isabella_branch.rpy:170
translate schinese ep12_bella_lib_label_c19b6ef1:

    # mc "And now that I realized that you two were in love when he left you... And that your relationship ended, or...was put on pause?"
    mc "现在我意识到，他离开你的时候，你俩其实已经相爱了……而你们的关系，要么结束了，要么……暂停了？"

# episode12\branches\ep12_isabella_branch.rpy:171
translate schinese ep12_bella_lib_label_7fb9d285:

    # mc "Fuck, I don't even know how to say it."
    mc "操，我甚至不知道该怎么说。"

# episode12\branches\ep12_isabella_branch.rpy:173
translate schinese ep12_bella_lib_label_103899e6:

    # isa "Go on."
    isa "继续吧。"

# episode12\branches\ep12_isabella_branch.rpy:175
translate schinese ep12_bella_lib_label_72ab680e:

    # mc "After I realized it had ended and neither of you wanted it to..."
    mc "在我意识到它已经结束了，而你们两个都不想让它继续下去……"

# episode12\branches\ep12_isabella_branch.rpy:176
translate schinese ep12_bella_lib_label_8114a09f:

    # mc "Uh..."
    mc "嗯……"

# episode12\branches\ep12_isabella_branch.rpy:177
translate schinese ep12_bella_lib_label_ecefe1b3:

    # mc "You're still in love with him... Aren't you?"
    mc "你还是爱着他……对吧？"

# episode12\branches\ep12_isabella_branch.rpy:179
translate schinese ep12_bella_lib_label_fb623a7e_1:

    # isa "..."
    isa "..."

# episode12\branches\ep12_isabella_branch.rpy:180
translate schinese ep12_bella_lib_label_9b6a1983:

    # mc "And... If he's alive... He's still in love with you."
    mc "而且……如果他还活着……他还是爱你的。"

# episode12\branches\ep12_isabella_branch.rpy:182
translate schinese ep12_bella_lib_label_d34467ef:

    # mc "And that scares me. How do I handle that?"
    mc "这让我害怕。我该怎么面对？"

# episode12\branches\ep12_isabella_branch.rpy:183
