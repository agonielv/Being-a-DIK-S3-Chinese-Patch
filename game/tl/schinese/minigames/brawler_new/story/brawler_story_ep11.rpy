translate schinese brawler_story_dwyane_after1_label_367ffd12:

    # dwy "Haha, cocky ass. Aight, I'll show you next time. Let's take a break."
    dwy "哈哈，你这自大鬼。行吧，下次再教你。我们休息一下。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:143
translate schinese brawler_story_dwyane_after1_label_36b6b7d7:

    # dwy "Haha, cocky ass. Aight, I'll show you."
    dwy "哈哈，你这自大鬼。行吧，我下次再给你展示。"

