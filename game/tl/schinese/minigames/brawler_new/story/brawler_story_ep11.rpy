translate schinese brawler_story_tate1_label_329c3c03:

    # tate "I know, and I wasn't being literal. What I meant is that I want you to put up somewhat of a challenge."
    tate "我知道，我没说字面意思。我是说，我希望你稍微有点挑战性。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:167
translate schinese brawler_story_tate1_label_8ec6e677:

