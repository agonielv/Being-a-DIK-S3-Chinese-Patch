translate schinese brawler_story_tate_after1_label_980e96ed:

    # chao "I was talking to Tate. He was slightly less - how should I put it? - bad at fighting this time."
    chao "我跟Tate聊了聊，他这次打斗稍微好点——怎么说呢？——没那么烂。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:209
translate schinese brawler_story_tate_after1_label_daa325ef:

    # tate "I already tapped out. There's no need to continue beating me up."
    tate "我已经认输了，不用继续打我了。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:211
translate schinese brawler_story_tate_after1_label_eed896c9_1:

    # chao "Hahaha!"
    chao "哈哈哈！"

# minigames\brawler_new\story\brawler_story_ep11.rpy:213
translate schinese brawler_story_tate_after1_label_fa49cc20:

    # mc "He likes to joke around with you. What's the deal with that?"
    mc "他就是喜欢跟你开玩笑。这事儿怎么解释啊？"

# minigames\brawler_new\story\brawler_story_ep11.rpy:215
translate schinese brawler_story_tate_after1_label_1be37f64:

    # tate "I think he's intimidated by me because we're the same weight class and I'm making progress."
    tate "我想他是被我吓到了，因为我们是同一个体重级别，而且我正在进步。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:216
translate schinese brawler_story_tate_after1_label_773fa75e:

    # tate "He's a great guy, but he has a habit of busting my chops any chance he gets."
    tate "他是个不错的人，就是总喜欢拿我开玩笑。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:218
translate schinese brawler_story_tate_after1_label_6fc269f6:

    # mc "I hope you do the same to him."
    mc "希望你也能对他这么做。"

