translate schinese brawler_story_dwyane_after1_label_11c746f7:

    # dwy "I'm not sharing my technique with you if that's all you'll give me."
    dwy "如果你连这点都做不到，就别指望我教你我的技巧。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:118
translate schinese brawler_story_dwyane_after1_label_fa8df451:

