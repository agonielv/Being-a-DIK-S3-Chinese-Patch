translate schinese brawler_story_tate_after1_label_98aac883:

    # tate "Nah. I saw him lose one of his recent fights, and I didn't have it in me."
    tate "不，我看到他最近输了一场，我实在没那个心情去笑话他。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:221
translate schinese brawler_story_tate_after1_label_3925e43b:

    # tate "He loves the sport so much, and I don't want to make fun of his weakest moments."
    tate "他真的很爱这项运动，我不想拿他的软肋开玩笑。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:223
translate schinese brawler_story_tate_after1_label_993f1425:

    # mc "You're a good guy."
    mc "你是个不错的人。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:224
translate schinese brawler_story_tate_after1_label_7b04b57a:

    # mc "And I think you're right. You are improving."
    mc "而且我觉得你说得对，你确实在进步。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:226
translate schinese brawler_story_tate_after1_label_3dbff762:

    # tate "I know, right?"
    tate "我知道，对吧？"

