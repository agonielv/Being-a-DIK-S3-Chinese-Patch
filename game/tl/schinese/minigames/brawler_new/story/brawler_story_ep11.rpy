translate schinese brawler_story_dwyane_after1_label_52955d02:

    # dwy "Lost my breath for a second. You faked me out good, looking up high while going low like that."
    dwy "让我喘了口气。你刚才那招真把我骗到了，抬头看高却打低，玩得我措手不及。"

# minigames\brawler_new\story\brawler_story_ep11.rpy:134
translate schinese brawler_story_dwyane_after1_label_58651aa3:

    # dwy "Didn't know you had that in you."
    dwy "没想到你还有这手。"

